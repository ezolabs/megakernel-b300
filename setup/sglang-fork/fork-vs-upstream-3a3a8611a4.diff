+"""Exact (lossless) decoder trim for DeepSeek-V4.1 prefill.
+
+Under decoder SWA bounded replay the late layers (from late_layer_start, the last
+kv-source layer) run only on the last tail rows of each extend, floored at
+seq_len - tail_len (page_floor(seq_len) - tail_len under the exact trim,
+see tail_floor). The lossy default tail is SWA_WINDOW. This module derives the
+tail length at which the trim is exact.
+
+Cone for a tail floored at F, window W: layers below late_layer_start run every
+row, so they are exact everywhere. The output of the source layer is exact from
+F + (W - 1). Each later layer adds W - 1 rows of cone, so the output of layer l is
+exact from F + (l - late_layer_start + 1) * (W - 1). The final window of the last
+layer and its logits are exact once the tail covers
+W + (L - 1 - late_layer_start) * (W - 1) rows, rounded up to a page.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+
+def exact_trim_enabled(enable_decoder_swa_bounded_replay) -> bool:
+    """Whether the exact trim is on: decoder SWA bounded replay with
+    SGLANG_DSV4_EXACT_DECODER_TRIM. The DSV4 backend, the radix cache and the
+    branch-rebuild startup gate all read it here, so they cannot drift."""
+    from sglang.srt.environ import envs
+
+    return bool(enable_decoder_swa_bounded_replay) and bool(
+        envs.SGLANG_DSV4_EXACT_DECODER_TRIM.get()
+    )
+
+
+def page_ceil(n: int, page: int) -> int:
+    return -(-n // page) * page
+
+
+def exact_tail_len(
+    *, window: int, num_layers: int, late_layer_start: int, page_size: int
+) -> int:
+    """Smallest page-aligned tail, in rows, that keeps the late-layer trim exact."""
+    if window < 1 or page_size < 1:
+        raise ValueError(f"window={window}, page_size={page_size} must be >= 1")
+    if not 0 <= late_layer_start < num_layers:
+        raise ValueError(
+            f"late_layer_start={late_layer_start} not in [0, {num_layers})"
+        )
+    depth = num_layers - 1 - late_layer_start
+    return page_ceil(window + depth * (window - 1), page_size)
+
+
+def output_exact_from(
+    layer: int, floor: int, *, window: int, late_layer_start: int
+) -> int:
+    """First row from which the output of ``layer`` equals full prefill, for a
+    late tail floored at ``floor``."""
+    if layer < late_layer_start:
+        return 0
+    return floor + (layer - late_layer_start + 1) * (window - 1)
+
+
+def final_window_is_exact(
+    prompt_end: int,
+    tail_len: int,
+    *,
+    window: int,
+    num_layers: int,
+    late_layer_start: int,
+) -> bool:
+    """Whether a tail of ``tail_len`` rows gives exact logits at prompt_end - 1 and
+    exact SWA KV of every late layer over the final window."""
+    floor = max(0, prompt_end - tail_len)
+    last = num_layers - 1
+    logits_ok = (
+        output_exact_from(last, floor, window=window, late_layer_start=late_layer_start)
+        <= prompt_end - 1
+    )
+    window_ok = (
+        output_exact_from(
+            last - 1, floor, window=window, late_layer_start=late_layer_start
+        )
+        <= prompt_end - window
+    )
+    return logits_ok and window_ok
+
+
+# Page-anchored exact tail. The late tail is floored at a page boundary,
+# page_floor(seq_len) - tail_len, rather than at seq_len - tail_len, so the
+# final window AT the prompt end P and the window at page_floor(P) (where the
+# radix cache can next hit) are both exact. A request then runs up to
+# tail_len + page - 1 late rows.
+
+# DeepSeek-V4.1-Flash: W = 128, L = 40, late_layer_start = 20.
+LATE_DEPTH = 40 - 1 - 20  # late layers after the source layer
+CONE = LATE_DEPTH * (128 - 1)  # 2413: rows from a floor to exact late KV
+
+
+def page_floor(n: int, page: int) -> int:
+    return n // page * page
+
+
+def tail_floor(seq_len: int, page: int, tail_len: int, min_floor: int = 0) -> int:
+    """Page-anchored late-tail floor: page_floor(seq_len) - tail_len, at least
+    ``min_floor`` (G) and 0."""
+    return max(page_floor(seq_len, page) - tail_len, min_floor, 0)
+
+
+def tail_rows_bound(tail_len: int, page: int) -> int:
+    """Most late rows one request runs under the page-anchored floor."""
+    return tail_len + page - 1
+
+
+def late_exact_from_after_extend(
+    start: int,
+    end: int,
+    floor: int,
+    prev: int,
+    window: int,
+    *,
+    depth: int = LATE_DEPTH,
+) -> int:
+    """Late-exact-from E after an extend [start, end) whose late tail is floored
+    at ``floor`` and runs rows [max(start, floor), end).
+
+    E is a layered claim: late layer late_layer_start + j has computed, exact
+    KV on rows [max(0, E - (depth - j) * (window - 1)), end), for j in
+    [0, depth]. So every late layer's KV is exact from E, and a window ending
+    at b is exact iff late_window_ok(E, b, window). ``prev`` is the claim for
+    rows [0, start): 0 when cold or fully exact. A cached prefix with unknown
+    late KV is prev = start + CONE. A chunk with no late-exact row yields
+    E >= end; a far-skipped chunk is the SKIP_TAIL-row floor = end - SKIP_TAIL
+    (far_skip).
+
+    The output of layer j is exact on row r iff the window
+    [max(r - window + 1, 0), r] lies at or above both the floor and the first
+    good row of layer j's KV. Once that first exact output row passes start,
+    each later layer adds window - 1 rows of cone.
+    """
+    if not 0 <= start <= end or floor < 0 or prev < 0:
+        raise ValueError(f"start={start}, end={end}, floor={floor}, prev={prev}")
+    if start == end:
+        return prev
+    c = window - 1
+    good = min(max(0, prev - depth * c), start)
+    for j in range(depth):
+        base = max(floor, good)
+        out = base + c if base > 0 else 0
+        good = out if out > start else min(max(0, prev - (depth - j - 1) * c), start)
+    return good
+
+
+def late_window_ok(late_exact_from: int, boundary: int, window: int) -> bool:
+    """Whether every late layer's KV over the window ending at ``boundary`` is
+    exact, for a late-exact-from claim (see late_exact_from_after_extend)."""
+    return max(boundary - window, 0) >= late_exact_from
+
+
+# Scheduler side: the radix match decision and the per-request E recurrence.
+# The geometry is LATE_DEPTH's (the recurrence's); the backend refuses a model
+# whose late depth differs.
+LATE_LAYER_START = 20
+
+
+def late_trim_tail_len(window: int, page: int, *, depth: int = LATE_DEPTH) -> int:
+    """R: the page-anchored exact tail for the late geometry LATE_DEPTH models."""
+    return exact_tail_len(
+        window=window,
+        num_layers=LATE_LAYER_START + depth + 1,
+        late_layer_start=LATE_LAYER_START,
+        page_size=page,
+    )
+
+
+def prefix_late_exact_from(
+    prefix_len: int,
+    node_late_exact_from: Optional[int],
+    window: int,
+    *,
+    depth: int = LATE_DEPTH,
+) -> int:
+    """``prev`` for a cached prefix [0, prefix_len): the matched node's claim, or
+    prefix_len + depth * (window - 1) (no cached late row exact) when it is
+    unknown. 0 for no prefix."""
+    if prefix_len <= 0:
+        return 0
+    if node_late_exact_from is None:
+        return prefix_len + depth * (window - 1)
+    return node_late_exact_from
+
+
+def match_late_floor(
+    prefix_len: int,
+    late_exact_from: Optional[int],
+    prompt_len: int,
+    *,
+    whole_extend: bool,
+    window: int,
+    page: int,
+    tail_len: int,
+) -> Optional[int]:
+    """Whether a radix hit of prefix_len tokens for a prompt of prompt_len is
+    kept, as the late floor G the request runs at: 0 for a hit whose late
+    window is exact, prefix_len for a hit at or below page_floor(P) - R (its
+    extend runs every late row the final window needs from the hit on, so the
+    cached late rows are never needed exact). None: cap the hit
+    (match_cap). A whole extend (prompt logprobs) reads every row's window, so
+    only a late-exact hit serves it."""
+    if prefix_len <= 0:
+        return 0
+    if late_exact_from is not None and late_window_ok(
+        late_exact_from, prefix_len, window
+    ):
+        return 0
+    if not whole_extend and prefix_len <= page_floor(prompt_len, page) - tail_len:
+        return prefix_len
+    return None
+
+
+def match_cap(
+    prompt_len: int,
+    deepest_late_exact_end: int,
+    *,
+    whole_extend: bool,
+    page: int,
+    tail_len: int,
+) -> int:
+    """The length a refused hit is re-walked to: the deepest late-exact node end
+    on its path, or page_floor(P) - R when longer and not a whole extend."""
+    cap = deepest_late_exact_end
+    if not whole_extend:
+        cap = max(cap, page_floor(prompt_len, page) - tail_len)
+    return max(cap, 0)
+
+
+# Rows a far-skipped extend still runs through the late layers. Not 0 or 1: a
+# zero-row tail breaks bucket_rows, MoE and the logits gather, and SWA_WINDOW
+# rows keep every late-layer shape the lossy default already runs.
+SKIP_TAIL = 128
+
+
+def far_skip(
+    end: int,
+    prompt_len: Optional[int],
+    *,
+    whole_extend: bool,
+    page: int,
+    tail_len: int,
+) -> bool:
+    """Whether an extend ending at ``end`` skips its late layers: no late row
+    below page_floor(P) - R is ever read exact again (the final window's cone
+    starts there, and the match cap never serves a hit above it), so a
+    non-whole extend that ends at or below it runs only a SKIP_TAIL-row tail and
+    raises the request's G to ``end``. ``prompt_len`` P is the length whose late
+    rows must come out exact (prompt_len of late_tail_floors); None never
+    skips."""
+    if prompt_len is None or whole_extend:
+        return False
+    return end < prompt_len and end <= page_floor(prompt_len, page) - tail_len
+
+
+def late_tail_floors(
+    seq_lens: list[int],
+    *,
+    prompt_lens: Optional[list[int]],
+    late_floor_gs: Optional[list[int]],
+    whole_extend: Optional[list[bool]],
+    page: int,
+    tail_len: int,
+) -> list[int]:
+    """Each request's late-tail floor as the backend runs it under the exact
+    trim: max(end - SKIP_TAIL, 0) for a far-skipped extend (far_skip), else
+    tail_floor(end) raised to the request's G. Requests past the end of
+    prompt_lens / late_floor_gs (padding, mixed-in decode rows) never skip and
+    run at G = 0. A whole extend's rows keep their plain windows
+    (_whole_extend_tail_layout); its entry here is unused."""
+    floors = []
+    for i, end in enumerate(seq_lens):
+        p = prompt_lens[i] if prompt_lens is not None and i < len(prompt_lens) else None
+        g = (
+            late_floor_gs[i]
+            if late_floor_gs is not None and i < len(late_floor_gs)
+            else 0
+        )
+        whole = whole_extend is not None and whole_extend[i]
+        if far_skip(end, p, whole_extend=whole, page=page, tail_len=tail_len):
+            floors.append(max(end - SKIP_TAIL, 0))
+        else:
+            floors.append(tail_floor(end, page, tail_len, g))
+    return floors
+
+
+def late_extend_floor(
+    start: int,
+    end: int,
+    *,
+    whole_extend: bool,
+    late_floor_g: int,
+    page: int,
+    tail_len: int,
+    prompt_len: Optional[int] = None,
+) -> int:
+    """A floor at or above the one the backend runs an extend [start, end) at: a
+    whole extend's plain windows reach start - tail_len
+    (_whole_extend_tail_layout), a far-skipped one (far_skip) is floored at
+    end - SKIP_TAIL, any other extend is page-anchored (tail_floor) and raised
+    to G. A whole extend is raised to G too, which the backend does not apply:
+    E is non-decreasing in the floor, so a higher floor only makes the claim
+    more conservative."""
+    if whole_extend:
+        return max(start - tail_len, late_floor_g, 0)
+    if far_skip(end, prompt_len, whole_extend=False, page=page, tail_len=tail_len):
+        return max(end - SKIP_TAIL, 0)
+    return tail_floor(end, page, tail_len, late_floor_g)
+
+
+def late_exact_from_after_request_extend(
+    prev: int,
+    start: int,
+    end: int,
+    *,
+    whole_extend: bool,
+    late_floor_g: int,
+    window: int,
+    page: int,
+    tail_len: int,
+    prompt_len: Optional[int] = None,
+) -> int:
+    """late_exact_from_after_extend at the request's late_extend_floor."""
+    floor = late_extend_floor(
+        start,
+        end,
+        whole_extend=whole_extend,
+        late_floor_g=late_floor_g,
+        page=page,
+        tail_len=tail_len,
+        prompt_len=prompt_len,
+    )
+    return late_exact_from_after_extend(start, end, floor, prev, window)
