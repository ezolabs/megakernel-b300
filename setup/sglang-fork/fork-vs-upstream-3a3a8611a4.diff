+def _ack(ready):
+    return SimpleNamespace(
+        finish_event=SimpleNamespace(query=MagicMock(return_value=ready))
+    )
+
+
+def _storage_queues(sizes):
+    return [SimpleNamespace(qsize=MagicMock(return_value=n)) for n in sizes]
+
