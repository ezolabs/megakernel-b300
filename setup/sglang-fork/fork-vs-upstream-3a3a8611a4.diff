+def _functions(body: dict) -> List[dict]:
+    return [tool["function"] for tool in body.get("tools") or []]
+
+
+def _null_in_a_list(value) -> bool:
+    if isinstance(value, list):
+        return any(v is None or _null_in_a_list(v) for v in value)
+    if isinstance(value, dict):
+        return any(_null_in_a_list(v) for v in value.values())
+    return False
+
+
+def _depth_of_first_null(value, depth=0) -> Optional[int]:
+    """The shallowest object/list depth at which ``value`` holds a null (``parameters`` = 0)."""
+    if value is None:
+        return depth
+    children = (
+        value.values() if isinstance(value, dict) else value
+        if isinstance(value, list) else ()
+    )
+    found = [_depth_of_first_null(v, depth + 1) for v in children]
+    found = [d for d in found if d is not None]
+    return min(found) if found else None
+
