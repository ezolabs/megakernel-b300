+class _AfterAlloc(Exception):
+    """Raised by the stand-in request's first attribute read after the allocation."""
+
+
+class _ExtendReq(SimpleNamespace):
+    """What ``prepare_for_extend`` reads before ``alloc_for_extend``; the first thing it
+    does after the allocation and the stamp, ``extend_batch_idx += 1``, raises."""
+
+    @property
+    def extend_batch_idx(self):
+        raise _AfterAlloc
+
+    def __getattr__(self, name):
+        # Upstream's loop after the allocation reads other fields first.
+        raise _AfterAlloc
+
+    def get_fill_ids(self):
+        return array("q", [1, 2, 3, 4])
+
+
+def _prepare_for_extend(req):
+    """Run the real ``ScheduleBatch.prepare_for_extend`` up to the stamp after alloc."""
+    from sglang.srt.managers import schedule_batch as sb_module
+    from sglang.srt.managers.schedule_batch import ScheduleBatch
+
+    batch = SimpleNamespace(
+        reqs=[req],
+        device="cpu",
+        is_dllm=lambda: False,
+        tree_cache=None,  # read for exact_decoder_trim
+    )
+    alloc = lambda b: (torch.zeros(2, dtype=torch.int64), torch.zeros(1), [0])
+    with (
+        mock.patch.object(sb_module, "alloc_for_extend", alloc),
+        mock.patch.object(
+            sb_module,
+            "get_exec",
+            return_value=SimpleNamespace(
+                features=SimpleNamespace(enable_encoder_swa_bounded_replay=False)
+            ),
+        ),
+    ):
+        with pytest.raises(_AfterAlloc):
+            ScheduleBatch.prepare_for_extend(batch)
+
+
+def _extend_req(phase):
+    return _ExtendReq(
+        sbr_phase=phase,
+        prefix_len=2,
+        extend_end=4,
+        extend_len=2,
+        origin_input_ids=array("q", [1, 2, 3, 4]),
+        logprob_start_len=-1,
+        full_untruncated_fill_ids=array("q", [1, 2, 3, 4]),
+    )
+
