@@ -0,0 +1,318 @@
+"""e1: the per-priority waiting-queue section on ``LoadSnapshot``.
+
+Two halves of one contract:
+
+* ``LoadSnapshot.priorities`` -- a list section of ``PriorityQueueMetrics``,
+  selected with ``include=priorities`` and carried over the msgpack snapshot
+  wire.
+* ``SchedulerLoadInquirer.get_priority_queue_metrics`` -- the grouping that
+  fills it, which must sum to the ``num_waiting_uncached_tokens`` the same
+  inquirer already reports.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest import mock
+
+import msgspec.msgpack
+import pytest
+
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.managers.load_snapshot import (
+    LoadSnapshot,
+    PriorityQueueMetrics,
+    snapshot_decoder,
+    snapshot_encoder,
+)
+from sglang.srt.managers.scheduler_components import load_inquirer as load_inquirer
+from sglang.srt.managers.scheduler_components.load_inquirer import (
+    SchedulerLoadInquirer,
+)
+
+_PRIORITIES = [
+    PriorityQueueMetrics(
+        priority=0, num_waiting_reqs=2, num_waiting_uncached_tokens=100
+    ),
+    PriorityQueueMetrics(priority=5, num_waiting_reqs=1, num_waiting_uncached_tokens=7),
+]
+_PRIORITIES_JSON = [
+    {"priority": 0, "num_waiting_reqs": 2, "num_waiting_uncached_tokens": 100},
+    {"priority": 5, "num_waiting_reqs": 1, "num_waiting_uncached_tokens": 7},
+]
+
+
+def _snapshot() -> LoadSnapshot:
+    return LoadSnapshot(num_running_reqs=1, priorities=list(_PRIORITIES))
+
+
+class TestPrioritiesSection:
+    def test_default_to_dict_serialises_the_list_as_dicts(self):
+        assert _snapshot().to_dict()["priorities"] == _PRIORITIES_JSON
+
+    def test_all_section_includes_priorities(self):
+        assert _snapshot().to_dict({"all"})["priorities"] == _PRIORITIES_JSON
+
+    def test_core_section_omits_priorities(self):
+        load = _snapshot().to_dict({"core"})
+        assert "priorities" not in load
+        assert load["num_running_reqs"] == 1
+
+    def test_priorities_section_carries_only_priorities(self):
+        load = _snapshot().to_dict({"priorities"})
+        assert load["priorities"] == _PRIORITIES_JSON
+        for other in ("memory", "speculative", "lora", "disaggregation", "queues"):
+            assert other not in load
+        assert load["num_running_reqs"] == 1  # core keys always ship
+
+    def test_priorities_combines_with_another_section(self):
+        load = _snapshot().to_dict({"core", "priorities"})
+        assert load["priorities"] == _PRIORITIES_JSON
+
+    def test_unknown_section_raises_naming_the_section(self):
+        with pytest.raises(ValueError) as excinfo:
+            _snapshot().to_dict({"bogus"})
+        assert "bogus" in str(excinfo.value)
+
+    def test_unset_priorities_stay_out_of_the_dict(self):
+        assert "priorities" not in LoadSnapshot().to_dict()
+
+    def test_msgpack_round_trip_preserves_priorities(self):
+        snapshot = _snapshot()
+        decoded = snapshot_decoder.decode(snapshot_encoder.encode(snapshot))
+
+        assert decoded.priorities == snapshot.priorities
+        assert [p.priority for p in decoded.priorities] == [0, 5]
+        assert decoded.to_dict()["priorities"] == _PRIORITIES_JSON
+
+    def test_empty_priorities_survive_the_wire(self):
+        decoded = snapshot_decoder.decode(
+            snapshot_encoder.encode(LoadSnapshot(priorities=[]))
+        )
+        assert decoded.priorities == []
+
+    def test_snapshot_from_a_writer_without_the_field_still_decodes(self):
+        legacy = msgspec.msgpack.Encoder().encode({"dp_rank": 3, "num_running_reqs": 1})
+        decoded = snapshot_decoder.decode(legacy)
+
+        assert decoded.dp_rank == 3
+        assert decoded.priorities is None
+
+
+_INQUIRER_CALLABLES = (
+    "get_running_batch",
+    "get_waiting_queue",
+    "waiting_queue_prefix_matched",
+    "get_recent_cache_hit_rate",
+    "get_stats",
+    "get_chunked_req",
+    "get_disagg_prefill_bootstrap_queue",
+    "get_disagg_prefill_inflight_queue",
+    "get_disagg_decode_prealloc_queue",
+    "get_disagg_decode_transfer_queue",
+    "get_spec_total_num_accept_tokens",
+    "get_spec_total_num_forward_ct",
+    "get_total_prefill_uncached_tokens",
+    "get_total_prefill_busy_us",
+    "get_decode_moment_totals",
+)
+
+
+_INERT_FIELDS = dict(
+    server_args=mock.MagicMock(),
+    max_total_num_tokens=4096,
+    max_running_requests=64,
+    pool_stats_observer=mock.MagicMock(),
+    tp_worker=mock.MagicMock(),
+    token_to_kv_pool_allocator=mock.MagicMock(),
+    spec_algorithm=mock.MagicMock(),
+)
+
+
+def _make_inquirer(**overrides) -> SchedulerLoadInquirer:
+    """An inquirer whose every field is a stand-in supplied as a kwarg."""
+    fields = {name: mock.MagicMock() for name in _INQUIRER_CALLABLES}
+    fields.update(_INERT_FIELDS)
+    fields["disaggregation_mode"] = DisaggregationMode.NULL
+    fields.update(overrides)
+    return SchedulerLoadInquirer(**fields)
+
+
+def _req(seqlen: int, matched: int, priority) -> SimpleNamespace:
+    return SimpleNamespace(
+        seqlen=seqlen, num_matched_prefix_tokens=matched, priority=priority
+    )
+
+
+def _rows(metrics) -> list[tuple[int, int, int]]:
+    return [
+        (m.priority, m.num_waiting_reqs, m.num_waiting_uncached_tokens)
+        for m in metrics
+    ]
+
+
+class TestPriorityQueueMetrics:
+    def test_groups_by_priority_and_orders_ascending(self):
+        inquirer = _make_inquirer(
+            get_waiting_queue=lambda: [
+                _req(100, 20, None),
+                _req(100, 0, 5),
+                _req(50, 50, 5),
+                _req(30, 0, -1),
+            ],
+            waiting_queue_prefix_matched=lambda: True,
+            get_recent_cache_hit_rate=lambda: 0.75,
+            get_chunked_req=lambda: SimpleNamespace(
+                seqlen=50, prefix_len=10, priority=5
+            ),
+        )
+
+        metrics = inquirer.get_priority_queue_metrics()
+
+        assert _rows(metrics) == [(-1, 1, 30), (0, 1, 80), (5, 2, 140)]
+        assert inquirer.get_num_waiting_uncached_tokens() == 250
+        assert sum(m.num_waiting_uncached_tokens for m in metrics) == 250
+
+    def test_sums_match_the_top_level_estimate_on_the_miss_rate_branch(self):
+        inquirer = _make_inquirer(
+            get_waiting_queue=lambda: [_req(100, 0, 1), _req(41, 0, 1), _req(8, 0, 2)],
+            waiting_queue_prefix_matched=lambda: False,
+            get_recent_cache_hit_rate=lambda: 0.75,
+            get_chunked_req=lambda: None,
+        )
+
+        metrics = inquirer.get_priority_queue_metrics()
+
+        assert _rows(metrics) == [(1, 2, 35), (2, 1, 2)]
+        assert inquirer.get_num_waiting_uncached_tokens() == 37
+        assert sum(m.num_waiting_uncached_tokens for m in metrics) == 37
+
+    def test_refactor_keeps_the_historic_top_level_totals(self):
+        """The pre-existing expectations for the shared estimate survive."""
+        req = _req(100, 20, None)
+        chunked = SimpleNamespace(seqlen=50, prefix_len=10, priority=None)
+        miss_rate = _make_inquirer(
+            get_waiting_queue=lambda: [req],
+            waiting_queue_prefix_matched=lambda: False,
+            get_recent_cache_hit_rate=lambda: 0.75,
+            get_chunked_req=lambda: chunked,
+        )
+        matched = _make_inquirer(
+            get_waiting_queue=lambda: [req],
+            waiting_queue_prefix_matched=lambda: True,
+            get_recent_cache_hit_rate=lambda: 0.75,
+            get_chunked_req=lambda: chunked,
+        )
+
+        assert miss_rate.get_num_waiting_uncached_tokens() == 65
+        assert matched.get_num_waiting_uncached_tokens() == 120
+        assert _rows(miss_rate.get_priority_queue_metrics()) == [(0, 1, 65)]
+        assert _rows(matched.get_priority_queue_metrics()) == [(0, 1, 120)]
+
+    def test_chunked_remainder_lands_under_its_own_priority(self):
+        inquirer = _make_inquirer(
+            get_waiting_queue=lambda: [],
+            waiting_queue_prefix_matched=lambda: True,
+            get_recent_cache_hit_rate=lambda: 0.0,
+            get_chunked_req=lambda: SimpleNamespace(
+                seqlen=90, prefix_len=40, priority=7
+            ),
+        )
+
+        metrics = inquirer.get_priority_queue_metrics()
+
+        assert _rows(metrics) == [(7, 0, 50)]
+        assert inquirer.get_num_waiting_uncached_tokens() == 50
+
+    def test_empty_queue_reports_an_empty_list(self):
+        inquirer = _make_inquirer(
+            get_waiting_queue=lambda: [],
+            get_chunked_req=lambda: None,
+        )
+
+        assert inquirer.get_priority_queue_metrics() == []
+
+    def test_disaggregated_decode_reports_no_pending_prefill(self):
+        inquirer = _make_inquirer(disaggregation_mode=DisaggregationMode.DECODE)
+
+        assert inquirer.get_priority_queue_metrics() == []
+        inquirer.get_waiting_queue.assert_not_called()
+        inquirer.waiting_queue_prefix_matched.assert_not_called()
+        inquirer.get_chunked_req.assert_not_called()
+
+
+def _loads_ready_inquirer(**overrides) -> SchedulerLoadInquirer:
+    """An inquirer complete enough for ``get_loads`` to run end to end."""
+    stats = SimpleNamespace(
+        spec_accept_rate=0.0,
+        lora_pool_slots_used=0,
+        lora_pool_slots_total=0,
+        lora_pool_utilization=0.0,
+        kv_transfer_speed_gb_s=0.0,
+        kv_transfer_latency_ms=0.0,
+        num_grammar_queue_reqs=0,
+        num_paused_reqs=0,
+        num_retracted_reqs=0,
+        gen_throughput=0.0,
+        cache_hit_rate=0.0,
+        utilization=0.0,
+    )
+    fields = dict(
+        pool_stats_observer=SimpleNamespace(
+            get_pool_stats=lambda: SimpleNamespace(
+                get_kv_token_stats=lambda: (10, 0.5)
+            )
+        ),
+        get_running_batch=lambda: SimpleNamespace(reqs=[]),
+        get_waiting_queue=lambda: [],
+        waiting_queue_prefix_matched=lambda: True,
+        get_recent_cache_hit_rate=lambda: 0.0,
+        get_chunked_req=lambda: None,
+        get_stats=lambda: stats,
+        get_decode_moment_totals=lambda: (0.0,) * 6,
+    )
+    fields.update(overrides)
+    return _make_inquirer(**fields)
+
+def _get_loads(inquirer: SchedulerLoadInquirer) -> LoadSnapshot:
+    # Upstream reads the DP rank from the runtime context, not an inquirer field.
+    with mock.patch.object(
+        load_inquirer, "get_lora", return_value=SimpleNamespace(enable_lora=False)
+    ), mock.patch.object(
+        load_inquirer, "get_parallel", return_value=SimpleNamespace(dp_rank=0)
+    ):
+        return inquirer.get_loads()
+
+
+class TestGetLoadsPublishesPriorities:
+    def test_snapshot_carries_the_priority_section(self):
+        snapshot = _get_loads(
+            _loads_ready_inquirer(
+                get_waiting_queue=lambda: [_req(60, 0, 2), _req(40, 0, 2)],
+            )
+        )
+
+        assert snapshot.priorities == [
+            PriorityQueueMetrics(
+                priority=2, num_waiting_reqs=2, num_waiting_uncached_tokens=100
+            )
+        ]
+        assert snapshot.num_waiting_uncached_tokens == 100
+        assert snapshot.num_waiting_reqs == 2
+        assert snapshot.to_dict()["priorities"] == [
+            {"priority": 2, "num_waiting_reqs": 2, "num_waiting_uncached_tokens": 100}
+        ]
+
+    def test_empty_queue_yields_an_empty_section_not_none(self):
+        snapshot = _get_loads(_loads_ready_inquirer())
+
+        assert snapshot.priorities == []
+        assert snapshot.to_dict()["priorities"] == []
+
+    def test_prometheus_path_ignores_the_list_section(self):
+        from sglang.srt.entrypoints.v1_loads import _format_loads_prometheus
+
+        text = _format_loads_prometheus([_snapshot()], {"priorities"}).body.decode()
+
+        assert "sglang_priorities" not in text
+        assert "sglang_num_running_reqs" in text
