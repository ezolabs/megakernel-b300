+# --------------------------------------------------------------------------------------
+# The placeholder ``messages`` the router posts (#10070)
+# --------------------------------------------------------------------------------------
+#
+# A body that carries ids carries ``[{"role":"user","content":""}]`` where its ``messages``
+# were (the serving router ``crates/sbr-wire/src/sglang/input_ids.rs``
+# ``PLACEHOLDER_MESSAGES_JSON``; ``docs/design/wire.md`` "The engine-ids egress", "The
+# body."), so the prompt crosses the wire once, as ids. That is true only while the engine
+# reads nothing of ``messages`` that varies on the ``input_ids`` path. The router's canary
+# compares ids, not messages, so its audit of the engine's source is the only guard there
+# is; these tests execute it. An engine that starts to read ``messages`` beside
+# ``input_ids`` (a validation of the content, an id drawn from the history, a reasoning
+# parser that looks at the last turn) turns them red, and a fork bump runs them.
+#
+# Every request below is converted by the real handler the way ``handle_request`` does
+# (``_validate_request``, then ``_convert_to_internal_request``) and answered the way it
+# does (``_build_chat_response``, ``_generate_chat_stream``), once with the router's body
+# as the messages path sent it (plus the router's ids) and once with the placeholder.
+
+PLACEHOLDER_MESSAGES_JSON = '[{"role":"user","content":""}]'
+_REASONING, _ANSWER = "I am thinking.", "The answer."
+_ARGUMENTS = {"city": "Zürich"}
+_PIECE = 3  # tokens per streamed chunk: it cuts the markers at awkward places
+
+
+def _placeholder_body(body: dict) -> dict:
+    """``body`` as the router posts it on the ids path: ``messages`` is the placeholder."""
+    return dict(body, messages=json.loads(PLACEHOLDER_MESSAGES_JSON))
+
+
+def _convert_with_placeholder(chat, record):
+    """The third conversion: the router's ids, the placeholder, every other member as sent."""
+    return _convert(chat, _placeholder_body(record["egress"]), record["router_ids"])
+
+
+def _messages_read(body: dict) -> Optional[str]:
+    """What the engine would read from ``body["messages"]`` on the ``input_ids`` path that
+    the placeholder would not give it; ``None`` when the placeholder is safe to send.
+
+    The router's rule, ``sbr_wire::sglang::input_ids::messages_the_engine_reads``: it keeps
+    the real messages for a body that trips one of these three (the audit found no other
+    read that varies with the body).
+    """
+    if "continue_final_message" in body and body["continue_final_message"] is not False:
+        return "continue_final_message"
+    messages = body.get("messages")
+    if not isinstance(messages, list):
+        return None
+    for message in messages:
+        if message.get("tools") is not None:
+            return "message-level tools"
+        parts = message.get("content")
+        if isinstance(parts, list) and any(p.get("type") != "text" for p in parts):
+            return "non-text part"
+    return None
+
+
+def _probe_body(**members) -> dict:
+    """A small DSv4.1 chat body in the router's shape (thinking and effort spelled out)."""
+    return {
+        "model": BOX_C_SERVED_MODEL,
+        "messages": [{"role": "user", "content": "hi"}],
+        "stream": True,
+        "max_tokens": 16,
+        "rid": "probe",
+        "separate_reasoning": True,
+        "tool_choice": "none",
+        "chat_template_kwargs": {"thinking": False, "enable_thinking": False},
+        "reasoning_effort": "high",
+        **members,
+    }
+
+
+def _continue_body() -> dict:
+    """A thinking turn that continues the text of a trailing assistant message (#149)."""
+    return _probe_body(
+        messages=[
+            {"role": "user", "content": "hi"},
+            {"role": "assistant", "content": "The answer is"},
+        ],
+        continue_final_message=True,
+        chat_template_kwargs={"thinking": True, "enable_thinking": True},
+    )
+
+
+def _tools_body() -> dict:
+    """The only tool is declared on the system message, not in ``tools``."""
+    tool = {
+        "type": "function",
+        "function": {"name": "lookup", "parameters": {"type": "object"}},
+    }
+    return _probe_body(
+        messages=[
+            {"role": "system", "content": "s", "tools": [tool]},
+            {"role": "user", "content": "hi"},
+        ],
+        tool_choice="auto",
+    )
+
+
+def _image_body() -> dict:
+    image = {"type": "image_url", "image_url": {"url": "data:image/png;base64,AAAA"}}
+    return _probe_body(
+        messages=[
+            {"role": "user", "content": [{"type": "text", "text": "hi"}, image]},
+        ]
+    )
+
+
+def _probe_request(chat, body: dict, placeholder: bool):
+    """The request the handler returns for ``body`` with ids (the placeholder, if asked)."""
+    if placeholder:
+        body = _placeholder_body(body)
+    return _convert(chat, body, [1, 2, 3])[1]
+
+
+class _CountedUuid4:
+    """``uuid.uuid4`` stand-in whose draws count up from a fixed start, so two answers to
+    one request draw the same tool-call ids (a DSv4.1 id is ``call_`` + 24 hex digits)."""
+
+    def __init__(self):
+        self.drawn = 0
+
+    def __call__(self) -> uuid.UUID:
+        self.drawn += 1
+        return uuid.UUID(int=self.drawn << 104)
+
+
+def _counted_ids():
+    return mock.patch.object(uuid, "uuid4", _CountedUuid4())
+
+
+def _dsml_call(name: str) -> str:
+    """One DSv4.1 tool call as the model writes it (an invoke of string parameters, the
+    form deepseek-recipe's parser reads)."""
+    dsml = DeepSeekV41Detector()
+    parameters = "".join(
+        f'<{dsml.dsml_token}{dsml.parameter_tag_name} name="{key}" string="true">'
+        f"{value}</{dsml.dsml_token}{dsml.parameter_tag_name}>\n"
+        for key, value in _ARGUMENTS.items()
+    )
+    return (
+        f"{dsml.bot_token}\n"
+        f'{dsml.invoke_start_token} name="{name}">\n'
+        f"{parameters}"
+        f"{dsml.invoke_end_token}\n"
+        f"{dsml.eot_token}"
+    )
+
+
+def _engine_text(chat, request) -> str:
+    """What the model writes for ``request``: its reasoning when thinking is on, an answer
+    (none under ``required`` or a named tool: the constraint forces the call), then a call
+    to a tool the request lets it call."""
+    thinking = chat._get_reasoning_from_request(request)
+    text = (_REASONING + "</think>") if thinking else ""
+    forced = request.tool_choice == "required" or isinstance(
+        request.tool_choice, ToolChoice
+    )
+    if not forced:
+        text += _ANSWER
+    tools = request.tools or []
+    if tools and request.tool_choice != "none":
+        name = (
+            request.tool_choice.function.name
+            if isinstance(request.tool_choice, ToolChoice)
+            else tools[0].function.name
+        )
+        text += "\n\n" + _dsml_call(name)
+    return text
+
+
+def _meta(request, generated: int, finished: bool) -> dict:
+    """The ``meta_info`` the scheduler gives an answer after ``generated`` tokens."""
+    meta = {
+        "id": "chatcmpl-probe",
+        "finish_reason": {"type": "stop", "matched": None} if finished else None,
+        "prompt_tokens": 1000,
+        "completion_tokens": generated,
+        "weight_version": "default",
+    }
+    if request.logprobs:
+        meta["output_token_logprobs"] = [(-0.25, 7, "t")] * generated
+        meta["output_token_logprobs_length"] = generated
+    return meta
+
+
+def _no_clock(text: str) -> str:
+    return re.sub(r'"created":\d+', '"created":0', text)
+
+
+def _output_ids(chat, text: str) -> List[int]:
+    """The token ids the scheduler sends with ``text`` (recipe's parsers read the ids),
+    tokenized without counting as an ``encode``."""
+    backend = chat.tokenizer_manager.tokenizer.backend_tokenizer
+    return backend.encode(text, add_special_tokens=False).ids
+
+
+def _respond(chat, request, text: str):
+    """The non-streaming answer ``_build_chat_response`` builds from the scheduler's ``text``."""
+    ids = _output_ids(chat, text)
+    ret = [
+        {"text": text, "output_ids": ids, "meta_info": _meta(request, len(ids), True)}
+    ]
+    with _counted_ids():
+        return chat._build_chat_response(request, ret, 0)
+
+
+def _wire(response) -> str:
+    """The response as the client reads it (an error response included), but for its clock."""
+    if hasattr(response, "model_dump_json"):
+        return _no_clock(response.model_dump_json())
+    return _no_clock(response.body.decode())
+
+
+async def _stream(chat, adapted, request, text: str) -> List[str]:
+    """The SSE frames ``_generate_chat_stream`` writes while the scheduler streams ``text``
+    in ``_PIECE``-token steps (the ids and text so far, as the scheduler sends them)."""
+    ids = _output_ids(chat, text)
+    tokenizer = chat.tokenizer_manager.tokenizer
+    ends = list(range(_PIECE, len(ids), _PIECE)) + [len(ids)]
+    chat.tokenizer_manager.script = [
+        {
+            "index": 0,
+            "text": tokenizer.decode(ids[:end]),
+            "output_ids": ids[:end],
+            "meta_info": _meta(request, end, step == len(ends) - 1),
+        }
+        for step, end in enumerate(ends)
+    ]
+    with _counted_ids():
+        frames = [f async for f in chat._generate_chat_stream(adapted, request, None)]
+    return [_no_clock(frame) for frame in frames]
+
+
+def _read_stream(frames: List[str]) -> dict:
+    """What a client assembles from the frames: reasoning, content, tool calls, finish."""
+    out = {"reasoning": "", "content": "", "calls": [], "finish": None}
+    for frame in frames:
+        if not frame.startswith("data: {"):
+            continue
+        for choice in json.loads(frame[len("data: ") :]).get("choices") or []:
+            delta = choice.get("delta") or {}
+            out["reasoning"] += delta.get("reasoning_content") or ""
+            out["content"] += delta.get("content") or ""
+            out["calls"] += delta.get("tool_calls") or []
+            out["finish"] = choice.get("finish_reason") or out["finish"]
+    return out
+
+
+def _request(body: dict, input_ids) -> ChatCompletionRequest:
+    """A request for ``body`` and ``input_ids`` that shares nothing with the fixture:
+    ``_validate_request`` rewrites a tool's schema in place."""
+    return ChatCompletionRequest(**dict(copy.deepcopy(body), input_ids=list(input_ids)))
+
+
+def _history_tool_calls(body: dict) -> int:
+    return sum(
+        len(m.get("tool_calls") or [])
+        for m in body["messages"]
+        if m["role"] == "assistant"
+    )
+
+
+def test_the_routers_placeholder_rule_clears_every_fixture_body():
+    """The router sends the placeholder only for a body that trips none of the three reads
+    below; every body of this fixture is one it would send it for, and it always spells a
+    ``tool_choice`` (``ChatCompletionRequest.set_tool_choice_default`` reads the messages
+    only when there is none)."""
+    assert json.loads(PLACEHOLDER_MESSAGES_JSON) == [{"role": "user", "content": ""}]
+    assert [r["id"] for r in RECORDS if _messages_read(r["egress"])] == []
+    assert all(r["egress"].get("tool_choice") is not None for r in RECORDS)
+    assert _messages_read(_placeholder_body(RECORDS[0]["egress"])) is None
+    # Control: the rule does see each of the three, and only them.
+    assert _messages_read(_continue_body()) == "continue_final_message"
+    assert _messages_read(_tools_body()) == "message-level tools"
+    assert _messages_read(_image_body()) == "non-text part"
+    assert _messages_read(dict(_continue_body(), continue_final_message=False)) is None
+    text_parts = [{"role": "user", "content": [{"type": "text", "text": "hi"}]}]
+    assert _messages_read(dict(_image_body(), messages=text_parts)) is None
+
