+class _Record:
+    """What every copy of one ``_HeldTokenizer`` family did, shared by all."""
+
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.copies = 0
+        self.encodes: List[tuple] = []  # (thread name, copy id, text length)
+        self.in_flight = 0
+        self.max_in_flight = 0
+        self.per_copy: Dict[int, int] = {}
+        self.max_per_copy = 0
+        self.gates: Dict[str, threading.Event] = {}
+        self.entered: Dict[str, threading.Event] = {}
+
+    def gate(self, marker: str) -> threading.Event:
+        with self.lock:
+            if marker not in self.gates:
+                self.gates[marker] = threading.Event()
+                self.entered[marker] = threading.Event()
+            return self.gates[marker]
+
+
+class _HeldTokenizer:
+    """A copyable tokenizer whose encode can be held open by a marker in the text.
+
+    A text containing ``<<hold:NAME>>`` waits on gate ``NAME`` (the wait releases
+    the GIL, as the Rust encode does). Copies share the record, so the test sees
+    every encode of every copy. The ids are the text's UTF-8 bytes.
+    """
+
+    chat_template = None
+    bos_token_id = 0
+
+    def __init__(self, record: Optional[_Record] = None, copy_id: int = 0):
+        self.record = record if record is not None else _Record()
+        self.copy_id = copy_id
+
+    def __deepcopy__(self, memo):
+        with self.record.lock:
+            self.record.copies += 1
+            copy_id = self.record.copies
+        return type(self)(self.record, copy_id)
+
+    def encode(self, text: str, **kwargs) -> List[int]:
+        record = self.record
+        with record.lock:
+            record.in_flight += 1
+            record.max_in_flight = max(record.max_in_flight, record.in_flight)
+            record.per_copy[self.copy_id] = record.per_copy.get(self.copy_id, 0) + 1
+            record.max_per_copy = max(
+                record.max_per_copy, record.per_copy[self.copy_id]
+            )
+            record.encodes.append(
+                (threading.current_thread().name, self.copy_id, len(text))
+            )
+        try:
+            start = text.find("<<hold:")
+            if start >= 0:
+                name = text[start + 7 : text.index(">>", start)]
+                gate = record.gate(name)
+                record.entered[name].set()
+                if not gate.wait(timeout=WAIT_S):
+                    raise TimeoutError(f"gate {name} was never released")
+            return [self.bos_token_id] + list(text.encode("utf-8"))
+        finally:
+            with record.lock:
+                record.in_flight -= 1
+                record.per_copy[self.copy_id] -= 1
+
+    def reset(self):
+        with self.record.lock:
+            self.record.encodes.clear()
+            self.record.max_in_flight = 0
+            self.record.max_per_copy = 0
+
+
+class _UncopyableTokenizer(_HeldTokenizer):
+    """Like ``_HeldTokenizer``, but copying it fails (it holds a lock)."""
+
+    def __deepcopy__(self, memo):
+        raise TypeError("cannot pickle '_thread.lock' object")
