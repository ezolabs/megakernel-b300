+def test_non_streaming_takes_the_first_choice_that_has_a_value():
+    serving = _serving()
+    request = _request(n=2, return_first_token_latency_in_sglext=True)
+    response = serving._build_chat_response(
+        request,
+        _ret(_meta(first_token_latency=None), _meta(first_token_latency=0.5)),
+        0,
+    )
+    sglext = json.loads(response.model_dump_json())["sglext"]
+    assert sglext["first_token_latency"] == 0.5
+
+
+# --- the streaming answer ---------------------------------------------------------
+
+
+async def _collect(serving, request, chunks, raw_request=None):
+    async def _generate_request(adapted, raw):
+        for chunk in chunks:
+            yield chunk
+
+    serving.tokenizer_manager.generate_request = _generate_request
+    adapted = SimpleNamespace(rid=RID, is_single=True)
+    frames = [
+        frame
+        async for frame in serving._generate_chat_stream(adapted, request, raw_request)
+    ]
+    return [
+        json.loads(frame[len("data: ") :])
+        for frame in frames
+        if frame.startswith("data: ") and frame.strip() != "data: [DONE]"
+    ]
+
+
+def _stream_chunks(final_meta):
+    return [
+        {"text": "Hi", "meta_info": _meta(first_token_latency=None, finished=False)},
+        {"text": "Hi!", "meta_info": final_meta},
+    ]
+
+
+async def test_streaming_sglext_chunk_carries_the_engine_ttft_when_asked():
+    serving = _serving()
+    request = _request(stream=True, return_first_token_latency_in_sglext=True)
+    events = await _collect(serving, request, _stream_chunks(_meta()))
+    sglext_events = [e for e in events if "sglext" in e]
+    assert [e["sglext"] for e in sglext_events] == [{"first_token_latency": TTFT}]
+
+
+async def test_streaming_control_without_the_ask_has_no_ttft_on_the_wire():
+    serving = _serving()
+    request = _request(stream=True)
+    events = await _collect(serving, request, _stream_chunks(_meta()))
+    assert all("sglext" not in e for e in events)
+
+
+async def test_streaming_control_without_the_engine_value_has_no_ttft_on_the_wire():
+    serving = _serving()
+    request = _request(stream=True, return_first_token_latency_in_sglext=True)
+    events = await _collect(
+        serving, request, _stream_chunks(_meta(first_token_latency=None))
+    )
+    assert all("sglext" not in e for e in events)
+
+
+# --- the engine's half: the tokenizer manager writes meta_info -------------------
+
+
+def _engine_output(time_stats, finished: bool):
+    """One ``BatchStrOutput`` batch for one request, as the scheduler sends it back."""
+    recv_obj = mock.MagicMock(spec=BatchStrOutput)
+    recv_obj.rids = [RID]
+    recv_obj.time_stats = [time_stats]
+    recv_obj.customized_info = None
+    recv_obj.finished_reasons = [{"type": "stop", "matched": None} if finished else None]
+    recv_obj.prompt_tokens = [3]
+    recv_obj.retraction_counts = [0]
+    recv_obj.output_strs = ["Hi!"]
+    recv_obj.completion_tokens = [2]
+    recv_obj.cached_tokens = [0]
+    recv_obj.output_ids = [[1, 2]]
+    # Not under test here: no weight-version spans and no cache breakdown.
+    recv_obj.weight_versions = None
+    recv_obj.cached_tokens_details = None
+    return recv_obj
+
+
+async def _run_engine_batch(finished: bool):
+    time_stats = APIServerReqTimeStats()
+    time_stats.created_time = time.perf_counter() - 1.0
+    state = ReqState(
+        out_list=[],
+        finished=False,
+        event=asyncio.Event(),
+        obj=SimpleNamespace(return_logprob=False, stream=True),
+        time_stats=time_stats,
+        ttft_observed=True,
+    )
+    tm = TokenizerManager.__new__(TokenizerManager)
+    tm.rid_to_state = {RID: state}
+    tm.enable_metrics = False
+    tm.enable_lora = False
+    tm.skip_tokenizer_init = True
+    tm.incremental_streaming_output = False
+    tm.dump_requests_folder = ""
+    tm.crash_dump_folder = ""
+    tm.config_value = lambda name: "v1"
+    recv_obj = _engine_output(time_stats, finished)
+    with (
+        mock.patch.object(tm_module, "get_serving", return_value=SimpleNamespace(batch_notify_size=1)),
+        mock.patch.object(tm_module, "get_spec", return_value=SimpleNamespace(speculative_algorithm=None)),
+    ):
+        state.finished = finished
+        await tm._handle_batch_output(recv_obj)
+    return state.out_list[-1]["meta_info"]
+
+
+async def test_the_finished_output_carries_the_engine_ttft():
+    meta = await _run_engine_batch(finished=True)
+    # The time from creation to the first output batch, set on this batch: about 1 s here.
+    assert 0.9 <= meta["first_token_latency"] < 60.0
+
+
+async def test_an_unfinished_output_has_no_engine_ttft_in_meta_info():
+    meta = await _run_engine_batch(finished=False)
+    assert "first_token_latency" not in meta
diff --git a/test/srt/sbr/test_y_default_thinking_reasoning.py b/test/srt/sbr/test_y_default_thinking_reasoning.py
new file mode 100644
index 0000000000..2d960a578a
--- /dev/null
+++ b/test/srt/sbr/test_y_default_thinking_reasoning.py
@@ -0,0 +1,359 @@
+"""``SGLANG_DEFAULT_THINKING`` drives the reasoning parser as well as the render.
+
+The DeepSeek encoders (``dsv4`` / ``dsv41`` / ``dsv32``) take their thinking mode from
+``chat_template_kwargs["thinking"]`` and fall back to ``SGLANG_DEFAULT_THINKING`` when the
+request does not name it (``OpenAIServingChat._apply_jinja_template``). The reasoning
+parser's switch, ``_get_reasoning_from_request``, read only the kwarg, so with the env on a
+request that named no thinking control was rendered with the ``<think>`` prefix but parsed as
+a chat turn: the model's reasoning and its ``</think>`` arrived in ``content`` and
+``reasoning_content`` stayed empty. The switch now falls back to the env exactly where the
+render does. Every thinking control a client can send (``chat_template_kwargs.thinking``,
+``reasoning_effort``, ``reasoning``) sets the kwarg in ``normalize_reasoning_inputs``, so an
+explicit off switch still wins.
+
+Driven through the real ``_apply_jinja_template`` (deepseek-recipe's DeepSeek-V4.1 render
+through the encoding adapter, on a synthetic byte-level tokenizer, with a stand-in tokenizer
+that records the rendered prompt), ``_build_chat_response`` and ``_generate_chat_stream``
+with the real ``deepseek-v41`` reasoning parser (recipe's, over the output token ids, where
+the adapter serves the spec); no server, no tokenizer files, no GPU.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from types import SimpleNamespace
+from typing import List, Optional
+from unittest import mock
+
+import pytest
+
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.environ import envs
+from sglang.srt.parser.reasoning_parser import ReasoningParser
+from _chat_serving_stub import (
+    init_chat_serving_defaults,
+    route_recipe_encode_through_stub_tokenizers,
+    synthetic_recipe_backend,
+)
+
+THINK = "<think>"
+END_THINK = "</think>"
+RID = "chatcmpl-default-thinking"
+REASONING = "The user wants 17 * 23. 17 * 20 = 340, 17 * 3 = 51, 340 + 51 = 391."
+ANSWER = "391"
+# What the model writes after a thinking prompt (which already ends in ``<think>``).
+THINKING_OUTPUT = f"{REASONING}{END_THINK}{ANSWER}"
+# What it writes after a chat prompt (which ends in ``</think>``).
+CHAT_OUTPUT = ANSWER
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's chat paths read get_serving(), which needs a published config
+    # in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+@pytest.fixture(autouse=True)
+def _recipe_encodes_through_the_stub(monkeypatch):
+    """The V4.1 render is deepseek-recipe's: its encode calls the stub tokenizer."""
+    route_recipe_encode_through_stub_tokenizers(monkeypatch)
+
+
+# The synthetic tokenizer recipe renders and parses with: output text as ids.
+_OUTPUT_TOKENIZER = synthetic_recipe_backend()
+
+
+def _output_ids(text: str) -> List[int]:
+    return _OUTPUT_TOKENIZER.encode(text, add_special_tokens=False).ids
+
+
+@pytest.fixture(autouse=True)
+def _env(monkeypatch):
+    monkeypatch.delenv("SGLANG_DEFAULT_THINKING", raising=False)
+    monkeypatch.delenv("SGLANG_ENABLE_THINKING", raising=False)
+    monkeypatch.delenv("SGLANG_DSV41_REASONING_EFFORT", raising=False)
+
+
+def _default_thinking(monkeypatch, on: bool) -> None:
+    if on:
+        monkeypatch.setenv("SGLANG_DEFAULT_THINKING", "1")
+    else:
+        monkeypatch.delenv("SGLANG_DEFAULT_THINKING", raising=False)
+    assert envs.SGLANG_DEFAULT_THINKING.get() is on
+
+
+class _RecordingTokenizer:
+    """Records the prompt the encoder hands to ``encode``."""
+
+    def __init__(self) -> None:
+        self.prompts: List[str] = []
+
+    def encode(self, text: str, **kwargs) -> List[int]:
+        self.prompts.append(text)
+        return [0]
+
+
+def _serving(
+    spec: Optional[str] = "dsv41", reasoning_parser: Optional[str] = "deepseek-v41"
+):
+    """The chat handler as box-c runs it (``--reasoning-parser auto`` resolves to
+    ``deepseek-v41`` on DeepSeek-V4.1; the encoder ships no Jinja template, so the
+    template manager infers no reasoning toggle and forces nothing)."""
+    serving = init_chat_serving_defaults(OpenAIServingChat.__new__(OpenAIServingChat))
+    serving.template_manager = mock.Mock(
+        reasoning_config=None,
+        force_reasoning=False,
+        jinja_template_content_format="openai",
+        jinja_template_may_reorder_tool_results=False,
+    )
+    serving.reasoning_parser = reasoning_parser
+    serving._reasoning_detector = (
+        ReasoningParser.DetectorMap[reasoning_parser]()
+        if reasoning_parser is not None
+        else None
+    )
+    serving.tool_call_parser = None
+    serving.is_gpt_oss = False
+    serving.chat_encoding_spec = spec
+    serving.tokenizer_manager = SimpleNamespace(
+        server_args=SimpleNamespace(
+            return_input_ids=False,
+            return_output_ids=False,
+            enable_cache_report=False,
+            incremental_streaming_output=False,
+            stream_response_default_include_usage=False,
+        ),
+        model_config=SimpleNamespace(is_multimodal=False, hf_config=None),
+        model_path="dummy",
+        tokenizer=_RecordingTokenizer(),
+    )
+    if spec in ("dsv4", "dsv41"):
+        serving._encoding_adapter = serving._build_chat_encoding_adapter()
+    return serving
+
+
+def _request(**extra) -> ChatCompletionRequest:
+    body = {"model": "m", "messages": [{"role": "user", "content": "What is 17 * 23?"}]}
+    body.update(extra)
+    return ChatCompletionRequest(**body)
+
+
+def _rendered_thinking(serving, request) -> bool:
+    """Whether the engine's own render opened a thinking block for this request."""
+    tokenizer = serving.tokenizer_manager.tokenizer
+    tokenizer.prompts.clear()
+    serving._apply_jinja_template(request, tools=None, is_multimodal=False)
+    (prompt,) = tokenizer.prompts
+    assert prompt.endswith(THINK) or prompt.endswith(END_THINK), prompt[-40:]
+    return prompt.endswith(THINK)
+
+
+def _meta(completion_tokens: int, finished: bool = True) -> dict:
+    return {
+        "id": RID,
+        "weight_version": "v1",
+        "prompt_tokens": 57,
+        "completion_tokens": completion_tokens,
+        "cached_tokens": 0,
+        "reasoning_tokens": 0,
+        "finish_reason": {"type": "stop", "matched": None} if finished else None,
+    }
+
+
+def _non_stream(serving, request, text: str) -> dict:
+    ids = _output_ids(text)
+    ret = [{"text": text, "meta_info": _meta(len(ids)), "output_ids": ids, "index": 0}]
+    body = json.loads(serving._build_chat_response(request, ret, 0).model_dump_json())
+    return body["choices"][0]["message"]
+
+
+def _stream(serving, request, text: str, step: int = 7):
+    ids = _output_ids(text)
+    ends = [*range(step, len(ids), step), len(ids)]
+    chunks = [
+        {
+            "text": _OUTPUT_TOKENIZER.decode(ids[:end], skip_special_tokens=False),
+            "output_ids": ids[:end],
+            "index": 0,
+            "meta_info": _meta(end, finished=end == len(ids)),
+        }
+        for end in ends
+    ]
+
+    async def _generate_request(adapted, raw):
+        for chunk in chunks:
+            yield chunk
+
+    serving.tokenizer_manager.generate_request = _generate_request
+    adapted = SimpleNamespace(rid=RID, is_single=True)
+
+    async def _collect():
+        return [f async for f in serving._generate_chat_stream(adapted, request, None)]
+
+    deltas = [
+        c["delta"]
+        for f in asyncio.run(_collect())
+        if f.startswith("data: {")
+        for c in json.loads(f[len("data: ") :]).get("choices", [])
+    ]
+    content = "".join(d.get("content") or "" for d in deltas)
+    reasoning = "".join(d.get("reasoning_content") or "" for d in deltas)
+    return content, reasoning
+
+
+# --- the switch agrees with the render ----------------------------------------------------------
+
+CONTROLS = {
+    "no-control": {},
+    "kwarg-thinking-true": {"chat_template_kwargs": {"thinking": True}},
+    "kwarg-thinking-false": {"chat_template_kwargs": {"thinking": False}},
+    "kwarg-other-only": {"chat_template_kwargs": {"reasoning_effort": 75}},
+    "effort-none": {"reasoning_effort": "none"},
+    "effort-low": {"reasoning_effort": "low"},
+    "effort-high": {"reasoning_effort": "high"},
+    "reasoning-enabled": {"reasoning": {"enabled": True}},
+    "reasoning-effort-none": {"reasoning": {"effort": "none"}},
+    "effort-high-kwarg-false": {
+        "reasoning_effort": "high",
+        "chat_template_kwargs": {"thinking": False},
+    },
+}
+
+# Whether the request thinks: with the env off (upstream behaviour, unchanged) and on.
+EXPECTED = {
+    "no-control": (False, True),
+    "kwarg-thinking-true": (True, True),
+    "kwarg-thinking-false": (False, False),
+    "kwarg-other-only": (False, True),
+    "effort-none": (False, False),
+    "effort-low": (True, True),
+    "effort-high": (True, True),
+    "reasoning-enabled": (True, True),
+    "reasoning-effort-none": (False, False),
+    "effort-high-kwarg-false": (False, False),
+}
+
+
+@pytest.mark.parametrize("env_on", [False, True], ids=["env-unset", "env-1"])
+@pytest.mark.parametrize("control", list(CONTROLS))
+def test_the_parser_switch_follows_the_render(monkeypatch, env_on, control):
+    _default_thinking(monkeypatch, env_on)
+    serving = _serving()
+    request = _request(**CONTROLS[control])
+    expected = EXPECTED[control][int(env_on)]
+    assert _rendered_thinking(serving, request) is expected
+    assert serving._get_reasoning_from_request(request) is expected
+
+
+# --- the incident: no control, env on ------------------------------------------------------------
+
+
+def test_no_control_env_on_routes_reasoning_non_stream(monkeypatch):
+    _default_thinking(monkeypatch, True)
+    serving = _serving()
+    request = _request()
+    assert _rendered_thinking(serving, request)
+    message = _non_stream(serving, request, THINKING_OUTPUT)
+    assert message["reasoning_content"] == REASONING
+    assert message["content"] == ANSWER
+    assert END_THINK not in message["content"]
+
+
+def test_no_control_env_on_routes_reasoning_stream(monkeypatch):
+    _default_thinking(monkeypatch, True)
+    serving = _serving()
+    content, reasoning = _stream(serving, _request(stream=True), THINKING_OUTPUT)
+    assert reasoning == REASONING
+    assert content == ANSWER
+    assert END_THINK not in content
+
+
+# --- env unset: unchanged ------------------------------------------------------------------------
+
+
+def test_no_control_env_unset_is_a_chat_turn(monkeypatch):
+    _default_thinking(monkeypatch, False)
+    serving = _serving()
+    request = _request()
+    assert not _rendered_thinking(serving, request)
+    assert serving._get_reasoning_from_request(request) is False
+    message = _non_stream(serving, request, CHAT_OUTPUT)
+    assert message["content"] == ANSWER
+    assert message["reasoning_content"] is None
+    content, reasoning = _stream(serving, _request(stream=True), CHAT_OUTPUT)
+    assert (content, reasoning) == (ANSWER, "")
+
+
+def test_env_unset_parses_a_thinking_shaped_reply_as_before(monkeypatch):
+    """Control: without a thinking switch the parser does not split, so the pre-fix bug's
+    shape (reasoning and ``</think>`` in ``content``) is what the env-on case produced.
+    """
+    _default_thinking(monkeypatch, False)
+    message = _non_stream(_serving(), _request(), THINKING_OUTPUT)
+    # recipe's parser keeps the special ``</think>`` token out of the text.
+    assert message["content"] == REASONING + ANSWER
+    assert message["reasoning_content"] is None
+
+
+# --- an explicit off switch still wins over the env ---------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "control",
+    [
+        {"reasoning_effort": "none"},
+        {"chat_template_kwargs": {"thinking": False}},
+        {"reasoning": {"effort": "none"}},
+    ],
+    ids=["effort-none", "kwarg-thinking-false", "reasoning-effort-none"],
+)
+def test_explicit_off_wins_over_env(monkeypatch, control):
+    _default_thinking(monkeypatch, True)
+    serving = _serving()
+    request = _request(**control)
+    assert not _rendered_thinking(serving, request)
+    assert serving._get_reasoning_from_request(request) is False
+    message = _non_stream(serving, request, CHAT_OUTPUT)
+    assert message["content"] == ANSWER
+    assert message["reasoning_content"] is None
+    content, reasoning = _stream(serving, _request(stream=True, **control), CHAT_OUTPUT)
+    assert (content, reasoning) == (ANSWER, "")
+
+
+# --- scope -----------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "spec, parser", [("dsv4", "deepseek-v4"), ("dsv32", "deepseek-v3")]
+)
+def test_the_other_deepseek_encoders_follow_the_env_too(monkeypatch, spec, parser):
+    _default_thinking(monkeypatch, True)
+    serving = _serving(spec, parser)
+    assert serving._get_reasoning_from_request(_request()) is True
+    assert (
+        serving._get_reasoning_from_request(_request(reasoning_effort="none")) is False
+    )
+
+
+@pytest.mark.parametrize("spec", [None, "kimi_k3", "inkling"])
+def test_other_encodings_ignore_the_env(monkeypatch, spec):
+    """Outside the DeepSeek encoders the env does not reach the render's switch here, so
+    the parser keeps its own default (``deepseek-v4``: explicit ``thinking`` only)."""
+    _default_thinking(monkeypatch, True)
+    serving = _serving(spec, "deepseek-v4")
+    assert serving._get_reasoning_from_request(_request()) is False
+
+
+def test_no_reasoning_parser_never_reasons(monkeypatch):
+    _default_thinking(monkeypatch, True)
+    assert (
+        _serving(reasoning_parser=None)._get_reasoning_from_request(_request()) is False
+    )
diff --git a/test/srt/sbr/test_z_retired_parallel_record.py b/test/srt/sbr/test_z_retired_parallel_record.py
new file mode 100644
index 0000000000..a4f5c42637
--- /dev/null
+++ b/test/srt/sbr/test_z_retired_parallel_record.py
@@ -0,0 +1,141 @@
+"""The fork's ports read the parallel topology the way upstream does since #40343.
+
+Upstream #40343 ("Retire the per-runner parallel record") deleted ``ParallelState``
+(``distributed/parallel_state_wrapper.py``) and every ``<runner>.ps`` it hung off: the
+scheduler, the model runner and the components now read ``get_parallel().<name>``. The 0039
+port (``Scheduler.init_batch_result_processor``'s start-up ``sbr-phase-cache`` line) kept the
+old line's ``self.ps.attn_tp_rank``, so with ``SGLANG_SBR_PHASE_TIMING=1`` and
+``SGLANG_SBR_PHASE_TIMING_DETAIL=1`` (both in box-c's tracked env) every rank died at scheduler
+start with ``AttributeError: 'Scheduler' object has no attribute 'ps'``. 0039's own test drove
+that method with a ``MagicMock``, which answers any attribute, so it passed.
+
+Two checks, CPU only:
+
+* the real ``Scheduler.init_batch_result_processor`` on a real ``Scheduler`` instance built
+  without ``__init__`` (``Scheduler.__new__``): only the attributes the method's constructor
+  call passes are set, so a read of an attribute ``Scheduler`` no longer has fails here the
+  way it fails on the box;
+* no code under ``python/sglang/srt`` reads ``.ps`` / ``._ps`` (the retired record), by AST,
+  so comments and strings that name it do not count.
+"""
+
+from __future__ import annotations
+
+import ast
+import logging
+import pathlib
+from unittest import mock
+
+import pytest
+
+from sglang.srt.managers.scheduler import Scheduler
+from sglang.srt.observability import sbr_phase_timing as spt
+from sglang.srt.runtime_context import get_parallel
+
+SRT = pathlib.Path(__file__).resolve().parents[3] / "python" / "sglang" / "srt"
+RETIRED = {"ps", "_ps"}
+
+# The attributes init_batch_result_processor hands to SchedulerBatchResultProcessor and the
+# phase-timing line, each set on the stand-in; nothing else is.
+_ATTRS = (
+    "is_generation",
+    "disaggregation_mode",
+    "enable_overlap",
+    "enable_overlap_mlx",
+    "model_config",
+    "token_to_kv_pool_allocator",
+    "hisparse_coordinator",
+    "req_to_token_pool",
+    "decode_offload_manager",
+    "metrics_collector",
+    "metrics_reporter",
+    "draft_worker",
+    "model_worker",
+    "output_streamer",
+    "beam_coordinator",
+)
+
+
+class FakeRadixCache:
+    pass
+
+
+def _stand_in(hisparse: bool = False) -> Scheduler:
+    sched = Scheduler.__new__(Scheduler)
+    for name in _ATTRS:
+        setattr(sched, name, mock.MagicMock(name=name))
+    sched.tree_cache = FakeRadixCache()
+    sched.enable_hisparse = hisparse
+    sched.init_beam_coordinator = lambda: None
+    return sched
+
+
+def _cache_lines(caplog):
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.name == spt.logger.name and r.getMessage().startswith("sbr-phase-cache ")
+    ]
+
+
+@pytest.fixture
+def detail(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    monkeypatch.setattr(spt, "DETAIL", True)
+    monkeypatch.setattr(spt, "GATE_FILE", "")
+
+
+def test_the_stand_in_has_no_retired_record():
+    assert not hasattr(_stand_in(), "ps")
+
+
+@pytest.mark.parametrize("hisparse", [False, True])
+def test_detail_on_attn_tp_rank_zero_logs_the_cache_class(detail, caplog, hisparse):
+    caplog.set_level(logging.INFO, logger=spt.logger.name)
+    with get_parallel().override(attn_tp_rank=0):
+        _stand_in(hisparse).init_batch_result_processor()
+    assert _cache_lines(caplog) == [
+        f"sbr-phase-cache class=FakeRadixCache hisparse={hisparse}"
+    ]
+
+
+def test_detail_on_another_attn_tp_rank_logs_nothing(detail, caplog):
+    caplog.set_level(logging.INFO, logger=spt.logger.name)
+    with get_parallel().override(attn_tp_rank=3):
+        _stand_in().init_batch_result_processor()
+    assert _cache_lines(caplog) == []
+
+
+def test_detail_off_never_reads_the_rank(monkeypatch, caplog):
+    """Off, the guard short-circuits before ``get_parallel()``: a scheduler that has not
+    stamped its ranks yet still builds its result processor."""
+    monkeypatch.setattr(spt, "ENABLED", True)
+    monkeypatch.setattr(spt, "DETAIL", False)
+    caplog.set_level(logging.INFO, logger=spt.logger.name)
+    sched = _stand_in()
+    sched.init_batch_result_processor()
+    assert sched.batch_result_processor is not None
+    assert _cache_lines(caplog) == []
+
+
+def _retired_reads():
+    hits = []
+    for path in sorted(SRT.rglob("*.py")):
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"), str(path))
+        except SyntaxError:
+            continue
+        for node in ast.walk(tree):
+            if (
+                isinstance(node, ast.Attribute)
+                and node.attr in RETIRED
+                and not isinstance(node.ctx, ast.Store)
+            ):
+                hits.append(f"{path.relative_to(SRT)}:{node.lineno} .{node.attr}")
+    return hits
+
+
+def test_no_code_reads_the_retired_parallel_record():
+    assert SRT.is_dir(), SRT
+    assert not (SRT / "distributed" / "parallel_state_wrapper.py").exists()
+    assert _retired_reads() == []
