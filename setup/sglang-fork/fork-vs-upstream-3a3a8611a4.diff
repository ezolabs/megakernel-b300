+    with mock.patch.object(scheduler_module, "retract_all") as retract_all:
+        Scheduler.pause_generation(s, SimpleNamespace(mode="retract"))
+    assert retract_all.call_args.kwargs["reqs"] == [cold, giant]
+    assert [c.args[0] for c in s._add_request_to_queue.call_args_list] == [
+        cold,
+        giant,
+    ]
+    assert e.swap.parked is None and s.chunked_req is None
+
+
+def test_the_swap_state_is_built_only_when_on(cache, engine):
+    # Off, the scheduler holds no swap state, so every pass is 0022's.
+    assert engine(cache, [], _giant(cache), short_prefill_swap_limit=0).swap is None
+    on = SimpleNamespace(**PROFILE)
+    assert isinstance(short_prefill.chunk_swap_for(on), short_prefill.ChunkSwap)
+    off = SimpleNamespace(**{**PROFILE, "short_prefill_swap_limit": 0})
+    assert short_prefill.chunk_swap_for(off) is None
+    unprotected = SimpleNamespace(**{**PROFILE, "short_prefill_token_threshold": 0})
+    assert short_prefill.chunk_swap_for(unprotected) is None
+
+
+def _box_c_args(**kw):
+    options = dict(
