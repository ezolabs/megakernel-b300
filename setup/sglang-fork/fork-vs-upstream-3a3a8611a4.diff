+# --------------------------------------------------------------------------------------
+# 0036: the router's per-image hashes (mm_hashes) on the chat door
+# --------------------------------------------------------------------------------------
+
+
+def _router_hashes(count: int) -> List[str]:
+    """Per-image hashes as the router sends them: 16 hex digits, one per image in message
+    order, each above 2**30 so that the pad value's modulo is exercised."""
+    return [f"{(i + 1) * 0x9E3779B97F4A7C15 % (1 << 64):016x}" for i in range(count)]
+
+
+def _tokenized_mm(processor, adapted: GenerateReqInput):
+    """The multimodal inputs ``TokenizerManager._tokenize_one_request`` hands the scheduler for
+    an adapted chat request. The method is the real one, on a bare manager, with the real
+    processor and the caller-hash block; only the two steps after the block are stubbed (the
+    length check and the tokenized object), and neither reads a hash."""
+    from sglang.srt.managers import tokenizer_manager as tm_mod
+
+    manager = tm_mod.TokenizerManager.__new__(tm_mod.TokenizerManager)
+    manager.mm_processor = processor
+    manager.max_req_input_len = 10**9
+    manager.model_config = types.SimpleNamespace(
+        hf_config=types.SimpleNamespace(architectures=["DeepseekV4ForCausalLM"])
+    )
+    def _validated(obj, input_ids):
+        return None
+
+    def _created(
+        obj, input_text, input_ids, input_embeds=None, mm_inputs=None, token_type_ids=None
+    ):
+        return mm_inputs
+
+    manager._validate_one_request = _validated
+    manager._create_tokenized_object = _created
+    with pytest.MonkeyPatch.context() as patch:
+        patch.setattr(
+            tm_mod,
+            "get_mm",
+            lambda: types.SimpleNamespace(limit_mm_data_per_request=None),
+        )
+        patch.setattr(
+            tm_mod,
+            "get_disagg",
+            lambda: types.SimpleNamespace(
+                language_only=False,
+                language_model_only=False,
+                encoder_transfer_backend=None,
+            ),
+        )
+        return asyncio.run(tm_mod.TokenizerManager._tokenize_one_request(manager, adapted))
+
+
+def test_the_routers_mm_hashes_reach_the_request_on_both_paths(tokenizer, box_c_env):
+    """The door: ``mm_hashes`` in the body is the request's ``mm_hashes``, in image order, on
+    the messages path and on the ``input_ids`` path, which never encodes; a body without it
+    has none."""
+    chat = _mm_chat(tokenizer)
+    for record in _image_records():
+        ids = _ids_of(record, "ids")
+        hashes = _router_hashes(len(_urls_in_message_order(record["egress"]["messages"])))
+        # the router's hashes are in message order: each moves with its image into the render's order
+        ordered = [hashes[i] for i in _render_order_of(record["egress"]["messages"])]
+        body = dict(record["egress"], mm_hashes=hashes)
+        by_messages, _, _ = _convert(chat, body)
+        by_ids, _, encoded = _convert(chat, body, ids)
+        assert by_messages.mm_hashes == ordered, record["id"]
+        assert by_ids.mm_hashes == ordered and encoded == [], record["id"]
+        plain, _, _ = _convert(chat, record["egress"], ids)
+        assert plain.mm_hashes is None, record["id"]
+
+
+def test_the_routers_mm_hashes_set_each_images_pad_value_over_its_offsets(
+    tokenizer, mm_processor, box_c_env
+):
+    """The engine: with ``mm_hashes`` each image's hash is the router's, its pad values are
+    the wide sentinels upstream derives from that hash (#43043; they replaced
+    ``1_000_000 + hash % 2**30``), and the scheduler's padding writes them over every offset
+    of that image, on both paths."""
+    from sglang.srt.managers.schedule_batch import (
+        MultimodalProcessorOutput,
+        _compute_pad_values,
+    )
+
+    chat = _mm_chat(tokenizer)
+    for record in _image_records():
+        ids = _ids_of(record, "ids")
+        hashes = _router_hashes(len(_urls_in_message_order(record["egress"]["messages"])))
+        ordered = [hashes[i] for i in _render_order_of(record["egress"]["messages"])]
+        body = dict(record["egress"], mm_hashes=hashes)
+        for shape, adapted in (
+            ("messages", _convert(chat, body)[0]),
+            ("ids", _convert(chat, body, ids)[0]),
+        ):
+            mm = _tokenized_mm(mm_processor, adapted)
+            items = mm.mm_items
+            assert [item.hash for item in items] == [int(h, 16) for h in ordered], (
+                record["id"],
+                shape,
+            )
+            assert [item.pad_values for item in items] == [
+                _compute_pad_values(int(h, 16).to_bytes(8, byteorder="big"))
+                for h in ordered
+            ], (record["id"], shape)
+            # each hash is its image's: the k-th item is the k-th image of the render, by its feature
+            assert [list(item.feature.shape) for item in items] == record["feature_shapes"], (
+                record["id"],
+                shape,
+            )
+            padded = MultimodalProcessorOutput.build_padded_input_ids(
+                list(mm.input_ids), items
+            )
+            for item in items:
+                for start, end in item.offsets:
+                    assert padded[start : end + 1] == item.padding_sequence(
+                        end - start + 1
+                    ), (record["id"], shape)
+
