+def test_metrics_are_flushed_on_a_poll_only():
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate, log_poll_metrics
+
+    collector = MagicMock()
+    gate = HiCachePollGate(lambda: False, heartbeat_calls=3)
+    gate.arm()
+    for _ in range(3):
+        log_poll_metrics(collector, gate.should_poll(), gate)
+    assert collector.increment_hicache_event_polls.call_args_list == [
+        ((), {"outcome": "polled", "count": 1}),
+        ((), {"outcome": "skipped", "count": 2}),
+    ]
+    log_poll_metrics(None, True, gate)  # no collector: nothing to do
