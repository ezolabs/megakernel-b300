+def test_startup_gates():
+    tree = _swa_cache()
+    alloc = tree.token_to_kv_pool_allocator
+
+    def refusal(v41=True, **over):
+        return startup_refusal(
+            is_deepseek_v41_paged_swa=v41,
+            tree_cache=tree,
+            allocator=alloc,
+            args=_gate_args(**over),
+        )
+
+    assert refusal() is None  # box-c's shape: DSpark, fcfs, no HiCache L3
+    assert refusal(speculative_algorithm=None) is None
+    assert refusal(hicache_host_memory_mode="cache") is None  # HiCache L2 is fine
+    assert refusal(v41=False) == "DeepSeek-V4.1 on the paged SWA pool"
+    for over, why in (
+        (dict(disaggregation_mode="prefill"), "no PD disaggregation"),
+        (dict(enable_dp_attention=True), "no DP attention"),
+        (dict(attn_cp_size=2), "no context parallelism"),
+        (dict(dcp_size=2), "no context parallelism"),
+        (dict(enable_mixed_chunk=True), "no mixed prefill/decode"),
+        (dict(enable_session_radix_cache=True), "no radix sessions"),
+        (dict(enable_unified_memory=True), "no unified memory"),
+        (dict(enable_lora=True), "no LoRA"),
+        (
+            dict(enable_unified_cache_external_linker=True),
+            "no an external cache linker",
+        ),
+        (dict(hicache_storage_backend="file"), "no a HiCache storage backend (L3)"),
+        (
+            dict(hicache_host_memory_mode="buffer_only"),
+            "no HiCache buffer-only host memory",
+        ),
+        (
+            dict(enable_decoder_swa_bounded_replay=True),  # the lossy tail
+            "no --enable-decoder-swa-bounded-replay without "
+            "SGLANG_DSV4_EXACT_DECODER_TRIM",
+        ),
+        (
+            dict(enable_encoder_swa_bounded_replay=True),
+            "no --enable-encoder-swa-bounded-replay",
+        ),
+        (dict(dllm_algorithm="x"), "no a dLLM algorithm"),
+        (dict(pp_size=2), "no pipeline parallelism"),
+        (
+            dict(speculative_algorithm="EAGLE"),
+            "no speculative decoding other than DSpark",
+        ),
+    ):
+        assert refusal(**over) == why, over
+    # The exact trim lets decoder bounded replay through (rebuild_mode), with
+    # the same helper the backend and the radix cache read.
+    assert not exact_trim_enabled(True)
+    with envs.SGLANG_DSV4_EXACT_DECODER_TRIM.override(True):
+        assert exact_trim_enabled(True) and not exact_trim_enabled(False)
+        assert refusal(enable_decoder_swa_bounded_replay=True) is None
+        assert refusal() is None  # the flag alone is not a decoder tail
+        for over in (
+            dict(enable_encoder_swa_bounded_replay=True),
+            dict(
+                enable_decoder_swa_bounded_replay=True,
+                enable_encoder_swa_bounded_replay=True,
+            ),
+        ):
+            # Encoder bounded replay stays refused.
+            assert refusal(**over) == "no --enable-encoder-swa-bounded-replay"
+    assert (
+        startup_refusal(
+            is_deepseek_v41_paged_swa=True,
+            tree_cache=SimpleNamespace(),
+            allocator=alloc,
+            args=_gate_args(),
+        )
+        == "the unified radix cache"
+    )
+    with mock.patch.object(
+        type(alloc), "swa_req_ring", new_callable=mock.PropertyMock, return_value=True
+    ):
+        assert refusal() == "the static SWA allocator"
+    with mock.patch(
+        "sglang.srt.mem_cache.allocator.page_interleave.page_interleave_shard_size",
+        return_value=2,
+    ):
+        assert refusal() == "no logical-page KV sharding"
