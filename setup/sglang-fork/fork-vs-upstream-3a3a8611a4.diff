+        return len(self.mediums)
+
+    def extend(self, other: "SnapshotCut") -> None:
+        """Append ``other``'s announcements after this cut's."""
+        self.mediums += other.mediums
+        self.parents += other.parents
+        self.seeds += other.seeds
+        self.lora_names += other.lora_names
+        self.hashes += other.hashes
+        self.raws += other.raws
+        self.lens += other.lens
+        self.bigrams += other.bigrams
+        self.salts += other.salts
+        self.num_blocks += other.num_blocks
+        self.num_tokens += other.num_tokens
+
+
+def render_snapshot_frames(
+    cut: SnapshotCut,
+    *,
+    max_frame_tokens: Optional[int] = None,
+    max_frame_pages: Optional[int] = None,
+    pace: Optional[Callable[[], None]] = None,
