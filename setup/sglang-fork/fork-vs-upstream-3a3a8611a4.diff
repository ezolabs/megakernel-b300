+def test_a_failed_render_closes_the_window_short_and_flushes_the_held_steps(
+    monkeypatch,
+):
+    cache, allocator, *_ = _hicache_tree()
+    mirror = _Mirror()
+    mirror.apply(KVEventBatch(ts=0.0, events=cache.take_events()))
+    publisher = _Publisher(snapshot_requests=1)
+    component = _off_loop(cache, publisher)
+    gate = _Gate(monkeypatch, release_first=1, fail_after=1)
+
+    component.publish_kv_events()
+    render = component.snapshot_render
+    publisher.wait_for(1)
+    _insert(cache, allocator, [31, 32, 33])
+    component.publish_kv_events()
+    gate.open()
+    assert render.join(WAIT_S)
+    assert isinstance(render.error, RuntimeError)
+
+    kinds = [_kinds(b) for b in publisher.batches]
+    assert kinds[0][0] == "SnapshotBegin"
+    assert kinds[1] == ["SnapshotEnd"]  # closed short: the claim is not met
+    assert kinds[2] == ["BlockStored"]  # the held step, after the window
+    for batch in publisher.batches:
+        mirror.apply(batch)
+    assert [v for v, _ in mirror.baselines] == ["refused"]
+    assert mirror.live == _truth(cache)
+
+    # The component recovers: the next request renders a whole snapshot.
+    monkeypatch.undo()
+    publisher.pending = 1
+    component.publish_kv_events()
+    again = component.snapshot_render
+    assert again is not None and again is not render
+    assert again.join(WAIT_S) and again.error is None
