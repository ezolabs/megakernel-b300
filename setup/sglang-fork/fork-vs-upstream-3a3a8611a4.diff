+    def test_usage_without_generation_omits_prompt_cache_counts(self):
+        usage = UsageInfo(prompt_tokens=3, total_tokens=3)
+        for dumped in (usage.model_dump(), json.loads(usage.model_dump_json())):
+            self.assertNotIn("prompt_cache_hit_tokens", dumped)
+            self.assertNotIn("prompt_cache_miss_tokens", dumped)
+
+    def test_final_stream_chunks_carry_prompt_cache_counts(self):
+        usage = UsageProcessor.calculate_token_usage(
+            prompt_tokens=45,
+            completion_tokens=58,
+            cached_tokens=PromptTokensDetails(cached_tokens=40),
+        )
+        chunk = ChatCompletionStreamResponse(id="x", model="m", choices=[], usage=usage)
+        completion_chunk = CompletionStreamResponse(
+            id="x", model="m", choices=[], usage=usage
+        )
+        for payload in (
+            chunk.model_dump_json(),
+            completion_chunk.model_dump_json(exclude_none=True),
+        ):
+            with self.subTest(payload=payload[:40]):
+                dumped = json.loads(payload)["usage"]
+                self.assertEqual(dumped["prompt_cache_hit_tokens"], 40)
+                self.assertEqual(dumped["prompt_cache_miss_tokens"], 5)
+
 
