index 0000000000..56a9c221d4
--- /dev/null
+++ b/.github/workflows/fork-runner-guard.yml
@@ -0,0 +1,35 @@
+name: Fork Runner Guard
+
+# Fork-only (<sglang-fork>): fails when an upstream merge brings back a
+# schedule trigger or a GitHub-hosted runner label in a fork-reachable workflow.
+# Fix: python3 .github/fork/self_hosted_runners.py --apply, then commit.
+
+on:
+  push:
+    branches: [prod]
+    paths: ['.github/**']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  guard:
+    if: github.repository == '<sglang-fork>'
+    runs-on: arc-sglang
+    timeout-minutes: 10
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      # The stock ARC runner image ships without python3.
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: Test the rewrite script
+        run: python3 .github/fork/test_self_hosted_runners.py -v
+
+      - name: Check workflows
+        run: python3 .github/fork/self_hosted_runners.py --check
diff --git a/.github/workflows/fork-runner-image.yml b/.github/workflows/fork-runner-image.yml
new file mode 100644
index 0000000000..ba64c495a2
--- /dev/null
+++ b/.github/workflows/fork-runner-image.yml
@@ -0,0 +1,155 @@
+name: Fork Runner Image
+
+# Fork-only (<sglang-fork>): builds the arc-sglang runner image from
+# .github/fork/runner-image and pushes it to ghcr.io.
+#
+# When: on dispatch, and weekly. The image freezes its versions at build
+# time: the actions-runner base (GitHub stops sending jobs to runners that
+# fall too far behind), Rust stable from rustup, gh, and the Ubuntu
+# packages. Each run builds from the newest actions-runner:latest digest
+# with no build cache, so none of them is more than a week old. A new
+# digest reaches the pool only when the cosmos repo's
+# .github/runner-image/arc-sglang.values.yaml pins it (the job summary
+# prints the pin).
+#
+# Gate: before anything is pushed, the image is loaded into the job's
+# Docker and run as the pod runs it (its own USER, uid 1001 in the docker
+# group, 123), ending in ARC's start command /home/runner/run.sh, which
+# with no registration must reach the listener's "Not configured" error,
+# not crash. The push reuses the gated build's cache, and the run fails
+# unless the pushed digest's layers equal the gated image's.
+
+on:
+  workflow_dispatch:
+  # Mondays 05:17 UTC.
+  schedule:
+    - cron: '17 5 * * 1'
+
+permissions:
+  contents: read
+  packages: write
+
+concurrency:
+  group: fork-runner-image
+  cancel-in-progress: false
+
+jobs:
+  build:
+    if: github.repository == '<sglang-fork>'
+    runs-on: arc-sglang
+    timeout-minutes: 60
+    env:
+      IMAGE: ghcr.io/<sglang-fork-owner>/arc-sglang-runner
+      BASE_REF: ghcr.io/actions/actions-runner:latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Log in to ghcr.io
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          ACTOR: ${{ github.actor }}
+        run: echo "$GITHUB_TOKEN" | docker login ghcr.io -u "$ACTOR" --password-stdin
+
+      - name: Resolve the base
+        id: base
+        run: |
+          set -uo pipefail
+          for attempt in 1 2 3; do
+            if digest=$(docker buildx imagetools inspect "$BASE_REF" --format '{{.Manifest.Digest}}'); then
+              break
+            fi
+            [ "$attempt" -lt 3 ] || { echo "::error::could not resolve $BASE_REF to a digest"; exit 1; }
+            sleep 30
+          done
+          [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "::error::$BASE_REF resolved to '$digest', not a digest"; exit 1; }
+          echo "base: $BASE_REF = $digest"
+          echo "base=${BASE_REF%:*}@$digest" >> "$GITHUB_OUTPUT"
+
+      - name: Build, gate and push
+        env:
+          BASE: ${{ steps.base.outputs.base }}
+        run: |
+          set -uo pipefail
+          # `<sha>-<run id>-<attempt>` is this attempt's alone (a re-run keeps
+          # the run id), so every pushed digest keeps a tag; `<sha>` moves to
+          # the newest build of that commit.
+          tag="$IMAGE:$GITHUB_SHA-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
+          moving="$IMAGE:$GITHUB_SHA"
+          gated="arc-sglang-runner:gate-${GITHUB_SHA::12}"
+          metadata="$RUNNER_TEMP/build-metadata.json"
+          build_args=(
+            --progress=plain
+            --platform linux/amd64
+            --provenance=false
+            --build-arg "RUNNER_IMAGE=$BASE"
+            --label "org.opencontainers.image.revision=$GITHUB_SHA"
+            --label "org.opencontainers.image.base.name=$BASE"
+          )
+
+          # 1. The gate copy, in the job's Docker only, built from scratch so
+          #    apt, rustup and gh hand out today's versions.
+          docker buildx build "${build_args[@]}" --no-cache --load -t "$gated" .github/fork/runner-image \
+            || { echo "::error::the gate build failed"; exit 1; }
+
+          # 2. The gate: the image's own USER, no --user, as the pod runs it.
+          user=$(docker image inspect "$gated" --format '{{.Config.User}}')
+          [ "$user" = runner ] || { echo "::error::the image's USER is '$user', not runner"; exit 1; }
+          gate_script=$(cat <<'GATE'
+          fail() { echo "gate: $*" >&2; exit 1; }
+          [ "$(id -u)" = 1001 ] || fail "runs as uid $(id -u), not the runner's 1001"
+          id -G | tr ' ' '\n' | grep -qx 123 || fail "uid 1001 is not in the docker group (123): $(id)"
+          notrunner=$(find /home/runner -xdev ! -user runner -print)
+          [ -z "$notrunner" ] || fail "not owned by runner under /home/runner: $notrunner"
+          version=$(/home/runner/bin/Runner.Listener --version 2>&1 | grep -Ex '[0-9]+\.[0-9]+\.[0-9]+' | tail -n 1)
+          [ -n "$version" ] || fail "Runner.Listener --version printed no x.y.z"
+          test -w /home/runner/_diag || fail "/home/runner/_diag is not writable by uid 1001: $(ls -ld /home/runner/_diag)"
+          out=$(timeout 300 /home/runner/run.sh 2>&1)
+          rc=$?
+          echo "::group::run.sh (unregistered), exit $rc"
+          echo "$out"
+          echo "::endgroup::"
+          [ "$rc" != 124 ] || fail "run.sh still running after 300 s"
+          ! grep -Eq 'UnauthorizedAccessException|Unhandled exception|Aborted' <<<"$out" || fail "run.sh: the listener crashed (log above)"
+          grep -q 'Not configured' <<<"$out" || fail "run.sh never reached the listener's 'Not configured' (log above)"
+          echo "gate: passed: Runner.Listener $version as uid 1001, run.sh reached 'Not configured'"
+          GATE
+          )
+          docker run --rm --platform linux/amd64 "$gated" bash -c "$gate_script" \
+            || { echo "::error::the gate failed: the runner cannot start as the pod starts it (log above). Nothing was pushed"; exit 1; }
+          versions=$(docker run --rm --platform linux/amd64 "$gated" bash -c '
+            echo "| actions-runner | $(/home/runner/bin/Runner.Listener --version 2>/dev/null | grep -Ex "[0-9]+\.[0-9]+\.[0-9]+" | tail -n 1) |"
+            echo "| rustc | $(rustc --version) |"
+            echo "| gh | $(gh --version | head -n 1) |"
+            echo "| python3 | $(python3 --version) |"
+            echo "| git | $(git --version) |"
+            echo "| os | $(. /etc/os-release && echo "$PRETTY_NAME") |"')
+
+          # 3. The push, from the gate build's cache.
+          docker buildx build "${build_args[@]}" --push -t "$tag" -t "$moving" --metadata-file "$metadata" .github/fork/runner-image \
+            || { echo "::error::the push build failed"; exit 1; }
+          digest=$(jq -r '."containerimage.digest" // empty' "$metadata")
+          [[ -n $digest ]] || digest=$(docker buildx imagetools inspect "$tag" --format '{{.Manifest.Digest}}')
+          [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "::error::no image digest in $metadata"; exit 1; }
+          pushed_layers=$(docker buildx imagetools inspect "$IMAGE@$digest" --format '{{json .Image.RootFS.DiffIDs}}' | jq -c .)
+          gated_layers=$(docker image inspect "$gated" --format '{{json .RootFS.Layers}}' | jq -c .)
+          if [ -z "$pushed_layers" ] || [ "$pushed_layers" != "$gated_layers" ]; then
+            echo "::error::$IMAGE@$digest is not the image the gate ran (layers $pushed_layers, gated $gated_layers): do not pin it"
+            exit 1
+          fi
+
+          echo "Pushed $tag ($moving)"
+          echo "Digest: $digest"
+          {
+            echo "### arc-sglang runner image"
+            echo
+            echo "- Tags: \`$tag\`, \`$moving\` (moves to the newest build of this commit)"
+            echo "- Digest: \`$digest\`"
+            echo "- Pin: \`$IMAGE@$digest\`"
+            echo "- Base: \`$BASE\`"
+            echo "- Gate: passed (run.sh as uid 1001 reached 'Not configured')"
+            echo
+            echo "| tool | version |"
+            echo "| --- | --- |"
+            echo "$versions"
+          } >> "$GITHUB_STEP_SUMMARY"
