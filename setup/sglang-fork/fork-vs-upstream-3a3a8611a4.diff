+    def test_random_transcripts_concatenate_and_never_restate(self):
+        """2,500 random answers at every chunk size: each call the stream
+        completes is byte for byte the one-shot parse's, in order and with
+        none missing; every other call the stream sent is counted broken and
+        never a JSON object; and no fragment restates the arguments sent
+        before it (_assemble feeds them through the serving router's reading)."""
+        rng = random.Random(20261020)
+        for case in range(RANDOM_CASES):
+            detector_cls = rng.choice(DETECTORS)
+            text = _random_transcript(rng, detector_cls)
+            one_shot = detector_cls().detect_and_parse(text, self.tools)
+            want = [(c.name, c.parameters) for c in one_shot.calls]
+            for size in CHUNK_SIZES:
