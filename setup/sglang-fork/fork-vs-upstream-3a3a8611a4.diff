--- /dev/null
+++ b/test/registered/unit/mem_cache/unified_radix_cache/test_swa_interior_first_eviction.py
@@ -0,0 +1,170 @@
+"""SGLANG_SWA_EVICT_INTERIOR_FIRST: SWA device eviction tombstones the tails
+of nodes that already have a child before any leaf tail, LRU within each
+class. Off, the walk is the single LRU pass.
+
+Tree used throughout (sliding window 4, page 1, 4-token nodes), inserted in
+this order so the SWA LRU runs, oldest first, X, Y, Z, W, V:
+
+    X            leaf tail, oldest
+    Y -> Z       Y interior, Z leaf
+    W -> V       W interior, V leaf
+"""
+
+import unittest
+from array import array
+from unittest import mock
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.mem_cache.base_prefix_cache import EvictParams, InsertParams
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.components.base import ComponentType
+from sglang.test.ci.ci_register import register_amd_ci, register_cuda_ci
+from sglang.test.kits.unified_radix_cache import fixtures as fixtures_mod
+from sglang.test.kits.unified_radix_cache.config import CacheConfig
+from sglang.test.kits.unified_radix_cache.fixtures import (
+    build_fixture,
+    match_prefix,
+    node_device_lock_ref,
+    node_device_value,
+    node_token_ids,
+)
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=5, stage="base-b", runner_config="1-gpu-small")
+register_amd_ci(est_time=5, suite="stage-b-test-1-gpu-small-amd")
+
+SWA = ComponentType.SWA
+
+X = [1, 2, 3, 4]
+Y = [101, 102, 103, 104]
+Z = [105, 106, 107, 108]
+W = [201, 202, 203, 204]
+V = [205, 206, 207, 208]
+NAMES = {1: "X", 101: "Y", 105: "Z", 201: "W", 205: "V"}
+
+LEGACY_ORDER = ["X", "Y", "Z", "W", "V"]
+INTERIOR_FIRST_ORDER = ["Y", "W", "X", "Z", "V"]
+
+
+class TestSWAInteriorFirstEviction(CustomTestCase):
+    cfg = CacheConfig(
+        page_size=1,
+        components=(ComponentType.FULL, SWA),
+        sliding_window_size=4,
+    )
+
+    def setUp(self):
+        if not torch.cuda.is_available():
+            # Pure tree bookkeeping: host tensors are enough off-GPU.
+            patcher = mock.patch.object(fixtures_mod, "get_device", return_value="cpu")
+            patcher.start()
+            self.addCleanup(patcher.stop)
+
+    def _build(self):
+        cache, allocator, _ = build_fixture(self.cfg, tree_core_backend="python")
+        for tokens in (X, Y, Y + Z, W, W + V):
+            value = allocator.alloc(len(tokens))
+            cache.insert(InsertParams(key=RadixKey(array("q", tokens)), value=value))
+        return cache
+
+    def _name(self, cache, node_id):
+        return NAMES[node_token_ids(cache, node_id)[0]]
+
+    def _lru_oldest_first(self, cache):
+        ids = cache.tree_core.get_component_device_lru_node_ids(SWA)
+        return [self._name(cache, i) for i in reversed(ids)]
+
+    def _record_swa_evictions(self, cache):
+        """Names of nodes whose SWA device value is freed, in order."""
+        tree_core = cache.tree_core
+        log = []
+        orig = tree_core._evict_component_and_detach_lru
+
+        def record(node, component, *args, **kwargs):
+            if (
+                component.component_type == SWA
+                and node.component_data[SWA].value is not None
+            ):
+                log.append(NAMES[node.key.token_ids[0]])
+            return orig(node, component, *args, **kwargs)
+
+        tree_core._evict_component_and_detach_lru = record
+        return log
+
+    def _evict_all_one_token_at_a_time(self, cache, log):
+        while True:
+            before = len(log)
+            cache.evict(EvictParams(num_tokens=0, swa_num_tokens=1))
+            if len(log) == before:
+                return
+
+    def _run(self, interior_first: bool):
+        with envs.SGLANG_SWA_EVICT_INTERIOR_FIRST.override(interior_first):
+            cache = self._build()
+            self.assertEqual(self._lru_oldest_first(cache), LEGACY_ORDER)
+            log = self._record_swa_evictions(cache)
+            self._evict_all_one_token_at_a_time(cache, log)
+            cache.sanity_check()
+        return log
+
+    def test_flag_off_matches_legacy_lru_order(self):
+        self.assertEqual(self._run(interior_first=False), LEGACY_ORDER)
+
+    def test_flag_off_one_big_request_matches_legacy(self):
+        with envs.SGLANG_SWA_EVICT_INTERIOR_FIRST.override(False):
+            cache = self._build()
+            log = self._record_swa_evictions(cache)
+            cache.evict(EvictParams(num_tokens=0, swa_num_tokens=12))
+        self.assertEqual(log, LEGACY_ORDER[:3])
+
+    def test_interior_tails_go_before_leaf_tails(self):
+        self.assertEqual(self._run(interior_first=True), INTERIOR_FIRST_ORDER)
+
+    def test_lru_within_each_class(self):
+        log = self._run(interior_first=True)
+        interiors = [n for n in log if n in ("Y", "W")]
+        leaves = [n for n in log if n in ("X", "Z", "V")]
+        self.assertEqual(interiors, ["Y", "W"])
+        self.assertEqual(leaves, ["X", "Z", "V"])
+
+    def test_interior_tombstone_keeps_full_kv_and_stops_at_budget(self):
+        with envs.SGLANG_SWA_EVICT_INTERIOR_FIRST.override(True):
+            cache = self._build()
+            log = self._record_swa_evictions(cache)
+            cache.evict(EvictParams(num_tokens=0, swa_num_tokens=8))
+            self.assertEqual(log, ["Y", "W"])
+            # The older leaf X keeps its window; Y keeps its Full KV.
