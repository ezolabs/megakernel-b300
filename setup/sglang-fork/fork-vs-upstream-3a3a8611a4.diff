+def test_on_every_stage_is_stamped_and_the_deltas_telescope(detail, caplog):
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    sender = _Sender()
+    streamer = _streamer(sender)
+    req = _arrive(rid="rid-9", length=8, cached=5, age=1.0)
+    batch, result = _prefill_batch([req], [7])
+    with _scheduler_runtime():
+        processor = _processor(streamer)
+        processor.process_batch_result_prefill(batch, result)
+        # The first output went out with the prefill; the request finishes later.
+        assert [s for s in req.sbr_phase.stamps if s != "finished"] == [
+            "recv",
+            "tokenize_done",
+            "dispatch",
+            "sched_recv",
+            "match_prefix_done",
+            "alloc_done",
+            "first_token",
+            "cache_start",
+            "cache_done",
+            "stream_start",
+            "payload_built",
+            "first_send",
+        ]
+        assert _lines(caplog, "sbr-phase") == []  # not finished: no line yet
+        req.finished_reason = mock.Mock(to_json=lambda: {"type": "length"})
+        streamer.stream_output([req], False)
+
+    (line,) = _lines(caplog, "sbr-phase")
+    m = LINE_RE.match(line)
+    assert m, line
+    assert (m["rid"], int(m["prompt"]), int(m["cached"]), int(m["uncached"])) == (
+        "rid-9",
+        8,
+        5,
+        3,
+    )
+    assert _delta_names(m["deltas"]) == SCHEDULER_DELTAS
+    _assert_telescopes(m)
+    assert float(m["wall"]) >= 1000.0  # recv was stamped a second back
+    # recv_at is the first stamp, the tokenizer's created_time carried over the wire.
+    assert float(m["recv_at"]) == pytest.approx(req.sbr_phase.stamps["recv"], abs=1e-6)
+    assert m["recv_at"] == f"{req.sbr_phase.stamps['recv']:.6f}"
+    # Stage order in time, not only in the names.
+    st = req.sbr_phase.stamps
+    ordered = [st[s] for s in spt.STAGES if s in st]
+    assert ordered == sorted(ordered)
