new file mode 100644
index 0000000000..e970eb9a0f
--- /dev/null
+++ b/python/sglang/srt/entrypoints/openai/sbr_schema_memo.py
@@ -0,0 +1,151 @@
+"""Memoised ``check_schema`` for tool ``parameters`` schemas (part 0040).
+
+``OpenAIServingChat._validate_request`` checks every tool's ``parameters`` against
+the JSON Schema 2020-12 metaschema on every request. That check costs about
+0.15 ms per schema node (0.8 ms for a six-node tool) and a coding agent sends the
+same tool schemas, unchanged, on every turn of every chat. With the memo on, a
+schema that already passed is not checked again::
+
+    key = sha256(json.dumps(schema, sort_keys=True, separators=(",", ":")))
+
+taken after ``normalize_json_schema_types`` has rewritten it in place, i.e. on the
+exact dict ``check_schema`` would see. Whether a schema is valid against the
+metaschema depends on its content alone, and the canonical JSON is a faithful
+encoding of that content (key order dropped; ``1``, ``1.0`` and ``true`` stay
+distinct), so a hit returns what the check would have returned: nothing.
+
+- Only a pass is stored. A schema that fails is checked again on every request
+  and raises ``SchemaError`` (or ``RecursionError``) exactly as without the memo.
+- A schema the key cannot be computed for (not JSON-encodable, cyclic, nested past
+  the recursion limit) is checked as without the memo and not stored.
+- The table is an LRU of at most ``MAX_ENTRIES`` keys (a hit refreshes its key),
+  guarded by a lock, so it is safe from any thread.
+
+Two settings (``environ.py``, read once at import): ``SGLANG_SBR_SCHEMA_MEMO``
+(``EnvBool``, default off) and ``SGLANG_SBR_SCHEMA_MEMO_GATE_FILE`` (``EnvStr``):
+when set, the memo is on only while that path exists, looked up at most once per
+second per process (0039's gate rule, ``sbr_phase_timing.RecheckedPathGate``), so
+a measurement can switch it on and off without a restart. While it is off the
+table is kept, not cleared: its entries stay true, and re-opening the gate starts
+warm. Off, ``_validate_request`` calls ``Draft202012Validator.check_schema`` on
+every tool as before; the memo's only cost there is one global test per request
+(and, with a gate path, the at-most-once-a-second ``stat``).
+
+While on, one INFO line per ``LOG_INTERVAL_S`` (60 s)::
+
+    sbr-schema-memo hits=<n> misses=<n> entries=<n>
+
+``hits`` / ``misses`` count the lookups since the previous line (a miss is every
+call that reached ``check_schema``, pass or fail); ``entries`` is the table's size
+now. The line is written by the first lookup at least 60 s after the window
+opened (the first lookup ever, or the previous line), so it needs traffic: an idle
+server logs nothing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import threading
+import time
+from collections import OrderedDict
+from typing import Any, Callable, Optional
+
+from jsonschema import Draft202012Validator
+
+from sglang.srt.environ import envs
+from sglang.srt.observability.sbr_phase_timing import RecheckedPathGate
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "sbr-schema-memo"
+
+# Read once at import, like 0038/0039's flags.
+ENABLED: bool = envs.SGLANG_SBR_SCHEMA_MEMO.get()
+GATE = RecheckedPathGate(envs.SGLANG_SBR_SCHEMA_MEMO_GATE_FILE.get())
+
+MAX_ENTRIES: int = 4096
+LOG_INTERVAL_S: float = 60.0
+
+# The counter line's clock, a module attribute so a test can inject it.
+_clock: Callable[[], float] = time.monotonic
+
+_lock = threading.Lock()
+_valid: OrderedDict[str, None] = OrderedDict()
+_hits = 0
+_misses = 0
+_window_start: Optional[float] = None
+
+
+def active() -> bool:
+    """Whether the memo runs now: ``ENABLED``, and the gate open if one is set."""
+    if not ENABLED:
+        return False
+    return GATE.is_open()
+
+
+def schema_key(schema: Any) -> Optional[str]:
+    """sha256 of the schema's canonical JSON, or ``None`` when it has none."""
+    try:
+        blob = json.dumps(schema, sort_keys=True, separators=(",", ":"))
+    except (TypeError, ValueError, RecursionError):
+        return None
+    return hashlib.sha256(blob.encode("ascii")).hexdigest()
+
+
+def _maybe_log(now: float) -> None:
+    """Write the counter line when the window is ``LOG_INTERVAL_S`` old. Lock held."""
+    global _hits, _misses, _window_start
+    if _window_start is None:
+        _window_start = now
+        return
+    if now - _window_start < LOG_INTERVAL_S:
+        return
+    logger.info(
+        "%s hits=%d misses=%d entries=%d", LOG_PREFIX, _hits, _misses, len(_valid)
+    )
+    _hits = 0
+    _misses = 0
+    _window_start = now
+
+
+def check_schema(schema: Any) -> None:
+    """``Draft202012Validator.check_schema(schema)``, skipped for a schema that passed.
+
+    Raises what ``check_schema`` raises; a failure is never stored.
+    """
+    global _hits, _misses
+    key = schema_key(schema)
+    now = _clock()
+    with _lock:
+        _maybe_log(now)
+        if key is not None and key in _valid:
+            _valid.move_to_end(key)
+            _hits += 1
+            return
+        _misses += 1
+    Draft202012Validator.check_schema(schema)
+    if key is None:
+        return
+    with _lock:
+        _valid[key] = None
+        _valid.move_to_end(key)
+        while len(_valid) > MAX_ENTRIES:
+            _valid.popitem(last=False)
+
+
+def stats() -> dict:
+    """The table's size and the current window's counts (for tests and debugging)."""
+    with _lock:
+        return {"entries": len(_valid), "hits": _hits, "misses": _misses}
+
+
