diff --git a/python/sglang/srt/managers/short_prefill.py b/python/sglang/srt/managers/short_prefill.py
new file mode 100644
index 0000000000..f2f665389c
--- /dev/null
+++ b/python/sglang/srt/managers/short_prefill.py
@@ -0,0 +1,283 @@
+"""Conditional chunk budget for an eligible short queued prefill.
+
+This preserves one continuing request. It does not guarantee admission when
+another resource budget prevents the waiting request from fitting.
+
+Eligibility reads a waiting request's ``num_matched_prefix_tokens``.
+Cache-aware policies set it for every waiting request in
+``SchedulePolicy.calc_priority``, and so do cache-agnostic ones over a cache
+whose ``supports_fast_match_prefix()`` is true. Any other pairing (``fcfs`` over
+``UnifiedRadixCache``, for one) leaves it at 0, so a long prompt that is 99 %
+cached would read as its whole length and never qualify. ``queue_head_matcher``
+covers exactly that case by matching the requests it is asked about.
+
+Without lookahead (``--short-prefill-lookahead 0``, the default) only the queue
+head decides, and an ineligible head is not bypassed: one cold head keeps every
+warm request behind it waiting for the continuing prompt's whole remainder.
+With lookahead ``K``, the first ``K`` waiting requests in queue order are
+examined, each matched at most once, and the first eligible one caps the chunk.
+While a chunk continues, the waiting-queue loop also steps over a request among
+those ``K`` that would have to be truncated (only one request may continue
+chunking) instead of ending the pass there, so later requests that fit the room
+left beside the chunk are still admitted. A request stepped over keeps its
+place in the queue and is served when the chunk ends or the room allows. The
+requests that are admitted keep their queue order.
+
+Neither helps a head that is itself cold and mid-size: it waits for the
+continuing prompt's whole remainder. With ``--short-prefill-swap-limit N``
+(``ChunkSwap``) such a head, one whose uncached prompt is above the threshold
+but at most ``N`` tokens, is prefilled in the continuing prompt's place: the
+prompt is parked at a chunk boundary, keeping its request slot, its locked
+cached prefix and its SWA window, and resumes where it stopped once the head
+has been prefilled, within a token budget per parked prompt.
+"""
+
+from sglang.srt.mem_cache.common import match_kv_cache
+
+
+def queue_head_matcher(policy, tree_cache, waiting_queue):
+    """The scheduler's way to refresh a waiting request's cached-prefix count, or None.
+
+    None when ``calc_priority`` already matched every waiting request this pass.
+    Otherwise a callable that runs, on one request, the match cache-aware
+    policies run on every waiting request. The waiting-queue loop re-matches a
+    request before admitting it (``init_next_round_input``), so admission is
+    unchanged; this only lets the eligibility test see the cached prefix. It is
+    called on the queue head, or with lookahead on at most ``K`` requests, and
+    only in a pass that can be protected.
+    """
+    if policy.waiting_queue_prefix_matched(waiting_queue):
+        return None
+
+    def match_head(req):
+        match_kv_cache(req, tree_cache)
+
+    return match_head
+
+
+def _uncached(req):
+    return max(0, len(req.origin_input_ids) - req.num_matched_prefix_tokens)
+
+
+def _is_eligible(req, threshold, match_head):
+    if match_head is not None:
+        match_head(req)
+    return 0 < _uncached(req) <= threshold
+
+
+def match_each_once(match_head):
+    """``match_head`` for one pass, running at most once per request.
+
+    The chunk swap and the eligibility scan both look at the queue head; this
+    keeps that to one prefix match, as without the swap.
+    """
+    if match_head is None:
+        return None
+    matched = set()
+
+    def match_once(req):
+        if id(req) not in matched:
+            matched.add(id(req))
+            match_head(req)
+
+    return match_once
+
+
+def add_chunk_with_short_prefill_budget(
+    adder,
+    chunked_req,
+    waiting_queue,
+    *,
+    threshold,
+    chunk_size,
+    batch_size,
+    match_head=None,
+    lookahead=0,
+):
+    if (
+        threshold <= 0
+        or not waiting_queue
+        or adder.rem_chunk_tokens is None
+        or adder.dllm_config is not None
+        or adder.rem_chunk_tokens <= chunk_size
+    ):
+        return adder.add_chunked_req(chunked_req)
+    # Lookahead 0 and 1 both examine the head alone. any() stops at the first
+    # eligible request, so each examined request is matched once.
+    examined = waiting_queue[: max(1, lookahead)]
+    if not any(_is_eligible(req, threshold, match_head) for req in examined):
+        return adder.add_chunked_req(chunked_req)
+
+    original_budget = adder.rem_chunk_tokens
+    adder.rem_chunk_tokens = chunk_size
+    try:
+        continuing = adder.add_chunked_req(chunked_req)
+    except BaseException:
+        adder.rem_chunk_tokens = original_budget
+        raise
+    consumed = chunk_size - adder.rem_chunk_tokens
+    adder.rem_chunk_tokens = max(
+        0, min(original_budget - consumed, batch_size - consumed)
+    )
+    return continuing
+
+
+def steps_over(adder, req, position, lookahead, *, preempted):
+    """Whether the waiting-queue loop moves past a refused ``req`` instead of stopping.
+
+    True only for a request refused because it would have to be truncated
+    while another request continues chunking (``adder.refused_truncation``),
+    at one of the first ``lookahead`` queue positions, while room is left
+    beside the chunk, and when no running request was preempted to make room
+    for it (a pass that preempted for a request it then refuses still ends
+    there, as before). Every other refusal (KV, request slots, SWA room, the
+    prefill delayer, a request cap) still ends the pass.
+    """
+    return (
+        position < lookahead
+        and not preempted
+        and adder.refused_truncation is req
+        and adder.rem_chunk_tokens is not None
+        and adder.rem_chunk_tokens > 0
+    )
+
+
+def chunk_swap_for(schedule):
+    """The scheduler's chunk-swap state, or None when the swap is off (the default)."""
+    if (
+        schedule.short_prefill_token_threshold <= 0
+        or schedule.short_prefill_swap_limit <= 0
+    ):
+        return None
+    return ChunkSwap(
+        schedule.short_prefill_swap_limit,
+        schedule.short_prefill_swap_budget,
+        schedule.chunked_prefill_size,
+    )
+
+
+def _outranks(a, b, priority_sign):
+    """Whether ``a`` is scheduled strictly before ``b`` by priority alone."""
+    if a.priority is None or b.priority is None:
+        return False
+    return a.priority * priority_sign < b.priority * priority_sign
+
+
+class ChunkSwap:
+    """A cold mid-size queue head is prefilled in the continuing prompt's place.
+
+    In a pass where a chunk continues, ``swap_out`` looks at the queue head. The
+    continuing prompt is parked, and the head starts chunking instead, when all
+    of these hold:
+
+    - nothing is parked already (no nested swap: a head that is itself
+      chunking in a parked prompt's place is never parked in turn);
+    - the head is not eligible for short-prefill protection, and its uncached
+      prompt is at most ``limit`` tokens (startup caps ``limit`` at four passes
+      of ``--chunked-prefill-size``);
+    - it is less than what the continuing prompt has left to prefill;
+    - the head is not of lower priority than the continuing prompt;
+    - the head has not failed a swap for this prompt before;
+    - the passes the head needs, ``ceil(uncached / chunk)``, fit what is left of
+      the prompt's budget.
+
+    The budget is in passes the prompt sits out, counted as ``chunk`` tokens
+    each: ``budget`` times the prompt's own uncached tokens (prompt length minus
+    ``cached_tokens``), i.e. ``budget`` times the passes of its own prefill.
+    Every pass it sits out is charged: the pass that parks it (``swap_out``)
+    and each pass the swapped-in head chunks in its place (``charge_pass``).
+    A head that is then not admitted is charged its lost pass too, and is not
+    tried again for this prompt (``settle``). So the prompt sits out at most
+    ``budget * own / chunk`` passes; only a swapped-in head that gets less than
+    a full chunk per pass (KV memory short) can take more passes than its
+    swap was allowed for, and then only that head's extra passes.
+
+    The parked prompt is left exactly as it was between two of its chunks: the
+    step already stashed its computed prefix into the radix tree, and it keeps
+    its request slot, its lock on that prefix and its SWA window. Nothing is
+    re-matched or recomputed when it resumes. While it is parked, only the
+    swapped-in head may start chunking (``blocks_new_chunk``), and the head runs
+    at the full chunk size, not the protected one (``holds``), so it finishes in
+    ``ceil(uncached / chunk)`` passes. The prompt resumes at the top of the
+    first step in which no request is chunking.
+    """
+
+    def __init__(self, limit, budget, chunk):
+        self.limit = limit
+        self.budget = budget
+        self.chunk = chunk  # --chunked-prefill-size: one pass, in tokens
+        self.parked = None  # the continuing prompt, set aside at a chunk boundary
+        self.head = None  # the head prefilled in its place
+        self.abort_parked = False
+        # The budget belongs to one continuing prompt at a time.
+        self.giant = None
+        self.spent = 0  # passes it has sat out, times ``chunk``
+        self.refused = set()
+        self._settling = False  # a swap was made this pass and is not settled
+
+    def holds(self, req):
+        """Whether ``req`` is the head chunk-prefilling in a parked prompt's place."""
+        return self.parked is not None and req is self.head
+
+    def blocks_new_chunk(self, req):
+        """Whether ``req`` may not start chunking because a prompt is parked.
+
+        The parked prompt resumes into the one continuing slot, so only the
+        swapped-in head may take it in the meantime.
+        """
+        return self.parked is not None and req is not self.head
+
+    def charge_pass(self):
+        """The parked prompt sits out one more pass while the head chunks."""
+        self.spent += self.chunk
+
+    def swap_out(
+        self, chunked_req, waiting_queue, *, threshold, match=None, priority_sign=None
+    ):
+        """Park ``chunked_req`` for the queue head and return the head, or None."""
+        if self.parked is not None:
+            return None
+        if not waiting_queue:
+            return None
+        if chunked_req is not self.giant:
+            self.giant, self.spent, self.refused = chunked_req, 0, set()
+        head = waiting_queue[0]
+        if head.rid in self.refused:
+            return None
+        if priority_sign is not None and _outranks(chunked_req, head, priority_sign):
+            return None
+        if match is not None:
+            match(head)
+        uncached = _uncached(head)
+        left = len(chunked_req.full_untruncated_fill_ids) - chunked_req.prefix_len
+        own = max(0, len(chunked_req.origin_input_ids) - chunked_req.cached_tokens)
+        if not threshold < uncached <= self.limit:
+            return None
+        if uncached >= left:
+            return None
+        passes = -(-uncached // self.chunk)
+        if self.spent + passes * self.chunk > self.budget * own:
+            return None
+        self.parked, self.head = chunked_req, head
+        self.spent += self.chunk  # this pass
+        self._settling = True
+        return head
+
+    def settle(self, can_run_list):
+        """End of the pass that swapped. A head that was not admitted (memory,
+        request slots) keeps its lost pass charged and is not tried again for
+        this prompt, which resumes at the next step."""
+        if not self._settling:
+            return
+        self._settling = False
+        if any(req is self.head for req in can_run_list):
+            return
+        self.refused.add(self.head.rid)
+        self.head = None
+
+    def resume(self):
+        """Hand back the parked prompt; nothing is parked afterwards."""
+        parked, self.parked, self.head = self.parked, None, None
+        self.abort_parked = False
+        self._settling = False
+        return parked
