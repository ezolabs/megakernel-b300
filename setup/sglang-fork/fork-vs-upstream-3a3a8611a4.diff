+    alloc = tree.token_to_kv_pool_allocator
+    # 3 free SWA slots + the stored turn's evictable window (4) < R (10).
+    hog = alloc.swa_attn_allocator.alloc(alloc.swa_available_size() - 3)
+    assert hog is not None
