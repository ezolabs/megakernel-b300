diff --git a/test/registered/unit/entrypoints/openai/test_recipe_parity.py b/test/registered/unit/entrypoints/openai/test_recipe_parity.py
new file mode 100644
index 0000000000..ae79e426f1
--- /dev/null
+++ b/test/registered/unit/entrypoints/openai/test_recipe_parity.py
@@ -0,0 +1,307 @@
+"""DeepSeek-V4.1 served render vs DeepSeek's own converter (deepseek-recipe).
+
+Each fixture under ``fixtures/recipe-parity`` is a Chat Completions body and the
+prompt (and token ids) its oracle renders: deepseek-recipe 0.2.0's
+``DeepseekV41Encoding``, or, for a trailing assistant message, what DeepSeek's
+live API was measured to serve (baseline #76). ``generate.py`` there rebuilds
+them; this test needs neither recipe nor the tokenizer (the id check runs
+when the tokenizer.json is at hand: ``SGLANG_DSV41_TOKENIZER_JSON``, else the
+local copy at ``LOCAL_TOKENIZER_JSON``).
+
+The served prompt is the string ``OpenAIServingChat`` hands the tokenizer on the
+dsv41 path. It must equal the fixture prompt, except for the named deviations a
+fixture carries (its ``deviation.served_prompt``).
+"""
+
+from sglang.test.test_utils import CustomTestCase, maybe_stub_sgl_kernel
+
+maybe_stub_sgl_kernel()  # must precede any import that pulls in sgl_kernel
+
+import hashlib
+import json
+import os
+import unittest
+from pathlib import Path
+from typing import Optional
+from unittest.mock import Mock
+
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.runtime_context import publish, reset_context
+from sglang.srt.server_args import ServerArgs
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=6, suite="base-a-test-cpu")
+
+FIXTURE_DIR = Path(__file__).parent / "fixtures" / "recipe-parity"
+MANIFEST = json.loads((FIXTURE_DIR / "MANIFEST.json").read_text(encoding="utf-8"))
+FIXTURES = [
+    json.loads((FIXTURE_DIR / f"{name}.json").read_text(encoding="utf-8"))
+    for name in MANIFEST["cases"]
+]
+# The DeepSeek-V4.1 tokenizer.json the fixture ids were encoded with; the id
+# check runs only when it is supplied (its sha256 must match the manifest).
+# Without the env var it falls back to the local copy, when that exists.
+TOKENIZER_ENV = "SGLANG_DSV41_TOKENIZER_JSON"
+LOCAL_TOKENIZER_JSON = Path(
+    "<HOME>/workspace/inference/.tmp/box-c-vs-openrouter/data/tokenizer.json"
+)
+
+
+def _tokenizer_json_path() -> Optional[str]:
+    path = os.environ.get(TOKENIZER_ENV)
+    if path:
+        return path
+    return str(LOCAL_TOKENIZER_JSON) if LOCAL_TOKENIZER_JSON.is_file() else None
+
+
+# The points of the recipe-parity work each need fixtures.
+REQUIRED_POINTS = {
+    "plain",
+    "effort",
+    "multi-turn",
+    "tools",
+    "response_format",
+    "trailing-assistant",
+    "empty-system",
+    "arguments",
+    "updated-tools",
+    "developer",
+    "tool-payload",
+    "tool-choice",
+    "numbers",
+}
+
+
+class _TokenizerManager:
+    def __init__(self, tokenizer):
+        self.model_config = Mock(is_multimodal=False)
+        self.model_config.hf_config = Mock(architectures=["LlamaForCausalLM"])
+        self.model_config.hf_config.to_dict.return_value = {}
+        self.server_args = Mock(
+            model_path="deepseek-ai/DeepSeek-V4.1-Flash",
+            revision=None,
+            enable_cache_report=False,
+            tool_call_parser="deepseekv41",
+            reasoning_parser=None,
+            stream_response_default_include_usage=False,
+            default_chat_template_kwargs=None,
+            return_input_ids=False,
+            return_output_ids=False,
+            incremental_streaming_output=False,
+        )
+        self.model_path = self.server_args.model_path
+        self.served_model_name = "test-model"
+        self._config_overrides = {}
+        # deepseek-recipe renders and tokenizes with the checkpoint's fast tokenizer.
+        self.tokenizer = tokenizer
+
+    def config_value(self, name: str):
+        if name in self._config_overrides:
+            return self._config_overrides[name]
+        return getattr(self.server_args, name)
+
+
+class _TemplateManager:
+    def __init__(self):
+        self.chat_template_name: Optional[str] = None
+        self.jinja_template_content_format: Optional[str] = "string"
+        self.completion_template_name: Optional[str] = None
+        self.reasoning_config = None
+        self.force_reasoning = False
+        self.jinja_template_may_reorder_tool_results = False
+        self.python_chat_template = None
+
+
+class TestRecipeParity(CustomTestCase):
+    def setUp(self):
+        path = _tokenizer_json_path()
+        if not path:
+            self.skipTest(f"set {TOKENIZER_ENV} to the DeepSeek-V4.1 tokenizer.json")
+        with open(path, "rb") as f:
+            self.assertEqual(
+                hashlib.sha256(f.read()).hexdigest(), MANIFEST["tokenizer_sha256"]
+            )
+        from transformers import PreTrainedTokenizerFast
+
+        tokenizer = PreTrainedTokenizerFast(
+            tokenizer_file=path,
+            bos_token="<｜begin▁of▁sentence｜>",
+            eos_token="<｜end▁of▁sentence｜>",
+        )
+        reset_context()
+        self.addCleanup(reset_context)
+        publish(
+            ServerArgs(
+                model_path="dummy",
+                revision=None,
+                enable_cache_report=False,
+                tool_call_parser="deepseekv41",
+                reasoning_parser=None,
+                stream_response_default_include_usage=False,
+                default_chat_template_kwargs=None,
+            ),
+            role="tokenizer",
+        )
+        self.tm = _TokenizerManager(tokenizer)
+        self.chat = OpenAIServingChat(self.tm, _TemplateManager())
+        self.assertEqual(self.chat.chat_encoding_spec, "dsv41")
+        self.assertIsNotNone(self.chat.encoding_adapter)
+
+    def _request(self, body: dict) -> ChatCompletionRequest:
+        request = ChatCompletionRequest(**json.loads(json.dumps(body)))
+        self.assertIsNone(self.chat._validate_request(request))
+        return request
+
+    def _served_ids(self, body: dict) -> list:
+        request = self._request(body)
+        return list(self.chat._process_messages(request, is_multimodal=False).prompt_ids)
+
+    def _served_prompt(self, body: dict) -> str:
+        return self.tm.tokenizer.decode(
+            self._served_ids(body), skip_special_tokens=False
+        )
+
+    @staticmethod
+    def _expected_prompt(fixture: dict) -> str:
+        # The render is deepseek-recipe's own since the upstream recipe merge:
+        # a fixture's "deviation" records how encoding_dsv41 served it before.
+        return fixture["prompt"]
+
+    def test_fixture_set_covers_every_point(self):
+        self.assertGreaterEqual(len(FIXTURES), 25)
+        covered = {point for fixture in FIXTURES for point in fixture["points"]}
+        self.assertLessEqual(REQUIRED_POINTS, covered)
+        # Missing description, missing parameters, strict true and false.
+        self.assertGreaterEqual(
+            sum("tool-payload" in fixture["points"] for fixture in FIXTURES), 8
+        )
+        # Named and required, each with and without more around them.
+        self.assertGreaterEqual(
+            sum("tool-choice" in fixture["points"] for fixture in FIXTURES), 5
+        )
+        for fixture in FIXTURES:
+            self.assertIn(
+                fixture["source"],
+                (
+                    "recipe-chat",
+                    "recipe-chat-as-system",
+                    "recipe-conversation",
+                    "live-deepseek",
+                ),
+                fixture["name"],
+            )
+
+    def test_served_render_matches_the_oracle(self):
+        for fixture in FIXTURES:
+            with self.subTest(case=fixture["name"]):
+                self.assertEqual(
+                    self._served_prompt(fixture["body"]),
+                    self._expected_prompt(fixture),
+                )
+
+    def test_served_ids_match_the_oracle(self):
+        for fixture in FIXTURES:
+            with self.subTest(case=fixture["name"]):
+                self.assertEqual(
+                    self._served_ids(fixture["body"]), fixture["input_ids"]
+                )
+
+    def test_trailing_assistant_probe_is_the_live_token_count(self):
+        """The live probe served 47 prompt tokens; the fixture render is 47 ids."""
+        (probe,) = [f for f in FIXTURES if f["name"] == "trailing_assistant_live_probe"]
+        self.assertEqual(probe["live_prompt_tokens"], 47)
+        self.assertEqual(len(probe["input_ids"]), 47)
+        self.assertTrue(
+            probe["prompt"].endswith("<｜Assistant｜><think></think>The answer is")
+        )
+
+    def test_continue_final_message_renders_the_same_prefix(self):
+        for name in ("trailing_assistant_live_probe", "trailing_assistant_chat"):
+            (fixture,) = [f for f in FIXTURES if f["name"] == name]
+            with self.subTest(case=name):
+                body = {**fixture["body"], "continue_final_message": True}
+                self.assertEqual(self._served_prompt(body), fixture["prompt"])
+
+    def test_continued_assistant_content_is_parsed_as_content(self):
+        """A prompt that continues a trailing assistant turn parses from there.
+
+        DeepSeek-V4.1 continues a trailing assistant text turn as DeepSeek's API
+        does, without continue_final_message; output parsing starts in content
+        once the prompt closed the reasoning block.
+        """
+        from sglang.srt.entrypoints.openai.serving_deepseek_recipe import (
