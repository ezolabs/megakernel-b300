new file mode 100644
index 0000000000..29c327ccf9
--- /dev/null
+++ b/python/sglang/srt/entrypoints/openai/preprocess_lanes.py
@@ -0,0 +1,732 @@
+"""Where chat requests are converted, and how long they wait to be.
+
+Converting a chat request (``OpenAIServingChat._convert_to_internal_request``)
+renders the conversation and tokenizes it. Part 0021 moved that work off the
+HTTP event loop onto ONE worker thread. One worker serializes every
+conversion: a 900k-token prompt holds the worker for seconds (the encode of
+a DeepSeek V4.1 prompt grows faster than its length: ~0.08 s for 65k
+tokens, ~0.7 s for 330k, ~2.5-3.4 s for 1M on a laptop core), and every
+request behind it waits that long before it reaches the scheduler, however
+cheap its own prefill.
+
+This module replaces the one worker with two lanes:
+
+* the **small** lane, ``SGLANG_CHAT_PREPROCESS_WORKERS`` threads (default 4),
+  for every conversion below ``SGLANG_CHAT_PREPROCESS_GIANT_CHARS``;
+* the **giant** lane, ``SGLANG_CHAT_PREPROCESS_GIANT_WORKERS`` threads
+  (default 2), for conversions at or above it. A giant waits only behind
+  giants, and a small request never waits behind one.
+
+``SGLANG_CHAT_PREPROCESS_GIANT_CHARS=0`` folds the giant lane into the small
+one; with ``SGLANG_CHAT_PREPROCESS_WORKERS=1`` as well, conversion is exactly
+part 0021's: one thread, the tokenizer manager's own tokenizer, arrival order.
+
+**One tokenizer copy per worker.** With more than one conversion thread,
+every conversion runs against a private ``copy.deepcopy`` of the tokenizer
+manager's tokenizer, checked out of its lane's pool for the length of the
+conversion, so no two threads ever use one tokenizer object at once. A
+Hugging Face fast tokenizer that is mutated (truncation or padding state)
+while another thread encodes either raises ``Already borrowed``
+(tokenizers <= 0.22) or blocks the mutating thread until that encode ends
+(0.23). The copy is visible to the conversion as
+``self.tokenizer_manager.tokenizer``: while a worker converts,
+``OpenAIServingBase.tokenizer_manager`` answers a view of the manager whose
+``tokenizer`` is the copy and whose every other attribute is the manager's.
+A tokenizer that cannot be copied falls back to the shared one, with every
+such conversion serialized under one process-wide lock (0021's guarantee).
+
+**Measurement.** Every off-loop conversion records how many conversions
+were queued and running in its lane when it was submitted, how long it
+waited for a worker and how long it ran. They are logged, one line per
+conversion (``SGLANG_CHAT_PREPROCESS_LOG_S``), and, with ``--enable-metrics``,
+exported as ``sglang:chat_preprocess_*``. An event-loop lag monitor
+(``SGLANG_EVENT_LOOP_LAG_INTERVAL_S``) measures how late the loop wakes a
+sleeping coroutine, and a ``gc`` callback times every collection, so a
+stalled loop can be told apart from a backed-up lane. The callback only
+records each pause; the monitor's tick exports it (``drain_gc_pauses``), since
+a metric touched inside a collection can deadlock on prometheus_client's
+process-wide multiprocess lock.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import collections
+import copy
+import gc
+import logging
+import threading
+import time
+import weakref
+from concurrent.futures import Future, ThreadPoolExecutor
+from dataclasses import dataclass
+from typing import Any, Callable, Deque, Dict, List, Optional, Tuple
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+PREPROCESS_THREAD_NAME_PREFIX = "sglang-chat-preprocess"
+SMALL = "small"
+GIANT = "giant"
+
+# Wait and run times span a cached 1k-token turn (~1 ms) to a queue of
+# 900k-token conversions (tens of seconds).
+_SECONDS_BUCKETS = (
+    0.001,
+    0.0025,
+    0.005,
+    0.01,
+    0.025,
+    0.05,
+    0.1,
+    0.25,
+    0.5,
+    1.0,
+    2.5,
+    5.0,
+    10.0,
+    20.0,
+    40.0,
+    80.0,
+)
+
+
+# --------------------------------------------------------------------------
+# Sizing a request before it is converted
+# --------------------------------------------------------------------------
+
+
+def _field(obj: Any, name: str) -> Any:
+    if isinstance(obj, dict):
+        return obj.get(name)
+    return getattr(obj, name, None)
+
+
+def _text_len(value: Any) -> int:
+    """Characters of text in a message ``content``: a string or a part list."""
+    if isinstance(value, str):
+        return len(value)
+    if isinstance(value, list):
+        total = 0
+        for part in value:
+            if isinstance(part, str):
+                total += len(part)
+                continue
+            text = _field(part, "text")
+            if isinstance(text, str):
+                total += len(text)
+        return total
+    return 0
+
+
+def estimate_chat_chars(request: Any) -> int:
+    """Characters the conversion of ``request`` will render and tokenize.
+
+    The sum of every message's text content, reasoning content and tool-call
+    arguments. Tool definitions and the template's own text are left out: they
+    are small next to a conversation that is large enough to matter. A request
+    that carries ``input_ids`` is not tokenized and counts 0. This runs on
+    the event loop, so it only walks the messages; it renders nothing.
+    """
+    if _field(request, "input_ids") is not None:
+        return 0
+    messages = _field(request, "messages")
+    if not isinstance(messages, list):
+        return 0
+    total = 0
+    for message in messages:
+        total += _text_len(_field(message, "content"))
+        reasoning = _field(message, "reasoning_content")
+        if isinstance(reasoning, str):
+            total += len(reasoning)
+        tool_calls = _field(message, "tool_calls")
+        if isinstance(tool_calls, list):
+            for call in tool_calls:
+                arguments = _field(_field(call, "function"), "arguments")
+                if isinstance(arguments, str):
+                    total += len(arguments)
+    return total
+
+
+# --------------------------------------------------------------------------
+# The tokenizer manager a worker sees
+# --------------------------------------------------------------------------
+
+
+class WorkerTokenizerManager:
+    """A tokenizer manager whose ``tokenizer`` is one worker's private copy.
+
+    Every other attribute is read from, and written to, the real manager.
+    """
+
+    __slots__ = ("_tm", "tokenizer")
+
+    def __init__(self, tokenizer_manager: Any, tokenizer: Any):
+        object.__setattr__(self, "_tm", tokenizer_manager)
+        object.__setattr__(self, "tokenizer", tokenizer)
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(object.__getattribute__(self, "_tm"), name)
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        if name == "tokenizer":
+            raise AttributeError(
+                "a preprocess worker cannot replace the tokenizer manager's tokenizer"
+            )
+        setattr(object.__getattribute__(self, "_tm"), name, value)
+
+
+_worker_local = threading.local()
+
+
+def active_view(tokenizer_manager: Any) -> Optional[WorkerTokenizerManager]:
+    """The view this thread converts through for ``tokenizer_manager``, if any."""
+    view = getattr(_worker_local, "view", None)
+    if view is not None and object.__getattribute__(view, "_tm") is tokenizer_manager:
+        return view
+    return None
+
+
+# --------------------------------------------------------------------------
+# Metrics
+# --------------------------------------------------------------------------
+
+
+class PreprocessMetrics:
+    """``sglang:chat_preprocess_*``, ``sglang:event_loop_lag_*``, ``sglang:python_gc_*``."""
+
+    def __init__(self, registry: Any = None):
+        # Imported here, after PROMETHEUS_MULTIPROC_DIR is set (as the other
+        # collectors do).
+        from prometheus_client import REGISTRY, Gauge, Histogram
+
+        registry = REGISTRY if registry is None else registry
+        self.queue_depth = Gauge(
+            "sglang:chat_preprocess_queue_depth",
+            "Chat conversions waiting for a preprocess worker, per lane.",
+            labelnames=["lane"],
+            multiprocess_mode="livesum",
+            registry=registry,
+        )
+        self.running = Gauge(
+            "sglang:chat_preprocess_running",
+            "Chat conversions running on a preprocess worker, per lane.",
+            labelnames=["lane"],
+            multiprocess_mode="livesum",
+            registry=registry,
+        )
+        self.wait_seconds = Histogram(
+            "sglang:chat_preprocess_wait_seconds",
+            "Time a chat conversion waited for a preprocess worker.",
+            labelnames=["lane"],
+            buckets=_SECONDS_BUCKETS,
+            registry=registry,
+        )
+        self.run_seconds = Histogram(
+            "sglang:chat_preprocess_run_seconds",
+            "Time a chat conversion (render + tokenize) ran on its worker.",
+            labelnames=["lane"],
+            buckets=_SECONDS_BUCKETS,
+            registry=registry,
+        )
+        self.loop_lag_seconds = Histogram(
+            "sglang:event_loop_lag_seconds",
+            "How late the HTTP event loop woke a sleeping coroutine.",
+            buckets=_SECONDS_BUCKETS,
+            registry=registry,
+        )
+        self.loop_lag_last_seconds = Gauge(
+            "sglang:event_loop_lag_last_seconds",
+            "The event loop lag of the latest monitor tick.",
+            multiprocess_mode="mostrecent",
+            registry=registry,
+        )
+        self.gc_pause_seconds = Histogram(
+            "sglang:python_gc_pause_seconds",
+            "Duration of a Python garbage collection in the HTTP process.",
+            labelnames=["generation"],
+            buckets=_SECONDS_BUCKETS,
+            registry=registry,
+        )
+
+
+_metrics: Optional[PreprocessMetrics] = None
+_metrics_lock = threading.Lock()
+
+
+def enable_metrics(registry: Any = None) -> PreprocessMetrics:
+    """Create the metrics once per process; later calls return the same ones."""
+    global _metrics
+    with _metrics_lock:
+        if _metrics is None:
+            _metrics = PreprocessMetrics(registry)
+        return _metrics
+
+
+def disable_metrics() -> None:
+    """Stop recording (tests)."""
+    global _metrics
+    with _metrics_lock:
+        _metrics = None
+
+
+def get_metrics() -> Optional[PreprocessMetrics]:
+    return _metrics
+
+
+# --------------------------------------------------------------------------
+# Lanes
+# --------------------------------------------------------------------------
+
+
+@dataclass
+class PreprocessTiming:
+    """What one conversion saw of its lane."""
+
+    lane: str = ""
+    chars: int = 0
+    queued_ahead: int = 0
+    running_at_submit: int = 0
+    wait_s: float = 0.0
+    run_s: float = 0.0
+    tokenizer: str = "shared"  # "copy", "shared" or "shared-serialized"
+    started: bool = False
+
+
+class _TokenizerPool:
+    """Private copies of one source tokenizer, one checked out per running task."""
+
+    def __init__(self, source: Any):
+        self.source = source
+        self.free: List[Any] = []
+        self.created = 0
+
+
+class PreprocessLane:
+    def __init__(self, name: str, workers: int, private_tokenizers: bool):
+        self.name = name
+        self.workers = workers
+        self.private_tokenizers = private_tokenizers
+        self.executor = ThreadPoolExecutor(
+            max_workers=workers,
+            # The small lane keeps part 0021's thread names.
+            thread_name_prefix=PREPROCESS_THREAD_NAME_PREFIX
+            if name == SMALL
+            else f"{PREPROCESS_THREAD_NAME_PREFIX}-{name}",
+        )
+        self._lock = threading.Lock()
+        self.waiting = 0
+        self.running = 0
+        self._pools: Dict[int, _TokenizerPool] = {}
+
+    # ---- counters -------------------------------------------------------
+
+    def _gauge(self, which: str, value: int) -> None:
+        metrics = _metrics
+        if metrics is not None:
+            getattr(metrics, which).labels(lane=self.name).set(value)
+
+    def _submitted(self) -> Tuple[int, int]:
+        with self._lock:
+            ahead, running = self.waiting, self.running
+            self.waiting += 1
+            waiting = self.waiting
+        self._gauge("queue_depth", waiting)
+        return ahead, running
+
+    def _started(self) -> None:
+        with self._lock:
+            self.waiting -= 1
+            self.running += 1
+            waiting, running = self.waiting, self.running
+        self._gauge("queue_depth", waiting)
+        self._gauge("running", running)
+
+    def _finished(self) -> None:
+        with self._lock:
+            self.running -= 1
+            running = self.running
+        self._gauge("running", running)
+
+    def _abandoned(self) -> None:
+        """A queued task was cancelled before a worker picked it up."""
+        with self._lock:
+            self.waiting -= 1
+            waiting = self.waiting
+        self._gauge("queue_depth", waiting)
+
+    # ---- tokenizer copies -----------------------------------------------
+
+    def _checkout(self, tokenizer_manager: Any) -> Tuple[Optional[Any], str]:
+        """This task's tokenizer: a private copy, or None to use the shared one."""
+        source = getattr(tokenizer_manager, "tokenizer", None)
+        if not self.private_tokenizers or source is None:
+            return None, "shared"
+        key = id(tokenizer_manager)
+        with self._lock:
+            pool = self._pools.get(key)
+            if pool is None or pool.source is not source:
+                pool = self._pools[key] = _TokenizerPool(source)
+            if pool.free:
+                return pool.free.pop(), "copy"
+            if pool.created < 0:  # this source cannot be copied
+                return None, "shared-serialized"
+        try:
+            tokenizer = copy.deepcopy(source)
+        except Exception as e:  # noqa: BLE001 - any copy failure means "share"
+            with self._lock:
+                first = pool.created >= 0
+                pool.created = -1
+            if first:
+                logger.warning(
+                    "Chat preprocess lane %r cannot copy the tokenizer (%s: %s); "
+                    "conversions that need it run one at a time on the shared "
+                    "tokenizer.",
+                    self.name,
+                    type(e).__name__,
+                    e,
+                )
+            return None, "shared-serialized"
+        with self._lock:
+            if pool.created >= 0:
+                pool.created += 1
+        return tokenizer, "copy"
+
+    def _checkin(self, tokenizer_manager: Any, tokenizer: Any) -> None:
+        with self._lock:
+            pool = self._pools.get(id(tokenizer_manager))
+            # A copy of a tokenizer that has since been replaced is dropped.
+            if pool is not None and pool.source is getattr(
+                tokenizer_manager, "tokenizer", None
+            ):
+                pool.free.append(tokenizer)
+
+    def prewarm(self, tokenizer_manager: Any) -> int:
+        """Make one tokenizer copy per worker now; returns how many were made.
+
+        Copying a fast tokenizer holds the GIL (~0.2 s for DeepSeek V4.1's), so
+        a copy made while serving stalls the event loop that long. Made at
+        startup, no request pays for one.
+        """
+        taken = []
+        try:
+            for _ in range(self.workers):
+                tokenizer, kind = self._checkout(tokenizer_manager)
+                if tokenizer is None:
+                    break
+                taken.append(tokenizer)
+        finally:
+            for tokenizer in taken:
+                self._checkin(tokenizer_manager, tokenizer)
+        return self.copies(tokenizer_manager)
+
+    def copies(self, tokenizer_manager: Any) -> int:
+        """How many private copies this lane has made for ``tokenizer_manager``."""
+        with self._lock:
+            pool = self._pools.get(id(tokenizer_manager))
+            return max(pool.created, 0) if pool is not None else 0
+
+    # ---- running a task -------------------------------------------------
+
+    def submit(
+        self,
+        runner: Callable[[Callable[[], Any]], Any],
+        func: Callable[..., Any],
+        args: tuple,
+        tokenizer_manager: Any,
+        timing: PreprocessTiming,
+    ) -> Future:
+        """Queue ``runner(task)`` on this lane; ``task()`` calls ``func(*args)``.
+
+        ``runner`` is how the caller wants the task run on the worker (the
+        caller's context copied in, for one); ``task`` does the lane's
+        bookkeeping around ``func``.
+        """
+        timing.lane = self.name
+        timing.queued_ahead, timing.running_at_submit = self._submitted()
+        submitted = time.perf_counter()
+
+        def task() -> Any:
+            started = time.perf_counter()
+            timing.started = True
+            timing.wait_s = started - submitted
+            self._started()
+            tokenizer = None
+            try:
+                tokenizer, timing.tokenizer = self._checkout(tokenizer_manager)
+                if tokenizer is not None:
+                    _worker_local.view = WorkerTokenizerManager(
+                        tokenizer_manager, tokenizer
+                    )
+                    return func(*args)
+                if timing.tokenizer == "shared-serialized":
+                    with _SHARED_TOKENIZER_LOCK:
+                        return func(*args)
+                return func(*args)
+            finally:
+                _worker_local.view = None
+                if tokenizer is not None:
+                    self._checkin(tokenizer_manager, tokenizer)
+                timing.run_s = time.perf_counter() - started
+                self._finished()
+                metrics = _metrics
+                if metrics is not None:
+                    metrics.wait_seconds.labels(lane=self.name).observe(timing.wait_s)
+                    metrics.run_seconds.labels(lane=self.name).observe(timing.run_s)
+
+        future = self.executor.submit(runner, task)
+
+        def _done(f: Future) -> None:
+            if f.cancelled():
+                self._abandoned()
+
+        future.add_done_callback(_done)
+        return future
+
+    def shutdown(self) -> None:
+        self.executor.shutdown(wait=False, cancel_futures=True)
+
+
+# Serializes conversions that share a tokenizer that could not be copied.
+_SHARED_TOKENIZER_LOCK = threading.Lock()
+
+
+class PreprocessLanes:
+    """The small lane and, when configured, the giant lane."""
+
+    def __init__(self, workers: int, giant_chars: int, giant_workers: int):
+        self.workers = max(1, int(workers))
+        self.giant_chars = max(0, int(giant_chars))
+        self.giant_workers = max(1, int(giant_workers))
+        threads = self.workers + (self.giant_workers if self.giant_chars else 0)
+        # One thread in all: 0021's configuration, the manager's own tokenizer.
+        private = threads > 1
+        self.small = PreprocessLane(SMALL, self.workers, private)
+        self.giant = (
+            PreprocessLane(GIANT, self.giant_workers, private)
+            if self.giant_chars
+            else None
+        )
+
+    @classmethod
+    def from_env(cls) -> PreprocessLanes:
+        return cls(
+            workers=envs.SGLANG_CHAT_PREPROCESS_WORKERS.get(),
+            giant_chars=envs.SGLANG_CHAT_PREPROCESS_GIANT_CHARS.get(),
+            giant_workers=envs.SGLANG_CHAT_PREPROCESS_GIANT_WORKERS.get(),
+        )
+
+    def prewarm(self, tokenizer_manager: Any) -> int:
+        """Every lane's tokenizer copies, made now (see ``PreprocessLane.prewarm``)."""
+        return sum(lane.prewarm(tokenizer_manager) for lane in self.lanes())
+
+    def lane_for(self, chars: int) -> PreprocessLane:
+        if self.giant is not None and chars >= self.giant_chars:
+            return self.giant
+        return self.small
+
+    def lanes(self) -> List[PreprocessLane]:
+        return [self.small] + ([self.giant] if self.giant is not None else [])
+
+    def describe(self) -> str:
+        return " ".join(
+            f"{lane.name}={lane.running}/{lane.workers}+{lane.waiting}q"
+            for lane in self.lanes()
+        )
+
+    def shutdown(self) -> None:
+        for lane in self.lanes():
+            lane.shutdown()
+
+
+_lanes: Optional[PreprocessLanes] = None
+_lanes_lock = threading.Lock()
+
+
+def get_lanes() -> PreprocessLanes:
+    """The process-wide lanes, built from the environment on first use."""
+    global _lanes
+    if _lanes is None:
+        with _lanes_lock:
+            if _lanes is None:
+                _lanes = PreprocessLanes.from_env()
+    return _lanes
+
+
+def reset_lanes() -> None:
+    """Drop the lanes so the next conversion rebuilds them (tests, restarts)."""
+    global _lanes
+    with _lanes_lock:
+        lanes, _lanes = _lanes, None
+    if lanes is not None:
+        lanes.shutdown()
+
+
+# --------------------------------------------------------------------------
+# One log line per conversion
+# --------------------------------------------------------------------------
+
+
+def log_conversion(
+    rid: Any, timing: PreprocessTiming, tokens: Optional[int], error: Optional[str]
+) -> None:
+    """``Chat preprocess: rid=… lane=… chars=… ahead=… running=… wait=… run=…``."""
+    threshold = envs.SGLANG_CHAT_PREPROCESS_LOG_S.get()
+    if threshold < 0 or timing.wait_s + timing.run_s < threshold:
+        return
+    logger.info(
+        "Chat preprocess: rid=%s lane=%s chars=%d tokens=%s ahead=%d running=%d "
+        "wait=%.3fs run=%.3fs tokenizer=%s%s",
+        rid if rid else "-",
+        timing.lane,
+        timing.chars,
+        "-" if tokens is None else tokens,
+        timing.queued_ahead,
+        timing.running_at_submit,
+        timing.wait_s,
+        timing.run_s,
+        timing.tokenizer,
+        f" error={error}" if error else "",
+    )
+
+
+# --------------------------------------------------------------------------
+# Event-loop lag and GC pauses
+# --------------------------------------------------------------------------
+
+_monitors: weakref.WeakKeyDictionary[asyncio.AbstractEventLoop, asyncio.Task] = (
+    weakref.WeakKeyDictionary()
+)
+
+
+async def _watch_loop(interval: float, warn_s: float) -> None:
+    while True:
+        before = time.perf_counter()
+        await asyncio.sleep(interval)
+        lag = max(0.0, time.perf_counter() - before - interval)
+        metrics = _metrics
+        if metrics is not None:
+            metrics.loop_lag_seconds.observe(lag)
+            metrics.loop_lag_last_seconds.set(lag)
+        drain_gc_pauses()
+        if lag >= warn_s:
+            lanes = _lanes
+            logger.warning(
+                "Event loop lag: %.3fs past a %.3fs tick (chat preprocess %s)",
+                lag,
+                interval,
+                lanes.describe() if lanes is not None else "idle",
+            )
+
+
+def ensure_loop_monitor() -> Optional[asyncio.Task]:
+    """Start the lag monitor on the running loop, once per loop."""
+    interval = envs.SGLANG_EVENT_LOOP_LAG_INTERVAL_S.get()
+    if interval <= 0:
+        return None
+    loop = asyncio.get_running_loop()
+    task = _monitors.get(loop)
+    if task is None or task.done():
+        task = loop.create_task(
+            _watch_loop(interval, envs.SGLANG_EVENT_LOOP_LAG_WARN_S.get()),
+            name="sglang-event-loop-lag",
+        )
+        _monitors[loop] = task
+        _install_gc_timer()
+    return task
+
+
+def stop_loop_monitor() -> None:
+    """Cancel the monitor on the running loop (tests)."""
+    task = _monitors.pop(asyncio.get_running_loop(), None)
+    if task is not None:
+        task.cancel()
+
+
+_gc_started: Dict[int, float] = {}
+_gc_installed = False
+
+# Pauses the GC callback timed and nobody has exported yet: (generation,
+# seconds, collected). The callback only appends here; ``drain_gc_pauses``
+# (the lag monitor's tick, on the event loop) observes and logs them. A deque
+# append and popleft are atomic and take no Python-level lock, so the callback
+# can never wait on a lock the interrupted frame holds. Bounded: if no tick
+# drains it (the monitor stopped), the oldest pauses are dropped.
+_GC_PENDING_MAX = 4096
+_gc_pending: Deque[Tuple[int, float, Any]] = collections.deque(maxlen=_GC_PENDING_MAX)
+
+
+def _gc_timer(phase: str, info: Dict[str, Any]) -> None:
+    """The ``gc.callbacks`` hook. It records the pause and nothing else.
+
+    A collection runs inside whatever frame allocated last, on any thread,
+    including a frame that holds a lock. In multiprocess mode prometheus_client
+    guards every metric value of the process with ONE non-reentrant
+    ``threading.Lock``: observing a metric here, while the interrupted frame was
+    itself inside ``inc``/``set``/``observe``, waits forever on a lock this
+    thread holds (box-c, 2026-10-13 08:13Z: the HTTP event loop deadlocked inside
+    ``_watch_loop``'s ``loop_lag_seconds.observe``). So no metric, no logging,
+    no env read and no lock here: the pause is appended to ``_gc_pending`` and
+    exported by ``drain_gc_pauses`` outside the collection.
+    """
+    thread = threading.get_ident()
+    if phase == "start":
+        _gc_started[thread] = time.perf_counter()
+        return
+    started = _gc_started.pop(thread, None)
+    if started is None:
+        return
+    _gc_pending.append(
+        (
+            info.get("generation", -1),
+            time.perf_counter() - started,
+            info.get("collected"),
+        )
+    )
+
+
+def drain_gc_pauses() -> int:
+    """Export the GC pauses timed since the last drain; returns how many.
+
+    Called by the lag monitor's every tick, outside any GC callback, so the
+    ``sglang:python_gc_pause_seconds`` observe and the long-pause warning take
+    their locks the ordinary way. Safe to call from any thread.
+    """
+    metrics = _metrics
+    warn_s = envs.SGLANG_EVENT_LOOP_LAG_WARN_S.get()
+    drained = 0
+    while True:
+        try:
+            generation, pause, collected = _gc_pending.popleft()
+        except IndexError:
+            return drained
+        drained += 1
+        if metrics is not None:
+            metrics.gc_pause_seconds.labels(generation=str(generation)).observe(pause)
+        if pause >= warn_s:
+            logger.warning(
+                "Python GC pause: %.3fs (generation %s, %s collected)",
+                pause,
+                generation,
+                collected,
+            )
+
+
+def _install_gc_timer() -> None:
+    global _gc_installed
+    if not _gc_installed:
+        gc.callbacks.append(_gc_timer)
+        _gc_installed = True
+
+
+def uninstall_gc_timer() -> None:
+    """Remove the GC callback (tests)."""
+    global _gc_installed
+    if _gc_installed:
+        try:
+            gc.callbacks.remove(_gc_timer)
+        except ValueError:
+            pass
+        _gc_installed = False
+    _gc_pending.clear()
