+class TestPixelLessItem(CustomTestCase):
+    """E3: a pixel-less item matches the full item for several sizes."""
+
+    def test_same_tokens_offsets_grid_and_pad_ids(self):
+        images = [Image.new("RGB", size, (i * 30, 60, 90)) for i, size in enumerate(SIZES)]
+        hashes = [_hash(i) for i in range(len(SIZES))]
+        full = _process(images)
+        omitted = {0, 2, 3, 5, 7}
+        refs = [
+            {"index": i, "width": SIZES[i][0], "height": SIZES[i][1]} for i in omitted
+        ]
+        kept = [im for i, im in enumerate(images) if i not in omitted]
+        with envs.SGLANG_MM_CACHED_REFS.override(True):
+            part = _process(kept, refs=refs, n_images=len(images))
+        self.assertEqual(part.input_ids, full.input_ids)
+        self.assertEqual(len(part.mm_items), len(full.mm_items))
+        for i, (a, b) in enumerate(zip(part.mm_items, full.mm_items)):
+            self.assertEqual(a.offsets, b.offsets, SIZES[i])
+            self.assertEqual(a.n_vit_h, b.n_vit_h, SIZES[i])
+            self.assertEqual(a.n_vit_w, b.n_vit_w, SIZES[i])
+            self.assertEqual(mm_cached_refs.is_cached_ref_item(a), i in omitted)
+            self.assertEqual(a.feature is None, i in omitted)
+        self.assertEqual(_padded(part, hashes), _padded(full, hashes))
+
+    def test_all_images_omitted(self):
+        size = (800, 600)
+        full = _process([Image.new("RGB", size)])
+        part = _process(
+            [], refs=[{"index": 0, "width": 800, "height": 600}], n_images=1
+        )
+        self.assertEqual(part.input_ids, full.input_ids)
+        self.assertEqual(part.mm_items[0].offsets, full.mm_items[0].offsets)
+
+    def test_placeholder_count_still_checked(self):
+        with self.assertRaises(ValueError):
+            _process([], refs=[{"index": 0, "width": 8, "height": 8}], n_images=2)
+
