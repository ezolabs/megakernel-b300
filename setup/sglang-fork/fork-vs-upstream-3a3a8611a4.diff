+
+def legacy_layout(extend, seq, tail_len, whole):
+    """The seq-anchored layout before the exact trim (prod fd3545a4)."""
+    tails = [
+        n if (whole and whole[i]) else min(tail_len, n) for i, n in enumerate(extend)
+    ]
+    idx, floor, start = [], [], 0
+    for i, (n, t, s) in enumerate(zip(extend, tails, seq)):
+        idx.append(torch.arange(start + n - t, start + n))
+        f = max(0, s - t - tail_len) if (whole and whole[i]) else max(0, s - tail_len)
+        floor.append(torch.full((t,), f, dtype=torch.int32))
+        start += n
+    return torch.cat(idx), tails, torch.cat(floor)
+
