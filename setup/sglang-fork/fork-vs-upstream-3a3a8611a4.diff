diff --git a/test/srt/sbr/hicache_poll_lockstep_worker.py b/test/srt/sbr/hicache_poll_lockstep_worker.py
new file mode 100644
index 0000000000..247e9f312d
--- /dev/null
+++ b/test/srt/sbr/hicache_poll_lockstep_worker.py
@@ -0,0 +1,595 @@
+"""One TP rank of test_v_hicache_poll_hint's 8-process CPU gloo run.
+
+Usage: python hicache_poll_lockstep_worker.py RANK WORLD STORE_FILE OUT_DIR
+
+Every rank drives the real ``SchedulerRequestReceiver.recv_requests`` (the
+request broadcast) and the real ``UnifiedRadixCache.check_hicache_events``
+(the ack poll and its MIN reduction) over one gloo group, in a scheduler loop
+whose idle / prefill / decode / abort iterations are scripted identically on
+every rank. Only TP rank 0's tokenizer socket carries the script, as in
+production. What differs per rank is when each D2H / H2D ack completes: every
+ack's event becomes ready a rank-dependent number of iterations after it was
+issued, so the ranks' local ready counts disagree all the time, which is the
+case the MIN reduction exists for.
+
+Every iteration has two phases: 0 is the receive (the request broadcast that
+carries TP rank 0's bit), 1 is the poll. In the main scenarios an ack becomes
+ready at phase 0 of some iteration, so readiness is fixed within an
+iteration. The ``midstep`` scenarios also make acks ready at phase 1, between
+the broadcast and the poll; the ``skipper`` scenarios run the real
+``SchedulerRecvSkipper`` (a receive every third iteration); the ``blocker``
+scenarios run the real ``SchedulerInputBlocker`` through a BLOCK / UNBLOCK
+stretch.
+
+Every ``torch.distributed`` collective each rank calls is recorded, with the
+iteration it was called in, and written to OUT_DIR/rank<R>.json with what each
+check saw and drained. The test compares the ranks.
+
+Not collected by pytest (no ``test_`` prefix); run by the test as a script.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import os
+import random
+import sys
+from collections import deque
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+# The CPU shims (triton, IPython, torch.mps, MPS reported unavailable) before
+# torch.distributed and the first sglang import: unsandboxed on Apple Silicon
+# is_mps() would otherwise be True and scheduler.py would import mlx.core.
+import conftest  # noqa: E402,F401
+import torch.distributed as dist  # noqa: E402
+
+from sglang.srt.environ import envs  # noqa: E402
+from sglang.srt.managers import scheduler as scheduler_mod  # noqa: E402
+from sglang.srt.managers.io_struct import BlockReqInput, BlockReqType  # noqa: E402
+from sglang.srt.managers.scheduler_components import (  # noqa: E402
+    recv_skipper as recv_skipper_mod,
+)
+from sglang.srt.managers.scheduler_components import (  # noqa: E402
+    request_receiver as receiver_mod,
+)
+from sglang.srt.managers.scheduler_input_blocker import (  # noqa: E402
+    SchedulerInputBlocker,
+)
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache  # noqa: E402
+from sglang.srt.observability.metrics_collector import (  # noqa: E402
+    RadixCacheMetricsCollector,
+)
+from sglang.srt.utils import poll_based_barrier  # noqa: E402
+
+try:  # absent on the base tree: the worker still runs there (ungated only)
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate
+except ImportError:  # pragma: no cover - exercised by the controls
+    HiCachePollGate = None
+
+if HiCachePollGate is not None:
+
+    class RecordingGate(HiCachePollGate):
+        """The real gate, plus a log of the bit each broadcast delivered."""
+
+        def __init__(self, *args, clock: Clock, **kwargs):
+            super().__init__(*args, **kwargs)
+            self.clock = clock
+            self.hints: list = []
+
+        def note_hint(self, hint) -> None:
+            self.hints.append([self.clock.k, int(hint)])
+            super().note_hint(hint)
+
+
+@dataclass
+class Gen:
+    rid: int
+    prompt_len: int
+    max_new: int
+
+
+@dataclass
+class Abort:
+    rid: int
+
+
+class Clock:
+    k = -1
+    phase = 0  # 0: the receive (and its broadcast); 1: the poll
+
+
+class FakeEvent:
+    def __init__(self, clock: Clock, ready_at: int, ready_phase: int = 0):
+        self.clock = clock
+        self.ready_at = ready_at
+        self.ready_phase = ready_phase
+
+    def query(self) -> bool:
+        return (self.clock.k, self.clock.phase) >= (self.ready_at, self.ready_phase)
+
+    def synchronize(self) -> None:
+        # The poll pops at most MIN(ready) acks, so every popped ack must be
+        # ready on this rank; a real synchronize would block here instead.
+        assert self.query(), "popped an ack whose event is not ready on this rank"
+
+
+class Socket:
+    """Rank 0's tokenizer socket: the script's messages for the current step."""
+
+    def __init__(self):
+        self.inbox: deque = deque()
+
+    def pop(self):
+        if not self.inbox:
+            raise receiver_mod.zmq.ZMQError()
+        return self.inbox.popleft()
+
+
+class Recorder:
+    """Wraps the torch.distributed collectives the code under test calls."""
+
+    def __init__(self, clock: Clock):
+        self.clock = clock
+        self.trace: list = []
+        self._orig_all_reduce = dist.all_reduce
+        self._orig_broadcast = dist.broadcast
+
+        def all_reduce(tensor, op=dist.ReduceOp.SUM, group=None, async_op=False):
+            self.trace.append(
+                [
+                    self.clock.k,
+                    "all_reduce",
+                    list(tensor.shape),
+                    str(tensor.dtype),
+                    str(op),
+                ]
+            )
+            return self._orig_all_reduce(tensor, op=op, group=group, async_op=async_op)
+
+        def broadcast(tensor, src=None, group=None, async_op=False, **kw):
+            self.trace.append(
+                [
+                    self.clock.k,
+                    "broadcast",
+                    list(tensor.shape),
+                    str(tensor.dtype),
+                    str(src),
+                ]
+            )
+            return self._orig_broadcast(
+                tensor, src=src, group=group, async_op=async_op, **kw
+            )
+
+        dist.all_reduce = all_reduce
+        dist.broadcast = broadcast
+
+    def all_reduce_count(self) -> int:
+        return sum(1 for t in self.trace if t[1] == "all_reduce")
+
+
+def ack_delay(seed: int, rank: int, ack_id: int) -> int:
+    return random.Random(seed * 1_000_003 + rank * 10_007 + ack_id).randint(0, 5)
+
+
+def ack_phase(seed: int, rank: int, ack_id: int) -> int:
+    """midstep: half the acks become ready between the broadcast and the poll."""
+    return random.Random(seed * 2_000_003 + rank * 10_009 + ack_id).randint(0, 1)
+
+
+def traffic_script(seed: int, iterations: int, idle_tail: int) -> dict:
+    """Messages per iteration (the same on every rank; only rank 0 is fed)."""
+    rng = random.Random(seed)
+    script: dict = {}
+    rid = 0
+    live: list = []
+    for k in range(8, iterations - idle_tail):
+        msgs = []
+        if rng.random() < 0.12:
+            for _ in range(rng.randint(1, 3)):
+                msgs.append(Gen(rid, rng.randint(1, 40), rng.randint(1, 12)))
+                live.append(rid)
+                rid += 1
+        if live and rng.random() < 0.05:
+            msgs.append(Abort(live.pop(rng.randrange(len(live)))))
+        if msgs:
+            script[k] = msgs
+    return script
+
+
+def make_cache(rank, clock, metrics_collector, digest_fn):
+    cache = object.__new__(UnifiedRadixCache)
+    cache.linker = None
+    cache.work_list = []
+    cache.pp_size = 1
+    cache.pp_rank = 0
+    cache.pp_group = None
+    cache.attn_cp_group = None
+    cache.attn_tp_group = None
+    cache.tp_group = dist.group.WORLD
+    cache.tp_world_size = dist.get_world_size()
+    cache.enable_storage_metrics = False
+    cache.storage_metrics_collector = None
+    cache.buffer_pipeline = None
+    cache.metrics_collector = metrics_collector
+    cache.cache_controller = SimpleNamespace(
+        ack_write_queue=[],
+        ack_load_queue=[],
+        start_writing=lambda: None,  # upstream's poll flushes pending backups first
+    )
+    cache.host_memory_mode = "cache"  # box-c: --hicache-host-memory-mode cache
+    cache.ongoing_write_through = {}
+    cache.ongoing_load_back = {}
+    drained: list = []
+
+    class TreeCore:
+        enable_storage = False
+
+        @property
+        def write_back_duplicate_reclaim_digest(self):
+            return digest_fn(clock.k)
+
+        def finish_load_back(self, node):
+            drained.append([clock.k, "load", node])
+
+    cache.tree_core = TreeCore()
+
+    def finish_write(ack_id):
+        cache.ongoing_write_through.pop(ack_id)
+        drained.append([clock.k, "write", ack_id])
+
+    cache._finish_write_through_ack = finish_write
+    cache.dec_lock_ref = lambda node, params: None
+    cache.dec_host_lock_ref = lambda node, params: None
+    if HiCachePollGate is not None:
+        # As UnifiedRadixCache.__init__ builds it.
+        cache.hicache_poll_gate = RecordingGate(
+            cache._local_hicache_events_ready,
+            envs.SGLANG_HICACHE_POLL_HEARTBEAT_CALLS.get(),
+            clock=clock,
+        )
+    return cache, drained
+
+
+def parallel_layout(rank, world):
+    """What upstream's receiver, skipper and arming read off get_parallel():
+    box-c's shape (TP = world, PP 1, no DP attention), this rank's place in it."""
+    return SimpleNamespace(
+        pp_rank=0,
+        pp_size=1,
+        attn_tp_rank=rank,
+        attn_cp_rank=0,
+        attn_dp_rank=0,
+        tp_size=world,
+        attn_tp_size=world,
+        attn_cp_size=1,
+        attn_dp_enabled=False,
+        enable_dp_attention=False,
+        tp_group=SimpleNamespace(
+            rank=rank, ranks=list(range(world)), cpu_group=dist.group.WORLD
+        ),
+        world_group=SimpleNamespace(cpu_group=dist.group.WORLD),
+    )
+
+
+def make_receiver(rank, world, socket, gate, recv_skipper=None, input_blocker=None):
+    kwargs = dict(
+        recv_from_tokenizer=socket,
+        recv_from_rpc=Socket(),
+        recv_skipper=recv_skipper,
+        input_blocker=input_blocker,
+        mm_receiver=None,
+        server_args=None,
+        model_config=SimpleNamespace(is_multimodal=False),
+        max_recv_per_poll=-1,
+        stream_output=lambda *a, **kw: None,
+        get_last_batch=lambda: None,
+    )
+    if (
+        "hicache_poll_gate"
+        in receiver_mod.SchedulerRequestReceiver.__dataclass_fields__
+    ):
+        kwargs["hicache_poll_gate"] = gate
+    return receiver_mod.SchedulerRequestReceiver(**kwargs)
+
+
+def run_scenario(
+    rank,
+    world,
+    name,
+    *,
+    poll_on_hint,
+    heartbeat,
+    seed,
+    iterations,
+    idle_tail,
+    script,
+    digest_fn,
+    metrics_collector,
+    recorder,
+    clock,
+    midstep=False,
+    recv_interval=1,
+    blocker=False,
+):
+    os.environ["SGLANG_HICACHE_POLL_ON_HINT"] = "1" if poll_on_hint else "0"
+    os.environ["SGLANG_HICACHE_POLL_HEARTBEAT_CALLS"] = str(heartbeat)
+    cache, drained = make_cache(rank, clock, metrics_collector, digest_fn)
+    stand_in = SimpleNamespace(
+        enable_hierarchical_cache=True,
+        tree_cache=cache,
+    )
+    arm = getattr(scheduler_mod.Scheduler, "_maybe_arm_hicache_poll_gate", None)
+    gate = arm(stand_in) if arm is not None else None
+    socket = Socket()
+    # The real skipper: with an interval of N and no last batch (weight 1),
+    # every N-th call receives and the others return [] before the broadcast.
+    recv_skipper_mod.get_schedule = lambda: SimpleNamespace(
+        scheduler_recv_interval=recv_interval
+    )
+    skipper = recv_skipper_mod.SchedulerRecvSkipper.maybe_create()
+    assert (skipper is None) == (recv_interval <= 1)
+    # The real blocker: only TP rank 0 sees BLOCK / UNBLOCK; it holds requests
+    # back while blocked, and the unblock barrier is a world all_reduce.
+    input_blocker = SchedulerInputBlocker(noop=rank != 0) if blocker else None
+    receiver = make_receiver(rank, world, socket, gate, skipper, input_blocker)
+
+    labels = metrics_collector.labels
+    polls_counter = getattr(metrics_collector, "hicache_event_polls", None)
+
+    def counter(outcome):
+        if polls_counter is None:
+            return None
+        return polls_counter.labels(**labels, outcome=outcome)._value.get()
+
+    counters_before = {o: counter(o) for o in ("polled", "skipped")}
+    trace_start = len(recorder.trace)
+    cc = cache.cache_controller
+    waiting: deque = deque()
+    running: dict = {}
+    next_ack = [0]
+    issued: list = []
+    checks: list = []
+    kinds: list = []
+    received: list = []
+    broadcast_steps: list = []
+    blocker_states: list = []
+    failure = None
+
+    def issue(kind, k):
+        ack_id = next_ack[0]
+        next_ack[0] += 1
+        ev = FakeEvent(
+            clock,
+            k + ack_delay(seed, rank, ack_id),
+            ack_phase(seed, rank, ack_id) if midstep else 0,
+        )
+        ack = SimpleNamespace(
+            node_ids=[ack_id],
+            finish_event=ev,
+            start_event=None,
+            num_tokens_by_pool={},
+            num_bytes=0,
+            timing_enabled=False,
+        )
+        if kind == "write":
+            cache.ongoing_write_through[ack_id] = ack
+            cc.ack_write_queue.append(ack)
+        else:
+            cache.ongoing_load_back[ack_id] = (ack_id, None, None)
+            cc.ack_load_queue.append(ack)
+        issued.append([k, kind, ack_id, ev.ready_at, ev.ready_phase])
+
+    for k in range(iterations):
+        clock.k = k
+        clock.phase = 0
+        if rank == 0:
+            socket.inbox.extend(script.get(k, []))
+        n_trace = len(recorder.trace)
+        msgs = receiver.recv_requests()
+        if any(t[1] == "broadcast" for t in recorder.trace[n_trace:]):
+            broadcast_steps.append(k)
+        if input_blocker is not None:
+            blocker_states.append([k, input_blocker._state.name])
+        received.append([k, [repr(m) for m in msgs]])
+        kind = set()
+        for m in msgs:
+            if isinstance(m, Gen):
+                waiting.append(m)
+            elif isinstance(m, Abort):
+                kind.add("abort")
+                if m.rid in running:
+                    del running[m.rid]
+                    issue("write", k)  # the aborted request's prefix is cached
+                else:
+                    for w in list(waiting):
+                        if w.rid == m.rid:
+                            waiting.remove(w)
+
+        # get_next_batch_to_run -> _get_new_batch_prefill_raw -> the poll
+        clock.phase = 1
+        local_ready = [
+            cache._count_ready_acks(cc.ack_write_queue),
+            cache._count_ready_acks(cc.ack_load_queue),
+        ]
+        before = recorder.all_reduce_count()
+        n_drained = len(drained)
+        try:
+            cache.check_hicache_events()
+        except AssertionError as e:
+            failure = [k, str(e)]
+        polled = recorder.all_reduce_count() > before
+        checks.append([k, polled, local_ready, len(drained) - n_drained])
+        if failure is not None:
+            break
+
+        if waiting:
+            req = waiting.popleft()
+            kind.add("prefill")
+            if req.prompt_len % 3 == 0:
+                issue("load", k)  # a host hit loaded back for the prefix
+            running[req.rid] = req.max_new
+            issue("write", k)  # the prefilled prefix is written through
+        elif running:
+            kind.add("decode")
+            for rid in list(running):
+                running[rid] -= 1
+                if running[rid] <= 0:
+                    del running[rid]
+                    issue("write", k)  # the finished request is cached
+        else:
+            kind.add("idle")
+        kinds.append([k, "+".join(sorted(kind))])
+
+    dist.barrier()
+    return {
+        "name": name,
+        "armed": bool(gate is not None and gate.armed),
+        "trace": recorder.trace[trace_start:],
+        "checks": checks,
+        "kinds": kinds,
+        "issued": issued,
+        "drained": drained,
+        "hints": [] if gate is None else gate.hints,
+        "received": received,
+        "broadcast_steps": broadcast_steps,
+        "blocker_states": blocker_states,
+        "failure": failure,
+        "left": {
+            "write_queue": len(cc.ack_write_queue),
+            "load_queue": len(cc.ack_load_queue),
+            "ongoing_write_through": len(cache.ongoing_write_through),
+            "ongoing_load_back": len(cache.ongoing_load_back),
+        },
+        "gate": None
+        if gate is None
+        else {
+            "polls": gate.polls,
+            "skips": gate.skips,
+            "unlogged_skips": gate._unlogged_skips,
+            "heartbeat_calls": gate.heartbeat_calls,
+        },
+        "counters": {
+            o: (None if counter(o) is None else counter(o) - counters_before[o])
+            for o in ("polled", "skipped")
+        },
+    }
+
+
+def main():
+    rank, world, store, out_dir = (
+        int(sys.argv[1]),
+        int(sys.argv[2]),
+        sys.argv[3],
+        sys.argv[4],
+    )
+    dist.init_process_group(
+        "gloo",
+        init_method=f"file://{store}",
+        rank=rank,
+        world_size=world,
+        timeout=datetime.timedelta(seconds=30),
+    )
+    # Outside a launched server the runtime context is unpublished; what the
+    # receiver, the skipper and the arming read is pinned to box-c's shape.
+    receiver_mod.get_disagg = lambda: SimpleNamespace(language_only=False)
+    layout = parallel_layout(rank, world)
+    receiver_mod.get_parallel = lambda: layout
+    scheduler_mod.get_parallel = lambda: layout
+    recv_skipper_mod.get_parallel = lambda: layout
+    poll_based_barrier.get_parallel = lambda: layout
+    # The tokenizer socket's wire format is not under test.
+    receiver_mod.sock_recv = lambda sock, flags=0: sock.pop()
+
+    clock = Clock()
+    recorder = Recorder(clock)
+    metrics_collector = RadixCacheMetricsCollector(
+        labels={"cache_type": "UnifiedRadixCache", "tp_rank": str(rank)}
+    )
+    # The idle tail is longer than the 64-call heartbeat, so one fires there.
+    seed, iterations, idle_tail = 7, 420, 100
+    script = traffic_script(seed, iterations, idle_tail)
+    results = []
+    for name, poll_on_hint in (("gated", True), ("ungated", False)):
+        results.append(
+            run_scenario(
+                rank,
+                world,
+                name,
+                poll_on_hint=poll_on_hint,
+                heartbeat=64,
+                seed=seed,
+                iterations=iterations,
+                idle_tail=idle_tail,
+                script=script,
+                digest_fn=lambda k: 0,
+                metrics_collector=metrics_collector,
+                recorder=recorder,
+                clock=clock,
+            )
+        )
+    # Acks also become ready between the broadcast and the poll (phase 1).
+    # Receives skipped by the real recv skipper (interval 3). The real input
+    # blocker holds requests back from step 150 to step 230.
+    blocked_script = {k: list(v) for k, v in script.items()}
+    blocked_script.setdefault(150, []).insert(
+        0, BlockReqInput(req_type=BlockReqType.BLOCK)
+    )
+    blocked_script.setdefault(230, []).insert(
+        0, BlockReqInput(req_type=BlockReqType.UNBLOCK)
+    )
+    for prefix, options, run_script in (
+        ("midstep", dict(midstep=True), script),
+        ("skipper", dict(recv_interval=3), script),
+        ("blocker", dict(blocker=True), blocked_script),
+    ):
+        for name, poll_on_hint in (("gated", True), ("ungated", False)):
+            results.append(
+                run_scenario(
+                    rank,
+                    world,
+                    f"{prefix}_{name}",
+                    poll_on_hint=poll_on_hint,
+                    heartbeat=64,
+                    seed=seed,
+                    iterations=iterations,
+                    idle_tail=idle_tail,
+                    script=run_script,
+                    digest_fn=lambda k: 0,
+                    metrics_collector=metrics_collector,
+                    recorder=recorder,
+                    clock=clock,
+                    **options,
+                )
+            )
+    # write_back's duplicate-reclaim digest diverges on rank 5 at step 37 of
+    # an idle stretch: no ack is ever ready, so only the heartbeat polls.
+    for name, poll_on_hint in (("digest_gated", True), ("digest_ungated", False)):
+        results.append(
+            run_scenario(
+                rank,
+                world,
+                name,
+                poll_on_hint=poll_on_hint,
+                heartbeat=16,
+                seed=seed,
+                iterations=120,
+                idle_tail=120,
+                script={},
+                digest_fn=lambda k: 7 if (rank == 5 and k >= 37) else 0,
+                metrics_collector=metrics_collector,
+                recorder=recorder,
+                clock=clock,
+            )
+        )
+    with open(os.path.join(out_dir, f"rank{rank}.json"), "w") as f:
+        json.dump(results, f)
+    dist.barrier()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()
