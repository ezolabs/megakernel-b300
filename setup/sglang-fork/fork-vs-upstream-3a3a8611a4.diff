+# HiRadixCache is gone upstream: the unified tree is the only HiCache owner.
+@pytest.mark.parametrize("cache_cls_name", ["UnifiedRadixCache"])
+def test_local_readiness(cache_cls_name):
+    if cache_cls_name == "UnifiedRadixCache":
+        from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache as cls
+    else:
+        from sglang.srt.mem_cache.hiradix_cache import HiRadixCache as cls
+
+    def make(write, load, storage=None):
+        cache = object.__new__(cls)
+        q = _storage_queues(storage or [0, 0, 0, 0])
+        cache.cache_controller = SimpleNamespace(
+            ack_write_queue=[_ack(x) for x in write],
+            ack_load_queue=[_ack(x) for x in load],
+            prefetch_hit_queue=q[0],
+            ack_prefetch_queue=q[1],
+            ack_backup_queue=q[2],
+            host_mem_release_queue=q[3],
+            extra_host_mem_release_queues={},
+        )
+        # UnifiedRadixCache.enable_storage is the tree core's.
+        cache.tree_core = SimpleNamespace(enable_storage=False)
+        cache.enable_storage = storage is not None
+        return cache
+
+    assert make([], [])._local_hicache_events_ready() is False
+    # Only the head counts: _count_ready_acks stops at the first unready ack.
+    assert make([False, True], [False])._local_hicache_events_ready() is False
+    assert make([True, False], [])._local_hicache_events_ready() is True
+    assert make([], [True])._local_hicache_events_ready() is True
+    assert make([], [], storage=[0, 0, 0, 0])._local_hicache_events_ready() is False
+    for i in range(4):
+        sizes = [0, 0, 0, 0]
+        sizes[i] = 2
+        assert make([], [], storage=sizes)._local_hicache_events_ready() is True
+    if cls.__name__ == "UnifiedRadixCache":
+        cache = make([], [], storage=[0, 0, 0, 0])
+        cache.cache_controller.extra_host_mem_release_queues = {
+            "swa": _storage_queues([1])[0]
+        }
+        assert cache._local_hicache_events_ready() is True
+        cache.cache_controller = None
+        assert cache._local_hicache_events_ready() is False
+
