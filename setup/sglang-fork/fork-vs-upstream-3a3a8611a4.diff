+def _serve(
+    tree,
+    model,
+    pools,
+    req,
+    *,
+    piece=4,
+    floor_mode="replay",
+    counter=None,
+    trim_tail=None,
+    after_replay=None,
+):
+    """Admit ``req``, lay out its row as prepare_for_extend does, replay its
+    rebuild, then run its own extend. Returns (logits, runner, full-pool copy
+    before the replay). ``trim_tail``: run under the exact trim with tail R;
+    ``after_replay(row)`` runs between the replay and the extend."""
+    adder, res = _admit(tree, req)
+    assert res == AddReqResult.CONTINUE, res
+    alloc = tree.token_to_kv_pool_allocator
+    idx = tree.req_to_token_pool.alloc_rows(1)[0]
+    req.kv.req_pool_idx = idx
+    n = len(req.origin_input_ids)
+    b = req.prefix_len
+    row = tree.req_to_token_pool.req_to_token[idx]
+    row[:b] = tree.prefix_device_indices(req).to(row.dtype)
+    row[b:n] = alloc.alloc(n - b).to(row.dtype)
+    runner = _Runner(model, pools, tree, floor_mode, trim_tail)
+    worker = SimpleNamespace(
+        model_runner=runner, hicache_layer_transfer_counter=counter
+    )
+    batch = SimpleNamespace(
+        reqs=[req],
+        forward_mode=ForwardMode.EXTEND,
+        req_pool_indices=torch.tensor([idx]),
+        req_pool_indices_cpu=torch.tensor([idx]),
+        global_num_tokens=None,
+        engram_history=None,
+        # The live batch's per-request late floors (prepare_for_extend): the
+        # replay must not inherit them.
+        late_tail_prompt_lens=[n],
+        late_tail_floor_gs=[req.late_floor_g],
+    )
+    m_before = pools["m"].clone()
+    with mock.patch(
+        "sglang.srt.model_executor.forward_batch_info.ForwardBatch.init_new",
+        side_effect=_fake_init_new,
+    ):
+        replayed = replay_mod.run_swa_branch_rebuild(worker, batch, piece_tokens=piece)
+    assert replayed == req.swa_rebuild.end - req.swa_rebuild.start
+    assert torch.equal(pools["m"], m_before)  # the replay wrote no Full latent
+    assert replay_mod.run_swa_branch_rebuild(worker, batch, piece_tokens=piece) == 0
+    if after_replay is not None:
+        after_replay(row)
+    own = SimpleNamespace(
+        input_ids=torch.tensor(list(req.origin_input_ids[b:n])),
+        prefix_lens=[b],
+        seq_lens_cpu=torch.tensor([n]),
+        out_cache_loc=row[b:n].long(),
+        req_pool_indices=torch.tensor([idx]),
+        encoder_swa_replay=False,
+        encoder_swa_row_floor=None,
+        late_tail_prompt_lens=[n],
+        late_tail_floor_gs=[req.late_floor_g],
+    )
+    logits = runner.forward(own)
+    scratch = req.swa_rebuild.end - req.swa_rebuild.start - TAIL
+    assert release_scratch(batch.reqs, alloc) == scratch
+    assert req.swa_rebuild is None
+    return logits, runner, row
+
+
+def _swa_kv(pools, mapping, row, lo, hi):
+    slots = mapping[row[lo:hi].long()]
+    return pools["k"][slots], pools["v"][slots]
+
+
+def _previous_turn(model, tree, prompt=PROMPT):
+    """The stored turn, prefilled through the pools at the tree's slots; the
+    SWA slots it dropped are then overwritten, as reuse would."""
+    pools = model.pools()
+    alloc = tree.token_to_kv_pool_allocator
+    stored = len(prompt)
+    slots = alloc.alloc(stored)
+    row = torch.zeros(KV_SIZE, dtype=torch.int64)
+    row[:stored] = slots
+    model.forward(
+        pools, alloc.full_to_swa_index_mapping, row, prompt, 0, stored, write_full=True
+    )
+    evicted = stored - TAIL
+    tree.insert(
+        InsertParams(
+            key=RadixKey(array("q", prompt)),
+            value=slots,
+            component_evicted_seqlens={ComponentType.SWA: evicted},
+            late_exact_from=0,  # a cold prefill: every late row exact
+        )
+    )
+    dropped = alloc.full_to_swa_index_mapping[slots[:evicted]].clone()
+    alloc.free_swa(slots[:evicted])
+    noise = torch.Generator().manual_seed(7)
+    for name in ("k", "v"):
+        pools[name][dropped] = torch.randn(
+            pools[name][dropped].shape, generator=noise, dtype=torch.float64
+        )
+    return pools, slots
+
+
+def _check_exact(model, span, *, piece=4, floor_mode="replay"):
+    tree = _swa_cache()
+    tree.configure_swa_branch_rebuild(LAYERS)
+    tree.components[ComponentType.SWA].rebuild_span = span
+    pools, _ = _previous_turn(model, tree)
+    req = _branch_req()
+    logits, runner, row = _serve(
+        tree, model, pools, req, piece=piece, floor_mode=floor_mode
+    )
+    cold_logits, cold_pools, cold_row, cold_map = model.cold(list(req.origin_input_ids))
+    mapping = tree.token_to_kv_pool_allocator.full_to_swa_index_mapping
+    rebuilt = _swa_kv(pools, mapping, row, BRANCH - TAIL, BRANCH)
+    cold = _swa_kv(cold_pools, cold_map, cold_row, BRANCH - TAIL, BRANCH)
+    kv_err = max((a - b).abs().max().item() for a, b in zip(rebuilt, cold))
+    last_layer_err = max(
+        (a[:, -1] - b[:, -1]).abs().max().item() for a, b in zip(rebuilt, cold)
+    )
+    logit_err = (logits[-1] - cold_logits[-1]).abs().max().item()
+    return kv_err, last_layer_err, logit_err, runner
+
+
+def test_rebuilt_window_and_next_token_logits_equal_a_cold_prefill():
+    model = RefModel()
+    kv_err, _, logit_err, runner = _check_exact(model, SPAN)
+    assert kv_err < 1e-10 and logit_err < 1e-10
+    replays = [c for c in runner.calls if c[2]]
+    assert [(s, e) for s, e, _, _ in replays] == [(30, 34), (34, 38), (38, 40)]
+    assert {floor for *_, floor in replays} == {BRANCH - SPAN}
+
+
+def test_one_piece_equals_many():
+    model = RefModel()
+    kv_err, _, logit_err, _ = _check_exact(model, SPAN, piece=4096)
+    assert kv_err < 1e-10 and logit_err < 1e-10
+
+
+def test_control_one_token_short_of_the_span_is_inexact():
+    model = RefModel()
+    kv_err, last_layer_err, logit_err, _ = _check_exact(model, SPAN - 1)
+    # The last layer's KV at B - tail needs every token of R: the tree adopts
+    # the whole tail node as a valid window.
+    assert last_layer_err > 1e-6 and kv_err > 1e-6
+    # A continuation from B reads only [B - W + 1, B), which L (W - 1) tokens
+    # already make exact: R's extra tail - W + 1 tokens buy the node's own
+    # exactness, not the next token's.
+    assert logit_err < 1e-10
+    assert SPAN - 1 == LAYERS * (WINDOW - 1)
+
+
+def test_control_a_one_window_replay_is_inexact():
