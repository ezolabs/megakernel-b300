+def test_live_events_during_a_slow_render_follow_the_window(monkeypatch):
+    mirror, at_cut, truth, batches, while_open, render = _scenario(
+        monkeypatch, release_first=1
+    )
+
+    # While the window was open on the wire, only its first frame was out:
+    # the four live steps were held, not published into the window.
+    assert len(while_open) == 1 and _kinds(while_open[0])[0] == "SnapshotBegin"
+    ends = [i for i, b in enumerate(batches) if "SnapshotEnd" in _kinds(b)]
+    assert ends == [render.frames - 1]
+    snapshot, live = batches[: render.frames], batches[render.frames :]
+    assert all(
+        set(_kinds(b)) <= {"SnapshotBegin", "BlockStored", "SnapshotEnd"}
+        for b in snapshot
+    )
+    # The four steps, in order, after the window and nowhere else.
+    assert len(live) == 4
+    assert not any({"SnapshotBegin", "SnapshotEnd"} & set(_kinds(b)) for b in live)
+    assert [b.events[0].medium for b in live] == [GPU, CPU, GPU, CPU]
+
+    # The mirror adopted the cache at the cut, then the held steps moved it to
+    # exactly the cache's placement now: nothing lost, nothing applied twice.
+    ((verdict, adopted),) = mirror.baselines
+    assert verdict == "adopted"
+    assert adopted == at_cut
+    assert mirror.live == truth
+    assert mirror.live != at_cut
