index 0000000000..3a08f53ffd
--- /dev/null
+++ b/test/srt/sbr/test_d3_scheduler_snapshot_wiring.py
@@ -0,0 +1,380 @@
+"""#190 (d3): the scheduler answers a pending KV snapshot request.
+
+``ZmqEventPublisher`` can answer "I cannot replay that for you" with
+``SNAPSHOT_SEQ`` and latch the request (d1); a tree cache can re-announce every
+resident page (d2). This is the wiring between the two: ``publish_kv_events``
+drains the latch first and renders the snapshot *before* it drains the event
+queue, so the snapshot is published ahead of every event the cache records
+afterwards. A subscriber that rebuilds its view between SnapshotBegin and
+SnapshotEnd must not be handed an event that belongs to the view the snapshot
+replaces.
+
+Pinned here: the snapshot is recorded before ``take_events`` (call order, on a
+mock cache), a request is served on a step that produced no events of its own,
+the snapshot markers and pages land in one batch with the pending incremental
+events and close it, no request means no snapshot marker at all, a cache that
+enumerates nothing still drains the latch without raising, a disabled publisher
+publishes nothing and never reads the cache, and the whole path runs on real
+sockets: a DEALER whose request fell out of the buffer is answered
+``SNAPSHOT_SEQ`` then ``END_SEQ``, and the SUB then receives the snapshot batch.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import struct
+import time
+from array import array
+from dataclasses import dataclass
+from unittest import mock
+
+import msgspec
+import pytest
+import zmq
+
+from sglang.srt.disaggregation.kv_events import (
+    AllBlocksCleared,
+    BlockStored,
+    KVEventBatch,
+    SnapshotBegin,
+    SnapshotEnd,
+    ZmqEventPublisher,
+)
+from sglang.srt.mem_cache.base_prefix_cache import InsertParams
+from sglang.srt.mem_cache.cpp_utils import native_hash
+from sglang.srt.mem_cache.radix_cache import RadixCache, RadixKey
+from sglang.srt.managers.scheduler_components.kv_events_publisher import (
+    SchedulerKvEventsPublisher,
+)
+
+class _PurePythonNativeHash:
+    """Stand-in for the compiled hasher: same contract, same chaining.
+
+    Hashes reach the events through ``get_native_hash``, a compiled extension
+    that only loads on little-endian Linux; this suite runs on a CPU-only macOS
+    host. The double below is the one d2's suite uses, so the pages a snapshot
+    announces here are computed the same way.
+    """
+
+    @staticmethod
+    def get_hash(raw, logical_len, unit_width, is_bigram, prior_digest, page_size):
+        page_size = page_size or 1
+        digest = prior_digest
+        digests = []
+        for start in range(0, logical_len, page_size):
+            end = min(start + page_size, logical_len)
+            payload = bytearray()
+            for index in range(start, end):
+                for lane in range(unit_width):
+                    payload += struct.pack("<q", raw[index * unit_width + lane])
+            digest = hashlib.sha256((digest or b"") + bytes(payload)).digest()
+            digests.append(digest.hex())
+        return digests
+
+
+@pytest.fixture(autouse=True)
+def _native_hash_module():
+    """The compiled hasher where it loads, the Python double where it cannot."""
+    try:
+        native_hash._load_native_hash_module()
+    except RuntimeError:
+        pass
+    else:
+        yield
+        return
+    with mock.patch.object(
+        native_hash, "_load_native_hash_module", lambda: _PurePythonNativeHash()
+    ):
+        yield
+
+
+PAGE_SIZE = 2
+POLL_TIMEOUT_MS = 10_000
+_endpoint_counter = itertools.count()
+
+
+@dataclass
+class _FakeParallelState:
+    """Only the ranks ``is_kv_publisher_rank`` / port selection read."""
+
+    pp_rank: int = 0
+    attn_tp_rank: int = 0
+    attn_cp_rank: int = 0
+    attn_dp_size: int = 1
+    attn_dp_rank: int = 0
+    dp_rank: int = 0
+
+
+class _LatchingPublisher:
+    """A publisher that stands in for the zmq one: records batches, owns the
+    latch. ``snapshot_requests`` is how many pending requests the cache owner
+    finds when it drains."""
+
+    def __init__(self, *, snapshot_requests: int = 0) -> None:
+        self.batches: list = []
+        self._pending = snapshot_requests
+
+    def publish(self, batch) -> None:
+        self.batches.append(batch)
+
+    def take_snapshot_request(self) -> bool:
+        if self._pending > 0:
+            self._pending -= 1
+            return True
+        return False
+
+    def shutdown(self) -> None:
+        pass
+
+    def kinds(self, index: int) -> list:
+        return [type(event).__name__ for event in self.batches[index].events]
+
+
+def _scheduler(cache, publisher, kv_events_config='{"publisher": "null"}'):
+    """A scheduler component wired to ``cache`` and ``publisher``.
+
+    ``{"publisher": "null"}`` keeps the real factory path (including the config
+    splat every publisher constructor has to accept) and is then swapped for the
+    recording publisher, so the test never depends on a socket.
+    """
+    # Upstream reads the publisher ranks off the runtime context (rank 0 here).
+    from sglang.srt.runtime_context import get_parallel
+
+    with get_parallel().override(
+        pp_rank=0,
+        attn_tp_rank=0,
+        attn_cp_rank=0,
+        attn_dp_size=1,
+        attn_dp_rank=0,
+        dp_rank=0,
+    ):
+        component = _make_component(cache, kv_events_config)
+    component.kv_event_publisher = publisher
+    return component
+
+
+def _make_component(cache, kv_events_config):
+    return SchedulerKvEventsPublisher(
+        kv_events_config=kv_events_config,
+        tree_cache=cache,
+        send_metrics_from_scheduler=None,
+        max_running_requests=8,
+        max_total_num_tokens=1024,
+        get_stats=lambda: None,
+    )
+
+
+def _events_enabled_cache() -> RadixCache:
+    cache = RadixCache.create_simulated(
+        page_size=PAGE_SIZE, enable_kv_cache_events=True
+    )
+    cache.take_events()  # construction announces AllBlocksCleared
+    return cache
+
+
+def test_snapshot_is_recorded_before_the_cache_is_drained():
+    cache = mock.Mock()
+    cache.record_kv_snapshot.return_value = 2
+    cache.take_events.return_value = []
+    publisher = _LatchingPublisher(snapshot_requests=1)
+    component = _scheduler(cache, publisher)
+
+    component.publish_kv_events()
+
+    # Order is the whole point: an event recorded after the walk belongs to the
+    # snapshot's world, one recorded before it is replaced by the reset.
+    assert [call[0] for call in cache.mock_calls] == [
+        "record_kv_snapshot",
+        "take_events",
+    ]
+    # Nothing to publish: the snapshot announced no events here (the mock cache
+    # owns its own queue) and the drain came back empty.
+    assert publisher.batches == []
+    assert publisher.take_snapshot_request() is False
+
+
+def test_snapshot_closes_the_batch_and_later_events_stay_after_it():
+    cache = _events_enabled_cache()
+    cache.insert(InsertParams(key=RadixKey(array("q", [1, 2, 3, 4]))))
+    publisher = _LatchingPublisher(snapshot_requests=1)
+    component = _scheduler(cache, publisher)
+
+    component.publish_kv_events()
+
+    (batch,) = publisher.batches
+    kinds = [type(event).__name__ for event in batch.events]
+    # The insert's own event was already queued when the request arrived; the
+    # snapshot is recorded after it and ends the batch.
+    assert kinds[0] == "BlockStored"
+    assert kinds[-1] == "SnapshotEnd"
+    begin = kinds.index("SnapshotBegin")
+    assert set(kinds[begin + 1 : -1]) == {"BlockStored"}
+    assert batch.events[begin].num_blocks == 2
+    assert batch.events[-1].num_blocks == 2
+    snapshot_pages = [
+        event for event in batch.events[begin + 1 : -1] if isinstance(event, BlockStored)
+    ]
+    # One store event per tree node, carrying every page of that node: the
+    # page count is in the framing, not in the event count.
+    assert len(snapshot_pages) == 1
+    assert len(snapshot_pages[0].block_hashes) == 2
+    assert snapshot_pages[0].token_ids == [1, 2, 3, 4]
+
+    # The next step's events are published in a later batch: nothing a
+    # subscriber sees is interleaved into the snapshot it rebuilds from.
+    cache.insert(InsertParams(key=RadixKey(array("q", [1, 2, 5, 6]))))
+    component.publish_kv_events()
+
+    assert len(publisher.batches) == 2
+    assert all(isinstance(e, BlockStored) for e in publisher.batches[1].events)
+    assert publisher.batches[1].events
+    assert publisher.take_snapshot_request() is False
+
+
+def test_no_request_publishes_incremental_events_only():
+    cache = _events_enabled_cache()
+    cache.insert(InsertParams(key=RadixKey(array("q", [1, 2, 3, 4]))))
+    publisher = _LatchingPublisher(snapshot_requests=0)
+    component = _scheduler(cache, publisher)
+
+    component.publish_kv_events()
+
+    assert publisher.kinds(0) == ["BlockStored"]
+
+
+def test_a_request_is_served_on_a_step_with_no_events_of_its_own():
+    cache = _events_enabled_cache()
+    assert cache.take_events() == []
+    publisher = _LatchingPublisher(snapshot_requests=1)
+    component = _scheduler(cache, publisher)
+
+    component.publish_kv_events()
+
+    # An empty snapshot is a complete answer (the subscriber's view is empty),
+    # so it is published rather than swallowed as "no events".
+    assert publisher.kinds(0) == ["SnapshotBegin", "SnapshotEnd"]
+    assert [event.num_blocks for event in publisher.batches[0].events] == [0, 0]
+    assert publisher.take_snapshot_request() is False
+
+
+def test_a_cache_that_enumerates_nothing_still_drains_the_latch():
+    cache = mock.Mock()
+    cache.record_kv_snapshot.return_value = 0
+    cache.take_events.return_value = []
+    publisher = _LatchingPublisher(snapshot_requests=1)
+    component = _scheduler(cache, publisher)
+
+    component.publish_kv_events()
+
+    cache.record_kv_snapshot.assert_called_once_with()
+    assert publisher.batches == []
+    # Drained: a request that cannot be answered must not stay latched forever.
+    assert publisher.take_snapshot_request() is False
+
+
+def test_a_disabled_publisher_never_reads_the_cache():
+    cache = mock.Mock()
+    component = _make_component(cache, None)
+
+    assert component.enable_kv_cache_events is False
+    assert component.kv_event_publisher is None
+    component.publish_kv_events()
+
+    assert cache.mock_calls == []
+    assert cache.take_events.call_count == 0
+
+
+def _await_reply(dealer) -> list:
+    frames: list = []
+    deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+    while time.monotonic() < deadline:
+        if not dealer.poll(200):
+            continue
+        frames_in = dealer.recv_multipart()
+        seq_bytes, payload = frames_in[-2:]
+        seq = int.from_bytes(seq_bytes, "big", signed=True)
+        frames.append((seq, payload))
+        if seq == -1:  # END_SEQ
+            return frames
+    raise AssertionError(f"no END_SEQ within {POLL_TIMEOUT_MS} ms: {frames!r}")
+
+
+def _await_snapshot_batch(sub) -> KVEventBatch:
+    seen: list = []
+    deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+    while time.monotonic() < deadline:
+        if not sub.poll(200):
+            continue
+        _topic, _seq, payload = sub.recv_multipart()
+        batch = msgspec.msgpack.decode(payload, type=KVEventBatch)
+        if any(isinstance(event, SnapshotBegin) for event in batch.events):
+            return batch
+        seen.append([type(event).__name__ for event in batch.events])
+    raise AssertionError(f"no snapshot batch within {POLL_TIMEOUT_MS} ms: saw {seen}")
+
+
+def test_a_replay_gap_on_the_wire_comes_back_as_a_snapshot_batch():
+    """The whole path, with the publisher a server would really run.
+
+    A DEALER asks for a sequence the 1-deep buffer has evicted; the publisher
+    answers SNAPSHOT_SEQ and END_SEQ and latches the request; the scheduler step
+    that follows renders the cache into a snapshot and publishes it, and the SUB
+    (a subscriber that stayed connected) receives that batch.
+    """
+    ctx = zmq.Context.instance()
+    index = next(_endpoint_counter)
+    pub_endpoint = f"inproc://d3-snap-{index}-pub"
+    replay_endpoint = f"inproc://d3-snap-{index}-replay"
+
+    # SUB and DEALER before the publisher exists: the subscription is in place
+    # before the first publish (no ZeroMQ slow-joiner drop) and the replay
+    # request is queued, not sent into a pipe that is not there yet.
+    sub = ctx.socket(zmq.SUB)
+    sub.setsockopt(zmq.SUBSCRIBE, b"")
+    sub.connect(pub_endpoint)
+    dealer = ctx.socket(zmq.DEALER)
+    dealer.connect(replay_endpoint)
+
+    publisher = ZmqEventPublisher(
+        attn_dp_rank=0,
+        endpoint=pub_endpoint,
+        replay_endpoint=replay_endpoint,
+        buffer_steps=1,
+    )
+    cache = _events_enabled_cache()
+    cache.insert(InsertParams(key=RadixKey(array("q", [1, 2, 3, 4]))))
+    component = _scheduler(cache, publisher)
+
+    try:
+        for stamp in (1.0, 2.0, 3.0):
+            publisher.publish(KVEventBatch(ts=stamp, events=[AllBlocksCleared()]))
+        # The publisher thread may still be draining the queue; a request sent
+        # too early would be answered from a buffer that still held seq 0, so
+        # wait until the third batch has gone out (its seq is the last one the
+        # publisher stamped).
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while publisher._last_seq < 2 and time.monotonic() < deadline:
+            time.sleep(0.01)
+        assert publisher._last_seq == 2
+        # seq 0 is gone from a 1-deep buffer, so this request cannot be served.
+        dealer.send_multipart([b"", (0).to_bytes(8, "big", signed=True)])
+        frames = _await_reply(dealer)
+        assert [seq for seq, _ in frames] == [-2, -1]
+
+        component.publish_kv_events()
+
+        batch = _await_snapshot_batch(sub)
+        kinds = [type(event).__name__ for event in batch.events]
+        assert kinds[-1] == "SnapshotEnd"
+        begin = kinds.index("SnapshotBegin")
+        assert batch.events[begin].num_blocks == 2
+        assert batch.events[-1].num_blocks == 2
+        assert [
+            t for event in batch.events[begin + 1 : -1] for t in event.token_ids
+        ] == [1, 2, 3, 4]
+        assert publisher.take_snapshot_request() is False
+    finally:
+        publisher.shutdown()
+        sub.close(linger=0)
+        dealer.close(linger=0)
