+import tempfile
+import textwrap
+import unittest
+from pathlib import Path
+
+_SCRIPT = Path(__file__).resolve().with_name("self_hosted_runners.py")
+_SPEC = importlib.util.spec_from_file_location("self_hosted_runners", _SCRIPT)
+assert _SPEC is not None and _SPEC.loader is not None
+shr = importlib.util.module_from_spec(_SPEC)
+sys.modules["self_hosted_runners"] = shr
+_SPEC.loader.exec_module(shr)
+
+COMPOSED = shr.COMPOSED_LABELS["${{ matrix.os }}-latest"]
