+def _tokenizer_manager(*, scheduler_delay=0.002):
+    """A ``TokenizerManager`` with the parts around ``generate_request`` replaced: the
+    scheduler round trip (an async generator that feeds ``_handle_batch_output`` one
+    output batch), the dispatch and the tokenized-object builder. ``generate_request``,
+    ``_tokenize_one_request`` and ``_handle_batch_output`` are the real ones."""
+    tm = TokenizerManager.__new__(TokenizerManager)
+    tm.rid_to_state = {}
+    tm.enable_trace = False
+    tm.disaggregation_mode = DisaggregationMode.NULL
+    tm.auto_create_handle_loop = lambda: None
+    tm._set_default_priority = lambda obj: None
+    tm.elastic_worker_count = 1
+    tm.request_logger = mock.Mock()
+    tm.tokenizer = None
+    tm.mm_processor = None
+    tm.model_config = SimpleNamespace(hf_config=SimpleNamespace(architectures=[]))
+    tm.is_pause = False
+    tm.is_pause_cond = asyncio.Condition()
+    tm.model_update_lock = SimpleNamespace(reader_lock=_AsyncNull())
+    tm.enable_metrics = False
+    tm.enable_lora = False
+    tm.skip_tokenizer_init = True
+    tm.incremental_streaming_output = False
+    tm.dump_requests_folder = ""
+    tm.crash_dump_folder = ""
+    tm.config_value = lambda name: "v1"
+    tm.recv_at_log = []
+
+    async def no_lora(obj):
+        return None
+
+    tm._validate_and_resolve_lora = no_lora
+    tm._validate_one_request = lambda obj, input_ids: time.sleep(0.001)
+
+    def create_tokenized(obj, input_text, input_ids, *args, **kwargs):
+        tokenized = SimpleNamespace(rid=obj.rid, input_ids=input_ids)
+        tokenized.time_stats = tm.rid_to_state[obj.rid].time_stats
+        tokenized.time_stats.set_tokenize_finish_time()
+        return tokenized
+
+    tm._create_tokenized_object = create_tokenized
+
+    async def send_one(tokenized):
+        await asyncio.sleep(0.001)
+        tokenized.time_stats.set_api_server_dispatch_time()
+        tm.rid_to_state[tokenized.rid].dispatched = True
+
+    tm._send_one_request = send_one
+
+    async def wait_one(obj, request):
+        # The scheduler's answer: the first output batch, after a delay, handed to the
+        # real ``_handle_batch_output`` the way ``handle_loop`` hands it over.
+        await asyncio.sleep(scheduler_delay)
+        recv_obj = mock.MagicMock(spec=BatchStrOutput)
+        recv_obj.rids = [obj.rid]
+        recv_obj.time_stats = None
+        recv_obj.customized_info = None
+        recv_obj.finished_reasons = [None]
+        recv_obj.prompt_tokens = [len(obj.input_ids or [])]
+        recv_obj.retraction_counts = [0]
+        recv_obj.output_strs = ["Hi"]
+        recv_obj.completion_tokens = [1]
+        recv_obj.cached_tokens = [2]
+        recv_obj.output_ids = [[1]]
+        recv_obj.weight_versions = None
+        recv_obj.cached_tokens_details = None
+        recv_obj.reasoning_tokens = [0]
+        tm_recv_at = time.perf_counter() if spt.DETAIL else None
+        await tm._handle_batch_output(recv_obj, tm_recv_at)
+        yield {"text": "Hi"}
+
+    tm._wait_one_response = wait_one
+    return tm
+
+
+@contextlib.contextmanager
+def _tm_runtime():
+    with (
+        mock.patch.object(
+            tm_module, "get_disagg", return_value=SimpleNamespace(language_only=False)
+        ),
+        mock.patch.object(
+            tm_module, "get_serving", return_value=SimpleNamespace(batch_notify_size=1)
+        ),
+        mock.patch.object(
+            tm_module,
+            "get_spec",
+            return_value=SimpleNamespace(speculative_algorithm=None),
+        ),
+    ):
+        yield
