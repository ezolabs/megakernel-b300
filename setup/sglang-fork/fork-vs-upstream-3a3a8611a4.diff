+def test_a_placeholder_messages_body_builds_the_same_generate_request(
+    tokenizer, box_c_env
+):
+    """The third conversion: the router's ids with the placeholder for ``messages`` builds
+    the ``GenerateReqInput`` the second conversion (ids beside the real messages) builds, in
+    every field: ``input_ids``, ``sampling_params`` (the tool-call constraint and the stop
+    list included), ``require_reasoning``, ``return_prompt_token_ids``. The request the
+    output parsers read differs in ``messages`` alone."""
+    chat = _handler(tokenizer)
+    constrained = {"real": [], "placeholder": []}
+    reasoning = {"real": Counter(), "placeholder": Counter()}
+    for record in RECORDS:
+        by_ids, real, _ = _convert(chat, record["egress"], record["router_ids"])
+        by_placeholder, placeholder, encoded = _convert_with_placeholder(chat, record)
+        assert encoded == [], record["id"]
+        assert by_placeholder.input_ids == record["router_ids"], record["id"]
+        assert _field_differences(by_ids, by_placeholder) == {}, record["id"]
+        assert by_placeholder.sampling_params == by_ids.sampling_params, record["id"]
+        assert by_placeholder.require_reasoning == by_ids.require_reasoning
+        assert (
+            by_placeholder.return_prompt_token_ids == by_ids.return_prompt_token_ids
+        ), record["id"]
+        for kind, adapted in (("real", by_ids), ("placeholder", by_placeholder)):
+            if adapted.sampling_params.get("structural_tag"):
+                constrained[kind].append(record["id"])
+            reasoning[kind][adapted.require_reasoning] += 1
+        # The request: the same, but for the messages it carries.
+        assert [(m.role, m.content) for m in placeholder.messages] == [("user", "")]
+        a, b = real.model_dump(), placeholder.model_dump()
+        a.pop("messages"), b.pop("messages")
+        assert a == b, record["id"]
+    # The comparison is not vacuous: the tool-call constraint and the reasoning flag are
+    # built on the placeholder path, and they vary across the corpus (as in the test above).
+    assert constrained["placeholder"] == constrained["real"]
+    assert len(constrained["placeholder"]) == 8
+    assert reasoning["placeholder"] == reasoning["real"] == {True: 43, False: 124}
+
