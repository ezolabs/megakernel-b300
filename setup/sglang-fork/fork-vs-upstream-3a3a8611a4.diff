diff --git a/python/sglang/srt/managers/mm_cached_refs.py b/python/sglang/srt/managers/mm_cached_refs.py
new file mode 100644
index 0000000000..03f180baf4
--- /dev/null
+++ b/python/sglang/srt/managers/mm_cached_refs.py
@@ -0,0 +1,239 @@
+"""Pixel-less image refs for images inside the cached prefix.
+
+Gated by ``SGLANG_MM_CACHED_REFS`` (default off). A request may omit the pixels
+of an image whose KV the engine already holds. The image keeps its placeholder
+in the prompt and its caller hash in ``mm_hashes``; ``mm_cached_refs`` names it
+by its position among ALL the request's images plus its post-EXIF ``width`` and
+``height``, which fix its placeholder token count. The processor then builds a
+feature-less item with the same pad ids and the same span as the full item.
+
+The scheduler admits such a request only if every omitted image ends inside the
+matched prefix (device + host hit), or -- when
+``SGLANG_MM_CACHED_REFS_EMBEDDING_CACHE`` is on -- its embedding is in the
+hash-keyed embedding cache. It checks on receive (fail fast) and again at
+admission; a miss aborts the request before any prefill of its prompt with
+HTTP 409 and err_type ``mm_bytes_required``; the caller resends with bytes.
+"""
+
+from __future__ import annotations
+
+import logging
+from http import HTTPStatus
+from typing import Any, Dict, List, Optional, Tuple
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+MM_BYTES_REQUIRED = "mm_bytes_required"
+MM_BYTES_REQUIRED_STATUS = HTTPStatus.CONFLICT
+# model_specific_data marker carried by a pixel-less item.
+MM_CACHED_REF_KEY = "mm_cached_ref"
+# Chat path: an omitted image keeps its image_url part, with this URL.
+CACHED_REF_URL_PREFIX = "sglang-mm-cached-ref:"
+
+
+def enabled() -> bool:
+    return envs.SGLANG_MM_CACHED_REFS.get()
+
+
+def embedding_cache_enabled() -> bool:
+    return envs.SGLANG_MM_CACHED_REFS_EMBEDDING_CACHE.get()
+
+
+class MmCachedRefsError(ValueError):
+    """A malformed or unsupported mm_cached_refs request (HTTP 400)."""
+
+
+class MmBytesRequiredError(Exception):
+    """Raised by the HTTP layers to answer 409 mm_bytes_required."""
+
+    def __init__(self, message: str):
+        super().__init__(message)
+        self.message = message
+
+
+def has_refs(obj: Any) -> bool:
+    return bool(getattr(obj, "mm_cached_refs", None))
+
+
+def _check_int(value: Any, name: str, minimum: int) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
+        raise MmCachedRefsError(
+            f"mm_cached_refs {name} must be an integer >= {minimum}, got {value!r}"
+        )
+    return value
+
+
+def normalize_refs(
+    refs: Any, present_image_count: int, mm_hashes: Any
+) -> Optional[List[Dict[str, int]]]:
+    """Validate one request's refs; return them sorted by index, or None.
+
+    ``index`` is the image's position among all the request's images (present
+    and omitted) in prompt order, which is also its position in ``mm_hashes``.
+    """
+    if refs is None or (isinstance(refs, list) and not refs):
+        return None
+    if not enabled():
+        raise MmCachedRefsError(
+            "mm_cached_refs requires SGLANG_MM_CACHED_REFS=1 on the engine"
+        )
+    if not isinstance(refs, list):
+        raise MmCachedRefsError("mm_cached_refs must be a list")
+    out: List[Dict[str, int]] = []
+    seen = set()
+    for i, ref in enumerate(refs):
+        if not isinstance(ref, dict):
+            raise MmCachedRefsError(f"mm_cached_refs[{i}] must be an object")
+        missing = [k for k in ("index", "width", "height") if k not in ref]
+        if missing:
+            raise MmCachedRefsError(f"mm_cached_refs[{i}] is missing {missing}")
+        index = _check_int(ref["index"], "index", 0)
+        width = _check_int(ref["width"], "width", 1)
+        height = _check_int(ref["height"], "height", 1)
+        if index in seen:
+            raise MmCachedRefsError(f"mm_cached_refs has duplicate index {index}")
+        seen.add(index)
+        out.append({"index": index, "width": width, "height": height})
+    total = present_image_count + len(out)
+    for ref in out:
+        if ref["index"] >= total:
+            raise MmCachedRefsError(
+                f"mm_cached_refs index {ref['index']} out of range for "
+                f"{total} images ({present_image_count} with bytes)"
+            )
+    if not isinstance(mm_hashes, list) or len(mm_hashes) != total:
+        got = len(mm_hashes) if isinstance(mm_hashes, list) else 0
+        raise MmCachedRefsError(
+            "mm_cached_refs requires mm_hashes with one entry per image "
+            f"(with bytes + omitted = {total}), got {got}"
+        )
+    for i, h in enumerate(mm_hashes):
+        try:
+            if not isinstance(h, str):
+                raise ValueError
+            int(h, 16)
+        except ValueError:
+            raise MmCachedRefsError(
+                f"mm_cached_refs requires valid hex mm_hashes; mm_hashes[{i}]={h!r}"
+            ) from None
+    out.sort(key=lambda r: r["index"])
+    return out
+
+
+def is_cached_ref_item(item: Any) -> bool:
+    if getattr(item, "feature", None) is not None:
+        return False
+    data = getattr(item, "model_specific_data", None)
+    return bool(data) and bool(data.get(MM_CACHED_REF_KEY))
+
+
+def cached_ref_items(mm_inputs: Any) -> list:
+    if mm_inputs is None:
+        return []
+    return [item for item in mm_inputs.mm_items if is_cached_ref_item(item)]
+
+
+def _item_end(item: Any) -> int:
+    """Exclusive end of the item's last placeholder span."""
+    return max(end for _, end in item.offsets) + 1
+
+
+def check_coverage(
+    mm_inputs: Any, covered_len: int, allow_embedding_cache: bool
+) -> Tuple[int, int, List[Any]]:
+    """Return (served_from_prefix, served_from_embedding_cache, missing_items)."""
+    from_prefix = 0
+    from_cache = 0
+    missing = []
+    cache = None
+    if allow_embedding_cache:
+        from sglang.srt.managers import mm_schedule
+
+        cache = mm_schedule.embedding_cache
+    for item in cached_ref_items(mm_inputs):
+        if _item_end(item) <= covered_len:
+            from_prefix += 1
+        elif cache is not None and item.hash is not None and cache.has(item.hash):
+            from_cache += 1
+        else:
+            missing.append(item)
+    return from_prefix, from_cache, missing
+
+
+def bytes_required_message(missing: List[Any], covered_len: int) -> str:
+    first_end = min(_item_end(item) for item in missing)
+    return (
+        f"{MM_BYTES_REQUIRED}: {len(missing)} omitted image(s) are not in the "
+        f"cached prefix (matched {covered_len} tokens; the first ends at token "
+        f"{first_end}); resend the request with the image bytes"
+    )
+
+
+def is_bytes_required_finish(finish_reason: Any) -> bool:
+    return (
+        isinstance(finish_reason, dict)
+        and finish_reason.get("type") == "abort"
+        and finish_reason.get("err_type") == MM_BYTES_REQUIRED
+    )
+
+
+class SchedulerMetrics:
+    """E6 counters; no-ops unless metrics are on for this scheduler rank."""
+
+    def __init__(self, enabled_: bool):
+        self.enabled = enabled_
+        if not enabled_:
+            return
+        from prometheus_client import Counter
+
+        self.omitted_images = Counter(
+            name="sglang:mm_cached_refs_omitted_images_total",
+            documentation="Images received as pixel-less cached refs.",
+        )
+        self.served = Counter(
+            name="sglang:mm_cached_refs_served_total",
+            documentation="Omitted images admitted, by where the engine had them.",
+            labelnames=["source"],
+        )
+        self.rejected = Counter(
+            name="sglang:mm_cached_refs_rejected_total",
+            documentation="Requests aborted with 409 mm_bytes_required, by stage.",
+            labelnames=["stage"],
+        )
+
+    def on_receive(self, n_omitted: int) -> None:
+        if self.enabled and n_omitted:
+            self.omitted_images.inc(n_omitted)
+
+    def on_served(self, from_prefix: int, from_cache: int) -> None:
+        if not self.enabled:
+            return
+        if from_prefix:
+            self.served.labels(source="prefix").inc(from_prefix)
+        if from_cache:
+            self.served.labels(source="embedding_cache").inc(from_cache)
+
+    def on_rejected(self, stage: str) -> None:
+        if self.enabled:
+            self.rejected.labels(stage=stage).inc()
+
+
+def check_ref_items_hashed(mm_inputs: Any, refs: List[Dict[str, int]]) -> None:
+    """Every pixel-less item must carry its caller hash (it has no feature)."""
+    items = cached_ref_items(mm_inputs)
+    if len(items) != len(refs) or any(item.hash is None for item in items):
+        raise MmCachedRefsError(
+            f"mm_cached_refs: {len(refs)} refs but {len(items)} hashed "
+            "pixel-less items; check mm_hashes"
+        )
+
+
+def needs_prefix(mm_inputs: Any, covered_len: int) -> bool:
+    """True if an omitted image is not covered by ``covered_len`` tokens."""
+    if mm_inputs is None or not enabled():
+        return False
+    return bool(
+        check_coverage(mm_inputs, covered_len, embedding_cache_enabled())[2]
+    )
