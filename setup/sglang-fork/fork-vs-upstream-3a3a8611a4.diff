diff --git a/python/sglang/srt/model_executor/swa_branch_rebuild_replay.py b/python/sglang/srt/model_executor/swa_branch_rebuild_replay.py
new file mode 100644
index 0000000000..ed69261f6a
--- /dev/null
+++ b/python/sglang/srt/model_executor/swa_branch_rebuild_replay.py
@@ -0,0 +1,129 @@
+"""Replay [B - R, B) to fill a rebuilt window (SGLANG_SWA_BRANCH_REBUILD).
+
+The scheduler has given the node ending at ``B`` fresh SWA slots and paired the
+tree's Full slots of ``[B - R, B)`` with fresh SWA slots (see
+``mem_cache/swa_branch_rebuild.py``). Before the batch that serves the request
+from ``B`` runs, this replays ``[B - R, B)`` through the target model:
+
+* the replay batch is the encoder replay's own (``encoder_swa_replay.
+  _build_replay_batch``): one request, prefix ``s``, extend ``[s, e)``, write
+  locations the tree's own Full slots (``req_to_token`` holds them: the prefix
+  was written by ``prepare_for_extend``), so the SWA KV lands in the paired
+  SWA slots;
+* ``encoder_swa_replay`` turns the compressor off, so no Full KV latent and no
+  indexer key is written: the tree's copies stay byte-identical;
+* every window is floored at ``B - R`` (``encoder_swa_row_floor``, one floor
+  per replayed row, which the DSV4 backend applies on the paged SWA pool), so
+  no position reads a slot outside the replay;
+* it runs in pieces of at most one prefill chunk, in order, each attending to
+  the pieces before it through the same floor;
+* it runs eager (the DSV4 backend keeps replay batches off the prefill graph),
+  after the last layer of any HiCache load-back of the Full KV.
+"""
+
+from __future__ import annotations
+
+from typing import List, Optional, Tuple
+
+import torch
+
+from sglang.srt.layers.attention.dsv4.exact_decoder_trim import SKIP_TAIL
+
+
+def pending_rebuilds(batch) -> List[Tuple[int, object]]:
+    """``(index in batch, req)`` of every request whose rebuild is still to replay.
+
+    A request still carrying an unmaterialized plan was admitted without its
+    window: serving it from ``B`` would read stale SWA slots, so that is a hard
+    failure, as a rebuild admitted but not replayed is at result time.
+    """
+    from sglang.srt.mem_cache.swa_branch_rebuild import SwaRebuild, SwaRebuildMatch
+
+    reqs = getattr(batch, "reqs", None) or []
+    pending = []
+    for i, req in enumerate(reqs):
+        plan = getattr(req, "swa_rebuild_match", None)
+        assert not isinstance(plan, SwaRebuildMatch), (
+            f"{req.rid}: branch rebuild planned but not materialized at admission"
+        )
+        rebuild = getattr(req, "swa_rebuild", None)
+        if isinstance(rebuild, SwaRebuild) and not rebuild.replayed:
+            pending.append((i, req))
+    return pending
+
+
+def _set_late_tail(fb, rebuild) -> None:
+    """The exact trim's late tail for one replay piece (ignored without it).
+
+    The piece batch copies the live batch, so drop its per-request floors
+    (row 0's, not the replayed request's) and set the replay's own: an
+    early-only replay runs its late layers on SKIP_TAIL rows (published
+    late-invalid); a full one runs at prompt_len = B and late floor G =
+    rebuild.late_floor_g, so the pieces at or below G are far-skipped and the
+    rest floored at exactly G (swa_branch_rebuild.rebuild_late_floor)."""
+    fb.late_tail_prompt_lens = None
+    fb.late_tail_floor_gs = None
+    fb.late_tail_len_override = None
+    if rebuild.early_only:
+        fb.late_tail_len_override = SKIP_TAIL
+    elif rebuild.late_floor_g is not None:
+        fb.late_tail_prompt_lens = [rebuild.end]
+        fb.late_tail_floor_gs = [rebuild.late_floor_g]
+
+
+def replay_pieces(start: int, end: int, piece_tokens: Optional[int]):
+    """``[s, e)`` pieces of the replay, each at most ``piece_tokens`` long."""
+    if piece_tokens is None or piece_tokens <= 0:
+        piece_tokens = end - start
+    return [(s, min(s + piece_tokens, end)) for s in range(start, end, piece_tokens)]
+
+
+def _piece_tokens() -> Optional[int]:
+    from sglang.srt.runtime_context import get_schedule
+
+    return get_schedule().chunked_prefill_size
+
+
+def run_swa_branch_rebuild(worker, batch, *, piece_tokens: Optional[int] = None):
+    """Replay the pending rebuilds of ``batch``; returns the tokens replayed."""
+    pending = pending_rebuilds(batch)
+    if not pending:
+        return 0
+    from sglang.srt.model_executor.encoder_swa_replay import _build_replay_batch
+    from sglang.srt.model_executor.forward_batch_info import (
+        CaptureHiddenMode,
+        ForwardBatch,
+    )
+
+    assert batch.forward_mode.is_extend_without_speculative(), (
+        f"a branch rebuild rides an extend batch, got {batch.forward_mode}"
+    )
+    if piece_tokens is None:
+        piece_tokens = _piece_tokens()
+    counter = getattr(worker, "hicache_layer_transfer_counter", None)
+    if counter is not None:
+        # The Full KV of [B - R, B) may be arriving from the host tier: order
+        # the whole replay behind the last layer of this batch's load-back.
+        counter.wait_until(counter.num_layers - 1)
+
+    runner = worker.model_runner
+    replayed = 0
+    for i, req in pending:
+        rebuild = req.swa_rebuild
+        for s, e in replay_pieces(rebuild.start, rebuild.end, piece_tokens):
+            replay = _build_replay_batch(batch=batch, runner=runner, rows=[(i, s, e)])
+            fb = ForwardBatch.init_new(
+                replay,
+                runner,
+                capture_hidden_mode=CaptureHiddenMode.NULL,
+                return_hidden_states_before_norm=False,
+            )
+            fb.encoder_swa_replay = True
+            fb.encoder_swa_row_floor = torch.full(
+                (e - s,), rebuild.start, dtype=torch.int64, device=runner.device
+            )
+            _set_late_tail(fb, rebuild)
+            runner.forward(fb)
+            replayed += e - s
+        rebuild.replayed = True
+    return replayed
diff --git a/python/sglang/srt/models/deepseek_common/o_fp8_qdq.py b/python/sglang/srt/models/deepseek_common/o_fp8_qdq.py
new file mode 100644
index 0000000000..2c222023d0
--- /dev/null
+++ b/python/sglang/srt/models/deepseek_common/o_fp8_qdq.py
@@ -0,0 +1,103 @@
+"""In-place FP8 (e4m3) quantize-dequantize of an activation in blocks along its last dim,
+with power-of-two scales: the reference act_quant(x, block, "ue8m0", ..., inplace=True)
+of DeepSeek's inference code. amax is floored at 1e-4, the scale is 2^ceil(log2(amax/448)),
+the value x/scale is clamped to +-448, rounded to e4m3 and multiplied back (bit-exact
+against the reference: the scale is a power of two).
+
+DeepSeek-V4.1-Flash-1017 runs the attention output o through it (block 32) before the
+bf16 wo_a einsum; the earlier V4.1 checkpoint did not.
+
+The e4m3 rounding uses the hardware conversion on sm89 and newer. Older GPUs (Ampere
+and before, where Triton has no e4m3 type) get the same rounding in fp32 arithmetic
+(round half to even onto the e4m3 grid, signed zero kept); SGLANG_DSV4_O_FP8_QDQ_EMULATE=1 forces
+that path anywhere, for testing.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.environ import envs
+
+
+@triton.jit
+def _o_fp8_qdq_kernel(
+    x_ptr, n_blocks, BLOCK: tl.constexpr, ROWS: tl.constexpr, NATIVE: tl.constexpr
+):
+    pid = tl.program_id(0)
+    rows = pid * ROWS + tl.arange(0, ROWS)
+    cols = tl.arange(0, BLOCK)
+    mask = rows[:, None] < n_blocks
+    offs = rows[:, None].to(tl.int64) * BLOCK + cols[None, :]
+    x = tl.load(x_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1e-4)
+    t = amax * (1.0 / 448.0)
+    bits = t.to(tl.int32, bitcast=True)
+    e = ((bits >> 23) & 0xFF) - 127 + tl.where((bits & 0x7FFFFF) != 0, 1, 0)
+    s = ((e + 127) << 23).to(tl.float32, bitcast=True)
+    v = tl.minimum(tl.maximum(x / s[:, None], -448.0), 448.0)
+    if NATIVE:
+        q = v.to(tl.float8e4nv).to(tl.float32)
+    else:
+        # the e4m3 grid: 3 mantissa bits, exponents down to -6, subnormal step 2^-9
+        a = tl.abs(v)
+        ea = tl.maximum(((a.to(tl.int32, bitcast=True) >> 23) & 0xFF) - 127, -6)
+        ulp = ((ea - 3 + 127) << 23).to(tl.float32, bitcast=True)
+        r = a / ulp  # exact: ulp is a power of two; r < 16
+        r = (r + 12582912.0) - 12582912.0  # round half to even (1.5 * 2^23)
+        q = r * ulp
+        # the sign by its bit: Triton's -q is 0 - q, which turns -0 into +0
+        sign = v.to(tl.int32, bitcast=True) & -2147483648
+        q = (q.to(tl.int32, bitcast=True) | sign).to(tl.float32, bitcast=True)
+    y = q * s[:, None]
+    tl.store(x_ptr + offs, y.to(x_ptr.dtype.element_ty), mask=mask)
+
+
+_NATIVE = {}
+
+
+def _native_fp8(device) -> bool:
+    if envs.SGLANG_DSV4_O_FP8_QDQ_EMULATE.get():
+        return False
+    idx = device.index if device.index is not None else torch.cuda.current_device()
+    if idx not in _NATIVE:
+        _NATIVE[idx] = torch.cuda.get_device_capability(idx) >= (8, 9)
+    return _NATIVE[idx]
+
+
+def o_fp8_qdq_(x: torch.Tensor, block: int) -> torch.Tensor:
+    """x in place (made contiguous first if it is not); returns the tensor holding the result."""
+    if x.shape[-1] % block:
+        raise ValueError(f"last dim {x.shape[-1]} is not a multiple of block {block}")
+    if not x.is_contiguous():
+        x = x.contiguous()
+    n_blocks = x.numel() // block
+    if n_blocks:
+        rows = 64
+        _o_fp8_qdq_kernel[(triton.cdiv(n_blocks, rows),)](
+            x, n_blocks, BLOCK=block, ROWS=rows, NATIVE=_native_fp8(x.device)
+        )
+    return x
+
+
+def e4m3_round_emulated(v: torch.Tensor) -> torch.Tensor:
+    """The non-native kernel path's rounding in torch (fp32 in, fp32 out, |v| <= 448)."""
+    a = v.abs()
+    ea = (((a.view(torch.int32) >> 23) & 0xFF) - 127).clamp_min(-6)
+    ulp = ((ea - 3 + 127) << 23).view(torch.float32)
+    r = a / ulp
+    r = (r + 12582912.0) - 12582912.0
+    q = r * ulp
+    return torch.where(v.view(torch.int32) < 0, -q, q)
+
+
+def o_fp8_qdq_reference(x: torch.Tensor, block: int) -> torch.Tensor:
+    """The same in plain torch, out of place (for the self-test)."""
+    shape = x.shape
+    f = x.float().reshape(-1, block)
+    amax = f.abs().amax(dim=1).clamp_min(1e-4)
+    bits = (amax * (1.0 / 448.0)).view(torch.int32)
+    e = ((bits >> 23) & 0xFF) - 127 + ((bits & 0x7FFFFF) != 0).to(torch.int32)
+    s = ((e + 127) << 23).view(torch.float32)[:, None]
+    v = (f / s).clamp(-448.0, 448.0)
+    return (v.to(torch.float8_e4m3fn).float() * s).to(x.dtype).reshape(shape)
