+def test_a_messages_array_reduced_to_its_images_gives_the_same_request(
+    tokenizer, box_c_env
+):
+    """The contract the router builds against: on the ``input_ids`` branch the engine takes
+    the images from ``messages`` in message order and part order, and reads no text there.
+    Dropping every text part and every message without an image, changing the roles, or
+    merging the images into one message gives the same request; reordering the images does
+    not."""
+    chat = _mm_chat(tokenizer)
+    reordered = 0
+    for record in _image_records():
+        ids = _ids_of(record, "ids")
+        messages = record["egress"]["messages"]
+        urls = _urls_in_message_order(messages)
+        moved = _render_order_of(messages) != list(range(len(urls)))
+        by_ids, request, _ = _convert(chat, record["egress"], ids)
+        bodies = {"image_only": record["image_only_messages"]}
+        bodies.update(_contract_variants(messages))
+        for name, reduced in bodies.items():
+            by_variant, variant, encoded = _convert(
+                chat, _ids_image_body(record, reduced), ids
+            )
+            assert encoded == [], (record["id"], name)
+            # a reduced array has no assistant message, so its images keep message order: the
+            # same request as the conversation's, unless the conversation's render moves them
+            differs = set(_field_differences(by_ids, by_variant))
+            assert differs == ({"image_data"} if moved else set()), (record["id"], name)
+            assert _urls(by_variant.image_data) == urls, (record["id"], name)
+            # the request the output parsers read differs in its messages alone
+            a, b = request.model_dump(), variant.model_dump()
+            a.pop("messages"), b.pop("messages")
+            assert a == b, (record["id"], name)
+        # Control: the same images in another order are another request.
+        if len(urls) > 1:
+            parts = [p for m in record["image_only_messages"] for p in m["content"]]
+            flipped = [{"role": "user", "content": parts[::-1]}]
+            by_flipped, _, _ = _convert(chat, _ids_image_body(record, flipped), ids)
+            assert _urls(by_flipped.image_data) == urls[::-1] != urls
+            reordered += 1
+    assert reordered >= 6
+
