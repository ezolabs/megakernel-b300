diff --git a/test/registered/unit/function_call/test_deepseek_dsml_long_streaming.py b/test/registered/unit/function_call/test_deepseek_dsml_long_streaming.py
new file mode 100644
index 0000000000..fb54a331a4
--- /dev/null
+++ b/test/registered/unit/function_call/test_deepseek_dsml_long_streaming.py
@@ -0,0 +1,788 @@
+"""Long DSML tool calls streamed in small deltas (DeepSeek V3.2 / V4 / V4.1).
+
+An open long-form invoke for an offered tool streams while it is still open:
+one item with the call's index and name (empty arguments) as soon as the
+invoke header is complete and its body has opened, then the arguments as JSON
+text fragments. A long call therefore sends its first byte within a few tokens
+instead of after its closer. These tests pin that:
+
+- the header goes out before the closer, and before the whole body;
+- the fragments concatenate to exactly the arguments the one-shot parser
+  (detect_and_parse) returns, for long string, JSON, number and bool values,
+  JSON-body invokes and several invokes, at every chunk size, and over 2,500
+  random answers;
+- no fragment starts with all the argument text sent before it, so
+  the serving router, which reads such a fragment as a cumulative restatement,
+  hands its client the same text (every _assemble checks this);
+- an invoke naming a tool the request did not offer sends nothing;
+- a body that breaks after the header went out ends the call with the
+  fragments already sent (never a JSON object), counted and logged;
+- the work per delta does not grow with the length of the call.
+"""
+
+import json
+import random
+import unittest
+from unittest.mock import patch
+
+from sglang.srt.entrypoints.openai import sbr_dsml_audit
+from sglang.srt.entrypoints.openai.protocol import Function, Tool
+from sglang.srt.function_call import deepseekv32_detector
+from sglang.srt.function_call.deepseekv4_detector import DeepSeekV4Detector
+from sglang.srt.function_call.deepseekv32_detector import DeepSeekV32Detector
+from sglang.srt.function_call.deepseekv41_detector import DeepSeekV41Detector
+from sglang.srt.function_call.function_call_parser import FunctionCallParser
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+DETECTORS = [DeepSeekV32Detector, DeepSeekV4Detector, DeepSeekV41Detector]
+CHUNK_SIZES = [1, 3, 7, 18, 100_000]
+
+
+def _tools():
+    return [
+        Tool(
+            type="function",
+            function=Function(
+                name=name,
+                parameters={"type": "object", "properties": {}},
+            ),
+        )
+        for name in ("write_file", "lookup", "list_files")
+    ]
+
+
+def _parameter(detector_cls, name, flag, value):
+    tag = f"{detector_cls.dsml_token}{detector_cls.parameter_tag_name}"
+    return f'<{tag} name="{name}" string="{flag}">{value}</{tag}>'
+
+
+def _open_parameter(detector_cls, name, value):
+    """A string parameter whose closer never comes."""
+    tag = f"{detector_cls.dsml_token}{detector_cls.parameter_tag_name}"
+    return f'<{tag} name="{name}" string="true">{value}'
+
+
+def _code(detector, n_chars):
+    """Code-like text with `<`, `</`, quotes, backslashes, tabs and partial
+    DSML closers, none complete."""
+    parameter = f"{detector.dsml_token}{type(detector).parameter_tag_name}"
+    pieces = [
+        "def f(x):\n",
+        "    return x < 3 and y </ 2\n",
+        '    s = "<div>\\n"\t# \\" quoted\n',
+        f"    # {detector.invoke_end_token[:-1]} is not a closer\n",
+        f"    # </{parameter} nor is this\n",
+        f"    # nor is <{detector.dsml_token}\n",
+        "    # 中文 é 😀  \n",
+    ]
+    out = []
+    while sum(map(len, out)) < n_chars:
+        out.extend(pieces)
+    return "".join(out)
+
+
+def _transcript(detector_cls, n_chars):
+    """Prose, a long write_file call (string, number, bool, null and JSON
+    parameters), a JSON-body lookup call and a zero-argument call."""
+    d = detector_cls()
+    code = _code(d, n_chars)
+    payload = {"query": code, "limit": 25, "exact": False, "tags": ["a", 1.5, None]}
+    text = (
+        "Let me write the file.\n\n"
+        f"{d.bot_token}\n"
+        f'{d.invoke_start_token} name="write_file">\n'
+        + _parameter(detector_cls, "path", "true", "src/app.py")
+        + "\n"
+        + _parameter(detector_cls, "content", "true", code)
+        + "\n"
+        + _parameter(detector_cls, "mode", "false", "420")
+        + "\n"
+        + _parameter(detector_cls, "overwrite", "false", "true")
+        + "\n"
+        + _parameter(detector_cls, "backup", "false", "null")
+        + "\n"
+        + _parameter(detector_cls, "meta", "false", '{"lines": [1, 2], "x": "y"}')
+        + "\n"
+        f"{d.invoke_end_token}\n"
+        f'{d.invoke_start_token} name="lookup">\n'
+        + json.dumps(payload, ensure_ascii=False, indent=2)
+        + f"\n{d.invoke_end_token}\n"
+        f'{d.invoke_start_token} name="list_files"/>\n'
+        f"{d.eot_token}"
+    )
+    content = code.strip() if d.strip_string_param_value else code
+    expected = [
+        (
+            "write_file",
+            {
+                "path": "src/app.py",
+                "content": content,
+                "mode": 420,
+                "overwrite": True,
+                "backup": None,
+                "meta": {"lines": [1, 2], "x": "y"},
+            },
+        ),
+        ("lookup", payload),
+        ("list_files", {}),
+    ]
+    return text, expected
+
+
+RANDOM_CASES = 2_500
+
+
+def _random_transcript(rng, detector_cls):
+    """A random DSML answer: prose, then 1-3 invokes (offered or not; JSON or
+    parameter bodies, some malformed or self-closing) holding every value
+    type, awkward text, and values that restate the arguments before them (a
+    parameter or key whose object value opens with that same name)."""
+    d = detector_cls()
+    tag = f"{d.dsml_token}{detector_cls.parameter_tag_name}"
+    pieces = [
+        "a", " ", "\n", "  x ", '"', "\\", "<", "</", "é", "中", "\t", "{",
+        "}", "😀", "\x01", ", ", ": ", "　", f"<{d.dsml_token}",
+        f"</{tag}"[:-2], d.invoke_end_token[:-1],
+    ]  # fmt: skip
+
+    def text(k):
+        return "".join(rng.choice(pieces) for _ in range(rng.randint(0, k)))
+
+    def value(depth=0):
+        r = rng.random()
+        if depth > 2 or r < 0.3:
+            return rng.choice(
+                [1, -0.0, 1.5e300, 12345678901234567890, True, False, None,
+                 's"\\/\n', text(5), 0, -3.25]
+            )  # fmt: skip
+        if r < 0.6:
+            return [value(depth + 1) for _ in range(rng.randint(0, 3))]
+        return {text(4) + str(i): value(depth + 1) for i in range(rng.randint(0, 3))}
+
+    def restating(name):
+        """An object whose first key is `name`: sent after `{"name": `, it
+        would start with it."""
+        rest = {text(3) + str(i): value(1) for i in range(rng.randint(0, 2))}
+        return {name: value(1), **{k: v for k, v in rest.items() if k != name}}
+
+    def dumps(obj):
+        return json.dumps(
+            obj,
+            ensure_ascii=rng.random() < 0.3,
+            indent=rng.choice([None, 1, 3]),
+            separators=rng.choice([None, (",", ":"), (" ,", " : ")]),
+        )
+
+    def invoke(name):
+        if rng.random() < 0.08:
+            return f'{d.invoke_start_token} name="{name}"/>'
+        if rng.random() < 0.4:
+            keys = [text(3) + "k" + str(i) for i in range(rng.randint(0, 4))]
+            obj = {k: restating(k) if rng.random() < 0.25 else value() for k in keys}
+            body = "\n" + dumps(obj) + rng.choice(["\n", " ", ""])
+            if rng.random() < 0.15:
+                body = body.replace(",", ",,", 1)  # malformed
+        else:
+            parts = []
+            for i in range(rng.randint(0, 4)):
+                name_i = f"p{i}"
+                if rng.random() < 0.5:
+                    parts.append(_parameter(detector_cls, name_i, "true", text(40)))
+                else:
+                    r = rng.random()
+                    if r < 0.25:
+                        raw = dumps(restating(name_i))
+                    elif r < 0.8:
+                        raw = dumps(value())
+                    else:
+                        raw = text(10)  # not JSON: kept as stripped text
+                    parts.append(_parameter(detector_cls, name_i, "false", raw))
+                parts.append(rng.choice(["\n", "", " stray ", "\n\n"]))
+            if rng.random() < 0.1 and parts:
+                # A tag without string=: the one-shot parse drops the invoke.
+                parts.insert(0, f'<{tag} name="bad">x</{tag}>')
+            if rng.random() < 0.1:
+                parts.append(f'<{tag} name="open" string="true">never closed')
+            body = "\n" + "".join(parts)
+        return f'{d.invoke_start_token} name="{name}">{body}{d.invoke_end_token}'
+
+    invokes = "\n".join(
+        invoke(rng.choice(["write_file", "lookup", "list_files", "nope"]))
+        for _ in range(rng.randint(1, 3))
+    )
+    prose = rng.choice(["", "Sure.\n\n", "x "])
+    return f"{prose}{d.bot_token}\n{invokes}\n{d.eot_token}"
+
+
+def _is_object(arguments):
+    try:
+        return isinstance(json.loads(arguments), dict)
+    except ValueError:
+        return False
+
+
+def _split(text, size):
+    return [text[i : i + size] for i in range(0, len(text), size)]
+
+
+def _stream(detector, text, size, tools):
+    """Feeds `text` in `size`-char deltas, then finish(). Returns the prose,
+    every item with the offset of the text fed when it was returned, and the
+    detector."""
+    normal, items, fed = "", [], 0
+    for chunk in _split(text, size):
+        fed += len(chunk)
+        result = detector.parse_streaming_increment(chunk, tools)
+        normal += result.normal_text
+        items.extend((fed, call) for call in result.calls)
+        # What the serving layer re-sends at the end is prev - streamed: never
+        # anything while a call streams.
+        for prev, sent in zip(
+            detector.prev_tool_call_arr, detector.streamed_args_for_tool
+        ):
+            assert prev.get("arguments", "") == sent, (prev, sent)
+    result = detector.finish(tools)
+    normal += result.normal_text
+    items.extend((fed, call) for call in result.calls)
+    return normal, items
+
+
+class _RouterArguments:
+    """the serving router's reading of one call's argument fragments, ported from
+    `ClientArguments::delta` (the serving router
+    crates/sbr-wire/src/sglang/stream.rs:480-501 at bdf5d0607, :473-494 at
+    59a5cc950; docs/design/wire.md §4.1, "The one restatement that cannot be
+    told apart from new text"). The router also accepts the cumulative
+    dialect: a fragment that starts with ALL the text already sent for its
+    index and adds to it is read as a restatement, and only its new suffix
+    reaches the client; a fragment equal to the sent text is dropped once the
+    index has restated itself. Anything else is passed on whole."""
+
+    def __init__(self):
+        self.sent = ""
+        self.restated = False
+
+    def delta(self, arguments):
+        if (
+            self.sent
+            and arguments.startswith(self.sent)
+            and len(arguments) > len(self.sent)
+        ):
+            suffix = arguments[len(self.sent) :]
+            self.sent = arguments
+            self.restated = True
+            return suffix
+        if self.restated and arguments == self.sent:
+            return ""
+        self.sent += arguments
+        return arguments
+
+
+def _assemble(items):
+    """Items -> [(name, arguments text)] by tool_index, checking that each call
+    opens with exactly one named item and that items arrive in index order.
+
+    It also feeds each call's fragments through the serving router's reading
+    (_RouterArguments) and checks that no fragment restates the text sent
+    before it, so the router's client gets exactly the concatenation."""
+    calls, routers = {}, {}
+    for _, call in items:
+        if call.tool_index not in calls:
+            assert call.name, f"call {call.tool_index} did not open with its name"
+            assert call.tool_index == len(calls), "calls out of order"
+            calls[call.tool_index] = [call.name, ""]
+            routers[call.tool_index] = [_RouterArguments(), ""]
+        else:
+            assert call.name is None, "a second header for one call"
+        calls[call.tool_index][1] += call.parameters
+        router = routers[call.tool_index]
+        if call.parameters:  # the router skips empty `arguments`
+            router[1] += router[0].delta(call.parameters)
+    for index, (name, arguments) in calls.items():
+        reader, client = routers[index]
+        assert not reader.restated and client == arguments, (
+            f"call {index} ({name}): a fragment restates the arguments sent "
+            f"before it; the router's client holds {client!r}, not {arguments!r}"
+        )
+    return [tuple(calls[index]) for index in sorted(calls)]
+
+
+def _fragments(items, index=0):
+    """The argument fragments of call `index`, header first."""
+    return [call.parameters for _, call in items if call.tool_index == index]
+
+
+class TestDeepSeekDsmlLongStreaming(CustomTestCase):
