+def random_batch(rng, bs, whole):
+    extend = [rng.randint(1, 6000) for _ in range(bs)]
+    seq = [n + rng.choice([0, rng.randint(1, 20000)]) for n in extend]
+    flags = [rng.random() < 0.3 for _ in range(bs)] if whole else None
+    return extend, seq, flags
