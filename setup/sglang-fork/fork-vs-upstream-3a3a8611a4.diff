index 0000000000..b41ebdb4d6
--- /dev/null
+++ b/test/srt/sbr/test_h_kv_events_tagged_maps.py
@@ -0,0 +1,215 @@
+"""h - KV events go out as tagged maps with ``cache_salt`` as a named field.
+
+This tree (``b4da0c4b``) predates upstream #37482, so its ``KVCacheEvent`` was
+``array_like``: every event a tagged positional array, and a salted page a
+``BlockStoredWithMetadata`` with a trailing ``{"cache_salt": ...}`` map. A
+consumer written against the current upstream wire (tagged ``omit_defaults``
+maps, ``cache_salt``/``session_id`` flat on ``BlockStored``) refuses every such
+batch. Patch 0017 carries the Python half of #37482: the event encoding and
+the recorder, nothing in the Rust radix tree.
+
+The golden digest below is the sha256 of the exact payload frame this tree
+encodes for a fixed batch. It is the same payload recorded as
+``crates/sbr-index/tests/fixtures/b4da0c4b_sbr/kv_batch.msgpack`` in
+the serving router (decoded there by the router's own decoder) and the same bytes
+the fork tip's ``box-f-sbr`` branch encodes for these events.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import struct
+from array import array
+
+import msgspec
+
+from sglang.srt.disaggregation.kv_events import (
+    AllBlocksCleared,
+    BlockRemoved,
+    BlockStored,
+    KVEventBatch,
+    SnapshotBegin,
+    SnapshotEnd,
+    StorageMedium,
+)
+from sglang.srt.managers.scheduler_components.load_publisher import LoadStat
+from sglang.srt.mem_cache.events import KVCacheEventRecorder
+from sglang.srt.mem_cache.radix_cache import RadixKey, TreeNode
+
+GOLDEN_KV_BATCH_SHA256 = (
+    "3866b2d9afb8e27a1fd9663a02c06af07912f8921e2ab9ccab5c835a614a730e"
+)
+GOLDEN_LOAD_STAT_SHA256 = (
+    "6425c786293769e41ac6dc905f91146355d1a683c141d7835ac281970b2ac86a"
+)
+
+
+def _golden_batch() -> KVEventBatch:
+    gpu, cpu = StorageMedium.GPU, StorageMedium.CPU
+    return KVEventBatch(
+        ts=1727280000.5,
+        events=[
+            SnapshotBegin(num_blocks=4),
+            BlockStored(
+                block_hashes=[-6917529027641081856, 1234567890123],
+                parent_block_hash=None,
+                token_ids=[1, 2, 3, 4],
+                block_size=2,
+                lora_id=None,
+                medium=gpu,
+            ),
+            BlockStored(
+                block_hashes=[42],
+                parent_block_hash=1234567890123,
+                token_ids=[5, 6],
+                block_size=2,
+                lora_id=None,
+                medium=gpu,
+                cache_salt="tenant-a",
+            ),
+            BlockStored(
+                block_hashes=[-1],
+                parent_block_hash=42,
+                token_ids=[(7, 8), (8, 9)],
+                block_size=2,
+                lora_id=None,
+                medium=cpu,
+                session_id="session-a",
+            ),
+            SnapshotEnd(num_blocks=4),
+            BlockRemoved(block_hashes=[42], medium=gpu),
+            AllBlocksCleared(),
+        ],
+        attn_dp_rank=3,
+    )
+
+
+def test_every_event_is_a_tagged_map_inside_a_positional_batch():
+    decoded = msgspec.msgpack.decode(msgspec.msgpack.encode(_golden_batch()))
+    ts, events, rank = decoded
+    assert (ts, rank) == (1727280000.5, 3)
+    assert all(isinstance(event, dict) for event in events)
+    assert [event["type"] for event in events] == [
+        "SnapshotBegin",
+        "BlockStored",
+        "BlockStored",
+        "BlockStored",
+        "SnapshotEnd",
+        "BlockRemoved",
+        "AllBlocksCleared",
+    ]
+    assert events[0] == {"type": "SnapshotBegin", "num_blocks": 4}
+    assert events[5] == {"type": "BlockRemoved", "block_hashes": [42], "medium": "GPU"}
+    assert events[6] == {"type": "AllBlocksCleared"}
+
+
+def test_salt_and_session_are_flat_named_fields_omitted_when_unset():
+    events = msgspec.msgpack.decode(msgspec.msgpack.encode(_golden_batch()))[1]
+    unsalted, salted, session = events[1], events[2], events[3]
+    assert "cache_salt" not in unsalted and "session_id" not in unsalted
+    assert salted["cache_salt"] == "tenant-a" and "session_id" not in salted
+    assert session["session_id"] == "session-a" and "cache_salt" not in session
+    assert all("metadata" not in event for event in events)
+    # Required optionals stay present as nil: the consumer reads them as None.
+    assert unsalted["parent_block_hash"] is None and unsalted["lora_id"] is None
+    assert session["token_ids"] == [[7, 8], [8, 9]]
+
+
+def test_the_payload_frame_is_byte_for_byte_the_recorded_fixture():
+    encoder = msgspec.msgpack.Encoder()  # what ZmqEventPublisher._pack is
+    payload = encoder.encode(_golden_batch())
+    assert hashlib.sha256(payload).hexdigest() == GOLDEN_KV_BATCH_SHA256
+    assert len(payload) == 512
+
+
+def test_load_stat_stays_the_positional_eleven():
+    stat = LoadStat(
+        num_running_reqs=5,
+        num_waiting_reqs=2,
+        num_tokens=1024,
+        max_total_num_tokens=65536,
+        attn_dp_rank=3,
+        num_waiting_uncached_tokens=300,
+        num_total_tokens=1324,
+        max_running_requests=64,
+        total_prefill_uncached_tokens=99999,
+        total_prefill_busy_us=123456,
+    )
+    payload = msgspec.msgpack.Encoder().encode(stat)
+    assert msgspec.msgpack.decode(payload) == [
+        "LoadStat", 5, 2, 1024, 65536, 3, 300, 1324, 64, 99999, 123456
+    ]
+    assert hashlib.sha256(payload).hexdigest() == GOLDEN_LOAD_STAT_SHA256
+
+
+class _PurePythonNativeHash:
+    """Stand-in for the Linux-only compiled hasher (same contract and chaining
+    as the double in ``test_d2_radix_snapshot.py``)."""
+
+    @staticmethod
+    def get_hash(raw, logical_len, unit_width, is_bigram, prior_digest, page_size):
+        page_size = page_size or 1
+        digest = prior_digest
+        digests = []
+        for start in range(0, logical_len, page_size):
+            end = min(start + page_size, logical_len)
+            payload = bytearray()
+            for index in range(start, end):
+                for lane in range(unit_width):
+                    payload += struct.pack("<q", raw[index * unit_width + lane])
+            digest = hashlib.sha256((digest or b"") + bytes(payload)).digest()
+            digests.append(digest.hex())
+        return digests
+
+
+def _node(parent, tokens, *, cache_salt=None):
+    node = TreeNode()
+    node.parent = parent
+    node.key = RadixKey(array("q", tokens), cache_salt=cache_salt)
+    node.value = list(range(len(tokens)))
+    parent.children[tokens[0]] = node
+    return node
+
+
+def _root():
+    root = TreeNode()
+    root.key = RadixKey(array("q", []))
+    root.value = []
+    root.hash_value = []
+    return root
+
+
+def test_the_recorder_stamps_salt_and_session_without_changing_the_hash(
+    monkeypatch,
+):
+    from sglang.srt.mem_cache.cpp_utils import native_hash
+
+    try:
+        native_hash._load_native_hash_module()
+    except RuntimeError:
+        monkeypatch.setattr(
+            native_hash, "_load_native_hash_module", lambda: _PurePythonNativeHash()
+        )
+
+    salted = _node(_root(), [1, 2, 3, 4], cache_salt="tenant-a")
+    plain = _node(_root(), [1, 2, 3, 4])
+
+    rec = KVCacheEventRecorder(enabled=True, page_size=2)
+    rec.record_store(salted)
+    (salted_event,) = rec.take()
+    assert salted_event.cache_salt == "tenant-a" and salted_event.session_id is None
+
+    rec.record_store(plain, session_id="session-a")
+    (with_session,) = rec.take()
+    rec.record_store(plain)
+    (without_session,) = rec.take()
+    assert with_session.session_id == "session-a" and with_session.cache_salt is None
+    # Attribution only: the session never enters the hash or the parent link.
+    assert with_session.block_hashes == without_session.block_hashes
+    assert with_session.parent_block_hash == without_session.parent_block_hash
+    # The salt does namespace the hash.
+    assert salted_event.block_hashes != without_session.block_hashes
+    # Different sessions never coalesce into one event.
+    rec.record_store(plain, session_id="session-a")
+    rec.record_store(plain, session_id="session-b")
+    assert len(rec.take()) == 2
diff --git a/test/srt/sbr/test_i_unified_radix_snapshot.py b/test/srt/sbr/test_i_unified_radix_snapshot.py
