+                )
+
+    def test_protocol_keeps_effort_words_as_sent(self):
+        """The model-agnostic validator never rewrites an effort word: DeepSeek's
+        ladder (minimal->low, medium->high, ultra->max) is applied by the
+        DeepSeek-V4.1 serving path only, so other models see what was sent."""
+        messages = [{"role": "user", "content": "Hello"}]
+        for word in ("minimal", "low", "medium", "high", "xhigh", "max", "ultra"):
+            for request_form, kwargs in (
+                ("top-level", {"reasoning_effort": word}),
+                ("nested", {"reasoning": {"effort": word}}),
+                ("nested-legacy", {"reasoning": {"reasoning_effort": word}}),
+            ):
+                with self.subTest(word=word, request_form=request_form):
+                    request = ChatCompletionRequest(
+                        model="test-model", messages=messages, **kwargs
+                    )
+                    self.assertEqual(request.reasoning_effort, word)
+                    self.assertEqual(
+                        request.chat_template_kwargs,
+                        {"thinking": True, "enable_thinking": True},
+                    )
+
+    def test_tokenize_request_accepts_ultra_and_forwards_the_toggle(self):
+        from sglang.srt.entrypoints.openai.protocol import TokenizeRequest
+
+        request = TokenizeRequest(
+            messages=[{"role": "user", "content": "Hello"}],
+            reasoning_effort="ultra",
+        )
+        self.assertEqual(request.reasoning_effort, "ultra")
+        self.assertEqual(request.to_chat_completion_request().reasoning_effort, "ultra")
+
+        request = TokenizeRequest(
+            messages=[{"role": "user", "content": "Hello"}],
+            reasoning_effort="ultra",
+            thinking={"type": "disabled"},
+        )
+        chat = request.to_chat_completion_request()
+        # The DeepSeek toggle is forwarded as sent; the DeepSeek-V4.1 serving
+        # path applies it (the tokenize path renders through it too).
+        self.assertEqual(chat.thinking, {"type": "disabled"})
+        self.assertEqual(chat.reasoning_effort, "ultra")
+
+    def test_deepseek_thinking_toggle_is_kept_but_not_applied(self):
+        """Top-level thinking:{type} is DeepSeek's API: the model-agnostic
+        validator keeps it as sent and changes nothing else, so a model other
+        than DeepSeek-V4.1 sees the request as if it were absent."""
+        messages = [{"role": "user", "content": "Hello"}]
+        for thinking in ({"type": "enabled"}, {"type": "disabled"}):
+            for other_kwargs in (
+                {},
+                {"reasoning_effort": "max"},
+                {"reasoning_effort": "ultra"},
+                {"reasoning_effort": 0.9},
+                {"reasoning_effort": "none"},
+                {"reasoning": {"enabled": True, "effort": "high"}},
+                {"chat_template_kwargs": {"thinking": True}},
+                {"chat_template_kwargs": {"thinking": False}},
+                {"chat_template_kwargs": {"enable_thinking": True}},
+            ):
+                with self.subTest(thinking=thinking, other_kwargs=other_kwargs):
+                    without = ChatCompletionRequest(
+                        model="test-model", messages=messages, **other_kwargs
+                    )
+                    request = ChatCompletionRequest(
+                        model="test-model",
+                        messages=messages,
+                        thinking=thinking,
+                        **other_kwargs,
+                    )
+                    self.assertEqual(request.thinking, thinking)
+                    self.assertEqual(
+                        request.reasoning_effort, without.reasoning_effort
+                    )
+                    self.assertEqual(
+                        request.chat_template_kwargs, without.chat_template_kwargs
+                    )
+        for request_kwargs in ({"thinking": None}, {}):
+            with self.subTest(request_kwargs=request_kwargs):
+                request = ChatCompletionRequest(
+                    model="test-model", messages=messages, **request_kwargs
+                )
+                self.assertIsNone(request.thinking)
+                self.assertIsNone(request.reasoning_effort)
+                self.assertIsNone(request.chat_template_kwargs)
+
+    def test_deepseek_thinking_toggle_is_validated(self):
+        messages = [{"role": "user", "content": "Hello"}]
+        for thinking in (
+            {"type": "auto"},
+            {"type": None},
+            {},
+            True,
+            "disabled",
+        ):
+            with (
+                self.subTest(thinking=thinking),
+                self.assertRaises(ValidationError),
+            ):
+                ChatCompletionRequest(
+                    model="test-model", messages=messages, thinking=thinking
+                )
 
