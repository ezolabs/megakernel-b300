+    """Controls for the comparison above: for each body the router's rule keeps the real
+    messages for, the engine's answer is not the placeholder's, so the tests above would
+    see a read of ``messages`` if the fixture's bodies made one."""
+    chat = _handler(tokenizer)
+    assert not chat.template_manager.force_reasoning
+    # continue_final_message: the prompt closed the reasoning before the last message's
+    # text, so the continuation is content (recipe's ``prefix: true``, the router's #149);
+    # the placeholder's parser answers by the thinking switch alone.
+    real = _probe_request(chat, _continue_body(), placeholder=False)
+    placeholder = _probe_request(chat, _continue_body(), placeholder=True)
+    text = "more</think>done"
