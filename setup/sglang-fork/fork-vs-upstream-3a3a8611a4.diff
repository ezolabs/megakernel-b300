+    def test_header_goes_out_before_the_invoke_closes(self):
+        """The first item of a long call carries its name and empty arguments
+        and arrives within a few tokens of the invoke header; argument text
+        follows while the content is still streaming."""
+        for detector_cls in DETECTORS:
+            text, _ = _transcript(detector_cls, 20_000)
+            d = detector_cls()
+            header_end = text.index(f'{d.invoke_start_token} name="write_file">')
+            closer = text.index(d.invoke_end_token)
+            content_start = text.index('name="content"')
+            for size in (1, 7, 18):
+                with self.subTest(detector=detector_cls.__name__, chunk_size=size):
+                    _, items = _stream(detector_cls(), text, size, self.tools)
+                    write = [(fed, c) for fed, c in items if c.tool_index == 0]
+                    fed, first = write[0]
+                    self.assertEqual((first.name, first.parameters), ("write_file", ""))
+                    # Out once the first parameter tag is complete: long before
+                    # the content parameter, let alone the closer.
+                    self.assertLess(fed, content_start + size)
+                    self.assertLess(fed - header_end, 200)
+                    mid_content = [
+                        c.parameters for fed, c in write if fed < closer - 1000
+                    ]
+                    self.assertGreater(len("".join(mid_content)), 15_000)
