+"""Exact decoder trim: ``UnifiedTreeNode.late_exact_from`` in the Python TreeCore.
+
+A node records the absolute position from which the late layers' SWA rows on
+its root path are exact; a page boundary b ending at the node is late-exact iff
+b - W >= late_exact_from. The value rides the insert (``InsertParams``) the way
+``rotation_base`` does: stamped on new nodes, copied on split (an absolute
+position is split-invariant), kept by an overlapping insert, and adopted from the
+incoming request only where a recovery hands the node the incoming SWA rows.
+None means unknown, which counts as late-invalid under trim. With trim off, the
+cache reports every node as valid (0).
+"""
+
+from __future__ import annotations
+
+import unittest
+from array import array
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import (
+    EvictParams,
+    InsertParams,
+    InsertResult,
+)
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import UnifiedTreeCore
+from sglang.srt.mem_cache.unified_cache.unified_tree_core_interface import (
+    UnifiedTreeCoreInterface,
+)
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+KV_SIZE = 4096
+WINDOW = 8
+_FULL = ComponentType.FULL
+_SWA = ComponentType.SWA
+
+
+def _cache(*, trim: bool = True, bounded_replay: bool = True) -> UnifiedRadixCache:
+    set_global_server_args_for_scheduler(ServerArgs(model_path="dummy", page_size=1))
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=1,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=[0, 2],
+        full_attention_layer_ids=[1, 3],
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=1,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=1,
+        disable=False,
+        sliding_window_size=WINDOW,
+        tree_components=(_FULL, _SWA),
+        tree_core_backend="python",
+        decoder_swa_bounded_replay=bounded_replay,
+    )
+    with envs.SGLANG_DSV4_EXACT_DECODER_TRIM.override(trim):
+        return UnifiedRadixCache(params=params)
+
+
+def _insert(cache, tokens, late_exact_from, *, prev_prefix_len=0, offset_walk=False):
+    value = cache.token_to_kv_pool_allocator.alloc(len(tokens))
+    assert value is not None
+    params = InsertParams(
+        key=RadixKey(array("q", tokens)),
+        value=value,
+        prev_prefix_len=prev_prefix_len,
+        late_exact_from=late_exact_from,
+    )
+    if offset_walk:
+        return cache._sbr_insert_by_offset(params)
+    return cache.insert(params)
+
+
+def _path(cache, tokens):
+    """The nodes on ``tokens``' root path, as (start, end, node)."""
+    core = cache.tree_core
+    node, pos, out = core.root_node, 0, []
+    key = RadixKey(array("q", tokens))
+    while pos < len(tokens):
+        child = node.children.get(key[pos:].child_key(core.page_size))
+        if child is None:
+            break
+        out.append((pos, pos + len(child.key), child))
+        pos += len(child.key)
+        node = child
+    return out
+
+
+def _nodes(cache):
+    stack, out = list(cache.tree_core.root_node.children.values()), []
+    while stack:
+        node = stack.pop()
+        out.append(node)
+        stack.extend(node.children.values())
+    return out
+
+
+P = list(range(1, 33))
+Q = P[:16] + list(range(100, 116))
+
+
+class TestStampAndSplit(unittest.TestCase):
+    def test_insert_stamps_every_new_node(self):
+        cache = _cache()
+        _insert(cache, P, 3)
+        path = _path(cache, P)
+        self.assertEqual(path[-1][1], len(P))
+        # The SWA commit hook may cap the leaf at a window; every piece is new.
+        self.assertTrue(all(node.late_exact_from == 3 for _, _, node in path))
+
+    def test_split_keeps_the_value_on_both_halves(self):
+        cache = _cache()
+        _insert(cache, P, 3)
+        _insert(cache, Q, 5)
+        (start, end, shared), *p_tail = _path(cache, P)
+        self.assertEqual((start, end), (0, 16), "Q must split P's chain at 16")
+        self.assertEqual(shared.late_exact_from, 3, "the split-off parent")
+        self.assertTrue(all(n.late_exact_from == 3 for _, _, n in p_tail))
+        q_tail = _path(cache, Q)[1:]
+        self.assertTrue(q_tail and all(n.late_exact_from == 5 for _, _, n in q_tail))
+
+    def test_direct_split_copies_the_field(self):
+        cache = _cache()
+        _insert(cache, P, 7)
+        core = cache.tree_core
+        (_, _, node), *_ = _path(cache, P)
+        new_parent, _ = core._split_node(node.key, node, 4)
+        self.assertEqual(new_parent.late_exact_from, 7)
+        self.assertEqual(node.late_exact_from, 7)
+
+    def test_none_stays_unknown(self):
+        cache = _cache()
+        _insert(cache, P, None)
+        self.assertTrue(all(n.late_exact_from is None for _, _, n in _path(cache, P)))
+
+
+class TestOverlapAndRecovery(unittest.TestCase):
+    def test_overlapping_insert_keeps_the_existing_value(self):
+        cache = _cache()
+        _insert(cache, P[:16], 3)
+        before = {id(n): n.late_exact_from for _, _, n in _path(cache, P[:16])}
+        _insert(cache, P, 9)
+        for start, end, node in _path(cache, P):
+            if end <= 16:
+                self.assertEqual(node.late_exact_from, before[id(node)])
+            else:
+                self.assertEqual(node.late_exact_from, 9, "the new tail leaf")
+
+    def test_identical_reinsert_keeps_the_existing_value(self):
+        cache = _cache()
+        _insert(cache, P, 3)
+        _insert(cache, P, 9)
+        self.assertTrue(all(n.late_exact_from == 3 for _, _, n in _path(cache, P)))
+
+    def test_tombstone_recovery_adopts_the_incoming_value(self):
+        cache = _cache()
+        _insert(cache, P, 3)
+        _insert(cache, Q, 5)
+        cache.evict(EvictParams(num_tokens=0, swa_num_tokens=WINDOW))
+        (_, _, shared), *p_tail = _path(cache, P)
+        self.assertIsNotNone(shared.component_data[_FULL].value)
+        self.assertIsNone(
+            shared.component_data[_SWA].value,
+            "precondition: the internal node's SWA rows are tombstoned",
+        )
+        result = _insert(cache, P, 9)
+        self.assertEqual(result.prefix_len, len(P))
+        self.assertIsNotNone(shared.component_data[_SWA].value)
+        self.assertEqual(
+            shared.late_exact_from, 9, "it now holds the incoming SWA rows"
+        )
+        # Nodes whose SWA rows were live keep their own.
+        self.assertTrue(all(n.late_exact_from == 3 for _, _, n in p_tail))
+        self.assertTrue(
+            all(n.late_exact_from == 5 for _, _, n in _path(cache, Q)[1:])
+        )
+
+    def test_unevict_recovery_publishes_with_the_incoming_value(self):
+        """``recover_after_unevict`` republishes the window from the request's
+        restored rows: a tombstoned node adopts the incoming value, a node
+        whose SWA is still live keeps its own."""
+        cache = _cache()
+        _insert(cache, P, 3)
+        _insert(cache, Q, 5)
+        cache.evict(EvictParams(num_tokens=0, swa_num_tokens=WINDOW))
+        (_, _, shared), (s1, e1, live), *_ = _path(cache, P)
+        self.assertIsNone(shared.component_data[_SWA].value)
+        self.assertIsNotNone(live.component_data[_SWA].value)
+        swa = cache.components[_SWA]
+        params = InsertParams(key=RadixKey(array("q", P)), late_exact_from=11)
+        for total, node in ((0, shared), (s1, live)):
+            swa.recover_after_unevict(
+                node=node,
+                prefix_len=len(node.key),
+                total_prefix_len=total,
+                params=params,
+                result=InsertResult(prefix_len=0),
+                cache_actions=[],
+            )
+        self.assertEqual(shared.late_exact_from, 11)
+        self.assertEqual(live.late_exact_from, 3)
+
+
+class TestSbrOffsetWalk(unittest.TestCase):
+    def test_offset_walk_stamps_splits_and_keeps(self):
+        cache = _cache()
+        _insert(cache, P, 3, offset_walk=True)
+        self.assertTrue(all(n.late_exact_from == 3 for _, _, n in _path(cache, P)))
+        _insert(cache, Q, 5, offset_walk=True)
+        (start, end, shared), *p_tail = _path(cache, P)
+        self.assertEqual((start, end), (0, 16))
+        self.assertEqual(shared.late_exact_from, 3)
+        self.assertTrue(all(n.late_exact_from == 3 for _, _, n in p_tail))
+        self.assertTrue(
+            all(n.late_exact_from == 5 for _, _, n in _path(cache, Q)[1:])
+        )
+        self.assertFalse(cache.tree_core._sbr_offset_walk)
+
+
+class TestAccessor(unittest.TestCase):
+    def test_core_and_cache_accessors_read_the_node(self):
+        cache = _cache()
+        self.assertTrue(cache.exact_decoder_trim)
+        _insert(cache, P, 3)
+        _insert(cache, Q, 5)
+        core = cache.tree_core
+        self.assertTrue(core.supports_late_exact_from)
+        for node in _nodes(cache):
+            self.assertEqual(core.late_exact_from_of(node.id), node.late_exact_from)
+            self.assertEqual(cache.late_exact_from_of(node.id), node.late_exact_from)
+        self.assertIsNone(cache.late_exact_from_of(None))
+        self.assertIsNone(cache.late_exact_from_of(core.root_node.id))
+
+    def test_interface_default_is_unknown(self):
+        self.assertFalse(UnifiedTreeCoreInterface.supports_late_exact_from)
+        self.assertIsNone(UnifiedTreeCoreInterface.late_exact_from_of(None, 0))
+
+    def test_a_core_without_the_field_is_refused_under_trim(self):
+        saved = UnifiedTreeCore.supports_late_exact_from
+        UnifiedTreeCore.supports_late_exact_from = False
+        try:
+            with self.assertRaisesRegex(
+                ValueError, "SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python"
+            ):
+                _cache(trim=True)
+            _cache(trim=False)  # flags off: no refusal
+        finally:
+            UnifiedTreeCore.supports_late_exact_from = saved
+
+
+class TestFlagsOff(unittest.TestCase):
+    def _check_all_valid(self, cache):
+        self.assertFalse(cache.exact_decoder_trim)
+        _insert(cache, P, None)
+        _insert(cache, Q, 5)
+        for node in _nodes(cache):
+            self.assertEqual(cache.late_exact_from_of(node.id), 0)
+        self.assertEqual(cache.late_exact_from_of(None), 0)
+
+    def test_trim_env_off(self):
+        self._check_all_valid(_cache(trim=False))
+
+    def test_bounded_replay_off(self):
+        self._check_all_valid(_cache(trim=True, bounded_replay=False))
+
+
+if __name__ == "__main__":
+    unittest.main()
