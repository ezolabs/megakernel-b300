+def _field_names(cls):
+    """Declared field names of a dataclass or a msgspec struct."""
+    if dataclasses.is_dataclass(cls):
+        return {f.name for f in dataclasses.fields(cls)}
+    return {f.name for f in msgspec.structs.fields(cls)}
+
+
+def _lines(caplog, prefix):
+    """The log lines that start with ``prefix`` and a space."""
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.name == LOGGER_NAME and r.getMessage().startswith(prefix + " ")
+    ]
+
+
+def _delta_names(text):
+    return re.findall(r"([a-z_]+)_ms=", text)
+
+
+def _delta_values(text):
+    return [float(x) for x in re.findall(r"_ms=(-?[\d.]+)", text)]
+
+
+def _assert_telescopes(m):
+    """Non-negative deltas whose sum is ``wall_ms``, to the rounding of each value."""
+    deltas = _delta_values(m["deltas"])
+    assert all(d >= 0.0 for d in deltas), m["deltas"]
+    assert abs(sum(deltas) - float(m["wall"])) <= 0.0005 * (len(deltas) + 1) + 1e-9
