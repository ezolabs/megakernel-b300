+def test_the_tool_member_null_bodies_are_the_routers_posting_of_the_clients():
+    """#8328: what the router posts for a client's tool-member nulls (#8309), as minted."""
+    toolnull = [r for r in RECORDS if r["kind"] == "toolnull"]
+    assert len(toolnull) == 26
+    client_fns = [f for r in toolnull for f in _functions(r["client"])]
+    egress_fns = [f for r in toolnull for f in _functions(r["egress"])]
+    assert len(client_fns) == len(egress_fns) == 22 * 2 + 22 + 2 + 2
+    # A top member the client sent as null is not posted; everything else is, as sent
+    # (a nested null included).
+    for client, egress in zip(client_fns, egress_fns):
+        assert egress == {k: v for k, v in client.items() if v is not None}, client
+    for r in toolnull:
+        for client, egress in zip(r["client"]["tools"], r["egress"]["tools"]):
+            assert {k: v for k, v in client.items() if v is not None} == dict(
+                egress, function=client["function"]
+            ), r["id"]
+    assert not any(
+        k in f and f[k] is None for f in egress_fns for k in ("parameters", "description")
+    )
+    # The families: a null schema (posted without `parameters`), `{}`, `{"a": null}`,
+    # nested nulls at depth 1 to 4 in objects and in lists, floats, non-ASCII text.
+    # n11, n12, n16 (alone and in the thinking body) and `ping` (3 bodies).
+    assert sum(f.get("parameters", 0) is None for f in client_fns) == 9
+    assert sum("parameters" not in f for f in egress_fns) == 9
+    assert {} in [f.get("parameters") for f in egress_fns]
+    assert {"a": None} in [f.get("parameters") for f in egress_fns]
+    # Container depth of the shallowest null under `parameters` (its own members = 1):
+    # `default` (1), a property's `default` / `anyOf[0].default` / `items[0].default` /
+    # `[[null]]` (3), `enum` / `examples` list members (4), a nested property's `const`
+    # (5), a list member four schema levels down (8).
+    depths = Counter(_depth_of_first_null(f.get("parameters")) for f in egress_fns)
+    assert {1, 3, 4, 5, 8} <= set(depths), depths
+    assert sum(_null_in_a_list(f.get("parameters")) for f in egress_fns) >= 6
+    params = json.dumps([f.get("parameters") for f in egress_fns], ensure_ascii=False)
+    assert "1e+21" in params and "-0.5" in params
+    assert "é日本" in params
+    assert any(f.get("description") == "é日本" for f in egress_fns)
