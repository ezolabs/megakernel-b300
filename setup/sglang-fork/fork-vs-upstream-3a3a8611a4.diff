+def _real_fast_tokenizer():
+    from tokenizers import Tokenizer, models, pre_tokenizers
+    from transformers import PreTrainedTokenizerFast
+
+    vocab = {"[UNK]": 0, "[BOS]": 1}
+    for i in range(997):
+        vocab[f"w{i}"] = len(vocab)
+    for word in ("You", "are", "terse", "x", "cheap", "turn"):
+        vocab[word] = len(vocab)
+    tokenizer = Tokenizer(models.WordLevel(vocab, unk_token="[UNK]"))
+    tokenizer.pre_tokenizer = pre_tokenizers.Whitespace()
+    return PreTrainedTokenizerFast(
+        tokenizer_object=tokenizer, unk_token="[UNK]", bos_token="[BOS]"
+    )
+
+
+def _words(n: int) -> str:
+    return " ".join(f"w{i % 997}" for i in range(n))
+
+
+class _Probe(OpenAIServingBase):
+    """A handler whose conversion either encodes a long text or changes the
+    tokenizer's truncation state, through ``self.tokenizer_manager``."""
+
+    convert_off_loop = True
+
+    def _request_id_prefix(self) -> str:
+        return "probe-"
+
+    def _convert_to_internal_request(self, request, raw_request=None):
+        tokenizer = self.tokenizer_manager.tokenizer
+        started = time.perf_counter()
+        if request["op"] == "encode":
+            request["entered"].set()
+            ids = tokenizer.encode(request["text"])
+        else:
+            ids = tokenizer(request["text"], truncation=True, max_length=8)["input_ids"]
+        return (tokenizer, ids, started, time.perf_counter()), request
+
+
+async def test_a_copy_isolates_tokenizer_state_from_another_workers_encode(
+    lanes_config,
+):
+    lanes_config(workers=2, giant_chars=0)
+    inner = _real_fast_tokenizer()
+    probe = _Probe(_TokenizerManager(inner))
+    long_text = _words(600_000)
+    entered = threading.Event()
+
+    encode = asyncio.create_task(
+        probe._convert_to_internal_request_async(
+            {"op": "encode", "text": long_text, "entered": entered}
+        )
+    )
+    await asyncio.to_thread(entered.wait, WAIT_S)
+    await asyncio.sleep(0.02)
+    (tok_m, ids_m, m_start, m_end), _ = await probe._convert_to_internal_request_async(
+        {"op": "mutate", "text": "w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12"}
+    )
+    (tok_e, ids_e, e_start, e_end), _ = await encode
+
+    assert tok_m is not tok_e and inner not in (tok_m, tok_e)
+    assert len(ids_m) == 8
+    assert m_end < e_end, "the truncation change waited for the other worker's encode"
+    assert m_end - m_start < 0.1, m_end - m_start
+    assert ids_e == inner.encode(long_text)
+
+    # Negative control: the same two calls on one shared real fast tokenizer.
+    # The truncation change must wait for the running encode (tokenizers 0.23)
+    # or raise "Already borrowed" (tokenizers <= 0.22).
+    shared = _real_fast_tokenizer()
+    started = threading.Event()
+    finished: Dict[str, float] = {}
+
+    def run_encode():
+        started.set()
+        shared.encode(long_text)
+        finished["encode"] = time.perf_counter()
+
+    thread = threading.Thread(target=run_encode)
+    thread.start()
+    started.wait(WAIT_S)
+    time.sleep(0.05)
+    raised = None
+    mutate_start = time.perf_counter()
+    try:
+        shared("w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12", truncation=True, max_length=8)
+    except RuntimeError as e:
+        raised = str(e)
+    blocked = time.perf_counter() - mutate_start
+    thread.join(WAIT_S)
+    # The Rust encode of 600k words takes several hundred ms; the change
+    # waits out what is left of it (the list conversion after it is not
+    # waited for, so the bound is well under the encode's length).
+    assert raised is not None or blocked >= 0.1, (raised, blocked, finished)
+    if raised is not None:
+        assert "Already borrowed" in raised
+
