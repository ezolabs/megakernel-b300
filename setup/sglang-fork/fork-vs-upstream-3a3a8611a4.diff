+def test_gate_semantics():
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate
+
+    gate = HiCachePollGate(lambda: True, heartbeat_calls=4)
+    assert [gate.should_poll() for _ in range(3)] == [True] * 3  # unarmed
+    gate.arm()
+    assert [gate.should_poll() for _ in range(4)] == [False, False, False, True]
+    gate.note_hint(1)
+    gate.note_hint(0)  # a later empty bit does not clear a pending one
+    assert gate.should_poll() is True
+    assert gate.should_poll() is False
+    gate.note_hint(0)
+    assert [gate.should_poll() for _ in range(3)] == [False, False, True]
+    assert gate.local_hint() is True
+    # A skipped receive delivers no bit: the next poll runs, once.
+    gate.note_receive_skipped()
+    assert [gate.should_poll() for _ in range(2)] == [True, False]
+
+    never = HiCachePollGate(lambda: False, heartbeat_calls=0)
+    never.arm()
+    assert not any(never.should_poll() for _ in range(1000))
+    never.note_hint(1)
+    assert never.should_poll() is True
+    assert never.polls == 1 and never.skips == 1000
+
