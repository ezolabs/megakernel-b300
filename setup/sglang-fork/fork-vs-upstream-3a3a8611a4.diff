+        ):
+            with self.subTest(choice=choice):
+                request = self._request(choice)
+                choice_data = self._response(request, self._completion(*calls))
+                self.assertEqual(choice_data.finish_reason, "tool_calls")
+                self.assertFalse(choice_data.message.content)
+                self.assertEqual(
+                    [
