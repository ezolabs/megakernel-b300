+++ b/test/srt/sbr/test_0044b_strict_gate_audit.py
@@ -0,0 +1,731 @@
+"""0044b - a runtime gate for the tool strict level, and the ``sbr-dsml`` audit.
+
+(a) ``SGLANG_SBR_TOOL_STRICT_GATE_FILE``: ``FunctionCallParser`` takes its strict level from
+``sbr_tool_strict.effective_tool_strict_level()``, which is ``SGLANG_TOOL_STRICT_LEVEL`` while the
+gate is open and ``OFF`` while it is closed. No path is always open (upstream behaviour); a set
+path is open while it exists, looked up at most once a second (0039's ``RecheckedPathGate``).
+
+(b) ``sbr_dsml_audit``: always on. Counts chat requests with tool parsing active, the tool calls
+they returned, the invokes the DSML detector dropped, and the requests whose returned
+``content`` (or ``reasoning_content``) holds ``｜DSML｜``; one ``sbr-dsml`` INFO line per 60 s and
+one ``sbr-dsml-leak`` WARNING per leaking request, without its text.
+
+Driven through the real ``OpenAIServingChat._build_chat_response`` and ``_generate_chat_stream``
+with the tokenizer manager replaced by a stand-in (no server, no tokenizer, no GPU), and the real
+``FunctionCallParser`` / DSML detector. The gate's clock and ``path_exists`` and the audit's clock
+are injected.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+from types import SimpleNamespace
+from typing import List, Optional
+from unittest import mock
+
+import pytest
+
+from sglang.srt.entrypoints.openai import sbr_dsml_audit as audit
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest, Tool
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.environ import ToolStrictLevel, envs
+from sglang.srt.function_call import sbr_tool_strict as strict
+from sglang.srt.function_call.function_call_parser import FunctionCallParser
+from sglang.srt.observability.sbr_phase_timing import RecheckedPathGate
+from _chat_serving_stub import init_chat_serving_defaults
+
+DSML = "｜DSML｜"
+GATE_PATH = "/sbr/tool-strict-gate"
+RID = "chatcmpl-0044b"
+# Prose that must never reach a log line.
+ANSWER_TEXT = "the answer text stays out of the log"
+
+WEATHER = {
+    "type": "function",
+    "function": {
+        "name": "get_weather",
+        "description": "Weather for a city.",
+        "parameters": {
+            "type": "object",
+            "properties": {"city": {"type": "string"}, "days": {"type": "integer"}},
+            "required": ["city"],
+        },
+    },
+}
+
+
+def _invoke(name: str, params: dict) -> str:
+    lines = [f'<{DSML} invoke name="{name}">']
+    for key, (value, is_string) in params.items():
+        flag = "true" if is_string else "false"
+        lines.append(
+            f'<{DSML} parameter name="{key}" string="{flag}">{value}</{DSML} parameter>'
+        )
+    lines.append(f"</{DSML} invoke>")
+    return "\n".join(lines) + "\n"
+
+
+def _calls(*invokes: str) -> str:
+    return f"<{DSML} calls>\n" + "".join(invokes) + f"</{DSML} calls>"
+
+
+GOOD = _invoke("get_weather", {"city": ("Paris", True), "days": ("2", False)})
+# A parameter tag without ``string=``: the detector drops the invoke as malformed.
+MALFORMED = (
+    f'<{DSML} invoke name="get_weather">\n'
+    f'<{DSML} parameter name="city">Paris</{DSML} parameter>\n'
+    f"</{DSML} invoke>\n"
+)
+# Cut off inside a parameter of an open calls block (max_tokens).
+CUT_OFF = f"x\n\n<{DSML} calls>\n" + GOOD.split(f"</{DSML} parameter>")[0]
+
+
+class _Clock:
+    def __init__(self, now: float = 1000.0) -> None:
+        self.now = now
+
+    def __call__(self) -> float:
+        return self.now
+
+
+class _Exists:
+    def __init__(self) -> None:
+        self.present = set()
+        self.calls: List[str] = []
+
+    def __call__(self, path: str) -> bool:
+        self.calls.append(path)
+        return path in self.present
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's chat paths read get_serving(), which needs a published config
+    # in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+@pytest.fixture(autouse=True)
+def _state(monkeypatch):
+    """No gate path, a fresh flip log, empty counters and an injected audit clock."""
+    monkeypatch.delenv("SGLANG_TOOL_STRICT_LEVEL", raising=False)
+    monkeypatch.setattr(strict, "GATE", RecheckedPathGate(""))
+    strict.reset()
+    monkeypatch.setattr(audit, "_clock", _Clock(0.0))
+    audit.reset()
+    yield
+    strict.reset()
+    audit.reset()
+
+
+# ==============================================================================================
+# (a) the gate
+# ==============================================================================================
+
+
+def _gated(monkeypatch):
+    gate = RecheckedPathGate(GATE_PATH)
+    clock, exists = _Clock(), _Exists()
+    gate.clock, gate.path_exists = clock, exists
+    monkeypatch.setattr(strict, "GATE", gate)
+    return gate, clock, exists
+
+
+def _parser() -> FunctionCallParser:
+    return FunctionCallParser([Tool.model_validate(WEATHER)], "deepseekv41")
+
+
+def _strict_lines(caplog) -> List[str]:
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.getMessage().startswith(strict.LOG_PREFIX)
+    ]
+
+
+def test_gate_env_default_and_parse(monkeypatch):
+    monkeypatch.delenv("SGLANG_SBR_TOOL_STRICT_GATE_FILE", raising=False)
+    assert envs.SGLANG_SBR_TOOL_STRICT_GATE_FILE.get() == ""
+    monkeypatch.setenv("SGLANG_SBR_TOOL_STRICT_GATE_FILE", GATE_PATH)
+    assert envs.SGLANG_SBR_TOOL_STRICT_GATE_FILE.get() == GATE_PATH
+
+
+def test_gate_path_is_read_at_import(monkeypatch):
+    import importlib
+
+    monkeypatch.setenv("SGLANG_SBR_TOOL_STRICT_GATE_FILE", GATE_PATH)
+    try:
+        assert importlib.reload(strict).GATE.path == GATE_PATH
+    finally:
+        monkeypatch.delenv("SGLANG_SBR_TOOL_STRICT_GATE_FILE")
+        assert importlib.reload(strict).GATE.path == ""
+
+
+@pytest.mark.parametrize("level", list(ToolStrictLevel))
+def test_path_unset_gives_the_env_level(monkeypatch, caplog, level):
+    caplog.set_level(logging.INFO, logger=strict.__name__)
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", str(int(level)))
+    assert strict.effective_tool_strict_level() == level
+    assert _parser().tool_strict_level == level
+    # Upstream behaviour: no gate, no flip line.
+    assert _strict_lines(caplog) == []
+
+
+def test_path_unset_and_env_unset_is_upstream_off():
+    assert strict.effective_tool_strict_level() == ToolStrictLevel.OFF
+    assert _parser().tool_strict_level == ToolStrictLevel.OFF
+
+
+def test_path_set_but_missing_gives_off(monkeypatch):
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "2")
+    _, _, exists = _gated(monkeypatch)
+    assert strict.effective_tool_strict_level() == ToolStrictLevel.OFF
+    assert _parser().tool_strict_level == ToolStrictLevel.OFF
+    assert exists.calls == [GATE_PATH]
+
+
+def test_creating_the_file_gives_the_env_level_within_one_recheck(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=strict.__name__)
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "1")
+    _, clock, exists = _gated(monkeypatch)
+    assert _parser().tool_strict_level == ToolStrictLevel.OFF
+    exists.present.add(GATE_PATH)
+    clock.now += 0.5  # not yet rechecked
+    assert _parser().tool_strict_level == ToolStrictLevel.OFF
+    clock.now += 0.5  # one recheck interval after the first look
+    assert _parser().tool_strict_level == ToolStrictLevel.FUNCTION
+    # Removed: OFF again at the next recheck.
+    exists.present.clear()
+    clock.now += 0.99
+    assert _parser().tool_strict_level == ToolStrictLevel.FUNCTION
+    clock.now += 0.01
+    assert _parser().tool_strict_level == ToolStrictLevel.OFF
+    assert _strict_lines(caplog) == [
+        "sbr-tool-strict level=0 gate=closed",
+        "sbr-tool-strict level=1 gate=open",
+        "sbr-tool-strict level=0 gate=closed",
+    ]
+
+
+def test_flip_line_is_logged_once_per_flip(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=strict.__name__)
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "2")
+    _, clock, exists = _gated(monkeypatch)
+    exists.present.add(GATE_PATH)
+    for _ in range(50):
+        clock.now += 0.3
+        assert strict.effective_tool_strict_level() == ToolStrictLevel.PARAMETER
+    assert _strict_lines(caplog) == ["sbr-tool-strict level=2 gate=open"]
+    # The path is stat'ed at most once a second.
+    assert len(exists.calls) <= 16
+
+
+def test_open_gate_hands_the_parser_a_level_that_constrains_auto(monkeypatch):
+    """Positive control: closed, ``auto`` builds no constraint; open, the env level does."""
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "1")
+    _, clock, exists = _gated(monkeypatch)
+    assert _parser().get_structure_constraint("auto") is None
+    exists.present.add(GATE_PATH)
+    clock.now += 1.0
+    constraint = _parser().get_structure_constraint("auto")
+    assert constraint is not None and constraint[0] == "structural_tag"
+
+
+# ==============================================================================================
+# (b) the audit
+# ==============================================================================================
+
+
+def _serving(tool_call_parser: Optional[str] = "deepseekv41", reasoning=None):
+    serving = init_chat_serving_defaults(OpenAIServingChat.__new__(OpenAIServingChat))
+    serving.template_manager = mock.Mock(
+        reasoning_config=None, force_reasoning=reasoning is not None
+    )
+    serving.reasoning_parser = reasoning
+    serving.tool_call_parser = tool_call_parser
+    serving.is_gpt_oss = False
+    serving.chat_encoding_spec = "dsv41"
+    serving.tokenizer_manager = SimpleNamespace(
+        server_args=SimpleNamespace(
+            return_input_ids=False,
+            return_output_ids=False,
+            enable_cache_report=False,
+            incremental_streaming_output=False,
+            stream_response_default_include_usage=False,
+        ),
+        model_config=SimpleNamespace(is_multimodal=False),
+        tokenizer=None,
+    )
+    if reasoning is not None:
+        serving._get_reasoning_from_request = lambda request: True
+    return serving
+
+
+def _request(tools=True, **extra) -> ChatCompletionRequest:
+    body = {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    if tools:
+        body["tools"] = [WEATHER]
+    body.update(extra)
+    return ChatCompletionRequest(**body)
+
+
+def _meta(finished: bool = True) -> dict:
+    return {
+        "id": RID,
+        "weight_version": "v1",
+        "prompt_tokens": 3,
+        "completion_tokens": 2,
+        "cached_tokens": 0,
+        "reasoning_tokens": 0,
+        "finish_reason": {"type": "stop", "matched": None} if finished else None,
+    }
+
+
+def _non_stream(serving, request, *texts):
+    ret = [
+        {"text": t, "meta_info": _meta(), "output_ids": [1, 2], "index": i}
+        for i, t in enumerate(texts)
+    ]
+    return json.loads(serving._build_chat_response(request, ret, 0).model_dump_json())
+
+
+def _stream_chunks(text: str, step: int, n: int = 1) -> List[dict]:
+    """Cumulative-text chunks of ``text`` in ``step``-char deltas, ``n`` choices interleaved."""
+    pieces = [text[i : i + step] for i in range(0, len(text), step)] or [""]
+    chunks = []
+    for k in range(len(pieces)):
+        for index in range(n):
+            chunks.append(
+                {
+                    "text": "".join(pieces[: k + 1]),
+                    "index": index,
+                    "meta_info": _meta(finished=k == len(pieces) - 1),
+                }
+            )
+    return chunks
+
+
+def _start_stream(serving, request, chunks):
+    async def _generate_request(adapted, raw):
+        for chunk in chunks:
+            yield chunk
+
+    serving.tokenizer_manager.generate_request = _generate_request
+    adapted = SimpleNamespace(rid=RID, is_single=True)
+    return serving._generate_chat_stream(adapted, request, None)
+
+
+def _deltas(frames, index: int = 0) -> List[dict]:
+    """Choice ``index``'s deltas, in order."""
+    return [
+        c["delta"]
+        for f in frames
+        if f.startswith("data: {")
+        for c in json.loads(f[len("data: ") :]).get("choices", [])
+        if c["index"] == index
+    ]
+
+
+async def _stream(serving, request, text: str, step: int, n: int = 1):
+    """Choice 0's content, reasoning and opened call names."""
+    gen = _start_stream(serving, request, _stream_chunks(text, step, n))
+    deltas = _deltas([f async for f in gen])
+    content = "".join(d.get("content") or "" for d in deltas)
+    reasoning = "".join(d.get("reasoning_content") or "" for d in deltas)
+    names = [
+        tc["function"]["name"]
+        for d in deltas
+        for tc in (d.get("tool_calls") or [])
+        if tc["function"].get("name")
+    ]
+    return content, reasoning, names
+
+
+def _leak_lines(caplog) -> List[str]:
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.getMessage().startswith(audit.LEAK_PREFIX)
+    ]
+
+
+def _summary_lines(caplog) -> List[str]:
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.getMessage().startswith(audit.LOG_PREFIX + " ")
+    ]
+
+
+def _expect(**nonzero) -> dict:
+    out = dict.fromkeys(audit.COUNTERS, 0)
+    out.update(nonzero)
+    return out
+
+
+# --- the summary line ---------------------------------------------------------------------------
+
+
+def test_summary_line_format_and_window(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=audit.__name__)
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "1")
+    clock = audit._clock
+    serving = _serving()
+    _non_stream(serving, _request(), _calls(GOOD))  # opens the window
+    clock.now = 59.9
+    _non_stream(serving, _request(), f"oops\n\n{_calls(MALFORMED)}")
+    assert _summary_lines(caplog) == []
+    clock.now = 60.0
+    # The first event at 60 s writes the window's line; it belongs to the next window.
+    _non_stream(serving, _request(tools=False), "plain answer")
+    (line,) = _summary_lines(caplog)
+    assert line == (
+        "sbr-dsml tool_requests=2 calls=1 dropped=1 text_leaks=0 parser_off_text=0 "
+        "reasoning_dsml=0 strict_level=1"
+    )
+    assert re.fullmatch(
+        r"sbr-dsml tool_requests=\d+ calls=\d+ dropped=\d+ text_leaks=\d+ "
+        r"parser_off_text=\d+ reasoning_dsml=\d+ strict_level=\d+",
+        line,
+    )
+    assert audit.stats() == _expect()
+
+
+def test_summary_line_reports_the_effective_strict_level(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=audit.__name__)
+    monkeypatch.setenv("SGLANG_TOOL_STRICT_LEVEL", "2")
+    _gated(monkeypatch)  # path set, file absent: OFF
+    audit.note_dropped()
+    audit._clock.now = 61.0
+    audit.note_dropped()
+    (line,) = _summary_lines(caplog)
+    assert line == (
+        "sbr-dsml tool_requests=0 calls=0 dropped=1 text_leaks=0 parser_off_text=0 "
+        "reasoning_dsml=0 strict_level=0"
+    )
+
+
+def test_an_idle_server_logs_nothing(caplog):
+    caplog.set_level(logging.INFO, logger=audit.__name__)
+    audit.note_dropped(0)  # not an event
+    audit._clock.now = 10_000.0
+    audit.note_dropped(0)
+    assert _summary_lines(caplog) == []
+    assert audit.stats() == _expect()
+
+
+# --- non-stream ---------------------------------------------------------------------------------
+
+
+def test_non_stream_tool_request_and_calls(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    body = _non_stream(_serving(), _request(), f"Checking.\n\n{_calls(GOOD, GOOD)}")
+    assert len(body["choices"][0]["message"]["tool_calls"]) == 2
+    assert audit.stats() == _expect(tool_requests=1, calls=2)
+    assert _leak_lines(caplog) == []
+
+
+def test_non_stream_dropped_malformed_cut_off_and_unclosed(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    serving = _serving()
+    body = _non_stream(serving, _request(), f"x\n\n{_calls(MALFORMED, GOOD)}")
+    assert len(body["choices"][0]["message"]["tool_calls"]) == 1
+    # Cut off inside the calls block: the open invoke is dropped with it.
+    body = _non_stream(serving, _request(), CUT_OFF)
+    assert body["choices"][0]["message"]["content"] == "x"
+    # A bare invoke that never closed.
+    _non_stream(serving, _request(), "y\n\n" + GOOD.split(f"</{DSML} invoke>")[0])
+    assert audit.stats() == _expect(tool_requests=3, calls=1, dropped=3)
+    assert _leak_lines(caplog) == []
+
+
+def test_non_stream_text_leak_with_parsing_active(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    # A parser that does not read DSML: the markup stays in content.
+    serving = _serving(tool_call_parser="hermes")
+    text = f"{ANSWER_TEXT} {_calls(GOOD)}"
+    body = _non_stream(serving, _request(tool_choice="auto", n=2), text, text)
+    assert all(DSML in c["message"]["content"] for c in body["choices"])
+    # Two choices leak; the request counts once.
+    assert audit.stats() == _expect(tool_requests=1, text_leaks=1)
+    (line,) = _leak_lines(caplog)
+    assert line == f"sbr-dsml-leak rid={RID} kind=text_leak tool_choice=auto"
+    assert ANSWER_TEXT not in line and DSML not in line
+
+
+@pytest.mark.parametrize(
+    "parser,request_kwargs",
+    [
+        ("deepseekv41", {"tools": False}),
+        ("deepseekv41", {"tool_choice": "none"}),
+        (None, {}),
+    ],
+    ids=["no-tools", "tool-choice-none", "no-parser"],
+)
+def test_non_stream_parser_off_text(caplog, parser, request_kwargs):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    serving = _serving(tool_call_parser=parser)
+    request = _request(**request_kwargs)
+    body = _non_stream(serving, request, f"{ANSWER_TEXT}\n{_calls(GOOD)}")
+    assert body["choices"][0]["message"].get("tool_calls") is None  # upstream omits nulls
+    assert DSML in body["choices"][0]["message"]["content"]
+    assert audit.stats() == _expect(parser_off_text=1)
+    (line,) = _leak_lines(caplog)
+    label = audit.tool_choice_label(request.tool_choice)
+    assert line == f"sbr-dsml-leak rid={RID} kind=parser_off_text tool_choice={label}"
+    assert ANSWER_TEXT not in line and DSML not in line
+
+
+def test_non_stream_reasoning_dsml_is_counted_but_not_a_leak(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    serving = _serving(reasoning="deepseek-r1")
+    text = f'thinking about <{DSML} invoke name="x"> markup</think>The answer.'
+    body = _non_stream(serving, _request(), text)
+    msg = body["choices"][0]["message"]
+    assert DSML in msg["reasoning_content"] and DSML not in msg["content"]
+    assert audit.stats() == _expect(tool_requests=1, reasoning_dsml=1)
+    assert _leak_lines(caplog) == []
+
+
+def test_non_stream_clean_answers_count_only_the_tool_request(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    _non_stream(_serving(), _request(), "Just prose with <b>tags</b> and a | bar.")
+    _non_stream(_serving(), _request(tools=False), "No tools here.")
+    assert audit.stats() == _expect(tool_requests=1)
+    assert _leak_lines(caplog) == []
+
+
+# --- stream ---------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("step", [1, 5, 10_000])
+async def test_stream_tool_request_calls_and_dropped(step, caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    text = f"Checking.\n\n{_calls(MALFORMED, GOOD, GOOD)}"
+    content, _, names = await _stream(_serving(), _request(), text, step)
+    assert names == ["get_weather", "get_weather"]
+    assert DSML not in content
+    assert audit.stats() == _expect(tool_requests=1, calls=2, dropped=1)
+    assert _leak_lines(caplog) == []
+
+
+@pytest.mark.parametrize("step", [1, 7, 10_000])
+async def test_stream_cut_off_inside_a_sent_call(step, caplog):
+    """Cut off inside a call already on the wire (its first parameter tag was
+    complete): the call stays, its arguments are not a JSON object, and it is
+    counted as dropped and logged without the answer text."""
+    caplog.set_level(logging.WARNING)
+    gen = _start_stream(_serving(), _request(), _stream_chunks(CUT_OFF, step))
+    deltas = _deltas([f async for f in gen])
+    content = "".join(d.get("content") or "" for d in deltas)
+    calls = [tc for d in deltas for tc in (d.get("tool_calls") or [])]
+    assert DSML not in content
+    assert [tc["function"]["name"] for tc in calls if tc["function"].get("name")] == [
+        "get_weather"
+    ]
+    arguments = "".join(tc["function"]["arguments"] or "" for tc in calls)
+    assert '{"city": "Paris'.startswith(arguments) and arguments.startswith("{")
+    assert audit.stats() == _expect(tool_requests=1, calls=1, dropped=1)
+    (line,) = [
+        r.getMessage()
+        for r in caplog.records
+        if r.getMessage().startswith("sbr-dsml-broken-call ")
+    ]
+    assert "tool=get_weather index=0 reason=unclosed" in line
+    assert "Paris" not in line
+
+
+async def test_stream_long_call_opens_before_its_closer():
+    """A long call's first tool_calls delta (id, name, empty arguments) goes
+    out within a few tokens of the invoke header, and the argument deltas
+    concatenate to the non-stream response's arguments."""
+    value = 'print("<b>x</b>")\n\tpath = "C:\\tmp"  # 中文\n' * 400
+    text = f"Writing.\n\n{_calls(_invoke('get_weather', {'city': (value, True), 'days': ('3', False)}))}"
+    chunks = _stream_chunks(text, 4)
+    pulled = []
+
+    async def _generate_request(adapted, raw):
+        for chunk in chunks:
+            pulled.append(len(chunk["text"]))
+            yield chunk
+
+    serving = _serving()
+    serving.tokenizer_manager.generate_request = _generate_request
+    gen = serving._generate_chat_stream(
+        SimpleNamespace(rid=RID, is_single=True), _request(), None
+    )
+    frames, first_call_at = [], None
+    async for frame in gen:
+        frames.append(frame)
+        if first_call_at is None and any(d.get("tool_calls") for d in _deltas([frame])):
+            first_call_at = pulled[-1]
+    calls = [tc for d in _deltas(frames) for tc in (d.get("tool_calls") or [])]
+    assert calls[0]["id"] and calls[0]["function"] == {
+        "name": "get_weather",
+        "arguments": "",
+    }
+    assert first_call_at < text.index('string="true">') + 20
+    assert first_call_at < text.index(f"</{DSML} invoke>") - len(value) + 100
+    arguments = "".join(tc["function"]["arguments"] or "" for tc in calls)
+    body = _non_stream(_serving(), _request(), text)
+    (expected,) = body["choices"][0]["message"]["tool_calls"]
+    assert arguments == expected["function"]["arguments"]
+    assert json.loads(arguments) == {"city": value, "days": 3}
+
+
+@pytest.mark.parametrize("step", [1, 3, 10_000])
+async def test_stream_text_leak_with_parsing_active(step, caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    text = f"{ANSWER_TEXT} {_calls(GOOD)}"
+    content, _, _ = await _stream(
+        _serving(tool_call_parser="hermes"), _request(n=2), text, step, n=2
+    )
+    assert DSML in content
+    # Both choices leak; the request counts once.
+    assert audit.stats() == _expect(tool_requests=1, text_leaks=1)
+    (line,) = _leak_lines(caplog)
+    assert line == f"sbr-dsml-leak rid={RID} kind=text_leak tool_choice=auto"
+    assert ANSWER_TEXT not in line and DSML not in line
+
+
+@pytest.mark.parametrize("step", [1, 2, 4, 10_000])
+async def test_stream_parser_off_text(step, caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    request = _request(tool_choice="none")
+    content, _, _ = await _stream(
+        _serving(), request, f"{ANSWER_TEXT}\n{_calls(GOOD)}", step
+    )
+    assert DSML in content
+    assert audit.stats() == _expect(parser_off_text=1)
+    (line,) = _leak_lines(caplog)
+    assert line == f"sbr-dsml-leak rid={RID} kind=parser_off_text tool_choice=none"
+    assert ANSWER_TEXT not in line and DSML not in line
+
+
+@pytest.mark.parametrize("step", [1, 3, 10_000])
+async def test_stream_reasoning_dsml(step, caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    serving = _serving(reasoning="deepseek-r1")
+    text = f'thinking about <{DSML} invoke name="x"> markup</think>The answer.'
+    content, reasoning, _ = await _stream(serving, _request(), text, step)
+    assert DSML in reasoning and DSML not in content
+    assert audit.stats() == _expect(tool_requests=1, reasoning_dsml=1)
+    assert _leak_lines(caplog) == []
+
+
+@pytest.mark.parametrize("cut", range(1, len(DSML)))
+async def test_stream_marker_split_across_deltas_counts(cut, caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    text = f"before {DSML} after"
+    at = text.index(DSML) + cut
+    chunks = [
+        {"text": text[:at], "index": 0, "meta_info": _meta(finished=False)},
+        {"text": text, "index": 0, "meta_info": _meta(finished=True)},
+    ]
+    gen = _start_stream(_serving(tool_call_parser=None), _request(), chunks)
+    emitted = [
+        d["content"] for d in _deltas([f async for f in gen]) if d.get("content")
+    ]
+    # Each delta alone holds no marker; only the carried tail joins them.
+    assert emitted == [text[:at], text[at:]]
+    assert all(DSML not in d for d in emitted)
+    assert audit.stats() == _expect(parser_off_text=1)
+    (line,) = _leak_lines(caplog)
+    assert "before" not in line and "after" not in line
+
+
+def test_split_marker_tail_is_per_choice():
+    a = audit.RequestAudit(False, None, rid=RID)
+    # Half a marker on choice 0, the other half on choice 1: no marker was returned.
+    a.observe_content("x" + DSML[:3], index=0)
+    a.observe_content(DSML[3:] + "y", index=1)
+    assert a.content_dsml is False
+    a.observe_content(DSML[3:], index=0)
+    assert a.content_dsml is True
+
+
+def test_tail_is_bounded_and_a_marker_far_back_is_not_rejoined():
+    a = audit.RequestAudit(True)
+    a.observe_content(DSML[:3] + "z" * 100)
+    assert len(a._content_tails[0]) == audit.TAIL_CHARS
+    a.observe_content(DSML[3:])
+    assert a.content_dsml is False
+
+
+async def test_stream_clean_answers_count_only_the_tool_request(caplog):
+    caplog.set_level(logging.WARNING, logger=audit.__name__)
+    await _stream(_serving(), _request(), "Plain prose, a < b, <b>x</b>.", 3)
+    await _stream(_serving(), _request(tools=False), "No tools.", 2)
+    assert audit.stats() == _expect(tool_requests=1)
+    assert _leak_lines(caplog) == []
+
+
+async def test_stream_is_committed_when_the_client_leaves_early():
+    text = f"{DSML} " * 20
+    chunks = [
+        {"text": text[: k + 1], "index": 0, "meta_info": _meta(finished=False)}
+        for k in range(len(text))
+    ]
+    gen = _start_stream(_serving(tool_call_parser=None), _request(tools=False), chunks)
+    for _ in range(12):
+        await gen.__anext__()
+    assert audit.stats() == _expect()  # not yet finished
+    await gen.aclose()
+    assert audit.stats() == _expect(parser_off_text=1)
+
+
+async def test_stream_failing_before_the_first_chunk_is_not_counted():
+    serving = _serving()
+
+    async def _generate_request(adapted, raw):
+        raise ValueError("context length exceeded")
+        yield  # pragma: no cover
+
+    serving.tokenizer_manager.generate_request = _generate_request
+    gen = serving._generate_chat_stream(
+        SimpleNamespace(rid=RID, is_single=True), _request(), None
+    )
+    with pytest.raises(ValueError):
+        await gen.__anext__()
+    assert audit.stats() == _expect()
+
+
+# --- the per-request object -------------------------------------------------------------------------
+
+
+def test_finish_is_idempotent_and_counts_each_kind_once():
+    a = audit.RequestAudit(True, "required", rid=RID)
+    for _ in range(3):
+        a.observe_content(DSML)
+        a.observe_reasoning(DSML)
+    a.add_calls(2)
+    a.finish()
+    a.finish()
+    assert audit.stats() == _expect(
+        tool_requests=1, calls=2, text_leaks=1, reasoning_dsml=1
+    )
+
+
+@pytest.mark.parametrize(
+    "choice,label",
+    [
+        (None, "unset"),
+        ("auto", "auto"),
+        ("required", "required"),
+        (
+            {"type": "function", "function": {"name": "get_weather"}},
+            "function:get_weather",
+        ),
+    ],
+)
+def test_tool_choice_label(choice, label):
+    if isinstance(choice, dict):
+        choice = _request(tool_choice=choice).tool_choice
+    assert audit.tool_choice_label(choice) == label
