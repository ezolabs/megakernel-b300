+def _generate_obj(*, ids=True, rid=RID, received_time=None, pre=None):
+    kwargs = dict(rid=rid, stream=True, sampling_params={"max_new_tokens": 2})
+    if ids:
+        kwargs["input_ids"] = [1, 2, 3, 4]
+    else:
+        kwargs["text"] = "hello there"
+    obj = GenerateReqInput(**kwargs)
+    obj.received_time = received_time
+    if pre is not None:
+        spt.attach_pre_stamps(obj, pre)
+    return obj
+
+
+async def _drive_generate(tm, obj):
+    with _tm_runtime():
+        async for _ in tm.generate_request(obj, None):
+            pass
