diff --git a/python/sglang/srt/mem_cache/sbr_unfinished_reuse.py b/python/sglang/srt/mem_cache/sbr_unfinished_reuse.py
new file mode 100644
index 0000000000..0f3e8051a5
--- /dev/null
+++ b/python/sglang/srt/mem_cache/sbr_unfinished_reuse.py
@@ -0,0 +1,57 @@
+"""Switch for ``SWARadixCache.cache_unfinished_req``'s reuse path (part 0041).
+
+``cache_unfinished_req`` runs for every request after each prefill chunk (and
+once after the prefill that produced its first token). For a request resuming a
+long cached prefix it does, at 0040::
+
+    values = req_to_token[row, :K].to(int64, copy=True)   # the whole prefix
+    insert(key, values)          # walks the path, slicing the key at every node
+    match_prefix(key)            # walks the same path again, slicing again
+    prefix_indices = cat([cat(node values), kv_tail])     # two whole-prefix copies
+
+The two walks slice the request's token array once per tree node, so their cost
+grows with ``cached_len * path_depth``. With the reuse path on, the insert walks
+the key by offset (``RadixKey.match_at`` / ``child_key_at``: no slicing),
+converts to ``int64`` only the slot ranges it actually stores or frees, and
+returns the node its path ends at; the match result is then read off that
+node's parent chain (the nodes the second walk would have visited, with the
+same sliding-window / tombstone rule and the same LRU and access-time updates)
+instead of walking the key again, and ``prefix_indices`` is built by one
+``torch.cat``. The tree, the allocator, ``req.prefix_indices``,
+``req.last_node`` and the locks end up exactly as on the original path (the
+part's property test compares them after every step of randomized runs).
+
+Part 0041b: the same switch governs ``UnifiedRadixCache.cache_unfinished_req``
+(the class a hybrid-SWA model runs through ``_create_unified_radix_cache``).
+There only the insert changes: on the Python TreeCore its walk
+(``UnifiedTreeCore._insert_walk_step``) slices the request's key at every node
+(``state.key = key[prefix_len:]``), O(cached_len * path_depth); with the switch
+on, ``_sbr_insert_walk_step_by_offset`` walks it by offset instead
+(``match_at`` / ``child_key_at``, absolute value offsets) and hands the commit
+step the same remainder. The ``match_prefix`` after the insert (session hook,
+component finalizers, linker) runs unchanged. The Rust TreeCore is not touched.
+
+Two settings (``environ.py``, read once at import):
+``SGLANG_SBR_UNFINISHED_REUSE`` (``EnvBool``, default off) and
+``SGLANG_SBR_UNFINISHED_REUSE_GATE_FILE`` (``EnvStr``): when set, the reuse path
+runs only while that path exists, looked up at most once per second per process
+(0039's gate rule, ``sbr_phase_timing.RecheckedPathGate``). Off, the original
+code runs unchanged; the only cost is one global test per call (and, with a gate
+path, the at-most-once-a-second ``stat``).
+"""
+
+from __future__ import annotations
+
+from sglang.srt.environ import envs
+from sglang.srt.observability.sbr_phase_timing import RecheckedPathGate
+
+# Read once at import, like 0038-0040's flags.
+ENABLED: bool = envs.SGLANG_SBR_UNFINISHED_REUSE.get()
+GATE = RecheckedPathGate(envs.SGLANG_SBR_UNFINISHED_REUSE_GATE_FILE.get())
+
+
+def active() -> bool:
+    """Whether the reuse path runs now: ``ENABLED``, and the gate open if one is set."""
+    if not ENABLED:
+        return False
+    return GATE.is_open()
diff --git a/python/sglang/srt/mem_cache/swa_branch_rebuild.py b/python/sglang/srt/mem_cache/swa_branch_rebuild.py
new file mode 100644
index 0000000000..0f1e8ef944
--- /dev/null
+++ b/python/sglang/srt/mem_cache/swa_branch_rebuild.py
@@ -0,0 +1,340 @@
+"""Rebuild a missing sliding window at a radix branch point by replaying R tokens.
+
+A DeepSeek-V4.1 prefix is reusable only up to the last position where the radix
+tree still holds a whole sliding window of SWA KV (the SWA boundary ``A``). Its
+Full KV (the compressed latents and the indexer keys) usually reaches much
+further, to ``B``: interior windows are tombstoned under SWA pressure, and a
+prompt that branches mid-history lands where no window was ever stored. Today
+such a request recomputes everything from ``A``.
+
+The window at ``B`` depends only on the ``R`` tokens before it. A layer's SWA
+KV at position ``t`` is a function of that layer's input at ``t``; layer ``l``'s
+input at ``t`` reads layer ``l - 1``'s window ``[t - W + 1, t]`` and the Full KV,
+which the tree holds exactly. A replay of ``[S, B)`` whose windows are floored
+at ``S`` therefore makes layer ``l``'s KV exact for ``t >= S + l (W - 1)``. The
+tree adopts SWA a node at a time, and the node that ends at ``B`` spans
+``tail = ceil(W / page) * page`` tokens, so every layer must be exact from
+``B - tail``:
+
+    R = ceil_page(tail + (L - 1) (W - 1))
+
+(5,376 tokens for DeepSeek-V4.1-Flash: 40 layers, window 128, page 256.)
+
+The rebuild is SWA load-back by compute:
+
+1. match: when ``B - A >= R + page``, the match hands back a plan to ``B``
+   (``SwaRebuildMatch``); ``match_kv_cache`` adopts it, so the request is
+   served from ``B`` and ``num_matched_prefix_tokens`` counts from ``B - R``.
+2. admission: after any HiCache load-back of the Full KV up to ``B``, and only
+   once the request is certain to be admitted, fresh SWA slots are paired with
+   the tree's Full slots of ``[B - R, B)``, the node ending at ``B`` is cut to
+   ``tail`` and takes the SWA slots of ``[B - tail, B)`` as its window, and only
+   then is the request locked, as an ordinary SWA-valid hit at ``B``.
+3. forward: before the batch runs, ``[B - R, B)`` is replayed in pieces of at
+   most one prefill chunk, writing into the tree's own slots, with the
+   compressor off (no Full KV or indexer-key write) and every window floored at
+   ``B - R`` (``ForwardBatch.encoder_swa_row_floor``).
+4. result: the slots of ``[B - R, B - tail)`` were scratch; they are released
+   once the forward that used them has completed.
+
+Under ``SGLANG_DSV4_EXACT_DECODER_TRIM`` (decoder SWA bounded replay) the
+late layers of every extend run only a page-anchored tail. A rebuild is then
+either full (``R`` rows, every layer; the replay's late tail is floored at
+``page_floor(B) - R_trim``, so the late window at ``B`` is exact) or, when the
+request will run at late floor ``G = B`` anyway (``rebuild_mode``), early-only:
+``ceil_page(tail + (late_layer_start - 1) (W - 1))`` rows (2,816), late layers
+on a ``SKIP_TAIL``-row tail, the node published late-invalid.
+
+Off unless ``SGLANG_SWA_BRANCH_REBUILD`` is set.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import logging
+from typing import Any, List, NamedTuple, Optional, Sequence
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def page_ceil(tokens: int, page_size: int) -> int:
+    return -(-tokens // page_size) * page_size
+
+
+def window_tail(sliding_window_size: int, page_size: int) -> int:
+    """Tokens of the node that holds the rebuilt window: the smallest page
+    multiple covering one window (the same cap `_maybe_split_leaf_for_swa_lock`
+    puts on a fresh leaf)."""
+    return page_ceil(sliding_window_size, page_size)
+
+
+def rebuild_span(num_layers: int, sliding_window_size: int, page_size: int) -> int:
+    """R: tokens to replay so that every layer's KV on the tail node is exact."""
+    assert num_layers >= 1 and sliding_window_size >= 1 and page_size >= 1
+    tail = window_tail(sliding_window_size, page_size)
+    return page_ceil(tail + (num_layers - 1) * (sliding_window_size - 1), page_size)
+
+
+class SwaRebuildMatch(NamedTuple):
+    """A match that can be served to ``seqlen`` once ``[start, seqlen)`` is replayed.
+
+    ``node`` ends at ``seqlen``. ``device_node`` is the deepest node on its path
+    whose Full KV is on the device (``node`` itself unless HiCache holds the rest
+    on the host); ``device_prefix_len`` counts the Full tokens from the root to
+    it (their indices are ``path_device_indices(device_node)``) and
+    ``host_hit_length`` the Full tokens between it and ``node``. Nodes are the
+    tree's own objects inside the tree core and NodeIds outside it.
+    """
+
+    seqlen: int
+    start: int
+    node: Any
+    device_node: Any
+    device_prefix_len: int
+    host_hit_length: int = 0
+
+
+class SwaRebuildCandidate(NamedTuple):
+    """What the match walk reached, before the SWA component decides."""
+
+    node: Any
+    device_node: Any
+    full_len: int
+
+
+@dataclasses.dataclass
+class SwaRebuild:
+    """A materialized rebuild, owned by the request until its batch has run."""
+
+    start: int
+    end: int
+    # Full indices of [start, end - tail): their SWA slots are scratch, freed
+    # (with their full->swa pairing) once the replay has completed.
+    scratch_full: torch.Tensor
+    replayed: bool = False
+    # Under SGLANG_DSV4_EXACT_DECODER_TRIM (see rebuild_mode): an early-only
+    # replay runs its late layers on SKIP_TAIL rows (the node is published
+    # late-invalid); a full one runs them at late floor late_floor_g
+    # (rebuild_late_floor) and far-skips the pieces below it. Both None/False
+    # without the exact trim.
+    early_only: bool = False
+    late_floor_g: Optional[int] = None
+
+
+def rebuild_late_floor(end: int, *, page: int, tail_len: int) -> int:
+    """G of a full rebuild replay ending at ``end`` under the exact trim.
+
+    The replay runs at prompt_len = end and late floor G = page_floor(end) - R:
+    a piece ending at or below G is far-skipped (late_tail_floors), and every
+    other piece's page-anchored floor is raised to exactly G. So the late rows
+    [G, end) come out as from one extend floored at G, whatever the pieces."""
+    from sglang.srt.layers.attention.dsv4.exact_decoder_trim import page_floor
+
+    return max(page_floor(end, page) - tail_len, 0)
+
+
+def rebuild_late_exact_from(
+    start: int, end: int, *, window: int, page: int, tail_len: int
+) -> int:
+    """late_exact_from of the node ending at ``end`` after a full rebuild replay
+    of [start, end) under the exact trim (B - 147 for DeepSeek-V4.1-Flash): one
+    extend floored at max(rebuild_late_floor, start), the replay's windows never
+    reading below start."""
+    from sglang.srt.layers.attention.dsv4.exact_decoder_trim import (
+        late_exact_from_after_extend,
+        prefix_late_exact_from,
+    )
+
+    floor = max(rebuild_late_floor(end, page=page, tail_len=tail_len), start)
+    return late_exact_from_after_extend(
+        start, end, floor, prefix_late_exact_from(start, None, window), window
+    )
+
+
+def rebuild_mode(
+    *,
+    end: int,
+    full_span: int,
+    early_span: int,
+    prompt_len: int,
+    whole_extend: bool,
+    page: int,
+    tail_len: int,
+) -> tuple[int, bool]:
+    """``(start, early_only)`` of a rebuild to ``end`` under the exact trim.
+
+    Early-only (``early_span``: the layers below late_layer_start, rebuild_span
+    of late_layer_start layers) when the request will run at late floor G = end
+    (match_late_floor of a late-invalid hit at end: not a whole extend and end
+    <= page_floor(P) - R), so its extend never reads the late rows the replay
+    leaves inexact. Full (every layer, an exact late window at ``end``)
+    otherwise. ``early_span`` 0 (no exact trim) is always full."""
+    from sglang.srt.layers.attention.dsv4.exact_decoder_trim import page_floor
+
+    if (
+        0 < early_span < full_span
+        and not whole_extend
+        and end <= page_floor(prompt_len, page) - tail_len
+    ):
+        return end - early_span, True
+    return end - full_span, False
+
+
+def plan_rebuild(
+    *,
+    span: int,
+    page_size: int,
+    swa_boundary_len: int,
+    full_hit_len: int,
+) -> Optional[tuple[int, int]]:
+    """``(start, end)`` of the replay, or None when recomputing from ``A`` is as cheap.
+
+    The replay costs ``R`` tokens and saves ``B - A``; it is only planned with a
+    page of margin, ``B - A >= R + page``.
+    """
+    if span <= 0:
+        return None
+    end = full_hit_len // page_size * page_size
+    if end - swa_boundary_len < span + page_size:
+        return None
+    return end - span, end
+
+
+def apply_match(req, match) -> None:
+    """Serve ``req`` from the plan's ``B`` (``match_kv_cache``).
+
+    The branch point needs no insert of its own afterwards
+    (``swa_branching_seqlen``), because the rebuild stores the window at ``B``.
+    """
+    req.swa_rebuild_match = match
+    req.prefix_len = match.device_prefix_len
+    req.last_node = match.device_node
+    req.last_host_node = match.node
+    req.best_match_node = match.node
+    req.host_hit_length = match.host_hit_length
+    req.swa_host_hit_length = 0
+    req.swa_branching_seqlen = None
+
+
+def swa_replay_start_per_token(
+    floors: Sequence[int], extend_lens: Sequence[int], device
+) -> torch.Tensor:
+    """One window floor per extend token (``ForwardBatch.encoder_swa_row_floor``)."""
+    assert len(floors) == len(extend_lens)
+    return torch.repeat_interleave(
+        torch.tensor(list(floors), dtype=torch.int64),
+        torch.tensor(list(extend_lens), dtype=torch.int64),
+    ).to(device)
+
+
+def startup_refusal(
