+class TestHttpLayers(CustomTestCase):
+    """409 mm_bytes_required before the first byte; chat ref re-indexing."""
+
+    def _gen(self, outs):
+        async def gen():
+            for out in outs:
+                yield out
+
+        return gen()
+
+    def test_generate_stream_peek(self):
+        abort = {
+            "meta_info": {
+                "finish_reason": {
+                    "type": "abort",
+                    "message": "mm_bytes_required: x",
+                    "status_code": HTTPStatus.CONFLICT,
+                    "err_type": mm_cached_refs.MM_BYTES_REQUIRED,
+                }
+            }
+        }
+
+        async def run(outs):
+            gen, rejected = await _peek_mm_bytes_required(self._gen(outs))
+            if rejected is not None:
+                return rejected
+            return [o async for o in gen]
+
+        rejected = asyncio.run(run([abort]))
+        self.assertEqual(rejected.status_code, 409)
+        self.assertIn(b"mm_bytes_required", rejected.body)
+        ok = [{"text": "a", "meta_info": {}}, {"text": "b", "meta_info": {}}]
+        self.assertEqual(asyncio.run(run(ok)), ok)
+
+    def test_chat_refs_reindexed_to_render_order(self):
