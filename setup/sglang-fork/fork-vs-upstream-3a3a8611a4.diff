+    monkeypatch.setattr(spt, "DETAIL", flags[1])
+    req = _FakeReq()
+    batch, result = _prefill_batch([req], [7])
+    sender = _Sender()
+    accumulator = mock.MagicMock()
+    accumulator.return_value.to_payload.return_value = None
+    with _scheduler_runtime(), mock.patch.object(
+        os_module, "_GenerationStreamAccumulator", accumulator
+    ):
+        _processor(_streamer(sender)).process_batch_result_prefill(batch, result)
+    accumulator.return_value.accept.assert_called_once_with(req=req)
+    assert req.output_ids == [7]
+    assert not hasattr(req, "sbr_phase")
