+def _todo_tool(strict=None):
+    """the serving router's todo_write as omni sends it: ``strict`` left out, item keys
+    alphabetical, each item open to other keys."""
+    item = {
+        "type": "object",
+        "additionalProperties": {},
+        "properties": {
+            "content": {"type": ["string", "null"]},
+            "id": {"type": ["string", "number", "null"]},
+            "kind": {"type": ["string", "null"]},
+            "notes": {"type": ["string", "null"]},
+            "status": {"type": ["string", "null"]},
+        },
+    }
+    function = {
+        "name": "todo_write",
+        "parameters": {
+            "type": "object",
+            "properties": {"todos": {"type": "array", "items": item}},
+            "required": ["todos"],
+        },
+    }
+    if strict is not None:
+        function["strict"] = strict
+    return Tool(type="function", function=function)
+
+
+# todo_write "todos" values: the item keys in declared order, two out of
+# declared order, and an out-of-order key padded into an undeclared one.
+_TODOS_IN_ORDER = [{"content": "x", "id": "#1", "kind": "build", "status": "pending"}]
+_TODOS_OUT_OF_ORDER = [
+    [{"status": "completed", "id": "#1"}],
+    [{"content": "x", "status": "pending", "kind": "build"}],
+]
+_TODOS_PADDED = [{"status": "completed", "id ": "#1"}]
+
+@unittest.skipUnless(
+    "deepseek_v4_1_xml" in get_args(JSONSchemaFormat.model_fields["style"].annotation),
+    "Requires XGrammar's DeepSeek V4.1 XML style",
+)
+class TestDeepSeekV41UnsetStrictIsNotStrict(CustomTestCase):
+    """#898: upstream #46133 made ``Function.strict`` default to None and an
+    unset one got its declared schema compiled in. xgrammar's schema grammar
+    holds an object's declared keys to their declared order, so a todo_write
+    item written ``status`` before ``id`` could only spell ``"id "``: the
+    padded keys. An unset ``strict`` is not strict again; an explicit
+    ``strict: true`` keeps its schema, key order included."""
+
+    INVOKE = f'<{DSML} invoke name="todo_write">\n'
+
+    @staticmethod
+    def _render(todos):
+        call = {"name": "todo_write", "arguments": json.dumps({"todos": todos})}
+        return _render_assistant(
+            {
+                "role": "assistant",
+                "content": "",
+                "reasoning_content": "reason",
+                "tool_calls": [{"type": "function", "function": call}],
+            },
+            thinking=False,
+            # deepseek-recipe refuses a strict tool whose additionalProperties
+            # is a schema; the rendered call is the same either way.
+            tools=[_todo_tool()],
+        ).removesuffix(EOS)
+
+    @staticmethod
+    def _grammar(tool, choice):
+        # box-c/box-a serve at SGLANG_TOOL_STRICT_LEVEL=1 (tool-strict.on).
+        parser = FunctionCallParser([tool], "deepseekv41")
+        parser.tool_strict_level = ToolStrictLevel.FUNCTION
+        constraint = parser.get_structure_constraint(choice)
+        assert constraint is not None and constraint[0] == "structural_tag"
+        return xgr.Grammar.from_structural_tag(constraint[1])
+
+    def _accepts(self, tool, todos):
+        output = self._render(todos)
+        return [
+            _is_grammar_accept_string(self._grammar(tool, choice), output)
+            for choice in ("auto", "required")
+        ]
+
+    def _body(self, tool):
+        tag = DeepSeekV41Detector().get_structural_tag([tool], "required")
+        return _invoke_bodies(tag)[self.INVOKE]
+
+    def test_structural_tag_tool_reads_unset_strict_as_false(self):
+        for strict, expected in ((None, False), (False, False), (True, True)):
+            with self.subTest(strict=strict):
+                converted = _structural_tag_tool(_todo_tool(strict))
+                self.assertIs(converted["function"]["strict"], expected)
+        tool = _todo_tool()
+        self.assertIsNone(tool.function.strict)
+        # The request side is untouched: no ``strict`` in the dump the chat
+        # template renders.
+        self.assertNotIn("strict", tool.model_dump()["function"])
+
+    def test_unset_strict_body_holds_the_parameter_names_only(self):
+        names_only = dict(
+            type="object", properties=dict(todos=dict()), additionalProperties=False
+        )
+        for strict in (None, False):
+            with self.subTest(strict=strict):
+                body = self._body(_todo_tool(strict))
+                self.assertEqual(body["json_schema"], names_only)
+                self.assertTrue(body["any_order"])
+        tool = _todo_tool(True)
+        body = self._body(tool)
+        self.assertEqual(body["json_schema"], tool.function.parameters)
+        self.assertFalse(body["any_order"])
+
+    def test_unset_strict_accepts_any_key_order(self):
+        for strict in (None, False):
+            tool = _todo_tool(strict)
+            for todos in [_TODOS_IN_ORDER, *_TODOS_OUT_OF_ORDER, _TODOS_PADDED]:
+                with self.subTest(strict=strict, todos=todos):
+                    self.assertEqual(self._accepts(tool, todos), [True, True])
+
+    def test_unset_strict_still_holds_the_parameter_name(self):
+        tool = _todo_tool()
+        output = self._render(_TODOS_IN_ORDER)
+        for wrong in ("todos ", "todo", "items"):
+            bad = output.replace('name="todos"', f'name="{wrong}"')
+            self.assertNotEqual(bad, output)
+            for choice in ("auto", "required"):
+                with self.subTest(name=wrong, choice=choice):
+                    grammar = self._grammar(tool, choice)
+                    self.assertFalse(_is_grammar_accept_string(grammar, bad))
+
+    def test_strict_true_keeps_the_declared_order(self):
+        # Unchanged: the schema grammar takes the declared order, and an
+        # out-of-order declared key only as an undeclared (padded) one.
+        tool = _todo_tool(True)
+        self.assertEqual(self._accepts(tool, _TODOS_IN_ORDER), [True, True])
+        for todos in _TODOS_OUT_OF_ORDER:
+            with self.subTest(todos=todos):
+                self.assertEqual(self._accepts(tool, todos), [False, False])
+        self.assertEqual(self._accepts(tool, _TODOS_PADDED), [True, True])
+
