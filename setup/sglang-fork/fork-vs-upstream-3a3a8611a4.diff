+
+@pytest.mark.parametrize("body", [TASK, REOPENED], ids=["task", "reopened_final_turn"])
+def test_a_task_or_a_reopened_turn_takes_the_full_encode(chat, body):
+    new, old, encodes = _both(chat, body)
