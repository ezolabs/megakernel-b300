+    chat = _mm_chat(tokenizer)
+    by_messages, _, _ = _convert(chat, swapped["egress"])
+    by_ids, _, _ = _convert(chat, swapped["egress"], _ids_of(swapped, "ids"))
+    for adapted in (by_messages, by_ids):
+        answer = _expand(mm_processor, adapted)
+        assert answer["prompt_token_ids"] == _ids_of(in_order, "prompt_token_ids")
