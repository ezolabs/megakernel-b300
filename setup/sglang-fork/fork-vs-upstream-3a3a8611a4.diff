+def _req(time_stats=None, rid="r1", length=8, max_new_tokens=64, stream=True) -> Req:
+    sampling_params = SamplingParams(max_new_tokens=max_new_tokens)
+    sampling_params.normalize(None)
+    return Req(
+        rid,
+        "",
+        array("q", range(1, length + 1)),
