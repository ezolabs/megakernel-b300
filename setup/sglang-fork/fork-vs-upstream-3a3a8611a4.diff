+def test_frames_are_bounded_and_concatenate_to_the_inline_snapshot():
+    cache, *_ = _hicache_tree()
+    cache.take_events()
+    cut = cache.cut_kv_snapshot()
+    assert cut.num_blocks == 22  # 0028's host tree: 12 device + 10 host pages
+
+    framed = list(recorder_events.render_snapshot_frames(cut, max_frame_tokens=3))
+    whole = list(recorder_events.render_snapshot_frames(cut))
+    cache.record_kv_snapshot()
+    inline = cache.take_events()
+
+    # Unbounded, the render is the inline snapshot byte for byte.
+    assert len(whole) == 1
+    encode = msgspec.msgpack.Encoder().encode
+    assert encode(KVEventBatch(ts=0.0, events=whole[0])) == encode(
+        KVEventBatch(ts=0.0, events=inline)
+    )
+    # Bounded: Begin opens the first frame, End closes the last, nothing else
+    # but page stores in between, and no frame holds more than 3 tokens.
+    assert len(framed) == 8
+    assert isinstance(framed[0][0], SnapshotBegin)
+    assert isinstance(framed[-1][-1], SnapshotEnd)
+    body = [e for f in framed for e in f][1:-1]
+    assert all(isinstance(e, BlockStored) for e in body)
+    for frame in framed:
+        assert sum(len(e.token_ids) for e in frame if isinstance(e, BlockStored)) <= 3
+    # Same pages, same parent links (a chain cut by a frame boundary resumes
+    # at its last page), same count.
+    assert _pages(body) == _pages(inline[1:-1])
+    assert sum(len(e.block_hashes) for e in body) == cut.num_blocks
+    assert framed[0][0].num_blocks == framed[-1][-1].num_blocks == 22
+
+    by_pages = list(recorder_events.render_snapshot_frames(cut, max_frame_pages=2))
+    assert len(by_pages) == 11
+    assert _pages([e for f in by_pages for e in f]) == _pages(inline)
+
