+import json
+import unittest
+
+from sglang.srt.parser import deepseek_recipe_output as output
+from sglang.srt.parser import deepseek_recipe_renderer as renderer
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase, is_in_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+MODEL = "deepseek-ai/DeepSeek-V4.1-Flash-1017"
+REVISION = "1bae0e1088993b9b82de08f59de5be5a34e42170"
+
+DSML = "<｜DSML｜"
+END = "</｜DSML｜"
+
+
+def _tokenizer_file():
+    """The V4.1 tokenizer; only outside CI does an unreachable Hub skip the test."""
+    from huggingface_hub import hf_hub_download
+
+    try:
+        return hf_hub_download(MODEL, "tokenizer.json", revision=REVISION)
+    except Exception as error:  # noqa: BLE001
+        if is_in_ci():
+            raise
+        raise unittest.SkipTest(f"the tokenizer is not available: {error}")
+
+
+def _parameter(name, value, string="true"):
+    return (
+        f'{DSML} parameter name="{name}" string="{string}">{value}'
+        f"{END} parameter>\n"
+    )
+
+
+def _invoke(name, *parameters):
+    return f'{DSML} invoke name="{name}">\n' + "".join(parameters) + f"{END} invoke>\n"
+
+
+def _calls(*invokes):
+    return f"\n\n{DSML} calls>\n" + "".join(invokes) + f"{END} calls>"
+
+
+class TestParameterNames(CustomTestCase):
+    """deepseek-recipe 0.2.0 cuts a parameter name at its first space
+    (deepseek-ai/deepseek-recipe#3); the parser writes names itself."""
+
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        from tokenizers import Tokenizer
+
+        cls.tokenizer = Tokenizer.from_file(_tokenizer_file())
+        cls.deepseek_recipe = renderer.DeepSeekRecipe("dsv41", cls.tokenizer)
+
+    def _ids(self, text):
+        return self.tokenizer.encode(text, add_special_tokens=False).ids
+
+    def _parser(self, *, raw=False, thinking=False, **options):
+        parser = output.DeepSeekRecipeOutputParser(
+            self.deepseek_recipe,
+            thinking_stage=self.deepseek_recipe.parse_start(thinking=thinking),
+            parse_tool_calls=options.pop("parse_tool_calls", True),
+            **options,
+        )
+        if raw:  # recipe as it parses the ids itself
+            parser._push_ids = parser._push_tokens
+        return parser
+
+    def _whole(self, text, *, finish="stop", **options):
+        return self._parser(**options).finish(self._ids(text), {"type": finish})
+
+    def _streamed(self, text, *, step=1, finish="stop", **options):
+        parser = self._parser(**options)
+        ids = self._ids(text)
+        delta = output.RecipeOutputDelta()
+        for start in range(0, len(ids), step):
+            delta = delta.merge(parser.feed(ids[start : start + step]))
+        return delta.merge(parser.finish([], {"type": finish}))
+
+    def _arguments(self, delta):
+        return [
+            (call.name, call.arguments) for call in output.whole_tool_calls(delta)
+        ]
+
+    def _assert_served(self, text, expected, **options):
+        """`text` parsed whole and streamed in steps, as `expected` calls whose
+        arguments are each valid JSON."""
+        for step in (None, 1, 2, 3, 7):
+            with self.subTest(step=step):
+                delta = (
+                    self._whole(text, **options)
+                    if step is None
+                    else self._streamed(text, step=step, **options)
+                )
+                calls = self._arguments(delta)
+                self.assertEqual(calls, expected)
+                for _, arguments in calls:
+                    json.loads(arguments)
+
+    def test_name_with_a_space(self):
+        # box-e cutover battery N2: `{"first: "abc123"}`.
+        self._assert_served(
+            _calls(_invoke("get_user", _parameter("first name", "abc123"))),
+            [("get_user", '{"first name": "abc123"}')],
+        )
+
+    def test_names_recipe_reads_unchanged(self):
+        self._assert_served(
+            _calls(
+                _invoke(
+                    "get_user",
+                    _parameter("first", "abc123"),
+                    _parameter("x-y.z_1", "v"),
+                    _parameter("名前", "名"),
+                )
+            ),
+            [("get_user", '{"first": "abc123", "x-y.z_1": "v", "名前": "名"}')],
+        )
+
+    def test_names_of_every_value_kind(self):
+        self._assert_served(
+            _calls(
+                _invoke(
+                    "f",
+                    _parameter("first name", 'he said "hi" \\ ok'),
+                    _parameter("my count", "5", string="false"),
+                    _parameter("my obj", '{"inner key": [1, "a b"]}', string="false"),
+                    _parameter("名 前", "x"),
+                    _parameter(" padded  name ", "y"),
+                    _parameter("back\\slash", "z"),
+                ),
+                _invoke("g", _parameter("last name", "b")),
+                _invoke("h"),
+            ),
+            [
+                (
+                    "f",
+                    '{"first name": "he said \\"hi\\" \\\\ ok", "my count": 5, '
+                    '"my obj": {"inner key": [1, "a b"]}, "名 前": "x", '
+                    '" padded  name ": "y", "back\\\\slash": "z"}',
+                ),
+                ("g", '{"last name": "b"}'),
+                ("h", "{}"),
+            ],
+        )
+
+    def test_names_in_a_forced_call_and_after_reasoning(self):
+        invoke = _invoke("get_user", _parameter("first name", "abc123"))
+        expected = [("get_user", '{"first name": "abc123"}')]
+        self._assert_served(invoke, expected, starts_in_tool_calls=True)
+        self._assert_served(
+            "Some thought.</think>Sure." + _calls(invoke), expected, thinking=True
+        )
+
+    def test_streamed_name_is_one_piece(self):
+        delta = self._streamed(
+            _calls(_invoke("get_user", _parameter("first name", "abc123")))
+        )
+        self.assertIn('"first name"', [call.arguments for call in delta.tool_calls])
+
+    def _assert_unchanged(self, text, **options):
+        """Where recipe reads no name, the parser serves what recipe parses."""
+        for step in (None, 1, 3):
+            with self.subTest(step=step):
+                served = (
+                    self._whole(text, **options)
+                    if step is None
+                    else self._streamed(text, step=step, **options)
+                )
+                raw = (
+                    self._whole(text, raw=True, **options)
+                    if step is None
+                    else self._streamed(text, step=step, raw=True, **options)
+                )
+                self.assertEqual(
+                    (served.reasoning, served.content, self._arguments(served)),
+                    (raw.reasoning, raw.content, self._arguments(raw)),
+                )
+
+    def test_attribute_text_outside_a_name_is_unchanged(self):
+        spelled = 'Write <parameter name="first name" string="true"> here.'
+        self._assert_unchanged(spelled)
+        self.assertEqual(self._whole(spelled).content, spelled)
+        self._assert_unchanged(spelled + "</think>" + spelled, thinking=True)
+        self.assertEqual(
+            self._whole(spelled + "</think>ok", thinking=True).reasoning, spelled
+        )
+        self._assert_unchanged(spelled, parse_tool_calls=False)
+        # In values: a string, and JSON text.
+        self._assert_served(
+            _calls(
+                _invoke(
+                    "f",
+                    _parameter("a", spelled),
+                    _parameter("b", json.dumps({"x": spelled}), string="false"),
+                )
+            ),
+            [("f", json.dumps({"a": spelled, "b": {"x": spelled}}))],
+        )
+
+    def test_output_ending_inside_a_name_is_parsed_as_recipe_parses_it(self):
+        for cut in ('first na', "first", ""):
+            text = (
+                f"\n\n{DSML} calls>\n"
+                f'{DSML} invoke name="f">\n{DSML} parameter name="{cut}'
+            )
+            with self.subTest(cut=cut):
+                self._assert_unchanged(text, finish="length")
+                self._assert_unchanged(text, finish="abort")
+
+    def test_marker_inside_a_name_is_parsed_as_recipe_parses_it(self):
+        self._assert_unchanged(
+            f"\n\n{DSML} calls>\n{DSML} invoke name=\"f\">\n"
+            f'{DSML} parameter name="first {END} invoke>\n{END} calls>'
+        )
+
+    def test_calls_recipe_reads_are_unchanged(self):
+        self._assert_unchanged(
+            "Sure."
+            + _calls(
+                _invoke(
+                    "f",
+                    _parameter("city", "Paris"),
+                    _parameter("n", "[1, 2]", string="false"),
+                ),
+                _invoke("g"),
+            )
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
