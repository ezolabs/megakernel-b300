+def recipe_chat(body):
+    request = dr.ChatCompletionRequest(json.dumps(body))
+    return request.convert(dr.ConversionOptions()).conversation
+
+
+def tool_definition(t):
+    """The ToolDefinition recipe's Chat converter builds for a non-strict tool."""
+    f = t["function"]
+    if f.get("strict"):
+        raise ValueError("the Conversation builder does not normalize strict tools")
+    parameters = f.get("parameters")
+    return dr.ToolDefinition(
+        f["name"], f.get("description"), {} if parameters is None else parameters
+    )
+
+
+def recipe_conversation(body, prefix_last=False):
+    """The body as a recipe Conversation, message tools kept on their SystemMessage.
+
+    ``prefix_last`` marks the trailing assistant message ``prefix``, which the
+    Chat converter refuses when the request declares tools.
+    """
+    thinking = body.get("thinking", {}).get("type") != "disabled"
+    messages = []
+    for m in body["messages"]:
+        role = m["role"]
+        if role == "system":
+            tools = [tool_definition(t) for t in m.get("tools") or []] or None
+            if not m["content"] and not tools:
+                continue  # the Chat converter drops an empty system message
+            messages.append(dr.SystemMessage(m["content"], tools=tools))
+        elif role == "user":
+            messages.append(dr.UserMessage(m["content"]))
+        elif role == "assistant":
+            rc = m.get("reasoning_content")
+            if rc is None and thinking:
+                rc = ""  # ConversionOptions' default FillEmpty
+            calls = [
+                dr.ToolCall(c["id"], c["function"]["name"], c["function"]["arguments"])
+                for c in m.get("tool_calls") or []
+            ] or None
+            prefix = prefix_last and m is body["messages"][-1]
+            messages.append(dr.AssistantMessage(m["content"], rc, calls, prefix))
+        elif role == "tool":
+            messages.append(dr.ToolMessage(m["content"], m["tool_call_id"]))
+        else:
+            raise ValueError(f"unsupported role {role!r} in a conversation case")
+    return dr.Conversation(
+        messages,
+        thinking_mode=thinking,
+        tools=[tool_definition(t) for t in body.get("tools") or []] or None,
+        reasoning_effort=body.get("reasoning_effort"),
+    )
+
+
+def without_message_tools(body):
+    body = json.loads(json.dumps(body))
+    for m in body["messages"]:
+        m.pop("tools", None)
+    return body
+
+
+def as_system(body):
+    body = json.loads(json.dumps(body))
+    for m in body["messages"]:
+        if m["role"] == "developer":
+            m["role"] = "system"
+    return body
+
+
+def with_prefix(body):
+    body = json.loads(json.dumps(body))
+    body["messages"][-1]["prefix"] = True
+    return body
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--tokenizer", required=True)
+    args = parser.parse_args()
+    tokenizer = dr.Tokenizer.from_file(args.tokenizer)
+    encoding = dr.DeepseekV41Encoding().with_tokenizer(tokenizer)
+
+    def render(conversation):
+        return encoding.render_conversation(conversation).prompt, encoding.encode(
+            conversation
+        )
+
+    for stale in os.listdir(HERE):
+        if stale.endswith(".json"):
+            os.remove(os.path.join(HERE, stale))
+
+    names = []
+    for name, points, source, partial in CASES:
+        body = {"model": MODEL, **partial}
+        fixture = {"name": name, "points": points, "source": source, "body": body}
+        if source == "recipe-chat":
+            prompt, ids = render(recipe_chat(body))
+        elif source == "recipe-chat-as-system":
+            prompt, ids = render(recipe_chat(as_system(body)))
+            fixture["recipe_body"] = as_system(body)
+        elif source == "recipe-conversation":
+            stripped = without_message_tools(body)
+            assert render(recipe_conversation(stripped)) == render(
+                recipe_chat(stripped)
+            ), f"{name}: the Conversation builder diverges from the Chat converter"
+            prompt, ids = render(recipe_conversation(body))
+            fixture["recipe_input"] = (
+                "recipe Conversation built from body: each system message's tools "
+                "on its SystemMessage, request tools as Conversation tools"
+            )
+        elif source == "live-deepseek":
+            if body.get("tools"):
+                # recipe's Chat converter refuses prefix with tools declared
+                # ("Function call should not be used with prefix"); its encoder
+                # renders the same Conversation with the prefix flag.
+                assert render(recipe_conversation(body)) == render(recipe_chat(body)), (
+                    f"{name}: the Conversation builder diverges from the Chat converter"
+                )
+                prompt, ids = render(recipe_conversation(body, prefix_last=True))
+                fixture["recipe_input"] = (
