+    assert chat._tool_call_parsing_active(real)
+    assert not chat._tool_call_parsing_active(placeholder)
+    assert real.skip_special_tokens is False
+    assert placeholder.skip_special_tokens is True
+    # ... and the protocol defaults a missing tool_choice from them (the router always
+    # writes one).
+    no_choice = {k: v for k, v in _tools_body().items() if k != "tool_choice"}
+    assert ChatCompletionRequest(**no_choice).tool_choice == "auto"
+    assert ChatCompletionRequest(**_placeholder_body(no_choice)).tool_choice == "none"
+    # A non-text part: the engine, which is not multimodal, refuses the media type.
+    refused = chat._validate_request(_request(_image_body(), [1, 2, 3]))
+    assert refused is not None and "image_url" in refused
+    placeholder = _request(_placeholder_body(_image_body()), [1, 2, 3])
+    assert chat._validate_request(placeholder) != refused
