+            node, device_path = stack.pop()
+            evicted = node.evicted
+            # A node no tier holds stops both passes: nothing under it is on
+            # device, and nothing under it can be matched.
+            if evicted and not getattr(node, "backuped", False):
+                continue
+            # The device pass stops at an evicted node, since nothing under
+            # it is on device; the host pass descends through it.
+            on_device = device_path and not evicted
+            on_host = self._host_copy_settled(node)
+            if on_device or on_host:
+                key = node.key
+                cache_salt = key.cache_salt
+                # The hashes, parent link, namespace and lora_name the store
+                # path (_emit_node_pages) publishes for this node.
+                hash_strs = self._node_event_hash_values(node)
+                seed = self._namespace_seed(node)
+                parent = self._parent_block_hash(node)
+                if parent is not None:
+                    parent = namespaced_block_hash(parent, namespace_seed=seed)
