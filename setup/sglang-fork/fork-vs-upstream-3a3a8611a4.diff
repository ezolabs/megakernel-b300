+"""0040 - memoised ``check_schema`` for tool ``parameters`` schemas in
+``OpenAIServingChat._validate_request``, behind ``SGLANG_SBR_SCHEMA_MEMO`` and a runtime gate,
+``SGLANG_SBR_SCHEMA_MEMO_GATE_FILE``.
+
+Off by default: every tool's schema is checked on every request, as before. On: a schema that
+already passed (same sha256 of its canonical JSON, taken after ``normalize_json_schema_types``)
+is not checked again; a failure is never stored and raises every time; the table is a bounded
+LRU; one ``sbr-schema-memo`` line is logged per 60 s. The gate makes the memo active only while
+a path exists, looked up at most once a second (0039's rule, ``RecheckedPathGate``).
+
+Driven through the real ``OpenAIServingChat._validate_request`` on real ``ChatCompletionRequest``
+objects, CPU only. ``Draft202012Validator.check_schema`` is wrapped by a counter that calls the
+real one, so "checked" is counted, not timed. The flags are module globals read at call time
+(``ENABLED``, ``GATE``), flipped with ``monkeypatch``; the gate's clock and ``stat`` and the
+counter line's clock are injected.
+"""
+
+from __future__ import annotations
+
+import copy
+import logging
+import threading
+from types import SimpleNamespace
+
+import pytest
+from jsonschema import Draft202012Validator, SchemaError
+
+from sglang.srt.entrypoints.openai import sbr_schema_memo as memo
+from sglang.srt.entrypoints.openai import serving_chat as sc
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.environ import envs
+from sglang.srt.observability import sbr_phase_timing as spt
+from sglang.srt.observability.sbr_phase_timing import RecheckedPathGate
+from _chat_serving_stub import init_chat_serving_defaults
+
+_REAL_CHECK = Draft202012Validator.check_schema
+
+
+class _Clock:
+    def __init__(self, now: float = 1000.0) -> None:
+        self.now = now
+
+    def __call__(self) -> float:
+        return self.now
+
+
+class _Exists:
+    """A counted ``os.path.exists`` over a set the test controls."""
+
+    def __init__(self) -> None:
+        self.present = set()
+        self.calls = []
+
+    def __call__(self, path: str) -> bool:
+        self.calls.append(path)
+        return path in self.present
+
+
+@pytest.fixture
+def checks(monkeypatch):
+    """Count ``Draft202012Validator.check_schema`` calls (both paths call it by that name)."""
+    calls = []
+
+    def counted(schema, *a, **kw):
+        calls.append(copy.deepcopy(schema))
+        return _REAL_CHECK(schema, *a, **kw)
+
+    monkeypatch.setattr(Draft202012Validator, "check_schema", counted)
+    return calls
+
+
+@pytest.fixture(autouse=True)
+def _published_config():
+    # Upstream's chat conversion reads get_model()/get_serving(), which need a
+    # published config in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+@pytest.fixture(autouse=True)
+def _memo_state(monkeypatch):
+    """Every test starts with the memo off, no gate path, an empty table and fresh counters."""
+    monkeypatch.setattr(memo, "ENABLED", False)
+    monkeypatch.setattr(memo, "GATE", RecheckedPathGate(""))
+    monkeypatch.setattr(memo, "MAX_ENTRIES", 4096)
+    monkeypatch.setattr(memo, "_clock", _Clock())
+    memo.reset()
+    yield
+    memo.reset()
+
+
+def _on(monkeypatch):
+    monkeypatch.setattr(memo, "ENABLED", True)
+
+
+def _serving():
+    srv = init_chat_serving_defaults(sc.OpenAIServingChat.__new__(sc.OpenAIServingChat))
+    srv.tokenizer_manager = SimpleNamespace(
+        server_args=SimpleNamespace(context_length=None, allow_auto_truncate=False),
+        model_config=SimpleNamespace(is_multimodal=False),
+    )
+    return srv
+
+
+def _schema(k: int) -> dict:
+    """A distinct valid object schema per ``k``."""
+    return {
+        "type": "object",
+        "properties": {
+            f"arg_{k}": {"type": "string", "description": f"argument {k}"},
+            "count": {"type": "integer", "minimum": 0},
+        },
+        "required": [f"arg_{k}"],
+        "additionalProperties": False,
+    }
+
+
+def _request(schemas) -> ChatCompletionRequest:
+    tools = [
+        {
+            "type": "function",
+            "function": {
+                "name": f"tool_{i}",
+                "description": "d",
+                "parameters": copy.deepcopy(s),
+            },
+        }
+        for i, s in enumerate(schemas)
+    ]
+    body = {
+        "model": "m",
+        "messages": [{"role": "user", "content": "hi"}],
+        "tools": tools,
+        "tool_choice": "auto",
+    }
+    return ChatCompletionRequest.model_validate(body)
+
+
+# --- flags -----------------------------------------------------------------------------------
+
+
+def test_flags_default_off_and_parse(monkeypatch):
+    monkeypatch.delenv("SGLANG_SBR_SCHEMA_MEMO", raising=False)
+    monkeypatch.delenv("SGLANG_SBR_SCHEMA_MEMO_GATE_FILE", raising=False)
+    assert envs.SGLANG_SBR_SCHEMA_MEMO.get() is False
+    assert envs.SGLANG_SBR_SCHEMA_MEMO_GATE_FILE.get() == ""
+    monkeypatch.setenv("SGLANG_SBR_SCHEMA_MEMO", "1")
+    monkeypatch.setenv("SGLANG_SBR_SCHEMA_MEMO_GATE_FILE", "/tmp/sbr-memo-gate")
+    assert envs.SGLANG_SBR_SCHEMA_MEMO.get() is True
+    assert envs.SGLANG_SBR_SCHEMA_MEMO_GATE_FILE.get() == "/tmp/sbr-memo-gate"
+
+
+def test_module_defaults_at_import_are_off():
+    # The test process does not set the flag, so the import-time read is off.
+    import importlib
+
+    fresh = importlib.reload(memo)
+    try:
+        assert fresh.ENABLED is False
+        assert fresh.GATE.path == ""
+        assert fresh.MAX_ENTRIES == 4096
+        assert fresh.LOG_INTERVAL_S == 60.0
+        assert fresh.active() is False
+    finally:
+        importlib.reload(memo)
+
+
+# --- off: today's behaviour -------------------------------------------------------------------
+
+
+def test_off_checks_every_tool_on_every_request(checks):
+    srv = _serving()
+    schemas = [_schema(k % 3) for k in range(6)]  # 3 distinct, each twice
+    for _ in range(4):
+        assert srv._validate_request(_request(schemas)) is None
+    assert len(checks) == 4 * 6
+    assert memo.stats() == {"entries": 0, "hits": 0, "misses": 0}
+
+
+def test_off_never_reads_the_gate_or_the_counter_clock(monkeypatch, checks):
+    def boom(*_a):
+        raise AssertionError("read while off")
+
+    gate = RecheckedPathGate("/nonexistent/gate")
+    gate.clock = boom
+    gate.path_exists = boom
+    monkeypatch.setattr(memo, "GATE", gate)
+    monkeypatch.setattr(memo, "_clock", boom)
+    assert memo.active() is False
+    assert _serving()._validate_request(_request([_schema(0), _schema(1)])) is None
+    assert len(checks) == 2
+
+
+def test_no_tools_does_not_consult_the_memo(monkeypatch):
+    def boom():
+        raise AssertionError("consulted without tools")
+
+    _on(monkeypatch)
+    monkeypatch.setattr(memo, "active", boom)
+    body = {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    assert (
+        _serving()._validate_request(ChatCompletionRequest.model_validate(body)) is None
+    )
+
+
+# --- on: one check per distinct schema ---------------------------------------------------------
+
+
+def test_on_checks_each_distinct_schema_once_across_requests(monkeypatch, checks):
+    _on(monkeypatch)
+    srv = _serving()
+    schemas = [_schema(k % 3) for k in range(6)]
+    for _ in range(4):
+        # A fresh request each time: new dict objects, same content.
+        assert srv._validate_request(_request(schemas)) is None
+    assert len(checks) == 3
+    assert sorted(c["required"][0] for c in checks) == ["arg_0", "arg_1", "arg_2"]
+    assert memo.stats() == {"entries": 3, "hits": 4 * 6 - 3, "misses": 3}
+
+
+def test_on_new_schema_in_a_later_request_is_checked_once(monkeypatch, checks):
+    _on(monkeypatch)
+    srv = _serving()
+    srv._validate_request(_request([_schema(0), _schema(1)]))
+    srv._validate_request(_request([_schema(0), _schema(1), _schema(2)]))
+    srv._validate_request(_request([_schema(2), _schema(0)]))
+    assert len(checks) == 3
+
+
+def test_on_and_off_return_the_same_result(monkeypatch, checks):
+    srv = _serving()
+    good = [_schema(0), _schema(1)]
+    bad = [_schema(0), {"type": "object", "properties": {"x": {"type": 12}}}]
+    off = (srv._validate_request(_request(good)), srv._validate_request(_request(bad)))
+    _on(monkeypatch)
+    on1 = (srv._validate_request(_request(good)), srv._validate_request(_request(bad)))
+    on2 = (srv._validate_request(_request(good)), srv._validate_request(_request(bad)))
+    assert off[0] is None and off[1].startswith(
+        "Tool 1 function has invalid 'parameters' schema:"
+    )
+    assert on1 == off and on2 == off
+
+
+# --- failures are never stored ------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {"type": 12},
+        {"type": "object", "properties": {"x": {"type": "nope"}}},
+        {"type": "object", "required": "x"},
+        {"type": "integer", "minimum": True},
+    ],
+)
+def test_invalid_schema_raises_every_time_and_is_never_cached(monkeypatch, checks, bad):
+    _on(monkeypatch)
+    srv = _serving()
+    errors = [srv._validate_request(_request([_schema(0), bad])) for _ in range(5)]
+    assert all(
+        e is not None and e.startswith("Tool 1 function has invalid") for e in errors
+    )
+    assert len(set(errors)) == 1
+    # schema 0 checked once; the bad one on every request.
+    assert len(checks) == 1 + 5
+    key = memo.schema_key(bad)
+    assert key is not None and key not in memo._valid
+    with pytest.raises(SchemaError):
+        memo.check_schema(copy.deepcopy(bad))
+    assert memo.stats()["entries"] == 1
+
+
+def test_a_cached_valid_schema_does_not_cover_a_near_miss(monkeypatch, checks):
+    # ``minimum: 1`` is valid; ``minimum: true`` is not. json.dumps keeps them apart.
+    _on(monkeypatch)
+    memo.check_schema({"type": "integer", "minimum": 1})
+    memo.check_schema({"type": "integer", "minimum": 1.0})
+    with pytest.raises(SchemaError):
+        memo.check_schema({"type": "integer", "minimum": True})
+    assert len(checks) == 3
+    assert memo.stats()["entries"] == 2
+
+
+def test_an_unkeyable_schema_is_checked_and_not_stored(monkeypatch, checks):
+    _on(monkeypatch)
+    # Not JSON-encodable (a set): no key, so jsonschema's own check decides every time
+    # (the metaschema wants "enum" to be an array, so it raises every time).
+    odd = {"type": "string", "enum": {"a", "b"}}
+    assert memo.schema_key(odd) is None
+    for _ in range(3):
+        with pytest.raises(SchemaError):
+            memo.check_schema(odd)
+    cyclic: dict = {"type": "object"}
+    cyclic["properties"] = {"self": cyclic}
+    assert memo.schema_key(cyclic) is None
+    deep: dict = {"type": "object"}
+    node = deep
+    for _ in range(5000):
+        node["properties"] = {"x": {"type": "object"}}
+        node = node["properties"]["x"]
+    assert memo.schema_key(deep) is None
+    assert len(checks) == 3
+    assert memo.stats() == {"entries": 0, "hits": 0, "misses": 3}
+
+
+# --- the key --------------------------------------------------------------------------------------
+
+
+def test_key_ignores_dict_order_and_whitespace_but_not_content():
+    a = {
+        "type": "object",
+        "properties": {"x": {"type": "string"}, "y": {"type": "integer"}},
+        "required": ["x"],
+    }
+    b = {
+        "required": ["x"],
+        "properties": {"y": {"type": "integer"}, "x": {"type": "string"}},
+        "type": "object",
+    }
+    assert memo.schema_key(a) == memo.schema_key(b)
+    assert len(memo.schema_key(a)) == 64
+    # List order is content (``required``, ``enum``, ``prefixItems`` order can matter).
+    c = copy.deepcopy(a)
+    c["required"] = ["x", "y"]
+    d = copy.deepcopy(a)
+    d["required"] = ["y", "x"]
+    assert memo.schema_key(c) != memo.schema_key(d)
+    # Value types stay apart.
+    assert len({memo.schema_key({"minimum": v}) for v in (1, 1.0, True, "1")}) == 4
+    # Non-ASCII text keys deterministically.
+    assert memo.schema_key({"description": "café"}) == memo.schema_key(
+        {"description": "café"}
+    )
+
+
+def test_dict_order_does_not_cause_a_second_check(monkeypatch, checks):
+    _on(monkeypatch)
+    a = {"type": "object", "properties": {"x": {"type": "string"}}, "required": ["x"]}
+    b = {"required": ["x"], "properties": {"x": {"type": "string"}}, "type": "object"}
+    srv = _serving()
+    srv._validate_request(_request([a]))
+    srv._validate_request(_request([b]))
+    assert len(checks) == 1
+
+
+def test_key_is_taken_after_normalisation_which_still_runs(monkeypatch, checks):
+    _on(monkeypatch)
+    srv = _serving()
+    aliased = {"type": "object", "properties": {"x": {"type": "varchar"}}}
+    standard = {"type": "object", "properties": {"x": {"type": "string"}}}
+    r1 = _request([aliased])
+    assert srv._validate_request(r1) is None
+    # The in-place rewrite (what the model's prompt is rendered from) still happens on a hit.
+    r2 = _request([aliased])
+    assert srv._validate_request(r2) is None
+    assert r2.tools[0].function.parameters == standard
+    r3 = _request([standard])
+    assert srv._validate_request(r3) is None
+    assert len(checks) == 1 and checks[0] == standard
+
+
+# --- the LRU bound ---------------------------------------------------------------------------------
+
+
+def test_lru_is_bounded_and_evicts_the_least_recent(monkeypatch, checks):
+    _on(monkeypatch)
+    monkeypatch.setattr(memo, "MAX_ENTRIES", 3)
+    s = [_schema(k) for k in range(5)]
+    for k in range(3):
+        memo.check_schema(s[k])
+    memo.check_schema(s[0])  # a hit refreshes 0: 1 is now the oldest
+    assert len(checks) == 3
+    memo.check_schema(s[3])  # evicts 1
+    assert memo.stats()["entries"] == 3
+    assert list(memo._valid) == [memo.schema_key(x) for x in (s[2], s[0], s[3])]
+    memo.check_schema(s[0])  # still there
+    assert len(checks) == 4
+    memo.check_schema(s[1])  # evicted: checked again, evicts 2
+    assert len(checks) == 5
+    assert memo.schema_key(s[2]) not in memo._valid
+    for k in range(200):
+        memo.check_schema(_schema(100 + k))
+    assert memo.stats()["entries"] == 3
+
+
+def test_concurrent_lookups_keep_the_table_consistent(monkeypatch):
+    _on(monkeypatch)
+    monkeypatch.setattr(memo, "MAX_ENTRIES", 8)
+    schemas = [_schema(k) for k in range(20)]
+    errors = []
+
+    def worker(off):
+        try:
+            for i in range(300):
+                memo.check_schema(schemas[(i + off) % 20])
+        except Exception as e:  # pragma: no cover - the failure is the assertion below
+            errors.append(e)
+
+    threads = [threading.Thread(target=worker, args=(t,)) for t in range(8)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert errors == []
+    st = memo.stats()
+    assert st["entries"] <= 8
+    assert st["hits"] + st["misses"] == 8 * 300
+
+
+# --- the runtime gate -------------------------------------------------------------------------------
+
+
+def _gated(monkeypatch, path="/sbr/memo-gate"):
+    _on(monkeypatch)
+    gate = RecheckedPathGate(path)
+    clock, exists = _Clock(), _Exists()
+    gate.clock, gate.path_exists = clock, exists
+    monkeypatch.setattr(memo, "GATE", gate)
+    return gate, clock, exists
+
+
+def test_gate_opens_and_closes_without_a_restart(monkeypatch, checks):
+    gate, clock, exists = _gated(monkeypatch)
+    srv = _serving()
+    schemas = [_schema(0), _schema(1)]
+    # Absent: off. Every tool checked, nothing stored.
+    srv._validate_request(_request(schemas))
+    srv._validate_request(_request(schemas))
+    assert len(checks) == 4 and memo.stats()["entries"] == 0
+    # Created: on at the next recheck (not before).
+    exists.present.add(gate.path)
+    clock.now += 0.5
+    srv._validate_request(_request(schemas))
+    assert len(checks) == 6
+    clock.now += 0.5
+    srv._validate_request(_request(schemas))
+    srv._validate_request(_request(schemas))
+    assert len(checks) == 8 and memo.stats()["entries"] == 2
+    # Removed: off again at the next recheck; the table is kept.
+    exists.present.clear()
+    clock.now += 1.0
+    srv._validate_request(_request(schemas))
+    assert len(checks) == 10 and memo.stats()["entries"] == 2
+    # Re-opened: warm.
+    exists.present.add(gate.path)
+    clock.now += 1.0
+    srv._validate_request(_request(schemas))
+    assert len(checks) == 10
+
+
+def test_gate_stats_the_path_at_most_once_a_second(monkeypatch):
+    gate, clock, exists = _gated(monkeypatch)
+    seen = []
+    for i in range(5000):
+        clock.now = 1000.0 + i * 0.01  # 50 s
+        if gate.is_open():
+            pass
+        if exists.calls and (not seen or seen[-1][0] != len(exists.calls)):
+            seen.append((len(exists.calls), clock.now))
+    assert len(exists.calls) <= 51
+    times = [t for _, t in seen]
+    assert all(b - a >= gate.recheck_s - 1e-9 for a, b in zip(times, times[1:]))
+
+
+def test_gate_with_no_path_is_always_open_and_reads_nothing():
+    def boom(*_a):
+        raise AssertionError("read")
+
+    gate = RecheckedPathGate("")
+    gate.clock = boom
+    gate.path_exists = boom
+    assert gate.is_open() is True
+
+
+def test_gate_defaults_are_0039s_rule(tmp_path):
+    gate = RecheckedPathGate(str(tmp_path / "g"))
+    assert gate.recheck_s == spt.GATE_RECHECK_S == 1.0
+    assert gate.path_exists.__name__ == "exists"
+    assert gate.is_open() is False
+    (tmp_path / "g").write_text("")
+    gate._checked_at -= 1.0
+    assert gate.is_open() is True
+
+
+def test_the_0039_timer_gate_is_untouched_by_the_memo_gate(monkeypatch, tmp_path):
+    # Separate paths, separate state: opening one does not open the other.
+    monkeypatch.setattr(spt, "ENABLED", True)
+    monkeypatch.setattr(spt, "GATE_FILE", str(tmp_path / "timer"))
+    monkeypatch.setattr(spt, "_gate_checked_at", None)
+    monkeypatch.setattr(spt, "_gate_open", False)
+    (tmp_path / "memo").write_text("")
+    _on(monkeypatch)
+    monkeypatch.setattr(memo, "GATE", RecheckedPathGate(str(tmp_path / "memo")))
+    assert memo.active() is True
+    assert spt.active() is False
+
+
+# --- the counter line ------------------------------------------------------------------------------
+
+
+def _memo_lines(caplog):
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.getMessage().startswith(memo.LOG_PREFIX)
+    ]
+
+
+def test_counter_line_once_per_60s_while_on(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=memo.__name__)
+    _on(monkeypatch)
+    clock = _Clock(0.0)
+    monkeypatch.setattr(memo, "_clock", clock)
+    srv = _serving()
+    schemas = [_schema(0), _schema(1), _schema(0)]
+    srv._validate_request(_request(schemas))  # opens the window: 2 misses, 1 hit
+    clock.now = 59.9
+    srv._validate_request(_request(schemas))  # 3 hits, still inside the window
+    assert _memo_lines(caplog) == []
+    clock.now = 60.0
+    srv._validate_request(_request(schemas))  # the first lookup at 60 s writes the line
+    assert _memo_lines(caplog) == ["sbr-schema-memo hits=4 misses=2 entries=2"]
+    # Counters restart with the new window (the 3 lookups of the call that logged are in it).
+    clock.now = 100.0
+    srv._validate_request(_request(schemas))
+    assert len(_memo_lines(caplog)) == 1
+    clock.now = 120.0
+    srv._validate_request(_request(schemas))
+    assert _memo_lines(caplog)[-1] == "sbr-schema-memo hits=6 misses=0 entries=2"
+    assert len(_memo_lines(caplog)) == 2
+
+
+def test_no_counter_line_while_off(monkeypatch, caplog):
+    caplog.set_level(logging.INFO, logger=memo.__name__)
+    clock = _Clock(0.0)
+    monkeypatch.setattr(memo, "_clock", clock)
+    srv = _serving()
+    for t in range(0, 600, 30):
+        clock.now = float(t)
+        srv._validate_request(_request([_schema(0)]))
+    assert _memo_lines(caplog) == []
+
+
+def test_counter_line_matches_the_documented_shape(monkeypatch, caplog):
+    import re
+
+    caplog.set_level(logging.INFO, logger=memo.__name__)
+    _on(monkeypatch)
+    clock = _Clock(0.0)
+    monkeypatch.setattr(memo, "_clock", clock)
+    memo.check_schema(_schema(0))
+    clock.now = 61.0
+    memo.check_schema(_schema(0))
+    (line,) = _memo_lines(caplog)
+    assert re.fullmatch(r"sbr-schema-memo hits=\d+ misses=\d+ entries=\d+", line)
diff --git a/test/srt/sbr/test_0041b_unified_offset_walk.py b/test/srt/sbr/test_0041b_unified_offset_walk.py
