+def test_the_scan_matches_each_request_once_and_stops_at_the_first_eligible(cache):
+    queue = [
+        _cold("cold-a", 1.0),
+        _cold("cold-b", 2.0, length=COLD_B),
+        _warm("warm-1", 3.0),
+        _warm("warm-2", 4.0),
