+                frame,
+                BlockStored(
+                    block_hashes=[block_hash],
+                    parent_block_hash=parent_block_hash,
+                    token_ids=page_tokens,
+                    block_size=len(page_tokens),
+                    lora_id=None,
+                    medium=medium,
+                    cache_salt=cache_salt,
+                    session_id=None,
+                    lora_name=lora_name,
+                ),
+            )
