+def test_a_request_during_a_render_is_served_by_the_next_snapshot(monkeypatch):
+    cache, *_ = _hicache_tree()
+    publisher = _Publisher(snapshot_requests=2)
+    component = _off_loop(cache, publisher)
+    gate = _Gate(monkeypatch, release_first=1)
