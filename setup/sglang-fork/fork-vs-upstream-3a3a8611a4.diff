+# ---------------------------------------------------------------------------
+# End to end with a reference model
+# ---------------------------------------------------------------------------
+
+
+class RefModel:
+    """L layers; layer l maps h to h + tanh(swa(h) + full(h)).
+
+    ``swa``: softmax attention over layer l's K/V of the window [t - W + 1, t]
+    (floored), stored in an SWA pool addressed through ``full_to_swa``.
+    ``full``: softmax attention over layer l's Full latents of every position
+    <= t, stored in a Full pool at the Full slots (the tree's Full KV; like
+    DSV4.1's compressed latents, a replay reads them and never writes them).
+
+    ``late_start`` set: the exact decoder trim's late layers. Layers >= it run
+    only the rows >= ``late_floor`` (their windows floored there), write SWA
+    K/V only for those rows, and read the last early layer's Full latents (the
+    KV source, written for every row), as DSV4.1's late layers do.
+    """
+
+    def __init__(self, layers=LAYERS, window=WINDOW, dim=16, seed=0, late_start=None):
+        g = torch.Generator().manual_seed(seed)
+
+        def mat(*shape):
+            return torch.randn(*shape, generator=g, dtype=torch.float64) / dim**0.5
+
+        self.layers, self.window, self.dim = layers, window, dim
+        self.late_start = late_start
+        self.emb = torch.randn(VOCAB, dim, generator=g, dtype=torch.float64)
+        self.w = [
+            {k: mat(dim, dim) for k in ("q", "k", "v", "m", "qm")}
+            for _ in range(layers)
+        ]
+        self.out = mat(dim, VOCAB)
+
+    def pools(self):
+        shape = (KV_SIZE + 2, self.layers, self.dim)
+        noise = torch.Generator().manual_seed(99)
+        return {
+            name: torch.randn(*shape, generator=noise, dtype=torch.float64)
+            for name in ("k", "v", "m")
+        }
+
+    def forward(
+        self,
+        pools,
+        mapping,
+        row,
+        tokens,
+        s,
+        e,
+        *,
+        write_full,
+        floor=None,
+        late_floor=None,
+    ):
+        """Extend positions [s, e) of one request whose Full slots are ``row``;
+        logits of the rows the last layer ran (from late_floor, if later)."""
+        h = self.emb[torch.tensor(tokens)]
+        first = s  # the position of h[0]
+        for l, w in enumerate(self.w):
+            late = self.late_start is not None and l >= self.late_start
+            lo_floor = 0 if floor is None else floor
+            if late and late_floor is not None:
+                if late_floor > first:
+                    h, first = h[late_floor - first :], late_floor
+                lo_floor = max(lo_floor, late_floor)
+            full_slots = row[first:e]
+            swa_slots = mapping[full_slots]
+            pools["k"][swa_slots, l] = h @ w["k"]
+            pools["v"][swa_slots, l] = h @ w["v"]
+            m_layer = self.late_start - 1 if late else l
+            if write_full and not late:
+                pools["m"][full_slots, l] = h @ w["m"]
+            out = torch.empty_like(h)
+            for j, t in enumerate(range(first, e)):
+                lo = max(t - self.window + 1, lo_floor)
+                ks = pools["k"][mapping[row[lo : t + 1]], l]
+                vs = pools["v"][mapping[row[lo : t + 1]], l]
+                q = h[j] @ w["q"]
+                a = torch.softmax(ks @ q, 0) @ vs
+                lat = pools["m"][row[: t + 1], m_layer]
+                qm = h[j] @ w["qm"]
+                c = torch.softmax(lat @ qm, 0) @ lat
+                out[j] = h[j] + torch.tanh(a + c)
+            h = out
+        return h @ self.out
+
+    def cold(self, tokens):
+        """A cold prefill of ``tokens`` in fresh pools: (logits, pools, row)."""
+        pools = self.pools()
+        row = torch.arange(1, len(tokens) + 1)
+        mapping = torch.arange(KV_SIZE + 2)
+        logits = self.forward(
+            pools, mapping, row, tokens, 0, len(tokens), write_full=True
+        )
+        return logits, pools, row, mapping
+
+
+class _Runner:
+    """Model runner stand-in: runs RefModel on the replay's forward batch."""
+
+    def __init__(self, model, pools, tree, floor_mode="replay", trim_tail=None):
+        self.model_obj = model
+        self.trim_tail = trim_tail  # R under the exact trim, else None
+        self.late_floors = []
+        self.pools = pools
+        self.tree = tree
+        self.device = "cpu"
+        self.req_to_token_pool = tree.req_to_token_pool
+        self.model = SimpleNamespace(model=SimpleNamespace(engram_hasher=None))
+        self.floor_mode = floor_mode
+        self.calls = []
+
+    def forward(self, fb):
+        s, e = fb.prefix_lens[0], int(fb.seq_lens_cpu[0])
+        row = self.req_to_token_pool.req_to_token[fb.req_pool_indices[0]].long()
+        assert fb.out_cache_loc.tolist() == row[s:e].tolist()
+        floor = None
+        if fb.encoder_swa_row_floor is not None:
+            rows = fb.encoder_swa_row_floor.tolist()
+            assert len(rows) == e - s and len(set(rows)) == 1, rows
+            floor = rows[0]
+        if self.floor_mode == "piece":
+            floor = s
+        self.calls.append((s, e, fb.encoder_swa_replay, floor))
+        late_floor = None
+        if self.trim_tail is not None:
+            # The backend's late floor (exact_trim_tail_floors) composed with
+            # the replay's row floor, as _build_late_layer_tail_metadata does.
+            from sglang.srt.layers.attention.deepseek_v4_backend import (
+                exact_trim_tail_floors,
+            )
+
+            (late_floor,) = exact_trim_tail_floors(
+                fb, [e], [False], tail_len=self.trim_tail, tail_page=PAGE
+            )
+            late_floor = max(late_floor, floor or 0)
+        self.late_floors.append((s, e, late_floor))
+        mapping = self.tree.token_to_kv_pool_allocator.full_to_swa_index_mapping
+        return self.model_obj.forward(
+            self.pools,
+            mapping,
+            row,
+            fb.input_ids.tolist(),
+            s,
+            e,
+            write_full=not fb.encoder_swa_replay,
+            floor=floor,
+            late_floor=late_floor,
+        )
+
+
+def _fake_init_new(replay, runner, **_):
