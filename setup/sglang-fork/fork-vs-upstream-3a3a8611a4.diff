index 0000000000..63bf52785e
--- /dev/null
+++ b/test/srt/sbr/test_b4_disconnect_large_body.py
@@ -0,0 +1,284 @@
+"""b4 - a client that hangs up after a large upload is seen gone on the first tick.
+
+Before its first output, ``TokenizerManager._stream_one_response`` waits on the
+request's event in ``_REQUEST_STATE_WAIT_TIMEOUT`` ticks and polls
+``request.is_disconnected()`` on each timeout. uvicorn's ``h11`` protocol pauses
+reading a connection once the buffered request body passes its 64 KiB
+high-water mark, and only a ``receive()`` resumes it. After a ~1 MB upload the
+endpoint's body read can end with reading still paused, so the client's FIN sits
+unread: the first poll's ``receive()`` only resumes reading and answers False,
+and the hang-up is seen one tick late while the request keeps queueing or
+prefilling. The loop now primes the poll once before the first wait, which
+resumes reading, so the first tick sees the FIN.
+
+These tests drive the real ``_stream_one_response`` from a FastAPI endpoint
+behind a real uvicorn ``h11`` server (uvloop when installed, as box-c serves),
+with a raw-socket client that uploads the body and then does
+``shutdown(SHUT_RDWR)`` -- abort-probe's sever. The tick is shortened to
+``TICK`` seconds; nothing ever sets the event, as for a request still queued or
+prefilling.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import queue
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+fastapi = pytest.importorskip("fastapi")
+uvicorn = pytest.importorskip("uvicorn")
+pytest.importorskip("h11")
+from uvicorn.protocols.http import flow_control  # noqa: E402
+
+from sglang.srt.managers import tokenizer_manager as tm_mod  # noqa: E402
+
+TICK = 1.0
+LARGE_BODY_CHARS = 1_273_000  # abort-probe's ~300k-token prompt
+SMALL_BODY_CHARS = 20_000  # well under uvicorn's 64 KiB high-water mark
+LARGE_BODY_ATTEMPTS = 3
+
+# The client runs in its own interpreter, as abort-probe does, so its send
+# pattern is not shaped by this process's GIL.
+_CLIENT = r"""
+import json, socket, sys, time
+port, nchars, close_after = int(sys.argv[1]), int(sys.argv[2]), float(sys.argv[3])
+headers = sys.argv[4]
+payload = json.dumps({"model": "m", "stream": True,
+                      "messages": [{"role": "user", "content": "x" * nchars}]}).encode()
+head = ("POST /v1/chat/completions HTTP/1.1\r\nHost: 127.0.0.1\r\n"
+        "Content-Type: application/json\r\n" + headers +
+        "Content-Length: %d\r\n\r\n" % len(payload)).encode()
+s = socket.create_connection(("127.0.0.1", port))
+t0 = time.monotonic()
+s.sendall(head + payload)
+time.sleep(max(0.0, close_after - (time.monotonic() - t0)))
+s.shutdown(socket.SHUT_RDWR)
+s.close()
+"""
+
+
+class _ReadingProbe:
+    """Tracks whether uvicorn's flow control has the transport's reading paused."""
+
+    def __init__(self):
+        self.paused = False
+        self._orig_pause = flow_control.FlowControl.pause_reading
+        self._orig_resume = flow_control.FlowControl.resume_reading
+
+    def install(self):
+        probe = self
+
+        def pause_reading(flow):
+            probe.paused = True
+            probe._orig_pause(flow)
+
+        def resume_reading(flow):
+            probe.paused = False
+            probe._orig_resume(flow)
+
+        flow_control.FlowControl.pause_reading = pause_reading
+        flow_control.FlowControl.resume_reading = resume_reading
+
+    def uninstall(self):
+        flow_control.FlowControl.pause_reading = self._orig_pause
+        flow_control.FlowControl.resume_reading = self._orig_resume
+
+
+def _tokenizer_manager():
+    tm = tm_mod.TokenizerManager.__new__(tm_mod.TokenizerManager)
+    tm.abort_request = mock.MagicMock(name="abort_request")
+    return tm
+
+
+def _build_app(probe: _ReadingProbe, results: "queue.Queue[dict]"):
+    app = fastapi.FastAPI()
+
+    @app.post("/v1/chat/completions")
+    async def chat(request: fastapi.Request):
+        body = await request.json()  # the full body read, as the chat endpoint does
+        paused_after_body = probe.paused
+        # Lets a test have the client gone before the loop starts.
+        await asyncio.sleep(float(request.headers.get("x-settle", "0")))
+
+        polls = []
+        t0 = time.monotonic()
+        is_disconnected = request.is_disconnected
+
+        async def recorded_is_disconnected():
+            gone = await is_disconnected()
+            polls.append((time.monotonic() - t0, gone))
+            return gone
+
+        request.is_disconnected = recorded_is_disconnected
+
+        tm = _tokenizer_manager()
+        rid = request.headers["x-rid"]
+        obj = SimpleNamespace(rid=rid, background=False, stream=True)
+        state = SimpleNamespace(event=asyncio.Event())  # never set: still queued
+        error = None
+        try:
+            async for _ in tm._stream_one_response(
+                obj=obj, state=state, request=request
+            ):
+                pass
+        except ValueError as e:
+            error = str(e)
+        results.put(
+            {
+                "rid": rid,
+                "chars": len(body["messages"][0]["content"]),
+                "paused_after_body": paused_after_body,
+                "polls": polls,
+                "error": error,
+                "aborts": [c.args for c in tm.abort_request.call_args_list],
+                "elapsed": time.monotonic() - t0,
+            }
+        )
+        return {"ok": True}
+
+    return app
+
+
+@pytest.fixture(scope="module")
+def server():
+    probe = _ReadingProbe()
+    probe.install()
+    results: "queue.Queue[dict]" = queue.Queue()
+    loop = "uvloop" if importlib.util.find_spec("uvloop") else "asyncio"
+    config = uvicorn.Config(
+        _build_app(probe, results),
+        host="127.0.0.1",
+        port=0,
+        loop=loop,
+        http="h11",
+        log_level="warning",
+        lifespan="off",
+    )
+    srv = uvicorn.Server(config)
+    thread = threading.Thread(target=srv.run, name="uvicorn-h11", daemon=True)
+    with mock.patch.object(tm_mod, "_REQUEST_STATE_WAIT_TIMEOUT", TICK):
+        thread.start()
+        deadline = time.monotonic() + 10
+        while not srv.started:
+            assert thread.is_alive() and time.monotonic() < deadline, "uvicorn did not start"
+            time.sleep(0.02)
+        port = srv.servers[0].sockets[0].getsockname()[1]
+        try:
+            yield SimpleNamespace(port=port, results=results)
+        finally:
+            srv.should_exit = True
+            thread.join(timeout=10)
+            probe.uninstall()
+
+
+def _hang_up(server, rid, *, chars, close_after, settle=0.0) -> dict:
+    headers = f"X-Rid: {rid}\r\nX-Settle: {settle}\r\n"
+    client = subprocess.Popen(
+        [
+            sys.executable,
+            "-I",
+            "-c",
+            _CLIENT,
+            str(server.port),
+            str(chars),
+            str(close_after),
+            headers,
+        ]
+    )
+    try:
+        result = server.results.get(timeout=settle + 6 * TICK + 10)
+    finally:
+        client.wait(timeout=10)
+    assert client.returncode == 0
+    assert result["rid"] == rid and result["chars"] == chars
+    return result
+
+
+def _assert_aborted(result, rid):
+    assert result["error"] is not None and "(type 1)" in result["error"], result
+    assert result["aborts"] == [(rid,)], result
+
+
+def test_large_body_hangup_is_seen_on_the_first_tick(server):
+    # Whether a loopback upload ends with reading paused depends on how the
+    # final read splits; retry until it does, since only then is the old loop
+    # one tick late.
+    for attempt in range(LARGE_BODY_ATTEMPTS):
+        rid = f"large-{attempt}"
+        result = _hang_up(server, rid, chars=LARGE_BODY_CHARS, close_after=0.3 * TICK)
+        if result["paused_after_body"]:
+            break
+    else:
+        pytest.fail(
+            f"uvicorn's reading never ended paused after a {LARGE_BODY_CHARS}-char "
+            f"upload in {LARGE_BODY_ATTEMPTS} attempts; the case proved nothing: {result}"
+        )
+
+    _assert_aborted(result, rid)
+    (prime_t, prime_gone), (tick_t, tick_gone) = result["polls"]
+    # The priming poll runs before any wait and finds the client still there;
+    # its receive() resumed reading, so the FIN is read during the first wait.
+    assert prime_gone is False and prime_t < 0.25 * TICK, result
+    # The first tick sees the hang-up. Unprimed, this poll answered False and
+    # the abort came at the second tick, ~2 * TICK.
+    assert tick_gone is True and 0.9 * TICK <= tick_t < 1.5 * TICK, result
+
+
+def test_small_body_hangup_is_seen_on_the_first_tick(server):
+    # A body under the high-water mark never pauses reading: the FIN is read
+    # as it arrives and the first tick saw it before the fix too. The priming
+    # poll changes nothing here: it only adds one non-blocking False before
+    # the wait, and the abort lands on the same first tick as without it.
+    rid = "small"
+    result = _hang_up(server, rid, chars=SMALL_BODY_CHARS, close_after=0.3 * TICK)
+
+    assert result["paused_after_body"] is False, result
+    _assert_aborted(result, rid)
+    before_wait = [p for p in result["polls"] if p[0] < 0.25 * TICK]
+    ticks = [p for p in result["polls"] if p[0] >= 0.25 * TICK]
+    assert [gone for _, gone in before_wait] in ([], [False]), result
+    assert len(ticks) == 1, result
+    (tick_t, tick_gone) = ticks[0]
+    assert tick_gone is True and 0.9 * TICK <= tick_t < 1.5 * TICK, result
+
+
+def test_client_gone_before_the_wait_is_aborted_without_a_tick(server):
+    # The client is gone, and its FIN already read, before the loop starts:
+    # the priming poll sees it and aborts at once instead of a tick later.
+    rid = "gone-early"
+    result = _hang_up(
+        server, rid, chars=SMALL_BODY_CHARS, close_after=0.1, settle=0.6
+    )
+
+    _assert_aborted(result, rid)
+    assert [gone for _, gone in result["polls"]] == [True], result
+    assert result["elapsed"] < 0.5 * TICK, result
+
+
+def test_background_request_is_never_polled():
+    # Background responses (OpenAI responses API) outlive their HTTP client:
+    # neither the priming poll nor a tick's poll may touch the request.
+    async def run():
+        tm = _tokenizer_manager()
+        request = mock.MagicMock()
+        request.is_disconnected = mock.AsyncMock(return_value=True)
+        obj = SimpleNamespace(rid="bg", background=True, stream=True)
+        state = SimpleNamespace(event=asyncio.Event())
+        gen = tm._stream_one_response(obj=obj, state=state, request=request)
+        with mock.patch.object(tm_mod, "_REQUEST_STATE_WAIT_TIMEOUT", 0.05):
+            with pytest.raises(asyncio.TimeoutError):
+                await asyncio.wait_for(gen.__anext__(), timeout=0.3)
+        await gen.aclose()
+        return tm, request
+
+    tm, request = asyncio.run(run())
+    assert request.is_disconnected.await_count == 0
+    tm.abort_request.assert_not_called()
diff --git a/test/srt/sbr/test_c_anthropic_abort_error.py b/test/srt/sbr/test_c_anthropic_abort_error.py
new file mode 100644
index 0000000000..80203083ec
--- /dev/null
+++ b/test/srt/sbr/test_c_anthropic_abort_error.py
@@ -0,0 +1,308 @@
+"""#186 (c): an aborted generation is an ``event: error``, never ``end_turn``.
+
+``finish_reason='abort'`` means the generation was cut short (graceful abort
+via ``/abort_request`` or a router-side cancel); it is not a stop reason.
+Before this change the Anthropic facade pushed it through
+``STOP_REASON_MAP.get(..., "end_turn")``, so a truncated generation was
+reported to the client as a clean finish on both paths:
+
+* streaming -- a ``message_delta`` carrying ``stop_reason='end_turn'``;
+* non-streaming -- HTTP 200 whose ``stop_reason`` said ``end_turn``.
+
+Both now answer with an Anthropic ``api_error``: the streaming path ends
+``content_block_stop`` -> ``error`` -> ``message_stop``, the non-streaming
+path returns the error envelope with HTTP 500.
+
+The stream fixtures are raw OpenAI SSE lines -- the exact wire form
+``OpenAIServingChat._generate_chat_stream`` yields -- so the test drives the
+real parse path (``ChatCompletionStreamResponse.model_validate_json``), not a
+reconstruction of it.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+from types import SimpleNamespace
+
+from fastapi.responses import JSONResponse
+
+from sglang.srt.entrypoints.anthropic.protocol import AnthropicMessagesRequest
+from sglang.srt.entrypoints.anthropic.serving import AnthropicServing
+from sglang.srt.entrypoints.openai.protocol import (
+    ChatCompletionRequest,
+    ChatCompletionResponse,
+)
+
+LOGGER_NAME = "sglang.srt.entrypoints.anthropic.serving"
+ABORT_MESSAGE = "Generation aborted before completion"
+USAGE = {"prompt_tokens": 5, "completion_tokens": 3, "total_tokens": 8}
+
+
+class _FakeOpenAIServingChat:
+    """Minimal stand-in for ``OpenAIServingChat``.
+
+    ``_generate_chat_stream`` yields the canned SSE lines verbatim and
+    ``_handle_non_streaming_request`` hands back a canned
+    ``ChatCompletionResponse`` -- the two seams the Anthropic facade consumes.
+    ``tokenizer_manager`` carries no chat template, so the facade treats
+    inline system messages as unsupported and never renders a template.
+    """
+
+    def __init__(self, stream_lines=None, non_streaming_response=None):
+        self.stream_lines = list(stream_lines or [])
+        self.non_streaming_response = non_streaming_response
+        self.tokenizer_manager = SimpleNamespace(
+            tokenizer=SimpleNamespace(chat_template=None)
+        )
+        # Upstream's facade reads the renderer's inline-system support off the
+        # chat serving object instead of probing the chat template.
+        self.supports_inline_system = False
+
+    def _generate_chat_stream(self, adapted_request, processed_request, raw_request):
+        lines = list(self.stream_lines)
+
+        async def _gen():
+            for line in lines:
+                yield line
+
+        return _gen()
+
+    def _validate_request(self, chat_request):
+        return None
+
+    def _convert_to_internal_request(self, chat_request, raw_request):
+        return SimpleNamespace(), chat_request
+
+    async def _convert_to_internal_request_async(self, chat_request, raw_request):
+        return self._convert_to_internal_request(chat_request, raw_request)
+
+    async def _handle_non_streaming_request(
+        self, adapted_request, processed_request, raw_request
+    ):
+        return self.non_streaming_response
+
+
+def _serving(stream_lines=None, non_streaming_response=None):
+    return AnthropicServing(
+        _FakeOpenAIServingChat(stream_lines, non_streaming_response)
+    )
+
+
+def _chunk(delta, finish_reason=None, usage=None):
+    """One OpenAI chat-completion SSE line, exactly as served on the wire."""
+    data = {
+        "id": "chatcmpl-abort-test",
+        "object": "chat.completion.chunk",
+        "created": 0,
+        "model": "test-model",
+        "choices": [
+            {"index": 0, "delta": delta, "finish_reason": finish_reason},
+        ],
+    }
+    if usage is not None:
+        data["usage"] = usage
+    return f"data: {json.dumps(data)}\n\n"
+
+
+def _completion(finish_reason, content="partial answer"):
+    return ChatCompletionResponse.model_validate(
+        {
+            "id": "chatcmpl-abort-test",
+            "object": "chat.completion",
+            "created": 0,
+            "model": "test-model",
+            "choices": [
+                {
+                    "index": 0,
+                    "message": {"role": "assistant", "content": content},
+                    "finish_reason": finish_reason,
+                }
+            ],
+            "usage": dict(USAGE),
+        }
+    )
+
+
+def _anthropic_request(stream=True):
+    return AnthropicMessagesRequest.model_validate(
+        {
+            "model": "test-model",
+            "max_tokens": 16,
+            "messages": [{"role": "user", "content": "hello"}],
+            "stream": stream,
+        }
+    )
+
+
+def _chat_request():
+    return ChatCompletionRequest.model_validate(
+        {
+            "model": "test-model",
+            "messages": [{"role": "user", "content": "hello"}],
+        }
+    )
+
+
+def _collect_frames(serving, request):
+    """Drain the Anthropic SSE generator, keeping the raw frames."""
+    frames = []
+
+    async def _drain():
+        async for frame in serving._generate_anthropic_stream(
+            adapted_request=object(),
+            processed_request=object(),
+            anthropic_request=request,
+            raw_request=object(),
+        ):
+            frames.append(frame)
+
+    asyncio.run(_drain())
+    return frames
+
+
+def _events(frames):
+    events = []
+    for frame in frames:
+        for line in frame.splitlines():
+            if line.startswith("data: "):
+                events.append(json.loads(line[6:]))
+    return events
+
+
+def _types(events):
+    return [event["type"] for event in events]
+
+
+def _abort_stream_lines():
+    """A real abort shape: two content deltas, then the abort chunk."""
+    return [
+        _chunk({"role": "assistant", "content": "The ans"}),
+        _chunk({"content": "wer is"}),
+        _chunk({}, finish_reason="abort", usage=dict(USAGE)),
+        "data: [DONE]\n\n",
+    ]
+
+
+def test_streaming_abort_emits_error_event_not_end_turn(caplog):
+    with caplog.at_level(logging.WARNING, logger=LOGGER_NAME):
+        frames = _collect_frames(_serving(_abort_stream_lines()), _anthropic_request())
+    events = _events(frames)
+    types = _types(events)
+
+    # A real error, then a close -- never a clean stop.
+    assert "error" in types
+    assert "message_stop" in types
+    assert types.index("error") < types.index("message_stop")
+    assert "message_delta" not in types
+
+    error_event = next(event for event in events if event["type"] == "error")
+    assert error_event["error"]["type"] == "api_error"
+    assert error_event["error"]["message"] == ABORT_MESSAGE
+
+    # The abort must be indistinguishable from a clean stop nowhere on the
+    # wire: no end_turn, no stop_reason at all.
+    wire = "".join(frames)
+    assert "end_turn" not in wire
+    assert "stop_reason" not in wire
+
+    # The partially streamed text block is closed before the error so strict
+    # SDK parsers never see an unterminated content_block_start.
+    assert "content_block_stop" in types
+    assert types.index("content_block_stop") < types.index("error")
+
+    # The SDK dispatches on the SSE event name, not only the JSON body.
+    assert any(frame.startswith("event: error\n") for frame in frames)
+
+    # And the operator keeps the abort signal in the logs.
+    messages = [record.getMessage() for record in caplog.records]
+    assert any("abort" in message.lower() for message in messages), messages
+
+
+def test_streaming_abort_before_any_content_still_errors():
+    lines = [_chunk({}, finish_reason="abort"), "data: [DONE]\n\n"]
+    frames = _collect_frames(_serving(lines), _anthropic_request())
+    events = _events(frames)
+
+    assert _types(events) == ["message_start", "error", "message_stop"]
+    assert "end_turn" not in "".join(frames)
+    assert events[1]["error"]["type"] == "api_error"
+
+
+def test_streaming_stop_still_yields_end_turn():
+    lines = [
+        _chunk({"role": "assistant", "content": "hi"}),
+        _chunk({"content": " there"}),
+        _chunk({}, finish_reason="stop", usage=dict(USAGE)),
+        "data: [DONE]\n\n",
+    ]
+    frames = _collect_frames(_serving(lines), _anthropic_request())
+    events = _events(frames)
+    types = _types(events)
+
+    assert "error" not in types
+    assert types[-1] == "message_stop"
+    delta = next(event for event in events if event["type"] == "message_delta")
+    assert delta["delta"]["stop_reason"] == "end_turn"
+    assert delta["usage"]["output_tokens"] == 3
+
+
+def test_streaming_content_filter_still_falls_through_to_end_turn(caplog):
+    """Only ``abort`` takes the error path; the old fall-through is unchanged."""
+    lines = [
+        _chunk({"role": "assistant", "content": "hi"}),
+        _chunk({}, finish_reason="content_filter"),
+        "data: [DONE]\n\n",
+    ]
+    with caplog.at_level(logging.WARNING, logger=LOGGER_NAME):
+        frames = _collect_frames(_serving(lines), _anthropic_request())
+    events = _events(frames)
+
+    assert "error" not in _types(events)
+    delta = next(event for event in events if event["type"] == "message_delta")
+    assert delta["delta"]["stop_reason"] == "end_turn"
+    messages = [record.getMessage() for record in caplog.records]
+    assert any("content_filter" in message for message in messages), messages
+
+
+def test_non_streaming_abort_returns_500_api_error(caplog):
+    with caplog.at_level(logging.WARNING, logger=LOGGER_NAME):
+        result = _serving()._convert_response(_completion("abort"))
+
+    assert isinstance(result, JSONResponse)
+    assert result.status_code == 500
+    assert json.loads(result.body) == {
+        "type": "error",
+        "error": {"type": "api_error", "message": ABORT_MESSAGE},
+    }
+    assert b"end_turn" not in result.body
+    messages = [record.getMessage() for record in caplog.records]
+    assert any("abort" in message.lower() for message in messages), messages
+
+
+def test_non_streaming_abort_reaches_http_response():
+    """The envelope survives the whole handler, not just the converter."""
+    serving = _serving(non_streaming_response=_completion("abort"))
+    result = asyncio.run(
+        serving._handle_non_streaming(
+            _chat_request(), _anthropic_request(stream=False), object()
+        )
+    )
+
+    assert isinstance(result, JSONResponse)
+    assert result.status_code == 500
+    payload = json.loads(result.body)
+    assert payload["type"] == "error"
+    assert payload["error"]["type"] == "api_error"
+    assert payload["error"]["message"] == ABORT_MESSAGE
+
+
+def test_non_streaming_stop_unchanged(caplog):
+    with caplog.at_level(logging.WARNING, logger=LOGGER_NAME):
+        result = _serving()._convert_response(_completion("stop", content="done"))
+
+    assert not isinstance(result, JSONResponse)
+    assert result.stop_reason == "end_turn"
+    assert [block.text for block in result.content] == ["done"]
+    assert not [record for record in caplog.records if "abort" in record.getMessage()]
