+    with mock.patch.object(tm_module, "async_sock_recv", socket):
+        with pytest.raises(_Stop):
+            await tm.handle_loop()
+    assert seen == [(None,)]
+
+
+async def test_off_the_api_path_logs_no_line_and_keeps_no_stamps(timer, caplog):
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    tm = _tokenizer_manager()
+    states = []
+    orig = tm._init_req_state
+
+    def keep_state(o, request=None):
+        orig(o, request)
+        states.append(tm.rid_to_state[RID])
+
+    tm._init_req_state = keep_state
+    obj = _generate_obj(ids=True, received_time=time.perf_counter())
+    await _drive_generate(tm, obj)
+    assert states[0].sbr_api is None
+    assert [r for r in caplog.records if r.name == LOGGER_NAME] == []
+
+
+async def test_gate_closed_api_path_logs_nothing_then_follows_the_gate(gate, caplog):
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    await _drive_generate(
+        _tokenizer_manager(), _generate_obj(ids=True, rid="closed")
+    )
+    assert _lines(caplog, "sbr-phase-api") == []
+    gate.path.write_text("")
+    gate.clock.now += 2.0
+    await _drive_generate(_tokenizer_manager(), _generate_obj(ids=True, rid="open"))
+    assert [API_RE.match(x)["rid"] for x in _lines(caplog, "sbr-phase-api")] == ["open"]
+
+
+# --- handle_request: the pre-rid stamps -------------------------------------------
+
+
+def _chat_serving():
+    serving = init_chat_serving_defaults(OpenAIServingChat.__new__(OpenAIServingChat))
+    manager = mock.MagicMock()
+    manager.request_logger.log_requests = False
+    serving.tokenizer_manager = manager
+    return serving
+
+
+async def _handle(serving, adapted, *, stream=False):
+    request = SimpleNamespace(stream=stream)
+
+    async def convert(req, raw):
+        await asyncio.sleep(0.001)
+        return adapted, request
+
+    async def handler(*args):
+        return SimpleNamespace(headers={})
+
+    serving._validate_request = lambda req: time.sleep(0.001) or None
+    serving._convert_to_internal_request_async = convert
+    serving._handle_non_streaming_request = handler
+    serving._handle_streaming_request = handler
+    return await serving.handle_request(request, None)
+
+
+async def test_on_handle_request_puts_the_pre_rid_stamps_on_the_adapted_request(detail):
+    adapted = GenerateReqInput(input_ids=[1, 2], rid="h1", sampling_params={})
+    t0 = time.perf_counter()
+    await _handle(_chat_serving(), adapted)
+    t1 = time.perf_counter()
+    pre = getattr(adapted, spt.PRE_ATTR)
+    assert set(pre) == {"validate_request_done", "convert_done"}
+    # received_time (= recv) <= validate_request_done <= convert_done, inside the call.
+    assert t0 <= adapted.received_time
+    assert adapted.received_time <= pre["validate_request_done"]
+    assert pre["validate_request_done"] <= pre["convert_done"] <= t1
+    # A plain attribute: not a dataclass field, not in the asdict a dump would write.
+    assert spt.PRE_ATTR not in _field_names(GenerateReqInput)
+    assert spt.PRE_ATTR not in dataclasses.asdict(adapted)
+
+
+async def test_off_handle_request_leaves_the_adapted_request_alone(timer):
+    adapted = GenerateReqInput(input_ids=[1, 2], rid="h2", sampling_params={})
+    await _handle(_chat_serving(), adapted)
+    assert spt.PRE_ATTR not in vars(adapted)
+    assert adapted.received_time is not None  # the request's own behaviour is unchanged
+
+
+async def test_on_handle_request_stamps_nothing_for_a_validation_failure(detail):
+    serving = _chat_serving()
+    serving._validate_request = lambda req: "bad request"
+    adapted = GenerateReqInput(input_ids=[1], rid="h3", sampling_params={})
+    response = await serving.handle_request(SimpleNamespace(stream=False), None)
+    assert response.status_code == 400  # the error response, as before
+    assert spt.PRE_ATTR not in vars(adapted)
