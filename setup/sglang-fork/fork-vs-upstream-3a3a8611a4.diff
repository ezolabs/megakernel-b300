+# Upstream #43006 (2026-10-12, "honor tool_choice=none in DeepSeek encoders") leaves
+# the tools out of the prompt on tool_choice "none"; the router renders the same from
+# f6391bfce (box-d only: box-c-orig's engine still lists them), so every body is in parity.
+TOOL_CHOICE_NONE = ("tool-short-01/none", "thinking-tool-01/none")
+# The forced chat-mode tool calls (#121): their recipe-parity prompt ends inside an opened
+# calls block, and the router posts them on the messages path, never as ids
+# (``_posted_on_the_messages_path``). The required/named thinking bodies are not here: a
+# forced call in thinking mode renders no opener.
+MESSAGES_PATH = (
+    "tool-short-01/required",
+    "tool-short-01/named",
+    "toolnull/null-schema-required",
+    "toolnull/null-schema-named",
