+"""HiCache's event poll runs its TP reduction only when TP rank 0 has a ready ack.
+
+``check_hicache_events`` MIN-reduces each rank's ready-ack counts across the
+TP group on every scheduler step, a CPU rendezvous per step even when every
+queue is empty. Part 0032 sends TP rank 0's "something is ready" bit on the
+request broadcast (``broadcast_pyobj_with_flag``) and runs the reduction only
+on a step that received it, plus a heartbeat for the digest assert
+(``hicache_poll_gate.py``).
+
+The 8-process test drives the real receiver and the real poll on a CPU gloo
+group (``hicache_poll_lockstep_worker.py``): readiness fixed within a step,
+acks that become ready between the broadcast and the poll, receives skipped
+by the real recv skipper, and the real input blocker. One test runs the real
+``Scheduler.__init__`` (its components stubbed) to pin where the gate is
+armed; the rest drives the pieces directly.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+WORLD = 8
+WORKER = os.path.join(HERE, "hicache_poll_lockstep_worker.py")
+RUN_TIMEOUT_S = 240
+
+
+# ---------------------------------------------------------------------------
+# The 8-rank run
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture(scope="module")
+def ranks():
+    """Launch the 8 ranks once; returns {scenario name: [rank 0..7 result]}."""
+    with tempfile.TemporaryDirectory(prefix="sbr-0032-") as tmp:
+        store = os.path.join(tmp, "store")
+        env = dict(os.environ)
+        env.setdefault(
+            "GLOO_SOCKET_IFNAME", "lo0" if sys.platform == "darwin" else "lo"
+        )
+        env["PYTHONDONTWRITEBYTECODE"] = "1"
+        python_dir = os.path.abspath(os.path.join(HERE, "..", "..", "..", "python"))
+        env["PYTHONPATH"] = os.pathsep.join(
+            [python_dir, HERE] + [p for p in [env.get("PYTHONPATH")] if p]
+        )
+        procs = []
+        for rank in range(WORLD):
+            log = open(os.path.join(tmp, f"rank{rank}.log"), "w")
+            procs.append(
+                (
+                    subprocess.Popen(
+                        [sys.executable, WORKER, str(rank), str(WORLD), store, tmp],
+                        env=env,
+                        stdout=log,
+                        stderr=subprocess.STDOUT,
+                    ),
+                    log,
+                )
+            )
+        deadline = time.monotonic() + RUN_TIMEOUT_S
+        hung = False
+        for proc, _ in procs:
+            try:
+                proc.wait(timeout=max(1.0, deadline - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                hung = True
+        for proc, log in procs:
+            if proc.poll() is None:
+                proc.kill()
+                proc.wait()
+            log.close()
+        codes = [proc.returncode for proc, _ in procs]
+        if hung or any(codes):
+            tails = []
+            for rank in range(WORLD):
+                with open(os.path.join(tmp, f"rank{rank}.log")) as f:
+                    tails.append(
+                        f"--- rank {rank} (exit {codes[rank]}) ---\n" + f.read()[-1500:]
+                    )
+            pytest.fail(
+                (
+                    "ranks hung: a collective was not called on every rank\n"
+                    if hung
+                    else ""
+                )
+                + "\n".join(tails)
+            )
+        per_rank = []
+        for rank in range(WORLD):
+            with open(os.path.join(tmp, f"rank{rank}.json")) as f:
+                per_rank.append(json.load(f))
+    return {
+        scenario["name"]: [per_rank[r][i] for r in range(WORLD)]
+        for i, scenario in enumerate(per_rank[0])
+    }
+
+
+def _iterations_of(results, kind):
+    return [k for k, kinds in results[0]["kinds"] if kind in kinds.split("+")]
+
+
+def test_every_rank_runs_the_same_collectives_in_the_same_order(ranks):
+    gated = ranks["gated"]
+    assert all(r["armed"] for r in gated)
+    # The scripted loop covers every kind of step, the same on every rank.
+    for kind in ("idle", "prefill", "decode", "abort"):
+        assert _iterations_of(gated, kind), kind
+    for r in gated[1:]:
+        assert r["kinds"] == gated[0]["kinds"]
+        assert r["received"] == gated[0]["received"]
+    # The ranks' local ack readiness really does disagree...
+    disagree = sum(
+        1
+        for i in range(len(gated[0]["checks"]))
+        if len({tuple(r["checks"][i][2]) for r in gated}) > 1
+    )
+    assert disagree > 50
+    # ...and still every rank called the same collectives, step for step.
+    for r in gated[1:]:
+        assert r["trace"] == gated[0]["trace"]
+    for r in ranks["ungated"][1:]:
+        assert r["trace"] == ranks["ungated"][0]["trace"]
+
+
+def test_the_reduction_runs_only_on_a_hinted_step_or_a_heartbeat(ranks):
+    gated, ungated = ranks["gated"][0], ranks["ungated"][0]
+    n_checks = len(gated["checks"])
+    assert n_checks == len(ungated["checks"]) == 420
+    # Ungated (SGLANG_HICACHE_POLL_ON_HINT=0): one reduction per step, as before.
+    assert not ungated["armed"]
+    assert sum(1 for t in ungated["trace"] if t[1] == "all_reduce") == n_checks
+    assert all(polled for _, polled, _, _ in ungated["checks"])
+    # Gated: a reduction only where TP rank 0's bit arrived, or the heartbeat.
+    hinted = {k for k, h in gated["hints"] if h}
+    assert len(gated["hints"]) == n_checks  # one bit per broadcast
+    polled = [k for k, p, _, _ in gated["checks"] if p]
+    reductions = sum(1 for t in gated["trace"] if t[1] == "all_reduce")
+    assert reductions == len(polled)
+    # This script issues an ack on almost every busy step (far denser than
+    # box-c's 10-17 backups/s), so the busy stretch polls often; the idle
+    # stretches poll only on the heartbeat.
+    assert 0 < len(polled) and n_checks - len(polled) >= 100
+    calls_since = 0
+    for k, p, _, _ in gated["checks"]:
+        calls_since += 1
+        if k in hinted or calls_since >= 64:
+            assert p, k
+            calls_since = 0
+        else:
+            assert not p, k
+    # The bit rides the size header: same broadcasts, one more int each.
+    b_gated = [t for t in gated["trace"] if t[1] == "broadcast"]
+    b_ungated = [t for t in ungated["trace"] if t[1] == "broadcast"]
+    assert len(b_gated) == len(b_ungated)
+    assert [t[2] for t in b_gated if t[3] == "torch.int64"] == [
+        [2] for t in b_ungated if t[3] == "torch.int64"
+    ]
+
+
+def test_a_skipped_poll_would_have_drained_nothing(ranks):
+    gated = ranks["gated"]
+    for i, (k, polled, _, n_drained) in enumerate(gated[0]["checks"]):
+        mins = [min(r["checks"][i][2][q] for r in gated) for q in (0, 1)]
+        if polled:
+            # A poll drains exactly the MIN across ranks (writes + loads).
+            assert all(r["checks"][i][3] == sum(mins) for r in gated), k
+        else:
+            assert mins == [0, 0], k
+            assert all(r["checks"][i][3] == 0 for r in gated), k
+
+
+EMPTY = {
+    "write_queue": 0,
+    "load_queue": 0,
+    "ongoing_write_through": 0,
+    "ongoing_load_back": 0,
+}
+
+
+def _drain_steps(result):
+    return {ack: k for k, _, ack in result["drained"]}
+
+
+def test_with_readiness_fixed_within_a_step_every_ack_drains_on_the_per_step_polls_step(
+    ranks,
+):
+    gated, ungated = ranks["gated"], ranks["ungated"]
+    issued = gated[0]["issued"]
+    assert len(issued) > 100
+    assert {i[1] for i in issued} == {"write", "load"}
+    # In this run an ack becomes ready only at the start of a step, before the
+    # broadcast (phase 0), so rank 0's bit already sees it. The case where it
+    # becomes ready between the broadcast and the poll is the midstep run.
+    assert all(i[4] == 0 for r in gated for i in r["issued"])
+    for g, u in zip(gated, ungated):
+        assert g["drained"] == u["drained"]
+        assert sorted(a for _, _, a in g["drained"]) == sorted(i[2] for i in issued)
+        assert g["left"] == EMPTY
+    for r in gated[1:]:
+        assert r["drained"] == gated[0]["drained"]
+
+
+def test_an_ack_ready_between_the_broadcast_and_the_poll_drains_at_most_one_step_later(
+    ranks,
+):
+    gated, ungated = ranks["midstep_gated"], ranks["midstep_ungated"]
+    assert all(r["armed"] for r in gated)
+    assert not any(r["armed"] for r in ungated)
+    for runs in (gated, ungated):
+        for r in runs[1:]:
+            assert r["trace"] == runs[0]["trace"]
+    # On every rank, about half the acks become ready at phase 1: after that
+    # step's broadcast carried rank 0's bit, before the poll.
+    for r in gated:
+        assert sum(1 for i in r["issued"] if i[4] == 1) > 50
+    ack_ids = sorted(i[2] for i in gated[0]["issued"])
+    hint_at = {k: h for k, h in gated[0]["hints"]}
+    polled = {k for k, p, _, _ in gated[0]["checks"] if p}
+    delayed = set()
+    for g, u in zip(gated, ungated):
+        g_at, u_at = _drain_steps(g), _drain_steps(u)
+        assert sorted(g_at) == sorted(u_at) == ack_ids
+        for ack in ack_ids:
+            late = g_at[ack] - u_at[ack]
+            assert late in (0, 1), (ack, u_at[ack], g_at[ack])
+            if late:
+                # The per-step poll drained it on a step whose bit said "nothing
+                # ready on rank 0" (it became ready after the broadcast), so the
+                # gated poll skipped that step and drained it on the next.
+                assert hint_at[u_at[ack]] == 0 and u_at[ack] not in polled, ack
+                assert g_at[ack] in polled, ack
+                delayed.add(ack)
+        assert g["left"] == u["left"] == EMPTY
+    for r in gated[1:]:
+        assert r["drained"] == gated[0]["drained"]
+    # The one-step delay is exercised, not just allowed.
+    assert len(delayed) >= 10
+
+
+def test_a_step_whose_receive_is_skipped_polls_as_before(ranks):
+    gated, ungated = ranks["skipper_gated"], ranks["skipper_ungated"]
+    assert all(r["armed"] for r in gated)
+    for runs in (gated, ungated):
+        for r in runs[1:]:
+            assert r["trace"] == runs[0]["trace"]
+    g0 = gated[0]
+    n = len(g0["checks"])
+    # The real recv skipper (interval 3, no last batch) receives, and so
+    # broadcasts, on every third step only.
+    received = g0["broadcast_steps"]
+    assert received == list(range(2, n, 3))
+    assert ungated[0]["broadcast_steps"] == received
+    assert [k for k, _ in g0["hints"]] == received  # a bit only with a broadcast
+    polled = {k for k, p, _, _ in g0["checks"] if p}
+    skipped_receive = set(range(n)) - set(received)
+    # No broadcast, no bit: the step polls, as every step did before the gate.
+    assert skipped_receive <= polled
+    # Receives were skipped while an ack was ready on every rank, and that
+    # step's poll drained it.
+    ready_on_skip = 0
+    for i, (k, _, _, _) in enumerate(g0["checks"]):
+        mins = [min(r["checks"][i][2][q] for r in gated) for q in (0, 1)]
+        if k in skipped_receive and sum(mins) > 0:
+            ready_on_skip += 1
+            assert all(r["checks"][i][3] == sum(mins) for r in gated), k
+    assert ready_on_skip > 20
+    # So every ack drains on the step the per-step poll (with the same
+    # skipper) drained it; the received steps still skip without a bit.
+    for g, u in zip(gated, ungated):
+        assert g["drained"] == u["drained"]
+        assert g["left"] == EMPTY
+    assert polled != set(range(n))
+
+
+def test_the_input_blocker_does_not_stop_the_bit(ranks):
+    gated, ungated = ranks["blocker_gated"], ranks["blocker_ungated"]
+    assert all(r["armed"] for r in gated)
+    for runs in (gated, ungated):
+        for r in runs[1:]:
+            assert r["trace"] == runs[0]["trace"]
+    g0 = gated[0]
+    n = len(g0["checks"])
+    # Rank 0's real input blocker held requests back from BLOCK (step 150)
+    # until UNBLOCK (step 230) passed the unblock barrier.
+    blocked = [k for k, state in g0["blocker_states"] if state != "UNBLOCKED"]
+    assert blocked == list(range(150, 230))
+    assert all(not msgs for k, msgs in g0["received"] if 150 <= k < 230)
+    assert g0["received"][230][1]  # the held requests, released
+    # It holds requests, not the broadcast: every step carried a bit...
+    assert g0["broadcast_steps"] == list(range(n))
+    assert [k for k, _ in g0["hints"]] == list(range(n))
+    # ...including the blocked ones, whose hinted polls drained acks.
+    hinted_blocked = [k for k, h in g0["hints"] if h and 150 <= k < 230]
+    assert hinted_blocked
+    assert sum(g0["checks"][k][3] for k in hinted_blocked) > 0
+    for g, u in zip(gated, ungated):
+        assert g["drained"] == u["drained"]
+        assert g["left"] == EMPTY
+
