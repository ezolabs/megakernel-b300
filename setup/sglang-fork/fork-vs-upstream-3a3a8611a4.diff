+        assert encodes == 0
+
+
+@pytest.mark.parametrize("default", [0, 101])
+def test_a_server_default_effort_out_of_range_falls_back_to_message_order(
+    chat, default
+):
+    chat._encoding_adapter._default_effort = default
+    body = _thinking(OUT_OF_CALL_ORDER)
+    new, old, _ = _both(chat, body)
+    assert new == old == chat._message_image_urls(ChatCompletionRequest(**body))
+    assert new != [IMAGES[0], IMAGES[1], IMAGES[2], IMAGES[3]]
+
+
+@pytest.mark.parametrize("effort", NUMERIC_EFFORTS)
+def test_no_rendered_effort_line_falls_back_as_the_full_encode_does(
+    chat, monkeypatch, effort
+):
+    """The effort line recipe renders for its "high" tier is swapped for the request's
+    budget; a render without it is refused. With the line moved off what recipe
+    renders, both the token search and the render check refuse the request, so both
+    keep message order."""
+    body = _thinking(OUT_OF_CALL_ORDER, effort)
+    rendered_order, _, _ = _both(chat, body)
+    monkeypatch.setattr(deepseek_recipe_renderer, "BUDGET_TIER_VALUE", 31)
+    new, old, encodes = _both(chat, body)
+    message_order = chat._message_image_urls(ChatCompletionRequest(**body))
+    assert new == old == message_order != rendered_order
+    assert encodes == 0
+
+
+@pytest.mark.parametrize(
+    "user_text",
+    [
+        "hi",
+        "Reasoning Effort: 31",
+        "xReasoning Effort: 31x",
+        "Reasoning Effort: 310",
+        "Reasoning Effort: 3 1",
+        "a\nReasoning Effort: 31\nb",
+    ],
+)
+@pytest.mark.parametrize("tier_value", [75, 31])
+def test_the_effort_line_check_is_the_token_search(
+    tokenizer, monkeypatch, user_text, tier_value
+):
+    """``_renders_effort_line`` answers on the render what ``_replace_effort_budget``
+    answers on the prompt ids, whether the line is recipe's or the user's."""
+    monkeypatch.setattr(deepseek_recipe_renderer, "BUDGET_TIER_VALUE", tier_value)
+    recipe = DeepSeekRecipe.from_hf_tokenizer("dsv41", tokenizer)
+    body = {"messages": [{"role": "user", "content": user_text}], "thinking": True}
+    conversation, _, _ = recipe._prepare(
