+    def test_body_broken_after_the_header_ends_the_call_incomplete(self):
+        """The header cannot be retracted. A body that breaks after it went out
+        ends the call with the fragments already sent: never a JSON object, so
+        a client cannot run it. It is counted (broken_call_count, the audit's
+        `dropped`) and logged without argument text, and the next invoke is
+        still parsed."""
