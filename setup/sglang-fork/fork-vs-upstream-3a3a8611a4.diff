+        self.seeds: list = []  # the node's namespace seed (_namespace_seed)
+        self.lora_names: list = []
+        self.hashes: list = []  # the node's page-hash strings
+        self.raws: list = []  # the key's token buffer
+        self.lens: list = []  # the key's logical length
+        self.bigrams: list = []
+        self.salts: list = []
