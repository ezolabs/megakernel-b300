index 0000000000..f813e55a93
--- /dev/null
+++ b/test/srt/sbr/test_g_kv_events_config_forbid.py
@@ -0,0 +1,203 @@
+"""``--kv-events-config`` rejects unknown keys instead of silently ignoring them.
+
+Pydantic's default ``extra="ignore"`` dropped a mistyped key, so a config that
+misspelled ``endpoint`` started a server that happily bound the *default*
+endpoint: the operator's intent was never applied and nothing said so.
+``KVEventsConfig`` now sets ``extra="forbid"`` and ``from_cli`` re-raises
+pydantic's ``ValidationError`` as a ``ValueError`` naming the offending key(s),
+so the failure reads as a CLI error at startup (the original error is kept as
+``__cause__``).
+
+The call sites keep their established behaviour, which is why the stricter
+parse is safe: the startup dry-run fails loudly, while the scheduler
+subprocess keeps swallowing a bad config rather than dying on it. The last two
+tests pin that.
+"""
+
+from __future__ import annotations
+
+import json
+from unittest.mock import patch
+
+import pytest
+from pydantic import ValidationError
+
+from sglang.srt.disaggregation.kv_events import (
+    EventPublisherFactory,
+    KVEventsConfig,
+    NullEventPublisher,
+)
+
+# Every field of KVEventsConfig, each at a non-default value.
+GOOD = {
+    "publisher": "zmq",
+    "endpoint": "tcp://*:5557",
+    "replay_endpoint": "tcp://*:5558",
+    "buffer_steps": 32,
+    "hwm": 256,
+    "max_queue_size": 512,
+    "topic": "kv-events",
+}
+
+# The misspelling under test: one transposed letter in the endpoint key.
+TYPO_KEY = "endpiont"  # codespell:ignore endpiont
+TYPO = json.dumps({"publisher": "zmq", TYPO_KEY: "tcp://*:5557"})
+# A second, unrelated misspelling, for the "name every offending key" test.
+TYPO_KEY2 = "topicc"  # codespell:ignore topicc
+
+
+def _extra_keys(excinfo) -> set:
+    """Keys pydantic reported as extra, read off the preserved ``__cause__``."""
+    cause = excinfo.value.__cause__
+    assert isinstance(cause, ValidationError)
+    return {err["loc"][0] for err in cause.errors() if err["type"] == "extra_forbidden"}
+
+
+def test_valid_config_parses_every_field():
+    cfg = KVEventsConfig.from_cli(json.dumps(GOOD))
+
+    assert isinstance(cfg, KVEventsConfig)
+    # A full round-trip proves the model still accepts all seven documented
+    # keys: extra="forbid" must not have narrowed the schema. Upstream's later
+    # fields (bind, format) keep their own defaults.
+    assert cfg.model_dump() == {**KVEventsConfig().model_dump(), **GOOD}
+
+
+def test_partial_config_keeps_the_documented_defaults():
+    cfg = KVEventsConfig.from_cli('{"publisher": "zmq"}')
+
+    assert cfg.publisher == "zmq"
+    assert cfg.endpoint == "tcp://*:5557"
+    assert cfg.replay_endpoint is None
+    assert (cfg.buffer_steps, cfg.hwm, cfg.max_queue_size) == (10_000, 100_000, 100_000)
+    assert cfg.topic == ""
+
+
+def test_typo_key_raises_a_cli_value_error_naming_the_key():
+    with pytest.raises(ValueError) as excinfo:
+        KVEventsConfig.from_cli(TYPO)
+
+    # A plain ValueError, not pydantic's ValueError subclass: the CLI boundary
+    # is what surfaces it, and its message is what an operator reads.
+    assert type(excinfo.value) is ValueError
+    assert str(excinfo.value).startswith("--kv-events-config: ")
+    assert TYPO_KEY in str(excinfo.value)
+    assert _extra_keys(excinfo) == {TYPO_KEY}
+
+
+def test_every_offending_key_is_named():
+    with pytest.raises(ValueError) as excinfo:
+        KVEventsConfig.from_cli(
+            json.dumps({**GOOD, TYPO_KEY: "tcp://*:5557", TYPO_KEY2: "kv"})
+        )
+
+    # Only the two typos are reported: the seven valid keys are not implicated,
+    # so the operator sees exactly which keys to fix.
+    assert _extra_keys(excinfo) == {TYPO_KEY, TYPO_KEY2}
+    assert TYPO_KEY in str(excinfo.value) and TYPO_KEY2 in str(excinfo.value)
+
+
+def test_malformed_json_is_a_cli_value_error_too():
+    # model_validate_json reports invalid JSON as a ValidationError as well;
+    # from_cli's contract is "ValueError naming --kv-events-config", and every
+    # caller that catches Exception/ValueError keeps working either way.
+    with pytest.raises(ValueError) as excinfo:
+        KVEventsConfig.from_cli("{not json")
+
+    assert type(excinfo.value) is ValueError
+    assert "--kv-events-config: " in str(excinfo.value)
+    assert isinstance(excinfo.value.__cause__, ValidationError)
+
+
+def test_model_itself_forbids_unknown_kwargs():
+    # Not only the JSON path: the model cannot smuggle an unknown key in when
+    # constructed directly either.
+    with pytest.raises(ValidationError):
+        KVEventsConfig(publisher="zmq", **{TYPO_KEY: "tcp://*:5557"})
+
+
+def test_factory_create_rejects_the_typo_before_constructing_a_publisher():
+    constructed = []
+    fake_registry = {"zmq": lambda **kwargs: constructed.append(kwargs)}
+
+    with patch.dict(EventPublisherFactory._registry, fake_registry):
+        with pytest.raises(ValueError) as excinfo:
+            EventPublisherFactory.create(TYPO)
+
+    assert TYPO_KEY in str(excinfo.value)
+    # Nothing was constructed: no ZMQ context, no bind, no publisher thread for
+    # a config the operator has to fix anyway.
+    assert constructed == []
+
+
+def test_factory_create_without_config_is_still_null():
+    assert isinstance(EventPublisherFactory.create(None), NullEventPublisher)
+    assert isinstance(EventPublisherFactory.create(""), NullEventPublisher)
+
+
+def test_load_publisher_stays_a_no_op_on_a_bad_config():
+    # The scheduler subprocess must not die on a config the startup dry-run
+    # already rejected: SchedulerLoadPublisher swallows it and publishes
+    # nothing, exactly as before the config became strict.
+    from sglang.srt.managers.scheduler_components.load_publisher import (
+        SchedulerLoadPublisher,
+    )
+    from sglang.srt.runtime_context import get_parallel
+
+    # Upstream gates the publisher on the runtime context's ranks (rank 0 here).
+    with get_parallel().override(
+        pp_rank=0, attn_tp_rank=0, attn_cp_rank=0
+    ), patch(
+        "sglang.srt.managers.scheduler_components.load_publisher._open_pub_socket"
+    ) as open_sock:
+        pub = SchedulerLoadPublisher(
+            kv_events_config=TYPO,
+            load_publish_endpoint="auto",
+        )
+
+    assert pub._socket is None
+    open_sock.assert_not_called()
+
+
+def test_server_info_advertisement_degrades_to_nothing_on_a_typo():
+    # /server_info must keep answering on a running server, so its reader
+    # swallows a bad config and advertises "no publisher" instead of raising.
+    # This is why a stricter parse cannot take the endpoint down with it.
+    from sglang.srt.runtime_context import describe_kv_events_publisher
+    from sglang.srt.server_args import ServerArgs
+
+    typo_args = ServerArgs(
+        model_path="dummy", kv_events_config=TYPO, page_size=64, dp_size=2
+    )
+    assert describe_kv_events_publisher(typo_args) is None
+
+    good_args = ServerArgs(
+        model_path="dummy",
+        kv_events_config=json.dumps({**GOOD, "endpoint": "tcp://*:5557"}),
+        page_size=64,
+        dp_size=2,
+    )
+    advertised = describe_kv_events_publisher(good_args)
+    # Positive control: the same path still advertises a good config, so the
+    # None above means "rejected", not "the helper never worked".
+    assert advertised is not None
+    assert advertised["publisher"] == "zmq"
+    assert (advertised["endpoint_host"], advertised["endpoint_port_base"]) == ("*", 5557)
+
+
+def test_startup_dry_run_reports_the_typo():
+    from sglang.srt.arg_groups.validation_hook import check_load_publish_args
+    from sglang.srt.server_args import ServerArgs
+
+    args = ServerArgs(
+        model_path="dummy",
+        kv_events_config=TYPO,
+        load_publish_endpoint="auto",
+    )
+
+    with pytest.raises(ValueError) as excinfo:
+        check_load_publish_args(args)
+
+    msg = str(excinfo.value)
+    assert "--kv-events-config is not parseable" in msg
+    assert TYPO_KEY in msg
diff --git a/test/srt/sbr/test_h_kv_events_tagged_maps.py b/test/srt/sbr/test_h_kv_events_tagged_maps.py
