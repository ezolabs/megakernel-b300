+        """Capture what ``record_snapshot`` would announce, without rendering it.
+
+        The walk ``record_snapshot`` describes (the device pass, then the host
+        pass), stopped short of building events: each announced node becomes
+        one row of the ``SnapshotCut``'s columns. This is the only part of a snapshot that
+        reads the tree, so it is the only part that must run where the tree is
+        consistent -- on the scheduler loop, between steps. Hashes the tree
+        has not memoized yet are computed and memoized here, as the store path
+        would.
+
+        Returns:
+            The cut; ``None`` when events are disabled.
+        """
+        if not self.enabled:
+            return None
+        if medium is None:
+            medium = StorageMedium.GPU
+        page_size = self.page_size
+        cpu = StorageMedium.CPU
+        cut = SnapshotCut(page_size)  # the device pass
+        host = SnapshotCut(page_size)  # the host pass, appended at the end
+
+        # One walk yields both passes: the device pass is this walk restricted
+        # to nodes with no evicted node on their path, the host pass this walk
+        # restricted to settled host copies, and each keeps the walk's order.
+        # Parent before children: a page's hash chains to its parent's last
+        # page hash, and a namespaced child reads its parent's event hash, so
+        # announcing the parent first is what makes a snapshot hash match the
+        # one the live path published. Children are pushed reversed so a LIFO
+        # stack yields siblings in tree order.
+        stack = [(child, True) for child in reversed(root.children.values())]
