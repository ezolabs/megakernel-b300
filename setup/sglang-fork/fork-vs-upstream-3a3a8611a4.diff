diff --git a/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py b/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py
new file mode 100644
index 0000000000..9032b10e73
--- /dev/null
+++ b/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py
@@ -0,0 +1,172 @@
+"""SGLANG_MK_TP_PROBE=1 (off by default): every SGLANG_MK_TP_PROBE_EVERY (10)
+scheduler iterations each rank snapshots its state before the request receive;
+TP rank 0's snapshot rides that iteration's request broadcast (no new
+collective) and every rank compares it with its own. SGLANG_MK_TP_PROBE_ASSERT=1
+raises on a mismatch instead of only logging it.
+
+Besides the scheduler counters, the snapshot carries rolling crc32s that
+on_decode_result folds on EVERY decode/verify result (not only probe
+iterations): each request's accepted length and emitted token ids (bonus
+included), ordered by rid, and the step's path (forward mode, CUDA graph or
+eager, rows, megakernel width or not). On probe iterations it adds a crc32 of
+the default CUDA generator's state (a host-side read, no device sync), and with
+SGLANG_MK_TP_PROBE_DEVICE_COUNTERS=1 the DSpark draft-noise Philox offset and
+blockwise-rejection counter (device tensors: that read synchronizes the device).
+A split that makes ranks wait in different collectives hangs before any compare;
+the probe cannot see it."""
+
+import logging
+import os
+import struct
+import zlib
+from dataclasses import dataclass
+
+logger = logging.getLogger(__name__)
+
+ENABLED = os.environ.get("SGLANG_MK_TP_PROBE") == "1"
+EVERY = max(1, int(os.environ.get("SGLANG_MK_TP_PROBE_EVERY", "10")))
+ASSERT = os.environ.get("SGLANG_MK_TP_PROBE_ASSERT") == "1"
+DEVICE_COUNTERS = os.environ.get("SGLANG_MK_TP_PROBE_DEVICE_COUNTERS") == "1"
+FIELDS = (
+    "it",
+    "forward_ct",
+    "sum_seq_lens",
+    "kv_available",
+    "rids_crc32",
+    "spec_accept",
+    "spec_verify_ct",
+    "decode_steps",
+    "accept_lens_crc32",
+    "token_ids_crc32",
+    "path_crc32",
+    "cuda_rng_crc32",
+    "dspark_draft_offset",
+    "dspark_rejection_counter",
+)
+_it = 0
+_checks = 0
+# Rolling over every decode/verify result this rank processed.
+_decode_steps = 0
+_accept_crc = 0
+_token_crc = 0
+_path_crc = 0
+_mk_widths = None  # frozenset of megakernel widths (empty: none), found once
+
+@dataclass(frozen=True)
+class MkTpProbe:
+    state: tuple
+
+def _target_model(worker):
+    for path in (("model_runner",), ("target_worker", "model_runner")):
+        obj = worker
+        for name in path:
+            obj = getattr(obj, name, None)
+        model = getattr(obj, "model", None)
+        if model is not None:
+            return model
+    return None
+
+def _widths(worker) -> frozenset:
+    global _mk_widths
+    if _mk_widths is None:
+        model = _target_model(worker)
+        built = None if model is None else model.__dict__.get("_megakernel")
+        _mk_widths = frozenset(getattr(built, "widths", None) or ())
+    return _mk_widths
+
+def on_decode_result(worker, batch, result, next_token_ids, rows: int) -> None:
+    """Fold one decode/verify result into the rolling crcs. next_token_ids is the
+    per-request accepted run (List[List[int]], bonus token included)."""
+    global _decode_steps, _accept_crc, _token_crc, _path_crc
+    rids = [str(getattr(req, "rid", "")) for req in batch.reqs]
+    accept, tokens = bytearray(), bytearray()
+    for i in sorted(range(len(rids)), key=rids.__getitem__):
+        ids = next_token_ids[i]
+        if isinstance(ids, int):
+            ids = (ids,)
+        accept += rids[i].encode() + struct.pack("<i", len(ids))
+        tokens += struct.pack(f"<{len(ids)}q", *ids)
+    _accept_crc = zlib.crc32(accept, _accept_crc)
+    _token_crc = zlib.crc32(tokens, _token_crc)
+    mode = getattr(batch, "forward_mode", 0)
+    graph = bool(getattr(result, "can_run_cuda_graph", False))
+    mk = graph and rows in _widths(worker)
+    path = struct.pack("<iiii", int(getattr(mode, "value", mode)), graph, rows, mk)
+    _path_crc = zlib.crc32(path, _path_crc)
+    _decode_steps += 1
+
+def _cuda_rng_crc():
+    try:
+        import torch
+
+        if not torch.cuda.is_available() or not torch.cuda.is_initialized():
+            return None
+        return zlib.crc32(torch.cuda.get_rng_state().numpy().tobytes())
+    except Exception as e:  # noqa: BLE001
+        return f"err:{type(e).__name__}"
+
+def _device_counters(scheduler) -> tuple:
+    if not DEVICE_COUNTERS:
+        return (None, None)
+    worker = scheduler.model_worker
+    noise = getattr(getattr(worker, "_proposer", None), "_noise", None)
+    rejection = getattr(worker, "_rejection_noise", None)
+    tensors = (getattr(noise, "offset", None), getattr(rejection, "counter", None))
+    if all(t is None for t in tensors):
+        return (None, None)
+    import torch
+
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+    return tuple(None if t is None else int(t.item()) for t in tensors)
+
+def _state(scheduler) -> tuple:
+    reqs = scheduler.running_batch.reqs
+    mr = scheduler.metrics_reporter
+    return (
+        _it,
+        scheduler.forward_ct,
+        sum(req.seqlen for req in reqs),
+        scheduler.token_to_kv_pool_allocator.available_size(),
+        zlib.crc32(",".join(sorted(req.rid for req in reqs)).encode()),
+        mr.spec_total_num_accept_tokens + mr.spec_num_accept_tokens,
+        mr.spec_total_num_forward_ct + mr.spec_num_forward_ct,
+        _decode_steps,
+        _accept_crc,
+        _token_crc,
+        _path_crc,
+        _cuda_rng_crc(),
+        *_device_counters(scheduler),
+    )
+
+def before_recv(scheduler):
+    """This rank's snapshot on a probe iteration (rank 0 sends it), else None."""
+    global _it
+    _it += 1
+    return MkTpProbe(_state(scheduler)) if _it % EVERY == 0 else None
+
+def after_recv(scheduler, recv_reqs: list, mine, tp_rank: int) -> list:
+    """Strip rank 0's snapshot from the received requests and compare it."""
+    global _checks
+    probes = [req for req in recv_reqs if isinstance(req, MkTpProbe)]
+    if not probes:
+        return recv_reqs
+    rank0 = probes[0].state
+    mine = (mine or MkTpProbe(_state(scheduler))).state
+    if mine != rank0:
+        differ = [
+            f"{name}: mine={a} rank0={b}"
+            for name, a, b in zip(FIELDS, mine, rank0)
+            if a != b
+        ]
+        msg = (
+            f"MK_TP_PROBE MISMATCH it={_it} rank={tp_rank} differ=[{'; '.join(differ)}] "
+            f"fields={','.join(FIELDS)} mine={mine} rank0={rank0}"
+        )
+        logger.error(msg)
+        assert not ASSERT, msg
+    else:
+        _checks += 1
+        if _checks % 10 == 0:
+            logger.info(f"MK_TP_PROBE ok it={_it} rank={tp_rank} checks={_checks} state={mine}")
+    return [req for req in recv_reqs if not isinstance(req, MkTpProbe)]
