new file mode 100644
index 0000000000..eae0f9eeee
--- /dev/null
+++ b/test/registered/unit/entrypoints/test_configure_logging.py
@@ -0,0 +1,178 @@
+"""`/configure_logging` cannot start request content logging or dumps at
+runtime unless the server was launched with
+SGLANG_ALLOW_RUNTIME_REQUEST_LOGGING=1 — a launch gate that vets the flags
+cannot see this endpoint, so the endpoint refuses the change itself.
+Turning things off and the non-content knobs keep working."""
+
+import logging
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from sglang.srt.entrypoints import http_server
+from sglang.srt.environ import envs
+from sglang.srt.managers import tokenizer_manager as tm_module
+from sglang.srt.managers.io_struct import ConfigureLoggingReq
+from sglang.srt.managers.tokenizer_manager import (
+    RuntimeRequestLoggingRefused,
+    TokenizerManager,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=3, suite="base-a-test-cpu")
+
+
+def _manager(*, log_requests=False, log_requests_level=2, crash_dump_folder=None):
+    """A TokenizerManager with only its logging/dumping state initialised,
+    through the real `init_request_logging_and_dumping` (`__new__` skips the
+    ZMQ/tokenizer setup)."""
+    manager = TokenizerManager.__new__(TokenizerManager)
+    manager.server_args = SimpleNamespace()
+    manager.crash_dump_folder = crash_dump_folder
+    manager.dispatched = []
+    manager._dispatch_to_scheduler = manager.dispatched.append
+    observability = SimpleNamespace(
+        log_requests=log_requests,
+        log_requests_level=log_requests_level,
+        log_requests_format="text",
+        log_requests_target=None,
+    )
+    with (
+        patch.object(tm_module, "get_observability", return_value=observability),
+        patch.object(tm_module, "RequestMetricsExporterManager"),
+    ):
+        manager.init_request_logging_and_dumping()
+    return manager
+
+
+def _state(manager):
+    logger = manager.request_logger
+    return (
+        logger.log_requests,
+        logger.log_requests_level,
+        logger.log_requests_format,
+        manager.dump_requests_folder,
+        manager.dump_requests_threshold,
+        manager.crash_dump_folder,
+    )
+
+
+class TestConfigureLoggingRefusesRequestContent(CustomTestCase):
+    def test_enabling_changes_are_refused_and_change_nothing(self):
+        for label, fields in (
+            ("log_requests", {"log_requests": True}),
+            ("log_requests_level", {"log_requests_level": 3}),
+            ("dump_requests_folder", {"dump_requests_folder": "/tmp/dump"}),
+            ("crash_dump_folder", {"crash_dump_folder": "/tmp/crash"}),
+            # One refused field poisons the whole request: nothing applies.
+            (
+                "log_requests",
+                {"log_requests": True, "log_requests_format": "json"},
+            ),
+        ):
+            with self.subTest(fields=fields):
+                manager = _manager()
+                before = _state(manager)
+                with self.assertRaisesRegex(
+                    RuntimeRequestLoggingRefused,
+                    f"{label}.*SGLANG_ALLOW_RUNTIME_REQUEST_LOGGING=1",
+                ):
+                    manager.configure_logging(ConfigureLoggingReq(**fields))
+                self.assertEqual(_state(manager), before)
+
+    def test_launch_enabled_logging_cannot_be_widened_or_redirected(self):
+        manager = _manager(
+            log_requests=True, log_requests_level=0, crash_dump_folder="/srv/crash"
+        )
+        for fields in (
+            {"log_requests_level": 1},
+            {"crash_dump_folder": "/tmp/elsewhere"},
+        ):
+            with self.subTest(fields=fields):
+                with self.assertRaises(RuntimeRequestLoggingRefused):
+                    manager.configure_logging(ConfigureLoggingReq(**fields))
+        # Restating the launch values, lowering and turning off are allowed.
+        manager.configure_logging(
+            ConfigureLoggingReq(
+                log_requests=True,
+                log_requests_level=0,
+                crash_dump_folder="/srv/crash",
+            )
+        )
+        manager.configure_logging(ConfigureLoggingReq(log_requests=False))
+        self.assertFalse(manager.request_logger.log_requests)
+
+    def test_non_content_and_disabling_changes_still_apply(self):
+        manager = _manager(log_requests=True, log_requests_level=3)
+        root = logging.getLogger()
+        self.addCleanup(root.setLevel, root.level)
+        manager.configure_logging(
+            ConfigureLoggingReq(
+                log_requests=False,
+                log_requests_level=1,
+                log_requests_format="json",
+                dump_requests_folder="",
+                dump_requests_threshold=10,
+                dump_requests_exclude_meta_keys=[],
+                crash_dump_folder="",
+                log_level="warning",
+            )
+        )
+        self.assertEqual(_state(manager), (False, 1, "json", "", 10, ""))
+        self.assertEqual(manager.dump_requests_exclude_meta_keys, [])
+        self.assertEqual(len(manager.dispatched), 1)  # log_level reaches ranks
+
+    def test_launch_opt_in_allows_runtime_enabling(self):
+        with envs.SGLANG_ALLOW_RUNTIME_REQUEST_LOGGING.override(True):
+            manager = _manager()
+        # Read at launch: the opt-in holds after the env is gone.
+        manager.configure_logging(
+            ConfigureLoggingReq(
+                log_requests=True,
+                log_requests_level=3,
+                dump_requests_folder="/tmp/dump",
+                crash_dump_folder="/tmp/crash",
+            )
+        )
+        self.assertEqual(
+            _state(manager), (True, 3, "text", "/tmp/dump", 1000, "/tmp/crash")
+        )
+
+
+class TestConfigureLoggingEndpoint(CustomTestCase):
+    def _post(self, manager, body):
+        app = FastAPI()
+        app.add_api_route(
+            "/configure_logging",
+            http_server.configure_logging,
+            methods=["GET", "POST"],
+        )
+        prior_state = http_server.get_global_state()
+        http_server.set_global_state(SimpleNamespace(tokenizer_manager=manager))
+        try:
+            return TestClient(app).post("/configure_logging", json=body)
+        finally:
+            http_server._global_state = prior_state
+
+    def test_refusal_is_a_403_with_the_reason(self):
+        manager = _manager()
+        response = self._post(manager, {"dump_requests_folder": "/tmp/dump"})
+        self.assertEqual(response.status_code, 403)
+        self.assertIn(
+            "SGLANG_ALLOW_RUNTIME_REQUEST_LOGGING", response.json()["error"]["message"]
+        )
+        self.assertEqual(manager.dump_requests_folder, "")
+
+    def test_allowed_change_is_a_200(self):
+        manager = _manager()
+        response = self._post(manager, {"log_requests_format": "json"})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(manager.request_logger.log_requests_format, "json")
+
+
+if __name__ == "__main__":
+    unittest.main()
