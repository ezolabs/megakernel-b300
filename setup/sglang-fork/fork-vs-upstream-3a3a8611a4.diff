index 0000000000..94ddc0ecf6
--- /dev/null
+++ b/.github/fork/runner-image/Dockerfile
@@ -0,0 +1,44 @@
+# arc-sglang runner image: the stock GitHub Actions runner plus the tools
+# sglang's CPU-side workflows expect on a GitHub-hosted Ubuntu runner.
+# RUNNER_IMAGE: the default is actions-runner 2.338.2 by digest, for a local
+# build; fork-runner-image.yml passes the newest actions-runner:latest digest
+# on every run (its weekly schedule keeps the runner, gh, Rust stable and the
+# Ubuntu security updates from going stale).
+ARG RUNNER_IMAGE=ghcr.io/actions/actions-runner@sha256:759a1d94a15b05941aba5196974ff43fe15b4cbba29b694b35cbc32a1166b232
+FROM ${RUNNER_IMAGE}
+
+LABEL org.opencontainers.image.source=https://github.com/<sglang-fork>
+
+USER root
+
+# `apt-get upgrade` takes the Ubuntu updates published since the base was
+# built (it is rebuilt only on a runner release).
+RUN apt-get update \
+    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
+    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+        ca-certificates curl gnupg \
+        python3 python3-pip python3-venv python3-dev python-is-python3 \
+        python3-yaml python3-requests \
+        build-essential pkg-config libssl-dev git-lfs zstd rsync wget \
+    && install -d -m 0755 /etc/apt/keyrings \
+    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
+        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
+    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
+    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
+        > /etc/apt/sources.list.d/github-cli.list \
+    && apt-get update \
+    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh \
+    && rm -rf /var/lib/apt/lists/*
+
+USER runner
+
+# Hosted Ubuntu ships rustup; maturin-action (sgl-model-gateway wheels/sdist)
+# calls it directly. Installed for the runner user so `rustup target add` works.
+RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
+        | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
+ENV PATH=/home/runner/.cargo/bin:$PATH
+
+# Fails the build if a tool is missing; the versions land in the build log.
+RUN rustc --version && cargo --version && rustup --version \
+    && gh --version && python3 --version && pip --version \
+    && git --version && git lfs version && gcc --version
