+    assert steps[0].rids == ["cold-7.7k"]
+    assert steps[0].extend("cold-7.7k") == (0, CHUNKED_PREFILL)
+    assert steps[0].parked is giant and steps[0].chunked is cold
+    # Step 2: the head's last chunk; nothing is chunking in the giant's place.
+    assert steps[1].rids == ["cold-7.7k"]
+    assert steps[1].extend("cold-7.7k") == (CHUNKED_PREFILL, COLD_A)
+    assert steps[1].chunked is None and steps[1].parked is giant
+    # Its prefill is done within its own ceil(7700 / 4096) = 2 passes (+ one).
+    own_passes = -(-COLD_A // CHUNKED_PREFILL)
+    assert _prefill_done_at(steps, cold) == own_passes <= own_passes + 1
+    # Step 3: the giant resumes where it stopped.
+    assert steps[2].rids == ["giant"]
+    assert steps[2].extend("giant") == (COMPUTED, COMPUTED + CHUNKED_PREFILL)
+    assert steps[2].chunked is giant and steps[2].parked is None
+    assert e.swap.spent == 2 * CHUNKED_PREFILL  # the two passes it sat out
