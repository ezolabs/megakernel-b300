+                {"index": 0, "width": 10, "height": 20},
+                {"index": 2, "width": 30, "height": 40},
+            ]
+        )
+        with envs.SGLANG_MM_CACHED_REFS.override(True):
+            kept, refs = OpenAIServingChat._split_mm_cached_refs(
+                None, request, image_data
+            )
+            self.assertEqual(kept, ["data:a"])
+            self.assertEqual(
+                refs,
+                [
+                    {"index": 0, "width": 30, "height": 40},
+                    {"index": 2, "width": 10, "height": 20},
+                ],
+            )
+            request.mm_cached_refs.append({"index": 5, "width": 1, "height": 1})
+            with self.assertRaisesRegex(ValueError, "no image_url part"):
+                OpenAIServingChat._split_mm_cached_refs(None, request, image_data)
