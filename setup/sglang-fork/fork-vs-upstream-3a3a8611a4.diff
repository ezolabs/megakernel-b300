+def _scheduler_stand_in(tree_cache, hisparse):
+    """A real ``Scheduler`` built without ``__init__``, carrying only what
+    ``init_batch_result_processor`` passes on. Not a ``MagicMock``: that answers any
+    attribute, and so hid the 0039 port's read of the retired ``Scheduler.ps``
+    (upstream #40343) until the first GPU boot."""
+    sched = Scheduler.__new__(Scheduler)
+    for name in (
+        "is_generation",
+        "disaggregation_mode",
+        "enable_overlap",
+        "enable_overlap_mlx",
+        "model_config",
+        "token_to_kv_pool_allocator",
+        "hisparse_coordinator",
+        "req_to_token_pool",
+        "decode_offload_manager",
+        "metrics_collector",
+        "metrics_reporter",
+        "draft_worker",
+        "model_worker",
+        "output_streamer",
+        "beam_coordinator",
+    ):
+        setattr(sched, name, mock.MagicMock(name=name))
+    sched.tree_cache = tree_cache
+    sched.enable_hisparse = hisparse
+    sched.init_beam_coordinator = lambda: None
+    return sched
+
