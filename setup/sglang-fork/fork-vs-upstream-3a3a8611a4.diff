+        self.assertTrue(all(_plain([n], [n]) for n in range(1, TAIL_LEN + 1)))
+        self.assertTrue(_plain([43, 2000], [43, 2000]))
+        self.assertFalse(_plain([3000], [3000]))
+
+    def test_a_cut_window_keeps_the_tail(self):
+        # A cached prefix whose SWA window the tail floor cuts.
+        self.assertTrue(_plain([100], [10100]))
+        self.assertFalse(_plain([TAIL_LEN], [10000 + TAIL_LEN]))
