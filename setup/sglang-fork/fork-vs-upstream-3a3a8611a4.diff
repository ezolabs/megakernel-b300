+def test_on_real_sockets_the_frames_and_the_held_step_arrive_in_order(monkeypatch):
+    ctx = zmq.Context.instance()
+    pub_endpoint = "inproc://t-snapshot-off-loop-pub"
+    replay_endpoint = "inproc://t-snapshot-off-loop-replay"
+    sub = ctx.socket(zmq.SUB)
+    sub.setsockopt(zmq.SUBSCRIBE, b"")
+    sub.connect(pub_endpoint)
+    dealer = ctx.socket(zmq.DEALER)
+    dealer.connect(replay_endpoint)
+    publisher = ZmqEventPublisher(
+        attn_dp_rank=0,
+        endpoint=pub_endpoint,
+        replay_endpoint=replay_endpoint,
+        buffer_steps=1,
+    )
+    cache, allocator, *_ = _hicache_tree()
+    cache.take_events()
+    component = _off_loop(cache, publisher)
+    gate = _Gate(monkeypatch, release_first=1)
+    try:
+        for stamp in (1.0, 2.0, 3.0):
+            publisher.publish(KVEventBatch(ts=stamp, events=[]))
+        deadline = time.monotonic() + WAIT_S
+        while publisher._last_seq < 2 and time.monotonic() < deadline:
+            time.sleep(0.01)
+        dealer.send_multipart([b"", (0).to_bytes(8, "big", signed=True)])
+        answer = []
+        while len(answer) < 2:
+            assert dealer.poll(int(WAIT_S * 1000))
+            answer.append(
+                int.from_bytes(dealer.recv_multipart()[-2], "big", signed=True)
+            )
+        assert answer == [-2, -1]
+
+        component.publish_kv_events()
+        render = component.snapshot_render
+        assert render is not None
+        _insert(cache, allocator, [31, 32, 33])
+        component.publish_kv_events()  # held: the window is open
+        gate.open()
+        assert render.join(WAIT_S)
+
+        received = []
+        while len(received) < render.frames + 1:
+            assert sub.poll(int(WAIT_S * 1000)), [_kinds(b) for _, b in received]
+            _topic, seq, payload = sub.recv_multipart()
+            batch = msgspec.msgpack.decode(payload, type=KVEventBatch)
+            if batch.events:  # the three warm-up batches are empty
+                received.append((int.from_bytes(seq, "big"), batch))
+        seqs = [s for s, _ in received]
+        assert seqs == list(range(seqs[0], seqs[0] + len(seqs)))
+        assert len(received) == render.frames + 1 and render.frames > 1
+        assert _kinds(received[0][1])[0] == "SnapshotBegin"
+        assert _kinds(received[render.frames - 1][1])[-1] == "SnapshotEnd"
+        assert _kinds(received[-1][1]) == ["BlockStored"]
+        assert received[-1][1].events[0].token_ids == [31, 32, 33]
+    finally:
+        publisher.shutdown()
+        sub.close(linger=0)
+        dealer.close(linger=0)
