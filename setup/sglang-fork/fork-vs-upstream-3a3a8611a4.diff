+def _ref_item(start, count, h):
+    item = MultimodalDataItem(
+        modality=mm_cached_refs_modality(),
+        feature=None,
+        offsets=[(start, start + count - 1)],
+        model_specific_data={mm_cached_refs.MM_CACHED_REF_KEY: True},
