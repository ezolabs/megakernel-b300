+@pytest.mark.parametrize("lanes", ["giant lane", "one worker (0021)"])
+async def test_a_small_conversion_does_not_wait_for_a_held_giant(lanes, lanes_config):
+    if lanes == "giant lane":
+        lanes_config(workers=2, giant_chars=GIANT_CHARS)
+    else:
+        lanes_config(workers=1, giant_chars=0)
+    tokenizer = _HeldTokenizer()
+    chat = _chat(tokenizer)
+    record = tokenizer.record
+    record.gate("giant")
+
+    giant = asyncio.create_task(
+        chat.handle_request(_giant("rid-giant", "<<hold:giant>>"), _raw_request())
+    )
+    await _entered(record, "giant")
+    small = asyncio.create_task(
+        chat.handle_request(_request("rid-small", "cheap turn"), _raw_request())
+    )
+    done, _ = await asyncio.wait({small}, timeout=0.5)
+
+    if lanes == "giant lane":
+        assert small in done, "the small conversion waited for the held giant"
+        assert [a.rid for a in chat.tokenizer_manager.generated] == ["rid-small"]
+        assert not giant.done()
+    else:
+        # Negative control: one lane, one worker; the small request is queued
+        # behind the giant and reaches the scheduler only after it.
+        assert small not in done
+        assert chat.tokenizer_manager.generated == []
+    record.gates["giant"].set()
+    await asyncio.wait_for(asyncio.gather(giant, small), WAIT_S)
+    order = [a.rid for a in chat.tokenizer_manager.generated]
+    if lanes == "giant lane":
+        assert order == ["rid-small", "rid-giant"]
+        (giant_thread,) = [n for n, _, length in record.encodes if length > GIANT_CHARS]
+        (small_thread,) = [n for n, _, length in record.encodes if length < GIANT_CHARS]
+        assert giant_thread.startswith(f"{PREPROCESS_THREAD_NAME_PREFIX}-giant")
+        assert small_thread.startswith(PREPROCESS_THREAD_NAME_PREFIX)
+        assert "-giant" not in small_thread
+    else:
+        assert order == ["rid-giant", "rid-small"]
+
