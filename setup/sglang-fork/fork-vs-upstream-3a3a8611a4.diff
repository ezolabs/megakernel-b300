@@ -0,0 +1,232 @@
+"""``x-request-id`` on the OpenAI facade (patch ``a1-openai-request-id``).
+
+``OpenAIServingBase.handle_request`` echoes the internal ``rid`` of the
+adapted request back to the client as an ``x-request-id`` response header, so
+a router that only sees HTTP can correlate a response with the request it
+routed even when the client sent no id of its own. These tests drive
+``handle_request`` with validation, conversion and generation mocked out: no
+server, no tokenizer, no GPU.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+from fastapi.responses import ORJSONResponse, StreamingResponse
+
+from sglang.srt.entrypoints.openai.protocol import ErrorResponse
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.entrypoints.openai.serving_completions import OpenAIServingCompletion
+from sglang.srt.managers.io_struct import GenerateReqInput
+
+RID = "rid-123"
+STREAMING = "_handle_streaming_request"
+NON_STREAMING = "_handle_non_streaming_request"
+
+
+def _serving(cls=OpenAIServingChat):
+    """``cls`` with no template/tokenizer machinery behind it.
+
+    ``handle_request`` touches ``tokenizer_manager`` only for the request
+    logger, and only when ``log_requests`` is on.
+    """
+    serving = cls.__new__(cls)
+    tokenizer_manager = mock.MagicMock()
+    tokenizer_manager.request_logger.log_requests = False
+    serving.tokenizer_manager = tokenizer_manager
+    return serving
+
+
+async def _dispatch(
+    serving, *, stream, handler_name, handler, adapted, raw_request=None
+):
+    """Run ``handle_request`` against a stubbed validate/convert/handler trio."""
+    request = SimpleNamespace(stream=stream)
+    with (
+        mock.patch.object(serving, "_validate_request", new=lambda request: None),
+        mock.patch.object(
+            serving,
+            "_convert_to_internal_request",
+            new=lambda request, raw: (adapted, request),
+        ),
+        mock.patch.object(serving, handler_name, new=handler),
+    ):
+        return await serving.handle_request(request, raw_request)
+
+
+@pytest.mark.parametrize(
+    "stream,handler_name",
+    [(False, NON_STREAMING), (True, STREAMING)],
+)
+async def test_handler_response_echoes_rid(stream, handler_name):
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+    response = StreamingResponse(iter([])) if stream else ORJSONResponse({})
+
+    async def handler(adapted_request, request, raw_request):
+        assert adapted_request is adapted
+        return response
+
+    result = await _dispatch(
+        serving,
+        stream=stream,
+        handler_name=handler_name,
+        handler=handler,
+        adapted=adapted,
+    )
+
+    assert result is response
+    assert result.headers["x-request-id"] == RID
+
+
+async def test_completion_requests_are_covered_by_the_base_handler():
+    """``/v1/completions`` shares ``handle_request`` with ``/v1/chat``."""
+    serving = _serving(OpenAIServingCompletion)
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    async def handler(adapted_request, request, raw_request):
+        return ORJSONResponse({})
+
+    result = await _dispatch(
+        serving,
+        stream=False,
+        handler_name=NON_STREAMING,
+        handler=handler,
+        adapted=adapted,
+    )
+
+    assert result.headers["x-request-id"] == RID
+
+
+async def test_batch_rid_is_joined_with_a_comma():
+    serving = _serving()
+    adapted = GenerateReqInput(text=["x", "y"], rid=["rid-a", "rid-b"])
+
+    async def handler(adapted_request, request, raw_request):
+        return ORJSONResponse({})
+
+    result = await _dispatch(
+        serving,
+        stream=False,
+        handler_name=NON_STREAMING,
+        handler=handler,
+        adapted=adapted,
+    )
+
+    assert result.headers["x-request-id"] == "rid-a,rid-b"
+
+
+async def test_rid_assigned_inside_the_handler_is_still_echoed():
+    """The client sends no rid; normalization mints one during the handler."""
+    serving = _serving()
+    adapted = GenerateReqInput(text="x")
+    assert adapted.rid is None
+
+    async def handler(adapted_request, request, raw_request):
+        adapted_request.rid = RID
+        return ORJSONResponse({})
+
+    result = await _dispatch(
+        serving,
+        stream=False,
+        handler_name=NON_STREAMING,
+        handler=handler,
+        adapted=adapted,
+    )
+
+    assert result.headers["x-request-id"] == RID
+
+
+async def test_a_header_set_by_the_handler_is_not_overwritten():
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    async def handler(adapted_request, request, raw_request):
+        return ORJSONResponse({}, headers={"x-request-id": "from-elsewhere"})
+
+    result = await _dispatch(
+        serving,
+        stream=False,
+        handler_name=NON_STREAMING,
+        handler=handler,
+        adapted=adapted,
+    )
+
+    assert result.headers["x-request-id"] == "from-elsewhere"
+
+
+async def test_validation_error_carries_no_header_and_skips_the_handler():
+    serving = _serving()
+    convert = mock.Mock()
+    handler = mock.Mock()
+
+    with (
+        mock.patch.object(
+            serving, "_validate_request", new=lambda request: "no such model"
+        ),
+        mock.patch.object(serving, "_convert_to_internal_request", new=convert),
+        mock.patch.object(serving, NON_STREAMING, new=handler),
+    ):
+        response = await serving.handle_request(SimpleNamespace(stream=False), None)
+
+    assert response.status_code == 400
+    assert "x-request-id" not in response.headers
+    convert.assert_not_called()
+    handler.assert_not_called()
+
+
+def test_a_body_model_without_headers_is_returned_untouched():
+    serving = _serving()
+    error = ErrorResponse(
+        object="error", message="boom", type="BadRequest", param=None, code=400
+    )
+
+    assert (
+        serving._attach_request_id_header(error, GenerateReqInput(text="x", rid=RID))
+        is error
+    )
+
+
+@pytest.mark.parametrize("rid", [None, "", []])
+def test_a_response_without_a_rid_is_left_alone(rid):
+    serving = _serving()
+    response = ORJSONResponse({})
+    adapted = GenerateReqInput(text="x", rid=rid)
+
+    assert serving._attach_request_id_header(response, adapted) is response
+    assert "x-request-id" not in response.headers
+
+
+@pytest.mark.parametrize(
+    "rid,expected",
+    [
+        ("rid\r\nalso-injected: 1", "ridalso-injected: 1"),
+        ("rid\nis-disconnected", "ridis-disconnected"),
+        ("rid\x00nul", "ridnul"),
+        ("r\u00efd-latin1", "r\u00efd-latin1"),
+    ],
+)
+def test_a_client_supplied_rid_is_sanitized(rid, expected):
+    """The rid goes onto the wire verbatim; CR/LF must not split the headers."""
+    serving = _serving()
+    response = ORJSONResponse({})
+    adapted = GenerateReqInput(text="x", rid=rid)
+
+    serving._attach_request_id_header(response, adapted)
+
+    assert response.headers["x-request-id"] == expected
+    assert "\r" not in response.headers["x-request-id"]
+    assert "\n" not in response.headers["x-request-id"]
+    # Starlette encodes headers lazily; this raises if anything unsafe got in.
+    assert response.raw_headers
+
+
+def test_a_non_latin1_rid_leaves_the_response_without_the_header():
+    serving = _serving()
+    response = ORJSONResponse({})
+    adapted = GenerateReqInput(text="x", rid="\u30ea\u30af\u30a8\u30b9\u30c8")
+
+    assert serving._attach_request_id_header(response, adapted) is response
+    assert "x-request-id" not in response.headers
diff --git a/test/srt/sbr/test_a1b_error_response_request_id.py b/test/srt/sbr/test_a1b_error_response_request_id.py
new file mode 100644
index 0000000000..b35c463498
--- /dev/null
+++ b/test/srt/sbr/test_a1b_error_response_request_id.py
@@ -0,0 +1,248 @@
+"""``x-request-id`` on the OpenAI facade's post-conversion error responses.
+
+``a1`` put ``x-request-id`` on the success path of
+``OpenAIServingBase.handle_request``. The four ``except`` arms below it built
+their response and returned it directly, so an error raised *after*
+``_convert_to_internal_request`` had already returned - the request is
+tokenized, its ``rid`` is minted, the scheduler may already hold it - dropped
+the correlation a router needs most, because the failed request is exactly the
+one it has to explain. ``adapted_request`` is now bound before the ``try`` and
+every error arm returns its response through ``_attach_request_id_header``,
+which no-ops when there is no rid: a validation-time error is still
+headerless, while a post-conversion one carries the id the tokenizer manager,
+the scheduler and the router all key that request by.
+
+Only ``handle_request`` is exercised; validation, conversion and the handler
+are stubbed. No server, no tokenizer, no GPU.
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+from fastapi import HTTPException
+from fastapi.responses import ORJSONResponse, StreamingResponse
+
+from sglang.srt.entrypoints.openai.encoding_dsv32 import DS32EncodingError
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.managers.io_struct import GenerateReqInput
+
+RID = "rid-error-1"
+STREAMING = "_handle_streaming_request"
+NON_STREAMING = "_handle_non_streaming_request"
+
+
+def _serving(cls=OpenAIServingChat):
+    """``cls`` with no template/tokenizer machinery behind it.
+
+    ``handle_request`` touches ``tokenizer_manager`` only for the request
+    logger, and only when ``log_requests`` is on.
+    """
+    serving = cls.__new__(cls)
+    tokenizer_manager = mock.MagicMock()
+    tokenizer_manager.request_logger.log_requests = False
+    serving.tokenizer_manager = tokenizer_manager
+    return serving
+
+
+async def _run(
+    serving,
+    *,
+    handler,
+    adapted=None,
+    stream=False,
+    handler_name=NON_STREAMING,
+    validate=None,
+    convert=None,
+):
+    """Run ``handle_request`` against a stubbed validate/convert/handler trio."""
+    request = SimpleNamespace(stream=stream)
+    with (
+        mock.patch.object(
+            serving, "_validate_request", new=validate or (lambda request: None)
+        ),
+        mock.patch.object(
+            serving,
+            "_convert_to_internal_request",
+            new=convert or (lambda request, raw_request: (adapted, request)),
+        ),
+        mock.patch.object(serving, handler_name, new=handler),
+    ):
+        return await serving.handle_request(request, None)
+
+
+def _raising(exception):
+    """A handler that fails the way a real one would, mid-generation."""
+
+    async def handler(adapted_request, request, raw_request):
+        raise exception
+
+    return handler
+
+
+@pytest.mark.parametrize(
+    "exception,status,err_type,message",
+    [
+        (HTTPException(status_code=400, detail="bad thing"), 400, "400", "bad thing"),
+        (ValueError("bad value"), 400, "BadRequest", "bad value"),
+        (DS32EncodingError("dsml"), 400, "BadRequest", "dsml"),
+        (
+            RuntimeError("kaboom"),
+            500,
+            "InternalServerError",
+            "Internal server error: kaboom",
+        ),
+    ],
+)
+async def test_an_error_after_conversion_carries_the_adapted_rid(
+    exception, status, err_type, message
+):
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    async def handler(adapted_request, request, raw_request):
+        assert adapted_request is adapted
+        raise exception
+
+    response = await _run(serving, handler=handler, adapted=adapted)
+
+    assert isinstance(response, ORJSONResponse)
+    assert response.status_code == status
+    # create_error_response dumps the ErrorResponse model itself, flat.
+    error = json.loads(response.body)
+    assert error["message"] == message
+    assert error["type"] == err_type
+    assert error["code"] == status
+    assert response.headers["x-request-id"] == RID
+    # The header has to be on the encoded wire, not just in the mapping.
+    assert (b"x-request-id", RID.encode()) in response.raw_headers
+
+
+async def test_a_streaming_request_that_fails_after_conversion_carries_the_rid():
+    """Nothing was streamed, so the error is a plain JSON body, not a stream."""
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    response = await _run(
+        serving,
+        handler=_raising(RuntimeError("kaboom")),
+        adapted=adapted,
+        stream=True,
+        handler_name=STREAMING,
+    )
+
+    assert not isinstance(response, StreamingResponse)
+    assert response.status_code == 500
+    assert response.headers["x-request-id"] == RID
+
+
+async def test_the_error_body_is_not_rebuilt_by_the_header_helper():
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+    error_response = ORJSONResponse(
+        {"object": "error", "message": "boom", "type": "400", "code": 400},
+        status_code=418,
+    )
+    create = mock.Mock(return_value=error_response)
+
+    with mock.patch.object(serving, "create_error_response", new=create):
+        response = await _run(
+            serving,
+            handler=_raising(HTTPException(status_code=400, detail="bad thing")),
+            adapted=adapted,
+        )
+
+    assert response is error_response
+    assert response.status_code == 418
+    assert response.headers["x-request-id"] == RID
+    create.assert_called_once_with(message="bad thing", err_type="400", status_code=400)
+
+
+async def test_a_batched_rid_is_joined_on_the_error_path():
+    serving = _serving()
+    adapted = GenerateReqInput(text=["x", "y"], rid=["rid-a", "rid-b"])
+
+    response = await _run(
+        serving, handler=_raising(ValueError("bad batch")), adapted=adapted
+    )
+
+    assert response.headers["x-request-id"] == "rid-a,rid-b"
+
+
+@pytest.mark.parametrize("rid", [None, "", []])
+async def test_an_error_with_no_rid_carries_no_header(rid):
+    """A handler that never minted a rid cannot have one echoed for it."""
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=rid)
+
+    response = await _run(
+        serving,
+        handler=_raising(ValueError("bad value")),
+        adapted=adapted,
+    )
+
+    assert response.status_code == 400
+    assert "x-request-id" not in response.headers
+
+
+async def test_a_validation_failure_carries_no_header():
+    """``_validate_request`` returns before anything has a rid."""
+    serving = _serving()
+    convert = mock.Mock()
+    handler = mock.Mock()
+
+    with (
+        mock.patch.object(
+            serving, "_validate_request", new=lambda request: "no such model"
+        ),
+        mock.patch.object(serving, "_convert_to_internal_request", new=convert),
+        mock.patch.object(serving, NON_STREAMING, new=handler),
+    ):
+        response = await serving.handle_request(SimpleNamespace(stream=False), None)
+
+    assert response.status_code == 400
+    assert json.loads(response.body)["message"] == "no such model"
+    assert "x-request-id" not in response.headers
+    convert.assert_not_called()
+    handler.assert_not_called()
+
+
+async def test_a_validation_exception_carries_no_header():
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    def validate(request):
+        raise ValueError("bad model")
+
+    response = await _run(
+        serving,
+        handler=_raising(AssertionError("the handler must not run")),
+        adapted=adapted,
+        validate=validate,
+    )
+
+    assert response.status_code == 400
+    assert json.loads(response.body)["message"] == "bad model"
+    assert "x-request-id" not in response.headers
+
+
+async def test_a_failure_inside_the_conversion_carries_no_header():
+    """The conversion never returned, so the rid it minted is not in hand."""
+    serving = _serving()
+    adapted = GenerateReqInput(text="x", rid=RID)
+
+    def convert(request, raw_request):
+        raise ValueError("cannot build the adapted request")
+
+    response = await _run(
+        serving,
+        handler=_raising(AssertionError("the handler must not run")),
+        adapted=adapted,
+        convert=convert,
+    )
+
+    assert response.status_code == 400
+    assert "x-request-id" not in response.headers
diff --git a/test/srt/sbr/test_a2_generate_request_id.py b/test/srt/sbr/test_a2_generate_request_id.py
new file mode 100644
index 0000000000..47b792dd1b
--- /dev/null
+++ b/test/srt/sbr/test_a2_generate_request_id.py
@@ -0,0 +1,194 @@
+"""``x-request-id`` echo on ``/generate`` (sbr patch ``a2``).
+
+``GenerateReqInput.rid`` is optional. When the caller supplies one, the
+response built by the ``/generate`` route carries it back as an
+``x-request-id`` header, so a client that already knows the id can correlate
+the response with the request it sent -- and can later ``POST /abort_request``
+with the same id. The header is attached while the response head is being
+built, which is why a *streaming* request whose caller sent no ``rid`` carries
+none: the id is minted inside ``TokenizerManager.generate_request``, on the
+first iteration, after the head has gone out.
+
+``http_server`` is imported with two optional third-party modules stubbed
+(``soundfile`` behind the OpenAI audio routes, ``python-multipart`` behind the
+``Form``/``File`` routes). Neither is reachable from ``/generate``; the CPU-only
+env used for the ``sbr`` series does not install them, and the ``sbr`` conftest
+is shared scaffolding that this patch does not touch.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import importlib.machinery
+import sys
+import types
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+
+def _stub_module(name: str, **attrs) -> types.ModuleType:
+    """Install a minimal module so an unrelated optional import succeeds."""
+    mod = types.ModuleType(name)
+    mod.__spec__ = importlib.machinery.ModuleSpec(name, None)
+    mod.__file__ = f"<stub {name}>"
+
+    def __getattr__(attr):
+        if attr.startswith("__"):
+            raise AttributeError(attr)
+        return mock.MagicMock(name=f"{name}.{attr}")
+
+    mod.__getattr__ = __getattr__
+    for key, value in attrs.items():
+        setattr(mod, key, value)
+    sys.modules[name] = mod
+    return mod
+
+
+_stub_module("soundfile")
+_stub_module("python_multipart", __version__="0.0.20")
+# scheduler.py imports the MLX mixin on darwin; the wheel is absent on non-Apple-ML hosts.
+_stub_module("mlx")
+_stub_module("mlx.core")
+
+from fastapi import BackgroundTasks  # noqa: E402
+from fastapi.responses import Response  # noqa: E402
+from fastapi.testclient import TestClient  # noqa: E402
+
+from sglang.srt.entrypoints import http_server  # noqa: E402
+
+
+class _FakeTokenizerManager:
+    """The slice of ``TokenizerManager`` that the ``/generate`` route uses.
+
+    ``generate_request`` is an async generator: the streaming branch iterates
+    it, the non-streaming branch pulls exactly one item with ``__anext__``.
+    As in the real manager, the rid that the caller did not send is minted on
+    the first iteration -- i.e. after the response head already exists.
+    """
+
+    def __init__(self, server_rid: str | None = None) -> None:
+        self.server_rid = server_rid
+        self.seen = []
+        self.abort_tasks = 0
+
+    async def generate_request(self, obj, request):
+        self.seen.append(obj)
+        if obj.rid is None and self.server_rid is not None:
+            obj.rid = self.server_rid
+        yield {
+            "text": "hello",
+            "meta_info": {"finish_reason": {"type": "stop"}},
+        }
+
+    def create_abort_task(self, obj):
+        self.abort_tasks += 1
+        return BackgroundTasks()
+
+
+@contextlib.contextmanager
+def _client(manager):
+    """A TestClient for which ``_global_state.tokenizer_manager`` is ``manager``.
+
+    ``TestClient`` is deliberately not used as a context manager: that would run
+    the app lifespan, which needs a real tokenizer manager and scheduler.
+    """
+    state = SimpleNamespace(tokenizer_manager=manager)
+    with mock.patch.object(http_server, "_global_state", state):
+        yield TestClient(http_server.app)
+
+
+def test_stream_generate_echoes_client_rid():
+    manager = _FakeTokenizerManager()
+    with _client(manager) as client:
+        resp = client.post(
+            "/generate", json={"text": "hi", "rid": "r-1", "stream": True}
+        )
+    assert resp.status_code == 200
+    assert resp.headers["x-request-id"] == "r-1"
+    assert resp.text.startswith("data: ")
+    assert resp.text.rstrip().endswith("data: [DONE]")
+    assert manager.seen[0].rid == "r-1"
+    # The abort background task the stream branch installs is still wired.
+    assert manager.abort_tasks == 1
+
+
+def test_stream_generate_without_client_rid_carries_no_header():
+    manager = _FakeTokenizerManager(server_rid="srv-1")
+    with _client(manager) as client:
+        resp = client.post("/generate", json={"text": "hi", "stream": True})
+    assert resp.status_code == 200
+    assert "x-request-id" not in resp.headers
+    # The id was minted, but only once the stream was iterated -- the header was
+    # already fixed by then, and normalising early would have been the bug.
+    assert manager.seen[0].rid == "srv-1"
+
+
+@pytest.mark.parametrize("method", ["POST", "PUT"])
+def test_nonstream_generate_echoes_client_rid(method):
+    manager = _FakeTokenizerManager(server_rid="srv-1")
+    with _client(manager) as client:
+        resp = client.request(method, "/generate", json={"text": "hi", "rid": "r-1"})
+    assert resp.status_code == 200
+    assert resp.headers["x-request-id"] == "r-1"
+    assert resp.json()["text"] == "hello"
+    assert manager.seen[0].rid == "r-1"
+
+
+def test_nonstream_generate_echoes_minted_rid_when_client_sent_none():
+    manager = _FakeTokenizerManager(server_rid="srv-1")
+    with _client(manager) as client:
+        resp = client.post("/generate", json={"text": "hi"})
+    assert resp.status_code == 200
+    assert resp.headers["x-request-id"] == "srv-1"
+
+
+def test_batched_rid_list_is_joined_with_commas():
+    manager = _FakeTokenizerManager()
+    with _client(manager) as client:
+        resp = client.post(
+            "/generate",
+            json={"text": ["hi", "there"], "rid": ["r-a", "r-b"], "stream": True},
+        )
+    assert resp.status_code == 200
+    assert resp.headers["x-request-id"] == "r-a,r-b"
+
+
+def test_rid_set_by_the_override_header_is_echoed_too():
+    """``x-override-rid`` is applied before the route branches, so it is echoed.
+
+    The override runs ahead of the stream/non-stream split, which means the id
+    the caller supplied by header is the one the response reports -- the echo
+    follows the effective rid, not just the body field.
+    """
+    manager = _FakeTokenizerManager()
+    with http_server.envs.SGLANG_ENABLE_REQUEST_HEADER_OVERRIDES.override(True):
+        with _client(manager) as client:
+            resp = client.post(
+                "/generate",
+                json={"text": "hi", "stream": True},
+                headers={"x-override-rid": "h-1"},
+            )
+    assert resp.status_code == 200
+    assert resp.headers["x-request-id"] == "h-1"
+    assert manager.seen[0].rid == "h-1"
+
+
+def test_helper_attaches_rid_and_returns_response():
+    response = Response(content=b"{}")
+    assert http_server._attach_request_id_header(response, "r-1") is response
+    assert response.headers["x-request-id"] == "r-1"
+
+
+def test_helper_joins_list_rid_with_commas():
+    response = Response(content=b"{}")
+    http_server._attach_request_id_header(response, ["r-a", "r-b"])
+    assert response.headers["x-request-id"] == "r-a,r-b"
+
+
+def test_helper_leaves_header_absent_when_client_sent_no_rid():
+    for rid in (None, "", []):
+        response = Response(content=b"{}")
+        http_server._attach_request_id_header(response, rid)
+        assert "x-request-id" not in response.headers
diff --git a/test/srt/sbr/test_b1_abort_task_no_sleep.py b/test/srt/sbr/test_b1_abort_task_no_sleep.py
new file mode 100644
index 0000000000..bafdcf0951
--- /dev/null
+++ b/test/srt/sbr/test_b1_abort_task_no_sleep.py
@@ -0,0 +1,97 @@
+"""``create_abort_task`` must abort without waiting out a sleep first.
+
+``TokenizerManager.create_abort_task`` hands Starlette a background callable
+that aborts every rid still live in ``rid_to_state`` when the response ends --
+which for an SSE stream is exactly when the client hangs up.  A
+``await asyncio.sleep(2)`` used to sit in front of that abort, so a client that
+had already disconnected (``is_disconnected()`` is true) left its slot on the
+scheduler for two more seconds before anything was aborted.
+
+These tests pin the background callable to:
+
+* abort immediately -- no awaited sleep at all, and far under the old delay;
+* never touch a rid whose state is gone, because a request that completed
+  normally deletes its ``rid_to_state`` entry before its final chunk is yielded
+  (see ``_handle_batch_output``), so "response finished" does not mean "abort";
+* walk every rid of a batch request and abort only the live ones.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from types import SimpleNamespace
+from unittest import mock
+
+from starlette.background import BackgroundTasks
+
+from sglang.srt.managers.tokenizer_manager import TokenizerManager
+
+
+def _manager(**live_rids):
+    """A manager built with ``__new__``: ``create_abort_task`` reads only
+    ``rid_to_state`` and ``abort_request``, so nothing else is needed and no
+    scheduler socket is ever opened."""
+    tm = TokenizerManager.__new__(TokenizerManager)
+    tm.rid_to_state = dict.fromkeys(live_rids, object())
+    tm.abort_request = mock.MagicMock(name="abort_request")
+    return tm
+
+
+def _obj(rid, is_single):
+    return SimpleNamespace(rid=rid, is_single=is_single)
+
+
+def test_background_shape_unchanged():
+    """Still one BackgroundTasks holding exactly one background callable."""
+    tm = _manager(r1=object())
+    background = tm.create_abort_task(_obj("r1", True))
+    assert isinstance(background, BackgroundTasks)
+    assert len(background.tasks) == 1
+
+
+async def test_abort_runs_immediately():
+    """``await background()`` aborts at once -- the 2 s wait is gone."""
+    tm = _manager(r1=object())
+    background = tm.create_abort_task(_obj("r1", True))
+
+    started = time.perf_counter()
+    await background()
+    elapsed = time.perf_counter() - started
+
+    tm.abort_request.assert_called_once_with("r1")
+    assert elapsed < 0.5, f"abort task waited {elapsed:.3f}s"
+
+
+async def test_no_sleep_is_awaited():
+    """No coroutine sleep is awaited at all, so the old delay cannot return."""
+    tm = _manager(r1=object())
+    background = tm.create_abort_task(_obj("r1", True))
+
+    with mock.patch.object(
+        asyncio, "sleep", new=mock.AsyncMock(name="asyncio.sleep")
+    ) as sleep:
+        await background()
+
+    sleep.assert_not_awaited()
+    tm.abort_request.assert_called_once_with("r1")
+
+
+async def test_completed_request_is_not_aborted():
+    """rid already removed from rid_to_state (request finished) -> no-op."""
+    tm = _manager()  # nothing live; the finished request cleaned up after itself
+    background = tm.create_abort_task(_obj("r1", True))
+
+    await background()
+
+    tm.abort_request.assert_not_called()
+
+
+async def test_batch_aborts_only_live_rids():
+    """A batch walks every rid and aborts only the ones still in rid_to_state."""
+    tm = _manager(r2=object())
+    background = tm.create_abort_task(_obj(["r1", "r2"], False))
+
+    await background()
+
+    tm.abort_request.assert_called_once_with("r2")
diff --git a/test/srt/sbr/test_b2_stream_disconnect_poll.py b/test/srt/sbr/test_b2_stream_disconnect_poll.py
new file mode 100644
index 0000000000..1e684c4f26
--- /dev/null
+++ b/test/srt/sbr/test_b2_stream_disconnect_poll.py
@@ -0,0 +1,257 @@
+"""b2 - a dropped chat-stream client aborts the decode instead of streaming on.
+
+``OpenAIServingChat._generate_chat_stream`` polls
+``raw_request.is_disconnected()`` at the top of every
+``tokenizer_manager.generate_request()`` iteration. The first ``True`` aborts
+every rid of the adapted request and returns, so the scheduler stops decoding a
+completion nobody can receive and - because the generator returns instead of
+falling through - the truncated stream is never closed with a ``data: [DONE]``
+frame, which an upstream broker would read as a clean stop.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+import json
+from types import SimpleNamespace
+from unittest import mock
+
+from sglang.srt.entrypoints.openai import serving_chat as sc
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.managers.io_struct import GenerateReqInput
+from _chat_serving_stub import init_chat_serving_defaults
+
+DONE_FRAME = "data: [DONE]\n\n"
+RID = "b2-single-rid"
+
+# The attributes the streaming loop reads off ``tokenizer_manager.server_args``
+# on this path.
+SERVING_STUB = SimpleNamespace(
+    incremental_streaming_output=False,
+    stream_response_default_include_usage=False,
+    return_input_ids=False,
+    return_output_ids=False,
+    enable_cache_report=False,
+)
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's serving path reads get_serving() (stream_response_default_
+    # include_usage, ...), which needs a published config in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+def _chunk(index: int = 0, text: str = "hi") -> dict:
+    """A minimal ``generate_request`` payload, shaped like the real one."""
+    return {
+        "index": index,
+        "text": text,
+        "meta_info": {
+            "id": "c1",
+            "prompt_tokens": 1,
+            "completion_tokens": 1,
+            "finish_reason": None,
+            "output_token_logprobs_length": 0,
+        },
+    }
+
+
+async def _contents(*items):
+    for item in items:
+        yield item
+
+
+def _serving(*items) -> sc.OpenAIServingChat:
+    serving = init_chat_serving_defaults(sc.OpenAIServingChat.__new__(sc.OpenAIServingChat))
+    serving.tokenizer_manager = mock.MagicMock()
+    serving.tokenizer_manager.generate_request = lambda *a, **k: _contents(*items)
+    serving.tokenizer_manager.server_args = SERVING_STUB
+    # Attributes __init__ would normally have set, read by the stream loop.
+    serving.chat_encoding_spec = None
+    serving.reasoning_parser = None
+    serving.tool_call_parser = None
+    return serving
+
+
+def _chat_request() -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="sbr-test-model",
+        messages=[{"role": "user", "content": "hi"}],
+        stream=True,
+    )
+
+
+def _adapted(rid=RID, text="hi") -> GenerateReqInput:
+    req = GenerateReqInput(rid=rid, text=text)
+    # Exactly what TokenizerManager.generate_request does first thing, so the
+    # test exercises the same rid/is_single state the real loop sees.
+    req.normalize_batch_and_arguments()
+    return req
+
+
+def _raw_request(*disconnects: bool) -> mock.MagicMock:
+    raw = mock.MagicMock()
+    raw.headers = {}
+    raw.is_disconnected = mock.AsyncMock(side_effect=list(disconnects))
+    return raw
+
+
+async def _drain(gen) -> list:
+    return [frame async for frame in gen]
+
+
+def _payloads(frames: list) -> list:
+    """SSE ``data:`` frames as dicts, ``[DONE]`` as None, minus wall-clock noise."""
+    out = []
+    for frame in frames:
+        assert frame.startswith("data: "), frame
+        body = frame[len("data: ") :].strip()
+        if body == "[DONE]":
+            out.append(None)
+            continue
+        payload = json.loads(body)
+        payload.pop("created", None)
+        out.append(payload)
+    return out
+
+
+def _deltas(frames: list) -> list:
+    deltas = []
+    for payload in _payloads(frames):
+        if payload is None:
+            continue
+        for choice in payload.get("choices") or []:
+            deltas.append(choice.get("delta", {}).get("content"))
+    return deltas
+
+
+
+
+async def test_disconnect_after_first_chunk_stops_before_the_second():
+    serving = _serving(_chunk(), _chunk(), _chunk())
+    raw = _raw_request(False, True)
+
+    frames = await _drain(
+        serving._generate_chat_stream(_adapted(), _chat_request(), raw)
+    )
+
+    # A one-chunk stream ends with the terminating frame; the truncated run is
+    # byte-for-byte those same frames with the terminator missing.
+    reference = await _drain(
+        _serving(_chunk())._generate_chat_stream(
+            _adapted(), _chat_request(), _raw_request(*[False] * 5)
+        )
+    )
+    assert reference[-1] == DONE_FRAME
+    assert _payloads(frames) == _payloads(reference[:-1])
+    # "h"+"i" of that one chunk: the leading "" is the per-index role frame the
+    # loop emits before the first content delta.
+    assert _deltas(frames) == ["", "hi"]
+
+    # The poll is at the top of the iteration: the abort lands before the
+    # second chunk is rendered, and no further poll is made.
+    assert raw.is_disconnected.await_count == 2
+    serving.tokenizer_manager.abort_request.assert_called_once_with(RID)
+
+    # A truncated stream is not closed as if it had finished.
+    assert DONE_FRAME not in frames
+
+
+async def test_truncated_run_is_shorter_than_an_uninterrupted_one():
+    served = _serving(_chunk(), _chunk(), _chunk())
+    full = await _drain(
+        served._generate_chat_stream(
+            _adapted(), _chat_request(), _raw_request(*[False] * 5)
+        )
+    )
+    served = _serving(_chunk(), _chunk(), _chunk())
+    cut = await _drain(
+        served._generate_chat_stream(_adapted(), _chat_request(), _raw_request(True))
+    )
+
+    assert len(cut) < len(full), (cut, full)
+    assert cut == []
+    assert full[-1] == DONE_FRAME
+    assert DONE_FRAME not in cut
+    assert served.tokenizer_manager.abort_request.call_args_list == [mock.call(RID)]
+
+
+async def test_all_chunks_stream_when_the_client_stays_connected():
+    serving = _serving(_chunk(text="h"), _chunk(text="hi"), _chunk(text="hi!"))
+    raw = _raw_request(*[False] * 8)
+
+    frames = await _drain(
+        serving._generate_chat_stream(_adapted(), _chat_request(), raw)
+    )
+
+    assert _deltas(frames) == ["", "h", "i", "!"]
+    assert raw.is_disconnected.await_count == 3
+    serving.tokenizer_manager.abort_request.assert_not_called()
+    assert frames[-1] == DONE_FRAME
+    assert frames.count(DONE_FRAME) == 1
+
+
+async def test_missing_raw_request_streams_unchanged():
+    serving = _serving(_chunk(text="h"), _chunk(text="hi"), _chunk(text="hi!"))
+
+    frames = await _drain(serving._generate_chat_stream(_adapted(), _chat_request(), None))
+
+    assert _deltas(frames) == ["", "h", "i", "!"]
+    assert frames[-1] == DONE_FRAME
+    serving.tokenizer_manager.abort_request.assert_not_called()
+
+
+async def test_every_rid_of_a_batch_request_is_aborted():
+    serving = _serving(_chunk(0), _chunk(1))
+    raw = _raw_request(False, True)
+    adapted = _adapted(rid=["r1", "r2"], text=["a", "b"])
+    assert adapted.is_single is False
+
+    frames = await _drain(serving._generate_chat_stream(adapted, _chat_request(), raw))
+
+    assert serving.tokenizer_manager.abort_request.call_args_list == [
+        mock.call("r1"),
+        mock.call("r2"),
+    ]
+    assert DONE_FRAME not in frames
+
+
+async def test_disconnect_before_the_first_token_is_a_499_not_a_500():
+    serving = _serving(_chunk(), _chunk())
+    # Once for the loop's poll, once for the handler re-checking that the client
+    # really is the reason the generator was empty.
+    raw = _raw_request(True, True)
+
+    response = await serving._handle_streaming_request(
+        _adapted(), _chat_request(), raw
+    )
+
+    assert response.status_code == 499
+    assert raw.is_disconnected.await_count == 2
+    serving.tokenizer_manager.abort_request.assert_called_once_with(RID)
+
+
+async def test_empty_stream_with_the_client_still_there_is_a_500():
+    # A generator that never yields a first chunk. `_generate_chat_stream`
+    # cannot currently produce one - after an empty loop it still yields the
+    # `[DONE]` terminator, so the only empty-generator case is the disconnect
+    # above - but the handler's contract for an empty generator must not be
+    # "client disconnected" when the client is demonstrably still there.
+    serving = _serving(_chunk(), _chunk())
+    serving._generate_chat_stream = lambda *a, **k: _contents()
+    raw = _raw_request(False)
+
+    response = await serving._handle_streaming_request(
+        _adapted(), _chat_request(), raw
+    )
+
+    assert response.status_code == 500
+    assert raw.is_disconnected.await_count == 1
+    serving.tokenizer_manager.abort_request.assert_not_called()
