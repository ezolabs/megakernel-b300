+
+def _hash(i):
+    return f"{0x1234_5678_9abc + i:016x}"
+
+
+def _padded(out, hashes):
+    for item, h in zip(out.mm_items, hashes):
+        item.set_hash(int(h, 16))
+        item.set_pad_value()
+    mm_inputs = MultimodalInputs(mm_items=out.mm_items)
+    return list(pad_mm_tokens(array("q", out.input_ids), mm_inputs))
