+
+``_dsv41_render_image_urls`` hands the multimodal processor the request's images in the
+order the deepseek-recipe render places their placeholders. It used to run the whole
+messages-path encode for that, tokenizing a ~400k-token prompt (single-threaded in the
+engine) to learn an order the render already holds. It now stops at the render: the
+order, and the requests that fall back to message order, are the full encode's. A task
+or a reopened final turn is checked on the prompt ids, so those still take the encode.
+"""
+
+from __future__ import annotations
+
+import base64
+import io
+
+import pytest
+from PIL import Image
+from test_w_chat_input_ids_parity import (  # noqa: F401 (fixtures)
+    _image_records,
+    _mm_chat,
+    _published_serving_config,
+    box_c_env,
+    tokenizer,
+)
+
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.entrypoints.openai.serving_chat import ThinkingMode
+from sglang.srt.parser import deepseek_recipe_renderer
+from sglang.srt.parser.deepseek_recipe_renderer import DeepSeekRecipe
+
+
+class _CountingEncoding:
+    """recipe's prompt encoding, counting the prompts it tokenizes."""
+
+    def __init__(self, inner):
+        self.inner = inner
+        self.encodes = 0
+
+    def encode(self, conversation):
+        self.encodes += 1
+        return self.inner.encode(conversation)
+
+    def render_conversation(self, conversation):
+        return self.inner.render_conversation(conversation)
+
+
+@pytest.fixture
+def chat(tokenizer, box_c_env):
+    chat = _mm_chat(tokenizer)
+    recipe = chat._encoding_adapter.deepseek_recipe
+    recipe._encoding = _CountingEncoding(recipe._encoding)
+    return chat
+
+
+def _encodes(chat):
+    return chat._encoding_adapter.deepseek_recipe._encoding.encodes
+
+
+def _full_encode_order(chat, request):
+    """The order as the handler took it before: the whole messages-path encode, and
+    message order for a request it refuses."""
+    thinking_mode = (
+        ThinkingMode.THINKING
+        if chat._thinking_requested(request)
+        else ThinkingMode.CHAT
+    )
+    image_data = []
+    try:
+        chat._encode_messages(
+            [message.model_dump() for message in request.messages],
+            request,
+            thinking_mode,
+            image_data=image_data,
+        )
+    except ValueError:
+        return chat._message_image_urls(request)
+    return [getattr(image, "url", image) for image in image_data]
+
+
+def _both(chat, body):
+    """(new order, old order, prompts the new one tokenized)."""
+    request = ChatCompletionRequest(**body)
+    before = _encodes(chat)
+    new = chat._dsv41_render_image_urls(request)
+    encodes = _encodes(chat) - before
+    return new, _full_encode_order(chat, ChatCompletionRequest(**body)), encodes
+
+
+def _data_url(fmt, shade):
+    buffer = io.BytesIO()
+    Image.new("RGB", (28, 28), (shade, 255 - shade, 7)).save(buffer, format=fmt)
+    mime = {"PNG": "image/png", "JPEG": "image/jpeg", "BMP": "image/bmp"}[fmt]
+    return f"data:{mime};base64,{base64.b64encode(buffer.getvalue()).decode()}"
+
+
+IMAGES = [_data_url("PNG", 30 * k) for k in range(6)]
+BMP = _data_url("BMP", 200)
+JPEG = _data_url("JPEG", 120)
+
+
+def _image(url):
+    return {"type": "image_url", "image_url": {"url": url}}
+
+
+def _text(text):
+    return {"type": "text", "text": text}
+
+
+TOOLS = [
+    {
+        "type": "function",
+        "function": {
+            "name": "lookup",
+            "description": "Look a thing up.",
+            "parameters": {"type": "object", "properties": {"q": {"type": "string"}}},
+        },
+    }
+]
+
+
+def _call(call_id):
+    return {
+        "id": call_id,
+        "type": "function",
+        "function": {"name": "lookup", "arguments": '{"q": "x"}'},
+    }
+
+
+def _tool_turns(answer_order):
+    """A user image, two calls, their answers (each with an image) in `answer_order`, and
+    a closing user image: the render moves the answers into call order."""
+    answers = {
+        "call_a": {
+            "role": "tool",
+            "tool_call_id": "call_a",
+            "content": [_text("result of call a"), _image(IMAGES[1])],
+        },
+        "call_b": {
+            "role": "tool",
+            "tool_call_id": "call_b",
+            "content": [_text("result of call b"), _image(IMAGES[2])],
+        },
+    }
+    return [
+        {"role": "user", "content": [_text("look"), _image(IMAGES[0])]},
+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [_call("call_a"), _call("call_b")],
+        },
+        *(answers[call] for call in answer_order),
+        {"role": "user", "content": [_image(IMAGES[3]), _text("and this")]},
+    ]
+
+
+def _thinking(body, effort=None):
+    body = dict(body, chat_template_kwargs={"thinking": True})
+    if effort is not None:
+        body["reasoning_effort"] = effort
+    return body
+
+
+# A request's numeric reasoning_effort is a float in [0, 0.99] (budget 1..99); the
+# server default may be an integer budget.
+NUMERIC_EFFORTS = [0.0, 0.01, 0.3, 0.75, 0.99]
+SEVERAL_PER_MESSAGE = {
+    "model": "m",
+    "messages": [
+        {
+            "role": "user",
+            "content": [
+                _text("one"),
+                _image(IMAGES[0]),
+                _image(IMAGES[1]),
+                _text("two"),
+                _image(IMAGES[2]),
+            ],
+        },
+        {"role": "assistant", "content": "seen"},
+        {"role": "user", "content": [_image(IMAGES[3]), _text("three")]},
+    ],
+}
+OUT_OF_CALL_ORDER = {
+    "model": "m",
+    "messages": _tool_turns(["call_b", "call_a"]),
+    "tools": TOOLS,
+}
+BODIES = {
+    "several_per_message": SEVERAL_PER_MESSAGE,
+    "tool_results_in_call_order": {
+        "model": "m",
+        "messages": _tool_turns(["call_a", "call_b"]),
+        "tools": TOOLS,
+    },
+    "tool_results_out_of_call_order": OUT_OF_CALL_ORDER,
+    "named_tool_choice": dict(
+        OUT_OF_CALL_ORDER,
+        tool_choice={"type": "function", "function": {"name": "lookup"}},
+    ),
+    "required_tool_choice": dict(OUT_OF_CALL_ORDER, tool_choice="required"),
+    "system_image": {
+        "model": "m",
+        "messages": [
+            {"role": "system", "content": [_text("sys"), _image(IMAGES[4])]},
+            {"role": "user", "content": [_image(IMAGES[5]), _text("hi")]},
+        ],
+    },
+    "bmp_and_jpeg": {
+        "model": "m",
+        "messages": [
+            {"role": "user", "content": [_image(BMP), _text("x"), _image(JPEG)]},
+            {"role": "assistant", "content": "ok"},
+            {"role": "user", "content": [_image(IMAGES[0])]},
+        ],
+    },
+    "continued_final_turn": {
+        "model": "m",
+        "messages": [
+            *SEVERAL_PER_MESSAGE["messages"],
+            {"role": "assistant", "content": "The images show"},
+        ],
+    },
+    "thinking": _thinking(OUT_OF_CALL_ORDER),
+    "thinking_named_effort": _thinking(OUT_OF_CALL_ORDER, "high"),
+    **{
+        f"thinking_effort_{effort}": _thinking(OUT_OF_CALL_ORDER, effort)
+        for effort in NUMERIC_EFFORTS
+    },
+    "chat_numeric_effort": dict(OUT_OF_CALL_ORDER, reasoning_effort=0.4),
+}
+TASK = dict(SEVERAL_PER_MESSAGE, task="action")
+# recipe refuses a continued turn beside declared tools, so it is rendered completed and
+# reopened on the prompt ids. The image order renders without tools, save the named
+# choice's (thinking mode: no calls block prefilled).
+REOPENED = _thinking(
+    dict(
+        BODIES["continued_final_turn"],
+        tools=TOOLS,
+        tool_choice={"type": "function", "function": {"name": "lookup"}},
+    )
+)
+
+
+def test_the_recorded_image_bodies_keep_their_order_without_an_encode(chat):
+    for record in _image_records():
+        new, old, encodes = _both(chat, record["egress"])
+        assert new == old, record["id"]
+        assert encodes == 0, record["id"]
+
+
+@pytest.mark.parametrize("name", sorted(BODIES))
+def test_the_order_is_the_full_encodes(chat, name):
+    new, old, encodes = _both(chat, BODIES[name])
+    assert new == old
+    assert len(new) == len(
+        chat._message_image_urls(ChatCompletionRequest(**BODIES[name]))
+    )
+    assert encodes == 0
+
+
+def test_the_render_moves_the_tool_results_into_call_order(chat):
+    """The cases above tell a render order from message order."""
+    new, _, _ = _both(chat, OUT_OF_CALL_ORDER)
+    assert new == [IMAGES[0], IMAGES[1], IMAGES[2], IMAGES[3]]
