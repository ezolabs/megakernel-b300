+            with self.subTest(name=name, arguments=arguments, mode="one-shot"):
+                _, calls = self._parser().parse_non_stream(content)
+                self.assertEqual(
+                    [(c.name, json.loads(c.parameters)) for c in calls], expected
+                )
+            for chunk_size in CHUNK_SIZES:
+                with self.subTest(name=name, arguments=arguments, chunk=chunk_size):
+                    parser = self._parser()
+                    calls = []
+                    for i in range(0, len(content), chunk_size):
+                        _, delta = parser.parse_stream_chunk(
+                            content[i : i + chunk_size]
+                        )
+                        calls.extend(delta)
+                    _, delta = parser.parse_stream_end()
+                    calls.extend(delta)
+                    self.assertEqual(_assemble(calls), expected)
