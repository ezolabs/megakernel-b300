+def _arrive(rid="r1", length=8, cached=5, age=1.0, **kwargs) -> Req:
+    """A request as the scheduler has it after the extend was queued: the tokenizer's
+    three stamps, ``sched_recv``, ``match_prefix_done`` and ``alloc_done``."""
+    stats = _wire(_tokenizer_stats(time.perf_counter() - age))
+    req = _req(stats, rid, length, **kwargs)
+    req.cached_tokens = cached
+    req.sbr_phase.mark_once("match_prefix_done")
+    spt.mark_batch([req], "alloc_done")
+    return req
