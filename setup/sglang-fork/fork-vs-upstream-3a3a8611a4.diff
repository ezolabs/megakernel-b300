+def test_detail_off_the_line_is_0038s_line_byte_for_byte(timer, caplog):
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    # A fixed-stamp request: every stamp is pinned, so the line is a constant.
+    req = _req(_wire(_tokenizer_stats(100.0)), rid="fixed", length=8)
+    req.cached_tokens = 5
+    req.sbr_phase.stamps.update(
+        {
+            "sched_recv": 100.003,
+            "match_prefix_done": 100.004,
+            "alloc_done": 100.006,
+            "first_token": 100.010,
+            "finished": 100.011,
+        }
+    )
+    req.finished = lambda: True
+    spt.log_finished(req)
+    (line,) = _lines(caplog, "sbr-phase")
+    assert line == (
+        "sbr-phase rid=fixed prompt_len=8 cached_len=5 uncached_len=3 "
+        "recv_to_tokenize_done_ms=1.000 tokenize_done_to_dispatch_ms=1.000 "
+        "dispatch_to_sched_recv_ms=1.000 sched_recv_to_match_prefix_done_ms=1.000 "
+        "match_prefix_done_to_alloc_done_ms=2.000 alloc_done_to_first_token_ms=4.000 "
+        "first_token_to_finished_ms=1.000 wall_ms=11.000"
+    )
+    assert line == _format_line_0038("fixed", 8, 5, req.sbr_phase.stamps)
+    assert LINE_RE_0038.match(line)
+
