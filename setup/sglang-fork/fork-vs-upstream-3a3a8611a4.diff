+++ b/test/srt/sbr/test_0030_abort_echo_counts.py
@@ -0,0 +1,411 @@
+"""0030 - an abort echo carries the prompt, so an aborted prefill's usage is not 0.
+
+A request aborted while the scheduler still holds it outside a running batch is
+answered with an ``AbortReq`` echo, and ``TokenizerManager._handle_abort_req``
+turns that echo into the stream's last output. The echo carried no token
+counts, so the ``meta_info`` it built had none either, and
+``OpenAIServingChat._generate_chat_stream`` read ``prompt_tokens`` and
+``cached_tokens`` as 0: a stream with ``stream_options.include_usage`` that is
+aborted (``POST /abort_request``) between two chunks of a long prefill, or while
+the short-prefill chunk swap has it parked, ended on
+``{"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}`` however
+many tokens it was admitted with and however much of them was prefilled.
+
+The echo now carries ``prompt_tokens`` (``len(origin_input_ids)``),
+``cached_tokens`` and ``cached_tokens_details`` -- exactly what a finished
+batch output reports -- for a request that has been in an extend batch
+(``already_computed`` set, or ``retracted_stain`` after a retract), and the
+tokenizer copies them into ``meta_info``. A request popped from the waiting
+queue before its first batch did no work: its echo still carries none, and its
+usage still says 0.
+
+Pinned through the real ``Scheduler._tear_down_chunked_request`` and
+``Scheduler.abort_request`` (on a scheduler assembled attribute by attribute,
+real ``Req`` objects), the real IPC codec, the real
+``TokenizerManager._handle_abort_req`` and the real ``_generate_chat_stream``.
+What ``prepare_for_extend`` records at a request's first chunk is set by hand
+(``_prefilled``); a retract is the real ``Req.reset_for_retract``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from array import array
+from types import SimpleNamespace
+from unittest import mock
+from unittest.mock import MagicMock
+
+import pytest
+
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.entrypoints.openai import serving_chat as sc
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest
+from sglang.srt.managers import scheduler as scheduler_module
+from sglang.srt.managers.io_struct import (
+    AbortReq,
+    GenerateReqInput,
+    msgpack_decode,
+    msgpack_encode,
+)
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.managers.scheduler import Scheduler
+from sglang.srt.managers.scheduler_components.output_streamer import (
+    SchedulerOutputStreamer,
+)
+from sglang.srt.managers.tokenizer_manager import ReqState, TokenizerManager
+from sglang.srt.sampling.sampling_params import SamplingParams
+from _chat_serving_stub import init_chat_serving_defaults
+
+DONE_FRAME = "data: [DONE]\n\n"
+
+# A giant cut between two 4,096-token chunks, as #7399's 847,957-token request
+# was: a 2,048-token prefix hit (1,536 on the device, 512 loaded from the host
+# tier), five chunks prefilled.
+PROMPT = 30_000
+CACHED, CACHED_DEVICE, CACHED_HOST = 2048, 1536, 512
+COMPUTED = CACHED + 5 * 4096
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's chat stream reads get_serving(), which needs a published
+    # config in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+@pytest.fixture(autouse=True)
+def _serving_config():
+    # ``_make_abort_req`` reads the serving weight version; no server is
+    # published here.
+    with mock.patch.object(
+        scheduler_module,
+        "get_serving",
+        return_value=SimpleNamespace(weight_version="default"),
+    ):
+        yield
+
+
+def _req(rid, length=PROMPT):
+    return Req(rid, "", array("q", range(1, length + 1)), SamplingParams())
+
+
+def _prefilled(req, cached=CACHED, device=CACHED_DEVICE, host=CACHED_HOST):
+    """What ``ScheduleBatch.prepare_for_extend`` leaves on a request that has
+    been scheduled: its prefix hit (counted once, at the first chunk, with the
+    tier split) and ``already_computed`` = the sequence length scheduled."""
+    req.cached_tokens = cached
+    req.cached_tokens_device, req.cached_tokens_host = device, host
+    req._cache_breakdown_computed = True
+    req.already_computed = COMPUTED
+    return req
+
+
+def _scheduler(waiting=()):
+    """A ``Scheduler`` with what the two abort paths read; echoes are recorded."""
+    s = Scheduler.__new__(Scheduler)
+    s.rust_server = None
+    s.sent = []
+    s.ipc_channels = SimpleNamespace(
+        send_to_tokenizer=SimpleNamespace(
+            send_output=lambda out, req=None: s.sent.append(out)
+        )
+    )
+    s.output_streamer = SchedulerOutputStreamer(
+        send_to_detokenizer=MagicMock(),
+        tree_cache=MagicMock(),
+        server_args=MagicMock(),
+        is_generation=True,
+        spec_algorithm=MagicMock(),
+        disaggregation_mode=DisaggregationMode.NULL,
+        enable_hicache_storage=lambda: False,
+    )
+    s.disaggregation_mode = DisaggregationMode.NULL
+    s.enable_hierarchical_cache = False
+    s.enable_hicache_storage = False
+    s.enable_unified_cache_external_linker = False
+    s.tree_cache = MagicMock()
+    s.chunked_req = None
+    s._pending_chunked_abort_req = None
+    s.mm_receiver = None
+    s.waiting_queue = list(waiting)
+    s.beam_coordinator = MagicMock()
+    s.dllm_config = None
+    s.grammar_manager = MagicMock()
+    s.collect_inflight_reqs = lambda: set()
+    return s
+
+
+def _tear_down(req):
+    """The echo the real chunked-prefill teardown sends for ``req``."""
+    s = _scheduler()
+    with (
+        mock.patch.object(scheduler_module, "prepare_abort"),
+        mock.patch.object(scheduler_module, "release_kv_cache"),
+    ):
+        Scheduler._tear_down_chunked_request(s, req)
+    (echo,) = s.sent
+    return echo
+
+
+def _queue_abort(req):
+    """The echo the real ``abort_request`` sends for ``req`` in the queue."""
+    s = _scheduler(waiting=[req])
+    Scheduler.abort_request(s, AbortReq(rid=req.rid))
+    assert s.waiting_queue == []
+    (echo,) = s.sent
+    return echo
+
+
+def _wire(echo):
+    """The echo as the tokenizer receives it (scheduler -> tokenizer codec)."""
+    return msgpack_decode(msgpack_encode(echo))
+
+
+def _counts(echo):
+    return tuple(
+        getattr(echo, f, None)
+        for f in ("prompt_tokens", "cached_tokens", "cached_tokens_details")
+    )
+
+
+# --- scheduler: what the echo carries --------------------------------------
+
+
+def test_a_chunked_teardown_echo_carries_the_prompt_and_its_cache_hit():
+    echo = _tear_down(_prefilled(_req("giant")))
+    assert isinstance(echo, AbortReq) and echo.rid == "giant"
+    assert _counts(echo) == (
+        PROMPT,
+        CACHED,
+        {"device": CACHED_DEVICE, "host": CACHED_HOST},
+    )
+
+
+def test_a_cold_prefill_reports_a_zero_hit_and_no_details():
+    # Prefilled with nothing cached: the count is still the whole prompt, the
+    # hit is 0 and, as on a finished output, there is no tier breakdown.
+    echo = _tear_down(_prefilled(_req("cold"), cached=0, device=0, host=0))
+    assert _counts(echo) == (PROMPT, 0, None)
+
+
+def test_a_scheduler_without_an_output_streamer_still_sends_the_counts():
+    # Stand-in schedulers predate the streamer's use here: the counts come
+    # from the request alone, only the tier breakdown needs the streamer.
+    s = _scheduler()
+    del s.output_streamer
+    with (
+        mock.patch.object(scheduler_module, "prepare_abort"),
+        mock.patch.object(scheduler_module, "release_kv_cache"),
+    ):
+        Scheduler._tear_down_chunked_request(s, _prefilled(_req("giant")))
+    (echo,) = s.sent
+    assert _counts(echo) == (PROMPT, CACHED, None)
+
+
+def test_a_retracted_request_popped_from_the_queue_still_carries_its_prompt():
+    # Retracted back into the waiting queue after it decoded: a retract zeroes
+    # already_computed, but the request was prefilled and its stream reported
+    # the prompt on every chunk; the abort echo must not reset it to 0.
+    req = _prefilled(_req("retracted"))
+    req.output_ids = [7, 8, 9]
+    req.reset_for_retract()
+    assert req.already_computed == 0 and req.retracted_stain
+    echo = _queue_abort(req)
+    assert _counts(echo) == (
+        PROMPT,
+        CACHED,
+        {"device": CACHED_DEVICE, "host": CACHED_HOST},
+    )
+
+
+def test_a_queue_pop_before_any_batch_carries_no_counts():
+    # Control: never scheduled, no work done -- nothing to count.
+    echo = _queue_abort(_req("queued"))
+    assert echo.rid == "queued"
+    assert _counts(echo) == (None, None, None)
+
+
+def test_the_counts_cross_the_ipc_codec():
+    echo = _wire(_tear_down(_prefilled(_req("giant"))))
+    assert isinstance(echo, AbortReq)
+    assert _counts(echo) == (
+        PROMPT,
+        CACHED,
+        {"device": CACHED_DEVICE, "host": CACHED_HOST},
+    )
+    # Control: the request-direction AbortReq the tokenizer sends is unchanged.
+    request = _wire(AbortReq(rid="r", abort_all=False))
+    assert request.rid == "r" and _counts(request) == (None, None, None)
+
+
+# --- tokenizer: the echo becomes the stream's last output -------------------
+
+
+def _tokenizer(rid):
+    tm = TokenizerManager.__new__(TokenizerManager)
+    tm.incremental_streaming_output = False
+    tm.config_value = lambda name: "default"
+    tm.enable_lora = False  # upstream's abort path releases a LoRA once
+    state = ReqState(
+        out_list=[],
+        finished=False,
+        event=asyncio.Event(),
+        obj=SimpleNamespace(stream=True, return_logprob=False),
+        time_stats=MagicMock(**{"get_e2e_latency.return_value": 61.9}),
+    )
+    tm.rid_to_state = {rid: state}
+    return tm, state
+
+
+def _abort_output(echo):
+    """The output ``_handle_abort_req`` appends for the echo as received."""
+    echo = _wire(echo)
+    tm, state = _tokenizer(echo.rid)
+    TokenizerManager._handle_abort_req(tm, echo)
+    assert state.finished and echo.rid not in tm.rid_to_state
+    (out,) = state.out_list
+    return out
+
+
+def test_the_abort_output_states_the_prompt_and_the_cache_hit():
+    meta = _abort_output(_tear_down(_prefilled(_req("giant"))))["meta_info"]
+    assert meta["finish_reason"] == {"type": "abort", "message": "Abort in waiting queue"}
+    assert meta["prompt_tokens"] == PROMPT
+    assert meta["cached_tokens"] == CACHED
+    assert meta["cached_tokens_details"] == {
+        "device": CACHED_DEVICE,
+        "host": CACHED_HOST,
+    }
+    assert meta["completion_tokens"] == 0
+
+
+def test_a_queue_pop_output_has_no_counts_as_before():
+    # Control: the old meta_info, keys and values.
+    meta = _abort_output(_queue_abort(_req("queued")))["meta_info"]
+    assert set(meta) == {
+        "id",
+        "finish_reason",
+        "weight_version",
+        "weight_versions",
+        "e2e_latency",
+        "completion_tokens",
+    }
+    assert meta["completion_tokens"] == 0
+
+
+# --- serving_chat: the include_usage frame the stream ends on ---------------
+
+
+def _serving(out, enable_cache_report):
+    async def _contents():
+        yield out
+
+    serving = init_chat_serving_defaults(sc.OpenAIServingChat.__new__(sc.OpenAIServingChat))
+    serving.tokenizer_manager = MagicMock()
+    serving.tokenizer_manager.generate_request = lambda *a, **k: _contents()
+    serving.tokenizer_manager.server_args = SimpleNamespace(
+        incremental_streaming_output=False,
+        stream_response_default_include_usage=False,
+        return_input_ids=False,
+        return_output_ids=False,
+        enable_cache_report=enable_cache_report,
+    )
+    serving.chat_encoding_spec = None
+    serving.reasoning_parser = None
+    serving.tool_call_parser = None
+    return serving
+
+
+async def _stream(echo, enable_cache_report=True, include_usage=True):
+    out = _abort_output(echo)
+    out["index"] = 0
+    rid = out["meta_info"]["id"]
+    adapted = GenerateReqInput(rid=rid, text="hi")
+    adapted.normalize_batch_and_arguments()
+    request = ChatCompletionRequest(
+        model="sbr-test-model",
+        messages=[{"role": "user", "content": "hi"}],
+        stream=True,
+        stream_options={"include_usage": include_usage},
+    )
+    raw = MagicMock()
+    raw.headers = {}
+    raw.is_disconnected = mock.AsyncMock(return_value=False)
+    # Upstream reads enable_cache_report off the published serving config.
+    from sglang.srt.runtime_context import get_context
+
+    with get_context().override_server_args(
+        model_path="dummy", enable_cache_report=enable_cache_report
+    ):
+        gen = _serving(out, enable_cache_report)._generate_chat_stream(
+            adapted, request, raw
+        )
+        return [frame async for frame in gen]
+
+
+def _payloads(frames):
+    out = []
+    for frame in frames:
+        assert frame.startswith("data: "), frame
+        body = frame[len("data: ") :].strip()
+        out.append(None if body == "[DONE]" else json.loads(body))
+    return out
+
+
+def _usage(frames):
+    (usage,) = [p["usage"] for p in _payloads(frames) if p and p.get("usage")]
+    return usage
+
+
+def _finish_reasons(frames):
+    return [
+        c.get("finish_reason")
+        for p in _payloads(frames)
+        if p
+        for c in p.get("choices") or []
+        if c.get("finish_reason")
+    ]
+
+
+async def test_an_aborted_prefill_ends_on_a_usage_frame_that_states_the_prompt():
+    frames = await _stream(_tear_down(_prefilled(_req("giant"))))
+    assert frames[-1] == DONE_FRAME
+    assert _finish_reasons(frames) == ["abort"]
+    usage = _usage(frames)
+    assert usage["prompt_tokens"] == PROMPT
+    assert usage["completion_tokens"] == 0
+    assert usage["total_tokens"] == PROMPT
+    assert usage["prompt_tokens_details"]["cached_tokens"] == CACHED
+
+
+async def test_without_cache_report_the_frame_still_counts_the_prompt():
+    usage = _usage(
+        await _stream(_tear_down(_prefilled(_req("giant"))), enable_cache_report=False)
+    )
+    assert (usage["prompt_tokens"], usage["total_tokens"]) == (PROMPT, PROMPT)
+    assert usage.get("prompt_tokens_details") is None
+
+
+async def test_a_queue_pop_still_ends_on_a_zero_usage_frame():
+    # Control: no work, no count -- today's frame, unchanged.
+    frames = await _stream(_queue_abort(_req("queued")))
+    assert frames[-1] == DONE_FRAME
+    assert _finish_reasons(frames) == ["abort"]
+    usage = _usage(frames)
+    assert (usage["prompt_tokens"], usage["completion_tokens"]) == (0, 0)
+    assert usage["total_tokens"] == 0
+    # Upstream states the (zero) hit on every frame when cache report is on.
+    assert usage.get("prompt_tokens_details") == {"cached_tokens": 0}
+
+
+async def test_without_include_usage_there_is_no_usage_frame():
+    # Control: the counts never add a frame the client did not ask for.
+    frames = await _stream(_tear_down(_prefilled(_req("giant"))), include_usage=False)
+    assert frames[-1] == DONE_FRAME
+    assert not [p for p in _payloads(frames) if p and p.get("usage")]
diff --git a/test/srt/sbr/test_0038_phase_timing.py b/test/srt/sbr/test_0038_phase_timing.py
new file mode 100644
index 0000000000..d704a404eb
--- /dev/null
+++ b/test/srt/sbr/test_0038_phase_timing.py
@@ -0,0 +1,295 @@
+"""0038 - an env-gated per-request stage timer: one ``sbr-phase`` line per request.
+
+Off by default. With ``SGLANG_SBR_PHASE_TIMING`` unset, nothing is stamped, the
+pickled time-stats state keeps exactly its previous keys, and no line is logged.
+With it set, the tokenizer's three stamps travel inside the request's time-stats
+object, the scheduler adds its own, and each finished request logs one line whose
+stage deltas are non-negative and telescope to the wall time.
+
+Driven through the real ``APIServerReqTimeStats`` / ``DPControllerReqTimeStats``
+``__getstate__`` and ``__setstate__`` (a real pickle round trip), the real ``Req``
+constructor, the real batch hook ``mark_batch`` and the real ``log_finished``. The
+hooks read ``sbr_phase_timing.ENABLED`` at call time, so the flag is flipped with
+``monkeypatch`` on that module global. ``envs.SGLANG_SBR_PHASE_TIMING.get()`` reads
+the environment on each call and is covered on its own.
+"""
+
+from __future__ import annotations
+
+import logging
+import pickle
+import re
+import time
+from array import array
+
+import pytest
+
+from sglang.srt.environ import envs
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.observability import sbr_phase_timing as spt
+from sglang.srt.observability.req_time_stats import (
+    APIServerReqTimeStats,
+    DPControllerReqTimeStats,
+)
+from sglang.srt.sampling.sampling_params import SamplingParams
+
+PHASE_KEYS = {
+    "sbr_phase_recv_at",
+    "sbr_phase_tokenize_done_at",
+    "sbr_phase_dispatch_at",
+}
+BASE_KEYS = {"disagg_mode", "enable_metrics", "trace_ctx"}
+
+LINE_RE = re.compile(
+    r"^sbr-phase rid=(?P<rid>\S+) prompt_len=(?P<prompt>\d+) "
+    r"cached_len=(?P<cached>\d+) uncached_len=(?P<uncached>\d+)"
+    r"(?P<deltas>(?: [a-z_]+_ms=-?\d+\.\d{3})*)"
+    r" wall_ms=(?P<wall>-?\d+\.\d{3})$"
+)
+LOGGER_NAME = spt.logger.name
+
+
+def _tokenizer_stats(t0: float) -> APIServerReqTimeStats:
+    """The tokenizer's time stats for one request, stamped at t0, t0+1ms, t0+2ms."""
+    ts = APIServerReqTimeStats()
+    ts.created_time = t0
+    ts.tokenize_finish_time = t0 + 0.001
+    ts.api_server_dispatch_time = t0 + 0.002
+    return ts
+
+
+def _wire(obj):
+    """The object as the scheduler receives it: a real pickle round trip."""
+    return pickle.loads(pickle.dumps(obj))
+
+
+def _req(time_stats=None, rid="r1", length=8) -> Req:
+    return Req(
+        rid,
+        "",
+        array("q", range(1, length + 1)),
+        SamplingParams(),
+        time_stats=time_stats,
+    )
+
+
+def _sbr_records(caplog):
+    return [
+        r.getMessage()
+        for r in caplog.records
+        if r.name == LOGGER_NAME and r.getMessage().startswith("sbr-phase ")
+    ]
+
+
+# --- off (the default) -----------------------------------------------------------
+
+
+def test_flag_is_off_by_default(monkeypatch):
+    monkeypatch.delenv("SGLANG_SBR_PHASE_TIMING", raising=False)
+    assert envs.SGLANG_SBR_PHASE_TIMING.get() is False
+
+
+def test_flag_parses_its_boolean_spellings(monkeypatch):
+    for raw, want in [("1", True), ("true", True), ("0", False), ("no", False)]:
+        monkeypatch.setenv("SGLANG_SBR_PHASE_TIMING", raw)
+        assert envs.SGLANG_SBR_PHASE_TIMING.get() is want, raw
+
+
+def test_off_tokenizer_state_keeps_its_keys(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", False)
+    state = _tokenizer_stats(time.perf_counter()).__getstate__()
+    assert set(state) == BASE_KEYS
+    assert not (set(state) & PHASE_KEYS)
+
+
+def test_off_dp_controller_state_keeps_its_keys(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", False)
+    state = DPControllerReqTimeStats().__getstate__()
+    assert set(state) == BASE_KEYS
+    assert not (set(state) & PHASE_KEYS)
+
+
+def test_off_request_gets_no_stamps(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", False)
+    req = _req(_wire(_tokenizer_stats(time.perf_counter())))
+    assert req.sbr_phase is None
+
+
+def test_off_log_finished_is_silent(monkeypatch, caplog):
+    monkeypatch.setattr(spt, "ENABLED", False)
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    req = _req(None)
+    req.finished = lambda: True
+    spt.log_finished(req)
+    assert _sbr_records(caplog) == []
+
+
+def test_on_adds_exactly_three_keys_and_changes_no_other_value(monkeypatch):
+    ts = _tokenizer_stats(time.perf_counter())
+    monkeypatch.setattr(spt, "ENABLED", False)
+    off = ts.__getstate__()
+    monkeypatch.setattr(spt, "ENABLED", True)
+    on = ts.__getstate__()
+    assert set(on) - set(off) == PHASE_KEYS
+    assert {k: on[k] for k in off} == off
+
+
+# --- on ----------------------------------------------------------------------------
+
+
+def test_on_stamps_survive_the_pickle_round_trip_unshifted(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    t = time.perf_counter()
+    got = _wire(_tokenizer_stats(t))
+    assert got.__dict__["sbr_phase_recv_at"] == t
+    assert got.__dict__["sbr_phase_tokenize_done_at"] == t + 0.001
+    assert got.__dict__["sbr_phase_dispatch_at"] == t + 0.002
+
+
+def test_on_scheduler_request_reads_the_tokenizer_stamps(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    now = time.perf_counter()
+    req = _req(_wire(_tokenizer_stats(now - 1.0)))
+    stamps = req.sbr_phase.stamps
+    assert stamps["recv"] == now - 1.0
+    assert stamps["tokenize_done"] == now - 1.0 + 0.001
+    assert stamps["dispatch"] == now - 1.0 + 0.002
+    assert stamps["recv"] < stamps["tokenize_done"] < stamps["dispatch"]
+    assert stamps["dispatch"] < stamps["sched_recv"]
+
+
+def test_on_dp_controller_carries_the_stamps_to_the_scheduler(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    now = time.perf_counter()
+    dpc = DPControllerReqTimeStats.new_from_obj(_wire(_tokenizer_stats(now - 1.0)))
+    req = _req(_wire(dpc))
+    assert req.sbr_phase.stamps["recv"] == now - 1.0
+    assert req.sbr_phase.stamps["dispatch"] == now - 1.0 + 0.002
+
+
+def test_on_full_request_logs_one_line_with_telescoping_deltas(monkeypatch, caplog):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    now = time.perf_counter()
+    req = _req(_wire(_tokenizer_stats(now - 1.0)), rid="rid-7", length=8)
+    req.cached_tokens = 5
+    req.sbr_phase.mark_once("match_prefix_done")
+    spt.mark_batch([req], "alloc_done")
+    req.sbr_phase.mark_once("first_token")
+    req.finished = lambda: True
+    spt.log_finished(req)
+    spt.log_finished(req)  # the second call must not log again
+
+    lines = _sbr_records(caplog)
+    assert len(lines) == 1
+    m = LINE_RE.match(lines[0])
+    assert m, lines[0]
+    assert m["rid"] == "rid-7"
+    assert int(m["prompt"]) == 8
+    assert int(m["cached"]) == 5
+    assert int(m["uncached"]) == 3
+
+    names = re.findall(r"([a-z_]+)_ms=", m["deltas"])
+    assert names == [
+        "recv_to_tokenize_done",
+        "tokenize_done_to_dispatch",
+        "dispatch_to_sched_recv",
+        "sched_recv_to_match_prefix_done",
+        "match_prefix_done_to_alloc_done",
+        "alloc_done_to_first_token",
+        "first_token_to_finished",
+    ]
+    deltas = [float(x) for x in re.findall(r"_ms=(-?[\d.]+)", m["deltas"])]
+    assert all(d >= 0.0 for d in deltas)
+    wall = float(m["wall"])
+    assert wall >= 1000.0  # recv was stamped one second before the log
+    # Each value is rounded to 3 decimals in ms: the sum is within the rounding.
+    assert abs(sum(deltas) - wall) <= 0.0005 * (len(deltas) + 1) + 1e-9
+
+
+def test_on_request_without_tokenizer_hop_logs_scheduler_stages_only(
+    monkeypatch, caplog
+):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    req = _req(None, length=8)
+    req.finished = lambda: True
+    spt.log_finished(req)
+    lines = _sbr_records(caplog)
+    assert len(lines) == 1
+    m = LINE_RE.match(lines[0])
+    assert m, lines[0]
+    assert re.findall(r"([a-z_]+)_ms=", m["deltas"]) == ["sched_recv_to_finished"]
+    assert int(m["uncached"]) == 8 - req.cached_tokens
+
+
+def test_unfinished_request_logs_nothing_and_stays_unlogged(monkeypatch, caplog):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    req = _req(None)
+    req.finished = lambda: False
+    spt.log_finished(req)
+    assert _sbr_records(caplog) == []
+    assert req.sbr_phase.logged is False
+
+
+def test_mark_batch_skips_requests_that_carry_no_stamps(monkeypatch):
+    monkeypatch.setattr(spt, "ENABLED", True)
+    plain = _req(None, rid="plain")
+    plain.sbr_phase = None
+    stamped = _req(_wire(_tokenizer_stats(time.perf_counter())), rid="stamped")
+    spt.mark_batch([plain, stamped], "alloc_done")
+    assert plain.sbr_phase is None
+    assert "alloc_done" in stamped.sbr_phase.stamps
+
+
+def test_mark_once_keeps_the_first_stamp():
+    phase = spt.PhaseStamps()
+    phase.mark_once("alloc_done", 1.0)
+    phase.mark_once("alloc_done", 2.0)
+    assert phase.stamps["alloc_done"] == 1.0
+
+
+# --- the arithmetic, on fixed stamps -----------------------------------------------
+
+
+def test_deltas_are_non_negative_and_telescope_to_wall():
+    stamps = {
+        "finished": 5.0,
+        "recv": 1.0,
+        "alloc_done": 3.5,
+        "tokenize_done": 1.25,
+        "dispatch": 1.5,
+        "sched_recv": 2.0,
+        "match_prefix_done": 2.5,
+        "first_token": 4.0,
+    }
+    deltas, wall = spt.phase_deltas(stamps)
+    assert wall == 4.0
+    assert all(d >= 0.0 for _, d in deltas)
+    assert sum(d for _, d in deltas) == pytest.approx(wall, abs=1e-12)
+    assert [name for name, _ in deltas] == [
+        "recv_to_tokenize_done",
+        "tokenize_done_to_dispatch",
+        "dispatch_to_sched_recv",
+        "sched_recv_to_match_prefix_done",
+        "match_prefix_done_to_alloc_done",
+        "alloc_done_to_first_token",
+        "first_token_to_finished",
+    ]
+
+
+def test_unreached_stages_are_skipped_not_zeroed():
+    deltas, wall = spt.phase_deltas({"recv": 1.0, "dispatch": 1.5, "finished": 2.0})
+    assert deltas == [("recv_to_dispatch", 0.5), ("dispatch_to_finished", 0.5)]
+    assert wall == 1.0
+
+
+def test_a_single_reached_stage_has_no_deltas():
+    assert spt.phase_deltas({"sched_recv": 3.0}) == ([], 0.0)
+
+
+def test_format_line_splits_cached_and_uncached_prompt_tokens():
+    line = spt.format_line("x", 300, 120, {"recv": 0.0, "finished": 0.5})
+    assert line.startswith("sbr-phase rid=x prompt_len=300 cached_len=120 uncached_len=180 ")
+    assert line.endswith(" wall_ms=500.000")
diff --git a/test/srt/sbr/test_0039_phase_timing_detail.py b/test/srt/sbr/test_0039_phase_timing_detail.py
new file mode 100644
index 0000000000..9e540d8845
--- /dev/null
+++ b/test/srt/sbr/test_0039_phase_timing_detail.py
@@ -0,0 +1,1772 @@
+"""0039 - the stage timer past ``first_token``: cache insert, stream, send, the
+detokenizer and the API server, behind ``SGLANG_SBR_PHASE_TIMING_DETAIL``, and a runtime
+gate, ``SGLANG_SBR_PHASE_TIMING_GATE_FILE``.
+
+Off by default (the two flags unset, and 0038's ``SGLANG_SBR_PHASE_TIMING`` too), nothing
+changes. With 0038's flag on and the detail off, the scheduler's ``sbr-phase`` line is the
+0038 line byte for byte and no other line is logged. With the detail on, the scheduler
+stamps five more stages between ``first_token`` and ``finished``, the detokenizer logs one
+``sbr-phase-detok`` line and the tokenizer manager one ``sbr-phase-api`` line per request at
+its first output. The gate makes the timer (0038's stamps and 0039's) active only while a
+path exists, looked up at most once a second.
+
+Driven through the real functions, CPU only, no server and no GPU:
+
+* ``SchedulerBatchResultProcessor.process_batch_result_prefill`` on a minimal fake batch
+  (real ``Req`` objects, the allocator, tree cache and the cache insert replaced by
+  stand-ins) into the real ``SchedulerOutputStreamer._stream_output_generation`` with a
+  recording sender: the cache hooks, ``stream_start``, ``payload_built``, ``first_send``,
+  ``log_finished``;
+* the real ``DetokenizerManager.handle_batch_token_id_out`` / ``_decode_batch_token_id_output``
+  with a fake tokenizer, framed the way ``event_loop`` frames it (``sbr_detok_begin`` after
+  the receive, ``detok_end`` after the send);
+* the real ``OpenAIServingBase.handle_request`` (validation and conversion stubbed), the
+  real ``TokenizerManager.generate_request`` / ``_tokenize_one_request`` /
+  ``_handle_batch_output`` (the scheduler round trip, the dispatch and the tokenizer replaced
+  by stand-ins) for the ``sbr-phase-api`` line;
+* the real ``Scheduler.init_batch_result_processor`` for the start-up ``sbr-phase-cache`` line.
+
+The flags are read at call time from the module globals ``ENABLED`` / ``DETAIL`` /
+``GATE_FILE``, so the tests flip them with ``monkeypatch``; the gate's clock and ``stat`` are
+module attributes too, so the one-per-second rule is counted, not timed.
