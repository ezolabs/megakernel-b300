+    # The SWA budget charges the replay, so the gate refuses it first ...
+    assert adder._swa_rebuild_charge(req) == SPAN
+    res = adder.add_one_req(req, has_chunked_req=False, truncation_align_size=None)
+    assert res == AddReqResult.NO_TOKEN
+    assert not req.swa_rebuild_declined
+    # ... and past the gate, a failed allocation declines it, tree untouched.
+    with mock.patch.object(PrefillAdder, "_swa_rebuild_charge", return_value=0):
+        res = adder.add_one_req(req, has_chunked_req=False, truncation_align_size=None)
+    assert res == AddReqResult.OTHER
+    assert req.swa_rebuild_declined and req.swa_rebuild is None
+    assert req not in adder.can_run_list and adder.log_swa_rebuild_tokens == 0
+    assert _swa_node(tree, node).value is None
+    assert alloc.swa_available_size() >= 3  # nothing allocated and kept
+    assert len(tree.tree_core.node_by_id(node).key) == BRANCH  # not split
+    # Next pass: the SWA-valid match, as without the flag.
+    req.init_next_round_input(tree)
+    assert req.swa_rebuild_match is None and req.prefix_len == 0
+    tree.sanity_check()
