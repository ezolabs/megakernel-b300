+# --------------------------------------------------------------------------
+# Parallel workers, one tokenizer copy each
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("workers", [3, 1])
+async def test_small_lane_workers_run_in_parallel_each_on_its_own_copy(
+    workers, lanes_config
+):
+    lanes_config(workers=workers, giant_chars=0)
+    tokenizer = _HeldTokenizer()
+    chat = _chat(tokenizer)
+    record = tokenizer.record
+    held = [f"h{i}" for i in range(4)]
+    for name in held:
+        record.gate(name)
+
+    tasks = [
+        asyncio.create_task(
+            chat.handle_request(
+                _request(f"rid-{name}", f"<<hold:{name}>>"), _raw_request()
+            )
+        )
+        for name in held
+    ]
+    # Let every worker pick up what it can.
+    deadline = time.perf_counter() + WAIT_S
+    while record.in_flight < min(workers, len(held)) and time.perf_counter() < deadline:
+        await asyncio.sleep(0.005)
+    await asyncio.sleep(0.1)
+    in_flight = record.in_flight
+    lane = preprocess_lanes.get_lanes().small
+    queued = lane.waiting
+    for name in held:
+        record.gates[name].set()
+    await asyncio.wait_for(asyncio.gather(*tasks), WAIT_S)
+
+    copy_ids = {copy_id for _, copy_id, _ in record.encodes}
+    threads = {name for name, _, _ in record.encodes}
+    if workers == 3:
+        assert in_flight == 3 and queued == 1
+        assert record.max_in_flight == 3
+        # One copy per worker, made at startup; never the manager's own (0).
+        assert lane.copies(chat.tokenizer_manager) == 3
+        assert record.copies == 3
+        assert 0 not in copy_ids and len(copy_ids) == 3
+        assert len(threads) == 3
+        # No copy was ever used by two threads at once.
+        assert record.max_per_copy == 1
+        assert chat.tokenizer_manager.tokenizer is tokenizer
+    else:
+        # Negative control: 0021's configuration, one worker on the manager's
+        # own tokenizer, one conversion at a time, no copy made.
+        assert in_flight == 1 and queued == 3
+        assert record.max_in_flight == 1
+        assert copy_ids == {0} and record.copies == 0
+        assert len(threads) == 1
+    assert sorted(a.rid for a in chat.tokenizer_manager.generated) == sorted(
+        f"rid-{n}" for n in held
+    )
