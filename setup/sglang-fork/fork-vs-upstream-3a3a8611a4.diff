+    assert "lora-cold" not in seen["warm"]
+    assert seen["warm-2"] >= {"lora-warm"} and "lora-cold" not in seen["warm-2"]
+
+
+def test_steps_over_only_a_truncation_refusal_with_room_left():
+    req, other = object(), object()
+    adder = SimpleNamespace(refused_truncation=req, rem_chunk_tokens=ROOM)
+    assert short_prefill.steps_over(adder, req, 0, LOOKAHEAD, preempted=False)
+    assert not short_prefill.steps_over(adder, other, 0, LOOKAHEAD, preempted=False)
+    assert not short_prefill.steps_over(
