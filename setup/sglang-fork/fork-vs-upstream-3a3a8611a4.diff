--- /dev/null
+++ b/python/sglang/srt/mem_cache/hicache_poll_gate.py
@@ -0,0 +1,132 @@
+"""When HiCache's per-step event poll runs its TP collective.
+
+``check_hicache_events`` runs on every scheduler step. On a TP group it
+builds a tensor of locally *ready* ack counts (write-through, load-back and,
+with storage, the storage control queues) and MIN-reduces it across the
+ranks, so that every rank drains the same number of acks. That reduction is
+a cross-rank rendezvous per step even when every queue is empty, beside the
+one ``recv_requests`` already runs (the request broadcast).
+
+The reduction is a MIN, so it can only drain something when *every* rank
+has something ready, in particular the broadcast source (TP rank 0). The
+gate uses that: rank 0 computes one bit, "I have a ready ack or a non-empty
+storage queue", and the request broadcast carries it to every rank
+(``broadcast_pyobj_with_flag``). The poll then runs its reduction only on a
+step that received the bit (or a later one, if that step did not reach the
+poll), plus one heartbeat every ``heartbeat_calls`` calls so that
+``write_back_duplicate_reclaim_digest``'s divergence assert, which rides the
+same reduction, still runs while no ack is ready.
+
+Every rank sees the same bit and counts the same calls, so every rank makes
+the same decision: the collective sequence stays identical across ranks by
+construction, not by the ranks happening to agree. A skipped poll is one
+whose reduction would have returned zeros (rank 0 had nothing ready when it
+sent the bit), so skipping it drains nothing that the old poll would have
+drained, except what became ready on rank 0 between the broadcast and the
+poll, which the next step's bit picks up: such an ack drains one step later
+than the per-step poll would have drained it, never more.
+
+A step whose receive is skipped (``SchedulerRecvSkipper``, with
+``--scheduler-recv-interval`` > 1) runs no broadcast, so no bit arrives. The
+receiver then calls ``note_receive_skipped`` and that step polls, as every
+step did before the gate. The decision to skip is itself the same on every
+rank (it must be, or the broadcast would not stay in lockstep). The input
+blocker never skips the broadcast: it only holds requests back, so the bit
+still rides every step's broadcast.
+
+The gate is armed only where the request broadcast spans exactly the group
+the poll reduces over: TP > 1, PP 1, no DP attention, no external linker
+(see ``Scheduler._maybe_arm_hicache_poll_gate``). Unarmed, every call polls,
+which is the old behaviour.
+"""
+
+from __future__ import annotations
+
+from typing import Callable, Optional
+
+
+class HiCachePollGate:
+    """Per-cache poll decision, identical on every rank of the TP group."""
+
+    __slots__ = (
+        "heartbeat_calls",
+        "armed",
+        "_local_hint_fn",
+        "_pending",
+        "_calls_since_poll",
+        "_unlogged_skips",
+        "polls",
+        "skips",
+    )
+
+    def __init__(
+        self,
+        local_hint_fn: Callable[[], bool],
+        heartbeat_calls: int,
+    ) -> None:
+        self.heartbeat_calls = int(heartbeat_calls)
+        self.armed = False
+        self._local_hint_fn = local_hint_fn
+        self._pending = False
+        self._calls_since_poll = 0
+        self._unlogged_skips = 0
+        self.polls = 0
+        self.skips = 0
+
+    def arm(self) -> None:
+        """Called by the scheduler, on every rank, when the request broadcast
+        carries the hint (see the module docstring for when that holds)."""
+        self.armed = True
+
+    def local_hint(self) -> bool:
+        """The bit the broadcast source sends. Rank-local; only the source's
+        value is ever used, so it must never decide anything on its own."""
+        return bool(self._local_hint_fn())
+
+    def note_hint(self, hint: int) -> None:
+        """Called on every rank with the bit the broadcast delivered."""
+        if hint:
+            self._pending = True
+
+    def note_receive_skipped(self) -> None:
+        """Called on every rank when this step's receive, and so its
+        broadcast, was skipped: no bit arrived, so the next poll runs."""
+        self._pending = True
+
+    def should_poll(self) -> bool:
+        """Called once per ``check_hicache_events``, on every rank."""
+        if not self.armed:
+            self.polls += 1
+            return True
+        self._calls_since_poll += 1
+        if self._pending or (
+            self.heartbeat_calls > 0 and self._calls_since_poll >= self.heartbeat_calls
+        ):
+            self._pending = False
+            self._calls_since_poll = 0
+            self.polls += 1
+            return True
+        self.skips += 1
+        self._unlogged_skips += 1
+        return False
+
+    def take_unlogged_skips(self) -> int:
+        skipped, self._unlogged_skips = self._unlogged_skips, 0
+        return skipped
+
+
+def log_poll_metrics(
+    metrics_collector: Optional[object], polled: bool, gate: HiCachePollGate
+) -> None:
+    """Flush the gate's counts to ``sglang:hicache_event_polls_total`` on a
+    poll (skips are batched into the next poll, so a skipped step costs no
+    metrics write)."""
+    if metrics_collector is None or not polled:
+        return
+    increment = getattr(metrics_collector, "increment_hicache_event_polls", None)
+    if increment is None:
+        return
+    increment(outcome="polled", count=1)
+    skipped = gate.take_unlogged_skips()
+    if skipped:
+        increment(outcome="skipped", count=skipped)
