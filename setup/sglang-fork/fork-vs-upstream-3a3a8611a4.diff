+        _, placeholder, _ = _convert_with_placeholder(chat, record)
+        expected = _history_tool_calls(record["egress"])
+        assert chat._get_history_tool_calls_cnt(real) == expected, record["id"]
+        assert chat._get_history_tool_calls_cnt(placeholder) == 0, record["id"]
+        with_history += expected > 0
+    assert with_history == 45
+    item = ToolCallItem(tool_index=1, name="f", parameters="{}")
+    with _counted_ids():
+        without = chat._process_tool_call_id(item, 0)
+    with _counted_ids():
