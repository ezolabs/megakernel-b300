+                        side.parents.append(parent)
+                        side.seeds.append(seed)
+                        side.lora_names.append(lora_name)
+                        side.hashes.append(hash_strs)
+                        side.raws.append(raw)
+                        side.lens.append(logical_len)
+                        side.bigrams.append(is_bigram)
+                        side.salts.append(cache_salt)
