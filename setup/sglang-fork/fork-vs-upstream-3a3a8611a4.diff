+    def test_work_per_delta_does_not_grow_with_the_call(self):
+        """Regex work stays linear in the length of the call, and each invoke
+        body is parsed whole once, at its closer (a re-parse per delta would be
+        quadratic)."""
+        for detector_cls in DETECTORS:
+            text, expected = _transcript(detector_cls, 60_000)
+            detector = detector_cls()
+            scanned = [0]
+
+            class _Counting:
+                def __init__(self, pattern):
+                    self.pattern = pattern
+
+                def search(self, string, pos=0, endpos=None):
+                    end = len(string) if endpos is None else endpos
+                    scanned[0] += end - pos
+                    return self.pattern.search(string, pos, end)
+
+                def match(self, string, pos=0, endpos=None):
+                    end = len(string) if endpos is None else endpos
+                    scanned[0] += end - pos
+                    return self.pattern.match(string, pos, end)
+
+            detector._invoke_header_re = _Counting(detector._invoke_header_re)
+            detector._param_header_re = _Counting(detector._param_header_re)
+            real_parse = detector_cls._parse_parameters_from_xml
+            with (
+                self.subTest(detector=detector_cls.__name__),
+                patch.object(
+                    detector_cls,
+                    "_parse_parameters_from_xml",
+                    autospec=True,
+                    side_effect=real_parse,
+                ) as parse,
+            ):
+                _, items = _stream(detector, text, 18, self.tools)
+                self.assertEqual(
+                    [(name, json.loads(args)) for name, args in _assemble(items)],
+                    expected,
+                )
+                self.assertEqual(parse.call_count, 3)
+                self.assertLess(scanned[0], 2 * len(text))
