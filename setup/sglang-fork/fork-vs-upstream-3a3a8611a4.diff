+class Dsv41ForcedToolCallTestCase(CustomTestCase):
+    """A DeepSeek-V4.1 forced tool call (named or required, chat mode) renders
+    its /v1/responses prompt through chat's ``_process_messages`` (recipe's
+    encoding adapter), so the prompt ends inside the opened calls block; the
+    Responses parsers then read the output as starting there, exactly as chat's
+    do. Each case compares the Responses output with chat's for the very Chat
+    request Responses rendered."""
+
+    DSML = "｜DSML｜"
+    PREFILL = "<｜Assistant｜></think>\n\n<｜DSML｜ calls>\n"
+
+    @classmethod
+    def setUpClass(cls):
+        from test_serving_deepseek_recipe import _tokenizer_file
+        from transformers import PreTrainedTokenizerFast
+
+        cls.tokenizer = PreTrainedTokenizerFast(tokenizer_file=_tokenizer_file())
+
+    def setUp(self):
+        reset_context()
+        self.addCleanup(reset_context)
+        # The store lets a case run in the background as well.
+        publish(
+            ServerArgs(model_path="dummy", enable_response_store=True),
+            role="tokenizer",
+        )
+        self.serving = make_serving()
+        self.serving.tokenizer_manager.tokenizer = self.tokenizer
+        self.serving.chat_encoding_spec = "dsv41"
+        self.serving.reasoning_parser = "deepseek-v41"
+        self.serving.tool_call_parser = "deepseekv41"
+        self.serving.default_chat_template_kwargs = {}
+        self.serving.template_manager.chat_template_name = None
+        self.serving.template_manager.jinja_template_content_format = "string"
+        self.serving._encoding_adapter = self.serving._build_chat_encoding_adapter()
+        # The Chat request each render used, for chat's side of the comparison.
+        self.chat_requests = []
+        process_messages = self.serving._process_messages
+
+        self.prompts = {}
+
+        def record(chat_request, is_multimodal, **kwargs):
+            self.chat_requests.append(chat_request)
+            processed = process_messages(chat_request, is_multimodal, **kwargs)
+            self.prompts[id(chat_request)] = processed.prompt_ids
+            return processed
+
+        self.serving._process_messages = record
+
+    @staticmethod
+    def _tool(name):
+        return {
+            "type": "function",
+            "name": name,
+            "description": f"The {name} tool.",
+            "parameters": {
+                "type": "object",
+                "properties": {"city": {"type": "string"}},
+                "required": ["city"],
+            },
+        }
+
+    @staticmethod
+    def _named(name="get_weather"):
+        return {"type": "function", "name": name}
+
+    # How a case is served: answered in full, streamed, or in the background.
+    MODES = {
+        "full": {},
+        "stream": {"stream": True},
+        "background": {"background": True, "store": True},
+    }
+
+    def _request(self, tool_choice, *, thinking=False, mode="full", **kwargs):
+        body = {
+            "model": "x",
+            "input": "Weather in Paris?",
+            "tools": [self._tool("get_weather"), self._tool("get_time")],
+            "tool_choice": tool_choice,
+            "chat_template_kwargs": {"thinking": thinking},
+            "store": False,
+            **self.MODES[mode],
+            **kwargs,
+        }
+        return ResponsesRequest(**body)
+
+    def _invoke(self, name, city):
+        return (
+            f'<{self.DSML} invoke name="{name}">\n'
+            f'<{self.DSML} parameter name="city" string="true">{city}'
+            f"</{self.DSML} parameter>\n</{self.DSML} invoke>"
+        )
+
+    def _completion(self, *calls):
+        """The model's output after the prefill: the invokes and the closer."""
+        invokes = "\n".join(self._invoke(name, city) for name, city in calls)
+        return f"{invokes}\n</{self.DSML} calls>"
+
+    def _engine_output(self, output_ids, finish):
+        return {
+            "text": self.tokenizer.decode(output_ids),
+            "output_ids": output_ids,
+            "meta_info": {
+                "id": "rid",
+                "prompt_tokens": 3,
+                "completion_tokens": len(output_ids),
+                "cached_tokens": 0,
+                "weight_version": "default",
+                "finish_reason": None if finish is None else {"type": finish},
+            },
+            "index": 0,
+        }
+
+    def _engine(self, completion, finish, stream):
+        """The engine's answer: cumulative output ids, in 3-token steps when
+        streamed, ``finish`` on the last output."""
+        ids = self.tokenizer.encode(completion, add_special_tokens=False)
+        ends = (*range(3, len(ids), 3), len(ids)) if stream else (len(ids),)
+
+        async def generate():
+            for end in ends:
+                yield self._engine_output(
+                    ids[:end], finish if end == len(ids) else None
+                )
+
+        return generate()
+
+    def _responses(self, request, completion, finish="stop"):
+        """create_responses over an engine that answers ``completion``: the
+        function_call items as (name, arguments), the message text and the
+        response status."""
+        self.serving.tokenizer_manager.generate_request = Mock(
+            return_value=self._engine(completion, finish, request.stream)
+        )
+
+        async def run():
+            result = await self.serving.create_responses(request)
+            if request.stream:
+                return [event async for event in result]
+            if request.background:
+                self.assertEqual(result.status, "queued")
+                await self.serving.background_tasks[result.id]
+                return self.serving.response_store[result.id]
+            return result
+
+        result = asyncio.run(run())
+        prompt = self._prompt(self.chat_requests[-1])
+        self.assertTrue(prompt.endswith(self.PREFILL), prompt[-80:])
+        if request.stream:
+            payloads = event_payloads(result)
+            types = [payload["type"] for payload in payloads]
+            self.assertNotIn("error", types)
+            (terminal,) = [
+                payload["response"]
+                for payload in payloads
+                if payload["type"] in ("response.completed", "response.incomplete")
+            ]
+            output = terminal["output"]
+            # The streamed text deltas carry exactly the final message text.
+            streamed_text = "".join(
+                payload["delta"]
+                for payload in payloads
+                if payload["type"] == "response.output_text.delta"
+            )
+        else:
+            self.assertIsInstance(result, ResponsesResponse, result)
+            output = [item.model_dump() for item in result.output]
+            terminal = {"status": result.status}
+        calls = [
+            (item["name"], item["arguments"])
+            for item in output
+            if item["type"] == "function_call"
+        ]
+        text = "".join(
+            part["text"]
+            for item in output
+            if item["type"] == "message"
+            for part in item["content"]
+        )
+        if request.stream:
+            self.assertEqual(streamed_text, text)
+        return calls, text, terminal["status"]
+
+    def _chat(self, completion, finish="stop"):
+        """Chat's tool calls and content for the Chat request Responses
+        rendered last, answered with the same ``completion``."""
+        chat_request = self.chat_requests[-1]
+        self.assertTrue(chat_request._calls_block_prefilled)
+        if not chat_request.stream:
+            ids = self.tokenizer.encode(completion, add_special_tokens=False)
+            response = self.serving._build_chat_response(
+                chat_request, [self._engine_output(ids, finish)], created=1
+            )
+            message = response.choices[0].message
+            calls = [
+                (call.function.name, call.function.arguments)
+                for call in message.tool_calls or []
+            ]
+            return calls, message.content or ""
+
+        self.serving.tokenizer_manager.generate_request = Mock(
+            return_value=self._engine(completion, finish, stream=True)
+        )
+        raw_request = Mock()
+        raw_request.is_disconnected = AsyncMock(return_value=False)
+
+        async def run():
+            return [
+                chunk
+                async for chunk in self.serving._generate_chat_stream(
+                    Mock(), chat_request, raw_request
+                )
+            ]
+
+        chunks = [
+            orjson.loads(chunk[len("data: ") :])
+            for chunk in asyncio.run(run())
+            if chunk.startswith("data: ") and chunk != "data: [DONE]\n\n"
+        ]
+        self.assertFalse(any("error" in chunk for chunk in chunks), chunks)
+        deltas = [c["delta"] for chunk in chunks for c in chunk.get("choices", [])]
+        assembled = {}
+        for delta in deltas:
+            for call in delta.get("tool_calls") or []:
+                entry = assembled.setdefault(call["index"], ["", ""])
+                entry[0] += call["function"].get("name") or ""
+                entry[1] += call["function"].get("arguments") or ""
+        calls = [(name, args) for name, args in assembled.values()]
+        return calls, "".join(delta.get("content") or "" for delta in deltas)
+
+    def _prompt(self, chat_request):
+        """The prompt text Responses rendered for ``chat_request``."""
+        return self.tokenizer.decode(self.prompts[id(chat_request)])
+
+    def _make_request(self, request):
+        """Responses' render of ``request``: whether it flagged the prefill, and
+        the prompt text."""
+        asyncio.run(self.serving._make_request(request, None, self.tokenizer))
+        return request._calls_block_prefilled, self._prompt(self.chat_requests[-1])
+
+    def test_make_request_flags_the_prefilled_prompt(self):
+        for choice in (self._named(), self._named("get_time"), "required"):
+            with self.subTest(choice=choice):
+                prefilled, prompt = self._make_request(self._request(choice))
+                self.assertTrue(prefilled)
+                self.assertTrue(prompt.endswith(self.PREFILL), prompt[-80:])
+        cases = {
+            "auto": self._request("auto"),
+            "thinking mode": self._request("required", thinking=True),
+            "trailing assistant": self._request(
+                "required",
+                input=[
+                    {"role": "user", "content": "Weather in Paris?"},
+                    {"role": "assistant", "content": "Let me check"},
+                ],
+            ),
+        }
+        for name, request in cases.items():
+            with self.subTest(case=name):
+                prefilled, prompt = self._make_request(request)
+                self.assertFalse(prefilled)
+                self.assertNotIn(
+                    f"<{self.DSML} calls>\n", prompt.rsplit("</think>")[-1]
+                )
+
+    def test_forced_call_parses_into_chats_function_calls(self):
+        for mode in self.MODES:
+            for choice, calls in (
+                (self._named(), [("get_weather", "Paris")]),
+                ("required", [("get_weather", "Paris"), ("get_time", "Oslo")]),
+            ):
+                with self.subTest(mode=mode, choice=choice):
+                    completion = self._completion(*calls)
+                    request = self._request(choice, mode=mode)
+                    got_calls, got_text, status = self._responses(request, completion)
+                    expected = [(name, f'{{"city": "{city}"}}') for name, city in calls]
+                    self.assertEqual(got_calls, expected)
+                    self.assertEqual(got_text, "")
+                    self.assertEqual(status, "completed")
+                    self.assertEqual((got_calls, got_text), self._chat(completion))
+
+    def test_block_closed_without_an_invoke_shows_no_dsml(self):
+        """Output that only closes the prefilled block is the end of an empty
+        calls block, not text: no call and no message, streamed or not."""
+        completion = f"\n</{self.DSML} calls>"
+        for mode in self.MODES:
+            with self.subTest(mode=mode):
+                request = self._request("required", mode=mode)
+                got_calls, got_text, status = self._responses(request, completion)
+                self.assertEqual((got_calls, got_text), ([], ""))
+                self.assertEqual(status, "completed")
+                self.assertEqual((got_calls, got_text), self._chat(completion))
+
+    def test_cut_off_calls_block_is_handled_as_chat_handles_it(self):
+        """The block never closed (max_tokens): parsed as the output with the
+        prefill in front, as chat parses it. Answered whole or streamed, each
+        call comes out as far as it got (an unclosed one with its arguments
+        cut), as recipe parses it for chat. Neither shows DSML as text."""
+        finished = self._invoke("get_weather", "Paris")
+        weather = ("get_weather", '{"city": "Paris"}')
+        cut_offs = {
+            "after an invoke": (finished, [weather]),
+            "inside an invoke": (
+                f'{finished}\n<{self.DSML} invoke name="get_time">\n'
+                f'<{self.DSML} parameter name="city" string="true">Os',
+                [weather, ("get_time", '{"city": "Os')],
+            ),
+        }
+        for mode in self.MODES:
+            for name, (completion, streamed_calls) in cut_offs.items():
+                with self.subTest(mode=mode, cut=name):
+                    request = self._request("required", mode=mode)
+                    got_calls, got_text, status = self._responses(
+                        request, completion, finish="length"
+                    )
+                    self.assertEqual(got_calls, streamed_calls)
+                    self.assertEqual(got_text, "")
+                    self.assertEqual(status, "incomplete")
+                    self.assertEqual(
+                        (got_calls, got_text), self._chat(completion, "length")
+                    )
+
