+# ---------------------------------------------------------------------------
+# Under the exact decoder trim: full and early-only rebuilds
+# ---------------------------------------------------------------------------
+
+T_LAYERS = LATE_LAYER_START + LATE_DEPTH + 1  # 40: the geometry the trim models
+T_FULL = rebuild_span(T_LAYERS, WINDOW, PAGE)  # 4 + 39 * 3 = 121
+T_EARLY = rebuild_span(LATE_LAYER_START, WINDOW, PAGE)  # 4 + 19 * 3 = 61
+T_TAIL = late_trim_tail_len(WINDOW, PAGE)  # R = 4 + 19 * 3 = 61
+T_STORED = 320
+T_BRANCH = 200  # B
+T_PROMPT = [(11 * i + 5) % VOCAB for i in range(T_STORED)]
+T_LONG = 80  # B <= P - R: the request runs at G = B, so early-only
+T_SHORT = 12  # B > P - R: full
+# A replay piece's matmuls round differently from the cold prefill's in the
+# last bit (~1e-14 on the rebuilt window); 40 layers amplify that to ~1e-10.
+# A wrong late row moves the logits by O(1).
+LOGIT_TOL = 1e-8
+
+
+def _trim_cache():
+    with envs.SGLANG_DSV4_EXACT_DECODER_TRIM.override(True):
+        tree = _swa_cache(decoder_swa_bounded_replay=True, tree_core_backend="python")
+    assert tree.exact_decoder_trim and tree.exact_trim_tail_len == T_TAIL
+    tree.configure_swa_branch_rebuild(T_LAYERS, late_layer_start=LATE_LAYER_START)
+    assert tree.swa_branch_rebuild_span() == T_FULL
+    assert tree.swa_rebuild_early_span == T_EARLY
+    return tree
+
+
+def _trim_req(rid, new, base=90):
+    return _req(rid, T_PROMPT[:T_BRANCH] + [base + (i % 5) for i in range(new)])
+
+
+def _trim_serve(new, *, piece=16, corrupt_late=False, force_early=None):
+    """Serve a branch at B with ``new`` tokens past it under the exact trim,
+    against a cold untrimmed prefill. ``corrupt_late``: overwrite every late
+    layer's SWA rows of [B - R, B) after the replay. ``force_early``: override
+    rebuild_mode's choice."""
+    model = RefModel(layers=T_LAYERS, late_start=LATE_LAYER_START)
+    tree = _trim_cache()
+    pools, _ = _previous_turn(model, tree, T_PROMPT)
+    mapping = tree.token_to_kv_pool_allocator.full_to_swa_index_mapping
+    req = _trim_req("trim", new)
+    seen = {}
+
+    def after_replay(row):
+        rebuild = req.swa_rebuild
+        seen.update(
+            start=rebuild.start,
+            early_only=rebuild.early_only,
+            late_floor_g=rebuild.late_floor_g,
+        )
+        if corrupt_late:
+            slots = mapping[row[T_BRANCH - T_FULL : T_BRANCH].long()]
+            noise = torch.Generator().manual_seed(5)
+            for name in ("k", "v"):
+                part = pools[name][slots, LATE_LAYER_START:]
+                pools[name][slots, LATE_LAYER_START:] = torch.randn(
+                    part.shape, generator=noise, dtype=torch.float64
+                )
+
+    mode = mock.patch.object(
+        tree,
+        "swa_rebuild_mode",
+        lambda req, plan: (
+            plan.seqlen - (T_EARLY if force_early else T_FULL),
+            force_early,
+        ),
+    )
+    with mode if force_early is not None else mock.MagicMock():
+        logits, runner, row = _serve(
+            tree,
+            model,
+            pools,
+            req,
+            piece=piece,
+            trim_tail=T_TAIL,
+            after_replay=after_replay,
+        )
+    cold_logits, cold_pools, cold_row, cold_map = model.cold(list(req.origin_input_ids))
+    rebuilt = _swa_kv(pools, mapping, row, T_BRANCH - TAIL, T_BRANCH)
+    cold = _swa_kv(cold_pools, cold_map, cold_row, T_BRANCH - TAIL, T_BRANCH)
+
+    def err(layers):
+        return max(
+            (a[:, layers] - b[:, layers]).abs().max().item()
+            for a, b in zip(rebuilt, cold)
+        )
+
+    return SimpleNamespace(
+        tree=tree,
+        req=req,
+        runner=runner,
+        early_kv_err=err(slice(0, LATE_LAYER_START)),
+        kv_err=err(slice(None)),
+        logit_err=(logits[-1] - cold_logits[-1]).abs().max().item(),
+        **seen,
+    )
+
+
+def test_trim_an_early_only_rebuild_then_a_long_extend_is_exact():
+    r = _trim_serve(T_LONG, corrupt_late=True)
+    start = T_BRANCH - T_EARLY
+    assert r.early_only and r.start == start and r.late_floor_g is None
+    assert r.req.late_floor_g == T_BRANCH  # the extend runs at G = B
+    *replays, own = r.runner.late_floors
+    # The replay's late layers ran SKIP_TAIL rows (here clipped to its start),
+    # not the live batch's floors; the extend's late tail stays above B.
+    assert [f for *_, f in replays] == [
+        max(e - SKIP_TAIL, start) for _, e, _ in replays
+    ]
+    assert own == (T_BRANCH, T_BRANCH + T_LONG, T_BRANCH + T_LONG - T_TAIL)
+    assert own[2] >= T_BRANCH
+    # Exact although every late SWA row below B is garbage.
+    assert r.early_kv_err < 1e-10 and r.logit_err < LOGIT_TOL
+
+
+def test_trim_control_an_early_only_rebuild_for_a_short_extend_is_inexact():
+    # A short extend reads the late rows below B the early-only replay left
+    # inexact: why rebuild_mode replays every layer for it.
+    r = _trim_serve(T_SHORT, corrupt_late=True, force_early=True)
+    assert r.early_only and r.req.late_floor_g == 0
+    assert r.runner.late_floors[-1][2] < T_BRANCH
+    assert r.early_kv_err < 1e-10 and r.logit_err > 1e-3
+
+
+@pytest.mark.parametrize("piece", [16, 4096])
+def test_trim_a_full_rebuild_then_a_short_extend_is_exact(piece):
+    r = _trim_serve(T_SHORT, piece=piece)
+    start, g = T_BRANCH - T_FULL, T_BRANCH - T_TAIL
+    assert not r.early_only and r.start == start and r.late_floor_g == g
+    claim = g + LATE_DEPTH * (WINDOW - 1)  # B - 147 for DeepSeek-V4.1-Flash
+    assert r.req.late_exact_from == claim and r.req.late_floor_g == 0
+    *replays, own = r.runner.late_floors
+    # Pieces at or below G far-skip; every other one is floored at exactly G.
+    for s, e, floor in replays:
+        assert floor == (max(e - SKIP_TAIL, start) if e <= g else g), (s, e, floor)
+    p = T_BRANCH + T_SHORT
+    assert own == (T_BRANCH, p, p - T_TAIL) and own[2] < T_BRANCH
+    # The late window at B is exact: the extend reads the replayed late rows.
+    assert r.kv_err < 1e-10 and r.logit_err < LOGIT_TOL
+
+
+def test_trim_a_sibling_hit_at_b_after_an_early_only_publish_is_capped():
+    tree = _trim_serve(T_LONG).tree
+    long_sib = _trim_req("long", T_LONG, base=60)
+    long_sib.init_next_round_input(tree)
+    assert long_sib.prefix_len == T_BRANCH and long_sib.late_floor_g == T_BRANCH
+    assert long_sib.swa_rebuild_match is None
+    short_sib = _trim_req("short", T_SHORT, base=60)
+    short_sib.init_next_round_input(tree)
+    # The node at B is late-invalid and a short extend there would read its
+    # late rows: the match cap moves the hit to the deepest late-exact
+    # boundary, the rebuilt node's parent at B - tail (still SWA-tombstoned),
+    # which it reaches by a full rebuild.
+    assert short_sib.prefix_len == T_BRANCH - TAIL
+    plan = short_sib.swa_rebuild_match
+    assert plan is not None and plan.seqlen == T_BRANCH - TAIL
+    assert tree.swa_rebuild_mode(short_sib, plan) == (plan.seqlen - T_FULL, False)
+
+
+def test_trim_a_sibling_hit_at_b_after_a_full_publish_is_served_at_b():
+    tree = _trim_serve(T_SHORT).tree
+    sib = _trim_req("sib", T_SHORT, base=60)
+    sib.init_next_round_input(tree)
+    assert sib.prefix_len == T_BRANCH and sib.swa_rebuild_match is None
+    assert sib.late_floor_g == 0
+    assert sib.late_exact_from == T_BRANCH - T_TAIL + LATE_DEPTH * (WINDOW - 1)
