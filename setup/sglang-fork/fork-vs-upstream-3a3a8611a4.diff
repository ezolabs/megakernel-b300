+def test_the_poll_counter_counts_polled_and_skipped_calls(ranks):
+    for r in ranks["gated"]:
+        gate, counters = r["gate"], r["counters"]
+        assert gate["polls"] + gate["skips"] == len(r["checks"])
+        assert counters["polled"] == gate["polls"]
+        assert counters["skipped"] + gate["unlogged_skips"] == gate["skips"]
+    for r in ranks["ungated"]:
+        assert r["counters"] == {"polled": len(r["checks"]), "skipped": 0}
