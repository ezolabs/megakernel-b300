+import argparse
+import unittest
+
+from sglang.srt.arg_groups.validation_hook import validate_short_prefill_protection
+from sglang.srt.server_args import ServerArgs
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class ShortPrefillArgumentsTest(unittest.TestCase):
+    def config(self, **kwargs):
+        options = dict(
+            model_path="dummy",
+            chunked_prefill_size=16384,
+            page_size=64,
+            short_prefill_token_threshold=2048,
+            short_prefill_chunk_size=4096,
+            short_prefill_max_tokens=6144,
+        )
+        options.update(kwargs)
+        return ServerArgs(**options)
+
+    def test_cli_flags_preserve_opt_in_default(self):
+        parser = argparse.ArgumentParser()
+        ServerArgs.add_cli_args(parser)
+        disabled = parser.parse_args(["--model-path", "dummy"])
+        self.assertEqual(disabled.short_prefill_token_threshold, 0)
+        enabled = parser.parse_args(
+            [
+                "--model-path",
+                "dummy",
+                "--short-prefill-token-threshold",
+                "2048",
+                "--short-prefill-chunk-size",
+                "4096",
+                "--short-prefill-max-tokens",
+                "6144",
+            ]
+        )
+        self.assertEqual(enabled.short_prefill_token_threshold, 2048)
+        self.assertEqual(enabled.short_prefill_chunk_size, 4096)
+        self.assertEqual(enabled.short_prefill_max_tokens, 6144)
+
+    def test_default_off_does_not_constrain_existing_chunk_configuration(self):
+        validate_short_prefill_protection(
+            self.config(
+                short_prefill_token_threshold=0,
+                chunked_prefill_size=-1,
+                short_prefill_chunk_size=-1,
+                enable_dynamic_chunking=True,
+            )
+        )
+
+    def test_opt_in_profile_is_valid(self):
+        validate_short_prefill_protection(self.config())
+
+    def test_invalid_opt_in_configurations_are_rejected(self):
+        cases = [
+            {"short_prefill_token_threshold": -1},
+            {"chunked_prefill_size": -1},
+            {"enable_dynamic_chunking": True},
+            {"short_prefill_chunk_size": 0},
+            {"short_prefill_chunk_size": 6144},
+            {"short_prefill_token_threshold": 2049},
+            {"short_prefill_chunk_size": 4095},
+        ]
+        for options in cases:
+            with self.subTest(options=options), self.assertRaises(ValueError):
+                validate_short_prefill_protection(self.config(**options))
+
+
+if __name__ == "__main__":
+    unittest.main()
