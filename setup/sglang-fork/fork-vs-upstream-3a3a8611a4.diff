diff --git a/test/registered/unit/mem_cache/test_dsv4_index_k_dequant.py b/test/registered/unit/mem_cache/test_dsv4_index_k_dequant.py
new file mode 100644
index 0000000000..c33abc3932
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_dsv4_index_k_dequant.py
@@ -0,0 +1,93 @@
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.layers.quantization.fp8 import DSV4_DEQUANT_FP4_TABLE
+from sglang.srt.mem_cache import deepseek_v4_memory_pool
+from sglang.srt.mem_cache.deepseek_v4_memory_pool import DeepSeekV4IndexerPool
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+def _reference_dequant(pool, layer_id, slots=None):
+    """get_index_k_dequant before it read through get_index_k_fp4: the broadcast
+    [n, 64] int64 column-index gather."""
+    buf = pool.index_k_with_scale_buffer[layer_id - pool.start_layer]
+    if slots is None:
+        slots = torch.arange(pool.size, device=buf.device)
+    slots = slots.to(torch.int64)
+    p = pool.page_size
+    page, off = (slots // p).unsqueeze(-1), slots % p
+    payload_cols = (off * 64).unsqueeze(-1) + torch.arange(64, device=buf.device)
+    scale_cols = (p * 64 + off * 4).unsqueeze(-1) + torch.arange(4, device=buf.device)
+    u = buf[page, payload_cols].view(torch.uint8)
+    codes = torch.stack([u & 0x0F, (u >> 4) & 0x0F], dim=-1)
+    vals = DSV4_DEQUANT_FP4_TABLE.to(buf.device)[codes.long()].flatten(1)
+    exps = buf[page, scale_cols].to(torch.int32) & 0xFF
+    scales = torch.exp2(exps.float() - 127).repeat_interleave(32, dim=-1)
+    return (vals * scales).to(torch.bfloat16)
+
+
+def _make_pool(num_pages, page_size=64, start_layer=0, layers=2, seed=0):
+    # Only the fields the fp4 readback touches; the buffer is random bytes in the
+    # [page_size * 64 payload | page_size * 4 scale] page layout.
+    gen = torch.Generator().manual_seed(seed)
+    pool = DeepSeekV4IndexerPool.__new__(DeepSeekV4IndexerPool)
+    pool.use_fp4_indexer = True
+    pool.page_size = page_size
+    pool.start_layer = start_layer
+    pool.size = num_pages * page_size
+    pool.index_k_with_scale_buffer = [
+        torch.randint(
+            0, 256, (num_pages, page_size * 68), dtype=torch.uint8, generator=gen
+        )
+        for _ in range(layers)
+    ]
+    return pool
+
+
+class TestDSV4IndexKDequant(CustomTestCase):
+    def _assert_same_bytes(self, new, ref):
+        self.assertEqual(new.dtype, torch.bfloat16)
+        self.assertEqual(new.shape, ref.shape)
+        self.assertTrue(torch.equal(new.view(torch.int16), ref.view(torch.int16)))
+
+    def test_matches_broadcast_gather_bytewise(self):
+        pool = _make_pool(num_pages=1024, start_layer=3)
+        gen = torch.Generator().manual_seed(1)
+        for n in (1_000, 40_000):
+            for layer_id in (3, 4):
+                slots = torch.randint(0, pool.size, (n,), generator=gen)
+                new = pool.get_index_k_dequant(layer_id, slots)
+                self.assertEqual(new.shape, (n, 128))
+                self._assert_same_bytes(new, _reference_dequant(pool, layer_id, slots))
+
+    def test_chunked_matches_unchunked(self):
+        pool = _make_pool(num_pages=1024)
+        slots = torch.randint(
+            0, pool.size, (40_000,), generator=torch.Generator().manual_seed(2)
+        )
+        ref = _reference_dequant(pool, 0, slots)
+        # A chunk that does not divide n, so the last chunk is a short one.
+        with patch.object(deepseek_v4_memory_pool, "INDEX_K_DEQUANT_CHUNK_ROWS", 4_093):
+            self._assert_same_bytes(pool.get_index_k_dequant(0, slots), ref)
+
+    def test_whole_pool_strided_and_empty_slots(self):
+        pool = _make_pool(num_pages=16, page_size=128)
+        self._assert_same_bytes(
+            pool.get_index_k_dequant(1), _reference_dequant(pool, 1)
+        )
+        strided = torch.arange(pool.size - 1, -1, -1, dtype=torch.int32)[::3]
+        self.assertFalse(strided.is_contiguous())
+        self._assert_same_bytes(
+            pool.get_index_k_dequant(0, strided), _reference_dequant(pool, 0, strided)
+        )
+        empty = torch.empty(0, dtype=torch.int64)
+        self.assertEqual(pool.get_index_k_dequant(0, empty).shape, (0, 128))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/registered/unit/mem_cache/test_exact_trim_match_cap.py b/test/registered/unit/mem_cache/test_exact_trim_match_cap.py
new file mode 100644
index 0000000000..f95bf19079
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_exact_trim_match_cap.py
@@ -0,0 +1,376 @@
+"""Exact decoder trim: the radix match decision and Req.late_exact_from.
+
+Under SGLANG_DSV4_EXACT_DECODER_TRIM the match no longer stops one window short.
+A hit of m tokens for a prompt of P is kept when its late window is exact
+(late_window_ok on the node's late_exact_from: G = 0), or when it is not a whole
+extend and m <= page_floor(P) - R (G = m: the extend recomputes every late row
+the final window needs). Otherwise it is re-walked to the deepest late-exact
+boundary on its path or page_floor(P) - R, whichever is longer (a whole extend
+takes only the former), and the linker gets the capped key. The request then
+carries late_exact_from from the matched node (unknown: m + CONE), advances it
+per extend, and stamps it on the nodes it inserts.
+
+Geometry here: page 1, W = 8, so R = late_trim_tail_len(8, 1) = 141 and an
+unknown prefix of m enters the recurrence as m + 19 * 7 = m + 133.
+"""
+
+from __future__ import annotations
+
+import unittest
+from array import array
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention.dsv4.exact_decoder_trim import (
+    LATE_DEPTH,
+    late_trim_tail_len,
+)
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import InsertParams, MatchPrefixParams
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.common import match_kv_cache
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.sampling.sampling_params import SamplingParams
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+KV_SIZE = 4096
+WINDOW = 8
+TAIL = late_trim_tail_len(WINDOW, 1)
+CONE = LATE_DEPTH * (WINDOW - 1)
+
+
+def _cache(
+    *, trim: bool = True, bounded_replay: bool = True, streaming_session: bool = False
+) -> UnifiedRadixCache:
+    set_global_server_args_for_scheduler(
+        ServerArgs(
+            model_path="dummy",
+            page_size=1,
+            enable_streaming_session=streaming_session,
+        )
+    )
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=1,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=[0, 2],
+        full_attention_layer_ids=[1, 3],
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=1,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=1,
+        disable=False,
+        sliding_window_size=WINDOW,
+        tree_components=(ComponentType.FULL, ComponentType.SWA),
+        tree_core_backend="python",
+        decoder_swa_bounded_replay=bounded_replay,
+    )
+    with envs.SGLANG_DSV4_EXACT_DECODER_TRIM.override(trim):
+        return UnifiedRadixCache(params=params)
+
+
+def _tokens(n: int, base: int = 1) -> list[int]:
+    return list(range(base, base + n))
+
+
+def _insert(cache, tokens, late_exact_from) -> torch.Tensor:
+    value = cache.token_to_kv_pool_allocator.alloc(len(tokens))
+    assert value is not None
+    cache.insert(
+        InsertParams(
+            key=RadixKey(array("q", tokens)),
+            value=value,
+            late_exact_from=late_exact_from,
+        )
+    )
+    return value
+
+
+def _stub_req(*, whole: bool = False):
+    return SimpleNamespace(
+        rid="r",
+        session=None,
+        return_logprob=whole,
+        logprob_start_len=0 if whole else -1,
+    )
+
+
+def _match(cache, tokens, req=None):
+    return cache.match_prefix(
+        MatchPrefixParams(key=RadixKey(array("q", tokens)), req=req or _stub_req())
+    )
+
+
+def _path(cache, tokens):
+    """The nodes on ``tokens``' root path, as (start, end, node)."""
+    core = cache.tree_core
+    node, pos, out = core.root_node, 0, []
+    key = RadixKey(array("q", tokens))
+    while pos < len(tokens):
+        child = node.children.get(key[pos:].child_key(core.page_size))
+        if child is None:
+            break
+        out.append((pos, pos + len(child.key), child))
+        pos += len(child.key)
+        node = child
+    return out
+
+
+class TestMatchDecision(unittest.TestCase):
+    def test_geometry(self):
+        self.assertEqual(TAIL, 141)
+        self.assertEqual(CONE, 133)
+
+    def test_late_exact_hit_keeps_m(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), 0)
+        req = _stub_req()
+        result = _match(cache, _tokens(600), req)
+        self.assertEqual(result.device_prefix_len, 500)
+        self.assertEqual(result.late_exact_from, 0)
+        self.assertEqual(cache.exact_trim_prefix_state(req, 600, 500, 0), (0, 0))
+        self.assertEqual(cache.exact_trim_stats.late_exact_hits, 1)
+
+    def test_inexact_hit_at_or_below_floor_keeps_m_with_g(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), None)
+        req = _stub_req()
+        # page_floor(641) - R = 500: the boundary case keeps m.
+        result = _match(cache, _tokens(641), req)
+        self.assertEqual(result.device_prefix_len, 500)
+        self.assertIsNone(result.late_exact_from)
+        self.assertEqual(
+            cache.exact_trim_prefix_state(req, 641, 500, None), (500 + CONE, 500)
+        )
+        self.assertEqual(cache.exact_trim_stats.late_floor_hits, 1)
+
+    def test_inexact_known_claim_below_floor_keeps_its_claim(self):
+        cache = _cache()
+        # Known but not late-exact at 500: 500 - 8 < 495.
+        _insert(cache, _tokens(500), 495)
+        req = _stub_req()
+        result = _match(cache, _tokens(700), req)
+        self.assertEqual(result.device_prefix_len, 500)
+        self.assertEqual(result.late_exact_from, 495)
+        self.assertEqual(cache.exact_trim_prefix_state(req, 700, 500, 495), (495, 500))
+
+    def test_inexact_hit_above_floor_caps_to_page_floor(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), None)
+        req = _stub_req()
+        result = _match(cache, _tokens(600), req)
+        cap = 600 - TAIL
+        self.assertEqual(result.device_prefix_len, cap)
+        self.assertIsNone(result.late_exact_from)
+        self.assertEqual(
+            cache.exact_trim_prefix_state(req, 600, cap, None), (cap + CONE, cap)
+        )
+        stats = cache.exact_trim_stats
+        self.assertEqual((stats.capped_hits, stats.capped_tokens), (1, 500 - cap))
+
+    def test_inexact_hit_caps_to_deeper_late_exact_node(self):
+        cache = _cache()
+        _insert(cache, _tokens(300), 0)
+        _insert(cache, _tokens(500), None)
+        # page_floor(400) - R = 259 < 300: the late-exact node end wins, G = 0.
+        req = _stub_req()
+        result = _match(cache, _tokens(400), req)
+        self.assertEqual(result.device_prefix_len, 300)
+        self.assertEqual(result.late_exact_from, 0)
+        self.assertEqual(cache.exact_trim_prefix_state(req, 400, 300, 0), (0, 0))
+
+    def test_cap_prefers_a_longer_page_floor(self):
+        cache = _cache()
+        _insert(cache, _tokens(200), 0)
+        # Not late-exact at 500 (500 - 8 < 494), so never at a shorter boundary
+        # inside the node either; its late-exact ancestor ends at 200.
+        _insert(cache, _tokens(500), 494)
+        req = _stub_req()
+        result = _match(cache, _tokens(560), req)
+        # 560 - R = 419 > 200: the page floor wins, G = 419, and the split
+        # node keeps its claim.
+        self.assertEqual(result.device_prefix_len, 560 - TAIL)
+        self.assertEqual(result.late_exact_from, 494)
+        self.assertEqual(
+            cache.exact_trim_prefix_state(req, 560, 560 - TAIL, 494),
+            (494, 560 - TAIL),
+        )
+
+    def test_whole_extend_caps_only_to_late_exact_boundary(self):
+        cache = _cache()
+        _insert(cache, _tokens(300), 0)
+        _insert(cache, _tokens(500), None)
+        req = _stub_req(whole=True)
+        result = _match(cache, _tokens(600), req)
+        # Not 600 - R = 459: a whole extend reads every row's window.
+        self.assertEqual(result.device_prefix_len, 300)
+        self.assertEqual(cache.exact_trim_prefix_state(req, 600, 300, 0), (0, 0))
+        self.assertEqual(cache.exact_trim_stats.whole_extend_caps, 1)
+
+    def test_whole_extend_without_late_exact_boundary_misses(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), None)
+        result = _match(cache, _tokens(2000), _stub_req(whole=True))
+        self.assertEqual(result.device_prefix_len, 0)
+        self.assertEqual(result.late_exact_from, 0)
+
+    def test_whole_extend_keeps_late_exact_hit(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), 10)
+        result = _match(cache, _tokens(600), _stub_req(whole=True))
+        self.assertEqual(result.device_prefix_len, 500)
+
+    def test_linker_gets_capped_key(self):
+        cache = _cache()
+        _insert(cache, _tokens(500), 0)
+        seen = []
+
+        class Linker:
+            def match(self, key, req, result):
+                seen.append(key.limit)
+                return result._replace(
+                    host_hit_length=result.host_hit_length + 1,
+                    last_host_node=result.last_device_node,
+                )
+
+        cache.linker = Linker()
+        result = _match(cache, _tokens(1000))
+        self.assertEqual(seen, [1000 - TAIL])
+        self.assertIsNone(result.late_exact_from)  # external pages: unknown
+        seen.clear()
+        _match(cache, _tokens(1000), _stub_req(whole=True))
+        self.assertEqual(seen, [])
+
+    def test_reprefill_tail_is_the_match_decisions(self):
+        req = Req(
+            rid="r",
+            origin_input_text="",
+            origin_input_ids=array("q", _tokens(10)),
+            sampling_params=SamplingParams(max_new_tokens=1),
+        )
+        self.assertEqual(_cache().swa_reprefill_tail_tokens(req), 0)
+        self.assertEqual(_cache(trim=False).swa_reprefill_tail_tokens(req), WINDOW)
+
+    def test_trim_off_is_unchanged(self):
+        cache = _cache(trim=False)
+        _insert(cache, _tokens(500), None)
+        result = _match(cache, _tokens(600), _stub_req(whole=True))
+        self.assertEqual(result.device_prefix_len, 500)
+        self.assertIsNone(result.late_exact_from)
+        req = Req(
+            rid="r",
+            origin_input_text="",
+            origin_input_ids=array("q", _tokens(600)),
+            sampling_params=SamplingParams(max_new_tokens=1),
+        )
+        match_kv_cache(req, cache)
+        self.assertEqual((req.late_exact_from, req.late_floor_g), (0, 0))
+
+    def test_stats_log_line(self):
+        cache = _cache()
+        cache.exact_trim_stats.LOG_INTERVAL_S = 0.0
+        _insert(cache, _tokens(500), 0)
+        with self.assertLogs(
+            "sglang.srt.mem_cache.unified_radix_cache", level="INFO"
+        ) as logs:
+            _match(cache, _tokens(600))
+        self.assertTrue(
+            any("Exact decoder trim: late_exact_hits=1" in m for m in logs.output),
+            logs.output,
+        )
+
+
+class TestStartupRefusals(unittest.TestCase):
+    def test_streaming_session_is_refused(self):
+        # A streaming session lends its record past the late-aware match cap.
+        with self.assertRaisesRegex(ValueError, "--enable-streaming-session"):
+            _cache(streaming_session=True)
+        # Without the trim (or without decoder bounded replay) it is allowed.
+        self.assertFalse(_cache(trim=False, streaming_session=True).exact_decoder_trim)
+        self.assertFalse(
+            _cache(bounded_replay=False, streaming_session=True).exact_decoder_trim
+        )
+        self.assertFalse(envs.SGLANG_DSV4_EXACT_DECODER_TRIM.get())
+
+
+class TestReqLateExactFromEndToEnd(unittest.TestCase):
+    """A real Req: match_kv_cache initialises late_exact_from / late_floor_g,
+    exact_trim_after_extend advances it, checkpoint_into_tree stamps it, and a
+    second request keeps the stamped node as a late-exact hit."""
+
+    def _run(self, cache, tokens, extend_end, tree_slots):
+        req = Req(
+            rid=f"r{len(tokens)}",
+            origin_input_text="",
+            origin_input_ids=array("q", tokens),
+            sampling_params=SamplingParams(max_new_tokens=1),
+        )
+        req.init_next_round_input(cache)  # match_kv_cache
+        m = req.prefix_len
+        prefix = tree_slots[:m]
+        self.assertIsNotNone(cache.req_to_token_pool.alloc([req]))
+        fresh = cache.token_to_kv_pool_allocator.alloc(extend_end - m)
+        cache.req_to_token_pool.write(
+            (req.kv.req_pool_idx, slice(0, extend_end)),
+            torch.cat([prefix.to(fresh.dtype), fresh]),
+        )
+        req.lock = cache.lock(req.last_node)
+        req.kv.cache_protected_len = m
+        req.extend_end = extend_end
+        start_state = (m, req.late_exact_from, req.late_floor_g)
+        req.late_exact_from = cache.exact_trim_after_extend(
+            req, m, extend_end, whole_extend=False
+        )
+        cache.checkpoint(req, up_to=extend_end)
+        return req, start_state
+
+    def test_match_extend_checkpoint_chain(self):
+        cache = _cache()
+        # Written with trim off: unknown.
+        slots = _insert(cache, _tokens(500), None)
+        tokens = _tokens(700)
+        req, start = self._run(cache, tokens, 700, slots)
+        self.assertEqual(start, (500, 500 + CONE, 500))
+        # Floor max(700 - R, G) = 559 > start: E = 559 + CONE.
+        self.assertEqual(req.late_exact_from, 559 + CONE)
+        path = _path(cache, tokens)
+        self.assertEqual(path[-1][1], 700)
+        for start, _, node in path:
+            self.assertEqual(node.late_exact_from, None if start < 500 else 559 + CONE)
+        # 700 - 8 >= 692: a third request keeps the whole hit, late-exact.
+        tokens2 = tokens + _tokens(100, base=10_000)
+        row = cache.req_to_token_pool.req_to_token[req.kv.req_pool_idx, :700]
+        req2, start2 = self._run(cache, tokens2, 800, row.clone())
+        self.assertEqual(start2, (700, 559 + CONE, 0))
+        self.assertEqual(cache.exact_trim_stats.late_exact_hits, 1)
+        self.assertEqual(req2.late_exact_from, 559 + CONE)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/registered/unit/mem_cache/test_hicache_sidecar_restore.py b/test/registered/unit/mem_cache/test_hicache_sidecar_restore.py
