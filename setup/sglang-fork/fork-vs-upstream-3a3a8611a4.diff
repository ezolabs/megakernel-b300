+
+def _tail(rows, plain=False):
+    idx = torch.arange(rows)
+    return LateLayerTail(
+        token_indices=idx,
+        positions=idx.clone(),
+        extend_seq_lens=torch.tensor([rows]),
+        extend_seq_lens_cpu=[rows],
+        swa_out_cache_loc=idx.clone(),
+        plain=plain,
+    )
+
+
+def _metadata(tail=None, cache=None):
+    md = object.__new__(DSV4Metadata)
+    md.late_layer_tail = tail
+    md.sparse_prefill_cache = cache
+    md.core_attn_metadata = SimpleNamespace(request_window_layout=None)
+    return md
+
+
+def _cache(rows):
+    return SimpleNamespace(num_qo_tokens=rows)
+
+
+def _backend():
+    backend = object.__new__(DeepseekV4AttnBackend)
+    backend.trtllm_attn = False
+    backend.hisparse_coordinator = None
+    backend.token_to_kv_pool = SimpleNamespace(request_window=None)
+    backend.tail_forward_metadata = None
+    backend.prefill_graph_replay_batch = None
+    return backend
+
+
+def _extend_batch(extend_lens):
+    return SimpleNamespace(
+        forward_mode=ForwardMode.EXTEND,
+        extend_seq_lens_cpu=extend_lens,
+        attn_cp_metadata=None,
+        global_num_token_non_padded_cpu=None,
+        global_num_token_non_padded=None,
+        num_token_non_padded=None,
+    )
+
+
+# box-c's exact trim: exact_tail_len = page_ceil(128 + 19 * 127, 256).
+TAIL_LEN, TAIL_PAGE, WINDOW = 2560, 256, 128
+
+
+def _plain(extend_lens, seq_lens):
+    return late_layer_tail_runs_plain(
+        extend_lens_cpu=extend_lens,
+        seq_lens_cpu=seq_lens,
+        tail_len=TAIL_LEN,
+        swa_window=WINDOW,
+        tail_page=TAIL_PAGE,
+    )
+
+
+class TestPlainRange(CustomTestCase):
