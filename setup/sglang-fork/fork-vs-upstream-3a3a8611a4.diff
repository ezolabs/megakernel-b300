+# The calls-block opener (encoding_dsv41.TOOL_CALLS_PREFILL before the recipe merge).
+PREFILL = DeepSeekV41Detector().tool_calls_prefill
+NAMED = ToolChoice(function=ToolChoiceFuncName(name="get_weather"))
