@@ -0,0 +1,1563 @@
+"""o - rebuild a missing sliding window at a radix branch point by an R-token replay.
+
+A DeepSeek-V4.1 prefix is served only up to the last position where the radix
+tree still holds a whole SWA window (``A``); its Full KV usually reaches much
+further (``B``). Part 0024 (``SGLANG_SWA_BRANCH_REBUILD``) serves the hit to
+``B`` and replays ``[B - R, B)``, ``R = ceil_page(tail + (L - 1)(W - 1))``, to
+fill the window: compressor off, windows floored at ``B - R``, write locations
+the tree's own Full slots.
+
+Pinned here on CPU:
+
+* the arithmetic of ``R`` and the plan threshold;
+* the match on a real ``UnifiedRadixCache`` (Full + SWA, Python TreeCore, page
+  size 1, window 4), with and without HiCache;
+* admission through the real ``PrefillAdder``: the window is materialized only
+  where the request is certain to be admitted, before its lock, one per pass,
+  its R tokens charged; a failure declines the rebuild and leaves the tree
+  untouched;
+* the replay driver (``run_swa_branch_rebuild``, on upstream's encoder-replay
+  batch builder) and the DSV4 backend's window floor for the paged SWA pool
+  (``encoder_swa_row_floor``);
+* end to end, with a small reference model standing in for the DSV4.1 kernels
+  (SWA attention over a W-token window, plus an attention over per-layer Full
+  latents the tree holds, which a replay reads and never writes), whose pools
+  are indexed by the real allocator's slots and ``full_to_swa`` mapping: every
+  layer's rebuilt SWA KV on the tail node and the next-token logits equal a
+  cold prefill of the whole prompt, the Full pool is untouched by the replay,
+  and the same holds when the Full KV was demoted to the host tier and loaded
+  back. ``R - 1``, an upstream-style one-window replay, and a floor at each
+  piece's start are the controls that break it.
+
+What this does not prove: the real DSV4.1 kernels. The GPU check (logits of a
+rebuilt hit against a cold prefill on the served model) is owed on a CUDA host.
+
+box-d-up port: upstream's match carries ``device_prefix_len`` (indices from
+``path_device_indices``) and adopts it in ``match_kv_cache``; admission is
+``_select_prefill_admission`` -> load-back -> ``_commit_prefill_admission``;
+SWA locks count tombstones. The cases are the box-c-orig ones on that API.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from array import array
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention.dsv4.exact_decoder_trim import (
+    LATE_DEPTH,
+    LATE_LAYER_START,
+    SKIP_TAIL,
+    exact_trim_enabled,
+    late_trim_tail_len,
+)
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.managers.schedule_policy import AddReqResult, PrefillAdder
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import InsertParams, MatchPrefixParams
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.common import match_kv_cache
+from sglang.srt.mem_cache.kv.alloc.chain import ChainAllocator
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_branch_rebuild import (
+    SwaRebuild,
+    SwaRebuildMatch,
+    plan_rebuild,
+    rebuild_span,
+    release_scratch,
+    startup_refusal,
+    swa_replay_start_per_token,
+    window_tail,
+)
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.model_executor import swa_branch_rebuild_replay as replay_mod
+from sglang.srt.model_executor.forward_batch_info import ForwardMode
+from sglang.srt.sampling.sampling_params import SamplingParams
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+from sglang.test.tree_slots import tree_slots_of
+
+PAGE = 1  # the SWA allocator's constraint on CPU, as in test_i/k/m/n
+KV_SIZE = 4096
+WINDOW = 4
+LAYERS = 3
+SPAN = rebuild_span(LAYERS, WINDOW, PAGE)  # 4 + 2 * 3 = 10
+TAIL = window_tail(WINDOW, PAGE)  # 4
+STORED = 64  # the previous turn, stored with only its last window
+BRANCH = 40  # B: where the new prompt leaves it
+NEW = 12  # the new prompt's own tokens past B
+VOCAB = 97
+PROMPT = [(7 * i + 3) % VOCAB for i in range(STORED)]
+
+
+def _swa_cache(size_swa=KV_SIZE, **params_over):
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=size_swa,
+        page_size=PAGE,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=[0, 2],
+        full_attention_layer_ids=[1, 3],
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=size_swa,
+        page_size=PAGE,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=PAGE,
+        disable=False,
+        sliding_window_size=WINDOW,
+        # The SWA slot's window is the retain window, as upstream's fixtures
+        # build it (CacheInitParams.swa_retain_window).
+        tree_slots=tree_slots_of(
+            (ComponentType.FULL, ComponentType.SWA),
+            window=max(WINDOW, params_over.get("draft_swa_window", 0)),
+        ),
+        **params_over,
+    )
+    return UnifiedRadixCache(params=params)
+
+
+@pytest.fixture(autouse=True)
+def _server_args():
+    set_global_server_args_for_scheduler(
+        ServerArgs(model_path="dummy", page_size=PAGE, chunked_prefill_size=4096)
+    )
+
+
+def _store_turn(tree, tokens=PROMPT, keep_tail=True):
+    """A finished turn as the tree keeps it: Full KV of every token, SWA only in
+    its last window (``keep_tail``) or nowhere; the dropped SWA slots freed."""
+    alloc = tree.token_to_kv_pool_allocator
+    slots = alloc.alloc(len(tokens))
+    evicted = len(tokens) - TAIL if keep_tail else len(tokens)
+    tree.insert(
+        InsertParams(
+            key=RadixKey(array("q", tokens)),
+            value=slots,
+            component_evicted_seqlens={ComponentType.SWA: evicted},
+        )
+    )
+    alloc.free_swa(slots[:evicted])
+    return slots
+
+
+def _req(rid, tokens, max_new=8):
+    req = Req(rid, "", array("q", tokens), SamplingParams(max_new_tokens=max_new))
+    req.time_stats.wait_queue_entry_time = 0.0
+    return req
+
+
+def _branch_req(rid="branch", new=NEW, branch=BRANCH):
+    return _req(rid, PROMPT[:branch] + [90 + (i % 5) for i in range(new)])
+
+
+def _adder(tree, rem_chunk=4096):
+    return PrefillAdder(
+        page_size=PAGE,
+        tree_cache=tree,
+        token_to_kv_pool_allocator=tree.token_to_kv_pool_allocator,
+        running_batch=None,
+        new_token_ratio=1.0,
+        rem_input_tokens=16384,
+        rem_chunk_tokens=rem_chunk,
+    )
+
+
+def _swa_node(tree, node_id):
+    return tree.tree_core.node_by_id(node_id).component_data[ComponentType.SWA]
+
+
+# ---------------------------------------------------------------------------
+# The arithmetic
+# ---------------------------------------------------------------------------
+
+
+def test_span_for_deepseek_v41_flash_and_small_configs():
+    # 40 layers, window 128, page 256: tail 256 + 39 * 127 = 5,209 -> 21 pages.
+    assert window_tail(128, 256) == 256
+    assert rebuild_span(40, 128, 256) == 5376
+    # page 1: the bound itself, no rounding.
+    assert rebuild_span(LAYERS, WINDOW, 1) == WINDOW + (LAYERS - 1) * (WINDOW - 1)
+    assert rebuild_span(1, 128, 256) == 256  # one layer: its own window page
+
+
+def test_plan_needs_a_page_of_margin_past_the_span():
+    r, page = 5376, 256
+    assert (
+        plan_rebuild(span=r, page_size=page, swa_boundary_len=0, full_hit_len=0) is None
+    )
+    at = r + page
+    assert plan_rebuild(
+        span=r, page_size=page, swa_boundary_len=1024, full_hit_len=1024 + at
+    ) == (1024 + at - r, 1024 + at)
+    assert (
+        plan_rebuild(
+            span=r, page_size=page, swa_boundary_len=1024, full_hit_len=1024 + at - 1
+        )
+        is None
+    )
+    # the branch point is page-aligned down
+    assert plan_rebuild(
+        span=r, page_size=page, swa_boundary_len=0, full_hit_len=at + 100
+    ) == (at - r, at)
+    assert (
+        plan_rebuild(span=0, page_size=page, swa_boundary_len=0, full_hit_len=10**6)
+        is None
+    )
+
+
+def test_floor_per_token():
+    got = swa_replay_start_per_token([30, 7], [3, 2], "cpu")
+    assert got.tolist() == [30, 30, 30, 7, 7]
+
+
+def test_replay_pieces():
+    assert replay_mod.replay_pieces(30, 40, 4) == [(30, 34), (34, 38), (38, 40)]
+    assert replay_mod.replay_pieces(0, 5376, 4096) == [(0, 4096), (4096, 5376)]
+    assert replay_mod.replay_pieces(30, 40, None) == [(30, 40)]
+
+
+# ---------------------------------------------------------------------------
+# The match
+# ---------------------------------------------------------------------------
+
+
+def test_match_plans_a_rebuild_to_the_branch_point():
+    tree = _swa_cache()
+    slots = _store_turn(tree)
+    assert tree.configure_swa_branch_rebuild(LAYERS) == SPAN
+    key = RadixKey(array("q", _branch_req().origin_input_ids))
+    result = tree.match_prefix(MatchPrefixParams(key=key))
+    plan = result.swa_rebuild
+    assert isinstance(plan, SwaRebuildMatch)
+    assert (plan.start, plan.seqlen) == (BRANCH - SPAN, BRANCH)
+    assert plan.host_hit_length == 0 and plan.device_prefix_len == BRANCH
+    assert tree.path_device_indices(plan.device_node).tolist() == (
+        slots[:BRANCH].tolist()
+    )
+    assert plan.node == plan.device_node
+    # The SWA-valid match itself is what it was: no window before B.
+    assert result.device_prefix_len == 0
+    assert result.swa_branching_seqlen == BRANCH
+    node = tree.tree_core.node_by_id(plan.node)
+    assert len(node.key) == BRANCH and _swa_node(tree, plan.node).value is None
+
+
+def test_no_plan_when_the_flag_is_off():
+    tree = _swa_cache()
+    _store_turn(tree)
+    key = RadixKey(array("q", _branch_req().origin_input_ids))
+    result = tree.match_prefix(MatchPrefixParams(key=key))
+    assert result.swa_rebuild is None
+    assert result.device_prefix_len == 0 and result.swa_branching_seqlen == BRANCH
+
+
+def test_no_plan_below_the_margin_or_on_a_window():
+    tree = _swa_cache()
+    _store_turn(tree)
+    tree.configure_swa_branch_rebuild(LAYERS)
+    # B - A = SPAN: recomputing from A is as cheap.
+    short = _branch_req(branch=SPAN)
+    result = tree.match_prefix(
+        MatchPrefixParams(key=RadixKey(array("q", short.origin_input_ids)))
+    )
+    assert result.swa_rebuild is None
+    assert (
+        tree.match_prefix(
+            MatchPrefixParams(
+                key=RadixKey(array("q", _branch_req(branch=SPAN + 1).origin_input_ids))
+            )
+        ).swa_rebuild
+        is not None
+    )
+    # The stored turn's own end holds a window: an ordinary hit.
+    whole = _req("whole", PROMPT + [1, 2, 3])
+    result = tree.match_prefix(
+        MatchPrefixParams(key=RadixKey(array("q", whole.origin_input_ids)))
+    )
+    assert result.swa_rebuild is None and result.device_prefix_len == STORED
+
+
+def test_init_next_round_input_serves_from_the_branch_point():
+    tree = _swa_cache()
+    slots = _store_turn(tree)
+    tree.configure_swa_branch_rebuild(LAYERS)
+    req = _branch_req()
+    req.init_next_round_input(tree)
+    assert isinstance(req.swa_rebuild_match, SwaRebuildMatch)
+    assert req.prefix_len == BRANCH
+    assert tree.prefix_device_indices(req).tolist() == slots[:BRANCH].tolist()
+    assert req.last_node == req.swa_rebuild_match.node
+    assert req.best_match_node == req.swa_rebuild_match.node
+    assert req.kv.cache_protected_len == BRANCH
+    assert req.swa_branching_seqlen is None  # B gets its window from the rebuild
+    # Eligibility and load reports count the replay as uncached, through the
+    # one match seam (match_kv_cache) every caller shares.
+    assert req.num_matched_prefix_tokens == BRANCH - SPAN
+    match_kv_cache(req, tree)
+    assert req.num_matched_prefix_tokens == BRANCH - SPAN
+    # A declined rebuild is not planned again for this request.
+    req.swa_rebuild_declined = True
+    req.init_next_round_input(tree)
+    assert req.swa_rebuild_match is None and req.prefix_len == 0
+    assert req.swa_branching_seqlen == BRANCH
+    match_kv_cache(req, tree)
+    assert req.num_matched_prefix_tokens == 0
+
+
+# ---------------------------------------------------------------------------
+# Admission
+# ---------------------------------------------------------------------------
+
+
+def _admit(tree, req, adder=None):
+    adder = adder or _adder(tree)
+    req.init_next_round_input(tree)
+    return adder, adder.add_one_req(
+        req, has_chunked_req=False, truncation_align_size=None
+    )
+
+
+def test_admission_materializes_the_window_before_the_lock():
+    tree = _swa_cache()
+    slots = _store_turn(tree)
+    tree.configure_swa_branch_rebuild(LAYERS)
+    alloc = tree.token_to_kv_pool_allocator
+    swa_free = alloc.swa_available_size()
+    req = _branch_req()
+    adder, res = _admit(tree, req)
+    assert res == AddReqResult.CONTINUE
+    assert req in adder.can_run_list
+    rebuild = req.swa_rebuild
+    assert isinstance(rebuild, SwaRebuild) and not rebuild.replayed
+    assert (rebuild.start, rebuild.end) == (BRANCH - SPAN, BRANCH)
+    assert req.swa_rebuild_match is None
+    # Charged: R replay tokens beside the request's own extend.
+    assert adder.log_swa_rebuild_tokens == SPAN and adder.log_replay_tokens == SPAN
+    assert adder.rem_chunk_tokens == 4096 - NEW - SPAN
+    # The tail node [B - tail, B) holds the window; its SWA slots and the
+    # scratch ones are fresh and paired with the tree's own Full slots.
+    tail = tree.tree_core.node_by_id(req.last_node)
+    assert len(tail.key) == TAIL
+    assert (
+        tail.component_data[ComponentType.FULL].value.tolist()
+        == slots[BRANCH - TAIL : BRANCH].tolist()
+    )
+    swa = tail.component_data[ComponentType.SWA].value
+    mapping = alloc.full_to_swa_index_mapping
+    assert swa.tolist() == mapping[slots[BRANCH - TAIL : BRANCH]].tolist()
+    assert bool((mapping[slots[BRANCH - SPAN : BRANCH]] > 0).all())
+    assert bool((mapping[slots[: BRANCH - SPAN]] == 0).all())
+    assert (
+        rebuild.scratch_full.tolist() == slots[BRANCH - SPAN : BRANCH - TAIL].tolist()
+    )
+    assert alloc.swa_available_size() == swa_free - SPAN
+    # Locked as an ordinary SWA-valid hit at B: the admission pin is gone, the
+    # request's own lock holds the tail's window (its uuid on the tail).
+    assert tail.component_data[ComponentType.SWA].lock_ref == 1
+    swa_uuid = req.lock.receipt.component_lock_uuids.get(ComponentType.SWA)
+    assert swa_uuid is not None
+    assert tail.component_data[ComponentType.SWA].metadata.get("uuid") == swa_uuid
+    assert tail.parent.component_data[ComponentType.SWA].value is None
+    assert tail.parent.component_data[ComponentType.SWA].lock_ref == 0
+    assert req.kv.cache_protected_len == BRANCH and req.extend_end == BRANCH + NEW
+    # The next match of the same prefix is an ordinary hit to B, no plan.
+    again = tree.match_prefix(
+        MatchPrefixParams(
+            key=RadixKey(array("q", _branch_req("again").origin_input_ids))
+        )
+    )
+    assert again.swa_rebuild is None and again.device_prefix_len == BRANCH
+    tree.sanity_check()
+    # The request's own release leaves the window evictable, ledgers paired.
+    tree.unlock(req.lock)
+    assert tail.component_data[ComponentType.SWA].lock_ref == 0
+    tree.sanity_check()
+
+
+def test_scratch_is_released_with_the_result():
+    tree = _swa_cache()
+    slots = _store_turn(tree)
+    tree.configure_swa_branch_rebuild(LAYERS)
+    alloc = tree.token_to_kv_pool_allocator
+    swa_free = alloc.swa_available_size()
+    req = _branch_req()
+    _admit(tree, req)
+    with pytest.raises(AssertionError, match="did not replay"):
+        release_scratch([req], alloc)
+    req.swa_rebuild.replayed = True
+    assert release_scratch([req], alloc) == SPAN - TAIL
+    assert req.swa_rebuild is None
+    assert alloc.swa_available_size() == swa_free - TAIL
+    mapping = alloc.full_to_swa_index_mapping
+    assert bool((mapping[slots[BRANCH - SPAN : BRANCH - TAIL]] == 0).all())
+    assert bool((mapping[slots[BRANCH - TAIL : BRANCH]] > 0).all())
+    assert release_scratch([req], alloc) == 0
+
+
+def test_one_rebuild_per_pass():
+    tree = _swa_cache()
+    _store_turn(tree)
+    other = [(5 * i + 1) % VOCAB for i in range(STORED)]
+    _store_turn(tree, other)
+    tree.configure_swa_branch_rebuild(LAYERS)
+    adder, res = _admit(tree, _branch_req())
+    assert res == AddReqResult.CONTINUE
+    second = _req("second", other[:BRANCH] + [1, 2, 3])
+    second.init_next_round_input(tree)
+    plan_node = second.swa_rebuild_match.node
+    assert (
+        adder.add_one_req(second, has_chunked_req=False, truncation_align_size=None)
+        == AddReqResult.OTHER
+    )
+    # Deferred, not declined: nothing happened to its branch point.
+    assert not second.swa_rebuild_declined
+    assert _swa_node(tree, plan_node).value is None
+    _, res = _admit(tree, second)
+    assert res == AddReqResult.CONTINUE and second.swa_rebuild is not None
