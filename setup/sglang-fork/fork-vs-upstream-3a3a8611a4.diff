+def test_the_worker_replays_after_the_hicache_consumer_and_before_the_batch(
+    monkeypatch,
+):
+    from sglang.srt.managers.tp_worker import TpModelWorker
+
+    order = []
+    worker = SimpleNamespace(
+        set_hicache_consumer=lambda index: order.append(("consumer", index)),
+        model_runner=None,
+    )
+    batch = SimpleNamespace(hicache_consumer_index=2, forward_mode=ForwardMode.EXTEND)
+
+    def init_new(*a, **k):
+        order.append("batch")
+        raise _Stop
+
+    with (
+        mock.patch.object(
+            replay_mod,
+            "run_swa_branch_rebuild",
+            side_effect=lambda w, b: order.append(("replay", w, b)),
+        ),
+        mock.patch(
+            "sglang.srt.managers.tp_worker.ForwardBatch.init_new", side_effect=init_new
+        ),
+    ):
+        with pytest.raises(_Stop):
+            TpModelWorker.forward_batch_generation(worker, batch)  # flag off
+        assert order == [("consumer", 2), "batch"]
+        order.clear()
+        monkeypatch.setenv("SGLANG_SWA_BRANCH_REBUILD", "true")
+        with pytest.raises(_Stop):
+            TpModelWorker.forward_batch_generation(worker, batch)
+        assert order == [("consumer", 2), ("replay", worker, batch), "batch"]
+        order.clear()
+        batch.forward_mode = ForwardMode.DECODE
+        with pytest.raises(_Stop):
+            TpModelWorker.forward_batch_generation(worker, batch)
+        assert order == [("consumer", 2), "batch"]
