new file mode 100644
index 0000000000..a356bd165f
--- /dev/null
+++ b/python/sglang/srt/observability/sbr_phase_timing.py
@@ -0,0 +1,595 @@
+"""Per-request stage timer, off unless ``SGLANG_SBR_PHASE_TIMING`` is set (part 0038).
+
+With the flag on, every request carries a ``PhaseStamps`` from the scheduler's
+``Req`` constructor onward, and the scheduler logs ONE INFO line when the request
+finishes, under a fixed greppable prefix::
+
+    sbr-phase rid=<rid> prompt_len=<n> cached_len=<n> uncached_len=<n> \
+        recv_to_tokenize_done_ms=<x> tokenize_done_to_dispatch_ms=<x> \
+        dispatch_to_sched_recv_ms=<x> sched_recv_to_match_prefix_done_ms=<x> \
+        match_prefix_done_to_alloc_done_ms=<x> alloc_done_to_first_token_ms=<x> \
+        first_token_to_finished_ms=<x> wall_ms=<x>
+
+(one line; wrapped here for reading). A delta is named for the two stages it
+spans and is present only when both were reached, so a request that was aborted
+before prefill logs fewer deltas and no zeros. The deltas telescope: their sum is
+exactly ``wall_ms``, the time from the first reached stage to the last.
+
+``cached_len`` is ``Req.cached_tokens``, the count the usage report carries, and
+``prompt_len`` is ``len(origin_input_ids)``.
+
+Stamps are ``time.perf_counter()``. The tokenizer's three stamps reach the
+scheduler inside the ``time_stats`` object the request already carries, under the
+``sbr_phase_*_at`` keys of ``APIServerReqTimeStats.__getstate__`` (and of
+``DPControllerReqTimeStats.__getstate__`` when a data-parallel controller sits
+between). Those keys do not end in ``time``, so ``ReqTimeStatsBase.__setstate__``
+leaves them alone: its realtime-diff shift is for clocks on different hosts, and the
+tokenizer and the scheduler run on one host, where ``perf_counter`` is one
+system-wide monotonic clock. Nothing else on the wire changes.
+
+A stamp is a host-side time. The KV write (``alloc_done``) is stamped when the
+host has queued it; a GPU kernel queued there may still run after the stamp.
+
+Off, the cost is one call of ``active()`` (which tests the module global ``ENABLED``
+first and returns) per request on the tokenizer path (the ``__getstate__`` branch), in
+``Req.__init__`` and per batch in ``prepare_for_extend``, and one module-global test in
+each of the scheduler's other per-request hooks. No stamp is taken, no key is added to
+any pickled state and no line is logged.
+
+Part 0039 adds a second flag, ``SGLANG_SBR_PHASE_TIMING_DETAIL``, and a runtime gate,
+``SGLANG_SBR_PHASE_TIMING_GATE_FILE``.
+
+The gate. When the gate path is set, the timer (0038's stamps and 0039's) is active
+only while that path exists. ``active()`` answers that: ``False`` when the timer is off
+(no stat, no clock read); ``True`` when it is on and no gate path is set; otherwise one
+``os.path.exists`` at most once per second per process, on a monotonic clock. The gate
+is read by the tokenizer, scheduler and detokenizer processes separately, so around an
+open or close one process may follow it up to a second after another: a request near
+the edge logs fewer stages, never a wrong delta. The stamps taken through ``active()``
+(the tokenizer's wire keys, ``Req`` creation, ``alloc_done``) follow the gate at the
+moment they run; a request created while the gate was open keeps what it has and logs
+when it finishes, even if the gate has closed since. ``detail_active()`` is ``active()``
+with DETAIL.
+
+The detail (DETAIL on, and the timer on). Five stages join the scheduler's line between
+``first_token`` and ``finished``: ``cache_start`` and ``cache_done`` around
+``maybe_cache_unfinished_req``, ``stream_start`` at the entry of
+``_stream_output_generation`` (only on a request that already carries ``first_token``,
+never on ``skip_req``), ``payload_built`` after ``acc.to_payload`` and ``first_send``
+after the send to the detokenizer (both on ``acc.output_reqs`` only)::
+
+    sbr-phase rid=… prompt_len=… cached_len=… uncached_len=… batch_reqs=<n> \
+        batch_cached=<n> recv_at=<abs> <deltas…> wall_ms=<x>
+
+``batch_reqs`` and ``batch_cached`` are the request count and the summed ``cached_tokens``
+of the prefill batch that produced the request's first token, its decode requests (a mixed
+batch) not counted; they are left out for a request that never went through one.
+``recv_at`` is the absolute ``perf_counter`` of the first stamp, the join key to the two
+lines below. ``log_finished`` runs before the same batch's send,
+so a request whose first output is also its finish logs without ``payload_built`` and
+``first_send``: those stages are unreached, never negative.
+
+Two more lines, DETAIL only, each logged once per request on its first output::
+
+    sbr-phase-detok rid=… detok_recv_at=<abs> detok_send_at=<abs>
+    sbr-phase-api rid=… path=ids|text prompt_len=… cached_len=… recv_at=<abs> \
+        <deltas…> engine_ttft_ms=<x> wall_ms=<x>
+
+The detokenizer's stamps are batch-level, taken in its event loop: ``detok_recv_at``
+right after ``sock_recv`` returned (before the batch is decoded) and ``detok_send_at``
+right after the output was sent on. Both are absolute ``perf_counter`` values, shared by
+every rid new in the batch. A rid is new when it has no decode-status entry yet, so the
+line comes once per rid, on its first output. The Rust egress (``SGLANG_RUST_SERVER``) has
+no Python detokenizer and logs none.
+
+The API line is written by the tokenizer manager at the one write point of
+``first_token_time``; its stages are ``API_STAGES``, ``recv`` being ``created_time`` and
+``first_output`` being ``first_token_time``, so ``engine_ttft_ms``
+(``get_first_token_latency()``, the value 0037 puts on the chat sglext) equals
+``wall_ms``. ``tm_batch_recv`` is taken in ``handle_loop`` right after ``async_sock_recv``
+returned. ``validate_request_done`` and ``convert_done`` are taken in
+``OpenAIServingBase.handle_request`` before the request has a rid and ride to
+``generate_request`` as a plain attribute of the adapted request (``PRE_ATTR``): not a
+dataclass field, on no wire, and taken off again at ``generate_request``'s entry. The
+Anthropic door does not go through ``handle_request``, so its lines lack those two stages.
+A native ``/generate`` request has its ``created_time`` taken inside ``generate_request``,
+after its entry stamp; ``generate_entry`` is then left out too. ``path`` is ``ids`` when
+``obj.input_ids`` reached ``_tokenize_one_request`` and ``text`` otherwise.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+from typing import Any, Callable, Dict, Iterable, List, Optional, Tuple
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "sbr-phase"
+# The 0039 lines. None starts with ``sbr-phase `` (prefix and a space), the string the
+# 0038 line is matched on.
+DETOK_LOG_PREFIX = "sbr-phase-detok"
+API_LOG_PREFIX = "sbr-phase-api"
+CACHE_LOG_PREFIX = "sbr-phase-cache"
+
+# Stage order. Deltas are taken between consecutive reached stages in this order.
+# The five between ``first_token`` and ``finished`` are 0039's (DETAIL only).
+STAGES: Tuple[str, ...] = (
+    "recv",
+    "tokenize_done",
+    "dispatch",
+    "sched_recv",
+    "match_prefix_done",
+    "alloc_done",
+    "first_token",
+    "cache_start",
+    "cache_done",
+    "stream_start",
+    "payload_built",
+    "first_send",
+    "finished",
+)
+
+# The tokenizer manager's stages for the ``sbr-phase-api`` line (0039, DETAIL only).
+API_STAGES: Tuple[str, ...] = (
+    "recv",
+    "validate_request_done",
+    "convert_done",
+    "generate_entry",
+    "state_ready",
+    "tokenize_entry",
+    "validate_one_start",
+    "validate_one_done",
+    "tokenize_done",
+    "dispatch",
+    "tm_batch_recv",
+    "first_output",
+)
+
+# The attribute that carries the pre-rid stamps from ``handle_request`` to
+# ``generate_request`` on the adapted request object.
+PRE_ATTR = "sbr_api_pre"
+
+# (stage, wire attribute). The tokenizer's three stamps, carried through the IPC
+# pickle as attributes of the request's time_stats object.
+WIRE_KEYS: Tuple[Tuple[str, str], ...] = (
+    ("recv", "sbr_phase_recv_at"),
+    ("tokenize_done", "sbr_phase_tokenize_done_at"),
+    ("dispatch", "sbr_phase_dispatch_at"),
+)
+WIRE_ATTRS: Tuple[str, ...] = tuple(attr for _, attr in WIRE_KEYS)
+
+# Read once at import. The gate is a module global so an off server pays one
+# global test per call and never reads the environment again.
+ENABLED: bool = envs.SGLANG_SBR_PHASE_TIMING.get()
+# 0039: the detail stamps and lines, effective only with ENABLED, and the runtime gate.
+DETAIL: bool = ENABLED and envs.SGLANG_SBR_PHASE_TIMING_DETAIL.get()
+GATE_FILE: str = envs.SGLANG_SBR_PHASE_TIMING_GATE_FILE.get()
+GATE_RECHECK_S: float = 1.0
+
+# The gate's clock and existence test, module attributes so a test can inject both.
+_clock: Callable[[], float] = time.monotonic
+_path_exists: Callable[[str], bool] = os.path.exists
+_gate_checked_at: Optional[float] = None
+_gate_open: bool = False
+
+
+def gate_open() -> bool:
+    """Whether the gate path exists, looked up at most once per ``GATE_RECHECK_S``."""
+    global _gate_checked_at, _gate_open
+    now = _clock()
+    if _gate_checked_at is None or now - _gate_checked_at >= GATE_RECHECK_S:
+        _gate_open = bool(_path_exists(GATE_FILE))
+        _gate_checked_at = now
+    return _gate_open
+
+
+def active() -> bool:
+    """Whether the timer runs now: ``ENABLED``, and the gate open if one is set."""
+    if not ENABLED:
+        return False
+    if not GATE_FILE:
+        return True
+    return gate_open()
+
+
+def detail_active() -> bool:
+    """Whether the 0039 detail is running now: DETAIL, and ``active()``."""
+    if not DETAIL:
+        return False
+    return active()
+
+
+class RecheckedPathGate:
+    """``gate_open``'s rule for another path, as an object (part 0040's memo gate).
+
+    ``is_open()`` is ``True`` when no path is set; otherwise whether the path
+    exists, looked up at most once per ``recheck_s`` on ``clock``. ``clock`` and
+    ``path_exists`` are instance attributes so a test can inject both. The timer's
+    own gate above keeps its module globals unchanged.
+    """
+
+    def __init__(self, path: str, recheck_s: float = GATE_RECHECK_S) -> None:
+        self.path = path
+        self.recheck_s = recheck_s
+        self.clock: Callable[[], float] = time.monotonic
+        self.path_exists: Callable[[str], bool] = os.path.exists
+        self._checked_at: Optional[float] = None
+        self._open = False
+
+    def is_open(self) -> bool:
+        if not self.path:
+            return True
+        now = self.clock()
+        if self._checked_at is None or now - self._checked_at >= self.recheck_s:
+            self._open = bool(self.path_exists(self.path))
+            self._checked_at = now
+        return self._open
+
+
+def apiserver_wire_state(ts: Any) -> Dict[str, float]:
+    """The three wire keys for an ``APIServerReqTimeStats`` (tokenizer side)."""
+    return {
+        "sbr_phase_recv_at": ts.created_time,
+        "sbr_phase_tokenize_done_at": ts.tokenize_finish_time,
+        "sbr_phase_dispatch_at": ts.api_server_dispatch_time,
+    }
+
+
+def dpc_wire_state(ts: Any) -> Dict[str, float]:
+    """The three wire keys for a ``DPControllerReqTimeStats`` (DP controller side)."""
+    return {attr: getattr(ts, attr, 0.0) for attr in WIRE_ATTRS}
+
+
+class PhaseStamps:
+    """Stage stamps of one request, owned by the scheduler process."""
+
+    __slots__ = ("stamps", "logged", "detail", "batch_reqs", "batch_cached")
+
+    def __init__(self, detail: bool = False) -> None:
+        self.stamps: Dict[str, float] = {}
+        self.logged = False
+        # DETAIL, fixed when the request was created: the 0039 hooks read this
+        # flag, not the gate, so a request is stamped whole or not at all.
+        self.detail = detail
+        # The prefill batch that produced the first token (DETAIL only).
+        self.batch_reqs: Optional[int] = None
+        self.batch_cached: Optional[int] = None
+
+    def mark_once(self, stage: str, ts: Optional[float] = None) -> None:
+        """Stamp ``stage`` the first time it is reached; later calls are no-ops."""
+        if stage not in self.stamps:
+            self.stamps[stage] = time.perf_counter() if ts is None else ts
+
+
+def start_for_req(time_stats: Any) -> PhaseStamps:
+    """Build a request's stamps from the ``time_stats`` it was constructed with.
+
+    Only called when ``active()``. The tokenizer's stamps are read from the wire
+    attributes; a stage the request did not pass through (no tokenizer hop, or a
+    DP controller that predates the stamp) is simply absent.
+    """
+    phase = PhaseStamps(detail=DETAIL)
+    if time_stats is not None:
+        for stage, attr in WIRE_KEYS:
+            ts = getattr(time_stats, attr, 0.0)
+            if ts:
+                phase.stamps[stage] = ts
+    phase.mark_once("sched_recv")
+    return phase
+
+
+def mark_batch(reqs: Iterable[Any], stage: str) -> None:
+    """Stamp ``stage`` on every request in a batch that carries stamps."""
+    now = time.perf_counter()
+    for req in reqs:
+        phase = req.sbr_phase
+        if phase is not None:
+            phase.mark_once(stage, now)
+
+
+def mark_detail(req: Any, stage: str) -> None:
+    """Stamp a 0039 ``stage`` on one request that carries detail stamps."""
+    phase = getattr(req, "sbr_phase", None)
+    if phase is not None and phase.detail:
+        phase.mark_once(stage)
+
+
+def mark_detail_batch(reqs: Iterable[Any], stage: str) -> None:
+    """Stamp a 0039 ``stage`` once, at one instant, on each request with the detail."""
+    now = time.perf_counter()
+    for req in reqs:
+        phase = getattr(req, "sbr_phase", None)
+        if phase is not None and phase.detail:
+            phase.mark_once(stage, now)
+
+
+def mark_stream_start(reqs: Iterable[Any], skip_req: Any = None) -> None:
+    """Stamp ``stream_start`` on the requests that already carry ``first_token``.
+
+    A request the batch is told to skip (a chunked request still in prefill) is
+    never stamped, and neither is one that has no first token yet.
+    """
+    now = time.perf_counter()
+    for req in reqs:
+        if req is skip_req:
+            continue
+        phase = getattr(req, "sbr_phase", None)
+        if phase is not None and phase.detail and "first_token" in phase.stamps:
+            phase.mark_once("stream_start", now)
+
+
+def note_prefill_batch(
+    reqs: List[Any], decoding_reqs: Optional[List[Any]] = None
+) -> None:
+    """Record the prefill batch's size and cached-token total on its detail requests.
+
+    Called before the batch's first tokens are stamped. The decode requests of a mixed
+    batch (``decoding_reqs``) are not part of the prefill and are not counted; a request
+    that already has its ``first_token`` keeps the batch that produced it.
+    """
+    decoding = {id(req) for req in decoding_reqs or ()}
+    members = [req for req in reqs if id(req) not in decoding]
+    targets = []
+    for req in members:
+        phase = getattr(req, "sbr_phase", None)
+        if phase is not None and phase.detail and "first_token" not in phase.stamps:
+            targets.append(phase)
+    if not targets:
+        return
+    batch_reqs = len(members)
+    batch_cached = sum(int(getattr(req, "cached_tokens", 0) or 0) for req in members)
+    for phase in targets:
+        phase.batch_reqs = batch_reqs
+        phase.batch_cached = batch_cached
+
+
+def phase_deltas(
+    stamps: Dict[str, float], stages: Tuple[str, ...] = STAGES
+) -> Tuple[List[Tuple[str, float]], float]:
+    """Deltas in seconds between consecutive reached stages, and the wall time.
+
+    Returns ``([("recv_to_tokenize_done", dt), ...], wall)``. The deltas telescope:
+    their sum is ``wall``, the last reached stamp minus the first.
+    """
+    reached = [(s, stamps[s]) for s in stages if s in stamps]
+    deltas = [
+        (f"{a}_to_{b}", tb - ta) for (a, ta), (b, tb) in zip(reached, reached[1:])
+    ]
+    wall = reached[-1][1] - reached[0][1] if len(reached) > 1 else 0.0
+    return deltas, wall
+
+
+def first_stamp(
+    stamps: Dict[str, float], stages: Tuple[str, ...] = STAGES
+) -> Optional[float]:
+    """The earliest reached stage's stamp, in the order of ``stages``."""
+    for stage in stages:
+        if stage in stamps:
+            return stamps[stage]
+    return None
+
+
+def format_line(
+    rid: str,
+    prompt_len: int,
+    cached_len: int,
+    stamps: Dict[str, float],
+    *,
+    detail: bool = False,
+    batch_reqs: Optional[int] = None,
+    batch_cached: Optional[int] = None,
+) -> str:
+    deltas, wall = phase_deltas(stamps)
+    fields = [
+        f"{LOG_PREFIX} rid={rid}",
+        f"prompt_len={prompt_len}",
+        f"cached_len={cached_len}",
+        f"uncached_len={prompt_len - cached_len}",
+    ]
+    if detail:
+        if batch_reqs is not None:
+            fields.append(f"batch_reqs={batch_reqs}")
+        if batch_cached is not None:
+            fields.append(f"batch_cached={batch_cached}")
+        recv_at = first_stamp(stamps)
+        if recv_at is not None:
+            fields.append(f"recv_at={recv_at:.6f}")
+    fields += [f"{name}_ms={dt * 1e3:.3f}" for name, dt in deltas]
+    fields.append(f"wall_ms={wall * 1e3:.3f}")
+    return " ".join(fields)
+
+
+def log_finished(req: Any) -> None:
+    """Log the one line for ``req`` once it has finished. A no-op when off."""
+    phase = req.sbr_phase
+    if phase is None or phase.logged or not req.finished():
+        return
+    phase.logged = True
+    phase.mark_once("finished")
+    logger.info(
+        format_line(
+            req.rid,
+            len(req.origin_input_ids),
+            req.cached_tokens,
+            phase.stamps,
+            detail=phase.detail,
+            batch_reqs=phase.batch_reqs,
+            batch_cached=phase.batch_cached,
+        )
+    )
+
+
+def log_cache_class(tree_cache: Any, hisparse: bool) -> None:
+    """The scheduler's live prefix-cache class, logged once at start (DETAIL only)."""
+    cache_class = type(tree_cache).__name__
+    logger.info(f"{CACHE_LOG_PREFIX} class={cache_class} hisparse={bool(hisparse)}")
+
+
+# --- the detokenizer's line ------------------------------------------------------
+
+
+def format_detok_line(rid: str, recv_at: float, send_at: float) -> str:
+    return (
+        f"{DETOK_LOG_PREFIX} rid={rid} "
+        f"detok_recv_at={recv_at:.6f} detok_send_at={send_at:.6f}"
+    )
+
+
+def detok_begin(
+    decode_status: Any, rids: Iterable[str]
+) -> Optional[Tuple[float, List[str]]]:
+    """At the detokenizer handler's entry: the receipt stamp and the rids new to it.
+
+    ``None`` when the detail is off or no rid is new, so the exit has nothing to do.
+    Must run before the batch is decoded, which creates the decode-status entries.
+    """
+    if not detail_active():
+        return None
+    recv_at = time.perf_counter()
+    new_rids = [rid for rid in rids if rid not in decode_status]
+    if not new_rids:
+        return None
+    return recv_at, new_rids
+
+
+def detok_end(token: Tuple[float, List[str]]) -> None:
+    """At the handler's exit, the output built: one line per rid new in the batch."""
+    recv_at, new_rids = token
+    send_at = time.perf_counter()
+    for rid in new_rids:
+        logger.info(format_detok_line(rid, recv_at, send_at))
+
+
+# --- the tokenizer manager's line --------------------------------------------------
+
+
+class ApiStamps:
+    """The tokenizer-side stage stamps of one request (a ``ReqState`` attribute)."""
+
+    __slots__ = ("stamps", "path")
+
+    def __init__(self, path: str) -> None:
+        self.stamps: Dict[str, float] = {}
+        self.path = path
+
+    def mark_once(self, stage: str, ts: Optional[float] = None) -> None:
+        if stage not in self.stamps:
+            self.stamps[stage] = time.perf_counter() if ts is None else ts
+
+
+def path_label(obj: Any) -> str:
+    """``ids`` when the request carries ``input_ids``, ``text`` when it is tokenized."""
+    return "ids" if getattr(obj, "input_ids", None) is not None else "text"
+
+
+def api_pre_begin() -> Optional[Dict[str, float]]:
+    """In ``handle_request``: the dict that collects the pre-rid stamps, or ``None``."""
+    return {} if detail_active() else None
+
+
+def attach_pre_stamps(adapted_request: Any, pre: Dict[str, float]) -> None:
+    """Put the pre-rid stamps on the adapted request, as a plain attribute.
+
+    Not a dataclass field: ``dataclasses.fields`` / ``asdict`` and the wire encoders
+    never see it. ``take_pre_stamps`` removes it again at ``generate_request``'s entry.
+    """
+    setattr(adapted_request, PRE_ATTR, pre)
+
+
+def take_pre_stamps(obj: Any) -> Optional[Dict[str, float]]:
+    """Remove and return the pre-rid stamps ``attach_pre_stamps`` put on ``obj``."""
+    attrs = getattr(obj, "__dict__", None)
+    if attrs is None:
+        return None
+    return attrs.pop(PRE_ATTR, None)
+
+
+def api_begin(
+    state: Any, pre: Optional[Dict[str, float]], entry_at: float, ready_at: float
+) -> None:
+    """In ``generate_request``, once the state exists and the request is logged."""
+    api = ApiStamps(path_label(state.obj))
+    if pre:
+        api.stamps.update(pre)
+    # A native /generate request is created (created_time) inside generate_request,
+    # after its entry: there is no span before the entry to report.
+    if entry_at >= state.time_stats.created_time:
+        api.stamps["generate_entry"] = entry_at
+    api.stamps["state_ready"] = ready_at
+    state.sbr_api = api
+
+
+def api_tokenize_entry(state: Any, obj: Any) -> Optional[ApiStamps]:
+    """At the top of ``_tokenize_one_request``: stamp the entry, label the path."""
+    api = getattr(state, "sbr_api", None)
+    if api is None:
+        return None
+    api.mark_once("tokenize_entry")
+    api.path = path_label(obj)
+    return api
+
+
+def format_api_line(
+    rid: str,
+    path: str,
+    prompt_len: int,
+    cached_len: int,
+    stamps: Dict[str, float],
+    engine_ttft_s: float,
+) -> str:
+    deltas, wall = phase_deltas(stamps, API_STAGES)
+    fields = [
+        f"{API_LOG_PREFIX} rid={rid}",
+        f"path={path}",
+        f"prompt_len={prompt_len}",
+        f"cached_len={cached_len}",
+    ]
+    recv_at = first_stamp(stamps, API_STAGES)
+    if recv_at is not None:
+        fields.append(f"recv_at={recv_at:.6f}")
+    fields += [f"{name}_ms={dt * 1e3:.3f}" for name, dt in deltas]
+    fields.append(f"engine_ttft_ms={engine_ttft_s * 1e3:.3f}")
+    fields.append(f"wall_ms={wall * 1e3:.3f}")
+    return " ".join(fields)
+
+
+def log_api_line(
+    state: Any,
+    rid: str,
+    prompt_len: int,
+    cached_len: int,
+    tm_recv_at: Optional[float],
+) -> None:
+    """At the single write point of ``first_token_time``: log the request's API line.
+
+    Logs once (the stamps are dropped from the state) and does nothing for a state
+    that was not begun, which is every state when the detail is off.
+    """
+    api = getattr(state, "sbr_api", None)
+    if api is None:
+        return
+    state.sbr_api = None
+    ts = state.time_stats
+    stamps = dict(api.stamps)
+    stamps["recv"] = ts.created_time
+    if ts.tokenize_finish_time:
+        stamps["tokenize_done"] = ts.tokenize_finish_time
+    if ts.api_server_dispatch_time:
+        stamps["dispatch"] = ts.api_server_dispatch_time
+    if tm_recv_at is not None:
+        stamps["tm_batch_recv"] = tm_recv_at
+    stamps["first_output"] = ts.first_token_time
+    logger.info(
+        format_api_line(
+            rid,
+            api.path,
+            prompt_len,
+            cached_len,
+            stamps,
+            ts.get_first_token_latency(),
+        )
+    )
