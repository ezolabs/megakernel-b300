+async def test_a_placeholder_messages_body_streams_the_same_response(
+    tokenizer, box_c_env
+):
+    """The stream: ``_generate_chat_stream`` builds a ``ReasoningParser`` per choice and
+    reads ``_get_history_tool_calls_cnt`` for every tool-call delta. The scheduler's answer
+    arrives in 3-token steps, so the reasoning and DSML markers are cut at awkward
+    places; the frames must be the same, byte for byte but for the clock."""
+    chat = _handler(tokenizer)
+    streams = {}
+    for record in RECORDS:
+        adapted, real, _ = _convert(chat, record["egress"], record["router_ids"])
+        adapted_ph, placeholder, _ = _convert_with_placeholder(chat, record)
+        text = _engine_text(chat, real)
+        a = await _stream(chat, adapted, real, text)
+        b = await _stream(chat, adapted_ph, placeholder, text)
+        assert a == b, record["id"]
+        assert a[-1] == "data: [DONE]\n\n", record["id"]
+        streams[record["id"]] = _read_stream(a)
+    may_call = [
+        r["id"]
+        for r in RECORDS
+        if r["egress"].get("tools") and r["egress"]["tool_choice"] != "none"
+    ]
+    assert [i for i, s in streams.items() if s["calls"]] == may_call
+    assert len([i for i, s in streams.items() if s["reasoning"]]) == 43
+    example = streams["thinking-tool-01/turn2"]
+    assert example["reasoning"] == _REASONING
+    assert example["content"].strip() == _ANSWER
+    names = [c["function"].get("name") for c in example["calls"]]
+    assert [name for name in names if name] == ["get_weather"]
