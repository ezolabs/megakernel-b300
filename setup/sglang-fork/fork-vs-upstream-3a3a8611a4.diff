+def _prompt(n_images):
+    ids = [1, 2]
+    for i in range(n_images):
+        ids += [IMG, 100 + i]
+    return ids
+
+
+def _process(images, refs=None, n_images=None):
+    request = SimpleNamespace(mm_cached_refs=refs)
+    ids = _prompt(len(images) if n_images is None else n_images)
+    return asyncio.run(
+        _processor().process_mm_data_async(images, ids, request_obj=request)
+    )
