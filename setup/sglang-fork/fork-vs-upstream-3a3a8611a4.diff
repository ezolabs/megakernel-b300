@@ -0,0 +1,161 @@
+"""Row-level replay simulator for the DSv4.1 exact decoder trim (far-chunk skip).
+
+Not a unit test: a standalone numpy script kept next to
+test_dsv41_exact_decoder_trim.py so the far-skip analysis can be re-run. It
+replays a chunked prefill of DeepSeek-V4.1-Flash-1017 under decoder SWA
+bounded replay and tracks, per late layer (20..39) and per row, whether the
+row's KV was written and whether its output equals full prefill. Constants:
+window W=128, L=40 layers, late start LS=20, exact tail R=2560
+(exact_tail_len(128, 40, 20, 256)).
+
+replay(P, ends, m=, far_skip=, g_floor=) models one request of P prompt rows,
+a prefix hit of m rows and chunk ends `ends`. A computed chunk runs its late
+layers on rows [max(start, pf(e)-R), e) with the window floored at
+max(pf(e)-R, G), pf = page floor (256), the page-anchored exact tail
+(G = last skipped chunk end when g_floor). With far_skip, a chunk with
+e <= pf(P)-R skips late layers except one tail row. page_anchored=False
+replays the seq-anchored e-R / P-R layout of item #88. checks() reports whether the
+final logits row and the final W-row window are exact on every late layer,
+and how many trailing rows of layers 36/37/38 (DSpark capture at target
+layers 37/38/39 = input of that layer) are exact.
+
+Usage (numpy only; seed defaults to 0):
+    python test/registered/unit/layers/dsv41_exact_trim_sim.py [seed]
+
+Results (page-anchored, fork-op item #268, seed 0, run on the build host with
+/opt/box-f-fork/venv-cpu; seq-anchored item #88 numbers in parentheses):
+  * 60k-token cold fill at chunk 4096, row-layers vs. full prefill:
+    tail-only   saving 17.92% (18.00%), late_rows=38496 (38400), logits +
+                final window exact
+    far-skip    saving 47.78% (47.86%), late_rows=2670 (2574), 14 chunks
+                skipped, exact
+  * DSpark exact trailing rows {37: 497, 38: 370, 39: 243}
+    ({37: 401, 38: 274, 39: 147}) >= draft window 128, so the draft context
+    stays exact.
+  * 300 random chunkings / prefix hits with far-skip: 0 failures (with and
+    without the G floor at seed 0).
+  * Prefix hit with fewer than R new rows (m = P-1 .. P-2432) is inexact when
+    the reprefill tail is W (swa_reprefill_tail_tokens under bounded replay);
+    exact only once m <= P-R, so exact mode needs a reprefill tail of R.
+"""
+
+import random
+import sys
+
+import numpy as np
+
+try:
+    from sglang.test.ci.ci_register import register_cpu_ci
+except ImportError:  # standalone run without sglang on the path
+
+    def register_cpu_ci(**_):
+        pass
+
+
+register_cpu_ci(
+    est_time=0,
+    suite="base-a-test-cpu",
+    disabled="exact-trim simulator script, not a unit test",
+)
+
+W, L, LS, R, PG = 128, 40, 20, 2560, 256
+LATE = list(range(LS, L))
+
+def pf(n):
+    return n // PG * PG
+
+
+def replay(
+    P, ends, *, m=0, far_skip=False, g_floor=True, skip_row=True, page_anchored=True
+):
+    """ends: chunk ends after prefix m. Returns (computed, exact, late_rows, skipped).
+    page_anchored: floor the tail at pf(e) - R (the exact trim's layout) and skip
+    chunks with e <= pf(P) - R; False is the seq-anchored e - R / P - R."""
+    comp = {l: np.zeros(P, bool) for l in LATE}
+    ex = {l: np.zeros(P, bool) for l in LATE}
+    G, start, late_rows, skipped = m, m, 0, []
+    anchor = pf if page_anchored else (lambda n: n)
+    for e in ends:
+        if far_skip and e <= anchor(P) - R and e < P:
+            skipped.append(e)
+            if skip_row:  # keep one row (the last) so every request has a tail row
+                for l in LATE:
+                    comp[l][e - 1] = True; ex[l][e - 1] = False
+                late_rows += 1
+            G = e
+            start = e
+            continue
+        a = max(start, anchor(e) - R, 0)
+        f = max(anchor(e) - R, 0)
+        if g_floor:
+            f = max(f, G)
+        rows = np.arange(a, e)
+        late_rows += e - a
+        for l in LATE:
+            comp[l][a:e] = True
+        for l in LATE:
+            bad = ~comp[l] if l == LS else (~comp[l] | ~ex[l - 1])
+            cs = np.concatenate([[0], np.cumsum(bad)])
+            cut = np.maximum(rows - W + 1, 0)
+            ok = (cut >= f) & (cs[rows + 1] - cs[cut] == 0)
+            ex[l][a:e] = ok
+        start = e
+    return comp, ex, late_rows, skipped
+
+
+def checks(P, comp, ex):
+    logits = bool(ex[L - 1][P - 1])
+    win = range(max(0, P - W), P)
+    window = all(comp[l][r] for l in LATE for r in win) and all(ex[l][r] for l in LATE[:-1] for r in win)
+    # DSpark capture at target layer i = input of layer i = output of i-1
+    dspark = {i: int(np.argmin(ex[i - 1][::-1]) if not ex[i - 1].all() else P) for i in (37, 38, 39)}
+    return logits, window, dspark
+
+
+def chunked(P, m, C):
+    ends, p = [], m
+    while p < P:
+        p = min(P, p + C); ends.append(p)
+    return ends
+
+
+def main(seed=0):
+    P, C = 60000, 4096
+    ends = chunked(P, 0, C)
+    base = P * L
+    for name, kw in (("tail-only", {}), ("far-skip", {"far_skip": True})):
+        comp, ex, late_rows, sk = replay(P, ends, **kw)
+        lg, win, ds = checks(P, comp, ex)
+        cost = P * LS + late_rows * (L - LS)
+        print(f"{name}: logits_exact={lg} final_window_exact={win} dspark_exact_last_rows={ds} "
+              f"late_rows={late_rows} skipped_chunks={len(sk)} row-layers={cost} saving={1-cost/base:.4f}")
+    # lossy default for comparison
+    comp, ex, lr, _ = replay(P, ends)
+    # random chunkings incl. short chunks, random capped prefix hits
+    rng = random.Random(seed)
+    fails = {"g": 0, "nog": 0}
+    n = 0
+    for trial in range(300):
+        P = rng.randint(R + 1, 12000)
+        m = rng.choice([0, 0, rng.randint(0, P - R)])
+        ends, p = [], m
+        while p < P:
+            p = min(P, p + rng.choice([rng.randint(1, 300), rng.randint(1, 3000), rng.randint(2000, 6000)])); ends.append(p)
+        for key, g in (("g", True), ("nog", False)):
+            comp, ex, _, _ = replay(P, ends, m=m, far_skip=True, g_floor=g)
+            lg, win, ds = checks(P, comp, ex)
+            if not (lg and win and min(ds.values()) >= W):
+                fails[key] += 1
+        n += 1
+    print(f"random trials={n} far-skip failures: with G floor={fails['g']}, without G floor={fails['nog']}")
+    # reprefill cap bug: match capped at P-W (current swa_reprefill_tail_tokens) with exact R tail
+    bad = 0
+    for new in (1, 50, 128, 500, 2000, 2432, 2560):
+        P = 20000; m = P - new
+        comp, ex, _, _ = replay(P, [P], m=m, g_floor=False)
+        lg, win, ds = checks(P, comp, ex)
+        print(f"prefix hit m=P-{new}: tail floor pf(P)-R reads unwritten late rows below m -> logits_exact={lg} window_exact={win}")
+
+
+if __name__ == "__main__":
+    main(int(sys.argv[1]) if len(sys.argv) > 1 else 0)
