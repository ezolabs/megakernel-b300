+    def test_router_reading_matches_its_rust_tests(self):
+        """_RouterArguments reads the router's own pinned cases as the router
+        does (the serving router crates/sbr-wire/src/sglang/stream.rs at
+        bdf5d0607: :3539-3558, :3562-3580 and :3591-3597), the ambiguous
+        `{"a": ` then `{"a": "y"}` split included."""
+
+        def read(fragments):
+            reader = _RouterArguments()
+            return [reader.delta(f) for f in fragments], reader.sent
+
+        self.assertEqual(
+            read(['{"location": ', '"San Francisco"}']),
+            (['{"location": ', '"San Francisco"}'], '{"location": "San Francisco"}'),
+        )
+        self.assertEqual(
+            read(['{"location": ', '{"location": "San Francisco"}']),
+            (['{"location": ', '"San Francisco"}'], '{"location": "San Francisco"}'),
+        )
+        self.assertEqual(
+            "".join(read(['{"n": ', "1", "1", "1", "1}"])[0]), '{"n": 1111}'
+        )
+        self.assertEqual(
+            "".join(read(['{"n": 11', '{"n": 1111}', '{"n": 1111}'])[0]),
+            '{"n": 1111}',
+        )
+        self.assertEqual(
+            read(['{"a": ', '{"a": "y"}', "}"]),
+            (['{"a": ', '"y"}', "}"], '{"a": "y"}}'),
