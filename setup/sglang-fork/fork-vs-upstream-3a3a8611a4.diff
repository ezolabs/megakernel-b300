+# --------------------------------------------------------------------------------------
+# Images on the input_ids path (part 0034, #10175; this section and its fixture, #10176)
+# --------------------------------------------------------------------------------------
+#
+# DeepSeek-V4.1 is multimodal. Its prompt ids hold ONE ``image_token_id`` (129264) per
+# image, and the tokenizer manager's multimodal processor expands each into the run of
+# ``image_token_id`` ids planned from the image's pixel size and attaches the pixels as a
+# ``MultimodalDataItem``. The processor runs only when the request carries ``image_data``.
+# The handler's ``input_ids`` branch used to set ``image_data=None``, so a body with ids and
+# images was served as bare placeholders with no vision features, and nothing complained:
+# the engine does not check ids against messages. Part 0034 keeps the images on that branch,
+# read from ``request.messages`` in the order the messages path reads them.
+#
+# ``fixtures/chat_input_ids_dsv41_images.jsonl.gz`` (router repo
+# ``sglang-patches/b4da0c4b/ids_images/record_ids_images.py``) holds, per body, the engine's
+# own recording: the ids its messages path renders (one placeholder per image), the ids the
+# processor expands them to (what ``x-sglext-return-input-ids`` returns), and each image's
+# offsets, token grid and feature shape. A record's ``image_only_messages`` is the array the
+# router may send in place of the conversation: the messages that hold an image, each reduced
+# to its image parts.
+
+IMAGES_FIXTURE = (
+    Path(__file__).parent / "fixtures" / "chat_input_ids_dsv41_images.jsonl.gz"
+)
+IMAGE_TOKEN_ID = 129264  # <｜deepseek_image｜>: hf_config.image_token_id on DeepSeek-V4.1
+EXACT_GATE = 642_000  # the router's live exact-count gate, in prompt tokens
+VISION_FIELDS = (
+    "image_token_id",
+    "vision_patch_size",
+    "vision_downsample_ratio",
+    "vision_max_n_token",
+    "vision_min_pixels",
+    "vision_max_wh_ratio",
+)
+
+
+@functools.lru_cache(maxsize=None)
+def _image_fixture():
+    with gzip.open(IMAGES_FIXTURE, "rt", encoding="utf-8") as fh:
+        lines = [json.loads(line) for line in fh]
+    return lines[0]["meta"], lines[1:]
+
+
+def _image_records() -> List[dict]:
+    return _image_fixture()[1]
+
+
+def _ids_of(record: dict, key: str) -> List[int]:
+    """An id array of a record: a plain list, or ``{prefix, unit, repeat, suffix}`` for the
+    one body whose 650k-token text is a single repeated unit."""
+    value = record[key]
+    if isinstance(value, list):
+        return value
+    return value["prefix"] + value["unit"] * value["repeat"] + value["suffix"]
+
+
+def _urls_in_message_order(messages: List[dict]) -> List[str]:
+    """The image URLs of a messages array, in message order and, inside a message, in part
+    order. The messages path's media order; written here without the engine's walk."""
+    return [
+        part["image_url"]["url"]
+        for message in messages
+        if isinstance(message.get("content"), list)
+        for part in message["content"]
+        if part.get("type") == "image_url"
+    ]
+
+
+def _images_by_message_order(record: dict) -> List[dict]:
+    """A record lists its images in placeholder (render) order; this puts them back in message order."""
+    return sorted(record["images"], key=lambda image: image["index"])
+
+
+def _render_order_of(messages: List[dict]) -> List[int]:
+    """The image indices of ``messages`` (message order) in the order the render places them: a
+    run of consecutive tool results is rendered in the call order of the last assistant's
+    ``tool_calls`` (``sort_tool_results_by_call_order``), and anything else keeps its place. Written
+    here from the rule, not read from the engine."""
+    counts = [
+        sum(1 for part in m["content"] if part.get("type") == "image_url")
+        if isinstance(m.get("content"), list)
+        else 0
+        for m in messages
+    ]
+    starts, total = [], 0
+    for count in counts:
+        starts.append(total)
+        total += count
+    slots = list(range(len(messages)))
+    call_order: Dict[str, int] = {}
+    i = 0
+    while i < len(messages):
+        message = messages[i]
+        if message["role"] == "assistant":
+            if message.get("tool_calls"):
+                call_order = {call["id"]: k for k, call in enumerate(message["tool_calls"])}
+            i += 1
+        elif message["role"] in ("user", "tool"):
+            # a user message and the tool messages after it share one rendered user message
+            j = i
+            while j < len(messages) and messages[j]["role"] in ("user", "tool"):
+                j += 1
+            group = list(range(i, j))
+            tools = [k for k in group if messages[k]["role"] == "tool"]
+            if len(tools) > 1 and call_order:
+                tools.sort(key=lambda k: call_order.get(messages[k]["tool_call_id"], 0))
+            moved = iter(tools)
+            slots[i:j] = [next(moved) if messages[k]["role"] == "tool" else k for k in group]
+            i = j
+        else:
+            i += 1
+    order: List[int] = []
+    for index in slots:
+        order.extend(range(starts[index], starts[index] + counts[index]))
+    return order
+
+
+def _expanded_by_runs(ids: List[int], runs: List[int]) -> List[int]:
+    """The processor's expansion, written here: each placeholder becomes a run of the image token,
+    one run per image in order."""
+    placeholder = _image_fixture()[0]["image_token_id"]
+    expanded: List[int] = []
+    run = 0
+    for token in ids:
+        if token == placeholder:
+            expanded.extend([placeholder] * runs[run])
+            run += 1
+        else:
+            expanded.append(token)
+    return expanded
+
+
+def _image_only_messages(messages: List[dict]) -> List[dict]:
+    """``messages`` reduced to its images: each message that holds one, with its role and
+    ``tool_call_id`` and only its ``image_url`` parts, in order. A conversation with no
+    image is the router's one-message placeholder."""
+    kept = []
+    for message in messages:
+        if not isinstance(message.get("content"), list):
+            continue
+        parts = [p for p in message["content"] if p.get("type") == "image_url"]
+        if not parts:
+            continue
+        reduced = {"role": message["role"], "content": parts}
+        if "tool_call_id" in message:
+            reduced["tool_call_id"] = message["tool_call_id"]
+        kept.append(reduced)
+    return kept or json.loads(PLACEHOLDER_MESSAGES_JSON)
+
+
+def _contract_variants(messages: List[dict]) -> Dict[str, List[dict]]:
+    """Other messages arrays that carry the same images in the same order. The engine reads
+    nothing else of them on the ``input_ids`` path, so all of them give the request the
+    conversation gives."""
+    only = _image_only_messages(messages)
+    parts = [p for m in only for p in m["content"]]
+    return {
+        # any role will do, and the tool-call id is not read
+        "roles_user": [{"role": "user", "content": m["content"]} for m in only],
+        # one message holding every image
+        "one_message": [{"role": "user", "content": parts}],
+        # every message kept, its text parts gone
+        "all_kept": [
+            {
+                "role": m["role"],
+                "content": (
+                    [p for p in m["content"] if p.get("type") == "image_url"] or ""
+                    if isinstance(m.get("content"), list)
+                    else ""
+                ),
+            }
+            for m in messages
+        ],
+    }
+
+
+def _urls(image_data):
+    """The urls of a request's ``image_data``: upstream wraps each in an ImageData."""
+    if image_data is None:
+        return None
+    return [getattr(item, "url", item) for item in image_data]
+
+
+def _mm_chat(tokenizer) -> OpenAIServingChat:
+    """box-c's handler with the multimodal switch on and DeepSeek-V4.1's image token id: the
+    two things its ``model_config`` answers that the text-only handler does not."""
+    chat = _handler(tokenizer)
+    chat.tokenizer_manager.model_config.is_multimodal = True
+    chat.tokenizer_manager.model_config.hf_config.image_token_id = IMAGE_TOKEN_ID
+    # Upstream's DSv4.1 render reads the manager's own copy (model_config's).
+    chat.tokenizer_manager.image_token_id = IMAGE_TOKEN_ID
+    return chat
+
+
+def _build_mm_processor(tokenizer):
+    """The real ``DeepseekV41ImageProcessor``, on CPU, with the runtime context's namespace
+    bags replaced by the few values it reads. Returns ``(processor, undo)``."""
+    from sglang.srt.configs.deepseek_v4 import DeepSeekV4Config
+    from sglang.srt.multimodal.processors import base_processor, deepseek_v41
+    from sglang.srt.utils import common
+
+    fields = DeepSeekV4Config.__dataclass_fields__
+    hf_config = types.SimpleNamespace(
+        **{name: fields[name].default for name in VISION_FIELDS}
+    )
+    mm = types.SimpleNamespace(
+        allowed_media_domains=None,
+        media_url_max_file_size_mb=common._DEFAULT_MEDIA_URL_MAX_FILE_SIZE_MB,
+        mm_feature_transport="cpu",
+        image_processor_backend="pil",
+        disable_fast_image_processor=True,
+        mm_process_config={},
+        mm_preprocess_cache_size_mb=0,
+        trust_mm_content_hashes=False,
+        mm_io_worker_num=0,
+        mm_processor_worker_num=1,
+    )
+    serving = types.SimpleNamespace(skip_tokenizer_init=False, tokenizer_worker_num=1)
+    patch = pytest.MonkeyPatch()
+    patch.setattr(base_processor, "get_mm", lambda: mm)
+    patch.setattr(base_processor, "get_serving", lambda: serving)
+    patch.setattr(deepseek_v41, "get_mm", lambda: mm)
+    # a process pool needs semaphores some sandboxes refuse; this processor never uses it
+    patch.setattr(
+        base_processor.BaseMultimodalProcessor, "_create_cpu_executor", lambda self: None
+    )
+    processor = deepseek_v41.DeepseekV41ImageProcessor(
+        hf_config, types.SimpleNamespace(base_gpu_id=0, tp_size=1), tokenizer, "default"
+    )
+    return processor, patch.undo
+
+
+@pytest.fixture(scope="module")
+def mm_processor(tokenizer):
+    processor, undo = _build_mm_processor(tokenizer)
+    yield processor
+    undo()
+
+
+def _expand(processor, adapted: GenerateReqInput) -> dict:
+    """What the tokenizer manager makes of a request that carries images: the processor
+    gets ``image_data`` and the ids (``prefer_tokenized_input``) and returns the expanded
+    ids with one item per image (``tokenizer_manager._tokenize_one_request``). The expanded
+    ids are the ``prompt_token_ids`` the canary header returns."""
+    out = asyncio.run(
+        processor.process_mm_data_async(
+            image_data=adapted.image_data,
+            audio_data=adapted.audio_data,
+            input_text=adapted.input_ids,
+            request_obj=adapted,
+            max_req_input_len=10**9,
+        )
+    )
+    return {
+        "prompt_token_ids": list(out.input_ids),
+        "offsets": [list(o) for item in out.mm_items for o in item.offsets],
+        "vit_grid": [
+            [item.model_specific_data["n_vit_h"], item.model_specific_data["n_vit_w"]]
+            for item in out.mm_items
+        ],
+        "feature_shapes": [list(item.feature.shape) for item in out.mm_items],
+    }
+
+
+def _planned_tokens(width: int, height: int) -> int:
+    """The engine's token count for an image of this stored size, from its planner."""
+    from sglang.srt.configs.deepseek_v4 import DeepSeekV4Config
+    from sglang.srt.multimodal.deepseek_v41_image_processing import (
+        num_image_tokens,
+        plan_image_grid,
+    )
+
+    fields = DeepSeekV4Config.__dataclass_fields__
+    vision = types.SimpleNamespace(
+        **{name: fields[name].default for name in VISION_FIELDS}
+    )
+    n_llm_h, n_llm_w, _, _ = plan_image_grid(width, height, vision)
+    return num_image_tokens(n_llm_h, n_llm_w)
+
+
+def _ids_image_body(record: dict, messages=None) -> dict:
+    body = record["egress"]
+    return body if messages is None else dict(body, messages=messages)
+
+
+def test_the_image_fixture_is_the_engines_recording_of_the_image_bodies():
+    meta, records = _image_fixture()
+    assert meta["tokenizer_sha256"] == VOCABULARY_SHA256
+    assert meta["fork_base_commit"]
+    assert meta["records"] == len(records)
+    assert len({r["id"] for r in records}) == len(records)
+    assert {"user-image", "tool-result-image", "over-gate"} <= {r["id"] for r in records}
+    for record in records:
+        urls = _urls_in_message_order(record["egress"]["messages"])
+        ids, expanded = _ids_of(record, "ids"), _ids_of(record, "prompt_token_ids")
+        count = len(urls)
+        assert count == len(record["images"]) == len(record["offsets"]) >= 1, record["id"]
+        assert ids.count(IMAGE_TOKEN_ID) == count, record["id"]
+        assert len(set(urls)) == count, record["id"]
+        assert "input_ids" not in record["egress"]
+        order = _render_order_of(record["egress"]["messages"])
+        # the record's images are in placeholder order: image k is the k-th image of the render
+        for url, image in zip([urls[i] for i in order], record["images"]):
+            raw = base64.b64decode(url.partition(",")[2])
+            assert hashlib.sha256(raw).hexdigest() == image["bytes_sha256"]
+            assert _planned_tokens(image["width"], image["height"]) == image["tokens"]
+        # the expansion: each placeholder becomes its run, at the recorded offsets
+        tokens = [end - start + 1 for start, end in record["offsets"]]
+        assert tokens == [image["tokens"] for image in record["images"]], record["id"]
+        assert len(expanded) == len(ids) + sum(tokens) - count
+        rebuilt, run = [], 0
+        for token in ids:
+            if token == IMAGE_TOKEN_ID:
+                start = len(rebuilt)
+                assert record["offsets"][run] == [start, start + tokens[run] - 1]
+                rebuilt.extend([IMAGE_TOKEN_ID] * tokens[run])
+                run += 1
+            else:
+                rebuilt.append(token)
+        assert rebuilt == expanded, record["id"]
+        assert len(ids) == record["ids_len"] and len(expanded) == record["expanded_len"]
+        assert record["image_only_messages"] == _image_only_messages(
+            record["egress"]["messages"]
+        )
+    over = {r["id"]: r for r in records}["over-gate"]
+    assert over["ids_len"] > EXACT_GATE
+
