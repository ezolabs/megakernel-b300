+import logging
+import sys
+import unittest
+from unittest.mock import patch
+
+from sglang.srt.layers.attention.dsv4 import v41_indexer
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+_LOGGER = v41_indexer.__name__
+
+
+class TestDenseFp4IndexerWarning(CustomTestCase):
+    def setUp(self):
+        v41_indexer._use_deep_gemm_prefill.cache_clear()
+        self.addCleanup(v41_indexer._use_deep_gemm_prefill.cache_clear)
+
+    def _gate(self, sm100, dense):
+        with (
+            patch.object(v41_indexer, "is_sm100_or_newer", lambda: sm100),
+            patch.object(v41_indexer, "has_dense_fp4_indexer", lambda: dense),
+        ):
+            return v41_indexer._use_deep_gemm_prefill()
+
+    def test_sm100_without_dense_fp4_indexer_warns_once(self):
+        with patch.dict(sys.modules, {"deep_gemm": None}):
+            with self.assertLogs(_LOGGER, level=logging.WARNING) as logs:
+                self.assertFalse(self._gate(sm100=True, dense=False))
+                # Cached: a second backend in the same process does not warn again.
+                self.assertFalse(self._gate(sm100=True, dense=False))
+        self.assertEqual(len(logs.records), 1)
+        message = logs.records[0].getMessage()
+        self.assertIn("torch indexer", message)
+        self.assertIn("deep_gemm does not import", message)
+
+    def test_names_a_deep_gemm_without_the_kernel(self):
+        fake = type(sys)("deep_gemm")
+        fake.__version__ = "0.1.0"
+        with patch.dict(sys.modules, {"deep_gemm": fake}):
+            with self.assertLogs(_LOGGER, level=logging.WARNING) as logs:
+                self.assertFalse(self._gate(sm100=True, dense=False))
+        self.assertIn("deep_gemm 0.1.0", logs.records[0].getMessage())
+        self.assertIn("has no fp8_fp4_mqa_logits", logs.records[0].getMessage())
+
+    def test_no_warning_when_deep_gemm_prefill_runs_or_gpu_predates_sm100(self):
+        with self.assertNoLogs(_LOGGER, level=logging.WARNING):
+            self.assertTrue(self._gate(sm100=True, dense=True))
+            v41_indexer._use_deep_gemm_prefill.cache_clear()
+            # Hopper and non-CUDA boxes take the torch indexer by design.
+            self.assertFalse(self._gate(sm100=False, dense=False))
+
+
+if __name__ == "__main__":
+    unittest.main()
