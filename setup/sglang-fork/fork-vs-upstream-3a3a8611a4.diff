+            computed, exact = replay_flags([P0], TAIL, page=page, floors=floors)
+            E = late_exact_from_after_extend(0, P0, floors[0][2], 0, WINDOW)
+            b = page_floor(P0, PAGE)
+            with self.subTest(page=page):
