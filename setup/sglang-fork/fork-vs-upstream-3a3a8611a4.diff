+    )
+    rendered = recipe._encoding.render_conversation(conversation)
+    try:
+        recipe._replace_effort_budget(recipe._encoding.encode(conversation), 50)
+        found = True
+    except ValueError:
+        found = False
+    assert recipe._renders_effort_line(rendered) == found
