+def test_detail_off_matches_0038_on_random_stamp_sets():
+    rng = random.Random(39)
+    stages = list(spt.STAGES[:7]) + ["finished"]  # 0038's eight
+    for _ in range(200):
+        stamps = {}
+        t = rng.uniform(0.0, 1000.0)
+        for stage in stages:
+            if rng.random() < 0.8:
+                t += rng.uniform(0.0, 0.5)
+                stamps[stage] = t
+        prompt = rng.randint(1, 500000)
+        cached = rng.randint(0, prompt)
+        assert spt.format_line("rid", prompt, cached, stamps) == _format_line_0038(
+            "rid", prompt, cached, stamps
+        )
