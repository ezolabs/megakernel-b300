index 0000000000..dc8c9e5e5f
--- /dev/null
+++ b/test/srt/sbr/test_d2_radix_snapshot.py
@@ -0,0 +1,337 @@
+"""#189 (d2): full-placement KV snapshots out of the radix cache.
+
+``KVCacheEventRecorder`` publishes placements incrementally, so a router that
+subscribes after a prefix was cached never learns those pages exist.
+``record_snapshot`` walks the tree and re-announces every resident page inside
+a ``SnapshotBegin`` / ``SnapshotEnd`` batch, and ``RadixCache`` /
+``BasePrefixCache`` expose that walk as ``record_kv_snapshot``.
+
+Pinned here: the batch framing and page count, that a snapshot page carries the
+same hash and parent link the insert path published, that every parent link in
+a batch is announced earlier in the same batch, and that an evicted node and
+its subtree never reappear.
+
+Hashes reach the events through ``get_native_hash``, a compiled extension that
+only loads on little-endian Linux. On a host without it (this suite runs on
+macOS) the fixture below substitutes a pure-Python hasher with the same
+contract -- one SHA256 hex digest per page, chained to the previous digest and
+seeded with the prior one -- so the assertions still bite on the ordering and
+chaining the snapshot has to reproduce. Where the extension does load, the real
+hasher runs and the same assertions hold.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import struct
+from array import array
+from unittest import mock
+
+import pytest
+import torch
+
+from sglang.srt.disaggregation.kv_events import (
+    BlockStored,
+    StorageMedium,
+)
+from sglang.srt.mem_cache.base_prefix_cache import (
+    BasePrefixCache,
+    EvictParams,
+    EvictResult,
+    IncLockRefResult,
+    InsertParams,
+    MatchPrefixParams,
+)
+from sglang.srt.mem_cache.events import (
+    KVCacheEventRecorder,
+    SnapshotBegin,
+    SnapshotEnd,
+)
+from sglang.srt.mem_cache.cpp_utils import native_hash
+from sglang.srt.mem_cache.radix_cache import RadixCache, RadixKey, TreeNode
+from sglang.srt.mem_cache.utils import hash_str_to_int64
+
+PAGE_SIZE = 2
+
+
+class _PurePythonNativeHash:
+    """Stand-in for the compiled hasher: same contract, same chaining."""
+
+    @staticmethod
+    def get_hash(raw, logical_len, unit_width, is_bigram, prior_digest, page_size):
+        page_size = page_size or 1
+        digest = prior_digest
+        digests = []
+        for start in range(0, logical_len, page_size):
+            end = min(start + page_size, logical_len)
+            payload = bytearray()
+            for index in range(start, end):
+                for lane in range(unit_width):
+                    payload += struct.pack("<q", raw[index * unit_width + lane])
+            digest = hashlib.sha256((digest or b"") + bytes(payload)).digest()
+            digests.append(digest.hex())
+        return digests
+
+
+@pytest.fixture(autouse=True)
+def _native_hash_module():
+    """Compiled hasher where it loads, Python double where it cannot."""
+    try:
+        native_hash._load_native_hash_module()
+    except RuntimeError:
+        pass
+    else:
+        yield
+        return
+    with mock.patch.object(
+        native_hash, "_load_native_hash_module", lambda: _PurePythonNativeHash()
+    ):
+        yield
+
+
+def _key(tokens, *, cache_salt=None):
+    return RadixKey(array("q", list(tokens)), cache_salt=cache_salt)
+
+
+def _attach(parent, tokens, *, evicted=False, cache_salt=None):
+    node = TreeNode()
+    node.key = _key(tokens, cache_salt=cache_salt)
+    node.parent = parent
+    node.value = None if evicted else torch.tensor(list(tokens), dtype=torch.int64)
+    parent.children[node.key.child_key(PAGE_SIZE)] = node
+    return node
+
+
+def _empty_root():
+    root = TreeNode()
+    root.key = _key([])
+    root.value = []
+    root.hash_value = []
+    return root
+
+
+def _build_tree():
+    """root -> A(4 tokens) -> B(2), and A -> C(evicted) -> D(2)."""
+    root = _empty_root()
+    a = _attach(root, [1, 2, 3, 4])
+    b = _attach(a, [5, 6])
+    c = _attach(a, [7, 8], evicted=True)
+    d = _attach(c, [9, 10])
+    return root, a, b, c, d
+
+
+def _stores(events):
+    return [event for event in events if isinstance(event, BlockStored)]
+
+
+def _flatten(events, field):
+    return [value for event in _stores(events) for value in getattr(event, field)]
+
+
+def _assert_parent_links_precede_their_pages(events):
+    """Every parent link is a hash announced earlier in the same batch.
+
+    A consumer rebuilding the page map in one pass needs exactly this: it can
+    hold a page's hash before the page that links to it arrives.
+    """
+    announced = set()
+    for event in _stores(events):
+        if event.parent_block_hash is not None:
+            assert event.parent_block_hash in announced
+        announced.update(event.block_hashes)
+
+
+def test_snapshot_frames_resident_pages_and_skips_evicted_subtree():
+    root, a, b, c, d = _build_tree()
+    rec = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+
+    num_blocks = rec.record_snapshot(root)
+    events = rec.take()
+
+    assert num_blocks == 3
+    assert isinstance(events[0], SnapshotBegin)
+    assert events[0].num_blocks == 3
+    assert isinstance(events[-1], SnapshotEnd)
+    assert events[-1].num_blocks == 3
+    assert all(isinstance(event, BlockStored) for event in events[1:-1])
+
+    hashes = _flatten(events, "block_hashes")
+    tokens = _flatten(events, "token_ids")
+    # A's two pages first, then B's page: parent before child.
+    assert tokens == [1, 2, 3, 4, 5, 6]
+    assert len(hashes) == len(set(hashes)) == 3
+    assert all(event.medium == StorageMedium.GPU for event in _stores(events))
+    # C was evicted (value None) and D hangs off it, so neither is resident.
+    assert 7 not in tokens and 8 not in tokens
+    assert 9 not in tokens and 10 not in tokens
+    assert d.value is not None  # D holds a value and is still not announced
+    _assert_parent_links_precede_their_pages(events)
+
+    # take() hands the batch over once.
+    assert rec.take() == []
+    assert a.evicted is False and b.evicted is False and c.evicted is True
+
+
+def test_snapshot_pages_carry_store_hashes_and_parent_links():
+    root, a, b, _c, _d = _build_tree()
+
+    snap = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    assert snap.record_snapshot(root) == 3
+    snap_hashes = _flatten(snap.take(), "block_hashes")
+
+    # Replaying one node through the insert path must produce the same hashes
+    # the snapshot published, or a consumer that indexed a snapshot would key
+    # the cache differently from one that followed the live stream.
+    a_rec = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    a_rec.record_store(a)
+    (a_event,) = a_rec.take()
+    assert a_event.block_hashes == snap_hashes[:2]
+    assert a_event.token_ids == [1, 2, 3, 4]
+    assert a_event.parent_block_hash is None  # A's first page hangs off the root
+
+    b_rec = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    b_rec.record_store(b)
+    (b_event,) = b_rec.take()
+    assert b_event.block_hashes == [snap_hashes[2]]
+    assert b_event.parent_block_hash == snap_hashes[1]
+
+
+def test_snapshot_uses_namespaced_event_hashes_for_salted_pages():
+    root = _empty_root()
+    a = _attach(root, [21, 22], cache_salt="salt-a")
+    b = _attach(a, [23, 24], cache_salt="salt-a")
+
+    rec = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    assert rec.record_snapshot(root) == 2
+    events = rec.take()
+
+    # Salted pages publish the namespace-aware hash, not the plain one, and B
+    # could only resolve its parent link because A was announced first.
+    assert a.event_hash_value is not None and b.event_hash_value is not None
+    assert _flatten(events, "block_hashes") == [
+        hash_str_to_int64(a.event_hash_value[0]),
+        hash_str_to_int64(b.event_hash_value[0]),
+    ]
+    assert _flatten(events, "token_ids") == [21, 22, 23, 24]
+    stores = _stores(events)
+    # A salted page carries its cache_salt on the BlockStored itself (upstream's
+    # flat field), exactly as the live store path emits it on this base.
+    assert stores and all(
+        isinstance(event, BlockStored) and event.cache_salt == "salt-a"
+        for event in stores
+    )
+    live = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    live.record_store(a)
+    live.record_store(b)
+    assert live.take() == stores
+    _assert_parent_links_precede_their_pages(events)
+
+
+def test_snapshot_noops_when_events_are_disabled():
+    root, *_ = _build_tree()
+    rec = KVCacheEventRecorder(enabled=False, page_size=PAGE_SIZE)
+    assert rec.record_snapshot(root) == 0
+    assert rec.take() == []
+
+
+def test_snapshot_of_empty_tree_is_an_empty_batch():
+    root = _empty_root()
+    rec = KVCacheEventRecorder(enabled=True, page_size=PAGE_SIZE)
+    assert rec.record_snapshot(root) == 0
+    events = rec.take()
+    assert [type(event) for event in events] == [SnapshotBegin, SnapshotEnd]
+    assert [event.num_blocks for event in events] == [0, 0]
+    assert _stores(events) == []
+
+
+class _PlainCache(BasePrefixCache):
+    """A cache that keeps no radix tree: the base default has to cover it."""
+
+    def reset(self):
+        raise NotImplementedError("not exercised by this test")
+
+    def match_prefix(self, params: MatchPrefixParams):
+        raise NotImplementedError("not exercised by this test")
+
+    def cache_finished_req(self, req, is_insert=True, **kwargs):
+        raise NotImplementedError("not exercised by this test")
+
+    def cache_unfinished_req(self, req, **kwargs):
+        raise NotImplementedError("not exercised by this test")
+
+    def evict(self, params: EvictParams):
+        return EvictResult()
+
+    def inc_lock_ref(self, node):
+        return IncLockRefResult()
+
+    def dec_lock_ref(self, node, params=None):
+        raise NotImplementedError("not exercised by this test")
+
+    def checkpoint(self, *args, **kwargs):
+        raise NotImplementedError("not exercised by this test")
+
+
+def test_base_cache_reports_zero_and_warns_once(caplog):
+    # The latch is per process, so a test that asserts on the warning arms it.
+    BasePrefixCache._kv_snapshot_unsupported_logged = False
+    cache = _PlainCache()
+
+    with caplog.at_level(
+        logging.WARNING, logger="sglang.srt.mem_cache.base_prefix_cache"
+    ):
+        assert cache.record_kv_snapshot() == 0
+        assert cache.record_kv_snapshot() == 0
+
+    messages = [
+        record.getMessage()
+        for record in caplog.records
+        if record.name == "sglang.srt.mem_cache.base_prefix_cache"
+    ]
+    assert len(messages) == 1
+    assert "does not support KV cache snapshots" in messages[0]
+    assert "_PlainCache" in messages[0]
+
+
+def test_real_radix_cache_snapshot_reproduces_insert_time_hashes():
+    cache = RadixCache.create_simulated(
+        page_size=PAGE_SIZE, enable_kv_cache_events=True
+    )
+    cache.take_events()  # construction announces AllBlocksCleared
+
+    cache.insert(InsertParams(key=RadixKey(array("q", [11, 12, 13, 14]))))
+    live = cache.take_events()
+    cache.insert(InsertParams(key=RadixKey(array("q", [11, 12, 15, 16]))))
+    live += cache.take_events()
+
+    live_hashes = [h for event in live for h in event.block_hashes]
+    live_tokens = [t for event in live for t in event.token_ids]
+    assert live_tokens == [11, 12, 13, 14, 15, 16]
+    assert len(live_hashes) == 3
+
+    # The second insert split [11,12,13,14] into [11,12] + [13,14], and the
+    # live stream announced [15,16] but never [11,12] on its own. The snapshot
+    # announces all three resident pages, and re-derives the same hashes.
+    assert cache.record_kv_snapshot() == 3
+    snapshot = cache.take_events()
+
+    assert isinstance(snapshot[0], SnapshotBegin)
+    assert snapshot[0].num_blocks == 3
+    assert isinstance(snapshot[-1], SnapshotEnd)
+    assert snapshot[-1].num_blocks == 3
+    assert _flatten(snapshot, "block_hashes") == live_hashes
+    assert _flatten(snapshot, "token_ids") == live_tokens
+    _assert_parent_links_precede_their_pages(snapshot)
+
+
+def test_real_radix_cache_snapshot_of_empty_cache_emits_no_pages():
+    cache = RadixCache.create_simulated(
+        page_size=PAGE_SIZE, enable_kv_cache_events=True
+    )
+    cache.take_events()  # construction announces AllBlocksCleared
+
+    assert cache.record_kv_snapshot() == 0
+    events = cache.take_events()
+    assert [type(event) for event in events] == [SnapshotBegin, SnapshotEnd]
+    assert events[0].num_blocks == 0
diff --git a/test/srt/sbr/test_d3_scheduler_snapshot_wiring.py b/test/srt/sbr/test_d3_scheduler_snapshot_wiring.py
