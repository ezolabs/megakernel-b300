+class FixtureRepo(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+        (self.root / ".github" / "workflows").mkdir(parents=True)
+
+    def tearDown(self) -> None:
+        self._tmp.cleanup()
+
+    def write(self, rel: str, text: str) -> None:
+        path = self.root / rel
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(textwrap.dedent(text).lstrip("\n"), encoding="utf-8")
+
+    def workflow(self, name: str, text: str) -> None:
+        self.write(f".github/workflows/{name}", text)
+
+    def read(self, rel: str) -> str:
+        return (self.root / rel).read_text(encoding="utf-8")
+
+    def wf(self, name: str) -> str:
+        return self.read(f".github/workflows/{name}")
+
+    def main(self, *args: str) -> tuple[int, str]:
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            code = shr.main([*args, "--root", str(self.root)])
+        return code, out.getvalue()
+
+    def apply(self) -> str:
+        code, out = self.main("--apply")
+        self.assertEqual(code, 0, out)
+        return out
+
+    def assert_converges(self, expected: dict[str, str]) -> None:
+        """--apply yields `expected` (workflow name -> text); a second --apply and --check are no-ops."""
+        self.apply()
+        for name, text in expected.items():
+            self.assertEqual(self.wf(name), textwrap.dedent(text).lstrip("\n"), name)
+        first = {p: p.read_bytes() for p in (self.root / ".github").rglob("*.yml")}
+        out = self.apply()
+        self.assertIn("0 schedule triggers removed, 0 workflow_dispatch added, 0 files changed", out)
+        self.assertEqual({p: p.read_bytes() for p in (self.root / ".github").rglob("*.yml")}, first)
+        code, out = self.main("--check")
+        self.assertEqual(code, 0, out)
+
+
