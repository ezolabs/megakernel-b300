+import unittest
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+from sglang.kernels.ops.attention.dsv4.attn_metadata_kernels import (
+    late_layer_tail_layout,
+)
+from sglang.srt.layers.attention.deepseek_v4_backend import late_layer_num_tokens
+from sglang.srt.layers.attention.dsv4.exact_decoder_trim import (
+    SKIP_TAIL,
+    far_skip,
+    late_extend_floor,
+    late_tail_floors,
+    late_trim_tail_len,
+    page_floor,
+    tail_floor,
+)
+from sglang.srt.mem_cache.unified_radix_cache import (
+    ExactTrimStats,
+    UnifiedRadixCache,
+)
+from sglang.srt.model_executor.forward_batch_info import (
+    CaptureHiddenMode,
+    ForwardMode,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+WINDOW = 128
+NUM_LAYERS = 40
+LATE_START = 20  # max(kv_source_layer_ids) of DeepSeek-V4.1-Flash-1017
+PAGE = 256
+TAIL = late_trim_tail_len(WINDOW, PAGE)  # 2560
+LATE = range(LATE_START, NUM_LAYERS)
+KV_LAYERS = range(LATE_START, NUM_LAYERS - 1)  # outputs that feed late KV
+DSPARK_CAPTURE = (37, 38, 39)  # inputs of these layers
+CPU = torch.device("cpu")
+
+
+def _tree():
+    return SimpleNamespace(
+        exact_trim_window=WINDOW,
+        page_size=PAGE,
+        exact_trim_tail_len=TAIL,
+        exact_trim_stats=ExactTrimStats(),
+    )
+
+
+class Request:
+    """One request's chunked prefill, replayed row by row.
+
+    A hit reuses [0, m): ``late="exact"`` caches exact late rows (G = 0),
+    ``late="floor"`` caches inexact ones (G = m, a late-floor hit). Prompt
+    logprobs from ``logprob_start`` make every extend past it whole.
+    """
+
+    def __init__(self, prompt_len, *, hit=0, late="exact", logprob_start=None):
+        self.P = prompt_len
+        self.tree = _tree()
+        self.computed = {l: np.zeros(prompt_len, bool) for l in LATE}
+        self.exact = {l: np.zeros(prompt_len, bool) for l in LATE}
+        self.logprob_start = logprob_start
+        self.req = SimpleNamespace(late_exact_from=None, late_floor_g=0)
+        if hit and late == "exact":
+            for l in LATE:
+                self.computed[l][:hit] = True
+                self.exact[l][:hit] = True
+            self.req.late_exact_from = 0
+        elif hit:
+            self.req.late_floor_g = hit
+        self.start = hit
+        self.late_rows = 0
+        self.claims = []
+
+    @property
+    def target(self):
+        """P as ScheduleBatch.prepare_for_extend plumbs it."""
+        if self.logprob_start is None:
+            return self.P
+        return min(self.P, self.logprob_start)
+
+    def extend(self, end):
+        start, n = self.start, end - self.start
+        whole = self.logprob_start is not None and self.logprob_start < end
+        g = self.req.late_floor_g
+        floors = late_tail_floors(
+            [end],
+            prompt_lens=[self.target],
+            late_floor_gs=[g],
+            whole_extend=[whole],
+            page=PAGE,
+            tail_len=TAIL,
+        )
+        idx, tails, row_floor = late_layer_tail_layout(
+            extend_lens_cpu=[n],
+            seq_lens_cpu=[end],
+            tail_len=TAIL,
+            device=CPU,
+            whole_extend=[whole],
+            tail_page=PAGE,
+            floors_cpu=floors,
+        )
+        rows = start + idx.numpy()
+        row_floor = row_floor.numpy()
+        self.late_rows += tails[0]
+        for l in LATE:
+            self.computed[l][rows] = True
+        cut = np.maximum(rows - WINDOW + 1, 0)
+        for l in LATE:
+            bad = ~self.computed[l]
+            if l > LATE_START:
+                bad = bad | ~self.exact[l - 1]
+            prefix_bad = np.concatenate([[0], np.cumsum(bad)])
+            self.exact[l][rows] = (cut >= row_floor) & (
+                prefix_bad[rows + 1] == prefix_bad[cut]
+            )
+        prev_g = g
+        e = UnifiedRadixCache.exact_trim_after_extend(
+            self.tree,
+            self.req,
+            start,
+            end,
+            whole_extend=whole,
+            prompt_len=self.target,
+        )
+        self.req.late_exact_from = e
+        self.claims.append((end, e))
+        skipped = far_skip(
+            end, self.target, whole_extend=whole, page=PAGE, tail_len=TAIL
+        )
+        self.start = end
+        return skipped, tails[0], prev_g
+
+    def claim_holds(self, end, e):
+        """Rows [E, end) of every late layer feeding KV are exact."""
+        return all(self.exact[l][e:end].all() for l in KV_LAYERS)
+
+    def final_window_exact(self):
+        rows = slice(self.P - WINDOW, self.P)
+        return all(self.exact[l][rows].all() for l in KV_LAYERS)
+
+    def logits_exact(self):
+        return bool(self.exact[NUM_LAYERS - 1][self.P - 1])
+
+    def dspark_trailing(self):
+        """Exact trailing rows of each DSpark capture (the input of layer i)."""
+        out = []
+        for i in DSPARK_CAPTURE:
+            ok = self.exact[i - 1]
+            k = 0
+            while k < self.P and ok[self.P - 1 - k]:
+                k += 1
+            out.append(k)
+        return out
+
+
+def _random_chunks(rng, start, total):
+    ends, pos = [], start
+    while pos < total:
+        pos = min(total, pos + rng.choice([1, 7, 128, 500, 1024, 2048, 4096, 5000]))
+        ends.append(pos)
+    return ends
+
+
+def _fixed_chunks(start, total, chunk):
+    return list(range(start + chunk, total, chunk)) + [total]
+
+
+def row_layer_saving(prompt_len, chunk=4096):
+    """Row-layer saving of a cold fill against full prefill."""
+    r = Request(prompt_len)
+    for end in _fixed_chunks(0, prompt_len, chunk):
+        r.extend(end)
+    full = prompt_len * NUM_LAYERS
+    trimmed = prompt_len * LATE_START + r.late_rows * len(LATE)
+    return 1 - trimmed / full, r
+
+
+class TestFarSkipRule(unittest.TestCase):
+    def test_rule_boundary(self):
+        P = 60000
+        bound = page_floor(P, PAGE) - TAIL
+        self.assertTrue(
+            far_skip(bound, P, whole_extend=False, page=PAGE, tail_len=TAIL)
+        )
+        self.assertFalse(
+            far_skip(bound + 1, P, whole_extend=False, page=PAGE, tail_len=TAIL)
+        )
+        self.assertFalse(
+            far_skip(bound, P, whole_extend=True, page=PAGE, tail_len=TAIL)
+        )
+        self.assertFalse(
+            far_skip(bound, None, whole_extend=False, page=PAGE, tail_len=TAIL)
+        )
+        # A prompt shorter than R + one page never skips.
+        self.assertFalse(
+            far_skip(1, TAIL + 255, whole_extend=False, page=PAGE, tail_len=TAIL)
+        )
+
+    def test_skip_floor_is_skip_tail_rows(self):
+        self.assertEqual(SKIP_TAIL, WINDOW)
+        f = late_extend_floor(
+            4096,
+            8192,
+            whole_extend=False,
+            late_floor_g=4096,
+            page=PAGE,
+            tail_len=TAIL,
+            prompt_len=60000,
+        )
+        self.assertEqual(f, 8192 - SKIP_TAIL)
+        # Not far: the page-anchored floor raised to G.
+        f = late_extend_floor(
+            50000,
+            58000,
+            whole_extend=False,
+            late_floor_g=56000,
+            page=PAGE,
+            tail_len=TAIL,
+            prompt_len=60000,
+        )
+        self.assertEqual(f, 56000)
+        self.assertEqual(
+            late_extend_floor(
+                50000,
+                58000,
+                whole_extend=False,
+                late_floor_g=0,
+                page=PAGE,
+                tail_len=TAIL,
+                prompt_len=60000,
+            ),
+            tail_floor(58000, PAGE, TAIL),
+        )
+
+    def test_short_skipped_extend_clamps_at_zero(self):
+        (f,) = late_tail_floors(
+            [100],
+            prompt_lens=[60000],
+            late_floor_gs=[0],
+            whole_extend=None,
+            page=PAGE,
+            tail_len=TAIL,
+        )
+        self.assertEqual(f, 0)
+
+    def test_rows_past_the_plumbed_lists_never_skip(self):
+        floors = late_tail_floors(
+            [4096, 9000],
+            prompt_lens=[60000],
+            late_floor_gs=[0],
+            whole_extend=None,
+            page=PAGE,
+            tail_len=TAIL,
+        )
+        self.assertEqual(floors, [4096 - SKIP_TAIL, tail_floor(9000, PAGE, TAIL)])
+        self.assertEqual(
+            late_tail_floors(
+                [4096],
+                prompt_lens=None,
+                late_floor_gs=None,
+                whole_extend=None,
+                page=PAGE,
+                tail_len=TAIL,
+            ),
+            [tail_floor(4096, PAGE, TAIL)],
+        )
+
+
+class TestFarSkipReplay(unittest.TestCase):
+    def _check(self, r, ends):
+        skips = 0
+        for end in ends:
+            start = r.start
+            skipped, tail, prev_g = r.extend(end)
+            if skipped:
+                skips += 1
+                self.assertEqual(tail, min(end - start, SKIP_TAIL))
+                self.assertEqual(r.req.late_floor_g, end)
+            else:
+                self.assertEqual(r.req.late_floor_g, prev_g)
+        for end, e in r.claims:
+            self.assertTrue(r.claim_holds(end, e), (end, e))
+        self.assertTrue(r.final_window_exact())
+        self.assertTrue(r.logits_exact())
+        self.assertTrue(all(k >= WINDOW for k in r.dspark_trailing()))
+        return skips
+
+    def test_random_chunkings_cold_and_hit(self):
+        rng = random.Random(0)
+        skips = trials = 0
+        for trial in range(300):
+            P = rng.choice([3000, 6000, 9000, 20000, 40000]) + rng.randrange(256)
+            kind = ("cold", "exact", "floor")[trial % 3]
+            if kind == "cold":
+                hit = 0
+            elif kind == "exact":
+                hit = rng.randrange(1, P)
+            else:
+                cap = page_floor(P, PAGE) - TAIL
+                if cap <= 0:
+                    continue
+                hit = rng.randrange(1, cap + 1)
+            r = Request(P, hit=hit, late="floor" if kind == "floor" else "exact")
+            ends = _random_chunks(rng, hit, P)
+            skips += self._check(r, ends)
+            trials += 1
+        self.assertGreater(trials, 250)
+        self.assertGreater(skips, 300)
+
+    def test_prompt_logprob_rows_stay_exact(self):
+        rng = random.Random(1)
+        for _ in range(40):
+            P = 20000 + rng.randrange(256)
+            L = rng.randrange(0, P)
+            r = Request(P, logprob_start=L)
+            self._check(r, _random_chunks(rng, 0, P))
+            self.assertTrue(r.exact[NUM_LAYERS - 1][L:P].all(), L)
+
+
+class TestRowLayerSaving(unittest.TestCase):
+    def test_60k_cold_fill_saves_about_46_percent(self):
+        saving, r = row_layer_saving(60000)
+        self.assertTrue(r.final_window_exact() and r.logits_exact())
+        self.assertAlmostEqual(saving, 0.46, delta=0.01)
+        stats = r.tree.exact_trim_stats
+        # Chunks ending at or below page_floor(60000) - 2560 = 57344.
+        self.assertEqual(stats.far_skipped_chunks, 57344 // 4096)
+
+    def test_table(self):
+        # Rederived from #88 (one-row skipped tails, seq-anchored floors:
+        # 8k 34.4%, 16k 42.2%, 32k 46.1%) with SKIP_TAIL-row tails and
+        # page-anchored floors.
+        got = {P: round(row_layer_saving(P)[0], 3) for P in (8192, 16384, 32768)}
+        self.assertEqual(got, EXPECTED_TABLE)
+
+
+EXPECTED_TABLE = {8192: 0.336, 16384: 0.41, 32768: 0.447}
