+            chat.handle_request(_request(f"rid-{n}", f"<<hold:{n}>>"), _raw_request())
+        )
+        for n in ("a", "b")
+    ]
+    await asyncio.sleep(0.2)
+    in_flight = record.in_flight
+    for name in ("a", "b"):
