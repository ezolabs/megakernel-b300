+    def test_no_fragment_restates_the_arguments_sent_so_far(self):
+        """The router reads a fragment that starts with all the argument text
+        sent before it as a cumulative restatement and keeps only its suffix.
+        Pinned shapes that would hand it one: a non-string parameter whose
+        object value opens with the parameter's own name (#2536 C2), first or
+        not; the same in a JSON body; and string values ending in `{` under
+        keys spelled `, ` and `: `. The header still goes out with the first
+        parameter tag; a non-string key goes out with its value."""
+        for detector_cls in DETECTORS:
+            d = detector_cls()
+            head = f'{d.bot_token}\n{d.invoke_start_token} name="write_file">\n'
+            tail = f"\n{d.invoke_end_token}\n{d.eot_token}"
+
+            def split_parameter(name, flag, value):
+                """A parameter as two deltas: its opening tag, then the rest."""
+                whole = _parameter(detector_cls, name, flag, value)
+                at = whole.index(">") + 1
+                return whole[:at], whole[at:]
+
+            c2_open, c2_rest = split_parameter("a", "false", '{"a": "y"}')
+            meta_open, meta_rest = split_parameter(
+                "meta", "false", '{"path": "a.py", "meta": 1}'
+            )
+            comma_open, comma_rest = split_parameter(", ", "true", "{")
+            json_body = f'{d.invoke_start_token} name="lookup">\n'
+            cases = {
+                # The key alone at the tag open, then `{"a": {"a": "y"}` at
+                # its close: the router's client got `{"a": "y"}}`.
+                "first parameter (C2)": (
+                    [head + c2_open, c2_rest, tail],
+                    ["", '{"a": {"a": "y"}', "}"],
+                ),
+                "later parameter": (
+                    [
+                        head + _parameter(detector_cls, "path", "true", "a.py"),
+                        meta_open,
+                        meta_rest,
+                        tail,
+                    ],
+                    [
+                        "",
+                        '{"path": "a.py"',
+                        ', "meta": {"path": "a.py", "meta": 1}',
+                        "}",
+                    ],
+                ),
+                # A JSON body re-serialised: `{"a": ` then a step holding the
+                # whole inner object; split after its first character.
+                "JSON body": (
+                    [
+                        f"{d.bot_token}\n{json_body}" + '{"a": ',
+                        '{"a": 1}, "b": 2}',
+                        tail,
+                    ],
+                    ["", '{"a": ', "{", '"a": 1}, "b": 2', "}"],
+                ),
+                "string value ending in a brace": (
+                    [
+                        head + comma_open,
+                        comma_rest + _parameter(detector_cls, ": ", "true", "z"),
+                        tail,
+                    ],
+                    ["", '{", ": "', "{", '", ": ": "z"', "}"],
+                ),
+            }
+            for label, (deltas, fragments) in cases.items():
+                with self.subTest(detector=detector_cls.__name__, case=label):
+                    text = "".join(deltas)
+                    one_shot = detector_cls().detect_and_parse(text, self.tools)
+                    detector, items = detector_cls(), []
+                    for delta in deltas:
+                        items.extend(
+                            (0, call)
+                            for call in detector.parse_streaming_increment(
+                                delta, self.tools
+                            ).calls
+                        )
+                    # The header goes out with the first parameter tag (or
+                    # the JSON body's first key), whatever its type.
+                    first = detector_cls().parse_streaming_increment(
+                        deltas[0], self.tools
+                    )
+                    self.assertTrue(first.calls[0].name)
+                    self.assertEqual(first.calls[0].parameters, "")
+                    self.assertEqual(_fragments(items), fragments)
+                    self.assertEqual(
+                        _assemble(items),
+                        [(c.name, c.parameters) for c in one_shot.calls],
+                    )
+        self.assertEqual(deepseekv32_detector.broken_call_count(), 0)
