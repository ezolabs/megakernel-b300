+def _posted_on_the_messages_path(body: dict) -> bool:
+    """The router's rule for a body it never posts as ``input_ids``.
+
+    the serving router (at ``FIXTURE_ROUTER_SHA``) ``crates/sbr-server/src/pipeline/render.rs``
+    ``prefills_tool_calls``: the encoder revision is ``recipe_parity``, ``tool_choice`` is
+    forced ("required" or a named function, ``forced_chat_call``), the request declares
+    tools, the render is in chat mode, and the last message is not the assistant's. Its
+    ids then end with the calls block's opener, which the engine renders, and has its
+    tool parser and grammar start inside, only on the messages path (``serving_chat.py``
+    ``_dsv41_tool_calls_prefill`` excludes a body that brings ``input_ids``), so
+    ``crates/sbr-server/src/pipeline/flight.rs`` ``ids_send_or_messages`` takes such a
+    request's ``IdsDecision::Send`` back to ``IdsDecision::Messages``. Its ids-path
+    request is therefore never served, and its ``structural_tag`` is no parity claim.
+    """
+    choice = body.get("tool_choice")
+    messages = body["messages"]
+    return (
+        META["encoder_revision"] == FIXTURE_ENCODER_REVISION
+        and (choice == "required" or isinstance(choice, dict))
+        and (bool(body.get("tools")) or any(m.get("tools") for m in messages))
+        and (body.get("chat_template_kwargs") or {}).get("thinking") is not True
+        and messages[-1]["role"] != "assistant"
+    )
+
+
+def _claimed(differences: dict, record, key="sampling_params.structural_tag") -> dict:
+    """``differences`` less what is no parity claim for ``record``: the ids-path tool-call
+    constraint (``key``) of a body the router posts on the messages path only."""
+    if not _posted_on_the_messages_path(record["egress"]):
+        return differences
+    return {k: v for k, v in differences.items() if k != key}
