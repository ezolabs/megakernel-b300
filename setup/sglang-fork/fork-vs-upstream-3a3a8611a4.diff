--- /dev/null
+++ b/test/srt/sbr/test_r_replay_wire_frames.py
@@ -0,0 +1,191 @@
+"""(r): every replay reply is the three frames the serving router decodes.
+
+the serving router reads a replay answer with the same decoder as the live KV and
+load feeds -- ``the serving router``
+``crates/sbr-index/src/events.rs`` ``decode_frame`` -- which refuses any
+message that is not exactly three frames, a sequence frame that is not 8
+bytes, or a first frame that is not UTF-8. On the replay socket the first frame
+is the ROUTER's empty delimiter, so a reply is ``[b"", seq, payload]`` and the
+terminator ``[b"", END_SEQ, b""]``. The router counts a refused frame as a
+``FrameFailures`` loss and keeps reading, so a reply in any other shape never
+reaches it and every replay round ends in a timeout.
+
+Upstream #43386 (53295c6972, "fix missing topics in replayed kv events") put
+the publisher's topic into the replay reply, making it four frames:
+``[b"", topic, seq, payload]`` and ``[b"", b"", END_SEQ, b""]``. That fixes
+nothing the router needs -- the replay socket is per DP rank, the router
+already knows which rank it dialed, and it checks the topic on the live SUB
+feed only -- so this fork keeps the three-frame wire, the one the ``SNAPSHOT_SEQ``
+sentinel has always used too. With a box-c and a box-d behind one router during a
+blue/green, both engines must answer in the one shape the router decodes.
+
+Pinned here, against a publisher with a non-empty topic (the case #43386
+changed): a replayed batch is exactly ``[b"", seq, payload]`` with the batch's
+own bytes, a caught-up request is ``END_SEQ`` alone in three frames, and both
+snapshot answers -- an explicit negative ``start_seq`` and a request older
+than the buffer -- are ``[b"", SNAPSHOT_SEQ, b""]`` then
+``[b"", END_SEQ, b""]``. Every reply also passes ``_router_decode``, a line
+for line copy of the router's ``decode_frame`` checks.
+
+The sockets are real ZeroMQ over ``inproc://`` on ``zmq.Context.instance()``,
+the DEALER connected before the publisher binds, and every poll has a timeout.
+"""
+
+from __future__ import annotations
+
+import itertools
+import time
+
+import msgspec
+import pytest
+import zmq
+
+from sglang.srt.disaggregation.kv_events import (
+    AllBlocksCleared,
+    KVEventBatch,
+    ZmqEventPublisher,
+)
+
+POLL_TIMEOUT_MS = 10_000
+TOPIC = "kv@decode@replay-wire"
+END_SEQ = ZmqEventPublisher.END_SEQ
+SNAPSHOT_SEQ = ZmqEventPublisher.SNAPSHOT_SEQ
+_endpoint_counter = itertools.count()
+
+
+def _router_decode(frames: list) -> tuple:
+    """the serving router's ``decode_frame``: ``(topic, seq, payload)`` or raise."""
+    if len(frames) != 3:
+        raise ValueError(f"FrameCount: got {len(frames)}")
+    topic, seq, payload = frames
+    if len(seq) != 8:
+        raise ValueError(f"SequenceLen: got {len(seq)}")
+    return topic.decode("utf-8"), int.from_bytes(seq, "big", signed=True), payload
+
+
+class _Replay:
+    """A started publisher with a topic, its SUB and a replay DEALER."""
+
+    def __init__(self, **config):
+        base = f"r-replay-wire-{next(_endpoint_counter)}"
+        self.pub_endpoint = f"inproc://{base}-pub"
+        replay_endpoint = f"inproc://{base}-replay"
+        ctx = zmq.Context.instance()
+        self.sub = ctx.socket(zmq.SUB)
+        self.sub.setsockopt(zmq.SUBSCRIBE, b"")
+        self.sub.connect(self.pub_endpoint)
+        self.dealer = ctx.socket(zmq.DEALER)
+        self.dealer.connect(replay_endpoint)
+        self.publisher = ZmqEventPublisher(
+            attn_dp_rank=0,
+            endpoint=self.pub_endpoint,
+            replay_endpoint=replay_endpoint,
+            topic=TOPIC,
+            **config,
+        )
+
+    def publish(self, count: int) -> list:
+        """Publish ``count`` batches; return the live ``(seq, payload)`` pairs.
+
+        Reading each one back off the SUB proves the publisher thread sent it,
+        so the replay buffer holds it before any request is issued.
+        """
+        received = []
+        for _ in range(count):
+            ts = time.time()
+            self.publisher.publish(KVEventBatch(ts=ts, events=[AllBlocksCleared()]))
+            deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+            while True:
+                assert time.monotonic() < deadline, f"batch {ts} never published"
+                if not self.sub.poll(200):
+                    continue
+                topic, seq, payload = self.sub.recv_multipart()
+                if msgspec.msgpack.decode(payload, type=KVEventBatch).ts == ts:
+                    # The live feed keeps its topic frame; only replay is bare.
+                    assert topic == TOPIC.encode()
+                    received.append((int.from_bytes(seq, "big", signed=True), payload))
+                    break
+        return received
+
+    def raw_answer(self, start_seq: int) -> list:
+        """Send one replay request; return each reply's raw frames to END_SEQ."""
+        self.dealer.send_multipart([b"", start_seq.to_bytes(8, "big", signed=True)])
+        replies: list = []
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while time.monotonic() < deadline:
+            if not self.dealer.poll(200):
+                continue
+            frames = self.dealer.recv_multipart()
+            replies.append(frames)
+            if END_SEQ in frames:
+                return replies
+        raise AssertionError(f"no END_SEQ within {POLL_TIMEOUT_MS} ms: {replies!r}")
+
+    def close(self) -> None:
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while time.monotonic() < deadline and not self.publisher._event_queue.empty():
+            time.sleep(0.01)
+        try:
+            self.publisher.shutdown()
+        finally:
+            self.sub.close(linger=0)
+            self.dealer.close(linger=0)
+
+
+@pytest.fixture
+def replay():
+    started: list = []
+
+    def start(**config) -> _Replay:
+        handle = _Replay(**config)
+        started.append(handle)
+        return handle
+
+    yield start
+    for handle in started:
+        handle.close()
+
+
+def _assert_router_reads(replies: list) -> list:
+    """Every reply decodes as the router decodes it, with the empty delimiter."""
+    decoded = [_router_decode(frames) for frames in replies]
+    assert [topic for topic, _, _ in decoded] == [""] * len(decoded)
+    return [(seq, payload) for _, seq, payload in decoded]
+
+
+def test_replayed_batches_are_three_frames_without_the_topic(replay):
+    handle = replay(buffer_steps=10)
+    published = handle.publish(3)
+
+    replies = handle.raw_answer(1)
+
+    assert replies == [
+        [b"", (1).to_bytes(8, "big"), published[1][1]],
+        [b"", (2).to_bytes(8, "big"), published[2][1]],
+        [b"", END_SEQ, b""],
+    ]
+    assert _assert_router_reads(replies) == published[1:] + [(-1, b"")]
+
+
+def test_caught_up_replay_is_end_seq_alone_in_three_frames(replay):
+    handle = replay(buffer_steps=10)
+    handle.publish(2)
+
+    replies = handle.raw_answer(2)
+
+    assert replies == [[b"", END_SEQ, b""]]
+    assert _assert_router_reads(replies) == [(-1, b"")]
+
+
+@pytest.mark.parametrize("start_seq", [-2, 0])
+def test_snapshot_sentinel_is_three_frames(replay, start_seq):
+    # -2 asks for a snapshot outright; 0 is older than a 2-deep buffer after
+    # five batches. Both get the same two-reply answer.
+    handle = replay(buffer_steps=2)
+    handle.publish(5)
+
+    replies = handle.raw_answer(start_seq)
+
+    assert replies == [[b"", SNAPSHOT_SEQ, b""], [b"", END_SEQ, b""]]
+    assert _assert_router_reads(replies) == [(-2, b""), (-1, b"")]
+    assert handle.publisher.take_snapshot_request() is True
diff --git a/test/srt/sbr/test_s_snapshot_host_tier.py b/test/srt/sbr/test_s_snapshot_host_tier.py
new file mode 100644
index 0000000000..a7ea1a3735
--- /dev/null
+++ b/test/srt/sbr/test_s_snapshot_host_tier.py
@@ -0,0 +1,320 @@
+"""s - the KV snapshot announces the HiCache host tier as well as the device.
+
+``KVCacheEventRecorder.record_snapshot`` used to walk the device tier only: it
+skipped every ``node.evicted`` node (and its subtree) and tagged every page it
+did announce ``GPU``. On a HiCache engine the nodes the device evicted are
+exactly the ones only the host tier still holds, and a router adopts a complete
+snapshot as a new epoch built from an empty tree -- so every adopted snapshot
+erased all host-only credit the live feed had built (``CPU_PINNED`` stores at
+the write-through ack), and the router priced host-tier resumes as misses.
+
+The snapshot now runs a device pass (unchanged) and then a host pass that
+announces every node whose host copy the live path has announced (``backuped``
+and no write-through still pending) as ``CPU_PINNED``, descending through
+device-evicted nodes. The proof is against the live path: replaying the live
+events into a ``{hash: tiers}`` map and replaying the snapshot into another
+gives the same map, page for page, and ``num_blocks`` equals what a consumer
+counts from the window's ``BlockStored`` events.
+
+The tree is the unified tree box-c builds (``UnifiedRadixCache``, Full + SWA,
+Python TreeCore), driven through the TreeCore's own HiCache entry points:
+``mark_write_through_pending`` / ``finish_write_through`` (the ack that
+announces the host copy), ``evict_device_leaf`` (the device eviction step,
+which demotes a backed-up leaf and deletes an unbacked one) and
+``drive_host_eviction``. The host pool itself needs CUDA pinned memory, so the
+host slots are plain CPU index tensors the test hands over and takes back; the
+tree logic and every event come from the real code.
+"""
+
+from __future__ import annotations
+
+from array import array
+
+import torch
+
+from sglang.srt.disaggregation.kv_events import (
+    BlockRemoved,
+    BlockStored,
+    StorageMedium,
+)
+from sglang.srt.mem_cache.base_prefix_cache import InsertParams
+from sglang.srt.mem_cache.events import (
+    KVCacheEventRecorder,
+    SnapshotBegin,
+    SnapshotEnd,
+)
+from sglang.srt.mem_cache.radix_cache import RadixKey, TreeNode
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+
+# The unified fixture (box-c's shape) and the hasher double are test_i's; this
+# part adds no second copy of either.
+from test_i_unified_radix_snapshot import (  # noqa: F401  (autouse fixture)
+    _build_cache,
+    _native_hash_module,
+    _pages,
+)
+
+GPU = StorageMedium.GPU
+CPU = StorageMedium.CPU
+
+_ack_ids = iter(range(1000, 10**6))
+
+
+def _insert(cache, allocator, tokens, *, cache_salt=None):
+    key = RadixKey(array("q", tokens), cache_salt=cache_salt)
+    value = allocator.alloc(len(tokens))
+    assert value is not None
+    cache.insert(InsertParams(key=key, value=value[: len(tokens)]))
+
+
+def _node(cache, tokens):
+    """The node whose path from the root spells exactly ``tokens``."""
+    node = cache.tree_core.root_node
+    rest = list(tokens)
+    while rest:
+        child = next(
+            c
+            for c in node.children.values()
+            if list(c.key.token_ids) == rest[: len(c.key)]
+        )
+        node, rest = child, rest[len(child.key) :]
+    return node
+
+
+def _start_backup(cache, *nodes):
+    """D->H write-through issued: host slots assigned, DMA not yet acked."""
+    core = cache.tree_core
+    ack_id = next(_ack_ids)
+    order = core.mark_write_through_pending([n.id for n in nodes], ack_id)
+    for node in nodes:
+        node.component_data[ComponentType.FULL].host_value = torch.arange(
+            len(node.key), dtype=torch.int64
+        )
+    return order, ack_id
+
+
+def _backup(cache, *nodes):
+    """A completed write-through: the ack announces the host copy (CPU)."""
+    order, ack_id = _start_backup(cache, *nodes)
+    cache.tree_core.finish_write_through(order, ack_id)
+
+
+def _drain(cache, result):
+    """Free what an eviction step released: device slots to the allocator,
+    the test's stand-in host slots back to nowhere."""
+    cache._drain_device_frees(result.device_frees)
+    result.host_frees.clear()
+    return result
+
+
+def _evict_device(cache, node):
+    """The eviction path's leaf step: demote if backed up, delete otherwise."""
+    _drain(cache, cache.tree_core.evict_device_leaf(node.id, cache.is_write_back))
+
+
+def _apply(tiers, events):
+    """Fold events into ``{hash: {medium, ...}}`` the way the router's
+    ``TierMask`` does: a store widens, a remove clears its own medium, and a
+    page leaves when no tier holds it."""
+    for event in events:
+        if isinstance(event, BlockStored):
+            for block_hash in event.block_hashes:
+                tiers.setdefault(block_hash, set()).add(event.medium)
+        elif isinstance(event, BlockRemoved):
+            for block_hash in event.block_hashes:
+                held = tiers.get(block_hash, set())
+                held.discard(event.medium)
+                if not held:
+                    tiers.pop(block_hash, None)
+    return tiers
+
+
+def _snapshot(cache):
+    announced = cache.record_kv_snapshot()
+    events = cache.take_events()
+    assert isinstance(events[0], SnapshotBegin)
+    assert isinstance(events[-1], SnapshotEnd)
+    body = events[1:-1]
+    assert all(isinstance(e, BlockStored) for e in body)
+    # The count a consumer checks the window against: one per hash per
+    # BlockStored, the arithmetic of sbr-index's tree and ingest tracker.
+    counted = sum(len(e.block_hashes) for e in body)
+    assert announced == counted == events[0].num_blocks == events[-1].num_blocks
+    return announced, body
+
+
+def _assert_links_resolve_in_order(body):
+    """Every parent link names a page announced earlier in the batch, on any
+    tier: what lets a host-only chain resolve under a device-only parent."""
+    seen = set()
+    for block_hash, parent, *_ in _pages(body):
+        assert parent is None or parent in seen
+        seen.add(block_hash)
+
+
+def _hicache_tree():
+    """A=[1..4] -> B=[5,6] (both backed up, B device-evicted), C=[9..12]
+    (device only), D=[21..24] salted (device + host)."""
+    cache, allocator = _build_cache()
+    _insert(cache, allocator, [1, 2, 3, 4])
+    _insert(cache, allocator, [1, 2, 3, 4, 5, 6])
+    _insert(cache, allocator, [9, 10, 11, 12])
+    _insert(cache, allocator, [21, 22, 23, 24], cache_salt="tenant-a")
+    a, b = _node(cache, [1, 2, 3, 4]), _node(cache, [1, 2, 3, 4, 5, 6])
+    d = _node(cache, [21, 22, 23, 24])
+    _backup(cache, a, b)
+    _backup(cache, d)
+    _evict_device(cache, b)
+    return cache, allocator, a, b, d
+
+
+def test_a_device_evicted_backed_up_node_is_announced_on_the_host():
+    cache, _, a, b, d = _hicache_tree()
+    assert b.evicted and b.backuped
+    assert not a.evicted and a.backuped
+    live = cache.take_events()  # nothing taken yet: every event since build
+    net = _apply({}, live)
+
+    announced, body = _snapshot(cache)
+
+    # A (4) + C (4) + D (4) on the device; A (4) + B (2) + D (4) on the host.
+    assert announced == 22
+    assert _apply({}, body) == net
+    pages = _pages(body)
+    by_medium = {GPU: set(), CPU: set()}
+    for block_hash, _parent, tokens, _salt, medium in pages:
+        by_medium[medium].add(tokens)
+    assert by_medium[CPU] == {(1,), (2,), (3,), (4,), (5,), (6,), (21,), (22,), (23,), (24,)}
+    assert (5,) not in by_medium[GPU] and (6,) not in by_medium[GPU]
+    assert {(9,), (10,), (11,), (12,)} <= by_medium[GPU]
+    assert not {(9,), (10,), (11,), (12,)} & by_medium[CPU]
+    # The host-only pages chain to A's last page, as the live backup did.
+    b_pages = [p for p in pages if p[2] in {(5,), (6,)}]
+    a_last = next(p[0] for p in pages if p[2] == (4,))
+    assert b_pages[0][1] == a_last and b_pages[0][4] == CPU
+    # The salted chain keeps its namespace on the host tier too.
+    assert {p[3] for p in pages if p[2][0] >= 21} == {"tenant-a"}
+    _assert_links_resolve_in_order(body)
+
+
+def test_the_device_pass_comes_first_and_each_pass_coalesces_its_chains():
+    cache, *_ = _hicache_tree()
+    cache.take_events()
+    _, body = _snapshot(cache)
+    mediums = [e.medium for e in body]
+    first_cpu = mediums.index(CPU)
+    assert set(mediums[:first_cpu]) == {GPU} and set(mediums[first_cpu:]) == {CPU}
+    # A->B is one parent-linked host chain: one event, not one per node.
+    chain = next(e for e in body if e.medium == CPU and e.token_ids[:1] == [1])
+    assert chain.token_ids == [1, 2, 3, 4, 5, 6]
+
+
+def test_a_write_through_not_yet_acked_is_not_announced_on_the_host():
+    cache, allocator = _build_cache()
+    _insert(cache, allocator, [1, 2, 3, 4])
+    a = _node(cache, [1, 2, 3, 4])
+    order, ack_id = _start_backup(cache, a)
+    assert a.backuped and a.write_through_pending_id == ack_id
+    live = cache.take_events()
+    assert not [e for e in live if getattr(e, "medium", None) == CPU]
+
+    announced, body = _snapshot(cache)
+    assert announced == 4 and {e.medium for e in body} == {GPU}
+    assert _apply({}, body) == _apply({}, live)
+
+    # The ack is what makes the host copy announceable, on both paths.
+    cache.tree_core.finish_write_through(order, ack_id)
+    live += cache.take_events()
+    announced, body = _snapshot(cache)
+    assert announced == 8
+    assert _apply({}, body) == _apply({}, live)
+    assert {e.medium for e in body} == {GPU, CPU}
+
+
+def test_an_unbacked_device_eviction_leaves_nothing_on_either_tier():
+    cache, allocator = _build_cache()
+    _insert(cache, allocator, [1, 2, 3, 4])
+    _insert(cache, allocator, [9, 10, 11, 12])
+    c = _node(cache, [9, 10, 11, 12])
+    _evict_device(cache, c)  # not backed up: the node is deleted
+    live = cache.take_events()
+    assert not c.backuped
+
+    announced, body = _snapshot(cache)
+    assert announced == 4 and {e.medium for e in body} == {GPU}
+    assert not {t for p in _pages(body) for t in p[2]} & {9, 10, 11, 12}
+    assert _apply({}, body) == _apply({}, live)
+
+
+def test_a_host_evicted_page_leaves_the_snapshot():
+    cache, *_ = _hicache_tree()
+    live = cache.take_events()
+    # Host pressure takes the host-only leaf B first (A and D are still on
+    # device, so they are not host-evictable leaves).
+    _drain(cache, cache.tree_core.drive_host_eviction(ComponentType.FULL, 2))
+    host_evict = cache.take_events()
+    assert [e.medium for e in host_evict if isinstance(e, BlockRemoved)] == [CPU]
+    live += host_evict
+
+    announced, body = _snapshot(cache)
+    assert announced == 20
+    assert _apply({}, body) == _apply({}, live)
+    assert not {t for p in _pages(body) for t in p[2]} & {5, 6}
+
+
+def test_without_a_host_tier_the_snapshot_is_the_device_pass_alone():
+    cache, allocator = _build_cache()
+    _insert(cache, allocator, [1, 2, 3, 4])
+    _insert(cache, allocator, [1, 2, 3, 4, 5, 6])
+    _insert(cache, allocator, [1, 2, 7, 8])
+    live = cache.take_events()
+    announced, body = _snapshot(cache)
+    assert announced == 8
+    assert {e.medium for e in body} == {GPU}
+    assert sorted(_pages(body)) == sorted(_pages(live))
+
+
+def test_a_host_copy_under_a_device_only_parent_is_reached():
+    """Write-back keeps a child's host copy while its parent has none; the host
+    pass descends through the device-only parent instead of stopping."""
+    cache, allocator = _build_cache()
+    _insert(cache, allocator, [1, 2, 3, 4])
+    _insert(cache, allocator, [1, 2, 3, 4, 5, 6])
+    a, b = _node(cache, [1, 2, 3, 4]), _node(cache, [1, 2, 3, 4, 5, 6])
+    _backup(cache, b)
+    live = cache.take_events()
+    assert not a.backuped and b.backuped
+
+    announced, body = _snapshot(cache)
+    assert announced == 6 + 2
+    assert _apply({}, body) == _apply({}, live)
+    cpu = [p for p in _pages(body) if p[4] == CPU]
+    assert [p[2] for p in cpu] == [(5,), (6,)]
+    assert cpu[0][1] == next(p[0] for p in _pages(body) if p[2] == (4,))
+    _assert_links_resolve_in_order(body)
+
+
+# HiRadixCache (radix_cache.TreeNode with a host_value) is gone upstream: the
+# HiCache host tier lives only in the unified tree, which the tests above drive.
+
+
+def _attach(parent, tokens, *, device=True, host=False, pending=None):
+    node = TreeNode()
+    node.key = RadixKey(array("q", tokens))
+    node.parent = parent
+    node.value = torch.tensor(tokens, dtype=torch.int64) if device else None
+    node.host_value = torch.tensor(tokens, dtype=torch.int64) if host else None
+    node.write_through_pending_id = pending
+    parent.children[node.key.child_key(2)] = node
+    return node
+
+
+def test_a_disabled_recorder_still_announces_nothing():
+    root = TreeNode()
+    root.key = RadixKey(array("q", []))
+    root.value = []
+    root.hash_value = []
+    _attach(root, [1, 2], device=False, host=True)
+    rec = KVCacheEventRecorder(enabled=False, page_size=2)
+    assert rec.record_snapshot(root) == 0
+    assert rec.take() == []
diff --git a/test/srt/sbr/test_t_snapshot_off_loop.py b/test/srt/sbr/test_t_snapshot_off_loop.py
new file mode 100644
index 0000000000..a34fde413b
--- /dev/null
+++ b/test/srt/sbr/test_t_snapshot_off_loop.py
@@ -0,0 +1,548 @@
+"""t - the KV snapshot is rendered off the scheduler loop, in bounded frames.
+
+``publish_kv_events`` used to answer a snapshot request by walking the whole
+radix tree and building every ``BlockStored`` on the scheduler loop, and the
+publisher thread then encoded the result as one batch -- one C call holding
+the GIL. At box-c's scale that is ~1.8 s (device only) or ~3.5 s (with 0028's
+host pass) during which no running request is scheduled, and one 104-313 MB
+frame to every subscriber.
+
+Now the loop only takes a *cut* (``cut_snapshot``: one walk that keeps, per
+announced node, the values the events are built from), and a ``SnapshotRender``
+thread renders the cut into frames of at most ``SNAPSHOT_FRAME_TOKENS`` tokens
+and publishes them. Live batches the loop produces while the render is open are
+*held* and published right after the last frame, so on the wire every live
+event follows the window it belongs after: a consumer that adopts the window
+(the cache at the cut) and applies the held batches ends exactly where the
+cache is. A small cut is still rendered inline into the step's batch.
+
+The consumer here is a Python model of the serving router's ``HashTree`` window
+(``crates/sbr-index/src/tree.rs`` ``apply_batch`` / ``close_window``): a store
+inside an open window lands in the live tree and the staged one and counts
+toward the window's pages; a remove clears both; ``SnapshotEnd`` adopts the
+staged tree only when the begin's claim, the end's count and the pages counted
+all agree, and refuses it otherwise.
+
+The renderer is gated (``_Gate``) so the test decides when each frame goes out:
+the loop runs real cache mutations -- an insert, a write-through ack, a device
+eviction, a host eviction -- while the window is open on the wire.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+
+import msgspec
+import zmq
+
+# The unified fixture (box-c's shape), the hasher double and the HiCache drivers
+# are test_i's and test_s's; this part adds no second copy of any of them.
+from test_i_unified_radix_snapshot import (  # noqa: F401  (autouse fixture)
+    _native_hash_module,
+    _pages,
+)
+from test_s_snapshot_host_tier import (
+    _apply,
+    _backup,
+    _drain,
+    _evict_device,
+    _hicache_tree,
+    _insert,
+    _node,
+)
+
+from sglang.srt.disaggregation.kv_events import (
+    BlockRemoved,
+    BlockStored,
+    KVEventBatch,
+    SnapshotBegin,
+    SnapshotEnd,
+    StorageMedium,
+    ZmqEventPublisher,
+)
+from sglang.srt.managers.scheduler_components import kv_events_publisher as kvp
+from sglang.srt.managers.scheduler_components.kv_events_publisher import (
+    SchedulerKvEventsPublisher,
+)
+from sglang.srt.mem_cache import events as recorder_events
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+
+WAIT_S = 10.0
+GPU = StorageMedium.GPU
+CPU = StorageMedium.CPU
+
+
+class _Publisher:
+    """Stands in for the zmq publisher: records batches in publish order (from
+    the loop and the render thread alike) and owns the request latch."""
+
+    def __init__(self, *, snapshot_requests: int = 0) -> None:
+        self.batches: list = []
+        self.pending = snapshot_requests
+        self._lock = threading.Lock()
+
+    def publish(self, batch) -> None:
+        with self._lock:
+            self.batches.append(batch)
+
+    def take_snapshot_request(self) -> bool:
+        with self._lock:
+            if self.pending > 0:
+                self.pending -= 1
+                return True
+            return False
+
+    def shutdown(self) -> None:
+        pass
+
+    def wait_for(self, count: int) -> None:
+        deadline = time.monotonic() + WAIT_S
+        while len(self.batches) < count:
+            assert time.monotonic() < deadline, f"{len(self.batches)} < {count} batches"
+            time.sleep(0.005)
+
+
+def _scheduler(cache, publisher, **snapshot):
+    # Upstream reads the publisher ranks off the runtime context (rank 0 here).
+    from sglang.srt.runtime_context import get_parallel
+
+    with get_parallel().override(
+        pp_rank=0,
+        attn_tp_rank=0,
+        attn_cp_rank=0,
+        attn_dp_size=1,
+        attn_dp_rank=0,
+        dp_rank=0,
+    ):
+        component = SchedulerKvEventsPublisher(
+            kv_events_config='{"publisher": "null"}',
+            tree_cache=cache,
+            send_metrics_from_scheduler=None,
+            max_running_requests=8,
+            max_total_num_tokens=1024,
+            get_stats=lambda: None,
+            **snapshot,
+        )
+    component.kv_event_publisher = publisher
+    return component
+
+
+def _off_loop(cache, publisher):
+    """Every snapshot off the loop, in frames of at most 3 tokens (page 1)."""
+    return _scheduler(
+        cache, publisher, snapshot_inline_tokens=0, snapshot_frame_tokens=3
+    )
+
+
+class _Gate:
+    """Holds the renderer before each frame until the test lets it through, so
+    the loop can run while a snapshot is open on the wire. ``fail_after``
+    raises in the renderer instead of rendering frame ``fail_after + 1``."""
+
+    def __init__(self, monkeypatch, *, release_first: int, fail_after=None):
+        self._allowed = threading.Semaphore(release_first)
+        real = kvp.render_snapshot_frames
+
+        def gated(cut, **kwargs):
+            for index, frame in enumerate(real(cut, **kwargs)):
+                assert self._allowed.acquire(timeout=WAIT_S), "gate never opened"
+                if fail_after is not None and index >= fail_after:
+                    raise RuntimeError("render failed")
+                yield frame
+
+        monkeypatch.setattr(kvp, "render_snapshot_frames", gated)
+
+    def open(self) -> None:
+        self._allowed.release(1_000_000)
+
+
+class _Mirror:
+    """the serving router's ``HashTree`` window semantics, tier for tier."""
+
+    def __init__(self) -> None:
+        self.live: dict = {}
+        self.window = None
+        self.baselines: list = []
+
+    def apply(self, batch) -> None:
+        for event in batch.events:
+            if isinstance(event, BlockStored):
+                _apply(self.live, [event])
+                if self.window is not None:
+                    _apply(self.window["staged"], [event])
+                    self.window["pages"] += len(event.block_hashes)
+            elif isinstance(event, BlockRemoved):
+                _apply(self.live, [event])
+                if self.window is not None:
+                    _apply(self.window["staged"], [event])
+            elif isinstance(event, SnapshotBegin):
+                self.window = {"claimed": event.num_blocks, "pages": 0, "staged": {}}
+            elif isinstance(event, SnapshotEnd):
+                window, self.window = self.window, None
+                if (
+                    window is not None
+                    and window["claimed"] == event.num_blocks == window["pages"]
+                ):
+                    self.live = window["staged"]
+                    self.baselines.append(("adopted", _copy(self.live)))
+                else:
+                    self.baselines.append(("refused", None))
+
+
+def _copy(tiers):
+    return {h: set(m) for h, m in tiers.items()}
+
+
+def _kinds(batch):
+    return [type(event).__name__ for event in batch.events]
+
+
+def _truth(cache):
+    """The cache's placement now: a fresh inline snapshot, folded."""
+    cache.take_events()
+    cache.record_kv_snapshot()
+    return _apply({}, cache.take_events())
+
+
+def _loop_steps(cache, allocator, component, a, b, d):
+    """Four scheduler steps of real cache traffic, each published as the loop
+    publishes it: an insert (GPU store), a write-through ack (CPU store), a
+    device eviction of a backed-up leaf (GPU remove) and a host eviction of
+    the host-only leaf (CPU remove)."""
+    _insert(cache, allocator, [31, 32, 33])
+    component.publish_kv_events()
+    c = _node(cache, [9, 10, 11, 12])
+    _backup(cache, c)
+    component.publish_kv_events()
+    _evict_device(cache, d)
+    component.publish_kv_events()
+    _drain(cache, cache.tree_core.drive_host_eviction(ComponentType.FULL, 2))
+    component.publish_kv_events()
+
+
+def _scenario(monkeypatch, *, release_first: int, hold: bool = True):
+    """A HiCache tree, a gated off-loop snapshot, live traffic while it is
+    open; returns what a subscribed mirror saw and what the cache holds."""
+    cache, allocator, a, b, d = _hicache_tree()
+    mirror = _Mirror()
+    history = cache.take_events()
+    mirror.apply(KVEventBatch(ts=0.0, events=history))
+    at_cut = _apply({}, history)
+
+    publisher = _Publisher(snapshot_requests=1)
+    component = _off_loop(cache, publisher)
+    gate = _Gate(monkeypatch, release_first=release_first)
+    if not hold:
+        monkeypatch.setattr(kvp.SnapshotRender, "offer", lambda self, batch: False)
+
+    component.publish_kv_events()
+    render = component.snapshot_render
+    assert render is not None and not render.closed
+    publisher.wait_for(release_first)
+    _loop_steps(cache, allocator, component, a, b, d)
+    while_open = list(publisher.batches)
+
+    gate.open()
+    assert render.join(WAIT_S)
+    component.publish_kv_events()
+    assert component.snapshot_render is None
+    for batch in publisher.batches:
+        mirror.apply(batch)
+    return mirror, at_cut, _truth(cache), publisher.batches, while_open, render
+
+
+# ---- the render is off the loop, and the loop never waits for it -----------
+
+
+def test_the_loop_returns_while_the_render_is_blocked(monkeypatch):
+    cache, *_ = _hicache_tree()
+    publisher = _Publisher(snapshot_requests=1)
+    component = _off_loop(cache, publisher)
+    gate = _Gate(monkeypatch, release_first=0)
+
+    started = time.monotonic()
+    component.publish_kv_events()
+    took = time.monotonic() - started
+
+    render = component.snapshot_render
+    assert render is not None and not render.closed
+    # The renderer is parked before its first frame and the step returned
+    # anyway: the loop paid for the cut alone. What the tree recorded before
+    # the cut (its whole build here) went out first, as one batch, ahead of
+    # the snapshot.
+    assert took < 1.0
+    (pending,) = publisher.batches
+    assert not {"SnapshotBegin", "SnapshotEnd"} & set(_kinds(pending))
+    gate.open()
+    assert render.join(WAIT_S)
+    assert render.frames > 1 and render.error is None
+
