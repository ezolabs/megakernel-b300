new file mode 100644
index 0000000000..f6d10f85c9
--- /dev/null
+++ b/python/sglang/srt/utils/log_redact.py
@@ -0,0 +1,128 @@
+"""Content-free summaries of request data for log lines and error messages.
+
+Server logs must never carry request content: prompts, messages, output text,
+response schemas / regexes / EBNF grammars, tool definitions or arguments, or
+token id lists.  Error paths that used to dump such values log a summary
+instead: the value's length plus a short sha256 digest, enough to tell two
+failures apart, to match a failure against a request the client still holds,
+and to correlate repeated failures, without the content itself.
+
+This module is dependency-free on purpose so that any layer can import it.
+"""
+
+from __future__ import annotations
+
+import array
+import hashlib
+import json
+import traceback
+from typing import Any
+
+DIGEST_HEX_CHARS = 12
+
+
+def _digest(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()[:DIGEST_HEX_CHARS]
+
+
+def _is_token_ids(value: Any) -> bool:
+    if isinstance(value, array.array):
+        return value.typecode in "bBhHiIlLqQ"
+    return isinstance(value, (list, tuple)) and all(
+        isinstance(v, int) and not isinstance(v, bool) for v in value
+    )
+
+
+def redact(value: Any) -> str:
+    """Summarize ``value`` without its content.
+
+    - ``None`` -> ``"None"``
+    - ``str`` -> ``"<str len=N sha256=xxxxxxxxxxxx>"`` (len in characters)
+    - ``bytes`` -> ``"<bytes len=N sha256=…>"``
+    - a list/tuple of ints or an integer ``array.array`` (token ids) ->
+      ``"<ids n=N sha256=…>"``; the digest covers the comma-joined decimal ids
+    - a bare int (one token id) -> ``"<id sha256=…>"``
+    - anything else (dicts, mixed lists, objects) -> ``"<TypeName len=N
+      sha256=…>"`` over its JSON (falling back to ``repr``) serialization
+    """
+    if value is None:
+        return "None"
+    if isinstance(value, str):
+        return f"<str len={len(value)} sha256={_digest(value.encode('utf-8', 'surrogatepass'))}>"
+    if isinstance(value, (bytes, bytearray)):
+        return f"<bytes len={len(value)} sha256={_digest(bytes(value))}>"
+    if isinstance(value, int) and not isinstance(value, bool):
+        return f"<id sha256={_digest(str(value).encode())}>"
+    if _is_token_ids(value):
+        joined = ",".join(str(v) for v in value).encode()
+        return f"<ids n={len(value)} sha256={_digest(joined)}>"
+    try:
+        text = json.dumps(value, sort_keys=True, ensure_ascii=False, default=repr)
+    except (TypeError, ValueError):
+        text = repr(value)
+    return (
+        f"<{type(value).__name__} len={len(text)} "
+        f"sha256={_digest(text.encode('utf-8', 'surrogatepass'))}>"
+    )
+
+
+def redact_exc(exc: BaseException) -> str:
+    """An exception's type plus a content-free summary of its message.
+
+    For exceptions raised while parsing or compiling request content (schema
+    compilers, grammar parsers, JSON decoders over model output), whose message
+    can quote the offending input.
+
+    The stdlib ``json.JSONDecodeError`` keeps its message: it is built from a
+    fixed reason and the line / column / char offset only, never the document.
+    (Exactly that type: a subclass may build its message differently.)
+    """
+    if type(exc) is json.JSONDecodeError:
+        return (
+            f"{type(exc).__name__}({exc.msg}: line {exc.lineno} "
+            f"column {exc.colno} (char {exc.pos}))"
+        )
+    return f"{type(exc).__name__}({redact(str(exc))})"
+
+
+_CAUSE_LINK = (
+    "\nThe above exception was the direct cause of the following exception:\n\n"
+)
+_CONTEXT_LINK = (
+    "\nDuring handling of the above exception, another exception occurred:\n\n"
+)
+
+
+def redacted_traceback(exc: BaseException) -> str:
+    """``exc``'s traceback, chained causes included, with every message redacted.
+
+    The replacement for ``logger.exception(...)`` / ``exc_info=True`` on paths
+    whose exception may quote request content: the standard traceback ends
+    with ``str(exc)`` (and, for a ``SyntaxError``, the offending source text),
+    so it would carry the content ``redact_exc`` keeps out of the message.
+    Frames (file, line, function and the code line) are kept; each
+    exception's own line is ``redact_exc(exc)``.
+    """
+    chain = []
+    seen = set()
+    cur, link = exc, ""
+    while cur is not None and id(cur) not in seen:
+        seen.add(id(cur))
+        chain.append((cur, link))
+        if cur.__cause__ is not None:
+            cur, link = cur.__cause__, _CAUSE_LINK
+        elif cur.__context__ is not None and not cur.__suppress_context__:
+            cur, link = cur.__context__, _CONTEXT_LINK
+        else:
+            cur = None
+    parts = []
+    # Oldest first, as the interpreter prints a chain; each link sits between
+    # an exception and the one it caused.
+    for i, (e, _) in enumerate(reversed(chain)):
+        if i:
+            parts.append(chain[len(chain) - i][1])
+        if e.__traceback__ is not None:
+            parts.append("Traceback (most recent call last):\n")
+            parts.extend(traceback.format_tb(e.__traceback__))
+        parts.append(redact_exc(e) + "\n")
+    return "".join(parts).rstrip("\n")
