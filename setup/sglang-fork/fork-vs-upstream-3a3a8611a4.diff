+                self.assertIn('"name": "get_weather"', prompt)
+                self.assertIn('"name": "get_time"', prompt)
+                elements = result.tool_call_constraint[1].format.elements
+                self.assertEqual(elements[0].value, f"\n\n<{self.DSML} calls>\n")
