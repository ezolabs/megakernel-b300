+    # Control: the kimi parsers put the count in the id, so on an engine that ran one the
+    # placeholder would change the output (the ids egress is DSv4.1-only).
+    chat.tool_call_parser = "kimi_k2"
+    assert chat._process_tool_call_id(item, 7) == "functions.f:8"
+    assert chat._process_tool_call_id(item, 0) == "functions.f:1"
