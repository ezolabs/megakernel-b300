diff --git a/test/registered/unit/managers/test_detokenizer_incremental.py b/test/registered/unit/managers/test_detokenizer_incremental.py
new file mode 100644
index 0000000000..c6f268affc
--- /dev/null
+++ b/test/registered/unit/managers/test_detokenizer_incremental.py
@@ -0,0 +1,171 @@
+"""Unit test for DetokenizerManager._decode_batch_token_id_output's streaming path.
+
+A character the tokenizer spells with several byte tokens decodes to U+FFFD until its
+last byte arrives, and the streaming branch then emits only find_printable_text's prefix
+without committing. That cut is not monotonic across retries (a CJK penultimate char
+keeps text[:-1], anything else cuts back to the last space), so a shorter printable must
+not pull sent_offset back: when it did, the commit re-sent new_text from the lower offset
+and the client saw text twice (a DeepSeek-V4.1 stream under DSPARK's multi-token steps
+read "齉䶮𠀾齉䶮𠀾𪚥" for the ids of "齉䶮𠀾𪚥"). Pure CPU: a byte-level stand-in tokenizer
+and a stub self, so no __init__ / IPC."""
+
+import random
+import unittest
+from types import SimpleNamespace
+
+from sglang.srt.managers.detokenizer_manager import DetokenizerManager
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+
+class ByteTokenizer:
+    """id -> raw bytes; decode joins them and replaces invalid UTF-8, as a byte-level
+    BPE does."""
+
+    is_fast = True
+
+    def __init__(self, vocab):
+        self.vocab = vocab
+
+    def __len__(self):
+        return len(self.vocab)
+
+    def decode(self, ids, skip_special_tokens=True, spaces_between_special_tokens=True):
+        return b"".join(self.vocab[i] for i in ids).decode("utf-8", "replace")
+
+    def batch_decode(
+        self, ids_list, skip_special_tokens=True, spaces_between_special_tokens=True
+    ):
+        return [self.decode(ids) for ids in ids_list]
+
+
+def _vocab():
+    """Every byte as its own token, plus whole-char tokens for a few strings."""
+    pieces = [bytes([b]) for b in range(256)]
+    pieces += [s.encode() for s in ("中", "面", "ab", "<<<", "ｱ")]
+    # The lead byte pair shared by the half-width katakana (DeepSeek's id 5879).
+    pieces.append(b"\xef\xbd")
+    return pieces
+
+
+VOCAB = _vocab()
+TOK = ByteTokenizer(VOCAB)
+ID = {p: i for i, p in enumerate(VOCAB)}
+# The prompt's surrogate context (INIT_INCREMENTAL_DETOKENIZATION_OFFSET tokens).
+PROMPT_TAIL = [ID[b"x"]] * 5
+
+
+def ids_of(*parts):
+    """Each str part is one whole token; each bytes part is one token per byte."""
+    out = []
+    for p in parts:
+        if isinstance(p, str):
+            out.append(ID[p.encode()])
+        else:
+            out.extend(ID[bytes([b])] for b in p)
+    return out
+
+
+def _stub():
+    stub = object.__new__(DetokenizerManager)
+    stub.tokenizer = TOK
+    stub.vocab_size = len(TOK)
+    stub.decode_status = {}
+    stub.disable_tokenizer_batch_decode = False
+    stub.is_tool_call_parser_gpt_oss = False
+    return stub
+
+
+def stream(ids, steps, rid="r"):
+    """Feed ids in the given step sizes, as the scheduler sends them; return each
+    step's emitted text."""
+    dm = _stub()
+    out, pos, k = [], 0, 0
+    while pos < len(ids):
+        chunk = ids[pos : pos + steps[k % len(steps)]]
+        k += 1
+        first = pos == 0
+        pos += len(chunk)
+        finished = None if pos < len(ids) else {"type": "length", "length": len(ids)}
+        recv = SimpleNamespace(
+            rids=[rid],
+            decode_ids=[(PROMPT_TAIL if first else []) + chunk],
+            read_offsets=[len(PROMPT_TAIL)],
+            finished_reasons=[finished],
+            no_stop_trim=[False],
+            skip_special_tokens=[True],
+            spaces_between_special_tokens=[True],
+            decoded_texts=[""],
+        )
+        out.append(dm._decode_batch_token_id_output(recv)[0])
+    return out
+
+
+class TestIncrementalDetokenize(unittest.TestCase):
+    def assert_streams_as_whole(self, ids, steps, msg=None):
+        """Every running concatenation of the deltas is a prefix of the whole decode
+        (nothing sent twice, nothing sent that is later taken back) and the last one
+        is the whole decode (nothing lost)."""
+        whole = TOK.decode(ids)
+        sent = ""
+        for delta in stream(ids, steps):
+            sent += delta
+            self.assertTrue(whole.startswith(sent), (sent, whole, msg))
+        self.assertEqual(sent, whole, msg)
+
+    def test_cjk_ext_b_then_ext_g_is_not_resent(self):
+        # 𪚥 (U+2A6A5, in _is_chinese_char's table) then 𰻞 (U+30EDE, Ext G, not in
+        # it), four byte tokens each. Steps: x | f0 aa 9a | a5 f0 | b0 bb 9e f0 | b0 bb 9e
+        # The second retry prints "𪚥"; the third ("𪚥𰻞�", penultimate not CJK)
+        # prints "", which used to pull sent_offset back under the "𪚥" already sent.
+        ids = ids_of("x", "𪚥".encode(), "𰻞".encode(), "𰻞".encode())
+        self.assertEqual("".join(stream(ids, [1, 3, 2, 4, 3])), "x𪚥𰻞𰻞")
+        self.assert_streams_as_whole(ids, [1, 3, 2, 4, 3])
+
+    def test_cjk_then_split_emoji_and_word_is_not_resent(self):
+        # 中 printed on a retry ("中�"), then "中😀ab�" cuts back to the last space
+        # (there is none) and prints "".
+        ids = ids_of("x", "中", "😀".encode(), "ab", "😀".encode())
+        self.assertEqual("".join(stream(ids, [1, 2, 5, 3])), "x中😀ab😀")
+        self.assert_streams_as_whole(ids, [1, 2, 5, 3])
+
+    def test_one_token_per_step_matches_the_whole_decode(self):
+        ids = ids_of("x", "中", "𪚥".encode(), "𰻞".encode(), "ab", " ", "😀".encode())
+        self.assert_streams_as_whole(ids, [1])
+
+    def test_random_steps_match_the_whole_decode(self):
+        rng = random.Random(2587)
+        alphabet = [
+            "中",
+            "面",
+            "ab",
+            " ",
+            "ｱ",
+            "x",
+            "𪚥".encode(),
+            "𰻞".encode(),
+            "😀".encode(),
+            "龘".encode(),
+            "ﾁ".encode(),
+            "é".encode(),
+        ]
+        for seed in range(300):
+            parts = [rng.choice(alphabet) for _ in range(rng.randint(5, 40))]
+            ids = ids_of(*parts)
+            steps = [rng.randint(1, 6) for _ in range(len(ids))]
+            self.assert_streams_as_whole(ids, steps, (seed, parts, steps))
+
+    def test_an_invalid_byte_sequence_surfaces_once_as_fffd(self):
+        # The model's own bytes: ｱ, then the lead EF BD of the next katakana, then
+        # "<<<" instead of its continuation byte. The stream holds the lead while it
+        # may still complete, then emits exactly what the whole decode has: one U+FFFD.
+        ids = [ID["ｱ".encode()], ID[b"\xef\xbd"], ID[b"<<<"]]
+        self.assertEqual(TOK.decode(ids), "ｱ�<<<")
+        for steps in ([1], [2], [3]):
+            self.assertEqual("".join(stream(ids, steps)), "ｱ�<<<")
+            self.assert_streams_as_whole(ids, steps)
+
+
+if __name__ == "__main__":
+    unittest.main()
