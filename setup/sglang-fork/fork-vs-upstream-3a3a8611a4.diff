     """DeepSeek V4.1 DSML detector.
 
     The leading space in each tag name below is intentional, not a typo.
+
+    With ``calls_block_prefilled`` set, the prompt already ends with
+    :attr:`tool_calls_prefill` (``\\n\\n<｜DSML｜ calls>\\n``), as
+    deepseek-recipe renders a forced tool call in chat mode
+    (``encoding_dsv41.TOOL_CALLS_PREFILL``): the output starts inside the calls
+    block, at its first invoke. It is parsed, one-shot and streamed, exactly as
+    the same output with the prefill in front of it, and the forced-call
+    grammar starts after the opener.
     """
 
     tool_calls_block_name = " calls"
     invoke_tag_name = " invoke"
     parameter_tag_name = " parameter"
+    # Kept in the fork after upstream #46219 dropped them (upstream parses V4.1
+    # chat output through deepseek-recipe): this detector still parses V4.1
+    # DSML on the FunctionCallParser paths, where string parameters are
+    # verbatim.
+    strip_string_param_value: bool = False
+
+    # The encoder joins an assistant turn's content and its calls block with a
+    # blank line, and renders it even when there is no content.
+    tool_calls_prefix = "\n\n"
+    think_end_token = "</think>"
+
+    def __init__(self):
+        super().__init__()
+        self.calls_block_prefilled = False
+        # Streaming: whether the prefill has been put in front of the output.
+        self._prefill_fed = False
+
+    @property
+    def tool_calls_prefill(self) -> str:
+        """The calls-block opener a forced tool call's prompt ends with."""
+        return f"{self.tool_calls_prefix}{self.bot_token}\n"
+
+    def _prefilled(self, text: str) -> str:
+        return self.tool_calls_prefill + text if self.calls_block_prefilled else text
+
+    def has_tool_call(self, text: str) -> bool:
+        return super().has_tool_call(self._prefilled(text))
+
+    def detect_and_parse(self, text: str, tools: List[Tool]) -> StreamingParseResult:
+        return super().detect_and_parse(self._prefilled(text), tools)
+
+    def parse_streaming_increment(
+        self, new_text: str, tools: List[Tool]
+    ) -> StreamingParseResult:
+        if self.calls_block_prefilled and not self._prefill_fed:
+            self._prefill_fed = True
+            new_text = self.tool_calls_prefill + new_text
+        return super().parse_streaming_increment(new_text, tools)
 
     def get_structural_tag_name(self) -> Optional[str]:
         return "deepseek_v4_1"
+
+    def get_structural_tag(
+        self,
+        tools: Optional[List[Tool]] = None,
+        tool_choice: Union[ToolChoice, Literal["auto", "required"]] = "auto",
+        thinking_mode: bool = False,
+        parallel_tool_calls: bool = True,
+    ) -> Optional[StructuralTag]:
+        """The DSML tag; with the calls block prefilled, without its opener."""
+        tag = super().get_structural_tag(
+            tools=tools,
+            tool_choice=tool_choice,
+            thinking_mode=thinking_mode,
+            parallel_tool_calls=parallel_tool_calls,
+        )
+        if tag is None or not self.calls_block_prefilled:
+            return tag
+        if tool_choice != "required" and not isinstance(tool_choice, ToolChoice):
+            raise ValueError("A prefilled calls block needs a forced tool call")
+        if not _drop_leading_const(tag.format, self.tool_calls_prefill):
+            raise ValueError(
+                "The forced-call structural tag does not open with "
+                f"{self.tool_calls_prefill!r}"
+            )
+        return tag
+
+
+def _drop_leading_const(node, value: str) -> bool:
+    """Remove the constant string ``value`` that opens the sequence ``node``.
+
+    A forced call's tag is ``[opener, invokes, closer]``, or, with the
+    reasoning span in front, ``[reasoning, [opener, invokes, closer]]``.
+    Returns whether the opener was found.
+    """
+    elements = getattr(node, "elements", None)
+    if not elements:
+        return False
+    first = elements[0]
+    if getattr(first, "type", None) == "const_string" and first.value == value:
+        del elements[0]
+        return True
+    return _drop_leading_const(elements[-1], value)
