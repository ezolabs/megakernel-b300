+class TestReplayMatchesEager(_CpuPlatform, CustomTestCase):
+    """Replay flags plain exactly when eager builds no tail, and the plain
+    tail's kernel choice equals the full metadata's."""
+
+    def _backend(self):
+        backend = _backend()
+        backend.late_tail_len = TAIL_LEN
+        backend.late_tail_page = TAIL_PAGE
+        backend.encoder_row_floor = None
+        backend.model_runner = SimpleNamespace(spec_algorithm=SpeculativeAlgorithm.NONE)
+        return backend
+
+    def test_replay_flag_and_kernel(self):
+        cases = (
+            ([43], [43]),
+            ([2560], [2560]),
+            ([3000], [3000]),
+            ([100], [10100]),
+            ([2560], [12560]),
+            ([43, 700], [43, 900]),
+        )
+        seen = set()
+        for extend_lens, seq_lens in cases:
+            backend = self._backend()
+            forward_batch = SimpleNamespace(
+                forward_mode=ForwardMode.EXTEND,
+                extend_seq_lens_cpu=extend_lens,
+                seq_lens_cpu=torch.tensor(seq_lens),
+                extend_logprob_start_lens_cpu=None,
+                return_logprob=False,
+                capture_hidden_mode=CaptureHiddenMode.NULL,
+                encoder_swa_replay=False,
+            )
+            with get_parallel().override(attn_dp_size=1):
+                eager_skips_tail = backend._late_layer_tail_runs_plain(forward_batch)
+                tail_md = _metadata(_tail(sum(extend_lens)))
+                backend._mark_plain_tail(tail_md, forward_batch)
+            seen.add(eager_skips_tail)
+            with self.subTest(extend=extend_lens, seq=seq_lens):
+                self.assertEqual(tail_md.late_layer_tail.plain, eager_skips_tail)
+                rows = sum(extend_lens)
+                backend.forward_metadata = _metadata()
+                full = backend._use_sparse_prefill(forward_batch, num_qo_tokens=rows)
+                backend.forward_metadata = tail_md
+                tail = backend._use_sparse_prefill(forward_batch, num_qo_tokens=rows)
