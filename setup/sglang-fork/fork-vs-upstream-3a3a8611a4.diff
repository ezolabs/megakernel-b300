+def test_split_ids_keeps_first_token_latency_on_the_non_ids_side():
+    non_ids, ids = SglExt(first_token_latency=TTFT, input_ids=[7]).split_ids()
+    assert non_ids is not None and non_ids.first_token_latency == TTFT
+    assert ids is not None and ids.input_ids == [7]
+    assert ids.first_token_latency is None
+    # Control: with only the ids set, there is no non-ids side.
+    non_ids_only, _ = SglExt(input_ids=[7]).split_ids()
+    assert non_ids_only is None
