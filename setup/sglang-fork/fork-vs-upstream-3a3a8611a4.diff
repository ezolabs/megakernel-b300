index 0000000000..1db6ba5645
--- /dev/null
+++ b/test/srt/sbr/test_f_metric_label_denylist.py
@@ -0,0 +1,395 @@
+"""``--metric-label-denylist`` drops named labels from every Prometheus series.
+
+Cardinality control that does not need a redeploy of the router: the engine
+already exports ``priority``, plus one more dimension per label set for
+``model_name``, ``engine_type``, ``tp_rank``, ... A deployment that cannot
+afford a dimension names it on the command line, and every label dict a
+collector is built from is filtered through
+:func:`apply_metric_label_denylist` before the metrics are constructed. The
+denied name is therefore absent from the metric's ``labelnames``: dashboards
+selecting on the remaining labels keep working, and a query pinned to the
+dropped label finds nothing rather than a series that silently aggregates
+something else.
+
+Two call-time additions are covered as well, because both add a name the
+collector was *not* built with: the per-priority queue breakdown in
+``SchedulerMetricsCollector._log_gauge_queue_count`` and the tokenizer's
+per-request ``custom_labels``/``priority`` merge. Left unfiltered, either hands
+``prometheus_client``'s ``.labels(**)`` a label it never declared, which raises
+``ValueError`` when the metric is emitted -- the last test pins that failure
+mode, so the fix cannot quietly stop being load-bearing.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from functools import partial
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+from prometheus_client import CollectorRegistry, Counter, Gauge, Histogram
+
+from sglang.srt.managers import tokenizer_manager as tm_mod
+from sglang.srt.observability import metrics_collector
+from sglang.srt.observability.metrics_collector import (
+    QueueCount,
+    SchedulerMetricsCollector,
+    TokenizerMetricsCollector,
+    apply_metric_label_denylist,
+)
+from sglang.srt.server_args import prepare_server_args
+
+DENIED = ["priority"]
+MODEL_NAME = "m"
+
+
+def _obs(denylist, **extra):
+    """The ``observability`` bag the modules under test read.
+
+    Only the fields those code paths touch are set; anything else is an
+    AttributeError rather than a plausible-looking default, so a new read added
+    to a call site fails this file loudly instead of widening the window with a
+    made-up value.
+    """
+    return SimpleNamespace(
+        metric_label_denylist=denylist,
+        enable_metrics=True,
+        enable_metrics_for_all_schedulers=False,
+        kv_events_config=None,
+        extra_metric_labels=None,
+        stat_loggers=None,
+        gc_warning_threshold_secs=0.0,
+        tokenizer_metrics_allowed_custom_labels=None,
+        prompt_tokens_buckets=None,
+        generation_tokens_buckets=None,
+        bucket_time_to_first_token=None,
+        bucket_inter_token_latency=None,
+        bucket_e2e_request_latency=None,
+        **extra,
+    )
+
+
+def _serving():
+    return SimpleNamespace(served_model_name=MODEL_NAME, enable_streaming_session=False)
+
+
+def _disagg():
+    return SimpleNamespace(disaggregation_mode="null", enable_pd_role_switch=False)
+
+
+def _device():
+    return SimpleNamespace(soft_watchdog_timeout=1.0)
+
+
+def _capturing_collector_factory(captured):
+    """A `resolve_collector_class` stand-in whose collector records its kwargs."""
+
+    class _Capturing:
+        def __init__(self, **kwargs):
+            captured.update(kwargs)
+
+    return lambda role, default: _Capturing
+
+
+@contextlib.contextmanager
+def _published_observability(denylist, bag=None):
+    """Publish one observability bag to both modules under test.
+
+    The config read is per-process state, and each module holds its own
+    reference to the accessor, so both have to see the same bag.
+    """
+    bag = bag if bag is not None else _obs(denylist)
+    with patch.object(
+        metrics_collector, "get_observability", lambda: bag
+    ), patch.object(tm_mod, "get_observability", lambda: bag):
+        yield bag
+
+
+def _isolated_tokenizer_collector_class():
+    """``TokenizerMetricsCollector`` writing into its own registry.
+
+    The suite builds collectors repeatedly in one process, and the default
+    registry rejects the second construction with ``Duplicated timeseries``.
+    """
+    registry = CollectorRegistry()
+    return type(
+        "IsolatedTokenizerMetricsCollector",
+        (TokenizerMetricsCollector,),
+        {
+            "_counter_cls": partial(Counter, registry=registry),
+            "_gauge_cls": partial(Gauge, registry=registry),
+            "_histogram_cls": partial(Histogram, registry=registry),
+        },
+    )
+
+
+def _isolated_collector(role, default):
+    return _isolated_tokenizer_collector_class()
+
+
+def _labelnames(collector):
+    """Every declared label set the collector holds, by attribute name."""
+    return {
+        name: metric._labelnames
+        for name, metric in vars(collector).items()
+        if hasattr(metric, "_labelnames")
+    }
+
+
+@contextlib.contextmanager
+def _tokenizer_manager_startup(denylist):
+    """``init_metric_collector_watchdog`` over the runtime context it reads."""
+    tm = tm_mod.TokenizerManager.__new__(tm_mod.TokenizerManager)
+    tm.enable_metrics = True
+    tm.enable_priority_scheduling = True
+    tm.server_args = SimpleNamespace()
+    with _published_observability(denylist), patch.object(
+        tm_mod, "get_serving", _serving
+    ), patch.object(tm_mod, "get_disagg", _disagg), patch.object(
+        tm_mod, "resolve_collector_class", _isolated_collector
+    ), patch.object(tm_mod, "start_cpu_monitor_thread"), patch.object(
+        tm_mod, "get_device", _device
+    ), patch.object(
+        tm_mod, "Watchdog", SimpleNamespace(create=lambda **kw: None)
+    ), patch.object(
+        # Upstream builds the labels in metrics_collector.tokenizer_metric_labels,
+        # which reads the runtime context there.
+        metrics_collector,
+        "get_serving",
+        _serving,
+    ), patch.object(
+        metrics_collector, "get_disagg", _disagg
+    ), patch.object(
+        metrics_collector,
+        "get_schedule",
+        lambda: SimpleNamespace(enable_priority_scheduling=True),
+    ):
+        tm.init_metric_collector_watchdog()
+    yield tm.metrics_collector
+
+
+@contextlib.contextmanager
+def _scheduler_startup(denylist, bag=None, priority_scheduling=True):
+    """``SchedulerMetricsCollector.init_new`` with its collector captured."""
+    captured = {}
+    # Upstream's init_new reads the ranks off get_parallel(), not arguments.
+    parallel = SimpleNamespace(
+        attn_tp_rank=0,
+        pp_rank=0,
+        attn_cp_rank=0,
+        moe_ep_rank=0,
+        tp_rank=0,
+        dp_rank=None,
+    )
+    with _published_observability(denylist, bag), patch.object(
+        metrics_collector, "get_serving", _serving
+    ), patch.object(metrics_collector, "get_disagg", _disagg), patch.object(
+        metrics_collector, "get_parallel", lambda: parallel
+    ), patch.object(
+        metrics_collector,
+        "resolve_collector_class",
+        _capturing_collector_factory(captured),
+    ):
+        ctx = SchedulerMetricsCollector.init_new(
+            server_args=SimpleNamespace(),
+            enable_priority_scheduling=priority_scheduling,
+            enable_lora=False,
+            enable_hierarchical_cache=False,
+        )
+    yield ctx, captured
+
+
+class _RecordingGauge:
+    """A gauge that records every label set handed to ``.labels()``."""
+
+    def __init__(self):
+        self.series = []
+
+    def labels(self, **kwargs):
+        self.series.append(dict(kwargs))
+        return SimpleNamespace(set=lambda value: None)
+
+
+# ---------------------------------------------------------------------------
+# The flag
+# ---------------------------------------------------------------------------
+
+
+def test_the_flag_parses_into_a_list_of_names():
+    args = prepare_server_args(
+        ["--model-path", "dummy", "--metric-label-denylist", "priority", "model_name"]
+    )
+
+    assert args.metric_label_denylist == ["priority", "model_name"]
+
+
+def test_the_flag_is_absent_by_default():
+    assert prepare_server_args(["--model-path", "dummy"]).metric_label_denylist is None
+
+
+def test_the_flag_requires_at_least_one_name():
+    # nargs='+', not a boolean toggle: an operator who types the flag with no
+    # names has not asked for "drop everything", and must not get that.
+    with pytest.raises(SystemExit):
+        prepare_server_args(["--model-path", "dummy", "--metric-label-denylist"])
+
+
+# ---------------------------------------------------------------------------
+# The helper
+# ---------------------------------------------------------------------------
+
+
+def test_denylist_drops_only_the_named_labels():
+    labels = {"model_name": MODEL_NAME, "engine_type": "unified", "priority": ""}
+
+    with _published_observability(DENIED):
+        kept = apply_metric_label_denylist(labels)
+
+    assert kept == {"model_name": MODEL_NAME, "engine_type": "unified"}
+    assert labels == {
+        "model_name": MODEL_NAME,
+        "engine_type": "unified",
+        "priority": "",
+    }
+    assert kept is not labels
+
+
+@pytest.mark.parametrize("denylist", [None, []])
+def test_unset_or_empty_denylist_changes_nothing(denylist):
+    labels = {"model_name": MODEL_NAME, "priority": ""}
+
+    with _published_observability(denylist):
+        assert apply_metric_label_denylist(labels) is labels
+
+
+def test_a_denied_name_the_labels_do_not_carry_is_ignored():
+    with _published_observability(["lora", "priority"]):
+        kept = apply_metric_label_denylist({"model_name": MODEL_NAME})
+
+    assert kept == {"model_name": MODEL_NAME}
+
+
+# ---------------------------------------------------------------------------
+# The tokenizer collector
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("denylist,present", [(DENIED, False), (None, True)])
+def test_tokenizer_collector_declares_no_denied_label(denylist, present):
+    labels = {"model_name": MODEL_NAME, "engine_type": "unified", "priority": ""}
+
+    with _published_observability(denylist):
+        collector = _isolated_tokenizer_collector_class()(
+            labels=apply_metric_label_denylist(labels)
+        )
+
+    assert ("priority" in collector.labels) is present
+    declared = _labelnames(collector)
+    assert declared, "the collector must hold labelled metrics to mean anything"
+    for name, labelnames in declared.items():
+        assert ("priority" in labelnames) is present, name
+
+
+@pytest.mark.parametrize("denylist,present", [(DENIED, False), (None, True)])
+def test_tokenizer_manager_init_watchdog_passes_the_denylist_through(denylist, present):
+    with _tokenizer_manager_startup(denylist) as collector:
+        pass
+
+    assert ("priority" in collector.labels) is present
+    for name, labelnames in _labelnames(collector).items():
+        assert ("priority" in labelnames) is present, name
+
+
+# ---------------------------------------------------------------------------
+# The scheduler collector
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("denylist,present", [(DENIED, False), (None, True)])
+def test_scheduler_labels_drop_a_denied_priority(denylist, present):
+    with _scheduler_startup(denylist) as (ctx, captured):
+        pass
+
+    assert ctx.collector is not None
+    labels = captured["labels"]
+    assert labels["model_name"] == MODEL_NAME
+    assert ("priority" in labels) is present
+    assert captured["enable_lora"] is False
+
+
+def test_scheduler_labels_drop_a_denied_extra_metric_label():
+    bag = _obs(["region"])
+    bag.extra_metric_labels = {"region": "eu", "tenant": "acme"}
+
+    with _scheduler_startup(None, bag=bag, priority_scheduling=False) as (_, captured):
+        pass
+
+    # --metric-label-denylist applies to labels merged from the CLI flag and
+    # from --extra-metric-labels alike: both are in the dict the collector is
+    # built from.
+    assert captured["labels"]["tenant"] == "acme"
+    assert "region" not in captured["labels"]
+
+
+@pytest.mark.parametrize("denylist,present", [(DENIED, False), (None, True)])
+def test_queue_count_never_labels_a_gauge_with_a_denied_priority(denylist, present):
+    # An unbound call with a stub owner: the method only reads `labels` and
+    # `_known_priorities`, and the stub keeps this to the code under test.
+    owner = SimpleNamespace(labels={"model_name": MODEL_NAME}, _known_priorities=set())
+    gauge = _RecordingGauge()
+
+    with _published_observability(denylist):
+        SchedulerMetricsCollector._log_gauge_queue_count(
+            owner, gauge, QueueCount(total=5, by_priority={0: 3, 1: 2})
+        )
+
+    assert gauge.series[0] == {"model_name": MODEL_NAME}  # the total
+    breakdown = [series for series in gauge.series if "priority" in series]
+    assert bool(breakdown) is present
+    if not present:
+        # A breakdown that cannot name a priority would repeat the total, not
+        # break anything down.
+        assert gauge.series == [{"model_name": MODEL_NAME}]
+
+
+def test_prometheus_rejects_a_label_the_metric_was_not_built_with():
+    # Why the per-priority path above had to be covered: this is the ValueError
+    # an unfiltered call-time label would raise at emission.
+    gauge = Gauge(
+        "sglang:test_denylist_queue_reqs",
+        "doc",
+        labelnames=["model_name"],
+        registry=CollectorRegistry(),
+        multiprocess_mode="mostrecent",
+    )
+
+    with pytest.raises(ValueError):
+        gauge.labels(model_name=MODEL_NAME, priority="1")
+
+
+# ---------------------------------------------------------------------------
+# The tokenizer's per-request labels
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("denylist,present", [(DENIED, False), (None, True)])
+def test_request_labels_drop_a_denied_priority(denylist, present):
+    tm = tm_mod.TokenizerManager.__new__(tm_mod.TokenizerManager)
+    tm.metrics_collector = SimpleNamespace(
+        labels={"model_name": MODEL_NAME, "engine_type": "unified", "priority": ""}
+    )
+    tm.enable_priority_scheduling = True
+    state = SimpleNamespace(
+        obj=SimpleNamespace(custom_labels={"priority": "3"}, priority=7)
+    )
+
+    with _published_observability(denylist):
+        labels = tm._metric_labels_for_request(state)
+
+    assert labels["model_name"] == MODEL_NAME
+    assert ("priority" in labels) is present
+    if present:
+        # The request's own priority wins over the collector default, exactly
+        # as it did before the denylist existed.
+        assert labels["priority"] == "7"
diff --git a/test/srt/sbr/test_g_kv_events_config_forbid.py b/test/srt/sbr/test_g_kv_events_config_forbid.py
