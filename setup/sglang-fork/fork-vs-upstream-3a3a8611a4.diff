diff --git a/python/sglang/srt/function_call/sbr_tool_strict.py b/python/sglang/srt/function_call/sbr_tool_strict.py
new file mode 100644
index 0000000000..982eb17cfa
--- /dev/null
+++ b/python/sglang/srt/function_call/sbr_tool_strict.py
@@ -0,0 +1,73 @@
+"""A runtime gate for ``SGLANG_TOOL_STRICT_LEVEL`` (part 0044b).
+
+``FunctionCallParser`` reads the tool strict level when it is built, once per
+request (and per streamed choice). Upstream that is ``SGLANG_TOOL_STRICT_LEVEL``
+itself; this module puts a gate file in front of it::
+
+    effective_tool_strict_level() = SGLANG_TOOL_STRICT_LEVEL   while the gate is open
+                                    ToolStrictLevel.OFF        while it is closed
+
+The gate is ``SGLANG_SBR_TOOL_STRICT_GATE_FILE`` (``environ.py``, read once at
+import) under 0039's rule (``sbr_phase_timing.RecheckedPathGate``): no path is
+always open, so with the variable unset nothing changes; a set path is open while
+it exists, looked up at most once a second per process. That lets a deployment
+raise the strict level (a grammar-constrained tool call) for a measurement window
+and drop it again without a restart. A request keeps the level its parser was
+built with; only parsers built after a flip see the new one.
+
+With a gate path set, one INFO line is logged per flip (and one for the first
+evaluation, so the starting state is on record)::
+
+    sbr-tool-strict level=<n> gate=<open|closed>
+
+``level`` is the effective level from then on: the env level while open, ``0``
+(OFF) while closed. No path set logs nothing.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from typing import Optional
+
+from sglang.srt.environ import ToolStrictLevel, envs
+from sglang.srt.observability.sbr_phase_timing import RecheckedPathGate
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "sbr-tool-strict"
+
+# Read once at import, like the other SGLANG_SBR_*_GATE_FILE gates.
+GATE = RecheckedPathGate(envs.SGLANG_SBR_TOOL_STRICT_GATE_FILE.get())
+
+_lock = threading.Lock()
+# The gate state the last flip line reported (``None``: nothing reported yet).
+_logged_open: Optional[bool] = None
+
+
+def effective_tool_strict_level() -> int:
+    """``SGLANG_TOOL_STRICT_LEVEL`` while ``GATE`` is open, else ``ToolStrictLevel.OFF``."""
+    global _logged_open
+    level = envs.SGLANG_TOOL_STRICT_LEVEL.get()
+    if not GATE.path:
+        return level
+    is_open = GATE.is_open()
+    effective = level if is_open else ToolStrictLevel.OFF
+    if is_open is not _logged_open:
+        with _lock:
+            if is_open is not _logged_open:
+                _logged_open = is_open
+                logger.info(
+                    "%s level=%d gate=%s",
+                    LOG_PREFIX,
+                    int(effective),
+                    "open" if is_open else "closed",
+                )
+    return effective
+
+
+def reset() -> None:
+    """Forget the last reported state (tests)."""
+    global _logged_open
+    with _lock:
+        _logged_open = None
