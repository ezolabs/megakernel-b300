+    real = short_prefill.match_kv_cache
+
+    def counting(req, tree, *args, **kwargs):
+        scanned.append(req.rid)
+        return real(req, tree, *args, **kwargs)
+
+    with mock.patch.object(short_prefill, "match_kv_cache", counting):
+        p = _pass(cache, queue)
+    assert scanned == ["cold-a", "cold-b", "warm-1"]
+    assert p.admitted == ["warm-1", "warm-2"]
+
+
+def test_a_memory_refusal_still_ends_the_pass(cache):
+    # More cold tokens than the KV pool holds: NO_TOKEN, not a truncation
+    # refusal. The pass ends there, as it always has.
+    huge, warm = _cold("huge", 1.0, length=KV_SIZE + 1), _warm("warm", 2.0)
+    p = _pass(cache, [huge, warm])
