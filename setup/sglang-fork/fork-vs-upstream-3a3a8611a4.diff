+def _detokenizer() -> DetokenizerManager:
+    manager = DetokenizerManager.__new__(DetokenizerManager)
+    manager.decode_status = LimitedCapacityDict(capacity=1000)
+    manager.tokenizer = _FakeTokenizer()
+    manager.vocab_size = 1000
+    manager.disable_tokenizer_batch_decode = False
+    manager.is_tool_call_parser_gpt_oss = False
+    return manager
