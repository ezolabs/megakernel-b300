+def test_the_real_scheduler_init_arms_the_gate_of_the_cache_it_built(
+    monkeypatch, caplog
+):
+    """The real ``Scheduler.__init__``, in its real order: every component
+    method it calls is stubbed (no model, no GPU, no sockets), except
+    ``init_request_receiver``, which runs for real and arms the gate. The KV
+    cache builder returns a HiCache stand-in carrying a real gate."""
+    import ast
+    import inspect
+    import logging
+    import textwrap
+
+    from sglang.srt.managers import scheduler as scheduler_mod
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate
+
+    Scheduler = scheduler_mod.Scheduler
+    init_tree = ast.parse(textwrap.dedent(inspect.getsource(Scheduler.__init__)))
+    called = {
+        node.func.attr
+        for node in ast.walk(init_tree)
+        if isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Attribute)
+        and isinstance(node.func.value, ast.Name)
+        and node.func.value.id == "self"
+    }
+    assert {"init_model_worker", "init_request_receiver"} <= called
+    order = []
+
+    def stub(name):
+        def method(self, *args, **kwargs):
+            order.append(name)
+
+        return method
+
+    for name in called - {"init_request_receiver"}:
+        monkeypatch.setattr(Scheduler, name, stub(name))
+    real_init_request_receiver = Scheduler.init_request_receiver
+
+    def init_request_receiver(self):
+        order.append("init_request_receiver")
+        real_init_request_receiver(self)
+
+    monkeypatch.setattr(Scheduler, "init_request_receiver", init_request_receiver)
+
+    gate = HiCachePollGate(lambda: False, heartbeat_calls=64)
+    cache = SimpleNamespace(hicache_poll_gate=gate, linker=None, cache_controller=None)
+
+    def build_kv_cache(**kwargs):
+        order.append("build_kv_cache")
+        assert kwargs["enable_hierarchical_cache"] is True
+        return SimpleNamespace(
+            is_hybrid_swa=False,
+            is_hybrid_ssm=False,
+            sliding_window_size=None,
+            full_tokens_per_layer=0,
+            swa_tokens_per_layer=0,
+            req_to_token_pool=None,
+            token_to_kv_pool_allocator=None,
+            disable_radix_cache=False,
+            tree_cache=cache,
+        )
+
+    monkeypatch.setattr(
+        scheduler_mod.kv_cache_builder, "build_kv_cache", build_kv_cache
+    )
+    monkeypatch.setattr(scheduler_mod, "maybe_revert_pr_fix", lambda: None)
+    # Upstream's __init__ builds the parallel and layer runtimes itself.
+    monkeypatch.setattr(
+        scheduler_mod,
+        "bootstrap",
+        SimpleNamespace(
+            init_parallel_runtime=lambda **kw: order.append("init_parallel_runtime"),
+            init_layer_runtime=lambda **kw: None,
+        ),
+    )
+    monkeypatch.setattr(
+        scheduler_mod, "get_device", lambda: SimpleNamespace(device="cpu")
+    )
+    monkeypatch.setattr(scheduler_mod, "page_interleave_shard_size", lambda a: 1)
+    monkeypatch.setattr(scheduler_mod, "use_mlx", lambda: False)
+    # box-c's shape: TP 8, PP 1, no DP attention, HiCache on, no linker.
+    contexts = {
+        "get_schedule": SimpleNamespace(
+            schedule_policy="fcfs",
+            enable_priority_scheduling=False,
+            abort_on_priority_when_disabled=False,
+            schedule_low_priority_values_first=False,
+            priority_scheduling_preemption_threshold=10,
+            disable_overlap_schedule=False,
+            page_size=256,
+        ),
+        "get_lora": SimpleNamespace(
+            enable_lora=False, enable_lora_overlap_loading=False, max_loras_per_batch=8
+        ),
+        "get_disagg": SimpleNamespace(
+            enable_pdmux=False,
+            disaggregation_mode="null",
+            disaggregation_decode_enable_radix_cache=False,
+            disaggregation_decode_enable_offload_kvcache=False,
+        ),
+        "get_serving": SimpleNamespace(skip_tokenizer_init=False, stream_interval=1),
+        "get_spec": SimpleNamespace(speculative_algorithm=None),
+        "get_memory": SimpleNamespace(
+            enable_hierarchical_cache=True,
+            enable_session_radix_cache=False,
+            hicache_storage_backend=None,
+            enable_unified_cache_external_linker=False,
+            enable_hisparse=False,
+            enable_unified_memory=False,
+            enable_lmcache=False,
+        ),
+        "get_parallel": SimpleNamespace(
+            enable_dp_attention=False,
+            attn_dp_enabled=False,
+            pp_rank=0,
+            attn_tp_rank=0,
+            attn_cp_rank=0,
+            tp_size=8,
+            pp_size=1,
+            dp_size=1,
+            attn_cp_size=1,
+            dcp_size=1,
+            ep_size=1,
+            moe_dp_size=1,
+        ),
+        "get_observability": SimpleNamespace(
+            enable_metrics=False, kv_events_config=None
+        ),
+    }
+    for getter, value in contexts.items():
+        monkeypatch.setattr(scheduler_mod, getter, lambda value=value: value)
+    monkeypatch.setenv("SGLANG_HICACHE_POLL_ON_HINT", "1")
+
+    # What the stubbed component methods would have set. Not tree_cache: only
+    # __init__'s own code may set that.
+    sched = object.__new__(Scheduler)
+    placeholders = dict(
+        model_config=SimpleNamespace(is_multimodal=False),
+        tp_worker=SimpleNamespace(
+            model_runner=SimpleNamespace(forward_stream=None, canary_manager=None)
+        ),
+        draft_worker=None,
+        tp_group=SimpleNamespace(rank=0, ranks=list(range(8))),
+        tp_cpu_group=object(),
+        attn_tp_group=None,
+        attn_tp_cpu_group=None,
+        attn_cp_group=None,
+        attn_cp_cpu_group=None,
+        pp_group=None,
+        world_group=None,
+        metrics_reporter=SimpleNamespace(scheduler_stage_metrics=None),
+        scheduler_stage_metrics=None,  # __init__ sets it inline, later
+        recv_from_tokenizer=None,
+        ipc_channels=SimpleNamespace(recv_from_rpc=None),
+        recv_skipper=None,
+        input_blocker=None,
+        mm_receiver=None,
+        scripted_scheduler_hook=None,
+        last_batch=None,
+        kv_event_lora_names=None,  # init_kv_event_lora_names (stubbed) sets it
+    )
+    assert "tree_cache" not in placeholders
+    sched.__dict__.update(placeholders)
+
+    caplog.set_level(logging.INFO, logger=scheduler_mod.logger.name)
+    with caplog.at_level(logging.INFO):
+        Scheduler.__init__(
+            sched,
+            server_args=SimpleNamespace(),
+            port_args=SimpleNamespace(nccl_port=0),
+        )
+
+    assert sched.is_initializing is False  # the whole __init__ ran
+    assert order.index("build_kv_cache") < order.index("init_request_receiver")
+    assert order.index("init_model_worker") < order.index("build_kv_cache")
+    assert sched.tree_cache is cache
+    assert sched.request_receiver.hicache_poll_gate is gate
+    assert gate.armed
+    assert any(
+        "HiCache event poll: reduce across TP only" in r.getMessage()
+        for r in caplog.records
+    )
+
+    # Nothing in the Scheduler's classes assigns self.tree_cache anywhere else,
+    # so the gate the receiver holds stays the cache's gate.
+    assignments = []
+    for cls in Scheduler.__mro__:
+        if not cls.__module__.startswith("sglang."):
+            continue
+        for node in ast.walk(ast.parse(textwrap.dedent(inspect.getsource(cls)))):
+            targets = (
+                node.targets
+                if isinstance(node, ast.Assign)
+                else [node.target]
+                if isinstance(node, (ast.AnnAssign, ast.AugAssign))
+                else []
+            )
+            for t in targets:
+                if (
+                    isinstance(t, ast.Attribute)
+                    and t.attr == "tree_cache"
+                    and isinstance(t.value, ast.Name)
+                    and t.value.id == "self"
+                ):
+                    assignments.append(cls.__name__)
+    assert assignments == ["Scheduler"]
+
