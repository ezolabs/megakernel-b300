diff --git a/test/registered/unit/constrained/test_log_redaction.py b/test/registered/unit/constrained/test_log_redaction.py
new file mode 100644
index 0000000000..c4a22176fc
--- /dev/null
+++ b/test/registered/unit/constrained/test_log_redaction.py
@@ -0,0 +1,180 @@
+"""
+Unit tests for content-free error logging on the grammar paths.
+
+Server logs must never carry request content (response schemas, grammars,
+token ids, output text).  These tests pin that for the xgrammar
+``accept_token`` failure path, which once logged a customer's response
+schema and output token ids, and for the ``redact`` helpers it uses.
+
+Usage:
+    python -m pytest test_log_redaction.py -v
+"""
+
+import hashlib
+import json
+import logging
+import unittest
+from types import SimpleNamespace
+
+from sglang.srt.utils.log_redact import DIGEST_HEX_CHARS, redact, redact_exc
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(2.0, "base-a-test-cpu")
+
+SECRET_FIELD = "customer_secret_field_xyz"
+SCHEMA = json.dumps(
+    {
+        "type": "object",
+        "properties": {SECRET_FIELD: {"type": "integer"}},
+        "required": [SECRET_FIELD],
+        "additionalProperties": False,
+    }
+)
+
+
+def _sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()[:DIGEST_HEX_CHARS]
+
+
+class TestRedact(unittest.TestCase):
+    def test_str_is_length_and_digest(self):
+        out = redact(SCHEMA)
+        self.assertEqual(
+            out, f"<str len={len(SCHEMA)} sha256={_sha(SCHEMA.encode())}>"
+        )
+        self.assertNotIn(SECRET_FIELD, out)
+
+    def test_same_input_same_digest_different_input_different_digest(self):
+        self.assertEqual(redact("abc"), redact("abc"))
+        self.assertNotEqual(redact("abc"), redact("abd"))
+
+    def test_token_ids_are_count_and_digest(self):
+        ids = [40213, 99117, 5]
+        out = redact(ids)
+        self.assertEqual(out, f"<ids n=3 sha256={_sha(b'40213,99117,5')}>")
+        self.assertEqual(redact(tuple(ids)), out)
+        for i in ids[:2]:
+            self.assertNotIn(str(i), out.split("sha256=")[0])
+
+    def test_single_token_id(self):
+        out = redact(40213)
+        self.assertEqual(out, f"<id sha256={_sha(b'40213')}>")
+
+    def test_none_bytes_and_structures(self):
+        self.assertEqual(redact(None), "None")
+        raw = b"\x00\x01"
+        self.assertEqual(redact(raw), f"<bytes len=2 sha256={_sha(raw)}>")
+        out = redact({"name": SECRET_FIELD, "n": 1})
+        self.assertTrue(out.startswith("<dict len="), out)
+        self.assertNotIn(SECRET_FIELD, out)
+        # key order does not change the digest
+        self.assertEqual(out, redact({"n": 1, "name": SECRET_FIELD}))
+        self.assertNotIn(SECRET_FIELD, redact([SECRET_FIELD, 1]))
+
+    def test_unserializable_value_falls_back_to_repr(self):
+        class Opaque:
+            def __repr__(self):
+                return SECRET_FIELD
+
+        out = redact(Opaque())
+        self.assertTrue(out.startswith("<Opaque len="), out)
+        self.assertNotIn(SECRET_FIELD, out)
+
+    def test_redact_exc_keeps_type_drops_message(self):
+        out = redact_exc(ValueError(f"bad schema near {SECRET_FIELD}"))
+        self.assertTrue(out.startswith("ValueError(<str len="), out)
+        self.assertNotIn(SECRET_FIELD, out)
+
+
+class TestXGrammarAcceptTokenFailure(unittest.TestCase):
+    """A token the grammar rejects must log no schema text and no token ids."""
+
+    @classmethod
+    def setUpClass(cls):
+        import xgrammar as xgr
+
+        # Byte-level toy vocab: id i is chr(i) for printable ASCII, plus EOS.
+        cls.vocab = [chr(i) if 32 <= i < 127 else f"<unused_{i}>" for i in range(128)]
+        cls.eos_id = len(cls.vocab)
+        cls.vocab.append("</s>")
+        info = xgr.TokenizerInfo(cls.vocab, stop_token_ids=[cls.eos_id])
+        cls.compiled = xgr.GrammarCompiler(info).compile_json_schema(SCHEMA)
+
+    def _grammar(self):
+        import xgrammar as xgr
+
+        from sglang.srt.constrained.xgrammar_backend import XGrammarGrammar
+
+        return XGrammarGrammar(
+            matcher=xgr.GrammarMatcher(self.compiled),
+            vocab_size=len(self.vocab),
+            ctx=self.compiled,
+            override_stop_tokens=None,
+            key_string=SCHEMA,
+        )
+
+    def _assert_content_free(self, text, accepted_ids, bad_id):
+        self.assertNotIn(SCHEMA, text)
+        self.assertNotIn(SECRET_FIELD, text)
+        self.assertNotIn('"type"', text)
+        self.assertNotIn(str(accepted_ids), text)
+        # Token ids may only appear inside a hex digest, never as a value.
+        visible = text
+        for part in text.split("sha256=")[1:]:
+            visible = visible.replace(part[:DIGEST_HEX_CHARS], "")
+        self.assertNotIn(str(bad_id), visible)
+        self.assertNotIn(str(accepted_ids[-1]), visible)
+
+    def test_accept_token_error_is_content_free(self):
+        grammar = self._grammar()
+        accepted = [ord("{"), ord('"')]
+        for t in accepted:
+            grammar.accept_token(t)
+        bad = ord("}")  # an object with a required field cannot close here
+        with self.assertRaises(ValueError) as cm:
+            grammar.accept_token(bad)
+        msg = str(cm.exception)
+        self.assertEqual(
+            msg,
+            "Token not accepted at position 2 (accepted_tokens=2, "
+            f"key_string={redact(SCHEMA)})",
+        )
+        self._assert_content_free(msg, accepted, bad)
+        self._assert_content_free(repr(grammar), accepted, bad)
+
+    def test_prefill_caller_log_and_abort_are_content_free(self):
+        from sglang.srt.managers.scheduler_components.batch_result_processor import (
+            SchedulerBatchResultProcessor,
+        )
+
+        grammar = self._grammar()
+        accepted = [ord("{"), ord('"')]
+        for t in accepted:
+            grammar.accept_token(t)
+        bad = ord("}")
+        req = SimpleNamespace(
+            rid="req-1",
+            grammar=grammar,
+            output_ids=[bad],
+            to_finish=None,
+            finished=lambda: False,
+        )
+        logger_name = (
+            "sglang.srt.managers.scheduler_components.batch_result_processor"
+        )
+        with self.assertLogs(logger_name, level=logging.ERROR) as logs:
+            SchedulerBatchResultProcessor._apply_prefill_grammar(
+                None, req=req, next_token_id=bad
+            )
+        self.assertEqual(len(logs.records), 1)
+        record = logs.records[0].getMessage()
+        self.assertIn("Grammar accept_token failed for req req-1", record)
+        self.assertIn("accepted_tokens=2", record)
+        self.assertIn(f"sha256={_sha(SCHEMA.encode())}", record)
+        self._assert_content_free(record, accepted, bad)
+        self.assertIsNotNone(req.to_finish)
+        self._assert_content_free(str(req.to_finish.message), accepted, bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
