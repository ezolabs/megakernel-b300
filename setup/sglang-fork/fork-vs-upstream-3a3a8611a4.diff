index 0000000000..2617cf20f5
--- /dev/null
+++ b/test/srt/sbr/test_0041b_unified_offset_walk.py
@@ -0,0 +1,268 @@
+"""Part 0041b: ``UnifiedRadixCache``'s insert walks the key by offset.
+
+With ``SGLANG_SBR_UNFINISHED_REUSE`` on (and its gate open), the insert inside
+``checkpoint_into_tree`` (upstream's name for ``cache_unfinished_req``) runs
+through ``_sbr_insert_by_offset``: ``UnifiedTreeCore._sbr_insert_walk_step_by_offset``
+reads the key with ``match_at`` / ``child_key_at`` at the walk's absolute offset
+instead of slicing it at every node. It must leave the cache exactly as the
+original walk does.
+
+box-d-up port: box-c-orig's test drove a stand-in scheduler (``cache_unfinished_req``,
+``prefix_indices``, ``swa_uuid_for_lock``, ``dec_swa_lock_only``) that upstream no
+longer has. This one drives the cache's own ``insert`` in two worlds built alike on
+box-c's shape (FULL + SWA, Python TreeCore), one through the offset walk and one
+through the original, with random shared-prefix keys, partial matches, splits,
+duplicate frees below ``prev_prefix_len`` that straddle the SWA eviction floor
+(b417471771's case, here deterministic), evictions and un-evicts, at page 1 and 4.
+After every insert the two worlds must agree on the tree (keys, FULL and SWA values,
+locks, hit counts), the InsertResult, the allocator's free sizes and the KV events.
+"""
+
+from __future__ import annotations
+
+import random
+from array import array
+
+import pytest
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.mem_cache import sbr_unfinished_reuse
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import EvictParams, InsertParams
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import UnifiedTreeCore
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+
+KV_SIZE = 8192
+NUM_LAYERS = 4
+FULL_LAYERS = (1, 3)
+WINDOW = 8
+
+
+def _cache(page_size: int) -> UnifiedRadixCache:
+    set_global_server_args_for_scheduler(
+        ServerArgs(model_path="dummy", page_size=page_size)
+    )
+    swa_layers = [i for i in range(NUM_LAYERS) if i not in FULL_LAYERS]
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=page_size,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=swa_layers,
+        full_attention_layer_ids=list(FULL_LAYERS),
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=page_size,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=page_size,
+        disable=False,
+        sliding_window_size=WINDOW,
+        tree_components=(ComponentType.FULL, ComponentType.SWA),
+    )
+    return UnifiedRadixCache(params=params)
+
+
+def _value(data) -> object:
+    if data is None or data.value is None:
+        return None
+    value = data.value
+    return tuple(int(x) for x in (value.tolist() if hasattr(value, "tolist") else value))
+
+
+def _alloc(alloc, n: int, page_size: int) -> torch.Tensor:
+    """n fresh slots, page-aligned on a paged pool, as an extend allocates them."""
+    if page_size == 1:
+        return alloc.alloc(n)
+    zero, size = torch.tensor([0]), torch.tensor([n])
+    return alloc.alloc_extend(zero, zero, size, size, torch.tensor([-1]), n)
+
+
+def _dump(cache: UnifiedRadixCache) -> list:
+    """Every node, parent before children, children in key order."""
+    out = []
+    stack = [(cache.tree_core.root_node, 0)]
+    while stack:
+        node, depth = stack.pop()
+        full = node.component_data[ComponentType.FULL]
+        swa = node.component_data[ComponentType.SWA]
+        out.append(
+            (
+                depth,
+                tuple(node.key.token_ids) if node.key is not None else (),
+                _value(full),
+                _value(swa),
+                getattr(full, "lock_ref", None),
+                getattr(swa, "lock_ref", None),
+                node.hit_count,
+                node.priority,
+            )
+        )
+        children = sorted(
+            node.children.values(), key=lambda c: tuple(c.key.token_ids)
+        )
+        stack.extend((c, depth + 1) for c in reversed(children))
+    return out
+
+
+def _result(result) -> tuple:
+    return (
+        result.prefix_len,
+        result.total_len,
+        result.swa_branch_inserted,
+        result.rotation_tail_declined,
+    )
+
+
+class _World:
+    def __init__(self, page_size: int, offset_walk: bool):
+        self.cache = _cache(page_size)
+        self.page_size = page_size
+        self.offset_walk = offset_walk
+
+    def insert(self, tokens, prev_prefix_len=0, swa_floor=0, priority=0):
+        alloc = self.cache.token_to_kv_pool_allocator
+        value = _alloc(alloc, len(tokens), self.page_size)
+        assert value is not None
+        params = InsertParams(
+            key=RadixKey(array("q", tokens)),
+            value=value,
+            prev_prefix_len=prev_prefix_len,
+            priority=priority,
+        )
+        if swa_floor:
+            params.set_evicted_seqlen(ComponentType.SWA, swa_floor)
+        if self.offset_walk:
+            return self.cache._sbr_insert_by_offset(params)
+        return self.cache.insert(params)
+
+    def evict(self, n):
+        self.cache.evict(EvictParams(num_tokens=n, swa_num_tokens=n))
+
+    def state(self):
+        alloc = self.cache.token_to_kv_pool_allocator
+        return (
+            _dump(self.cache),
+            alloc.full_available_size(),
+            alloc.swa_available_size(),
+        )
+
+
+def _aligned(n: int, page_size: int) -> int:
+    return n - n % page_size
+
+
+def _run(seed: int, page_size: int, steps: int = 60):
+    rng = random.Random(seed)
+    plain, offset = _World(page_size, False), _World(page_size, True)
+    stems = [[rng.randrange(1, 50) for _ in range(rng.randrange(8, 48))] for _ in range(4)]
+    for step in range(steps):
+        stem = rng.choice(stems)
+        cut = _aligned(rng.randrange(0, len(stem) + 1), page_size)
+        tail = [rng.randrange(1, 50) for _ in range(rng.randrange(1, 24))]
+        tokens = stem[:cut] + tail
+        tokens = tokens[: _aligned(len(tokens), page_size)]
+        if not tokens:
+            continue
+        prev = _aligned(rng.randrange(0, len(tokens) + 1), page_size)
+        floor = _aligned(rng.randrange(0, prev + 1), page_size) if prev else 0
+        priority = rng.randrange(0, 3)
+        a = plain.insert(tokens, prev, floor, priority)
+        b = offset.insert(tokens, prev, floor, priority)
+        assert _result(a) == _result(b), (seed, step)
+        assert plain.state() == offset.state(), (seed, step)
+        assert plain.cache.take_events() == offset.cache.take_events()
+        if rng.random() < 0.15:
+            n = rng.randrange(1, 64)
+            plain.evict(n)
+            offset.evict(n)
+            assert plain.state() == offset.state(), (seed, step, "evict")
+    return plain, offset
+
+
+@pytest.mark.parametrize("page_size", [1, 4])
+@pytest.mark.parametrize("seed", range(6))
+def test_the_offset_walk_leaves_the_cache_as_the_original_walk(seed, page_size):
+    _run(seed, page_size)
+
+
+@pytest.mark.parametrize("page_size", [1, 4])
+def test_a_duplicate_below_prev_prefix_len_straddling_the_swa_floor(page_size):
+    """b417471771's case, deterministic: the duplicate slice starts below the
+    request's SWA floor (FULL-only free) and ends above it (FULL + SWA free)."""
+    p = page_size
+    plain, offset = _World(p, False), _World(p, True)
+    stem = list(range(1, 1 + 8 * p))
+    for world in (plain, offset):
+        world.insert(stem)
+    a = plain.insert(stem + [99] * p, prev_prefix_len=6 * p, swa_floor=2 * p)
+    b = offset.insert(stem + [99] * p, prev_prefix_len=6 * p, swa_floor=2 * p)
+    assert _result(a) == _result(b)
+    assert plain.state() == offset.state()
+    before = plain.state()[1:]
+    # Control: the free really happened (both pools got slots back).
+    fresh = _World(p, False)
+    fresh.insert(stem)
+    _alloc(fresh.cache.token_to_kv_pool_allocator, len(stem) + p, p)
+    assert before != fresh.state()[1:]
+
+
+def test_the_walk_mode_is_off_outside_the_offset_insert():
+    world = _World(1, True)
+    world.insert(list(range(1, 20)))
+    assert UnifiedTreeCore._sbr_offset_walk is False
+    assert world.cache.tree_core._sbr_offset_walk is False
+
+
+def test_the_control_sees_a_walk_that_diverges(monkeypatch):
+    """Control: an offset walk that forgets to count the node's hit is caught."""
+    real = UnifiedTreeCore._sbr_insert_walk_step_by_offset
+
+    def no_hit_count(self, state):
+        saved = self._inc_hit_count_and_check
+        self._inc_hit_count_and_check = lambda node: False
+        try:
+            return real(self, state)
+        finally:
+            self._inc_hit_count_and_check = saved
+
+    monkeypatch.setattr(
+        UnifiedTreeCore, "_sbr_insert_walk_step_by_offset", no_hit_count
+    )
+    with pytest.raises(AssertionError):
+        for seed in range(6):
+            _run(seed, 1)
+
+
+def test_the_switch_reads_its_env_and_gate(monkeypatch, tmp_path):
+    monkeypatch.setattr(sbr_unfinished_reuse, "ENABLED", False)
+    assert sbr_unfinished_reuse.active() is False
+    monkeypatch.setattr(sbr_unfinished_reuse, "ENABLED", True)
+    gate = tmp_path / "gate"
+    monkeypatch.setattr(
+        sbr_unfinished_reuse,
+        "GATE",
+        type(sbr_unfinished_reuse.GATE)(str(gate)),
+    )
+    assert sbr_unfinished_reuse.active() is False
+    assert envs.SGLANG_SBR_UNFINISHED_REUSE.get() in (True, False)
diff --git a/test/srt/sbr/test_0042_gc_hook_lock_free.py b/test/srt/sbr/test_0042_gc_hook_lock_free.py
new file mode 100644
index 0000000000..23b23fd861
--- /dev/null
+++ b/test/srt/sbr/test_0042_gc_hook_lock_free.py
@@ -0,0 +1,258 @@
+"""Part 0042: the ``gc.callbacks`` hook never touches a metric.
+
+box-c, 2026-10-13 08:13:45-08:31Z: the HTTP server's event-loop thread
+deadlocked itself. In multiprocess mode (``PROMETHEUS_MULTIPROC_DIR``)
+prometheus_client 0.26.0 guards every metric value of the process with ONE
+non-reentrant ``threading.Lock``. The lag monitor (``_watch_loop``) held it
+inside ``loop_lag_seconds.observe``, a collection ran in that frame, and the
+GC hook ``_gc_timer`` observed ``sglang:python_gc_pause_seconds`` -- waiting
+forever on the lock its own thread held. Every other thread that touched a
+metric then queued behind it.
+
+The hook now only appends ``(generation, pause, collected)`` to a bounded
+deque; ``drain_gc_pauses`` (every monitor tick, outside any collection)
+observes and logs. CPU only, no server: the real ``MultiProcessValue`` and its
+real process-wide lock, with every scenario that could hang run on a daemon
+thread joined under a timeout, so the unpatched hook fails instead of hanging.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import gc
+import logging
+import sys
+import threading
+from typing import Callable, List, Optional, Tuple
+
+import pytest
+from prometheus_client import CollectorRegistry, mmap_dict, values
+
+from sglang.srt.entrypoints.openai import preprocess_lanes
+from sglang.srt.environ import envs
+
+WAIT_S = 10  # a deadlocked scenario is declared after this; a green one takes ms
+GC_PAUSE_COUNT = "sglang:python_gc_pause_seconds_count"
+GC_PAUSE_SUM = "sglang:python_gc_pause_seconds_sum"
+
+
+@pytest.fixture(autouse=True)
+def _fresh():
+    """No metrics, no hook, nothing pending, the lag monitor off -- before and after."""
+    with envs.SGLANG_EVENT_LOOP_LAG_INTERVAL_S.override(0):
+        preprocess_lanes.disable_metrics()
+        preprocess_lanes.uninstall_gc_timer()
+        yield
+    preprocess_lanes.disable_metrics()
+    preprocess_lanes.uninstall_gc_timer()
+
+
+def _closure_lock(value_class: type) -> threading.Lock:
+    """The one lock every ``MmapedValue`` of a ``MultiProcessValue()`` shares."""
+    found = []
+    for method in (value_class.inc, value_class.set, value_class.get):
+        names = method.__code__.co_freevars
+        found.append(method.__closure__[names.index("lock")].cell_contents)
+    assert all(lock is found[0] for lock in found)
+    assert type(found[0]) is type(threading.Lock())  # non-reentrant
+    return found[0]
+
+
+@pytest.fixture
+def mp_metrics(tmp_path, monkeypatch):
+    """``enable_metrics`` in prometheus_client's multiprocess mode, as on box-c.
+
+    Yields ``(registry, lock)``; ``lock`` is the process-wide value lock.
+    """
+    monkeypatch.setenv("PROMETHEUS_MULTIPROC_DIR", str(tmp_path))
+    value_class = values.MultiProcessValue()
+    monkeypatch.setattr(values, "ValueClass", value_class)
+    lock = _closure_lock(value_class)
+    registry = CollectorRegistry()
+    metrics = preprocess_lanes.enable_metrics(registry)
+    assert getattr(metrics.loop_lag_seconds._sum, "_multiprocess", False)
+    yield registry, lock
+    preprocess_lanes.disable_metrics()
+    preprocess_lanes.uninstall_gc_timer()
+    # A deadlocked scenario (the unpatched hook) holds the lock forever on its
+    # daemon thread: closing the files would join it.
+    if lock.acquire(timeout=0.5):
+        lock.release()
+        value_class.close_all_files()
+
+
+def _bounded(target: Callable[[], None]) -> Tuple[bool, Optional[BaseException]]:
+    """Run ``target`` on a daemon thread; (finished within WAIT_S, its exception)."""
+    error: List[BaseException] = []
+
+    def run() -> None:
+        try:
+            target()
+        except BaseException as e:  # reported to the test
+            error.append(e)
+
+    thread = threading.Thread(target=run, name="test-0042-scenario", daemon=True)
+    thread.start()
+    thread.join(WAIT_S)
+    return not thread.is_alive(), (error[0] if error else None)
+
+
+def _install_hook() -> None:
+    """Install the hook the way the server does: ``ensure_loop_monitor``."""
+
+    async def start_and_stop() -> None:
+        with envs.SGLANG_EVENT_LOOP_LAG_INTERVAL_S.override(0.05):
+            assert preprocess_lanes.ensure_loop_monitor() is not None
+        preprocess_lanes.stop_loop_monitor()
+
+    asyncio.run(start_and_stop())
+    assert preprocess_lanes._gc_timer in gc.callbacks
+
+
+def _sample(registry, name: str, labels: dict) -> float:
+    value = registry.get_sample_value(name, labels)
+    return 0.0 if value is None else value
+
+
+def _frame_names() -> List[str]:
+    frame, names = sys._getframe(1), []
+    while frame is not None:
+        names.append(frame.f_code.co_name)
+        frame = frame.f_back
+    return names
+
+
+# --------------------------------------------------------------------------
+# The incident, and the lock held by any frame of the collecting thread
+# --------------------------------------------------------------------------
+
+
+def test_a_collection_inside_the_lag_monitors_observe_does_not_deadlock(
+    mp_metrics, monkeypatch
+):
+    """08:13:45Z exactly: ``_watch_loop`` -> ``observe`` -> (lock held) -> GC."""
+    registry, lock = mp_metrics
+    real_write = mmap_dict.MmapedDict.write_value
+    injected: List[Tuple[bool, List[str]]] = []
+    collected = threading.Event()
+
+    def write_value(self, key, value, timestamp):
+        # Inside ``MmapedValue.inc``'s ``with lock``: let a collection run here,
+        # once, in the lag histogram's own write.
+        if not injected and '"sglang:event_loop_lag_seconds"' in key:
+            injected.append((lock.locked(), _frame_names()))
+            gc.collect()
+            collected.set()
+        return real_write(self, key, value, timestamp)
+
+    monkeypatch.setattr(mmap_dict.MmapedDict, "write_value", write_value)
+
+    async def serve() -> None:
+        with (
+            envs.SGLANG_EVENT_LOOP_LAG_INTERVAL_S.override(0.01),
+            envs.SGLANG_EVENT_LOOP_LAG_WARN_S.override(60),
+        ):
+            assert preprocess_lanes.ensure_loop_monitor() is not None
+        try:
+            while not collected.is_set():
+                await asyncio.sleep(0.005)
+            await asyncio.sleep(0.05)  # more ticks after the collection
+        finally:
+            preprocess_lanes.stop_loop_monitor()
+
+    finished, error = _bounded(lambda: asyncio.run(serve()))
+    assert finished, (
+        "the event loop deadlocked: the GC hook waited on the multiprocess "
+        "metric lock its own thread held"
+    )
+    assert error is None, error
+    ((held, frames),) = injected
+    assert held, "the collection did not run under the multiprocess lock"
+    assert "_watch_loop" in frames and "observe" in frames
+    # The pause was still exported -- by the monitor's tick, after the GC.
+    assert _sample(registry, GC_PAUSE_COUNT, {"generation": "2"}) >= 1
+    assert _sample(registry, "sglang:event_loop_lag_seconds_count", {}) >= 2
+
+
+def test_a_collection_while_the_thread_holds_the_metric_lock_does_not_deadlock(
+    mp_metrics,
+):
+    """Any frame on any thread (a lane worker's ``finally``) may hold the lock."""
+    registry, lock = mp_metrics
+    _install_hook()
+
+    def collect_under_the_lock() -> None:
+        with lock:
+            gc.collect()
+
+    finished, error = _bounded(collect_under_the_lock)
+    assert finished, "gc.collect() under the held metric lock deadlocked in the hook"
+    assert error is None, error
+    # Negative control: the hook itself touched no metric.
+    assert _sample(registry, GC_PAUSE_COUNT, {"generation": "2"}) == 0
+    assert preprocess_lanes.drain_gc_pauses() >= 1
+    assert _sample(registry, GC_PAUSE_COUNT, {"generation": "2"}) >= 1
+    assert preprocess_lanes.drain_gc_pauses() == 0
+
+
+# --------------------------------------------------------------------------
+# What the hook records, and what the drain exports
+# --------------------------------------------------------------------------
+
+
+def test_the_hook_logs_nothing_and_the_drain_warns(caplog):
+    _install_hook()
+    with (
+        envs.SGLANG_EVENT_LOOP_LAG_WARN_S.override(0),  # every pause warns
+        caplog.at_level(logging.WARNING, logger=preprocess_lanes.__name__),
+    ):
+        gc.collect()
+        in_hook = [r for r in caplog.records if "Python GC pause" in r.getMessage()]
+        drained = preprocess_lanes.drain_gc_pauses()
+    warnings = [
+        r.getMessage() for r in caplog.records if "Python GC pause" in r.getMessage()
+    ]
+    assert in_hook == []
+    assert drained >= 1
+    assert len(warnings) == drained
+    assert any("(generation 2," in w for w in warnings)
+
+
+def test_the_drain_observes_by_generation_and_warns_at_the_threshold(caplog):
+    registry = CollectorRegistry()
+    preprocess_lanes.enable_metrics(registry)
+    preprocess_lanes._gc_pending.extend([(2, 0.5, 7), (0, 0.001, 0)])
+    with (
+        envs.SGLANG_EVENT_LOOP_LAG_WARN_S.override(0.2),
+        caplog.at_level(logging.WARNING, logger=preprocess_lanes.__name__),
+    ):
+        assert preprocess_lanes.drain_gc_pauses() == 2
+    assert _sample(registry, GC_PAUSE_COUNT, {"generation": "2"}) == 1
+    assert _sample(registry, GC_PAUSE_SUM, {"generation": "2"}) == pytest.approx(0.5)
+    assert _sample(registry, GC_PAUSE_COUNT, {"generation": "0"}) == 1
+    # The 1 ms pause is under the threshold: one warning, the 0.5 s one.
+    (warning,) = [
+        r.getMessage() for r in caplog.records if "Python GC pause" in r.getMessage()
+    ]
+    assert warning == "Python GC pause: 0.500s (generation 2, 7 collected)"
+
+
+def test_the_drain_without_metrics_still_empties_the_queue():
+    preprocess_lanes._gc_pending.extend([(1, 0.01, 3)] * 3)
+    assert preprocess_lanes.get_metrics() is None
+    assert preprocess_lanes.drain_gc_pauses() == 3
+    assert len(preprocess_lanes._gc_pending) == 0
+
+
+def test_undrained_pauses_are_bounded():
+    cap = preprocess_lanes._GC_PENDING_MAX
+    for _ in range(cap + 10):
+        preprocess_lanes._gc_timer("start", {"generation": 0})
+        preprocess_lanes._gc_timer("stop", {"generation": 0, "collected": 0})
+    assert len(preprocess_lanes._gc_pending) == cap
+    assert preprocess_lanes.drain_gc_pauses() == cap
+
+
+def test_a_stop_without_its_start_records_nothing():
+    preprocess_lanes._gc_timer("stop", {"generation": 2, "collected": 0})
+    assert preprocess_lanes.drain_gc_pauses() == 0
