+            """
+            on:
+              schedule:
+                - cron: '0 2 * * *'
+              workflow_dispatch:
+            jobs:
+              a:
+                runs-on: ubuntu-latest
+                strategy:
+                  matrix:
+                    runner: [ubuntu-24.04, ubuntu-24.04-arm]
+              b:
+                runs-on: ${{ matrix.os }}-latest
+            """,
+        )
+        self.workflow("pr.yml", "on:\n  pull_request:\njobs:\n  a:\n    runs-on: ubuntu-latest\n")
+
+    def test_check_lists_leftovers_then_passes(self) -> None:
+        code, out = self.main("--check")
+        self.assertEqual(code, 1)
+        self.assertEqual(
+            out.splitlines(),
+            [
+                ".github/workflows/n.yml:2: schedule trigger",
+                ".github/workflows/n.yml:7: hosted label 'ubuntu-latest' not rewritten",
+                ".github/workflows/n.yml:10: hosted label 'ubuntu-24.04' not rewritten",
+                ".github/workflows/n.yml:10: hosted label 'ubuntu-24.04-arm' not rewritten",
+                ".github/workflows/n.yml:12: hosted label '${{ matrix.os }}-latest' not rewritten",
+            ],
+        )
+        self.apply()
+        code, out = self.main("--check")
+        self.assertEqual(code, 0, out)
+
+    def test_second_apply_is_byte_identical(self) -> None:
+        self.apply()
+        first = {p: p.read_bytes() for p in (self.root / ".github").rglob("*.yml")}
+        out = self.apply()
+        self.assertIn("0 files changed", out)
+        self.assertEqual({p: p.read_bytes() for p in (self.root / ".github").rglob("*.yml")}, first)
