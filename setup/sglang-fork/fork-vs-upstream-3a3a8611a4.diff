+def test_the_digest_divergence_assert_still_fires_without_acks(ranks):
+    for r in ranks["digest_ungated"]:
+        assert r["failure"][0] == 37
+        assert "duplicate-reclaim victims diverged" in r["failure"][1]
+    for r in ranks["digest_gated"]:
+        # No ack is ever ready: the first heartbeat after step 37 (calls 16,
+        # 32, 48 are steps 15, 31, 47) runs the reduction and the assert.
+        assert r["armed"]
+        assert not any(h for _, h in r["hints"])
+        assert r["failure"][0] == 47
+        assert "duplicate-reclaim victims diverged" in r["failure"][1]
+        assert [k for k, p, _, _ in r["checks"] if p] == [15, 31, 47]
+
