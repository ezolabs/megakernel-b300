+def test_the_prefill_result_releases_the_scratch_after_the_forward():
+    from sglang.srt.managers.scheduler_components.batch_result_processor import (
+        SchedulerBatchResultProcessor,
+    )
+
+    freed, order = [], []
+
+    class _Proc(SchedulerBatchResultProcessor):
+        def snapshot_auxiliary_output_starts(self, batch, result):
+            return None
+
+        def move_logprobs_to_cpu(self, **_):
+            order.append(("logprobs", list(freed)))
+            raise _Stop
+
+    proc = _Proc.__new__(_Proc)
+    for name, value in dict(
+        is_generation=True,
+        token_to_kv_pool_allocator=SimpleNamespace(
+            free_group_begin=lambda: None,
+            free_swa=lambda idx: freed.append(idx.tolist()),
+        ),
+    ).items():
+        object.__setattr__(proc, name, value)
+
+    class _Ids:
+        def tolist(self):
+            order.append(("forward done", list(freed)))
+            return [0]
+
+    req = SimpleNamespace(
+        rid="r",
+        swa_rebuild=SwaRebuild(
+            start=30, end=40, scratch_full=torch.arange(30, 36), replayed=True
+        ),
+    )
