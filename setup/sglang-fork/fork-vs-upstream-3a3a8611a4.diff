+# holds the GIL, so the frame bound is also the bound on how long an encode can
+# keep the scheduler waiting. A coalesced BlockStored never spans two frames,
+# so every event also stays inside a KV-event consumer's per-event caps
+# (the serving router: MAX_TOKENS_PER_EVENT 2**20, MAX_HASHES_PER_EVENT 2**16).
+# Consumers already close a snapshot window that spans batches: the window is
+# SnapshotBegin .. SnapshotEnd, whatever the framing, and its page count is the
+# sum over every BlockStored in it.
+SNAPSHOT_FRAME_TOKENS = 1 << 18
+SNAPSHOT_FRAME_PAGES = 1 << 16
