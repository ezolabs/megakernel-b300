diff --git a/test/srt/sbr/test_d1_kv_publisher_snapshot.py b/test/srt/sbr/test_d1_kv_publisher_snapshot.py
new file mode 100644
index 0000000000..5bbbd794ce
--- /dev/null
+++ b/test/srt/sbr/test_d1_kv_publisher_snapshot.py
@@ -0,0 +1,372 @@
+"""#188 (d1): snapshot events and gap detection in the KV-event publisher.
+
+A subscriber that subscribes late, or reconnects after the publisher's replay
+buffer has moved on, had no way to say so: it asked for a batch the buffer no
+longer held and got a bare ``END_SEQ`` back, so it silently kept a view with a
+hole in it. The replay request is now decoded as *signed* (a negative
+``start_seq`` is a signal, not a position), such a subscriber is told "cannot
+serve you" with ``SNAPSHOT_SEQ`` ahead of ``END_SEQ``, and the publisher
+latches a snapshot request the cache owner drains with
+``take_snapshot_request()``. The cache owner then publishes a full placement
+snapshot as ordinary batches -- ``SnapshotBegin``, one ``BlockStored`` per
+resident page, ``SnapshotEnd`` -- so the subscriber can rebuild the view it
+lost.
+
+Pinned here: the replayed batches and their sequence numbers, the exact answer
+a gap gets, the latch's once-per-request semantics, that an explicit ``-2`` is
+a snapshot request while a serviceable ``start_seq`` is not, that the new
+events round-trip through the same msgspec code path as the older ones (tagged
+``SnapshotBegin`` / ``SnapshotEnd``), and that ``{"publisher": "null"}`` still
+builds a publisher now that the factory splats the remaining config keys into
+the constructor.
+
+The sockets are real ZeroMQ over ``inproc://`` endpoints, on the same
+``zmq.Context.instance()`` the publisher uses, and every poll has a timeout:
+a bug shows up as a failed assertion, not a hung suite. The DEALER is
+connected before the publisher binds its ROUTER, so the request cannot be sent
+into a pipe that is not there yet.
+"""
+
+from __future__ import annotations
+
+import itertools
+import time
+
+import msgspec
+import pytest
+import zmq
+
+from sglang.srt.disaggregation.kv_events import (
+    AllBlocksCleared,
+    BlockStored,
+    EventPublisherFactory,
+    KVEventBatch,
+    NullEventPublisher,
+    SnapshotBegin,
+    SnapshotEnd,
+    StorageMedium,
+    ZmqEventPublisher,
+)
+
+# Unique inproc endpoint names: a duplicate name collides inside one process.
+_endpoint_counter = itertools.count()
+POLL_TIMEOUT_MS = 10_000
+
+
+def _endpoints(prefix: str) -> tuple[str, str]:
+    index = next(_endpoint_counter)
+    base = f"{prefix}-{index}"
+    return f"inproc://{base}-pub", f"inproc://{base}-replay"
+
+
+def _batch(ts: float) -> KVEventBatch:
+    """One single-event batch, stamped so a subscriber can identify it."""
+    return KVEventBatch(ts=ts, events=[AllBlocksCleared()])
+
+
+class _Publisher:
+    """A started publisher plus the two client sockets pointed at it."""
+
+    def __init__(self, **config):
+        self.pub_endpoint, self.replay_endpoint = _endpoints("d1-kv-snap")
+        self.ctx = zmq.Context.instance()
+
+        # SUB before PUB: the publisher binds its PUB in the constructor, so
+        # the subscription exists before the first publish and the early
+        # messages are not dropped by ZeroMQ's slow-joiner behaviour.
+        self.sub = self.ctx.socket(zmq.SUB)
+        self.sub.setsockopt(zmq.SUBSCRIBE, b"")
+        self.sub.connect(self.pub_endpoint)
+
+        # The subscriber connects before the publisher exists and the
+        # publisher's ROUTER binds this endpoint in its constructor, so the
+        # request queues until the pipe exists and can never be sent into a
+        # pipe that is not there yet. (inproc emits no connect monitor events,
+        # so a request sent right after an async connect would race this
+        # fixture.)
+        self.dealer = self.ctx.socket(zmq.DEALER)
+        self.dealer.connect(self.replay_endpoint)
+
+        self.publisher = ZmqEventPublisher(
+            attn_dp_rank=0,
+            endpoint=self.pub_endpoint,
+            replay_endpoint=self.replay_endpoint,
+            **config,
+        )
+
+    def publish_and_take(self, count: int) -> list:
+        """Publish ``count`` batches; return ``[(seq, payload), ...]``.
+
+        Waiting for each batch to come back on the SUB is what proves the
+        publisher thread sent it: the sequence counter and the replay buffer
+        only advance on that path, so a replay request issued earlier would
+        race the state under test.
+        """
+        received = []
+        for _ in range(count):
+            ts = time.time()
+            self.publisher.publish(_batch(ts))
+            received.append(self._take(ts))
+        return received
+
+    def _take(self, ts: float) -> tuple:
+        """Read batches off the SUB until the one stamped ``ts`` arrives.
+
+        A SUB can be handed a batch more than once while its subscription
+        settles, so matching on the stamp is what keeps the sequence numbers
+        below tied to the batches this test published.
+        """
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while time.monotonic() < deadline:
+            if not self.sub.poll(200):
+                continue
+            _topic, seq_bytes, payload = self.sub.recv_multipart()
+            if msgspec.msgpack.decode(payload, type=KVEventBatch).ts == ts:
+                return int.from_bytes(seq_bytes, "big", signed=True), payload
+        raise AssertionError(f"published batch {ts} never arrived on the PUB socket")
+
+    def answer(self, start_seq: int) -> list:
+        """Send one replay request; read the answer up to ``END_SEQ``.
+
+        The request is ``[b"", start_seq]`` -- what a REQ-shaped subscriber
+        sends, which the publisher has always received as
+        ``[identity, empty_delim, start_seq]``: its frozen line
+        ``client_id, _, start_seq_bytes = frame`` reads the sequence from the
+        third frame, so that is where a request must put it. A reply is
+        ``[seq, payload]``; the routing envelope ZeroMQ leaves in front of
+        those two is dropped here, because those two frames are the contract.
+        """
+        self.dealer.send_multipart([b"", start_seq.to_bytes(8, "big", signed=True)])
+        frames: list = []
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while time.monotonic() < deadline:
+            if not self.dealer.poll(200):
+                continue
+            frames_in = self.dealer.recv_multipart()
+            seq_bytes, payload = frames_in[-2:]
+            seq = int.from_bytes(seq_bytes, "big", signed=True)
+            frames.append((seq, payload))
+            if seq == -1:  # END_SEQ
+                break
+        else:
+            raise AssertionError(f"no END_SEQ within {POLL_TIMEOUT_MS} ms: {frames!r}")
+        return frames
+
+    def close(self) -> None:
+        """Stop the publisher once its queue has drained.
+
+        Waiting here is fixture hygiene, not an assertion: ``shutdown`` stops
+        the thread even with a batch still queued and logs a warning when it
+        does, and that race would put a line in this suite's output that says
+        nothing about what the test checked.
+        """
+        deadline = time.monotonic() + POLL_TIMEOUT_MS / 1000
+        while time.monotonic() < deadline and not self.publisher._event_queue.empty():
+            time.sleep(0.01)
+        try:
+            self.publisher.shutdown()
+        finally:
+            self.sub.close(linger=0)
+            self.dealer.close(linger=0)
+
+
+@pytest.fixture
+def publisher():
+    started: list = []
+
+    def start(**config) -> _Publisher:
+        handle = _Publisher(**config)
+        started.append(handle)
+        return handle
+
+    yield start
+
+    for handle in started:
+        handle.close()
+
+
+def test_replay_within_the_buffer_sends_the_batches_and_no_snapshot(publisher):
+    handle = publisher(buffer_steps=10)
+    pub = handle.publisher
+
+    published = handle.publish_and_take(3)
+    assert [seq for seq, _ in published] == [0, 1, 2]
+
+    frames = handle.answer(0)
+
+    assert frames == published + [(-1, b"")]
+    assert ZmqEventPublisher.SNAPSHOT_SEQ not in [seq for seq, _ in frames]
+    # The subscriber was served from the buffer, so nobody owes it a snapshot.
+    assert pub.take_snapshot_request() is False
+
+
+def test_replay_older_than_the_buffer_answers_snapshot_then_end(publisher):
+    handle = publisher(buffer_steps=2)
+    pub = handle.publisher
+
+    published = handle.publish_and_take(5)
+    assert [seq for seq, _ in published] == [0, 1, 2, 3, 4]
+
+    # Batches 0..2 were evicted from the 2-deep buffer: an honest answer is "I
+    # cannot serve you", not a replay that starts at 3.
+    frames = handle.answer(0)
+
+    assert frames == [(-2, b""), (-1, b"")]
+    assert frames[0][0] == int.from_bytes(
+        ZmqEventPublisher.SNAPSHOT_SEQ, "big", signed=True
+    )
+    # One request, one snapshot: the latch is level-triggered and drains once.
+    assert pub.take_snapshot_request() is True
+    assert pub.take_snapshot_request() is False
+
+
+@pytest.mark.parametrize("start_seq", [-2, -7])
+def test_negative_start_seq_is_a_snapshot_request(publisher, start_seq):
+    handle = publisher(buffer_steps=10)
+    pub = handle.publisher
+
+
+    # -2 is the wire constant; -7 is any other negative value -- a request that
+    # cannot be read as a position is a signal, and it must reach the cache
+    # owner the same way. (-1 is END_SEQ, which the publisher emits itself.)
+    frames = handle.answer(start_seq)
+
+    assert frames == [(-2, b""), (-1, b"")]
+    assert pub.take_snapshot_request() is True
+    assert pub.take_snapshot_request() is False
+
+
+def test_snapshot_request_latches_once_and_request_snapshot_is_local(publisher):
+    handle = publisher(buffer_steps=10)
+    pub = handle.publisher
+
+    assert pub.take_snapshot_request() is False
+
+    pub.request_snapshot()
+    assert pub.take_snapshot_request() is True
+    assert pub.take_snapshot_request() is False
+
+    # A drained latch re-arms: a later gap must ask for a snapshot again.
+    pub.request_snapshot()
+    assert pub.take_snapshot_request() is True
+    # The null publisher has no subscriber to lose in the first place.
+    assert NullEventPublisher().take_snapshot_request() is False
+
+
+def test_snapshot_batches_ride_the_event_socket_and_replay(publisher):
+    handle = publisher(buffer_steps=10)
+    pub = handle.publisher
+
+    handle.publish_and_take(1)  # seq 0
+    snapshot_ts = time.time()
+    pub.publish(
+        KVEventBatch(
+            ts=snapshot_ts,
+            events=[
+                SnapshotBegin(num_blocks=1),
+                BlockStored(
+                    block_hashes=[7],
+                    parent_block_hash=None,
+                    token_ids=[1, 2],
+                    block_size=2,
+                    lora_id=None,
+                    medium=StorageMedium.GPU,
+                ),
+                SnapshotEnd(num_blocks=1),
+            ],
+        )
+    )
+
+    seq, payload = handle._take(snapshot_ts)
+    assert seq == 1
+
+    # This is the payload a subscriber decodes and acts on: a snapshot is not
+    # a side channel, it is a batch like any other, so it replays too.
+    decoded = msgspec.msgpack.decode(payload, type=KVEventBatch)
+    assert [type(event).__name__ for event in decoded.events] == [
+        "SnapshotBegin",
+        "BlockStored",
+        "SnapshotEnd",
+    ]
+    assert decoded.events[0].num_blocks == 1
+    assert decoded.events[2].num_blocks == 1
+
+    frames = handle.answer(1)
+    assert frames == [(1, payload), (-1, b"")]
+
+
+def test_snapshot_events_round_trip_with_explicit_encoder_and_decoder():
+    encoder = msgspec.msgpack.Encoder()
+    decoder = msgspec.msgpack.Decoder(KVEventBatch)
+
+    batch = KVEventBatch(
+        ts=1.5,
+        events=[
+            SnapshotBegin(num_blocks=3),
+            BlockStored(
+                block_hashes=[1, 2],
+                parent_block_hash=None,
+                token_ids=[1, 2, 3, 4],
+                block_size=4,
+                lora_id=None,
+                medium=StorageMedium.GPU,
+            ),
+            SnapshotEnd(num_blocks=3),
+        ],
+    )
+
+    decoded = decoder.decode(encoder.encode(batch))
+
+    assert decoded.ts == 1.5
+    assert decoded.events == batch.events
+    assert [type(event) for event in decoded.events] == [
+        SnapshotBegin,
+        BlockStored,
+        SnapshotEnd,
+    ]
+    assert decoded.events[0].num_blocks == 3
+    assert decoded.events[2].num_blocks == 3
+
+    # Tagged maps, the same encoding the older events use on this base
+    # (``{"type": tag, field: value, ...}``): a consumer that already decodes
+    # BlockStored needs no new code path for the markers.
+    raw = msgspec.msgpack.decode(encoder.encode(SnapshotBegin(num_blocks=3)))
+    assert raw == {"type": "SnapshotBegin", "num_blocks": 3}
+    raw_end = msgspec.msgpack.decode(encoder.encode(SnapshotEnd(num_blocks=0)))
+    assert raw_end == {"type": "SnapshotEnd", "num_blocks": 0}
+    raw_store = msgspec.msgpack.decode(encoder.encode(batch.events[1]))
+    assert raw_store["type"] == "BlockStored"
+
+
+def test_shutdown_is_idempotent(publisher):
+    handle = publisher(buffer_steps=10)
+    pub = handle.publisher
+
+    handle.publish_and_take(1)
+    pub.shutdown()
+    # Every publisher is registered with atexit as well, so the owner's close
+    # is the second call. It must not queue a sentinel no thread can consume
+    # (which made shutdown log a warning about a batch that never existed).
+    pub.shutdown()
+    assert pub._thread.is_alive() is False
+    assert pub._event_queue.qsize() == 0
+
+
+def test_null_publisher_config_builds_a_null_publisher():
+    # Regression: create() splats the remaining config keys into the
+    # constructor, so {"publisher": "null"} used to die with
+    # "TypeError: NullEventPublisher() takes no arguments".
+    null_publisher = EventPublisherFactory.create('{"publisher": "null"}')
+
+    assert isinstance(null_publisher, NullEventPublisher)
+    assert null_publisher.take_snapshot_request() is False
+    null_publisher.publish(_batch(time.time()))
+    null_publisher.shutdown()
+
+    # The whole config is splatted, not just the publisher key.
+    full = EventPublisherFactory.create(
+        '{"publisher": "null", "endpoint": "tcp://*:5599", "buffer_steps": 4,'
+        ' "hwm": 8, "max_queue_size": 16, "topic": "kv",'
+        ' "replay_endpoint": "tcp://*:5600"}'
+    )
+    assert isinstance(full, NullEventPublisher)
