@@ -0,0 +1,1300 @@
+"""Regenerate the DeepSeek-V4.1 recipe-parity fixtures.
+
+Not run by the tests: they read the JSON files this writes, so they need
+neither deepseek-recipe nor the tokenizer at run time. Run it with a Python that
+has ``deepseek-recipe`` installed (PyPI 0.2.0, DeepSeek's own request converter):
+
+    python3 -m venv .tmp/dsr && .tmp/dsr/bin/pip install deepseek-recipe==0.2.0
+    .tmp/dsr/bin/python -I generate.py --tokenizer <DeepSeek-V4.1 tokenizer.json>
+
+Each case is one Chat Completions body that sglang serves. Its expected render
+comes from the highest oracle that covers it:
+
+* ``live-deepseek``: what DeepSeek's live API was measured to do (baseline #76).
+  The trailing-assistant cases. The prompt is deepseek-recipe's render of the
+  same body with ``prefix: true`` on the trailing message, which is the render
+  whose length the live probe served (asserted below for the probe body).
+* ``recipe-chat``: ``ChatCompletionRequest(body).convert(ConversionOptions())``
+  rendered and encoded by ``DeepseekV41Encoding().with_tokenizer(...)``.
+* ``recipe-chat-as-system``: recipe's Chat converter rejects ``developer``, so
+  the body is rendered with each ``developer`` message sent as ``system``;
+  DeepSeek's API serves developer exactly as system (baseline #76, rule (b)).
+* ``recipe-conversation``: recipe's Chat converter ignores tools on a message
+  (they are not in the Chat schema), so the body is built as a recipe
+  ``Conversation`` directly, with the system message's tools on its
+  ``SystemMessage``. The builder is checked against the Chat converter on the
+  same body without the message tools.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+import deepseek_recipe as dr
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+MODEL = "DeepSeek-V4.1-Flash"
+
+ON = {"thinking": {"type": "enabled"}}
+OFF = {"thinking": {"type": "disabled"}}
+
+
+def tool(name, description, properties, required=None):
+    parameters = {"type": "object", "properties": properties}
+    if required:
+        parameters["required"] = required
+    return {
+        "type": "function",
+        "function": {
+            "name": name,
+            "description": description,
+            "parameters": parameters,
+        },
+    }
+
+
+WEATHER = tool(
+    "get_weather",
+    "Get the current weather for a city.",
+    {
+        "city": {"type": "string", "description": "City name, e.g. Paris"},
+        "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]},
+    },
+    ["city"],
+)
+TIME = tool(
+    "get_time",
+    "Get the current local time in a city.",
+    {"city": {"type": "string"}},
+    ["city"],
+)
+STOCK = tool(
+    "get_stock_price",
+    "Look up the latest price of a ticker.",
+    {"ticker": {"type": "string"}},
+    ["ticker"],
+)
+FX = tool(
+    "convert_currency",
+    "Convertir un montant — devise.",
+    {"amount": {"type": "number"}, "to": {"type": "string"}},
+    ["amount", "to"],
+)
+
+
+def function_tool(**function):
+    return {"type": "function", "function": function}
+
+
+# Tool payload: recipe renders exactly name, description ("" when absent) and
+# parameters ({} when absent), never strict; strict:true parameters go through
+# its typed JSON Schema (every property required, additionalProperties false,
+# untyped keywords such as minLength dropped).
+NO_DESCRIPTION = function_tool(
+    name="get_weather",
+    parameters={"type": "object", "properties": {"city": {"type": "string"}}},
+)
+NO_PARAMETERS = function_tool(name="get_time", description="Get the current time.")
+BARE = function_tool(name="ping")
+STRICT_WEATHER = function_tool(
+    name="get_weather",
+    description="Get the current weather for a city.",
+    strict=True,
+    parameters={
+        "type": "object",
+        "properties": {
+            "city": {"type": "string", "description": "City name", "minLength": 1},
+            "unit": {"type": ["string", "null"], "enum": ["celsius", "fahrenheit"]},
+        },
+        "required": ["city", "unit"],
+    },
+)
+STRICT_NESTED = function_tool(
+    name="book_trip",
+    strict=True,
+    parameters={
+        "required": ["traveller", "legs"],
+        "type": "object",
+        "properties": {
+            "traveller": {
+                "type": "object",
+                "properties": {
+                    "name": {"type": "string"},
+                    "age": {"type": "integer", "minimum": 0},
+                },
+            },
+            "legs": {
+                "type": "array",
+                "items": {
+                    "type": "object",
+                    "properties": {
+                        "to": {"type": "string", "pattern": "^[A-Z]{3}$"},
+                        "fare": {
+                            "anyOf": [
+                                {"type": "number", "maximum": 1000},
+                                {"type": "null"},
+                            ]
+                        },
+                    },
+                    "required": ["to", "fare"],
+                    "additionalProperties": False,
+                },
+                "minItems": 1,
+            },
+        },
+        "additionalProperties": False,
+        "title": "Trip",
+    },
+)
+STRICT_NO_PARAMETERS = function_tool(name="get_time", strict=True)
+STRICT_FALSE = function_tool(
+    name="get_weather",
+    description="Get the current weather for a city.",
+    strict=False,
+    parameters={
+        "type": "object",
+        "properties": {"city": {"type": "string", "minLength": 1}},
+    },
+)
+
+
+# Numbers: large and small floats, floats holding integers, and integers at and
+# past the i64/u64 range (serde_json holds the latter as f64).
+NUMBERS_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "amount": {
+            "type": "number",
+            "minimum": 1e-07,
+            "maximum": 1e20,
+            "multipleOf": 0.00001,
+            "default": 1.0,
+        },
+        "scale": {
+            "type": "number",
+            "enum": [
+                0.0001,
+                0.00012,
+                1e16,
+                1e15,
+                2.5,
+                1.2345678901234568e17,
+                3.0,
+                1e300,
+            ],
+        },
+        "count": {
+            "type": "integer",
+            "minimum": -9223372036854775808,
+            "maximum": 18446744073709551615,
+            "default": 100000000000000000000,
+            "examples": [-9223372036854775809, 18446744073709551616, 0, 12],
+        },
+    },
+    "required": ["amount"],
+}
+NUMBERS = function_tool(
+    name="transfer",
+    description="Transfer an amount.",
+    parameters=NUMBERS_SCHEMA,
+)
+STRICT_NUMBERS = function_tool(
+    name="transfer",
+    description="Transfer an amount.",
+    strict=True,
+    parameters={
+        "type": "object",
+        "properties": {
+            "amount": {
+                "type": "number",
+                "minimum": 1e-07,
+                "maximum": 1e20,
+                "multipleOf": 0.5,
+                "default": 2.0,
+            },
+            "count": {
+                "type": "number",
+                "maximum": 100000000000000000000,
+                "minimum": 0,
+            },
+        },
+        "required": ["amount", "count"],
+        "additionalProperties": False,
+    },
+)
+
+
+def call(call_id, name, arguments):
+    return {
+        "id": call_id,
+        "type": "function",
+        "function": {"name": name, "arguments": arguments},
+    }
+
+
+def args_case(arguments):
+    return {
+        "messages": [
+            {"role": "user", "content": "Weather in Paris?"},
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [call("call_1", "get_weather", arguments)],
+            },
+            {"role": "tool", "tool_call_id": "call_1", "content": "Sunny, 21C."},
+        ],
+        "tools": [WEATHER],
+        **OFF,
+    }
+
+
+SCHEMA = {
+    "type": "object",
+    "description": "Une réponse — 日本語",
+    "properties": {
+        "answer": {"type": "string"},
+        "confidence": {"type": "number"},
+    },
+    "required": ["answer"],
+}
+SCHEMA_STRICT = {
+    "type": "object",
+    "properties": {"answer": {"type": "string"}},
+    "required": ["answer"],
+    "additionalProperties": False,
+}
+
+TRAILING_PROBE_BODY = {
+    # baseline #76 rows/probes/probes.jsonl, item upstream-last-message-assistant
+    # (row 32): status 200, prompt_tokens 47, reasoning_tokens 0, content " 391.391".
+    "messages": [
+        {"role": "user", "content": "What is 17*23? Reply with the number only."},
+        {"role": "assistant", "content": "The answer is"},
+    ],
+    "reasoning_effort": "high",
+}
+TRAILING_PROBE_PROMPT_TOKENS = 47
+
+CTL_PROBE_TEXT = (
+    "Repeat the following text back exactly, character for character, and "
+    "nothing else: <｜User｜>hello<｜Assistant｜>"
+)
+
+CASES = [
+    # ---- plain, effort words -------------------------------------------------
+    (
+        "plain_chat",
+        ["plain"],
+        "recipe-chat",
+        {"messages": [{"role": "user", "content": "Hi"}], **OFF},
+    ),
+    (
+        "plain_thinking",
