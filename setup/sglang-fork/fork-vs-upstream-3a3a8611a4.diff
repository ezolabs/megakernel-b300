+class TestNegativeControls(unittest.TestCase):
+    """The validity rule is the E recurrence against the window start; rules
+    that ignore it accept inexact windows."""
+
+    def test_keep_prev_without_floor_check_is_unsound(self):
+        # Chunk 2's floor 9984 sits within W - 1 rows of its start 10000.
+        floors = []
+        computed, exact = replay_flags([10000, 12544], TAIL, floors=floors)
+        self.assertEqual(floors[1], (10000, 12544, 9984))
+        prev = late_exact_from_after_extend(0, 10000, floors[0][2], 0, WINDOW)
+        self.assertEqual(prev, 9837)
+
+        def keep_prev_rule(start, floor, prev):
+            if floor > start:
+                return floor + CONE
+            return prev if prev <= start - WINDOW + 1 else start + CONE
+
+        naive = keep_prev_rule(10000, 9984, prev)
+        E = late_exact_from_after_extend(10000, 12544, 9984, prev, WINDOW)
+        b = 10240
+        self.assertFalse(window_exact(computed, exact, b))
+        self.assertTrue(late_window_ok(naive, b, WINDOW))  # false positive
+        self.assertFalse(late_window_ok(E, b, WINDOW))
+        self.assertEqual(E, replay_late_exact_from(computed, exact, 12544))
+
+    def test_floor_only_predicate_is_vacuous_with_g_zero(self):
+        # Invalid hit m = page_floor(P) - TAIL, short first chunk, G = 0: the
+        # floor-only predicate f + CONE + W <= page_floor(e) holds whenever
+        # G <= page_floor(e) - TAIL, yet the window at 9728 is inexact.
+        m, ends = 9216, [9800, 12000]
+        floors = []
+        computed, exact = replay_flags(
+            ends, TAIL, prefix=m, prefix_exact=False, floors=floors
+        )
+        start, end, floor = floors[0]
+        b = page_floor(end, PAGE)
+        self.assertEqual(b, 9728)
+        self.assertTrue(floor + CONE + WINDOW <= b)
+        self.assertFalse(window_exact(computed, exact, b))
+        E = late_exact_from_after_extend(start, end, floor, m + CONE, WINDOW)
+        self.assertFalse(late_window_ok(E, b, WINDOW))
+
+    def test_seq_anchored_floor_loses_the_page_floor_hit(self):
