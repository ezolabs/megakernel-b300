+    def test_token_mask_lets_the_name_finish(self):
+        """What decoding sees: after `name="tytu` the mask admits `ł` and
+        forbids closing the name, where the builtin tag did the opposite."""
+        prefix = (
+            f"\n\n<{DSML} calls>\n"
+            + self._invoke("zapisz_notatke")
+            + f'<{DSML} parameter name="tytu'
+        )
+        vocab = sorted(set(prefix) | {"ł", '"', "ś", "x", '" string="true">'})
+        vocab.append("</s>")
+        info = xgr.TokenizerInfo(vocab, stop_token_ids=[len(vocab) - 1])
+        compiler = xgr.GrammarCompiler(info, cache_enabled=False)
+        fixed = self.detector.get_structural_tag(self.tools, "required")
+        builtin = BaseFormatDetector.get_structural_tag(
+            self.detector, self.tools, "required"
+        )
+        allowed = {}
+        for label, tag in (("fixed", fixed), ("builtin", builtin)):
+            matcher = xgr.GrammarMatcher(compiler.compile_structural_tag(tag))
+            for char in prefix:
+                self.assertTrue(matcher.accept_token(vocab.index(char)), (label, char))
+            bitmask = xgr.allocate_token_bitmask(1, len(vocab))
+            matcher.fill_next_token_bitmask(bitmask)
+            mask = bitmask_to_bool_mask(bitmask, len(vocab))[0]
+            allowed[label] = {vocab[i] for i in range(len(vocab)) if bool(mask[i])}
+        self.assertIn("ł", allowed["fixed"])
+        self.assertNotIn('"', allowed["fixed"])
+        self.assertNotIn('" string="true">', allowed["fixed"])
+        self.assertNotIn("ś", allowed["fixed"])
+        self.assertNotIn("ł", allowed["builtin"])
+        self.assertIn('"', allowed["builtin"])
