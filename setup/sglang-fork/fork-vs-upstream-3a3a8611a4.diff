+def test_the_images_follow_the_rendered_tool_results(tokenizer, box_c_env):
+    """The engine pairs the k-th placeholder of the RENDERED prompt with the k-th image the render
+    places there. Tool results answered out of the assistant's call order are rendered in call order
+    (``sort_tool_results_by_call_order``), and their images are taken in that same order, on the
+    messages path and on the ids path alike: the first placeholder gets the first call's image."""
+    by_id = {r["id"]: r for r in _image_records()}
+    chat = _mm_chat(tokenizer)
+    for name, swapped in (
+        ("tool-results-in-call-order", False),
+        ("tool-results-out-of-call-order", True),
+    ):
+        record = by_id[name]
+        in_messages = [
+            _planned_tokens(i["width"], i["height"])
+            for i in _images_by_message_order(record)
+        ]
+        runs = [end - start + 1 for start, end in record["offsets"]]
+        assert len(set(in_messages)) == len(in_messages)  # distinguishable
+        prompt = tokenizer.decode(_ids_of(record, "ids"))
+        # rendered in call order whatever the messages' order
+        assert prompt.index("result of call a") < prompt.index("result of call b")
+        tool_messages = [
+            m for m in record["egress"]["messages"] if m["role"] == "tool"
+        ]
+        answered = [m["tool_call_id"] for m in tool_messages]
+        assert answered == (["call_b", "call_a"] if swapped else ["call_a", "call_b"])
+        # the image_data order is the call order, whichever order the messages hold them ...
+        urls = [m["content"][-1]["image_url"]["url"] for m in tool_messages]
+        by_call = [answered.index(call) for call in ("call_a", "call_b")]
+        by_ids, _, _ = _convert(chat, record["egress"], _ids_of(record, "ids"))
+        by_messages, _, _ = _convert(chat, record["egress"])
+        assert _urls(by_ids.image_data) == [urls[i] for i in by_call], name
+        assert _urls(by_messages.image_data) == [urls[i] for i in by_call], name
+        # ... so run k is the image of the k-th call, sized as its planner says
+        assert runs == [in_messages[i] for i in by_call], name
+        assert (by_call != [0, 1]) == swapped, name
+
+
+def test_a_full_conversation_expands_as_its_images_answered_in_call_order(
+    tokenizer, mm_processor, box_c_env
+):
+    """The out-of-call-order body is the in-call-order body with its two answers swapped, and the
+    render is the same: the full conversation makes the same prompt, offsets, grids and feature
