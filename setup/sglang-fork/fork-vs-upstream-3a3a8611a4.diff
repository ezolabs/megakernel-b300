+++ b/test/srt/sbr/test_m_short_prefill_lookahead.py
@@ -0,0 +1,525 @@
+"""m - short-prefill lookahead: a cold queue head no longer blocks warm turns.
+
+Part 0020 protects a warm queue head while a long prompt is chunk-prefilled,
+but only the head decides, and the waiting-queue loop ends the pass at the
+first request ``PrefillAdder`` refuses. While a chunk continues the adder
+refuses any request that would have to be truncated (one continuing request at
+most), so one cold head (7.7k or 13.8k uncached tokens on box-c), or a second
+giant, keeps every warm request behind it waiting for the continuing prompt's
+whole remainder: prod 17:04:28 -> 17:04:54 and 17:27:30 -> 17:27:56, TTFT
+17-27 s for requests with 186-6,959 uncached tokens.
+
+Part 0022 adds ``--short-prefill-lookahead K``: the first ``K`` waiting
+requests in queue order are examined for eligibility (each matched against the
+radix cache at most once), and while a chunk continues the loop steps over a
+request among those ``K`` that would need truncating instead of ending the
+pass. Pinned here through the real ``Scheduler._get_new_batch_prefill_raw``
+with the real ``PrefillAdder``, on a ``UnifiedRadixCache`` built like box-c's
+(Full + SWA, Python TreeCore), real ``Req`` objects, fcfs + priority, and box-c's
+profile C (3072/1024/4096 at ``--chunked-prefill-size 4096``). Only
+``ScheduleBatch.init_new`` is replaced: it records the admitted list and ends
+the pass before a GPU batch would be built.
+
+- a cold head followed by a warm second: the chunk is capped at 1024, the warm
+  turn is admitted beside it, the cold head keeps its place;
+- ``K = 0`` (the default) is today's pass: chunk 4096, nothing admitted, the
+  warm turn never even matched;
+- no second chunked request is ever started, across two cold heads, and the
+  cold head is the one that starts chunking once the long prompt ends;
+- queue order is kept among the admitted requests; the scan is bounded by ``K``
+  and stops at the first eligible request; every other refusal (KV memory,
+  a preemption made for the refused request) still ends the pass; a stepped-over
+  request's LoRA is not counted as running;
+- startup validation of the new flag, and its CLI default.
+"""
+
+from __future__ import annotations
+
+import argparse
+from array import array
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+import torch
+
+import sglang.srt.managers.short_prefill as short_prefill
+from sglang.srt.arg_groups.validation_hook import validate_short_prefill_protection
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.managers import scheduler as scheduler_module
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.managers.schedule_policy import PrefillAdder, SchedulePolicy
+from sglang.srt.managers.scheduler import Scheduler
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import InsertParams
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.runtime_context import get_context
+from sglang.srt.sampling.sampling_params import SamplingParams
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+
+# The SWA allocator hands out single tokens outside the paged extend path, so
+# the tree runs at page size 1 (as in test_i / test_k).
+PAGE_SIZE = 1
+# Large enough that every cold request below fits the pool whole, so the only
+# refusal it meets is the one-continuation guard (the memory test goes past it).
+KV_SIZE = 65536
+NUM_LAYERS = 4
+FULL_LAYERS = (1, 3)
+
+# box-c: --chunked-prefill-size 4096, profile C = 3072/1024/4096 (deployed with
+# 0020 on 2026-09-27); 8 is the lookahead this part proposes.
+CHUNKED_PREFILL = 4096
+THRESHOLD, CHUNK, MAX_TOKENS = 3072, 1024, 4096
+ROOM = MAX_TOKENS - CHUNK  # what waiting requests may take beside a capped chunk
+LOOKAHEAD = 8
+PROFILE = dict(
+    page_size=PAGE_SIZE,
+    chunked_prefill_size=CHUNKED_PREFILL,
+    short_prefill_token_threshold=THRESHOLD,
+    short_prefill_chunk_size=CHUNK,
+    short_prefill_max_tokens=MAX_TOKENS,
+    short_prefill_lookahead=LOOKAHEAD,
+)
+
+CACHED = 4900
+PREFIX = list(range(1, CACHED + 1))
+WARM_NEW = 186  # the smallest uncached size among the stalled prod requests
+COLD_A, COLD_B = 7700, 13800  # the cold heads seen on box-c
+GIANT = 60_000  # the long prompt that is being chunk-prefilled
+
+
+@pytest.fixture
+def cache():
+    set_global_server_args_for_scheduler(ServerArgs(model_path="dummy", **PROFILE))
+    swa_layers = [i for i in range(NUM_LAYERS) if i not in FULL_LAYERS]
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=PAGE_SIZE,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=swa_layers,
+        full_attention_layer_ids=list(FULL_LAYERS),
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=PAGE_SIZE,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=PAGE_SIZE,
+        disable=False,
+        sliding_window_size=4,
+        tree_components=(ComponentType.FULL, ComponentType.SWA),
+    )
+    tree = UnifiedRadixCache(params=params)
+    value = allocator.alloc(CACHED)
+    tree.insert(InsertParams(key=RadixKey(array("q", PREFIX)), value=value[:CACHED]))
+    return tree
+
+
+_next_token = iter(range(1_000_001, 10**9))
+
+
+def _req(rid, tokens, entry_time, lora_id=None):
+    req = Req(rid, "", array("q", tokens), SamplingParams(max_new_tokens=8))
+    req.priority = 1  # box-c: --default-priority-value 1
+    req.time_stats.wait_queue_entry_time = entry_time
+    req.lora_id = lora_id
+    return req
+
+
+def _fresh(n):
+    return [next(_next_token) for _ in range(n)]
+
+
+def _warm(rid, entry_time, new=WARM_NEW, **kw):
+    return _req(rid, PREFIX + _fresh(new), entry_time, **kw)
+
+
+def _cold(rid, entry_time, length=COLD_A, **kw):
+    return _req(rid, _fresh(length), entry_time, **kw)
+
+
+def _giant(length=GIANT):
+    return _req("giant", _fresh(length), 0.0)
+
+
+def _fcfs(tree):
+    # box-c: --schedule-policy fcfs (default) --enable-priority-scheduling
+    return SchedulePolicy(
+        "fcfs",
+        tree,
+        enable_hierarchical_cache=False,
+        enable_priority_scheduling=True,
+        schedule_low_priority_values_first=False,
+    )
+
+
+class _BatchBuilt(Exception):
+    def __init__(self, reqs, chunked_req):
+        super().__init__("batch built")
+        self.reqs = list(reqs)
+        self.chunked_req = chunked_req
+
+
+class _StopAtBatch:
+    @staticmethod
+    def init_new(reqs, *args, chunked_req=None, **kwargs):
+        raise _BatchBuilt(reqs, chunked_req)
+
+
+class _Pass(SimpleNamespace):
+    """What one scheduler pass did."""
+
+    @property
+    def admitted(self):
+        return [r.rid for r in self.batch[1:]]  # batch[0] is the continuing chunk
+
+    @property
+    def chunk_tokens(self):
+        return (self.giant.extend_end - self.giant.prefix_len)
+
+
+def _pass(tree, queue, giant=None, *, preempt=False, lora=None, **schedule):
+    """One real ``_get_new_batch_prefill_raw`` pass with ``giant`` continuing."""
+    giant = giant or _giant()
+    # override_server_args publishes a fresh ServerArgs holding only the fields
+    # it is given, so it carries the whole profile.
+    override = get_context().override_server_args(**{**PROFILE, **schedule})
+    override.install()
+    adders, offered = [], []
+
+    class _Adder(PrefillAdder):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            adders.append(self)
+
+        def add_one_req(self, req, has_chunked_req, truncation_align_size):
+            offered.append(req.rid)
+            return super().add_one_req(req, has_chunked_req, truncation_align_size)
+
+        def preempt_to_schedule(self, req):
+            return preempt
+
+    fake = SimpleNamespace(
+        grammar_manager=SimpleNamespace(has_waiting_grammars=lambda: False),
+        enable_hierarchical_cache=False,
+        enable_unified_cache_external_linker=False,
+        enable_hicache_storage=False,
+        enable_priority_preemption=preempt,
+        is_hybrid_swa=True,
+        waiting_queue=list(queue),
+        chunked_req=giant,
+        min_free_slots_delayer=None,
+        # With preemption on, one slot: every waiting request finds the batch
+        # full and preempts (the stub above says it succeeded).
+        get_num_allocatable_reqs=lambda *args, **kwargs: 1 if preempt else 64,
+        policy=_fcfs(tree),
+        chunked_prefill_size=CHUNKED_PREFILL,
+        dynamic_chunk_sizer=None,
+        tp_worker=SimpleNamespace(
+            model_runner=SimpleNamespace(attn_backend=SimpleNamespace())
+        ),
+        page_size=PAGE_SIZE,
+        tree_cache=tree,
+        token_to_kv_pool_allocator=tree.token_to_kv_pool_allocator,
+        new_token_ratio_tracker=SimpleNamespace(current=0.7),
+        max_prefill_tokens=16384,
+        is_mixed_chunk=False,
+        priority_scheduling_preemption_threshold=10,
+        max_prefill_bs=64,
+        max_running_requests=64,
+        dllm_config=None,
+        enable_lora=lora is not None,
+        _can_schedule_lora_req=lora,
+        lora_drainer=None,
+        req_to_token_pool=SimpleNamespace(),
+        disaggregation_mode=DisaggregationMode.NULL,
+        truncation_align_size=None,
+        model_config=None,
+        enable_overlap=False,
+        spec_algorithm=None,
+        # Upstream's pass reads these too (the adder class through a getter,
+        # the LoRA gate without the underscore).
+        processed_tokens_counter=None,
+        get_prefill_adder_class=lambda: _Adder,
+        can_schedule_lora_req=lora,
+        enable_lmcache=False,
+        enable_priority_scheduling=True,
+        hisparse_coordinator=None,
+    )
+    running = SimpleNamespace(reqs=[], batch_is_full=False, is_empty=lambda: True)
+    try:
+        with (
+            mock.patch.object(scheduler_module, "PrefillAdder", _Adder),
+            mock.patch.object(scheduler_module, "ScheduleBatch", _StopAtBatch),
+            pytest.raises(_BatchBuilt) as built,
+        ):
+            Scheduler._get_new_batch_prefill_raw(
+                fake, prefill_delayer_single_pass=None, running_batch=running
+            )
+    finally:
+        override.restore()
+    assert len(adders) == 1
+    assert built.value.reqs[0] is giant, "the continuing chunk is always in the pass"
+    return _Pass(
+        adder=adders[0],
+        batch=built.value.reqs,
+        giant=giant,
+        offered=offered,
+        queue_after=[r.rid for r in fake.waiting_queue],
+        chunked_after=fake.chunked_req,
+        running=running,
+    )
+
+
+def test_a_cold_head_no_longer_blocks_the_warm_turn_behind_it(cache):
+    cold, warm = _cold("cold-7.7k", 1.0), _warm("warm", 2.0)
+    p = _pass(cache, [cold, warm])
+    assert p.chunk_tokens == CHUNK  # the chunk is capped at 1024
+    assert p.admitted == ["warm"]
+    assert (warm.extend_end - warm.prefix_len) == WARM_NEW  # only its uncached suffix
+    assert p.queue_after == ["cold-7.7k"]  # the cold head keeps its place
+    assert p.offered == ["cold-7.7k", "warm"]
+    assert p.adder.refused_truncation is cold
+    assert p.adder.new_chunked_req is None and p.chunked_after is p.giant
+
+
+def test_lookahead_zero_is_todays_pass(cache):
+    cold, warm = _cold("cold-7.7k", 1.0), _warm("warm", 2.0)
+    p = _pass(cache, [cold, warm], short_prefill_lookahead=0)
+    assert p.chunk_tokens == CHUNKED_PREFILL  # the ineligible head decides
+    assert p.admitted == []
+    # The pass ends at the head: upstream's budget_state() check stops it
+    # before the first offer once the continuing chunk spent the budget.
+    assert p.offered == []
+    assert p.queue_after == ["cold-7.7k", "warm"]
+    assert warm.num_matched_prefix_tokens == 0  # never even matched
+    assert p.adder.new_chunked_req is None and p.chunked_after is p.giant
+
+
+def test_lookahead_one_is_the_head_alone_like_zero(cache):
