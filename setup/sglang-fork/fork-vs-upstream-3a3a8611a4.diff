+"""The engine's time to first token on the chat sglext (patch ``0037``).
+
+``meta_info["first_token_latency"]`` is the tokenizer manager's ``first_token_time -
+created_time`` for a finished request, the value ``sglang:time_to_first_token_seconds``
+observes. The chat door puts it on ``sglext.first_token_latency`` only when the request
+asks: the body field ``return_first_token_latency_in_sglext`` or the header
+``x-sglext-return-ttft: 1``. Without the ask the chat response is unchanged.
+
+These tests drive the real ``OpenAIServingChat`` methods with the tokenizer and the
+scheduler replaced by plain stand-ins: no server, no tokenizer, no GPU.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+from fastapi import Request
+
+from sglang.srt.entrypoints.openai.protocol import (
+    ChatCompletionRequest,
+    SglExt,
+)
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.managers import tokenizer_manager as tm_module
+from sglang.srt.managers.io_struct import BatchStrOutput
+from sglang.srt.managers.tokenizer_manager import ReqState, TokenizerManager
+from sglang.srt.observability.req_time_stats import APIServerReqTimeStats
+from _chat_serving_stub import init_chat_serving_defaults
+
+RID = "chatcmpl-ttft"
+TTFT = 0.25
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's chat response reads get_serving() (return_input_ids, ...),
+    # which needs a published config in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+class _Sentinel(Exception):
+    """Raised by a stub to stop ``_convert_to_internal_request`` once its header read is done."""
+
+
+def _serving() -> OpenAIServingChat:
+    serving = init_chat_serving_defaults(OpenAIServingChat.__new__(OpenAIServingChat))
+    serving.template_manager = mock.Mock(reasoning_config=None, force_reasoning=False)
+    serving.reasoning_parser = None
+    serving.is_gpt_oss = False
+    serving.chat_encoding_spec = "dsv41"
+    serving.tokenizer_manager = SimpleNamespace(
+        server_args=SimpleNamespace(
+            return_input_ids=False,
+            return_output_ids=False,
+            enable_cache_report=False,
+            incremental_streaming_output=False,
+            stream_response_default_include_usage=False,
+        ),
+        model_config=SimpleNamespace(is_multimodal=False),
+        tokenizer=None,
+    )
+    return serving
+
+
+def _request(**extra) -> ChatCompletionRequest:
+    body = {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    body.update(extra)
+    return ChatCompletionRequest(**body)
+
+
+def _raw_request(headers: dict) -> Request:
+    async def _no_body() -> dict:
+        return {"type": "http.request", "body": b"", "more_body": False}
+
+    return Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/v1/chat/completions",
+            "headers": [
+                (name.lower().encode(), value.encode()) for name, value in headers.items()
+            ],
+        },
+        receive=_no_body,
+    )
+
+
+def _meta(first_token_latency=TTFT, finished=True) -> dict:
+    meta = {
+        "id": RID,
+        "weight_version": "v1",
+        "prompt_tokens": 3,
+        "completion_tokens": 2,
+        "cached_tokens": 0,
+        "reasoning_tokens": 0,
+        "finish_reason": {"type": "stop", "matched": None} if finished else None,
+    }
+    if first_token_latency is not None:
+        meta["first_token_latency"] = first_token_latency
+    return meta
+
+
+# --- the SglExt member ------------------------------------------------------
+
+
+def test_sglext_serializes_first_token_latency_and_omits_it_when_unset():
+    # Positive: the member is on the wire.
+    assert json.loads(SglExt(first_token_latency=TTFT).model_dump_json()) == {
+        "first_token_latency": TTFT
+    }
+    # Control: a response without it has the same keys as before the patch.
+    assert json.loads(SglExt(input_ids=[1, 2]).model_dump_json()) == {
+        "input_ids": [1, 2]
+    }
