+    def test_prefilled_stream_parses_into_tool_calls(self):
+        calls = [("get_weather", "Paris"), ("get_time", "Oslo")]
+        ids = self.tokenizer.encode(self._completion(*calls), add_special_tokens=False)
+        request = self._request("required", stream=True)
+
+        async def generate():
+            for end in (*range(3, len(ids), 3), len(ids)):
+                ret = self._output(self.tokenizer.decode(ids[:end]))
+                ret["output_ids"] = ids[:end]
+                ret["meta_info"]["completion_tokens"] = end
+                if end < len(ids):
+                    ret["meta_info"]["finish_reason"] = None
+                yield ret
+
+        self.tm.generate_request.return_value = generate()
+        chunks = self._parse_chunks(self._run_chat_stream(Mock(), request))
+        self.assertFalse(any("error" in chunk for chunk in chunks), chunks)
+        choices = [c for chunk in chunks for c in chunk.get("choices", [])]
+        self.assertEqual("".join(c["delta"].get("content") or "" for c in choices), "")
+        assembled = {}
+        for choice in choices:
+            for call in choice["delta"].get("tool_calls") or []:
+                entry = assembled.setdefault(call["index"], ["", ""])
+                entry[0] += call["function"].get("name") or ""
+                entry[1] += call["function"].get("arguments") or ""
+        self.assertEqual(
+            [(name, json.loads(args)) for name, args in assembled.values()],
+            [(name, {"city": city}) for name, city in calls],
+        )
+        self.assertEqual(choices[-1]["finish_reason"], "tool_calls")
