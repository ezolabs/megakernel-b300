index 0000000000..a2bdf933c7
--- /dev/null
+++ b/python/sglang/srt/entrypoints/openai/sbr_dsml_audit.py
@@ -0,0 +1,223 @@
+"""Counts DeepSeek DSML tool-call markup that reaches a client as text (part 0044b).
+
+0044 picked upstream's fail-closed DSML parsing (#39632) so a tool call the model
+writes as ``<｜DSML｜invoke ...>`` markup is either returned as a ``tool_calls`` entry
+or dropped, never left in ``content``. This module is the instrument that checks it
+on live traffic: it is always on (no switch), and its per-request cost is one
+substring scan of each emitted content (and reasoning) delta for ``｜DSML｜``.
+
+Six counters, summed over a window and written as one INFO line per
+``LOG_INTERVAL_S`` (60 s)::
+
+    sbr-dsml tool_requests=<n> calls=<n> dropped=<n> text_leaks=<n> parser_off_text=<n> reasoning_dsml=<n> strict_level=<effective>
+
+- ``tool_requests``: finished chat requests with tool-call parsing active
+  (``tool_choice`` not ``none``, tools present, a ``--tool-call-parser`` set).
+- ``calls``: tool calls returned (non-stream: entries in ``tool_calls``; stream:
+  calls opened, i.e. deltas carrying a function name), summed over choices.
+- ``dropped``: invokes the DSML detector (``deepseekv32_detector`` and its V4 /
+  V4.1 subclasses) dropped: malformed parameters, an invoke still open when a
+  non-stream answer ended, or one still buffered when a stream ended.
+- ``text_leaks``: requests whose returned ``content`` contained ``｜DSML｜`` while
+  tool-call parsing was active.
+- ``parser_off_text``: the same while parsing was off (``tool_choice`` none, no
+  tools, or no parser): the model wrote DSML no parser was asked to read.
+- ``reasoning_dsml``: requests whose ``reasoning_content`` contained it
+  (informational: tool calls inside thinking are not parsed by design).
+
+A request counts at most once per kind, however many choices or deltas carry the
+marker. ``strict_level`` is ``sbr_tool_strict.effective_tool_strict_level()`` when
+the line is written. The line is written by the first event (a finished request
+or a dropped invoke) at least 60 s after the window opened, so an idle server
+logs nothing.
+
+Each leak also logs one WARNING when its request finishes, with no answer text::
+
+    sbr-dsml-leak rid=<rid> kind=<text_leak|parser_off_text> tool_choice=<auto|required|none|function:<name>|unset>
+
+Streamed deltas are scanned with the last ``TAIL_CHARS`` characters of the
+previous delta of the same choice prepended, so a marker split across two
+deltas still counts.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import time
+from typing import Any, Callable, Dict, Optional
+
+from sglang.srt.function_call.sbr_tool_strict import effective_tool_strict_level
+
+logger = logging.getLogger(__name__)
+
+LOG_PREFIX = "sbr-dsml"
+LEAK_PREFIX = "sbr-dsml-leak"
+DSML_MARKER = "｜DSML｜"
+# Carried between deltas of one choice; longer than the marker (6 chars).
+TAIL_CHARS = 16
+LOG_INTERVAL_S: float = 60.0
+
+KIND_TEXT_LEAK = "text_leak"
+KIND_PARSER_OFF_TEXT = "parser_off_text"
+
+COUNTERS = (
+    "tool_requests",
+    "calls",
+    "dropped",
+    "text_leaks",
+    "parser_off_text",
+    "reasoning_dsml",
+)
+
+# The summary line's clock, a module attribute so a test can inject it.
+_clock: Callable[[], float] = time.monotonic
+
+_lock = threading.Lock()
+_counts: Dict[str, int] = dict.fromkeys(COUNTERS, 0)
+_window_start: Optional[float] = None
+
+
+def _maybe_log(now: float) -> None:
+    """Write the summary line when the window is ``LOG_INTERVAL_S`` old. Lock held."""
+    global _window_start
+    if _window_start is None:
+        _window_start = now
+        return
+    if now - _window_start < LOG_INTERVAL_S:
+        return
+    logger.info(
+        "%s %s strict_level=%d",
+        LOG_PREFIX,
+        " ".join(f"{name}={_counts[name]}" for name in COUNTERS),
+        int(effective_tool_strict_level()),
+    )
+    for name in COUNTERS:
+        _counts[name] = 0
+    _window_start = now
+
+
+def _add(deltas: Dict[str, int]) -> None:
+    now = _clock()
+    with _lock:
+        # The event that closes a window belongs to the next one.
+        _maybe_log(now)
+        for name, n in deltas.items():
+            _counts[name] += n
+
+
+def note_dropped(n: int = 1) -> None:
+    """The DSML detector dropped ``n`` invokes."""
+    if n > 0:
+        _add({"dropped": n})
+
+
+def tool_choice_label(tool_choice: Any) -> str:
+    """``tool_choice`` for the leak line: the string, ``function:<name>`` or ``unset``."""
+    if tool_choice is None:
+        return "unset"
+    if isinstance(tool_choice, str):
+        return tool_choice
+    function = getattr(tool_choice, "function", None)
+    name = getattr(function, "name", None)
+    if name is None and isinstance(tool_choice, dict):
+        name = (tool_choice.get("function") or {}).get("name")
+    return f"function:{name}" if name else type(tool_choice).__name__
+
+
+class RequestAudit:
+    """One chat request's observations, committed to the counters by ``finish()``."""
+
+    __slots__ = (
+        "rid",
+        "tool_parsing_active",
+        "tool_choice",
+        "calls",
+        "content_dsml",
+        "reasoning_dsml",
+        "_content_tails",
+        "_reasoning_tails",
+        "_finished",
+    )
+
+    def __init__(
+        self,
+        tool_parsing_active: bool,
+        tool_choice: Any = None,
+        rid: Optional[str] = None,
+    ) -> None:
+        self.rid = rid
+        self.tool_parsing_active = bool(tool_parsing_active)
+        self.tool_choice = tool_choice
+        self.calls = 0
+        self.content_dsml = False
+        self.reasoning_dsml = False
+        self._content_tails: Dict[int, str] = {}
+        self._reasoning_tails: Dict[int, str] = {}
+        self._finished = False
+
+    @property
+    def leak_kind(self) -> Optional[str]:
+        if not self.content_dsml:
+            return None
+        return KIND_TEXT_LEAK if self.tool_parsing_active else KIND_PARSER_OFF_TEXT
+
+    @staticmethod
+    def _scan(tails: Dict[int, str], index: int, text: str) -> bool:
+        window = tails.get(index, "") + text
+        if DSML_MARKER in window:
+            return True
+        tails[index] = window[-TAIL_CHARS:]
+        return False
+
+    def observe_content(self, text: Optional[str], index: int = 0) -> None:
+        """A ``content`` delta (or a whole answer) returned for choice ``index``."""
+        if text and not self.content_dsml:
+            self.content_dsml = self._scan(self._content_tails, index, text)
+
+    def observe_reasoning(self, text: Optional[str], index: int = 0) -> None:
+        """A ``reasoning_content`` delta (or a whole one) returned for choice ``index``."""
+        if text and not self.reasoning_dsml:
+            self.reasoning_dsml = self._scan(self._reasoning_tails, index, text)
+
+    def add_calls(self, n: int) -> None:
+        self.calls += n
+
+    def finish(self) -> None:
+        """Commit this request to the counters; later calls do nothing."""
+        if self._finished:
+            return
+        self._finished = True
+        kind = self.leak_kind
+        _add(
+            {
+                "tool_requests": int(self.tool_parsing_active),
+                "calls": self.calls,
+                "text_leaks": int(kind == KIND_TEXT_LEAK),
+                "parser_off_text": int(kind == KIND_PARSER_OFF_TEXT),
+                "reasoning_dsml": int(self.reasoning_dsml),
+            }
+        )
+        if kind is not None:
+            logger.warning(
+                "%s rid=%s kind=%s tool_choice=%s",
+                LEAK_PREFIX,
+                self.rid,
+                kind,
+                tool_choice_label(self.tool_choice),
+            )
+
+
+def stats() -> Dict[str, int]:
+    """The current window's counters (tests and debugging)."""
+    with _lock:
+        return dict(_counts)
+
+
+def reset() -> None:
+    """Zero the counters and close the window (tests)."""
+    global _window_start
+    with _lock:
+        for name in COUNTERS:
+            _counts[name] = 0
+        _window_start = None
