@@ -0,0 +1,878 @@
+"""n - short-prefill chunk swap: a cold mid-size head is prefilled in the giant's place.
+
+Parts 0020 and 0022 protect warm requests while a long prompt (the "giant") is
+chunk-prefilled, but not a request that is itself cold and mid-size. Only one
+request may continue chunking, so a head with 3,072-16k uncached tokens waits
+for the giant's whole remainder: on box-c, 7,734 uncached tokens waited 25.9 s
+(17:04:28) and 13,778 waited 27.4 s (17:27:30), for about a second of their
+own prefill.
+
+Part 0023 adds ``--short-prefill-swap-limit N`` and ``--short-prefill-swap-budget
+F``. A head above the threshold whose uncached prompt is at most ``N`` tokens
+(and less than the giant has left, and not of lower priority) is prefilled in
+the giant's place: the giant is parked at a chunk boundary, keeping its request
+slot and its locked cached prefix, and resumes where it stopped at the top of
+the first step in which nothing is chunking in its place. Every pass the giant
+sits out is charged one chunk against ``F`` times its own uncached tokens,
+including a pass lost to a head that could not be admitted, so it sits out at
+most ``F`` times the passes of its own prefill.
+
+Pinned here through the real ``Scheduler.get_next_batch_to_run`` (so the resume
+at the top of a step, the stash gate and the prefill pass run in their real
+order) with the real ``PrefillAdder``, on a ``UnifiedRadixCache`` built like
+box-c's (Full + SWA, Python TreeCore), real ``Req`` objects, fcfs + priority and
+box-c's profile C (3072/1024/4096 at ``--chunked-prefill-size 4096``) with ``K = 8``
+and a 16,384-token swap limit. ``ScheduleBatch.init_new`` is replaced: it records
+the batch and ends the step before a GPU batch would be built. Between steps a
+stand-in for the forward and the stash appends the chunk just scheduled to the
+continuing request's ``prefix_len``; nothing else is simulated.
+"""
+
+from __future__ import annotations
+
+import argparse
+from array import array
+from types import SimpleNamespace
+from unittest import mock
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+
+import sglang.srt.managers.short_prefill as short_prefill
+from sglang.srt.arg_groups.validation_hook import validate_short_prefill_protection
+from sglang.srt.disaggregation.utils import DisaggregationMode
+from sglang.srt.managers import scheduler as scheduler_module
+from sglang.srt.managers.io_struct import AbortReq
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.managers.schedule_policy import PrefillAdder, SchedulePolicy
+from sglang.srt.managers.scheduler import Scheduler
+from sglang.srt.managers.scheduler_components.invariant_checker import (
+    SchedulerInvariantChecker,
+)
+from sglang.srt.managers.scheduler_components.load_inquirer import (
+    SchedulerLoadInquirer,
+)
+from sglang.srt.mem_cache.allocator.swa import SWATokenToKVPoolAllocator
+from sglang.srt.mem_cache.base_prefix_cache import (
+    EvictParams,
+    InsertParams,
+    MatchPrefixParams,
+)
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.memory_pool import ReqToTokenPool
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+from sglang.srt.runtime_context import get_context
+from sglang.srt.sampling.sampling_params import SamplingParams
+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler
+
+PAGE_SIZE = 1  # the SWA allocator's constraint, as in test_i / test_k / test_m
+KV_SIZE = 65536
+NUM_LAYERS = 4
+FULL_LAYERS = (1, 3)
+
+# box-c: --chunked-prefill-size 4096 and profile C (0020); K = 8 (0022); this
+# part proposes a 16,384-token swap limit (four passes) and a 25 % budget.
+CHUNKED_PREFILL = 4096
+THRESHOLD, CHUNK, MAX_TOKENS = 3072, 1024, 4096
+LOOKAHEAD = 8
+SWAP_LIMIT, SWAP_BUDGET = 4 * CHUNKED_PREFILL, 0.25
+PROFILE = dict(
+    page_size=PAGE_SIZE,
+    chunked_prefill_size=CHUNKED_PREFILL,
+    short_prefill_token_threshold=THRESHOLD,
+    short_prefill_chunk_size=CHUNK,
+    short_prefill_max_tokens=MAX_TOKENS,
+    short_prefill_lookahead=LOOKAHEAD,
+    short_prefill_swap_limit=SWAP_LIMIT,
+    short_prefill_swap_budget=SWAP_BUDGET,
+)
+
+CACHED = 4900
+PREFIX = list(range(1, CACHED + 1))
+WARM_NEW = 186
+COLD_A, COLD_B = 7700, 13800  # the cold heads seen on box-c (7,734 and 13,778)
+GIANT = 60_000  # its own uncached tokens: 25 % is 15,000, three passes of 4,096
+COMPUTED = 5 * CHUNKED_PREFILL  # what it has prefilled when the head arrives
+
+
+@pytest.fixture
+def cache():
+    set_global_server_args_for_scheduler(ServerArgs(model_path="dummy", **PROFILE))
+    swa_layers = [i for i in range(NUM_LAYERS) if i not in FULL_LAYERS]
+    kv_pool = SWAKVPool(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=PAGE_SIZE,
+        dtype=torch.bfloat16,
+        head_num=1,
+        head_dim=8,
+        swa_attention_layer_ids=swa_layers,
+        full_attention_layer_ids=list(FULL_LAYERS),
+        device="cpu",
+    )
+    allocator = SWATokenToKVPoolAllocator(
+        size=KV_SIZE,
+        size_swa=KV_SIZE,
+        page_size=PAGE_SIZE,
+        dtype=torch.bfloat16,
+        device="cpu",
+        kvcache=kv_pool,
+        need_sort=False,
+    )
+    params = CacheInitParams(
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=KV_SIZE, device="cpu", enable_memory_saver=False
+        ),
+        token_to_kv_pool_allocator=allocator,
+        page_size=PAGE_SIZE,
+        disable=False,
+        sliding_window_size=4,
+        tree_components=(ComponentType.FULL, ComponentType.SWA),
+    )
+    tree = UnifiedRadixCache(params=params)
+    value = allocator.alloc(CACHED)
+    tree.insert(InsertParams(key=RadixKey(array("q", PREFIX)), value=value[:CACHED]))
+    return tree
+
+
+_next_token = iter(range(1_000_001, 10**9))
+
+
+def _fresh(n):
+    return [next(_next_token) for _ in range(n)]
+
+
+def _req(rid, tokens, entry_time, priority=1):
+    req = Req(rid, "", array("q", tokens), SamplingParams(max_new_tokens=8))
+    req.priority = priority  # box-c: --default-priority-value 1
+    req.time_stats.wait_queue_entry_time = entry_time
+    return req
+
+
+def _warm(rid, entry_time, new=WARM_NEW):
+    return _req(rid, PREFIX + _fresh(new), entry_time)
+
+
+def _cold(rid, entry_time, length=COLD_A, **kw):
+    return _req(rid, _fresh(length), entry_time, **kw)
+
+
+def _giant(tree, length=GIANT, computed=COMPUTED, priority=1):
+    """A giant between two of its chunks, as a step's stash leaves it.
+
+    Its first ``computed`` tokens are in the radix tree and locked by it, and
+    ``prefix_len`` is what the tree matched; ``cached_tokens`` is what
+    ``prepare_for_extend`` recorded at its first chunk (it arrived cold).
+    """
+    giant = _req("giant", _fresh(length), 0.0, priority=priority)
+    tokens = array("q", giant.origin_input_ids[:computed])
+    value = tree.token_to_kv_pool_allocator.alloc(computed)
+    tree.insert(InsertParams(key=RadixKey(tokens), value=value))
+    giant.init_next_round_input(tree)
+    assert giant.prefix_len == computed
+    tree.inc_lock_ref(giant.last_node)
+    giant.extend_end = computed  # its last chunk ended here
+    giant.cached_tokens = 0
+    return giant
+
+
+def _fcfs(tree):
+    # box-c: --schedule-policy fcfs (default) --enable-priority-scheduling
+    return SchedulePolicy(
+        "fcfs",
+        tree,
+        enable_hierarchical_cache=False,
+        enable_priority_scheduling=True,
+        schedule_low_priority_values_first=False,
+    )
+
+
+class _BatchBuilt(Exception):
+    def __init__(self, reqs):
+        super().__init__("batch built")
+        self.reqs = list(reqs)
+
+
+class _StopAtBatch:
+    @staticmethod
+    def init_new(reqs, *args, chunked_req=None, **kwargs):
+        raise _BatchBuilt(reqs)
+
+
+class _Step(SimpleNamespace):
+    """What one scheduler step did."""
+
+    def extend(self, rid):
+        """(start, end) of what ``rid`` prefills in this step, or None."""
+        return self.spans.get(rid)
+
+    @property
+    def rids(self):
+        return [r.rid for r in self.batch]
+
+
+class _Engine:
+    """A real ``Scheduler`` (built attribute by attribute) stepped with the real
+    ``get_next_batch_to_run``, ending each step where the GPU batch is built."""
+
+    def __init__(self, tree, queue, giant, **schedule):
+        self.override = get_context().override_server_args(**{**PROFILE, **schedule})
+        self.override.install()
+        self.tree = tree
+        self.allocatable = 64
+        s = Scheduler.__new__(Scheduler)
+        s._pause_started_at = None
+        s.scheduler_stage_metrics = None
+        s._pending_chunked_abort_req = None
+        s._abort_on_waiting_timeout = MagicMock()
+        s._abort_on_running_timeout = MagicMock()
+        s.enable_fpm = False
+        s.dllm_config = None
+        s.dllm_manager = None
+        s.enable_hisparse = False
+        s.require_mlp_sync = False
+        s.prefill_decode_interval = 0
+        s._prefill_decode_interval_remaining = 0
+        s.prefill_delayer = None
+        s.dp_attn_adapter = MagicMock()
+        s.dp_attn_adapter.maybe_prepare_mlp_sync_batch.side_effect = lambda batch, **_: (
+            batch
+        )
+        s.dp_attn_adapter.maybe_convert_decode_to_extend.side_effect = lambda b: b
+        s.ngram_embedding_manager = MagicMock()
+        s.ngram_embedding_manager.prepare_for_forward.side_effect = lambda batch, **_: (
+            batch
+        )
+        s.stash_chunked_request = self._stash
+        s.grammar_manager = SimpleNamespace(has_waiting_grammars=lambda: False)
+        s.enable_hierarchical_cache = False
+        s.enable_unified_cache_external_linker = False
+        s.enable_hicache_storage = False
+        s.enable_priority_preemption = False
+        s.is_hybrid_swa = True
+        s.waiting_queue = list(queue)
+        s.chunked_req = giant
+        s.min_free_slots_delayer = None
+        s.get_num_allocatable_reqs = lambda *args, **kwargs: self.allocatable
+        s.policy = _fcfs(tree)
+        s.chunked_prefill_size = CHUNKED_PREFILL
+        s.dynamic_chunk_sizer = None
+        s.tp_worker = SimpleNamespace(
+            model_runner=SimpleNamespace(attn_backend=SimpleNamespace())
+        )
+        s.page_size = PAGE_SIZE
+        s.tree_cache = tree
+        s.token_to_kv_pool_allocator = tree.token_to_kv_pool_allocator
+        s.new_token_ratio_tracker = SimpleNamespace(current=0.7)
+        s.max_prefill_tokens = 16384
+        s.is_mixed_chunk = False
+        s.priority_scheduling_preemption_threshold = 10
+        s.max_prefill_bs = 64
+        s.max_running_requests = 64
+        s.enable_lora = False
+        s.lora_drainer = None
+        s.req_to_token_pool = SimpleNamespace()
+        s.disaggregation_mode = DisaggregationMode.NULL
+        s.truncation_align_size = None
+        s.model_config = None
+        s.enable_overlap = False
+        s.spec_algorithm = None
+        # Upstream's pass reads these too.
+        s.processed_tokens_counter = 0
+        s.enable_lmcache = False
+        s.hisparse_coordinator = None
+        s.enable_continuous_input_polling = False
+        s.enable_overlap_mlx = False
+        s.running_batch = SimpleNamespace(
+            reqs=[],
+            batch_is_full=False,
+            is_empty=lambda: True,
+            is_prefill_only=False,
+            batch_size=lambda: 0,
+            filter_batch=lambda: None,
+        )
+        s.short_prefill_swap = short_prefill.chunk_swap_for(
+            SimpleNamespace(**{**PROFILE, **schedule})
+        )
+        self.s = s
+        self.stashed = []
+
+    @property
+    def swap(self):
+        return self.s.short_prefill_swap
+
+    def _stash(self, req):
+        # Stand-in for the forward plus the step's stash: the chunk scheduled
+        # last step is computed, so the continuing request's prefix covers it.
+        # (The real stash also inserts it into the tree; nothing here reads that.)
+        self.stashed.append(req.rid)
+        req.prefix_len = max(req.prefix_len, req.extend_end)
+
+    def step(self):
+        adders, offered = [], []
+
+        class _Adder(PrefillAdder):
+            def __init__(self, *args, **kwargs):
+                super().__init__(*args, **kwargs)
+                adders.append(self)
+
+            def add_one_req(self, req, has_chunked_req, truncation_align_size):
+                offered.append(req.rid)
+                return super().add_one_req(req, has_chunked_req, truncation_align_size)
+
+        batch = []
+        with (
+            mock.patch.object(scheduler_module, "PrefillAdder", _Adder),
+            mock.patch.object(scheduler_module, "ScheduleBatch", _StopAtBatch),
+        ):
+            try:
+                Scheduler.get_next_batch_to_run(
+                    self.s, running_batch=self.s.running_batch, last_batch=None
+                )
+            except _BatchBuilt as built:
+                batch = built.reqs
+        swap = self.swap
+        return _Step(
+            batch=batch,
+            # The extend range is rewritten by later steps: record it now.
+            spans={r.rid: (r.prefix_len, r.extend_end) for r in batch},
+            adder=adders[0] if adders else None,
+            offered=offered,
+            chunked=self.s.chunked_req,
+            parked=None if swap is None else swap.parked,
+            queue=[r.rid for r in self.s.waiting_queue],
+        )
+
+    def close(self):
+        self.override.restore()
+
