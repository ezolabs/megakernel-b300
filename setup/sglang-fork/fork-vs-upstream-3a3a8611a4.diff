+def _invoke_bodies(tag):
+    """{invoke header: its JSON-schema body} of a structural tag."""
+    bodies = {}
+
+    def visit(node):
+        if isinstance(node, list):
+            for item in node:
+                visit(item)
+        elif isinstance(node, dict):
+            content = node.get("content")
+            if node.get("type") == "tag" and isinstance(content, dict):
+                if content.get("type") == "json_schema":
+                    bodies[node["begin"]] = content
+                    return
+            for value in node.values():
+                visit(value)
+
+    visit(tag.model_dump(by_alias=True))
+    return bodies
