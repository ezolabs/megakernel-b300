+"""Error paths that used to print request content log only lengths + digests.
+
+Covers the Req repr (every f"{req=}" assert / log), the GrammarManager poll
+assert, the chat-parsing JSON error, the /generate error logs and the
+redacted traceback helper the `logger.exception` sites now use.
+"""
+
+import asyncio
+import json
+import logging
+import unittest
+from array import array
+from types import SimpleNamespace
+
+from sglang.srt.utils.log_redact import redact, redact_exc, redacted_traceback
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(2.0, "base-a-test-cpu")
+
+PROMPT = "my account password is hunter2-customer-secret"
+STOP = "customer_stop_word_xyz"
+SCHEMA = json.dumps({"type": "object", "properties": {"customer_field_xyz": {}}})
+INPUT_IDS = [40213, 99117, 51234]
+OUTPUT_IDS = [77001, 77002]
+SECRETS = [PROMPT, "hunter2", STOP, "customer_field_xyz", "customer_stop_word"]
+
+
+def _visible(text: str) -> str:
+    """`text` with every hex digest cut out, so ids can be searched as values."""
+    out = text
+    for part in text.split("sha256=")[1:]:
+        out = out.replace(part.split(">")[0].split(")")[0], "")
+    return out
+
+
+class _ContentFreeMixin:
+    def assert_content_free(self, text: str):
+        for s in SECRETS:
+            self.assertNotIn(s, text)
+        visible = _visible(text)
+        for i in INPUT_IDS + OUTPUT_IDS:
+            self.assertNotIn(str(i), visible)
+
+
+def _make_req():
+    from sglang.srt.managers.schedule_batch import Req
+    from sglang.srt.sampling.sampling_params import SamplingParams
+
+    req = Req(
+        rid="rid-redact-1",
+        origin_input_text=PROMPT,
+        origin_input_ids=array("q", INPUT_IDS),
+        sampling_params=SamplingParams(
+            max_new_tokens=8, stop=[STOP], json_schema=SCHEMA
+        ),
+    )
+    req.output_ids.extend(OUTPUT_IDS)
+    return req
+
+
+class TestReqRepr(_ContentFreeMixin, unittest.TestCase):
+    def test_repr_is_ids_free_and_text_free(self):
+        req = _make_req()
+        out = repr(req)
+        self.assertIn("rid=rid-redact-1", out)
+        self.assertIn(f"origin_input_ids={redact(INPUT_IDS)}", out)
+        self.assertIn(f"output_ids={redact(OUTPUT_IDS)}", out)
+        self.assertIn("sampling_params=<SamplingParams len=", out)
+        self.assert_content_free(out)
+        self.assert_content_free(f"{req=}")
+        self.assert_content_free(str(req))
+
+    def test_grammar_poll_assert_is_content_free(self):
+        from sglang.srt.constrained.base_grammar_backend import (
+            InvalidGrammarObject,
+        )
+        from sglang.srt.constrained.grammar_manager import GrammarManager
+
+        req = _make_req()
+        # Not a Future and not None: trips the poll loop's type assert.
+        req.grammar = InvalidGrammarObject(f"bad schema near {SCHEMA}")
+        manager = object.__new__(GrammarManager)
+        manager.grammar_backend = object()
+        manager.grammar_queue = [req]
+        manager.pp_rank = 0
+        manager.SGLANG_GRAMMAR_POLL_INTERVAL = 0.05
+        with self.assertRaises(AssertionError) as cm:
+            manager.get_ready_grammar_requests()
+        msg = str(cm.exception)
+        self.assertIn("rid=rid-redact-1", msg)
+        self.assertIn("InvalidGrammarObject(error_message=<str len=", msg)
+        self.assert_content_free(msg)
+
+
+class TestContentParserJsonError(_ContentFreeMixin, unittest.TestCase):
+    def test_unparseable_region_message_has_digest_not_text(self):
+        from sglang.srt.parser.chat_parsing.content_parsers import _json
+
+        text = '{"note": "' + PROMPT + '", '
+        with self.assertRaises(ValueError) as cm:
+            _json(text, {})
+        msg = str(cm.exception)
+        self.assertIn(f"Content: {redact(text)}", msg)
+        self.assert_content_free(msg)
+
+    def test_transformed_region_message_has_digests_not_text(self):
+        from sglang.srt.parser.chat_parsing.content_parsers import _json
+
+        text = "{note: " + PROMPT
+        with self.assertRaises(ValueError) as cm:
+            _json(text, {"unquoted_keys": True})
+        msg = str(cm.exception)
+        self.assertIn(f"Original: {redact(text)}", msg)
+        self.assertIn("Transformed: <str len=", msg)
+        self.assert_content_free(msg)
+
+
+class _FakeTokenizerManager:
+    def __init__(self, exc: Exception):
+        self.exc = exc
+
+    def generate_request(self, obj, request):
+        exc = self.exc
+
+        async def gen():
+            raise exc
+            yield  # pragma: no cover
+
+        return gen()
+
+    def create_abort_task(self, obj):
+        return None
+
+
+class TestHttpServerGenerateErrorLog(_ContentFreeMixin, unittest.TestCase):
+    LOGGER = "sglang.srt.entrypoints.http_server"
+
+    def _serve(self, stream: bool):
+        from sglang.srt.entrypoints import http_server
+        from sglang.srt.managers.io_struct import GenerateReqInput
+
+        exc = ValueError(f"cannot tokenize prompt {PROMPT!r} ids={INPUT_IDS}")
+        obj = GenerateReqInput(text=PROMPT, stream=stream, rid="rid-http-1")
+        saved = http_server.get_global_state()
+        http_server.set_global_state(
+            SimpleNamespace(tokenizer_manager=_FakeTokenizerManager(exc))
+        )
+        try:
+
+            async def run():
+                resp = await http_server.serve_generate_request(obj, None)
+                if not stream:
+                    return resp.body
+                chunks = []
+                async for chunk in resp.body_iterator:
+                    chunks.append(chunk)
+                return b"".join(chunks)
+
+            with self.assertLogs(self.LOGGER, level=logging.ERROR) as logs:
+                body = asyncio.run(run())
+        finally:
+            http_server.set_global_state(saved)
+        return logs.records, body
+
+    def _check(self, records, body):
+        self.assertEqual(len(records), 1)
+        msg = records[0].getMessage()
+        self.assertIn("[http_server] Error: rid=rid-http-1 ValueError(<str len=", msg)
+        self.assert_content_free(msg)
+        # The client still gets its own error message.
+        self.assertIn(b"hunter2", body)
+
+    def test_non_stream_error_log_is_content_free(self):
+        self._check(*self._serve(stream=False))
+
+    def test_stream_error_log_is_content_free(self):
+        self._check(*self._serve(stream=True))
+
+
+class TestRedactedTraceback(_ContentFreeMixin, unittest.TestCase):
+    def test_chain_frames_kept_messages_redacted(self):
+        def inner():
+            json.loads("{" + PROMPT)
+
+        def outer():
+            try:
+                inner()
+            except ValueError as e:
+                raise RuntimeError(f"tool call failed on {PROMPT}") from e
+
+        try:
+            outer()
+        except RuntimeError as e:
+            out = redacted_traceback(e)
+        self.assert_content_free(out)
+        self.assertIn("Traceback (most recent call last):", out)
+        self.assertIn("in inner", out)
+        self.assertIn("in outer", out)
+        self.assertIn("direct cause of the following exception", out)
+        self.assertTrue(
+            out.endswith(redact_exc(RuntimeError(f"tool call failed on {PROMPT}")))
+        )
+        # JSONDecodeError's own message is positions only, so it is kept.
+        self.assertIn("JSONDecodeError(Expecting property name enclosed", out)
+
+    def test_implicit_context_and_syntax_error(self):
+        import ast
+
+        try:
+            try:
+                ast.parse("f(" + PROMPT)
+            except SyntaxError:
+                raise KeyError(PROMPT)
+        except KeyError as e:
+            out = redacted_traceback(e)
+        self.assert_content_free(out)
+        self.assertIn("SyntaxError(<str len=", out)
+        self.assertIn("During handling of the above exception", out)
+
+    def test_exception_without_traceback(self):
+        out = redacted_traceback(ValueError(PROMPT))
+        self.assertEqual(out, redact_exc(ValueError(PROMPT)))
+
+    def test_redact_exc_json_decode_error_keeps_position_message(self):
+        try:
+            json.loads('{"a": ' + PROMPT)
+        except json.JSONDecodeError as e:
+            out = redact_exc(e)
+        self.assertEqual(
+            out, "JSONDecodeError(Expecting value: line 1 column 7 (char 6))"
+        )
+
+    def test_token_id_array_is_ids_digest(self):
+        self.assertEqual(redact(array("q", INPUT_IDS)), redact(INPUT_IDS))
+
+
+class TestDetectorErrorLog(_ContentFreeMixin, unittest.TestCase):
+    def test_pythonic_parse_failure_logs_no_model_text(self):
+        from sglang.srt.function_call import pythonic_detector
+        from sglang.srt.function_call.pythonic_detector import PythonicDetector
+
+        def boom(*args, **kwargs):
+            raise ValueError(f"cannot parse {PROMPT}")
+
+        detector = PythonicDetector()
+        text = "[get_weather(city='" + PROMPT + "')]"
+        orig = pythonic_detector.safe_ast_parse
+        pythonic_detector.safe_ast_parse = boom
+        try:
+            with self.assertLogs(pythonic_detector.logger, level=logging.ERROR) as logs:
+                detector.detect_and_parse(text, tools=[])
+        finally:
+            pythonic_detector.safe_ast_parse = orig
+        msg = "\n".join(r.getMessage() for r in logs.records)
+        self.assertIn("Error in pythonic tool call parsing: ValueError(<str len=", msg)
+        self.assertIn("Traceback (most recent call last):", msg)
+        self.assert_content_free(msg)
+
+
+class _Completion:
+    def __init__(self, exc: Exception):
+        self.exc = exc
+
+    def done(self):
+        return True
+
+    def result(self):
+        raise self.exc
+
+    def cancel(self):
+        raise self.exc
+
+
+class TestDeferredResponseErrorLog(_ContentFreeMixin, unittest.TestCase):
+    LOGGER = "sglang.srt.managers.scheduler"
+
+    def _fake(self, exc):
+        req = _make_req()
+        fake = SimpleNamespace(
+            _deferred_responses={req.rid: (req, _Completion(exc))},
+            aborted=[],
+        )
+        fake._abort_deferred_response = lambda r, reason: fake.aborted.append(
+            (r, reason)
+        )
+        return req, fake
+
+    def _check(self, logs, phrase):
+        self.assertEqual(len(logs.records), 1)
+        msg = logs.records[0].getMessage()
+        self.assertIn(f"{phrase} for rid-redact-1: ValueError(<str len=", msg)
+        self.assertIn("Traceback (most recent call last):", msg)
+        self.assert_content_free(msg)
+
+    def test_failed_completion_logs_no_request_content(self):
+        from sglang.srt.managers.scheduler import Scheduler
+
+        exc = ValueError(f"deferred work failed on {PROMPT!r} ids={INPUT_IDS}")
+        req, fake = self._fake(exc)
+        with self.assertLogs(self.LOGGER, level=logging.ERROR) as logs:
+            Scheduler.stream_released_deferred_outputs(fake)
+        self._check(logs, "Deferred response failed")
+        self.assertEqual([r for r, _ in fake.aborted], [req])
+        self.assertEqual(fake._deferred_responses, {})
+
+    def test_failed_cancel_logs_no_request_content(self):
+        from sglang.srt.managers.scheduler import Scheduler
+
+        exc = ValueError(f"cannot cancel work on {PROMPT!r} ids={INPUT_IDS}")
+        req, fake = self._fake(exc)
+        recv_req = SimpleNamespace(abort_all=True, rid="", finished_reason=None)
+        with self.assertLogs(self.LOGGER, level=logging.ERROR) as logs:
+            Scheduler._abort_deferred_responses(fake, recv_req)
+        self._check(logs, "Failed to cancel deferred work")
+        self.assertEqual([r for r, _ in fake.aborted], [req])
+
+
+class TestCustomLabelsHeaderErrorLog(_ContentFreeMixin, unittest.TestCase):
+    def test_unparseable_header_logs_no_header_value(self):
+        from unittest import mock
+
+        from sglang.srt.entrypoints.openai import serving_base
+
+        header = "x-custom-labels"
+        value = "{" + PROMPT
+
+        class _QuotingDecodeError(json.JSONDecodeError):
+            # A decoder whose error message quotes the document it rejected.
+            def __str__(self):
+                return f"{self.msg}: {self.doc!r}"
+
+        def loads(doc):
+            raise _QuotingDecodeError("bad labels", doc, 1)
+
+        fake = SimpleNamespace(allowed_custom_labels={"team"})
+        request = SimpleNamespace(headers={header: value})
+        observability = SimpleNamespace(tokenizer_metrics_custom_labels_header=header)
+        with (
+            mock.patch.object(
+                serving_base, "get_observability", return_value=observability
+            ),
+            mock.patch.object(serving_base.orjson, "loads", loads),
+            self.assertLogs(serving_base.logger, level=logging.ERROR) as logs,
+        ):
+            labels = serving_base.OpenAIServingBase.extract_custom_labels(fake, request)
+        self.assertIsNone(labels)
+        self.assertEqual(len(logs.records), 1)
+        msg = logs.records[0].getMessage()
+        self.assertIn("Error in request: _QuotingDecodeError(<str len=", msg)
+        self.assertIn("Traceback (most recent call last):", msg)
+        self.assert_content_free(msg)
+
+
+if __name__ == "__main__":
+    unittest.main()
