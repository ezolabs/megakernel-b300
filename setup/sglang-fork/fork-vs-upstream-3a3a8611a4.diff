+        out_cache_loc=replay.out_cache_loc,
+        req_pool_indices=replay.req_pool_indices,
+        encoder_swa_replay=False,
+        encoder_swa_row_floor=None,
+        late_tail_prompt_lens=getattr(replay, "late_tail_prompt_lens", None),
+        late_tail_floor_gs=getattr(replay, "late_tail_floor_gs", None),
+    )
