+def test_a_placeholder_messages_body_gets_the_same_response(tokenizer, box_c_env):
+    """The non-streaming answer. ``_build_chat_response`` reads ``request.messages`` in two
+    places: ``ReasoningParser.__init__`` (the last message, under ``continue_final_message``)
+    and ``_get_history_tool_calls_cnt`` (the history's tool calls, for a kimi tool-call id).
+    Each body is answered with a scripted model output (its reasoning when thinking is on,
+    an answer, a DSv4.1 tool call when the request may call one) and the two responses must
+    be the same, tool-call ids included."""
+    chat = _handler(tokenizer)
+    answers, called, reasoned = {}, [], []
+    for record in RECORDS:
+        _, real, _ = _convert(chat, record["egress"], record["router_ids"])
+        _, placeholder, _ = _convert_with_placeholder(chat, record)
+        text = _engine_text(chat, real)
+        a, b = _respond(chat, real, text), _respond(chat, placeholder, text)
+        assert isinstance(a, ChatCompletionResponse), record["id"]
+        assert _wire(a) == _wire(b), record["id"]
+        answers[record["id"]] = a
+        message = a.choices[0].message
+        if message.tool_calls:
+            called.append(record["id"])
+        if message.reasoning_content:
+            reasoned.append(record["id"])
+    # The parse ran: a tool call wherever the request may call one, reasoning wherever
+    # thinking is on.
+    may_call = [
+        r["id"]
+        for r in RECORDS
+        if r["egress"].get("tools") and r["egress"]["tool_choice"] != "none"
+    ]
+    assert called == may_call and len(may_call) == 117
+    assert len(reasoned) == 43
+    example = answers["thinking-tool-01/turn2"]
+    message = example.choices[0].message
+    assert message.reasoning_content == _REASONING
+    assert message.content == _ANSWER
+    assert [c.function.name for c in message.tool_calls] == ["get_weather"]
+    assert message.tool_calls[0].function.arguments == json.dumps(
+        _ARGUMENTS, ensure_ascii=False
+    )
+    assert example.choices[0].finish_reason == "tool_calls"
