@@ -0,0 +1,835 @@
+"""CPU checks for the exact decoder trim (SGLANG_DSV4_EXACT_DECODER_TRIM).
+
+The late layers of a decoder SWA bounded replay run on a floored tail. The replay
+below tracks, row by row, whether each late layer's output and KV equal full
+prefill, so the cone claimed in exact_decoder_trim.py is checked against a
+simulation rather than only against its closed form.
+"""
+
+import random
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import torch
+
+from sglang.kernels.ops.attention.dsv4.attn_metadata_kernels import (
+    late_layer_tail_layout,
+    late_layer_tail_lens,
+)
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention import deepseek_v4_backend
+from sglang.srt.layers.attention.deepseek_v4_backend import (
+    DeepseekV4AttnBackend,
+    late_layer_num_tokens,
+)
+from sglang.srt.layers.attention.dsv4.exact_decoder_trim import (
+    CONE,
+    LATE_DEPTH,
+    exact_tail_len,
+    final_window_is_exact,
+    late_exact_from_after_extend,
+    late_extend_floor,
+    late_window_ok,
+    match_cap,
+    match_late_floor,
+    page_floor,
+    prefix_late_exact_from,
+    tail_floor,
+    tail_rows_bound,
+)
+from sglang.srt.model_executor.forward_batch_info import (
+    CaptureHiddenMode,
+    ForwardMode,
+)
+from sglang.srt.models import deepseek_v4_replay_tail
+from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=5, suite="base-a-test-cpu")
+
+WINDOW = 128
+NUM_LAYERS = 40
+LATE_START = 20  # max(kv_source_layer_ids) of DeepSeek-V4.1-Flash-1017
+PAGE = 256
+TAIL = 2560  # exact_tail_len(128, 40, 20, 256)
+
+
+def replay_flags(
+    chunk_ends,
+    tail_len,
+    *,
+    page=PAGE,
+    prefix=0,
+    prefix_exact=True,
+    min_floor=0,
+    skip_ends=(),
+    floors=None,
+):
+    """Row-exact replay of the late layers over a chunked prefill.
+
+    Chunk i runs [chunk_ends[i-1], chunk_ends[i]) (the first from ``prefix``,
+    the rows a prefix hit reuses: exact when ``prefix_exact``, else missing).
+    Its late layers run rows [max(start, floor), end) and write their KV, with
+    each row's window floored at floor = max(page_floor(end) - tail_len,
+    min_floor, 0), the page-anchored exact tail (end - tail_len when page is
+    None). A chunk end in ``skip_ends`` is far-skipped: its late layers run
+    only row end - 1, floored there. ``floors`` collects (start, end, floor).
+    Returns (computed, exact), dicts keyed by late layer: computed[l][t] says
+    layer l wrote row t's KV, exact[l][t] says its output equals full prefill.
+    Layers below LATE_START run every row, so they are exact everywhere.
+    """
+    total = chunk_ends[-1]
+    late = range(LATE_START, NUM_LAYERS)
+    computed = {l: np.zeros(total, bool) for l in late}
+    exact = {l: np.zeros(total, bool) for l in late}
+    if prefix_exact:
+        for l in late:
+            computed[l][:prefix] = True
+            exact[l][:prefix] = True
+    start = prefix
+    for end in chunk_ends:
+        if end in skip_ends:
+            floor = end - 1
+        else:
+            anchor = end if page is None else end // page * page
+            floor = max(anchor - tail_len, min_floor, 0)
+        rows = np.arange(max(start, floor), end)
+        if floors is not None:
+            floors.append((start, end, floor))
+        for l in late:
+            computed[l][rows] = True
+        cut = np.maximum(rows - WINDOW + 1, 0)
+        for l in late:
+            # bad[r]: row r's KV of layer l is missing or inexact
+            bad = ~computed[l]
+            if l > LATE_START:
+                bad = bad | ~exact[l - 1]
+            prefix_bad = np.concatenate([[0], np.cumsum(bad)])
+            exact[l][rows] = (cut >= floor) & (prefix_bad[rows + 1] == prefix_bad[cut])
+        start = end
+    return computed, exact
+
+
+def node_window_exact(computed, exact, end):
+    """Every late layer's SWA KV over the node's last WINDOW rows is exact."""
+    rows = range(max(0, end - WINDOW), end)
+    if not all(computed[LATE_START][r] for r in rows):
+        return False
+    return all(exact[l][r] for l in range(LATE_START, NUM_LAYERS - 1) for r in rows)
+
+
+class TestExactTailLen(unittest.TestCase):
+    def test_flagship_config_gives_2560(self):
+        self.assertEqual(
+            exact_tail_len(
+                window=WINDOW,
+                num_layers=NUM_LAYERS,
+                late_layer_start=LATE_START,
+                page_size=PAGE,
+            ),
+            TAIL,
+        )
+
+    def test_unrounded_minimum_is_2541(self):
+        self.assertEqual(
+            exact_tail_len(
+                window=WINDOW,
+                num_layers=NUM_LAYERS,
+                late_layer_start=LATE_START,
+                page_size=1,
+            ),
+            WINDOW + 19 * (WINDOW - 1),
+        )
+
+    def test_rejects_bad_arguments(self):
+        with self.assertRaises(ValueError):
+            exact_tail_len(
+                window=WINDOW,
+                num_layers=NUM_LAYERS,
+                late_layer_start=40,
+                page_size=PAGE,
+            )
+        with self.assertRaises(ValueError):
+            exact_tail_len(
+                window=0,
+                num_layers=NUM_LAYERS,
+                late_layer_start=LATE_START,
+                page_size=PAGE,
+            )
+
+
+class TestClosedFormMatchesReplay(unittest.TestCase):
+    def test_single_extend_boundary(self):
+        B = 3200
+        for tail, expect in (
+            (2541, True),
+            (2540, False),
+            (TAIL, True),
+            (WINDOW, False),
+        ):
+            with self.subTest(tail=tail):
+                closed = final_window_is_exact(
+                    B,
+                    tail,
+                    window=WINDOW,
+                    num_layers=NUM_LAYERS,
+                    late_layer_start=LATE_START,
+                )
+                computed, exact = replay_flags([B], tail, page=None)
+                self.assertEqual(closed, expect)
+                self.assertEqual(exact[NUM_LAYERS - 1][B - 1], expect)
+                self.assertEqual(node_window_exact(computed, exact, B), expect)
+
+    def test_chunked_prefill_exact_for_any_chunking(self):
+        B = 3200
+        rng = random.Random(0)
+        for trial in range(3):
+            ends, pos = [], 0
+            while pos < B:
+                pos = min(B, pos + rng.randint(1, 1500))
+                ends.append(pos)
+            with self.subTest(trial=trial, chunk_ends=ends):
+                computed, exact = replay_flags(ends, TAIL)
+                self.assertTrue(exact[NUM_LAYERS - 1][B - 1])
+                for end in ends:
+                    self.assertTrue(node_window_exact(computed, exact, end), end)
+
+    def test_lossy_tail_is_not_exact_when_chunked(self):
+        B = 3200
+        computed, exact = replay_flags([1000, 2000, B], WINDOW)
+        self.assertFalse(exact[NUM_LAYERS - 1][B - 1])
+
+
+def kv_good(computed, exact, l, end):
+    """Rows of [0, end) where late layer l's KV is computed and exact."""
+    good = computed[l][:end].copy()
+    if l > LATE_START:
+        good &= exact[l - 1][:end]
+    return good
+
+
+def replay_late_exact_from(computed, exact, end):
+    """E-tracking replay: the first row from which every late layer's KV is
+    computed and exact through end."""
+    good = np.ones(end, bool)
+    for l in range(LATE_START, NUM_LAYERS):
+        good &= kv_good(computed, exact, l, end)
+    bad = np.flatnonzero(~good)
+    return 0 if bad.size == 0 else int(bad[-1]) + 1
+
+
+def window_exact(computed, exact, boundary):
+    """Every late layer's KV over the window ending at boundary is exact."""
+    lo = max(0, boundary - WINDOW)
+    return all(
+        kv_good(computed, exact, l, boundary)[lo:].all()
+        for l in range(LATE_START, NUM_LAYERS)
+    )
+
+
+def random_schedule(rng, *, aligned, hit):
+    """(P, prefix hit m, chunk ends after m), page-aligned or unaligned chunks.
+    An invalid hit (prefix late KV missing) is capped at page_floor(P) - TAIL,
+    as the scheduler caps it."""
+    P = rng.randint(TAIL + 3 * PAGE, 14000)
+    if hit == "cold":
+        m = 0
+    elif hit == "valid":
+        m = page_floor(rng.randint(PAGE, P - 1), PAGE)
+    else:
+        m = page_floor(rng.randint(PAGE, page_floor(P, PAGE) - TAIL), PAGE)
+    ends, pos = [], m
+    while pos < P:
+        if aligned:
+            step = rng.choice([256, 512, 2048, 4096, 8192])
+        else:
+            step = rng.choice(
+                [rng.randint(1, 300), rng.randint(1, 3000), rng.randint(2000, 6000)]
+            )
+        pos = min(P, pos + step)
+        ends.append(pos)
+    return P, m, ends
+
+
+def run_schedule(P, m, ends, *, hit, far_skip, g_floor=False):
+    """Replay a request and its E recurrence. far_skip skips chunks with
+    end <= page_floor(P) - TAIL. g_floor floors every chunk at an invalid hit
+    (G = m), else G = 0 as the backend does.
+    Returns (computed, exact, per-chunk [(start, end, floor, E)])."""
+    threshold = page_floor(P, PAGE) - TAIL
+    skips = {e for e in ends if far_skip and e < P and e <= threshold}
+    floors = []
+    computed, exact = replay_flags(
+        ends,
+        TAIL,
+        prefix=m,
+        prefix_exact=(hit == "valid"),
+        skip_ends=skips,
+        min_floor=m if (hit == "invalid" and g_floor) else 0,
+        floors=floors,
+    )
+    # A prefix whose late KV is unknown claims E = m + CONE.
+    E = m + CONE if hit == "invalid" else 0
+    out = []
+    for start, end, floor in floors:
+        E = late_exact_from_after_extend(start, end, floor, E, WINDOW)
+        out.append((start, end, floor, E))
+    return computed, exact, out
+
+
+class TestPageAnchoredTail(unittest.TestCase):
+    def test_constants(self):
+        self.assertEqual(LATE_DEPTH, NUM_LAYERS - 1 - LATE_START)
+        self.assertEqual(CONE, 19 * 127)
+        self.assertEqual(CONE + WINDOW, 2541)
+        self.assertEqual(tail_rows_bound(TAIL, PAGE), 2815)
+
+    def test_tail_floor(self):
+        self.assertEqual(tail_floor(10000, PAGE, TAIL), 9984 - TAIL)
+        self.assertEqual(tail_floor(9984, PAGE, TAIL), 9984 - TAIL)
+        self.assertEqual(tail_floor(2000, PAGE, TAIL), 0)
+        self.assertEqual(tail_floor(10000, PAGE, TAIL, min_floor=8000), 8000)
+        for seq in range(1, 6000, 37):
+            self.assertLessEqual(seq - tail_floor(seq, PAGE, TAIL), TAIL + PAGE - 1)
+
+    def test_window_ok_edges(self):
+        self.assertTrue(late_window_ok(0, 50, WINDOW))
+        self.assertFalse(late_window_ok(1, 50, WINDOW))
+        self.assertTrue(late_window_ok(372, 500, WINDOW))
+        self.assertFalse(late_window_ok(373, 500, WINDOW))
+
+    def test_recurrence_branches(self):
+        # Cold extend floored at 0: every row exact.
+        self.assertEqual(late_exact_from_after_extend(0, 2000, 0, 0, WINDOW), 0)
+        # A floor above the start: the cone grows from the floor.
+        self.assertEqual(
+            late_exact_from_after_extend(0, 10000, 7424, 0, WINDOW), 7424 + CONE
+        )
+        # Floor and cached rows well below the start: E holds.
+        self.assertEqual(
+            late_exact_from_after_extend(10000, 10200, 7424, 9837, WINDOW), 9837
+        )
+        # A floor within W - 1 rows of the start cuts the next rows' windows.
+        self.assertEqual(
+            late_exact_from_after_extend(10000, 12544, 9984, 9837, WINDOW),
+            9984 + CONE,
+        )
+        # Far-skipped chunk (one tail row): no late-exact row.
+        self.assertGreater(
+            late_exact_from_after_extend(4000, 8000, 7999, 0, WINDOW), 8000
+        )
+        with self.assertRaises(ValueError):
+            late_exact_from_after_extend(10, 5, 0, 0, WINDOW)
+
+    def test_random_chunkings_match_replay(self):
+        rng = random.Random(0)
+        checked = {"windows": 0, "chunks": 0, "end_exact": 0, "hits": 0}
+        for trial in range(180):
+            aligned = trial % 2 == 0
+            hit = ("cold", "valid", "invalid")[trial % 3]
+            far_skip = trial % 4 >= 2
+            g_floor = hit == "invalid" and trial % 5 == 0
+            P, m, ends = random_schedule(rng, aligned=aligned, hit=hit)
+            computed, exact, chunks = run_schedule(
+                P, m, ends, hit=hit, far_skip=far_skip, g_floor=g_floor
+            )
+            ctx = dict(trial=trial, P=P, m=m, ends=ends, hit=hit, far_skip=far_skip)
+            for start, end, floor, E in chunks:
+                checked["chunks"] += 1
+                truth = replay_late_exact_from(computed, exact, end)
+                # (d) the recurrence is sound, and exact once any row is late-exact
+                self.assertGreaterEqual(E, truth, (ctx, start, end, floor))
+                if truth < end:
+                    self.assertEqual(E, truth, (ctx, start, end, floor))
+                # (a) predicate-marked windows are exact: 0 false positives
+                for b in list(range(PAGE, end + 1, PAGE)) + [end]:
+                    if b > m and late_window_ok(E, b, WINDOW):
+                        checked["windows"] += 1
+                        self.assertTrue(
+                            window_exact(computed, exact, b), (ctx, start, end, b, E)
+                        )
+            if g_floor:
+                continue
+            # (b) the final window AT P and the logits are exact
+            E = chunks[-1][3]
+            self.assertTrue(exact[NUM_LAYERS - 1][P - 1], ctx)
+            self.assertTrue(window_exact(computed, exact, P), ctx)
+            self.assertTrue(late_window_ok(E, P, WINDOW), ctx)
+            checked["end_exact"] += 1
+            # (c) a hit at page_floor(P) is late-exact
+            b = page_floor(P, PAGE)
+            if b > m:
+                self.assertTrue(window_exact(computed, exact, b), ctx)
+                self.assertTrue(late_window_ok(E, b, WINDOW), ctx)
+                checked["hits"] += 1
+        for key, n in checked.items():
+            self.assertGreater(n, 20, (key, checked))
+
+
+LATE = range(LATE_START, NUM_LAYERS)
+
+
+def advance_flags(computed, exact, start, chunks, total):
+    """replay_flags from a given prefix state: rows below start keep computed /
+    exact from the tree, rows from start on run the chunks [(end, floor)]."""
+    comp = {l: np.zeros(total, bool) for l in LATE}
+    ex = {l: np.zeros(total, bool) for l in LATE}
+    for l in LATE:
+        comp[l][:start] = computed[l][:start]
+        ex[l][:start] = exact[l][:start]
+    for end, floor in chunks:
+        rows = np.arange(max(start, floor), end)
+        for l in LATE:
+            comp[l][rows] = True
+        cut = np.maximum(rows - WINDOW + 1, 0)
+        for l in LATE:
+            bad = ~comp[l]
+            if l > LATE_START:
+                bad = bad | ~ex[l - 1]
+            prefix_bad = np.concatenate([[0], np.cumsum(bad)])
+            ex[l][rows] = (cut >= floor) & (prefix_bad[rows + 1] == prefix_bad[cut])
+        start = end
+    return comp, ex
+
+
+def node_claim(path, b):
+    """late_exact_from of the path node holding boundary b (a split node keeps
+    its claim); 0 at the root."""
+    if b == 0:
+        return 0
+    for s, e, late in path:
+        if s < b <= e:
+            return late
+    raise AssertionError((path, b))
+
+
+def decide_match(path, hit, P, *, whole):
+    """The scheduler's decision (UnifiedRadixCache._exact_trim_cap_match) on a
+    path of nodes [(start, end, late_exact_from)]: (m, node claim, G)."""
+    m = hit
+    while True:
+        late = node_claim(path, m)
+        G = match_late_floor(
+            m, late, P, whole_extend=whole, window=WINDOW, page=PAGE, tail_len=TAIL
+        )
+        if G is not None:
+            return m, late, G
+        deepest = max(
+            [
+                min(e, m)
+                for s, e, claim in path
+                if s < m
+                and claim is not None
+                and late_window_ok(claim, min(e, m), WINDOW)
+            ],
+            default=0,
+        )
+        cap = match_cap(P, deepest, whole_extend=whole, page=PAGE, tail_len=TAIL)
+        assert cap < m, (cap, m)
+        m = cap
+
+
+def random_ends(rng, start, P):
+    ends, pos = [], start
+    while pos < P:
+        step = rng.choice(
+            [
+                rng.choice([256, 2048, 8192]),
+                rng.randint(1, 300),
+                rng.randint(1, 3000),
+                rng.randint(2000, 6000),
+            ]
+        )
+        pos = min(P, pos + step)
+        ends.append(pos)
+    return ends
+
+
+class TestMatchCapAcrossRequests(unittest.TestCase):
+    """Request 1 writes nodes (its far-skipped chunks leave inexact late rows,
+    stamped honestly); request 2 matches them through the match decision and
+    writes on; request 3 matches request 2's nodes. The tree keeps the first
+    writer's rows where requests overlap. For every request kept by the
+    decision: the E recurrence is sound against the replay, the final window
+    and logits are exact, a whole extend's every row is exact, and every node
+    stamped late-exact is."""
+
+    def run_request(self, rng, tree, path, hit, P, *, whole, apply_g, far_skip):
+        comp0, ex0 = tree
+        m, claim, G = decide_match(path, hit, P, whole=whole)
+        E = prefix_late_exact_from(m, claim, WINDOW)
+        threshold = page_floor(P, PAGE) - TAIL
+        chunks, stamps, start = [], [], m
+        for end in random_ends(rng, m, P):
+            if far_skip and end < P and end <= threshold:
+                actual = model = end - 1
+            else:
+                if whole:
+                    actual = max(0, start - TAIL)
+                else:
+                    actual = tail_floor(end, PAGE, TAIL, G if apply_g else 0)
+                model = late_extend_floor(
+                    start,
+                    end,
+                    whole_extend=whole,
+                    late_floor_g=G,
+                    page=PAGE,
+                    tail_len=TAIL,
+                )
+                self.assertGreaterEqual(model, actual)
+            E = late_exact_from_after_extend(start, end, model, E, WINDOW)
+            chunks.append((end, actual))
+            stamps.append((start, end, E))
+            start = end
+        comp, ex = advance_flags(comp0, ex0, m, chunks, P)
+        ctx = dict(m=m, G=G, P=P, whole=whole, apply_g=apply_g, chunks=chunks)
+        # The claim is only ever read over the last W rows before a boundary
+        # (late_window_ok, the recurrence's prev); below the hit the tree may
+        # hold another writer's rows, so the replay ignores rows under m - W.
+        lo = max(0, m - WINDOW)
+        seen = (
+            {l: comp[l].copy() for l in LATE},
+            {l: ex[l].copy() for l in LATE},
+        )
+        for l in LATE:
+            seen[0][l][:lo] = True
+            seen[1][l][:lo] = True
+        for s, e, claim_e in stamps:
+            truth = replay_late_exact_from(*seen, e)
+            self.assertGreaterEqual(claim_e, truth, (ctx, s, e))
+        self.assertTrue(ex[NUM_LAYERS - 1][P - 1], ctx)
+        self.assertTrue(window_exact(comp, ex, P), ctx)
+        self.assertTrue(late_window_ok(E, P, WINDOW), ctx)
+        if whole:
+            self.assertTrue(ex[NUM_LAYERS - 1][m:P].all(), ctx)
+        return m, G, (comp, ex), stamps
+
+    @staticmethod
+    def grow_tree(tree, path, shared, req_flags, stamps, P):
+        """Insert a request's rows past the shared prefix: earlier nodes and
+        their rows win, new nodes are stamped per chunk at page floors."""
+        comp0, ex0 = tree
+        comp1, ex1 = req_flags
+        end_tree = page_floor(P, PAGE)
+        comp = {l: comp1[l][:end_tree].copy() for l in LATE}
+        ex = {l: ex1[l][:end_tree].copy() for l in LATE}
+        for l in LATE:
+            comp[l][:shared] = comp0[l][:shared]
+            ex[l][:shared] = ex0[l][:shared]
+        new_path = [(s, min(e, shared), c) for s, e, c in path if s < shared]
+        cursor = shared
+        for _, end, E in stamps:
+            b = page_floor(end, PAGE)
+            if b > cursor:
+                new_path.append((cursor, b, E))
+                cursor = b
+        return (comp, ex), new_path
+
+    def check_stamps(self, tree, path):
+        comp, ex = tree
+        for s, e, claim in path:
+            if claim is not None and late_window_ok(claim, e, WINDOW):
+                self.assertTrue(window_exact(comp, ex, e), (s, e, claim))
+
+    def test_three_requests(self):
+        rng = random.Random(4)
+        kinds = {"capped": 0, "late_floor": 0, "late_exact": 0, "whole": 0}
+        for trial in range(90):
+            apply_g = trial % 2 == 1
+            # Request 1: an unknown prefix (written with trim off) of L0 rows.
+            L0 = page_floor(rng.randint(0, 9000), PAGE)
+            P1 = rng.randint(max(L0, 1) + TAIL + 3 * PAGE, 22000)
+            empty = {l: np.zeros(L0, bool) for l in LATE}
+            tree = (empty, {l: np.zeros(L0, bool) for l in LATE})
+            path = [(0, L0, None)] if L0 else []
+            _, _, flags, stamps = self.run_request(
+                rng, tree, path, L0, P1, whole=False, apply_g=apply_g, far_skip=True
+            )
+            tree, path = self.grow_tree(tree, path, L0, flags, stamps, P1)
+            self.check_stamps(tree, path)
+            prev_P = P1
+            # Requests 2 and 3: each shares a page-aligned prefix of the last.
+            for _ in range(2):
+                d = page_floor(rng.randint(PAGE, prev_P), PAGE)
+                d = min(d, page_floor(prev_P, PAGE))
+                whole = rng.random() < 0.25
+                P = d + rng.randint(1, 9000)
+                m, G, flags, stamps = self.run_request(
+                    rng, tree, path, d, P, whole=whole, apply_g=apply_g, far_skip=False
+                )
+                if m < d:
+                    kinds["capped"] += 1
+                elif m and G:
+                    kinds["late_floor"] += 1
+                elif m:
+                    kinds["late_exact"] += 1
+                kinds["whole"] += whole
+                tree, path = self.grow_tree(tree, path, d, flags, stamps, P)
+                self.check_stamps(tree, path)
+                prev_P = P
+        for key, n in kinds.items():
+            self.assertGreater(n, 5, kinds)
+
