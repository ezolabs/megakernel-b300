+def test_a_placeholder_messages_body_has_no_history_tool_calls_to_count(
+    tokenizer, box_c_env
+):
+    """``_get_history_tool_calls_cnt`` is the one read of the history the response side
+    makes on every request. It counts the assistant ``tool_calls`` of the messages, so it
+    is 0 under the placeholder wherever the real count is not (45 bodies here), and it
+    reaches the output only through ``_process_tool_call_id`` for the kimi parsers; box-c's
+    ``deepseekv41`` draws a uuid whatever the count."""
+    chat = _handler(tokenizer)
+    with_history = 0
