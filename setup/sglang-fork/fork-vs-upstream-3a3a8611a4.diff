+# HiRadixCache is gone upstream: the unified tree is the only HiCache owner.
+@pytest.mark.parametrize("cache_cls_name", ["UnifiedRadixCache"])
+def test_check_hicache_events_obeys_the_gate(cache_cls_name):
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate
+
+    if cache_cls_name == "UnifiedRadixCache":
+        from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache as cls
+    else:
+        from sglang.srt.mem_cache.hiradix_cache import HiRadixCache as cls
+
+    cache = object.__new__(cls)
+    cache.tree_core = SimpleNamespace(enable_storage=False)
+    cache.pp_size = 1
+    cache.linker = None
+    # Upstream's poll flushes pending backups first.
+    cache.cache_controller = SimpleNamespace(start_writing=lambda: None)
+    cache.enable_storage = False
+    cache.enable_storage_metrics = False
+    cache.buffer_pipeline = None
+    cache.metrics_collector = None
+    cache._drain_async_work = MagicMock()
+    cache.writing_check = MagicMock()
+    cache.loading_check = MagicMock()
+    sync = MagicMock(
+        return_value=(1, 2, (), ())
+        if cls.__name__ == "UnifiedRadixCache"
+        else (1, 2, ())
+    )
+    cache._sync_hicache_ready_counts = sync
+
+    # No gate (a cache built without __init__): every call polls, as before.
+    cache.check_hicache_events()
+    assert sync.call_count == 1
+
+    cache.hicache_poll_gate = HiCachePollGate(lambda: False, heartbeat_calls=0)
+    cache.check_hicache_events()  # unarmed: polls
+    assert sync.call_count == 2
+    cache.hicache_poll_gate.arm()
+    for _ in range(5):
+        cache.check_hicache_events()
+    assert sync.call_count == 2
+    cache.writing_check.assert_called_with(finish_count=1)
+    assert cache.writing_check.call_count == 2
+    cache.hicache_poll_gate.note_hint(1)
+    cache.check_hicache_events()
+    assert sync.call_count == 3
+    cache.loading_check.assert_called_with(finish_count=2)
+
+    # PP > 1 keeps its per-step sync (upstream folds it into
+    # _sync_hicache_ready_counts), untouched by the gate even if armed.
+    cache.pp_size = 2
+    cache.check_hicache_events()
+    assert sync.call_count == 4
