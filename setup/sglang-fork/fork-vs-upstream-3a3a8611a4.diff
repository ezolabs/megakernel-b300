+++ b/.github/fork/self_hosted_runners.py
@@ -0,0 +1,771 @@
+#!/usr/bin/env python3
+"""Route this fork's reachable GitHub Actions jobs to our self-hosted runners.
+
+The fork (<sglang-fork>, default branch ``prod``) has no pull requests and
+never pushes to ``main``, so only some upstream workflows can ever start here.
+This script keeps the upstream workflow files close to upstream while making
+the ones that can start run on demand on our runners:
+
+* It removes every ``schedule`` trigger from ``on:`` in every workflow, adding
+  ``workflow_dispatch`` only when nothing else is left. A ``schedule:`` key goes
+  with its cron items (indented or at the same column) and the comment block
+  right above it; ``on: schedule``, ``on: [..., schedule]`` and a ``- schedule``
+  block-list item are rewritten in place. A form it cannot rewrite (an ``on:``
+  flow mapping, a multi-line flow list) is refused: ``--apply`` exits 1 naming
+  ``file:line``. The fork's own workflows (``fork-*.yml``, never upstream's)
+  keep their schedules: ``fork-runner-image.yml`` rebuilds the runner image
+  weekly.
+* In the fork-reachable set (workflows with a trigger that can fire here, plus
+  the reusable workflows and local actions they call, transitively) it rewrites
+  GitHub-hosted runner labels to our self-hosted labels, in runner positions
+  only: ``runs-on:``, matrix ``runner:`` values, reusable-workflow runner inputs
+  (``with: runs_on:`` and friends) and the defaults of those inputs.
+
+It edits the YAML text line by line (stdlib only, no YAML round-trip) so the
+diff against upstream holds only removed schedule lines and changed labels.
+Comments, ``if:`` conditions, hardware labels and repository guards are never
+touched.
+
+Usage:
+    python3 .github/fork/self_hosted_runners.py --apply   # rewrite in place
+    python3 .github/fork/self_hosted_runners.py --check   # exit 1 on leftovers
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from collections import Counter
+from dataclasses import dataclass, field
+from pathlib import Path
+
+FORK_DEFAULT_BRANCH = "prod"
+
+WORKFLOWS_DIR = Path(".github/workflows")
+LOCAL_WORKFLOW_PREFIX = "./.github/workflows/"
+LOCAL_ACTION_PREFIX = "./.github/actions/"
+# The fork's own workflows: their schedules are ours, so they stay.
+FORK_OWNED_WORKFLOW = re.compile(r"fork-[^/]*\.ya?ml")
+
+# Events that can start a workflow in the fork. `push` is judged by its filters.
+REACHABLE_EVENTS = frozenset(
+    {
+        "workflow_dispatch",
+        "workflow_run",
+        "repository_dispatch",
+        "issues",
+        "issue_comment",
+    }
+)
+
+# GitHub-hosted label (full match) -> our self-hosted label.
+LABEL_RULES: tuple[tuple[re.Pattern[str], str], ...] = (
+    (re.compile(r"ubuntu-(?:latest|22\.04|24\.04)"), "arc-sglang"),
+    (re.compile(r"ubuntu-\d\d\.04-arm"), "sglang-linux-arm64"),
+    (re.compile(r"macos-(?:latest|\d+)"), "sglang-macos"),
+    (re.compile(r"windows-(?:latest|20\d\d)"), "sglang-windows"),
+)
+# Anything shaped like a hosted image label, mapped or not.
+HOSTED_LABEL = re.compile(r"(?:ubuntu|macos|windows)-[A-Za-z0-9._-]+")
+# Hosted macOS images that are Intel-only; our macOS runner (iris2) is ARM64.
+INTEL_ONLY_MACOS = re.compile(r"macos-1[0-3](?:-.*)?")
+
+# Composed labels, rewritten by exact string.
+COMPOSED_LABELS: dict[str, str] = {
+    "${{ matrix.os }}-latest": (
+        "${{ fromJSON('{\"ubuntu\":\"arc-sglang\",\"macos\":\"sglang-macos\","
+        "\"windows\":\"sglang-windows\"}')[matrix.os] }}"
+    ),
+}
+
+# Reusable-workflow inputs that carry a runner label.
+RUNNER_INPUT_KEYS = frozenset({"runs_on", "collect_runs_on", "restore_runs_on", "runner"})
+
+KEY_RE = re.compile(
+    r"""(?P<key>"[^"]*"|'[^']*'|[A-Za-z0-9_][A-Za-z0-9_.\-]*)[ \t]*:(?:[ \t]+(?P<rest>.*)|[ \t]*$)"""
+)
+BLOCK_SCALAR_RE = re.compile(r"[|>][-+0-9]*")
+EXPRESSION_RE = re.compile(r"\$\{\{.*?\}\}")
+FLOW_ITEM_RE = re.compile(r"""(?P<lead>[\[,]\s*)(?P<item>"[^"]*"|'[^']*'|[^,\[\]\s][^,\]]*?)(?P<trail>\s*)(?=[,\]])""")
+
+
+@dataclass
+class Line:
+    """One physical line of a YAML file, annotated with its structural context."""
+
+    no: int
+    text: str
+    ending: str
+    indent: int
+    path: tuple[str, ...] = ()
+    key: str | None = None
+    # Column span of the value (comment excluded) within `text`.
+    value_start: int = 0
+    value_end: int = 0
+    is_item: bool = False  # a "- scalar" list item without a key
+    in_block: bool = False  # inside a block scalar (`run: |` ...)
+    is_comment: bool = False
+    is_blank: bool = False
+
+    @property
+    def value(self) -> str:
+        return self.text[self.value_start : self.value_end]
+
+
+@dataclass
+class Finding:
+    path: Path
+    line: int
+    message: str
+
+    def __str__(self) -> str:
+        return f"{self.path.as_posix()}:{self.line}: {self.message}"
+
+
+@dataclass
+class FileResult:
+    path: Path
+    original: str
+    lines: list[Line]
+    schedules_removed: int = 0
+    dispatch_added: bool = False
+    label_rewrites: Counter[str] = field(default_factory=Counter)
+    problems: list[Finding] = field(default_factory=list)
+
+    @property
+    def text(self) -> str:
+        return "".join(line.text + line.ending for line in self.lines)
+
+    @property
+    def changed(self) -> bool:
+        return self.text != self.original
+
+
+def _unquote(key: str) -> str:
+    if len(key) >= 2 and key[0] == key[-1] and key[0] in "\"'":
+        return key[1:-1]
+    return key
+
+
+def _comment_start(text: str, start: int) -> int:
+    """Index of a `#` comment in text[start:], or len(text)."""
+    quote = ""
+    for i in range(start, len(text)):
+        ch = text[i]
+        if quote:
+            if ch == quote:
+                quote = ""
+        elif ch in "\"'" and (i == start or text[i - 1] in " \t[,{:"):
+            quote = ch
+        elif ch == "#" and (i == start or text[i - 1] in " \t"):
+            return i
+    return len(text)
+
+
+def parse(text: str) -> list[Line]:
+    """Split YAML into lines annotated with the key path that contains each."""
+    lines: list[Line] = []
+    stack: list[tuple[int, str]] = []  # (column, key) or (column, "-") for list items
+    block_col: int | None = None
+    for no, raw in enumerate(text.splitlines(keepends=True), start=1):
+        body = raw.rstrip("\r\n")
+        ending = raw[len(body) :]
+        stripped = body.lstrip(" ")
+        indent = len(body) - len(stripped)
+        line = Line(no=no, text=body, ending=ending, indent=indent)
+        lines.append(line)
+        if block_col is not None:
+            if not stripped.strip() or indent > block_col:
+                line.in_block = True
+                line.path = tuple(k for _, k in stack if k != "-")
+                continue
+            block_col = None
+        if not stripped.strip():
+            line.is_blank = True
+            continue
+        if stripped.startswith("#"):
+            line.is_comment = True
+            continue
+        col = indent
+        rest = stripped
+        dashed = False
+        while rest == "-" or rest.startswith("- "):
+            while stack and (stack[-1][0] > col or (stack[-1][0] == col and stack[-1][1] == "-")):
+                stack.pop()
+            stack.append((col, "-"))
+            dashed = True
+            after = rest[1:]
+            inner = after.lstrip(" ")
+            col += 1 + len(after) - len(inner)
+            rest = inner
+        match = KEY_RE.match(rest)
+        if match:
+            key = _unquote(match.group("key"))
+            if not dashed:
+                while stack and stack[-1][0] >= col:
+                    stack.pop()
+            line.path = tuple(k for _, k in stack if k != "-")
+            line.key = key
+            stack.append((col, key))
+            if match.group("rest") is not None:
+                start = col + match.start("rest")
+                end = _comment_start(body, start)
+                line.value_start, line.value_end = start, len(body[:end].rstrip())
+                if BLOCK_SCALAR_RE.fullmatch(line.value):
+                    block_col = col
+            else:
+                line.value_start = line.value_end = len(body)
+        else:
+            line.path = tuple(k for _, k in stack if k != "-")
+            if dashed and rest:
+                line.is_item = True
+                start = col
+                end = _comment_start(body, start)
+                line.value_start, line.value_end = start, len(body[:end].rstrip())
+    return lines
+
+
+# --- triggers and reachability -------------------------------------------------
+
+
+def _list_values(lines: list[Line], owner: Line) -> list[str]:
+    """Scalar values of `owner` (a key line): inline scalar/flow list or block list items."""
+    value = owner.value.strip()
+    if value:
+        if value.startswith("["):
+            return [_unquote(m.group("item").strip()) for m in FLOW_ITEM_RE.finditer(value)]
+        return [_unquote(value)]
+    child_path = owner.path + (owner.key or "",)
+    return [_unquote(line.value) for line in lines if line.is_item and line.path == child_path and not line.in_block]
+
+
+def _on_line(lines: list[Line]) -> Line | None:
+    for line in lines:
+        if line.key in ("on", "true") and line.path == () and line.indent == 0:
+            return line
+    return None
+
+
+def _bracket_depth(text: str) -> int:
+    """Net count of flow brackets opened in `text`, quoted strings excluded."""
+    depth = 0
+    quote = ""
+    for ch in text:
+        if quote:
+            if ch == quote:
+                quote = ""
+        elif ch in "\"'":
+            quote = ch
+        elif ch in "[{":
+            depth += 1
+        elif ch in "]}":
+            depth -= 1
+    return depth
+
+
+def _flow_text(lines: list[Line], owner: Line) -> tuple[str, bool]:
+    """`owner`'s inline value joined with the lines that close its flow collection; (text, single line)."""
+    text = owner.value.strip()
+    depth = _bracket_depth(text) if text[:1] in ("[", "{") else 0
+    if depth <= 0:
+        return text, True
+    parts = [text]
+    for line in lines[lines.index(owner) + 1 :]:
+        if depth <= 0:
+            break
+        if line.is_blank or line.is_comment:
+            continue
+        body = line.text[: _comment_start(line.text, line.indent)].strip()
+        parts.append(body)
+        depth += _bracket_depth(body)
+    return " ".join(parts), False
+
+
+def _flow_mapping_keys(text: str) -> list[str]:
+    """Top-level keys of a flow mapping such as `{push: {branches: [a]}, schedule: [...]}`."""
+    keys: list[str] = []
+    depth = 0
+    quote = ""
+    segment = ""
+    for ch in text:
+        if quote:
+            if ch == quote:
+                quote = ""
+        elif ch in "\"'":
+            quote = ch
+        elif ch in "[{":
+            depth += 1
+            if depth == 1:
+                continue
+        elif ch in "]}":
+            depth -= 1
+        elif ch == "," and depth == 1:
+            keys.append(segment)
+            segment = ""
+            continue
+        if depth >= 1:
+            segment += ch
+    keys.append(segment)
+    names = []
+    for seg in keys:
+        match = KEY_RE.match(seg.strip())
+        name = _unquote(match.group("key")) if match else _unquote(seg.strip())
+        if name:
+            names.append(name)
+    return names
+
+
+def triggers(lines: list[Line]) -> dict[str, Line]:
+    """Event name -> the line that declares it.
+
+    An inline `on:` value (scalar, flow list or flow mapping) maps every event to
+    the `on:` line itself; a block `on:` maps each event key or `- event` item to
+    its own line.
+    """
+    on = _on_line(lines)
+    if on is None:
+        return {}
+    if on.value.strip():
+        text, _ = _flow_text(lines, on)
+        if text.startswith("{"):
+            names = _flow_mapping_keys(text)
+        elif text.startswith("["):
+            names = [_unquote(m.group("item").strip()) for m in FLOW_ITEM_RE.finditer(text)]
+        else:
+            names = [_unquote(text)]
+        return {name: on for name in names}
+    events: dict[str, Line] = {}
+    for line in lines:
+        if line.in_block or line.path != ("on",):
+            continue
+        if line.key:
+            events[line.key] = line
+        elif line.is_item:
+            events[_unquote(line.value)] = line
+    return events
+
+
+def _glob_matches(pattern: str, ref: str) -> bool:
+    regex = ""
+    i = 0
+    while i < len(pattern):
+        if pattern.startswith("**", i):
+            regex += ".*"
+            i += 2
+        elif pattern[i] == "*":
+            regex += "[^/]*"
+            i += 1
+        elif pattern[i] == "?":
+            regex += "."
+            i += 1
+        else:
+            regex += re.escape(pattern[i])
+            i += 1
+    return re.fullmatch(regex, ref) is not None
+
+
+def push_reaches_branch(lines: list[Line], push: Line, branch: str) -> bool:
+    filters = {
+        line.key: line
+        for line in lines
+        if line.key and line.path == ("on", "push") and not line.in_block
+    }
+    if "branches" in filters:
+        hit = False
+        for pattern in _list_values(lines, filters["branches"]):
+            if pattern.startswith("!"):
+                if _glob_matches(pattern[1:], branch):
+                    hit = False
+            elif _glob_matches(pattern, branch):
+                hit = True
+        return hit
+    if "branches-ignore" in filters:
+        return not any(_glob_matches(p, branch) for p in _list_values(lines, filters["branches-ignore"]))
+    # Only tag filters: branch pushes never start it.
+    return "tags" not in filters and "tags-ignore" not in filters
+
+
+def can_fire(lines: list[Line]) -> bool:
+    events = triggers(lines)
+    if REACHABLE_EVENTS & events.keys():
+        return True
+    return "push" in events and push_reaches_branch(lines, events["push"], FORK_DEFAULT_BRANCH)
+
+
+def local_uses(lines: list[Line]) -> list[str]:
+    out: list[str] = []
+    for line in lines:
+        if line.key == "uses" and not line.in_block:
+            target = _unquote(line.value.strip())
+            if target.startswith((LOCAL_WORKFLOW_PREFIX, LOCAL_ACTION_PREFIX)):
+                out.append(target)
+    return out
+
+
+def _resolve_use(root: Path, target: str) -> Path | None:
+    rel = Path(target[2:].rstrip("/"))
+    if target.startswith(LOCAL_WORKFLOW_PREFIX):
+        return rel if (root / rel).is_file() else None
+    for name in ("action.yml", "action.yaml"):
+        if (root / rel / name).is_file():
+            return rel / name
+    return None
+
+
+def fork_owned(path: Path) -> bool:
+    return FORK_OWNED_WORKFLOW.fullmatch(path.name) is not None
+
+
+def workflow_files(root: Path) -> list[Path]:
+    folder = root / WORKFLOWS_DIR
+    return sorted(p.relative_to(root) for p in folder.iterdir() if p.suffix in (".yml", ".yaml") and p.is_file())
+
+
+def reachable_set(root: Path, parsed: dict[Path, list[Line]]) -> tuple[list[Path], list[Path]]:
+    """(entry workflows that can fire here, every reachable file incl. callees)."""
+    entries = [path for path in workflow_files(root) if can_fire(parsed[path])]
+    seen: set[Path] = set()
+    queue = list(entries)
+    while queue:
+        path = queue.pop()
+        if path in seen:
+            continue
+        seen.add(path)
+        if path not in parsed:
+            parsed[path] = parse((root / path).read_text(encoding="utf-8"))
+        for target in local_uses(parsed[path]):
+            resolved = _resolve_use(root, target)
+            if resolved is not None and resolved not in seen:
+                queue.append(resolved)
+    return entries, sorted(seen)
+
+
+# --- schedule stripping --------------------------------------------------------
+
+
+def _is_dash(line: Line) -> bool:
+    rest = line.text[line.indent :]
+    return rest == "-" or rest.startswith("- ")
+
+
+def _block_end(lines: list[Line], start: int) -> int:
+    """Index of the last line of the `schedule:` node at `start`.
+
+    The node holds every deeper line, plus a list at the key's own column (`schedule:`
+    then `- cron:` at the same indent, legal YAML). Comments at or left of the key's
+    column, and blank lines, count only when more of the node follows them.
+    """
+    sched = lines[start]
+    same_column_list = not sched.value.strip()
+    last = start
+    for i in range(start + 1, len(lines)):
+        line = lines[i]
+        if line.is_blank or (line.is_comment and line.indent <= sched.indent):
+            continue
+        if line.in_block or line.indent > sched.indent:
+            last = i
+        elif same_column_list and line.indent == sched.indent and _is_dash(line):
+            last = i
+        else:
+            break
+    return last
+
+
+def _strip_inline(result: FileResult, on: Line, remaining: list[str]) -> bool:
+    """Drop `schedule` from an inline `on:` value; False (with a problem) when it cannot."""
+    _, single_line = _flow_text(result.lines, on)
+    value = on.value
+    if not single_line or value.startswith("{") or (value.startswith("[") and not value.endswith("]")):
+        form = "flow mapping" if value.startswith("{") else "multi-line flow list"
+        result.problems.append(
+            Finding(result.path, on.no, f"cannot rewrite the schedule trigger in an `on:` {form}; edit it by hand")
+        )
+        return False
+    if value.startswith("["):
+        items = list(FLOW_ITEM_RE.finditer(value))
+        kept = [m.group("item") for m in items if _unquote(m.group("item").strip()) != "schedule"]
+        sep = items[1].group("lead") if len(items) > 1 else ", "
+        if not kept:
+            first = items[0].group("item")
+            quote = first[0] if first[:1] in ("'", '"') else ""
+            kept = [f"{quote}workflow_dispatch{quote}"]
+        new = value[: items[0].start("item")] + sep.join(kept) + value[items[-1].end("item") :]
+    else:
+        quote = value[0] if value[:1] in ("'", '"') else ""
+        new = f"{quote}workflow_dispatch{quote}"
+    on.text = on.text[: on.value_start] + new + on.text[on.value_end :]
+    result.dispatch_added = result.dispatch_added or not remaining
+    result.schedules_removed += 1
+    return True
+
+
+def strip_schedule(result: FileResult) -> bool:
+    """Remove one schedule trigger; True when the text changed (re-parse before the next call)."""
+    lines = result.lines
+    events = triggers(lines)
+    sched = events.get("schedule")
+    if sched is None:
+        return False
+    remaining = [name for name in events if name != "schedule"]
+    if sched.path == ():
+        return _strip_inline(result, sched, remaining)
+    start = lines.index(sched)
+    last = start if sched.is_item else _block_end(lines, start)
+    # A comment block right above, at the same column, describes the schedule.
+    first = start
+    while first > 0 and lines[first - 1].is_comment and lines[first - 1].indent == sched.indent:
+        first -= 1
+    replacement: list[Line] = []
+    if not remaining:
+        if sched.is_item:
+            text = sched.text[: sched.value_start] + "workflow_dispatch"
+        else:
+            text = " " * sched.indent + "workflow_dispatch:"
+        replacement.append(Line(no=sched.no, text=text, ending=sched.ending, indent=sched.indent))
+        result.dispatch_added = True
+    lines[first : last + 1] = replacement
+    result.schedules_removed += 1
+    return True
+
+
+# --- label rewriting -----------------------------------------------------------
+
+
+def is_label_position(line: Line) -> bool:
+    path = line.path
+    if line.in_block or line.is_comment or line.is_blank:
+        return False
+    if line.key is not None:
+        key = line.key
+        if key == "runs-on":
+            return True
+        if key == "labels" and path[-1:] == ("runs-on",):
+            return True
+        if key == "runner" and "matrix" in path:
+            return True
+        if key in RUNNER_INPUT_KEYS and path[-1:] == ("with",):
+            return True
+        return (
+            key == "default"
+            and len(path) == 4
+            and path[0] == "on"
+            and path[1] in ("workflow_call", "workflow_dispatch")
+            and path[2] == "inputs"
+            and path[3] in RUNNER_INPUT_KEYS
+        )
+    if line.is_item and path:
+        parent = path[-1]
+        if parent == "runs-on" or (parent == "labels" and path[-2:-1] == ("runs-on",)):
+            return True
+        if parent == "runner" and "matrix" in path:
+            return True
+        return parent in RUNNER_INPUT_KEYS and path[-2:-1] == ("with",)
+    return False
+
+
+def map_label(label: str) -> str | None:
+    for pattern, target in LABEL_RULES:
+        if pattern.fullmatch(label):
+            return target
+    return None
+
+
+@dataclass
+class LabelEdit:
+    new_value: str
+    rewrites: list[tuple[str, str]]  # (old label, new label)
+    problems: list[str]
+
+
+def _rewrite_scalar(token: str) -> LabelEdit:
+    quote = token[0] if token[:1] in ("'", '"') and token[-1:] == token[:1] and len(token) >= 2 else ""
+    label = token[1:-1] if quote else token
+    if label in COMPOSED_LABELS:
+        new = COMPOSED_LABELS[label]
+        return LabelEdit(f"{quote}{new}{quote}", [(label, "composed")], [])
+    if label in COMPOSED_LABELS.values():
+        return LabelEdit(token, [], [])
+    if "${{" in label:
+        residue = EXPRESSION_RE.sub("", label)
+        problems: list[str] = []
+        if "latest" in residue or HOSTED_LABEL.search(residue):
+            problems.append(f"unknown composed hosted label {label!r}")
+        for inner in re.findall(r"""['"]((?:ubuntu|macos|windows)-[A-Za-z0-9._-]+)['"]""", label):
+            problems.append(f"hosted label {inner!r} inside an expression")
+        return LabelEdit(token, [], problems)
+    if not HOSTED_LABEL.fullmatch(label):
+        return LabelEdit(token, [], [])
+    target = map_label(label)
+    if target is None:
+        return LabelEdit(token, [], [f"unmapped hosted label {label!r}"])
+    return LabelEdit(f"{quote}{target}{quote}", [(label, target)], [])
+
+
+def rewrite_value(value: str) -> LabelEdit:
+    stripped = value.strip()
+    if stripped.startswith("[") and stripped.endswith("]"):
+        rewrites: list[tuple[str, str]] = []
+        problems: list[str] = []
+
+        def sub(match: re.Match[str]) -> str:
+            edit = _rewrite_scalar(match.group("item"))
+            rewrites.extend(edit.rewrites)
+            problems.extend(edit.problems)
+            return match.group("lead") + edit.new_value + match.group("trail")
+
+        return LabelEdit(FLOW_ITEM_RE.sub(sub, value), rewrites, problems)
+    return _rewrite_scalar(value)
+
+
+def rewrite_labels(result: FileResult, warnings: list[Finding], problems: list[Finding]) -> None:
+    for line in result.lines:
+        if not is_label_position(line) or not line.value:
+            continue
+        edit = rewrite_value(line.value)
+        for old, new in edit.rewrites:
+            result.label_rewrites[new] += 1
+            if INTEL_ONLY_MACOS.fullmatch(old):
+                warnings.append(Finding(result.path, line.no, f"{old} is Intel-only; sglang-macos (iris2) is ARM64"))
+        problems.extend(Finding(result.path, line.no, msg) for msg in edit.problems)
+        if edit.new_value != line.value:
+            line.text = line.text[: line.value_start] + edit.new_value + line.text[line.value_end :]
+
+
+def stray_hosted_labels(path: Path, lines: list[Line]) -> list[Finding]:
+    """Hosted labels as plain YAML values outside the positions this script rewrites."""
+    found: list[Finding] = []
+    for line in lines:
+        if line.in_block or line.is_comment or line.is_blank or is_label_position(line):
+            continue
+        if line.key is None and not line.is_item:
+            continue
+        value = line.value.strip()
+        items = (
+            [_unquote(m.group("item").strip()) for m in FLOW_ITEM_RE.finditer(value)]
+            if value.startswith("[")
+            else [_unquote(value)]
+        )
+        for item in items:
+            if HOSTED_LABEL.fullmatch(item):
+                found.append(Finding(path, line.no, f"hosted label {item!r} in a position this script does not rewrite"))
+    return found
+
+
+# --- driver --------------------------------------------------------------------
+
+
+@dataclass
+class Report:
+    results: dict[Path, FileResult]
+    entries: list[Path]
+    reachable: list[Path]
+    warnings: list[Finding]
+    problems: list[Finding]
+    check_findings: list[Finding]
+
+
+def run(root: Path) -> Report:
+    results: dict[Path, FileResult] = {}
+    parsed: dict[Path, list[Line]] = {}
+    check_findings: list[Finding] = []
+    problems: list[Finding] = []
+    for path in workflow_files(root):
+        original = (root / path).read_text(encoding="utf-8")
+        lines = parse(original)
+        result = FileResult(path=path, original=original, lines=lines)
+        if not fork_owned(path):
+            sched = triggers(lines).get("schedule")
+            if sched is not None:
+                check_findings.append(Finding(path, sched.no, "schedule trigger"))
+            # One trigger per pass, re-parsing so each pass sees the edited structure.
+            while strip_schedule(result):
+                result.lines = parse(result.text)
+        problems.extend(result.problems)
+        results[path] = result
+        parsed[path] = result.lines
+    entries, reachable = reachable_set(root, parsed)
+    warnings: list[Finding] = []
+    for path in reachable:
+        if path not in results:
+            original = (root / path).read_text(encoding="utf-8")
+            results[path] = FileResult(path=path, original=original, lines=parse(original))
+        result = results[path]
+        # Leftovers as they stand on disk, for --check.
+        on_disk = parse(result.original)
+        for line in on_disk:
+            if is_label_position(line) and line.value:
+                edit = rewrite_value(line.value)
+                for old, _ in edit.rewrites:
+                    check_findings.append(Finding(path, line.no, f"hosted label {old!r} not rewritten"))
+                check_findings.extend(Finding(path, line.no, msg) for msg in edit.problems)
+        check_findings.extend(stray_hosted_labels(path, on_disk))
+        rewrite_labels(result, warnings, problems)
+    return Report(results, entries, reachable, warnings, problems, check_findings)
+
+
+def summarize(report: Report, applied: bool) -> str:
+    changed = [r for r in report.results.values() if r.changed]
+    labels: Counter[str] = Counter()
+    for r in report.results.values():
+        labels.update(r.label_rewrites)
+    verb = "applied" if applied else "would apply"
+    out = [
+        f"{verb}: {sum(r.schedules_removed for r in report.results.values())} schedule triggers removed, "
+        f"{sum(r.dispatch_added for r in report.results.values())} workflow_dispatch added, "
+        f"{len(changed)} files changed",
+        "label rewrites: " + (", ".join(f"{k}={v}" for k, v in sorted(labels.items())) or "none"),
+        f"reachable: {len(report.entries)} entry workflows, {len(report.reachable)} files with callees",
+    ]
+    out.extend(f"  {p.as_posix()}" for p in report.reachable)
+    out.extend(f"warning: {w}" for w in report.warnings)
+    out.extend(f"refused: {p}" for p in report.problems)
+    return "\n".join(out)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0] if __doc__ else None)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument(
+        "--apply", action="store_true", help="rewrite the workflow files in place; exit 1 on any refusal"
+    )
+    mode.add_argument("--check", action="store_true", help="exit 1 listing every schedule or hosted label left")
+    parser.add_argument(
+        "--root",
+        type=Path,
+        default=Path(__file__).resolve().parents[2],
+        help="repository root (default: the repo holding this script)",
+    )
+    parser.add_argument("--quiet", action="store_true", help="print findings only")
+    args = parser.parse_args(argv)
+    root: Path = args.root.resolve()
+    report = run(root)
+    if args.apply:
+        for result in report.results.values():
+            if result.changed:
+                (root / result.path).write_text(result.text, encoding="utf-8", newline="")
+        if not args.quiet:
+            print(summarize(report, applied=True))
+        else:
+            for problem in report.problems:
+                print(f"refused: {problem}")
+        if report.problems:
+            print(f"{len(report.problems)} refusal(s); fix those lines by hand, then re-run --apply", file=sys.stderr)
+            return 1
+        return 0
+    findings = sorted(report.check_findings, key=lambda f: (f.path.as_posix(), f.line))
+    for finding in findings:
+        print(finding)
+    if findings:
+        print(
+            f"{len(findings)} finding(s); run python3 .github/fork/self_hosted_runners.py --apply",
+            file=sys.stderr,
+        )
+        return 1
+    if not args.quiet:
+        print(f"ok: no schedule triggers; no hosted labels in {len(report.reachable)} reachable files")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
