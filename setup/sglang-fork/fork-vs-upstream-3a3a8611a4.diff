+def test_what_the_engine_catches_when_the_ids_and_the_images_disagree(
+    tokenizer, mm_processor, box_c_env
+):
+    """Controls. What the engine can and cannot catch when ids and images disagree. The
+    processor loads one image per placeholder it finds in the ids: more placeholders than
+    images is an error, fewer is served with the surplus images dropped, and ids with no
+    image at all are served bare. The handler checks none of it (the engine does not check
+    ids against messages), so the router must send exactly one placeholder per image."""
+    record = {r["id"]: r for r in _image_records()}["user-two-images-one-message"]
+    ids = _ids_of(record, "ids")
+    chat = _mm_chat(tokenizer)
+    # No image in the messages: no ``image_data``, no multimodal processing, bare
+    # placeholders.
+    bare = _ids_image_body(record, [{"role": "user", "content": "hi"}])
+    by_bare, _, _ = _convert(chat, bare, ids)
+    assert by_bare.image_data is None and not by_bare.contains_mm_input()
+    assert by_bare.input_ids == ids
+    first = ids.index(IMAGE_TOKEN_ID)
+    by_many, _, _ = _convert(chat, record["egress"], ids + [IMAGE_TOKEN_ID])
+    # upstream's processor names the mismatch (#45925) where it used to fail the load
+    with pytest.raises(ValueError, match="3 image placeholders but 2 image inputs"):
+        _expand(mm_processor, by_many)
+    by_few, _, _ = _convert(chat, record["egress"], ids[:first] + ids[first + 1 :])
+    assert len(by_few.image_data) == 2
+    answer = _expand(mm_processor, by_few)
+    assert len(answer["offsets"]) == 1  # the second image was dropped, unheard
+    start, end = answer["offsets"][0]
+    assert end - start + 1 == record["images"][0]["tokens"]
+    # A text-only engine refuses an image on both paths, with the same words.
+    plain = _handler(tokenizer)
+    for ids_arg in (None, ids):
+        with pytest.raises(ValueError, match="image input is not supported"):
+            _convert(plain, record["egress"], ids_arg)
+    # Only DeepSeek-V4.1 reads its images this way: any other encoding keeps ``None``.
+    other = _mm_chat(tokenizer)
+    other.chat_encoding_spec = "dsv4"
+    by_other, _, _ = _convert(other, record["egress"], ids)
+    assert by_other.image_data is None
+
