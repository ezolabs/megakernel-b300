@@ -0,0 +1,262 @@
+"""e2: the ``/v1/loads`` ``aggregate`` object and the Prometheus rows.
+
+``/v1/loads`` returns one ``LoadSnapshot`` per DP rank. This patch adds a
+cluster-wide ``aggregate`` beside them, summed over exactly the ranks the
+request returned -- so a ``dp_rank`` filter narrows the aggregate too -- and
+teaches the Prometheus exposition the two things it previously dropped:
+per-priority waiting-queue rows (``sglang_priority_*``, labelled with
+``dp_rank`` and ``priority``) and the aggregate scalars
+(``sglang_aggregate_*``, no labels).
+
+The route is called directly with a fake ``tokenizer_manager``; the runtime
+context reads it makes (``get_parallel``, ``_accelerator_name``) are patched,
+the pattern the a1/a2 tests use for the unpublished context.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+from fastapi import HTTPException
+
+from sglang.srt.entrypoints.v1_loads import _aggregate_loads, get_loads
+from sglang.srt.managers.load_snapshot import LoadSnapshot, PriorityQueueMetrics
+
+
+class _FakeTokenizerManager:
+    """The slice of ``TokenizerManager`` that ``/v1/loads`` touches."""
+
+    metrics_collector = None
+
+    def __init__(self, loads, error=None):
+        self.loads = loads
+        self.error = error
+
+    async def get_loads(self, include=None, dp_rank=None):
+        if self.error is not None:
+            raise self.error
+        return [
+            load for load in self.loads if dp_rank is None or load.dp_rank == dp_rank
+        ]
+
+
+def _snapshots():
+    """Two ranks whose counts differ everywhere, so every sum is checkable."""
+    return [
+        LoadSnapshot(
+            dp_rank=0,
+            num_running_reqs=3,
+            num_waiting_reqs=2,
+            num_waiting_uncached_tokens=100,
+            num_used_tokens=1000,
+            max_total_num_tokens=4000,
+            max_running_requests=128,
+            priorities=[
+                PriorityQueueMetrics(
+                    priority=1, num_waiting_reqs=2, num_waiting_uncached_tokens=100
+                )
+            ],
+        ),
+        LoadSnapshot(
+            dp_rank=1,
+            num_running_reqs=5,
+            num_waiting_reqs=4,
+            num_waiting_uncached_tokens=300,
+            num_used_tokens=2000,
+            max_total_num_tokens=6000,
+            max_running_requests=256,
+            priorities=[
+                PriorityQueueMetrics(
+                    priority=0, num_waiting_reqs=1, num_waiting_uncached_tokens=50
+                ),
+                PriorityQueueMetrics(
+                    priority=1, num_waiting_reqs=3, num_waiting_uncached_tokens=250
+                ),
+            ],
+        ),
+    ]
+
+
+_AGGREGATE = {
+    "num_dp_ranks": 2,
+    "num_running_reqs": 8,
+    "num_waiting_reqs": 6,
+    "num_waiting_uncached_tokens": 400,
+    "max_running_requests": 384,
+    "kv_used": 3000,
+    "kv_total": 10000,
+    "kv_usage": 0.3,
+    "priorities": [
+        {"priority": 0, "num_waiting_reqs": 1, "num_waiting_uncached_tokens": 50},
+        {"priority": 1, "num_waiting_reqs": 5, "num_waiting_uncached_tokens": 350},
+    ],
+}
+
+_EMPTY_AGGREGATE = {
+    "num_dp_ranks": 0,
+    "num_running_reqs": 0,
+    "num_waiting_reqs": 0,
+    "num_waiting_uncached_tokens": 0,
+    "max_running_requests": 0,
+    "kv_used": 0,
+    "kv_total": 0,
+    "kv_usage": 0.0,
+    "priorities": [],
+}
+
+
+@contextlib.contextmanager
+def _context():
+    """Patch the two unpublished runtime-context reads the route makes."""
+    # Upstream's _num_accelerators_per_dp_rank reads attn_dp_enabled and
+    # num_dp_ranks off the runtime context (8 GPUs / 2 DP ranks = 4).
+    parallel = SimpleNamespace(
+        tp_size=8, pp_size=1, num_dp_ranks=2, attn_dp_enabled=True
+    )
+    with (
+        mock.patch(
+            "sglang.srt.entrypoints.v1_loads.get_parallel", return_value=parallel
+        ),
+        mock.patch(
+            "sglang.srt.entrypoints.v1_loads._accelerator_name",
+            return_value="NVIDIA GB300",
+        ),
+    ):
+        yield
+
+
+class TestAggregateJson:
+    def test_sums_every_returned_rank(self):
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(get_loads(tokenizer_manager=manager))
+
+        assert response["aggregate"] == _AGGREGATE
+        # The per-rank envelope is untouched by the new key.
+        assert response["num_accelerators"] == 4
+        assert [load["dp_rank"] for load in response["loads"]] == [0, 1]
+
+    def test_present_even_when_include_omits_the_sections(self):
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(get_loads(include="core", tokenizer_manager=manager))
+
+        assert "priorities" not in response["loads"][0]
+        assert response["aggregate"]["priorities"] == _AGGREGATE["priorities"]
+        assert response["aggregate"]["num_waiting_uncached_tokens"] == 400
+
+    def test_dp_rank_filter_narrows_the_aggregate(self):
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(get_loads(dp_rank=1, tokenizer_manager=manager))
+
+        assert response["aggregate"] == {
+            "num_dp_ranks": 1,
+            "num_running_reqs": 5,
+            "num_waiting_reqs": 4,
+            "num_waiting_uncached_tokens": 300,
+            "max_running_requests": 256,
+            "kv_used": 2000,
+            "kv_total": 6000,
+            "kv_usage": round(2000 / 6000, 4),
+            "priorities": [
+                {
+                    "priority": 0,
+                    "num_waiting_reqs": 1,
+                    "num_waiting_uncached_tokens": 50,
+                },
+                {
+                    "priority": 1,
+                    "num_waiting_reqs": 3,
+                    "num_waiting_uncached_tokens": 250,
+                },
+            ],
+        }
+
+    def test_rank_without_a_snapshot_aggregates_to_zero(self):
+        """A dp_rank nobody published still answers with an all-zero aggregate."""
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(get_loads(dp_rank=7, tokenizer_manager=manager))
+
+        assert response["loads"] == []
+        assert response["aggregate"] == _EMPTY_AGGREGATE
+
+
+class TestAggregatePrometheus:
+    def test_priority_rows_and_aggregate_scalars_are_rendered(self):
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(
+                get_loads(format="prometheus", tokenizer_manager=manager)
+            )
+        body = response.body.decode()
+
+        assert "# TYPE sglang_priority_num_waiting_reqs gauge" in body
+        assert 'sglang_priority_num_waiting_reqs{dp_rank="0",priority="1"} 2' in body
+        assert 'sglang_priority_num_waiting_reqs{dp_rank="1",priority="1"} 3' in body
+        assert (
+            'sglang_priority_num_waiting_uncached_tokens{dp_rank="1",priority="0"} 50'
+            in body
+        )
+        assert (
+            'sglang_priority_num_waiting_uncached_tokens{dp_rank="0",priority="1"} 100'
+            in body
+        )
+
+        # Aggregate scalars carry no labels and cover exactly the numeric keys.
+        assert "sglang_aggregate_num_dp_ranks 2" in body
+        assert "sglang_aggregate_num_waiting_uncached_tokens 400" in body
+        assert "sglang_aggregate_kv_used 3000" in body
+        assert "sglang_aggregate_kv_usage 0.3" in body
+        assert "# TYPE sglang_aggregate_kv_usage gauge" in body
+        assert "sglang_aggregate_priorities" not in body
+        assert "sglang_aggregate_kv_usage{" not in body
+
+        # The pre-existing per-rank rows are unchanged.
+        assert 'sglang_num_running_reqs{dp_rank="0"} 3' in body
+
+    def test_priorities_excluded_from_include_keep_only_the_aggregate(self):
+        manager = _FakeTokenizerManager(_snapshots())
+        with _context():
+            response = asyncio.run(
+                get_loads(
+                    include="core", format="prometheus", tokenizer_manager=manager
+                )
+            )
+        body = response.body.decode()
+
+        assert "sglang_priority_" not in body
+        assert "sglang_aggregate_num_dp_ranks 2" in body
+
+
+class TestAggregateHelper:
+    def test_merges_priorities_across_ranks_in_ascending_order(self):
+        aggregated = _aggregate_loads(_snapshots())
+        assert aggregated["priorities"] == _AGGREGATE["priorities"]
+
+    def test_no_priorities_is_an_empty_list_not_none(self):
+        aggregated = _aggregate_loads([LoadSnapshot(dp_rank=0)])
+        assert aggregated["priorities"] == []
+        assert aggregated["kv_usage"] == 0.0
+
+    def test_kv_usage_is_rounded_to_four_places(self):
+        loads = [
+            LoadSnapshot(dp_rank=0, num_used_tokens=1, max_total_num_tokens=3),
+        ]
+        assert _aggregate_loads(loads)["kv_usage"] == round(1 / 3, 4)
+
+
+class TestErrorMapping:
+    def test_value_error_from_get_loads_maps_to_http_400(self):
+        error = ValueError("Invalid include sections: {'bogus'}. Valid options: [...]")
+        manager = _FakeTokenizerManager([], error=error)
+        with _context(), pytest.raises(HTTPException) as excinfo:
+            asyncio.run(get_loads(include="bogus", tokenizer_manager=manager))
+
+        assert excinfo.value.status_code == 400
