+    serving._process_messages = mock.Mock(side_effect=_Sentinel)
+    with pytest.raises(_Sentinel):
+        serving._convert_to_internal_request(request, _raw_request({}))
+    assert request.return_first_token_latency_in_sglext is True
+
+
+def test_no_raw_request_leaves_the_opt_in_off():
+    serving = _serving()
+    request = _request()
+    serving._process_messages = mock.Mock(side_effect=_Sentinel)
+    with pytest.raises(_Sentinel):
+        serving._convert_to_internal_request(request, None)
+    assert request.return_first_token_latency_in_sglext is False
+
