+class TestPageAnchoredLayout(unittest.TestCase):
+    def test_flags_off_layout_is_byte_identical(self):
+        rng = random.Random(0)
+        for trial in range(60):
+            bs = rng.choice([1, 1, 2, 5])
+            whole = trial % 3 == 0
+            extend, seq, flags = random_batch(rng, bs, whole)
+            for tail_len in (WINDOW, TAIL):
+                ref_idx, ref_tails, ref_floor = legacy_layout(
+                    extend, seq, tail_len, flags
+                )
+                idx, tails, floor = late_layer_tail_layout(
+                    extend_lens_cpu=extend,
+                    seq_lens_cpu=seq,
+                    tail_len=tail_len,
+                    device=CPU,
+                    whole_extend=flags,
+                )
+                self.assertEqual(tails, ref_tails)
+                self.assertEqual(floor.dtype, torch.int32)
+                self.assertTrue(torch.equal(idx.to(torch.int64), ref_idx))
+                self.assertTrue(torch.equal(floor, ref_floor))
+                self.assertEqual(
+                    late_layer_tail_lens(extend, tail_len, flags), ref_tails
+                )
+
+    def test_page_anchored_layout(self):
+        rng = random.Random(1)
+        for trial in range(60):
+            bs = rng.choice([1, 1, 2, 5])
+            extend, seq, flags = random_batch(rng, bs, trial % 3 == 0)
+            idx, tails, floor = late_layer_tail_layout(
+                extend_lens_cpu=extend,
+                seq_lens_cpu=seq,
+                tail_len=TAIL,
+                device=CPU,
+                whole_extend=flags,
+                tail_page=PAGE,
+            )
+            self.assertEqual(
+                tails,
+                late_layer_tail_lens(
+                    extend, TAIL, flags, seq_lens_cpu=seq, tail_page=PAGE
+                ),
+            )
+            exp_idx, exp_floor, start = [], [], 0
+            for i, (n, t, s) in enumerate(zip(extend, tails, seq)):
+                if flags and flags[i]:
+                    self.assertEqual(t, n)
+                    f = max(0, s - n - TAIL)
+                else:
+                    f = tail_floor(s, PAGE, TAIL)
+                    self.assertEqual(t, min(n, s - f))
+                    self.assertLessEqual(t, tail_rows_bound(TAIL, PAGE))
+                exp_idx += range(start + n - t, start + n)
+                exp_floor += [f] * t
+                start += n
+            self.assertEqual(idx.tolist(), exp_idx)
+            self.assertEqual(floor.tolist(), exp_floor)
