+            self.assertIn(f".github/workflows/{name}.yml:1: schedule trigger", out)
+        self.assert_converges(
+            {
+                "push.yml": "on: [push]\njobs:\n  a:\n    runs-on: arc-sglang\n",
+                "middle.yml": "on: [ pull_request,push ]  # all three\njobs: {}\n",
+                "scalar.yml": "on: workflow_dispatch\njobs:\n  a:\n    runs-on: arc-sglang\n",
+                "quoted.yml": "'on': \"workflow_dispatch\"\njobs: {}\n",
+                "list.yml": "on: [workflow_dispatch]\njobs: {}\n",
+                "quoted-list.yml": "on: ['workflow_dispatch']\njobs: {}\n",
+            }
+        )
+
+    def test_unrewritable_inline_forms_fail_apply(self) -> None:
+        mapping = "name: M\non: {schedule: [{cron: '0 0 * * *'}], workflow_dispatch: {}}\njobs: {}\n"
+        multiline = "on: [push,\n  schedule]\njobs: {}\n"
+        self.workflow("mapping.yml", mapping)
+        self.workflow("multiline.yml", multiline)
+        for _ in range(2):
+            code, out = self.main("--apply")
+            self.assertEqual(code, 1)
+            self.assertIn(
+                "refused: .github/workflows/mapping.yml:2: cannot rewrite the schedule trigger in an `on:` flow mapping",
+                out,
+            )
+            self.assertIn(
+                "refused: .github/workflows/multiline.yml:1: cannot rewrite the schedule trigger"
+                " in an `on:` multi-line flow list",
+                out,
+            )
+            self.assertEqual(self.wf("mapping.yml"), mapping)
+            self.assertEqual(self.wf("multiline.yml"), multiline)
+        code, out = self.main("--apply", "--quiet")
+        self.assertEqual(code, 1)
+        self.assertIn("refused: .github/workflows/mapping.yml:2:", out)
+        code, out = self.main("--check")
+        self.assertEqual(code, 1)
+        self.assertIn(".github/workflows/mapping.yml:2: schedule trigger", out)
+        self.assertIn(".github/workflows/multiline.yml:1: schedule trigger", out)
+
+    def test_block_list_on(self) -> None:
+        self.workflow(
