+    # stamp the validation and the conversion.
+    received = time.perf_counter()
+    pre = {}
+    await asyncio.sleep(0.001)
+    pre["validate_request_done"] = time.perf_counter()
+    await asyncio.sleep(0.001)
+    pre["convert_done"] = time.perf_counter()
+    obj = _generate_obj(ids=True, received_time=received, pre=pre)
+    await asyncio.sleep(0.001)
+    await _drive_generate(tm, obj)
+
+    line, m = _api_line(caplog)
+    assert m["rid"] == RID and m["path"] == "ids"
+    assert (int(m["prompt"]), int(m["cached"])) == (4, 2)
+    assert _delta_names(m["deltas"]) == API_DELTAS
+    _assert_telescopes(m)
+    # The stages are ordered in time: no delta is negative (checked above), and the
+    # first one is `recv` - the engine's created_time, `received_time`.
+    assert float(m["recv_at"]) == pytest.approx(received, abs=1e-6)
+    assert m["recv_at"] == f"{received:.6f}"
+    # generate_request took the pre-rid stamps off the request object again.
+    assert spt.PRE_ATTR not in vars(obj)
