+    assert p.admitted == [] and p.offered == []  # upstream: a chunk that spent the pass budget ends it before any offer
+
+
+@pytest.mark.parametrize("lookahead", [0, LOOKAHEAD])
+def test_a_warm_head_is_protected_as_in_0020(cache, lookahead):
