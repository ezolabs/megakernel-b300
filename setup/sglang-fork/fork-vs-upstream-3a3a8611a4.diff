+async def test_on_handle_loop_stamps_the_receipt_right_after_the_socket_returns(
+    detail, caplog
+):
+    caplog.set_level(logging.INFO, logger=LOGGER_NAME)
+    tm = _tokenizer_manager()
+    tm.soft_watchdog = SimpleNamespace(
+        disable=contextlib.nullcontext, feed=lambda: None
+    )
+    tm.last_receive_tstamp = 0.0
+    tm._result_dispatcher = lambda recv_obj: None
+    # A request the loop will find: begun, tokenized and dispatched.
+    obj = _generate_obj(ids=True, received_time=time.perf_counter())
+    tm._init_req_state(obj, None)
+    state = tm.rid_to_state[RID]
+    spt.api_begin(state, None, obj.received_time, time.perf_counter())
+    state.time_stats.set_tokenize_finish_time()
+    state.time_stats.set_api_server_dispatch_time()
+
+    class _Stop(BaseException):
+        pass
+
+    calls = []
+
+    async def socket(sock, flags=0):
+        calls.append(time.perf_counter())
+        if len(calls) > 1:
+            raise _Stop
+        await asyncio.sleep(0.08)  # waiting for the detokenizer, not the loop's work
+        return _output_batch()
+
+    def slow_unwrap(value):
+        time.sleep(0.02)  # work inside _handle_batch_output, after the receipt
+        return value
+
+    tm.recv_from_detokenizer = object()
+    with _tm_runtime(), mock.patch.object(tm_module, "async_sock_recv", socket), \
+            mock.patch.object(tm_module, "unwrap_from_pickle", slow_unwrap):
+        with pytest.raises(_Stop):
+            await tm.handle_loop()
+    _, m = _api_line(caplog)
+    deltas = dict(zip(_delta_names(m["deltas"]), _delta_values(m["deltas"])))
+    # The wait on the socket is before the receipt stamp; the unwrap is after it.
+    assert deltas["dispatch_to_tm_batch_recv"] >= 79.0
+    assert 19.0 <= deltas["tm_batch_recv_to_first_output"] < 60.0
+    _assert_telescopes(m)
