+# --- the opt-in ---------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "headers,expected",
+    [
+        ({"x-sglext-return-ttft": "1"}, True),
+        ({}, False),
+        ({"x-sglext-return-ttft": "0"}, False),
+        ({"x-sglext-return-input-ids": "1"}, False),
+    ],
+)
+def test_the_header_sets_the_opt_in(headers, expected):
+    serving = _serving()
+    request = _request()
+    serving._process_messages = mock.Mock(side_effect=_Sentinel)
+    with pytest.raises(_Sentinel):
+        serving._convert_to_internal_request(request, _raw_request(headers))
+    assert request.return_first_token_latency_in_sglext is expected
+
+
+def test_the_body_field_is_an_opt_in_without_a_header():
+    serving = _serving()
