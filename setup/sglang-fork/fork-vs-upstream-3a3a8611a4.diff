+              - workflow_dispatch
+            jobs:
+              a:
+                runs-on: ubuntu-latest
+            """,
+        )
+        self.workflow("only.yml", "on:\n- 'schedule'  # nightly\njobs: {}\n")
+        self.workflow("pr.yml", "on:\n  - pull_request\njobs:\n  a:\n    runs-on: ubuntu-latest\n")
+        code, out = self.main("--check")
