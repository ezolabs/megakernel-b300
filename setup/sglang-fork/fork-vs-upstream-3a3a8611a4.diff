+"""Chat preprocessing runs on one worker thread, not on the HTTP event loop.
+
+``OpenAIServingBase.handle_request`` (``/v1/chat/completions``) and the
+Anthropic facade (``/v1/messages``, both paths) called
+``OpenAIServingChat._convert_to_internal_request`` inline. For a DeepSeek
+V4.1 chat that conversion renders the conversation
+(``encoding_dsv41.encode_messages``) and tokenizes it; the encode alone was
+measured on box-c at ~0.36 s for a 195k-token prompt. While it ran, the event
+loop ran nothing else: every other request, every stream chunk and every
+``/v1/loads`` poll on the process waited behind it.
+
+The conversion now runs on ``serving_base.get_preprocess_executor()``, one
+process-wide worker thread. A fast tokenizer releases the GIL while it
+encodes, so the loop keeps serving while a prompt is tokenized.
+``SGLANG_CHAT_PREPROCESS_OFF_LOOP=false`` keeps the inline conversion.
+
+What these tests pin:
+
+* the encode of a V4.1 prompt runs on the worker thread, for
+  ``/v1/chat/completions`` (buffered and streamed) and ``/v1/messages``
+  (buffered and streamed);
+* a ``/v1/loads``-style coroutine is answered while the encode is in flight;
+  inline (the negative control) it is answered only after the encode ends;
+* the same with a real Hugging Face fast tokenizer doing the encode;
+* the request the scheduler receives is the same on both paths (same token
+  ids, sampling params, rid, stream flag), and so is every error response,
+  byte for byte: ``ValueError`` and ``DS32EncodingError`` stay 400,
+  anything else stays 500, on both facades;
+* one worker: two concurrent conversions never encode at the same time;
+* the caller's context variables reach the worker thread;
+* only the chat handler opts in: other handlers still convert inline.
+
+No server, no GPU. The serving objects are the real ``OpenAIServingChat`` and
+``AnthropicServing`` over a stub tokenizer manager.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextvars
+import json
+import threading
+import time
+from typing import List, Optional
+from unittest import mock
+
+import pytest
+from fastapi.responses import JSONResponse, ORJSONResponse, StreamingResponse
+from starlette.requests import Request
+
+from sglang.srt.entrypoints.anthropic.protocol import AnthropicMessagesRequest
+from sglang.srt.entrypoints.anthropic.serving import AnthropicServing
+from sglang.srt.entrypoints.openai import preprocess_lanes, serving_base
+from sglang.srt.entrypoints.openai.encoding_dsv32 import DS32EncodingError
+from sglang.srt.entrypoints.openai.protocol import (
+    ChatCompletionRequest,
+    ChatCompletionResponse,
+)
+from sglang.srt.entrypoints.openai.serving_base import (
+    PREPROCESS_THREAD_NAME_PREFIX,
+    OpenAIServingBase,
+    get_preprocess_executor,
+)
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.environ import envs
+from sglang.srt.managers.io_struct import GenerateReqInput
+from _chat_serving_stub import (
+    route_recipe_encode_through_stub_tokenizers,
+    synthetic_recipe_backend,
+)
+
+# How long a held encode stays in flight, and how often the stand-in for a
+# /v1/loads poll asks. ~100 polls fit in one held encode; the tests need one.
+HOLD_S = 0.2
+POLL_S = 0.002
+
+ON = "executor"
+OFF = "inline"
+
+_REQUEST_CONTEXT: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar(
+    "_REQUEST_CONTEXT", default=None
+)
+
+
+@pytest.fixture(autouse=True)
+def _recipe_encodes_through_the_stub(monkeypatch):
+    """The V4.1 render is deepseek-recipe's: its encode calls the stub tokenizer."""
+    route_recipe_encode_through_stub_tokenizers(monkeypatch)
+
+
+@pytest.fixture(autouse=True)
+def _one_worker():
+    """Part 0021's configuration: one worker, no giant lane, no lag monitor.
+
+    Part 0026 (``preprocess_lanes``) made the worker count a setting, with a
+    default of more than one. The pins below are 0021's, and they hold in the
+    one-worker configuration 0026 keeps (``SGLANG_CHAT_PREPROCESS_WORKERS=1``,
+    ``SGLANG_CHAT_PREPROCESS_GIANT_CHARS=0``); 0026's own behaviour is pinned
+    in ``test_q_chat_preprocess_lanes.py``.
+    """
+    with (
+        envs.SGLANG_CHAT_PREPROCESS_WORKERS.override(1),
+        envs.SGLANG_CHAT_PREPROCESS_GIANT_CHARS.override(0),
+        envs.SGLANG_EVENT_LOOP_LAG_INTERVAL_S.override(0),
+    ):
+        preprocess_lanes.reset_lanes()
+        yield
+    preprocess_lanes.reset_lanes()
+
+
+# --------------------------------------------------------------------------
+# Stubs
+# --------------------------------------------------------------------------
+
+
+@pytest.fixture(autouse=True)
+def _published_serving_config():
+    # Upstream's serving path reads get_serving() (stream_response_default_
+    # include_usage, ...), which needs a published config in this process.
+    from sglang.srt.runtime_context import publish, reset_context
+    from sglang.srt.server_args import ServerArgs
+
+    publish(ServerArgs(model_path="dummy"), role="tokenizer")
+    yield
+    reset_context()
+
+
+class _HeldTokenizer:
+    """A tokenizer whose ``encode`` can be held open, like a long real encode.
+
+    ``encode`` waits on ``gate`` (``threading.Event.wait`` releases the GIL,
+    as the Rust fast tokenizer does for the whole encode). The ids are the
+    rendered prompt's UTF-8 bytes, so two conversions of one request give the
+    same ids only if they rendered the same prompt.
+    """
+
+    chat_template = None
+    bos_token_id = 0
+
+    def __init__(self, raises: Optional[BaseException] = None):
+        self.raises = raises
+        self.gate = threading.Event()
+        self.gate.set()
+        self.entered = threading.Event()
+        self.in_flight = 0
+        self.max_in_flight = 0
+        self.threads: List[str] = []
+        self.contexts: List[Optional[str]] = []
+        self._lock = threading.Lock()
+
+    def encode(self, text: str, **kwargs) -> List[int]:
+        with self._lock:
+            self.in_flight += 1
+            self.max_in_flight = max(self.max_in_flight, self.in_flight)
+        try:
+            self.threads.append(threading.current_thread().name)
+            self.contexts.append(_REQUEST_CONTEXT.get())
+            self.entered.set()
+            if not self.gate.wait(timeout=10):
+                raise TimeoutError("the held encode was never released")
+            if self.raises is not None:
+                raise self.raises
+            return [self.bos_token_id] + list(text.encode("utf-8"))
+        finally:
+            with self._lock:
+                self.in_flight -= 1
+
+    def reset(self):
+        """Forget the ``encode("")`` probe ``OpenAIServingChat.__init__`` makes."""
+        self.threads.clear()
+        self.contexts.clear()
+        self.entered.clear()
+        self.max_in_flight = 0
+
+
+class _TrackedTokenizer:
+    """A real Hugging Face fast tokenizer, with encodes in flight counted."""
+
+    chat_template = None
+
+    def __init__(self, inner):
+        self.inner = inner
+        self.bos_token_id = inner.bos_token_id
+        self.in_flight = 0
+        self.threads: List[str] = []
+
+    def encode(self, text: str, **kwargs):
+        self.in_flight += 1
+        try:
+            self.threads.append(threading.current_thread().name)
+            return self.inner.encode(text, **kwargs)
+        finally:
+            self.in_flight -= 1
+
+    def reset(self):
+        self.threads.clear()
+
+
+def _generation_result() -> dict:
+    return {
+        "text": "ok",
+        # recipe parses the V4.1 output from its ids (the synthetic backend's).
+        "output_ids": synthetic_recipe_backend().encode("ok").ids,
+        "meta_info": {
+            "id": "chatcmpl-l-test",
+            "prompt_tokens": 10,
+            "completion_tokens": 1,
+            "cached_tokens": 0,
+            "weight_version": "default",
+            "finish_reason": {"type": "stop", "matched": None},
+        },
+        "index": 0,
+    }
+
+
+class _TokenizerManager:
+    """What ``OpenAIServingChat`` reads off a tokenizer manager, for V4.1.
+
+    ``tool_call_parser="deepseekv41"`` resolves the chat encoding spec to
+    ``dsv41``, box-c's. ``generate_request`` records the request it is handed:
+    that is exactly what would go to the scheduler.
+    """
+
+    def __init__(self, tokenizer):
+        self.tokenizer = tokenizer
+        self.model_config = mock.Mock(is_multimodal=False)
+        self.model_config.get_default_sampling_params.return_value = {}
+        hf_config = mock.Mock(
+            architectures=["DeepseekV4ForCausalLM"], model_type="deepseek_v4"
+        )
+        hf_config.to_dict.return_value = {}
+        self.model_config.hf_config = hf_config
+        self.server_args = mock.Mock(
+            model_path="deepseek-ai/DeepSeek-V4.1",
+            revision=None,
+            enable_cache_report=False,
+            tool_call_parser="deepseekv41",
+            reasoning_parser=None,
+            stream_response_default_include_usage=False,
+            default_chat_template_kwargs=None,
+            return_input_ids=False,
+            return_output_ids=False,
+            incremental_streaming_output=False,
+            context_length=1_048_576,
+            allow_auto_truncate=False,
+        )
+        self.model_path = self.server_args.model_path
+        self.served_model_name = "dsv41"
+        self.request_logger = mock.Mock(log_requests=False, log_requests_level=0)
+        self.create_abort_task = mock.Mock(return_value=None)
+        self.generated: List[GenerateReqInput] = []
+
+    def config_value(self, name: str):
+        return getattr(self.server_args, name)
+
+    def generate_request(self, adapted_request, raw_request=None):
+        self.generated.append(adapted_request)
+
+        async def _one():
+            yield _generation_result()
+
+        return _one()
+
+
+class _TemplateManager:
+    chat_template_name = None  # the Jinja path, where the dsv41 encoder lives
+    jinja_template_content_format = None
+    completion_template_name = None
+    reasoning_config = None
+    force_reasoning = False
+    jinja_template_may_reorder_tool_results = False
+
+
+def _chat(tokenizer) -> OpenAIServingChat:
+    chat = OpenAIServingChat(_TokenizerManager(tokenizer), _TemplateManager())
+    assert chat.chat_encoding_spec == "dsv41"
+    tokenizer.reset()
+    return chat
+
+
+async def _connected() -> dict:
+    """The ASGI receive channel of a client that stays connected."""
+    return {"type": "http.request", "body": b"", "more_body": False}
+
+
+def _raw_request() -> Request:
+    return Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/v1/chat/completions",
+            "headers": [],
+        },
+        receive=_connected,
+    )
+
+
+def _conversation(words: int = 40) -> List[dict]:
+    body = " ".join(f"w{i % 997}" for i in range(words))
+    return [
+        {"role": "system", "content": "You are terse."},
+        {"role": "user", "content": f"first turn {body}"},
+        {"role": "assistant", "content": "noted"},
+        {"role": "user", "content": f"second turn {body}"},
+    ]
+
+
+def _chat_request(stream: bool = False, **fields) -> ChatCompletionRequest:
+    return ChatCompletionRequest(
+        model="dsv41",
+        messages=_conversation(),
+        max_completion_tokens=16,
+        temperature=0.3,
+        stream=stream,
+        **fields,
+    )
+
+
+def _messages_request(stream: bool = False) -> AnthropicMessagesRequest:
+    conversation = _conversation()
+    return AnthropicMessagesRequest(
+        model="dsv41",
+        max_tokens=16,
+        system=conversation[0]["content"],
+        messages=conversation[1:],
+        stream=stream,
+    )
+
+
+def _mode(mode: str):
+    return envs.SGLANG_CHAT_PREPROCESS_OFF_LOOP.override(mode == ON)
+
+
+def _on_worker(thread_name: str) -> bool:
+    return thread_name.startswith(PREPROCESS_THREAD_NAME_PREFIX)
+
+
+def _scheduler_view(adapted: GenerateReqInput) -> dict:
+    """Everything the conversion put on the request but its arrival time."""
+    view = dict(vars(adapted))
+    view.pop("received_time")
+    return view
+
+
+async def _race(call, tokenizer, hold: float = HOLD_S):
+    """Run ``call`` while a /v1/loads-style coroutine polls the loop.
+
+    The first encode is held open for ``hold`` seconds by a helper thread.
+    Returns ``(result, polls)``: ``polls`` has one entry per answered poll,
+    True when an encode was in flight as it was answered.
+    """
+    tokenizer.gate.clear()
+
+    def _release():
+        tokenizer.entered.wait(timeout=10)
+        time.sleep(hold)
+        tokenizer.gate.set()
+
+    releaser = threading.Thread(target=_release, daemon=True)
+    releaser.start()
+    task = asyncio.create_task(call())
+    polls: List[bool] = []
+    try:
+        while not task.done():
+            await asyncio.sleep(POLL_S)
+            polls.append(tokenizer.in_flight > 0)
+    finally:
+        # A call that never encoded must not leave the helper waiting.
+        tokenizer.entered.set()
+        tokenizer.gate.set()
+        releaser.join(timeout=10)
+    return task.result(), polls
+
+
+# --------------------------------------------------------------------------
+# /v1/chat/completions
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("stream", [False, True])
+async def test_chat_encode_runs_on_the_worker_and_the_loop_keeps_answering(stream):
+    tokenizer = _HeldTokenizer()
+    chat = _chat(tokenizer)
+
+    response, polls = await _race(
+        lambda: chat.handle_request(_chat_request(stream=stream), _raw_request()),
+        tokenizer,
+    )
+
+    assert len(tokenizer.threads) == 1
+    assert _on_worker(tokenizer.threads[0]), tokenizer.threads
+    # Polls were answered while the prompt was still encoding.
+    assert sum(polls) >= 1, polls
+    if stream:
+        assert isinstance(response, StreamingResponse)
+        (adapted,) = [
+            c.args[0] for c in chat.tokenizer_manager.create_abort_task.mock_calls
+        ]
+    else:
+        assert isinstance(response, ChatCompletionResponse)
+        (adapted,) = chat.tokenizer_manager.generated
+    assert adapted.input_ids[0] == tokenizer.bos_token_id
+    assert len(adapted.input_ids) > 100
+
+
+@pytest.mark.parametrize("stream", [False, True])
+async def test_inline_chat_encode_blocks_the_loop_negative_control(stream):
+    tokenizer = _HeldTokenizer()
+    chat = _chat(tokenizer)
+
+    with _mode(OFF):
+        _, polls = await _race(
+            lambda: chat.handle_request(_chat_request(stream=stream), _raw_request()),
+            tokenizer,
+        )
+
+    assert len(tokenizer.threads) == 1
+    assert not _on_worker(tokenizer.threads[0])
+    assert tokenizer.threads[0] == threading.current_thread().name
+    # Not one poll was answered while the encode held the loop.
+    assert polls and sum(polls) == 0, polls
+
+
+async def test_same_request_reaches_the_scheduler_on_both_paths():
+    requests = {}
+    for mode in (ON, OFF):
+        tokenizer = _HeldTokenizer()
+        chat = _chat(tokenizer)
+        with _mode(mode):
+            response = await chat.handle_request(
+                _chat_request(rid="rid-l-1", priority=3), _raw_request()
+            )
+        assert isinstance(response, ChatCompletionResponse)
+        assert _on_worker(tokenizer.threads[0]) == (mode == ON)
+        (adapted,) = chat.tokenizer_manager.generated
+        requests[mode] = (_scheduler_view(adapted), response)
+
+    (on_view, on_response), (off_view, off_response) = requests[ON], requests[OFF]
