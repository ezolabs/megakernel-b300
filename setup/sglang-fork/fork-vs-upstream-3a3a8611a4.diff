+        """Parsed as the output with the prefill in front: a calls block that
+        never closed (max_tokens) keeps its finished invokes, as recipe parses
+        it, and shows no DSML."""
+        request = self._request("required")
+        completion = self._completion(("get_weather", "Paris"))
+        choice_data = self._response(
+            request, completion[: -len(f"\n</{self.DSML} calls>")], finish="length"
+        )
+        self.assertEqual(
+            [
