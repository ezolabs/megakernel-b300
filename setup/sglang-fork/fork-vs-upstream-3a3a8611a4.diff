+def test_without_mm_hashes_the_pad_value_stays_the_feature_hash(
+    tokenizer, mm_processor, box_c_env
+):
+    """Control: with no ``mm_hashes`` the tokenizer manager sets no hash and the scheduler's
+    ``set_pad_value`` takes the processor's feature-tensor hash, as before. A list one hash
+    short of the images is ignored (the engine's length rule), so no image takes a router
+    hash."""
+    from sglang.srt.managers.mm_utils import hash_feature
+    from sglang.srt.managers.schedule_batch import _compute_pad_values
+
+    chat = _mm_chat(tokenizer)
+    for record in _image_records():
+        ids = _ids_of(record, "ids")
+        urls = _urls_in_message_order(record["egress"]["messages"])
+        adapted, _, _ = _convert(chat, record["egress"], ids)
+        for item in _tokenized_mm(mm_processor, adapted).mm_items:
+            assert item.hash is None and item.pad_value is None, record["id"]
+            item.set_pad_value()
+            assert item.hash == hash_feature(item.feature), record["id"]
+            assert item.pad_values == _compute_pad_values(
+                item.hash.to_bytes(8, byteorder="big")
+            ), record["id"]
+        if len(urls) > 1:
+            short = dict(record["egress"], mm_hashes=_router_hashes(len(urls) - 1))
+            adapted_short, _, _ = _convert(chat, short, ids)
+            for item in _tokenized_mm(mm_processor, adapted_short).mm_items:
+                assert item.hash is None and item.pad_value is None, record["id"]
