index 0000000000..aa7393df88
--- /dev/null
+++ b/test/srt/sbr/_chat_serving_stub.py
@@ -0,0 +1,116 @@
+"""Defaults for an ``OpenAIServingChat`` built with ``__new__`` in a test.
+
+``OpenAIServingChat.__init__`` needs a live tokenizer manager, so the sbr tests
+build the handler with ``__new__`` and set only what their path reads. This
+sets every attribute ``__init__`` would have set to its no-model value first, so
+an upstream attribute added later does not break the stubs; a test then
+overrides what it needs.
+"""
+
+from collections import OrderedDict
+
+
+def init_chat_serving_defaults(serving):
+    defaults = {
+        "tool_call_parser": None,
+        "reasoning_parser": None,
+        "default_chat_template_kwargs": {},
+        "_reasoning_detector": None,
+        "default_sampling_params": None,
+        "is_gpt_oss": False,
+        "is_gemma4": False,
+        "is_minimax_m3": False,
+        "chat_encoding_spec": None,
+        "supports_inline_system": False,
+        "_encoding_adapter": None,
+        "_response_parser": None,
+        "_tokenizer_auto_adds_specials": True,
+        "_prompt_text_round_trip_is_lossy": False,
+        "_chat_template_cache": OrderedDict(),
+    }
+    for name, value in defaults.items():
+        if name not in vars(serving):
+            setattr(serving, name, value)
+    return serving
+
+
+# deepseek-recipe's special tokens a DeepSeek-V4/V4.1 render needs in the added
+# vocabulary (found by rendering chat, system, tools, tool results, images and
+# effort bodies against an empty vocabulary).
+DSV4_RECIPE_SPECIAL_TOKENS = (
+    "<｜begin▁of▁sentence｜>",
+    "<｜end▁of▁sentence｜>",
+    "<｜System｜>",
+    "<｜User｜>",
+    "<｜Assistant｜>",
+    "<think>",
+    "</think>",
+    "｜DSML｜",
+    "<｜deepseek_image｜>",
+)
+
+
+def synthetic_recipe_backend():
+    """A byte-level fast tokenizer (one token per byte) that deepseek-recipe accepts."""
+    from tokenizers import AddedToken, Tokenizer, decoders, models, pre_tokenizers
+
+    alphabet = sorted(pre_tokenizers.ByteLevel.alphabet())
+    tokenizer = Tokenizer(
+        models.BPE(vocab={c: i for i, c in enumerate(alphabet)}, merges=[])
+    )
+    tokenizer.pre_tokenizer = pre_tokenizers.ByteLevel(add_prefix_space=False)
+    tokenizer.decoder = decoders.ByteLevel()
+    tokenizer.add_special_tokens(
+        [
+            AddedToken(token, special=True, normalized=False)
+            for token in DSV4_RECIPE_SPECIAL_TOKENS
+        ]
+    )
+    return tokenizer
+
+
+def route_recipe_encode_through_stub_tokenizers(monkeypatch):
+    """Let a stub tokenizer stand where deepseek-recipe's encode runs.
+
+    The DeepSeek-V4/V4.1 render is deepseek-recipe's: it tokenizes with its own
+    copy of the checkpoint's fast tokenizer and never calls the HF tokenizer's
+    ``encode``. A stub tokenizer (held, tracked, raising) has no fast tokenizer,
+    so the recipe is built on ``synthetic_recipe_backend()`` and its prompt is
+    handed to the stub's ``encode``, whose ids are the prompt ids. The encode
+    therefore runs on the same thread, under the same context, as recipe's.
+    Inside a preprocess worker the stub is the worker's tokenizer copy (the
+    lane's view), as for any other encoding. (recipe itself shares one native
+    tokenizer across threads; it releases the GIL while it encodes.)
+    """
+    from types import SimpleNamespace
+
+    from sglang.srt.entrypoints.openai import preprocess_lanes
+    from sglang.srt.parser.deepseek_recipe_renderer import DeepSeekRecipe
+
+    original_from_hf_tokenizer = DeepSeekRecipe.from_hf_tokenizer.__func__
+    original_encode = DeepSeekRecipe.encode
+
+    def from_hf_tokenizer(cls, chat_encoding_spec, tokenizer):
+        recipe = original_from_hf_tokenizer(
+            cls,
+            chat_encoding_spec,
+            SimpleNamespace(backend_tokenizer=synthetic_recipe_backend()),
+        )
+        recipe._sbr_stub_tokenizer = tokenizer
+        return recipe
+
+    def encode(self, body, **kwargs):
+        prompt_ids = original_encode(self, body, **kwargs)
+        stub = getattr(self, "_sbr_stub_tokenizer", None)
+        if stub is None:
+            return prompt_ids
+        view = getattr(preprocess_lanes._worker_local, "view", None)
+        if view is not None:
+            stub = view.tokenizer
+        prompt = self.hf_tokenizer.decode(prompt_ids, skip_special_tokens=False)
+        return stub.encode(prompt)
+
+    monkeypatch.setattr(
+        DeepSeekRecipe, "from_hf_tokenizer", classmethod(from_hf_tokenizer)
+    )
+    monkeypatch.setattr(DeepSeekRecipe, "encode", encode)
diff --git a/test/srt/sbr/conftest.py b/test/srt/sbr/conftest.py
new file mode 100644
index 0000000000..43857a1965
--- /dev/null
+++ b/test/srt/sbr/conftest.py
@@ -0,0 +1,202 @@
+"""CPU-only test scaffolding for the ``sbr`` (the serving router) patch series.
+
+The modules under test (``tokenizer_manager``, ``serving_chat``, the
+Anthropic façade, the metrics collector, ``kv_events``, ``load_snapshot``)
+import ``triton`` and CUDA-only helpers at module load. Nothing in these
+tests launches a kernel, so a permissive stand-in for ``triton`` is
+installed before the first ``sglang`` import, torch's caches are pointed at
+a temp dir, and ``torch.mps.Stream`` (absent on CPU torch builds) is shimmed.
+
+MPS is reported unavailable for the whole process, so an Apple Silicon host
+runs the same CPU paths as any other machine without a GPU: with MPS up,
+``is_mps()`` is True and ``scheduler.py`` imports the MLX overlap mixin
+(``mlx.core``, not in the CPU venv) at module load, and the MPS branches
+elsewhere in the tree would change what these tests exercise.
+
+Run with plain ``pytest test/srt/sbr`` on a machine without a GPU. On a
+CUDA box with the real triton installed the stand-in is skipped.
+"""
+
+from __future__ import annotations
+
+import importlib.machinery
+import importlib.util
+import os
+import sys
+import tempfile
+import types
+from unittest import mock
+
+_CACHE_ROOT = os.path.join(tempfile.gettempdir(), "sglang-sbr-tests")
+os.makedirs(_CACHE_ROOT, exist_ok=True)
+for _var, _sub in (
+    ("XDG_CACHE_HOME", "xdg"),
+    ("TORCHINDUCTOR_CACHE_DIR", "inductor"),
+    ("HF_HOME", "hf"),
+    ("SGLANG_CACHE_DIR", "sglang"),
+):
+    os.environ.setdefault(_var, os.path.join(_CACHE_ROOT, _sub))
+
+
+class _PermissiveMeta(type):
+    """A class whose instances and attributes accept anything."""
+
+    def __getattr__(cls, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        return mock.MagicMock(name=f"{cls.__module__}.{cls.__name__}.{name}")
+
+    def __getitem__(cls, item):
+        return cls
+
+
+class _Permissive(metaclass=_PermissiveMeta):
+    def __init__(self, *args, **kwargs):
+        pass
+
+    def __call__(self, *args, **kwargs):
+        return mock.MagicMock(name="call")
+
+    def __getattr__(self, name):
+        if name.startswith("__"):
+            raise AttributeError(name)
+        return mock.MagicMock(name=name)
+
+    def __getitem__(self, item):
+        return self
+
+
+def _stub_module(name: str, **attrs) -> types.ModuleType:
+    mod = types.ModuleType(name)
+    mod.__spec__ = importlib.machinery.ModuleSpec(name, None)
+    mod.__path__ = []  # type: ignore[attr-defined]
+    mod.__file__ = f"<stub {name}>"
+    cache: dict[str, type] = {}
+
+    def __getattr__(attr):
+        if attr.startswith("__"):
+            raise AttributeError(attr)
+        cls = cache.get(attr)
+        if cls is None:
+            # A real class: usable as an isinstance target (torch's
+            # flop_counter does that with ``JITFunction``) and callable.
+            cls = _PermissiveMeta(attr, (_Permissive,), {"__module__": name})
+            cache[attr] = cls
+        return cls
+
+    mod.__getattr__ = __getattr__  # type: ignore[attr-defined]
+    for key, value in attrs.items():
+        setattr(mod, key, value)
+    sys.modules[name] = mod
+    return mod
+
+
+def _identity_decorator(fn=None, **kwargs):
+    if fn is not None and callable(fn) and not kwargs:
+        return fn
+    return lambda f: f
+
+
+def _install_triton_stub() -> None:
+    if importlib.util.find_spec("triton") is not None:
+        return
+    _stub_module(
+        "triton",
+        __version__="3.8.0",
+        jit=_identity_decorator,
+        autotune=lambda *a, **k: (lambda f: f),
+        heuristics=lambda *a, **k: (lambda f: f),
+        cdiv=lambda a, b: (a + b - 1) // b,
+        next_power_of_2=lambda n: 1 << (int(n) - 1).bit_length(),
+    )
+    class _Constexpr(int):
+        """``tl.constexpr``: upstream reads ``.value`` at module level."""
+
+        @property
+        def value(self):
+            return int(self)
+
+    _stub_module("triton.language", constexpr=_Constexpr)
+    for sub in (
+        "triton.compiler",
+        "triton.compiler.compiler",
+        "triton.backends",
+        "triton.backends.compiler",
+        "triton.runtime",
+        "triton.runtime.jit",
+        "triton.runtime.autotuner",
+        "triton.runtime.driver",
+        "triton.knobs",
+        "triton.testing",
+        "triton.language.extra",
+        "triton.language.extra.libdevice",
+    ):
+        _stub_module(sub)
+    for parent, child in (
+        ("triton", "language"),
+        ("triton", "compiler"),
+        ("triton", "backends"),
+        ("triton", "runtime"),
+        ("triton", "knobs"),
+        ("triton", "testing"),
+        ("triton.runtime", "jit"),
+        ("triton.runtime", "autotuner"),
+        ("triton.runtime", "driver"),
+        ("triton.compiler", "compiler"),
+        ("triton.backends", "compiler"),
+        ("triton.language", "extra"),
+        ("triton.language.extra", "libdevice"),
+    ):
+        setattr(sys.modules[parent], child, sys.modules[f"{parent}.{child}"])
+
+    # No GPU driver: fla/utils.py (imported by the scheduler through the mamba
+    # triton ops) probes triton.runtime.driver.active at module load and falls
+    # back to "cpu" only when that probe raises; a permissive stand-in would
+    # hand it a MagicMock as the backend name.
+    class _NoActiveDriver:
+        def get_current_target(self):
+            raise RuntimeError("triton stand-in: no active GPU driver")
+
+        def get_active_torch_device(self):
+            raise RuntimeError("triton stand-in: no active GPU driver")
+
+    sys.modules["triton.runtime.driver"].active = _NoActiveDriver()
+
+
+def _install_ipython_stub() -> None:
+    if importlib.util.find_spec("IPython") is not None:
+        return
+    _stub_module("IPython")
+    _stub_module("IPython.display")
+    sys.modules["IPython"].display = sys.modules["IPython.display"]  # type: ignore[attr-defined]
+
+
+def _shim_torch_mps() -> None:
+    import torch
+
+    if not hasattr(torch.mps, "Stream"):
+        torch.mps.Stream = mock.MagicMock(name="torch.mps.Stream")
+
+
+def _report_mps_unavailable() -> None:
+    """Make every MPS probe answer False, as on a host without a GPU.
+
+    Only the leaf is replaced: ``torch.mps.is_available`` (via
+    ``device_count``) and the cached ``torch.backends.mps.is_available`` both
+    call ``torch._C._mps_is_available``, so their wrappers -- and the
+    ``__wrapped__`` that ``torch._dynamo`` reads -- stay intact. Cached answers
+    from before this runs are dropped, including sglang's own ``is_mps``.
+    """
+    import torch
+
+    torch._C._mps_is_available = lambda: False
+    torch.backends.mps.is_available.cache_clear()
+    common = sys.modules.get("sglang.srt.utils.common")
+    if common is not None:
+        common.is_mps.cache_clear()
+
+
+_install_triton_stub()
+_install_ipython_stub()
+_shim_torch_mps()
+_report_mps_unavailable()
