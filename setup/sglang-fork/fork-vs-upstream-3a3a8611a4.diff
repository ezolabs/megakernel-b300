+def _arm(
+    monkeypatch,
+    *,
+    hicache=True,
+    tp=8,
+    pp=1,
+    dp_attention=False,
+    linker=None,
+    env="1",
+    gate="gate",
+):
+    from sglang.srt.managers import scheduler as scheduler_mod
+    from sglang.srt.mem_cache.hicache_poll_gate import HiCachePollGate
+
+    monkeypatch.setattr(
+        scheduler_mod,
+        "get_parallel",
+        lambda: SimpleNamespace(attn_dp_enabled=dp_attention, tp_size=tp, pp_size=pp),
+    )
+    monkeypatch.setenv("SGLANG_HICACHE_POLL_ON_HINT", env)
+    g = HiCachePollGate(lambda: False, heartbeat_calls=64) if gate == "gate" else None
+    stand_in = SimpleNamespace(
+        enable_hierarchical_cache=hicache,
+        tree_cache=SimpleNamespace(hicache_poll_gate=g, linker=linker),
+    )
+    returned = scheduler_mod.Scheduler._maybe_arm_hicache_poll_gate(stand_in)
+    return returned, g
