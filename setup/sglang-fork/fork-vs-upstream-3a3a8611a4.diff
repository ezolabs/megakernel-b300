+def _decode_json_escape(raw: str) -> tuple[int, str]:
+    """Decode the escape sequence `raw` starts with (a backslash), the way the C
+    json scanner does, surrogate pairs included. Returns (chars used, decoded
+    char), or (0, "") when `raw` is too short to decide."""
+    if len(raw) < 2:
+        return 0, ""
+    if raw[1] != "u":
+        if raw[1] in _JSON_ESCAPES:
+            return 2, _JSON_ESCAPES[raw[1]]
+        raise _Unstreamable("invalid escape")
+    if not all(c in _HEX_DIGITS for c in raw[2:6]):
+        raise _Unstreamable("invalid \\u escape")
+    if len(raw) < 6:
+        return 0, ""
+    code = int(raw[2:6], 16)
+    if not 0xD800 <= code <= 0xDBFF:
+        return 6, chr(code)
+    # A high surrogate joins a following \u low surrogate.
+    if len(raw) < 7:
+        return 0, ""
+    if raw[6] != "\\":
+        return 6, chr(code)
+    if len(raw) < 8:
+        return 0, ""
+    if raw[7] != "u":
+        return 6, chr(code)
+    if not all(c in _HEX_DIGITS for c in raw[8:12]):
+        raise _Unstreamable("invalid \\u escape")
+    if len(raw) < 12:
+        return 0, ""
+    low = int(raw[8:12], 16)
+    if 0xDC00 <= low <= 0xDFFF:
+        return 12, chr(0x10000 + (((code - 0xD800) << 10) | (low - 0xDC00)))
