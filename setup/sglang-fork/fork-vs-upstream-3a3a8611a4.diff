+            ([{"index": 2, "width": 4, "height": 4}], 2),  # out of range
+            ([{"index": 0, "width": 4, "height": 4}] * 2, 3),  # duplicate
+            ([{"index": 0, "width": 4, "height": 4}], 1),  # mm_hashes too short
+            ([{"index": True, "width": 4, "height": 4}], 2),  # bool index
+        ]
+        with envs.SGLANG_MM_CACHED_REFS.override(True):
+            for refs, n_hashes in bad:
