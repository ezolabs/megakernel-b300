+    def __init__(self) -> None:
+        # One frame per open container: [kind ("{" or "["), expectation, keys].
+        self.stack: list[list] = []
+        self.done = False
+        self.token = None  # None, "string", "number" or "literal"
+        self.token_text = ""  # number/literal text, or a key's decoded chars
