+                    "required": ["city"],
+                },
+            },
+        }
+
+    def setUp(self):
+        ServingChatTestCase.setUp(self)
+        # The client stays connected while the stream runs.
+        self.fastapi_request.is_disconnected = AsyncMock(return_value=False)
+        self.template_manager.chat_template_name = None
+        self.template_manager.jinja_template_content_format = "string"
+        self.tm.tokenizer = self.tokenizer
+        self.chat.chat_encoding_spec = "dsv41"
+        self.chat.reasoning_parser = "deepseek-v41"
+        self.chat.tool_call_parser = "deepseekv41"
+        self.chat._encoding_adapter = self.chat._build_chat_encoding_adapter()
+        self.tools = [self._tool("get_weather"), self._tool("get_time")]
+
+    def _request(self, tool_choice, thinking=False, **kwargs):
+        body = {
+            "model": "x",
+            "messages": [{"role": "user", "content": "Weather in Paris?"}],
+            "tools": self.tools,
+            "tool_choice": tool_choice,
+            "thinking": {"type": "enabled" if thinking else "disabled"},
+            **kwargs,
+        }
+        request = ChatCompletionRequest(**body)
+        self.assertIsNone(self.chat._validate_request(request))
+        return request
+
+    def _process(self, request):
+        """The rendered prompt text, and the processing result; the render also
+        flags ``request._calls_block_prefilled``."""
+        result = self.chat._process_messages(request, is_multimodal=False)
+        return self.tokenizer.decode(result.prompt_ids), result
+
+    @staticmethod
+    def _named(name="get_weather"):
+        return {"type": "function", "function": {"name": name}}
+
+    def _completion(self, *calls):
+        """The model's output after the prefill: the invokes and the closer."""
+        invokes = "\n".join(
+            f'<{self.DSML} invoke name="{name}">\n'
+            f'<{self.DSML} parameter name="city" string="true">{city}'
+            f"</{self.DSML} parameter>\n</{self.DSML} invoke>"
+            for name, city in calls
+        )
+        return f"{invokes}\n</{self.DSML} calls>"
+
+    def _output(self, text, finish="stop"):
+        """An engine output of ``text``, as token ids too."""
+        ret = _spec_result(0)
+        ret["text"] = text
+        ret["output_ids"] = self.tokenizer.encode(text, add_special_tokens=False)
+        ret["meta_info"]["completion_tokens"] = len(ret["output_ids"])
+        ret["meta_info"]["finish_reason"] = finish and {"type": finish}
+        return ret
+
+    def _response(self, request, text, finish="stop"):
+        self._process(request)
+        return self.chat._build_chat_response(
+            request, [self._output(text, finish)], created=1
+        ).choices[0]
+
+    def test_forced_call_ends_the_prompt_inside_the_calls_block(self):
+        for choice, listed in (
+            (self._named(), ["get_weather"]),
+            (self._named("get_time"), ["get_time"]),
+            ("required", ["get_weather", "get_time"]),
+        ):
+            with self.subTest(choice=choice):
+                request = self._request(choice)
+                prompt, result = self._process(request)
+                self.assertTrue(request._calls_block_prefilled)
+                self.assertTrue(prompt.endswith(self.PREFILL), prompt[-80:])
+                for name in ("get_weather", "get_time"):
+                    self.assertEqual(f'"name": "{name}"' in prompt, name in listed)
+                kind, tag = result.tool_call_constraint
+                self.assertEqual(kind, "structural_tag")
+                # The grammar starts at the first invoke, after the opener.
+                self.assertNotEqual(tag.format.elements[0].type, "const_string")
+                self.assertEqual(tag.format.elements[-1].value, f"</{self.DSML} calls>")
+
