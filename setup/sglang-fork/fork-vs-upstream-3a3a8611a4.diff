+def _convert(chat, body: dict, input_ids=None):
+    """One conversion; returns (GenerateReqInput, request, encode calls)."""
+    if input_ids is not None:
+        body = dict(body, input_ids=list(input_ids))
+    _CountingTokenizer.encoded = []
+    adapted, request = chat._convert_to_internal_request(
+        ChatCompletionRequest(**body), _raw_request()
+    )
+    return adapted, request, list(_CountingTokenizer.encoded)
+
+
+def _both(chat, record):
+    by_messages = _convert(chat, record["egress"])
+    by_ids = _convert(chat, record["egress"], record["router_ids"])
+    return by_messages, by_ids
+
+
+def _field_differences(a: GenerateReqInput, b: GenerateReqInput) -> Dict[str, tuple]:
+    out = {}
+    for field in dataclasses.fields(GenerateReqInput):
+        x, y = getattr(a, field.name), getattr(b, field.name)
+        if field.name == "sampling_params":
+            for key in sorted(set(x) | set(y)):
+                if x.get(key) != y.get(key):
+                    out[f"sampling_params.{key}"] = (x.get(key), y.get(key))
+        elif field.name == "image_data" and _urls(x) == _urls(y):
+            continue  # upstream wraps each url in a fresh ImageData
+        elif x != y:
+            out[field.name] = (x, y)
+    return out
+
+
+def _scheduler_sampling(params: dict, tokenizer) -> dict:
+    """What the tokenizer manager hands the scheduler for these sampling params
+    (``SamplingParams`` is a msgspec struct: every field, after normalize/verify)."""
+    sampling = SamplingParams(**params)
+    sampling.normalize(tokenizer)
+    sampling.verify(len(tokenizer))
+    return {name: getattr(sampling, name) for name in sampling.__struct_fields__}
