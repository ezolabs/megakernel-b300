+# ---------------------------------------------------------------------------
+# HiCache: the Full KV comes back from the host tier, the window is replayed
+# ---------------------------------------------------------------------------
+
+
+class _HostController:
+    """cache_controller stand-in: a Full-KV load copies host latents into the
+    device Full pool at freshly allocated slots, and nothing else."""
+
+    def __init__(self, tree, pools, host):
+        self.tree, self.pools, self.host = tree, pools, host
+        self.loads = []
+
+    def load(self, host_indices, node_id, extra_pools=None):
+        self.loads.append((host_indices.clone(), node_id, extra_pools))
+        device = self.tree.token_to_kv_pool_allocator.full_attn_allocator.alloc(
+            len(host_indices)
+        )
+        self.pools["m"][device] = self.host[host_indices]
+        return device
+
+    def reset(self):
+        pass
+
+
+def test_hicache_full_kv_loaded_back_then_the_window_is_replayed():
+    model = RefModel()
+    tree = _swa_cache()
+    tree.configure_swa_branch_rebuild(LAYERS)
+    core = tree.tree_core
+    core.set_hicache_enabled()
+    core.has_swa_host_pool = True  # DSV4 HiCache mirrors SWA too
+    pools, slots = _previous_turn(model, tree)
+    # Back the whole turn up to the host tier and demote it: its Full KV and
+    # its last window leave the device.
+    host = torch.zeros(KV_SIZE, LAYERS, model.dim, dtype=torch.float64)
+    host_idx = torch.arange(100, 100 + STORED)
+    host[host_idx] = pools["m"][slots]
+    root = core.root_node
+    stored = next(iter(root.children.values()))
+    tail_node = next(iter(stored.children.values()))
+    for node in (stored, tail_node):
+        lo = sum(len(n.key) for n in _ancestors(node)) - len(node.key)
+        core.commit_backup(node.id, host_idx[lo : lo + len(node.key)], {})
+    tracker = {ct: 0 for ct in tree.components}
+    tree._demote(tail_node.id, tracker)
+    tree._demote(stored.id, tracker)
+    assert stored.evicted and tail_node.evicted
+    pools["m"][slots] = 0.0  # the device copy is gone
+    tree.cache_controller = _HostController(tree, pools, host)
+    tree.load_back_threshold = 1
+
+    req = _branch_req()
+    req.init_next_round_input(tree)
+    plan = req.swa_rebuild_match
+    assert isinstance(plan, SwaRebuildMatch)
+    assert plan.host_hit_length == BRANCH and plan.device_prefix_len == 0
+    assert req.needs_host_load_back() and req.swa_host_hit_length == 0
+
+    counter_log = []
+    logits, runner, row = _serve(tree, model, pools, req, counter=_Counter(counter_log))
+    # One Full-only load of the branch's 40 tokens, no SWA transfer.
+    ((host_indices, node_id, extra),) = tree.cache_controller.loads
+    assert host_indices.tolist() == host_idx[:BRANCH].tolist()
+    assert not extra
+    # The replay waited for the last layer of the load before its first forward.
+    assert counter_log == [("wait", LAYERS - 1)]
+    cold_logits, cold_pools, cold_row, cold_map = model.cold(list(req.origin_input_ids))
+    mapping = tree.token_to_kv_pool_allocator.full_to_swa_index_mapping
+    for a, b in zip(
+        _swa_kv(pools, mapping, row, BRANCH - TAIL, BRANCH),
+        _swa_kv(cold_pools, cold_map, cold_row, BRANCH - TAIL, BRANCH),
+    ):
+        assert (a - b).abs().max().item() < 1e-10
+    assert (logits[-1] - cold_logits[-1]).abs().max().item() < 1e-10
+
+
+def _ancestors(node):
+    out = []
+    while node.parent is not None:
+        out.append(node)
+        node = node.parent
+    return out
+
+
+def test_hicache_swa_load_back_of_a_rebuild_anchor_is_full_only():
+    tree = _swa_cache()
+    core = tree.tree_core
+    core.set_hicache_enabled()
+    core.has_swa_host_pool = True
+    _store_turn(tree, keep_tail=False)
+    stored = next(iter(core.root_node.children.values()))
+    from sglang.srt.mem_cache.unified_cache.components.base import (
+        CacheTransferPhase,
+    )
+
+    swa = tree.components[ComponentType.SWA]
+    assert swa.build_hicache_transfers(stored, CacheTransferPhase.LOAD_BACK) is None
+
