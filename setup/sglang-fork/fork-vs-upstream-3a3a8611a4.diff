+
+def test_the_skipped_head_starts_chunking_once_the_long_prompt_ends(cache):
+    # The giant has 800 tokens left: it finishes this pass, so nothing
+    # continues into the waiting loop and the cold head, first in the queue,
+    # becomes the one continuing request. The warm turn waits (queue order).
+    cold, warm = _cold("cold-7.7k", 1.0), _warm("warm", 2.0)
