+def test_on_the_cache_hooks_sit_immediately_around_the_cache_insert(detail):
+    """Placement, driven through process_batch_result_prefill: the stand-in cache insert
+    reads the stamps at the instant it runs."""
+    seen = {}
+
+    def cache_insert(req, tree_cache):
+        stamps = req.sbr_phase.stamps
+        seen["before"] = dict(stamps)
+        seen["t_call"] = time.perf_counter()
+
+    hisparse = mock.Mock()
+
+    def admit(req):
+        seen["admit"] = dict(req.sbr_phase.stamps)
+
+    hisparse.admit_request_into_staging.side_effect = admit
+    sender = _Sender()
+    streamer = _streamer(sender)
+    req = _arrive()
+    batch, result = _prefill_batch([req], [7])
+    with _scheduler_runtime(hisparse=True, cache_fn=cache_insert):
+        _processor(streamer, hisparse).process_batch_result_prefill(batch, result)
+
+    st = req.sbr_phase.stamps
+    # At the insert: cache_start is taken, cache_done is not, first_token is.
+    assert "first_token" in seen["before"]
+    assert "cache_start" in seen["before"] and "cache_done" not in seen["before"]
+    assert st["first_token"] <= st["cache_start"] <= seen["t_call"] <= st["cache_done"]
+    # The hisparse admit stays outside the bracket: cache_done is already stamped
+    # when it runs and stream_start is not, so the admit falls in
+    # cache_done_to_stream_start.
+    hisparse.admit_request_into_staging.assert_called_once_with(req)
+    assert "cache_done" in seen["admit"] and "stream_start" not in seen["admit"]
+    assert st["cache_done"] <= st["stream_start"]
+
