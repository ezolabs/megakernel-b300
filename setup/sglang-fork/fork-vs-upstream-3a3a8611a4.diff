+def _detok_batch(manager, rids, finished, framed=True):
+    """One batch through the handler, framed the way ``event_loop`` frames it."""
+    n = len(rids)
+    fields = {
+        f.name: None
+        for f in msgspec.structs.fields(BatchTokenIDOutput)
+        if f.required
+    }
+    fields.update(
+        rids=list(rids),
+        http_worker_ipcs=[None] * n,
+        finished_reasons=list(finished),
+        decoded_texts=[""] * n,
+        decode_ids=[array("q", [1, 2, 3]) for _ in rids],
+        read_offsets=[3] * n,
+        output_ids=[array("q", [4]) for _ in rids],
+        skip_special_tokens=[True] * n,
+        spaces_between_special_tokens=[True] * n,
+        no_stop_trim=[False] * n,
+        prompt_tokens=[3] * n,
+        reasoning_tokens=[0] * n,
+        completion_tokens=[1] * n,
+        cached_tokens=[0] * n,
+    )
+    recv_obj = BatchTokenIDOutput(**fields)
+    token = manager.sbr_detok_begin(recv_obj) if spt.DETAIL and framed else None
+    out = manager.handle_batch_token_id_out(recv_obj)
+    if token is not None:
+        spt.detok_end(token)
+    return out
+
