+@pytest.mark.parametrize("tokenizer_cls", [_UncopyableTokenizer, _HeldTokenizer])
+async def test_an_uncopyable_tokenizer_is_shared_one_conversion_at_a_time(
+    tokenizer_cls, lanes_config, caplog
