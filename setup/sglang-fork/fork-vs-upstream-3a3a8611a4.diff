+def test_refused_heads_in_turn_stop_within_the_budget(cache, engine):
+    # No request slot is ever free, so every swapped-in head is refused and the
+    # giant loses that pass. Each lost pass is charged, and the next distinct
+    # mid-size head (the refused one's client gave up, so it left the queue) is
+    # swapped only while the budget has room for the passes it would need.
+    # 15,000 tokens: after two lost passes (8,192) a 7.7k head's two passes no
+    # longer fit, so the giant loses two passes, not one per arrival.
+    giant = _giant(cache)
+    heads = [_cold(f"cold-{i}", float(i + 1)) for i in range(6)]
+    e = engine(cache, list(heads), giant)
+    e.allocatable = 0
+    steps = []
+    for _ in range(6):
+        steps.append(e.step())
+        if e.s.waiting_queue and e.s.waiting_queue[0].rid in e.swap.refused:
+            e.s.waiting_queue.pop(0)
+    lost = [n for n, step in enumerate(steps) if step.extend("giant") is None]
+    assert lost == [0, 1]
+    assert e.swap.refused == {"cold-0", "cold-1"}
+    assert e.swap.spent == 2 * CHUNKED_PREFILL <= SWAP_BUDGET * GIANT
+    for n, step in enumerate(steps[2:]):
+        start = COMPUTED + n * CHUNKED_PREFILL
+        assert step.extend("giant") == (start, start + CHUNKED_PREFILL)
+        assert step.parked is None
+
