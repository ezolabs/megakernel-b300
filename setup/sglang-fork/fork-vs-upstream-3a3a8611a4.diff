+
+    @staticmethod
+    def _host_copy_settled(node: Any) -> bool:
+        """Whether the live path has announced ``node``'s host copy.
+
+        ``backuped`` is the tree's own "KV present on host" (``RadixCache``'s
+        ``TreeNode`` and the unified tree's ``UnifiedTreeNode`` both define it;
+        a cache without a host tier never sets it). A copy whose write-through
+        is still pending is on its way, not settled: ``record_store(node,
