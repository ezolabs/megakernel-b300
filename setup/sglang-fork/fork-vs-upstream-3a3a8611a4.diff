+def _prefill_done_at(steps, req):
+    """1-based step whose batch prefills ``req``'s last prompt token (its first
+    output token is sampled from that batch), or None."""
+    for n, step in enumerate(steps, 1):
+        span = step.extend(req.rid)
+        if span is not None and span[1] == len(req.origin_input_ids):
+            return n
+    return None
+
