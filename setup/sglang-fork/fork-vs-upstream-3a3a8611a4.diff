+class TestDeepSeekV41PrefilledCallsBlock(CustomTestCase):
+    """A forced tool call's prompt ends with the calls-block opener (as
+    deepseek-recipe renders it), so the output starts at the first invoke. It
+    must parse, one-shot and streamed, exactly as the same output with the
+    opener in front does, and the grammar must start after the opener."""
+
+    CALLS = [
+        ("get_weather", {"city": "Paris"}),
+        ("lookup", {"query": '{"a": 1}', "limit": 2, "flags": [1, True, None]}),
+    ]
+
+    def setUp(self):
+        # ``strict`` unset: not strict (values any JSON, names the declared
+        # ones), as before upstream #46133 made the default None.
+        self.tools = _tools()
+
+    @staticmethod
+    def _completion(calls):
+        """The assistant turn the encoder renders for ``calls``, cut at the prefill."""
+        rendered = _render_assistant(
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [
+                    {
+                        "type": "function",
+                        "function": {"name": name, "arguments": json.dumps(args)},
+                    }
+                    for name, args in calls
+                ],
+            },
+            thinking=False,
+        ).removesuffix(EOS)
+        assert rendered.startswith(PREFILL), rendered
+        return rendered[len(PREFILL) :]
+
+    def _parser(self, prefilled=True, tools=None):
+        return FunctionCallParser(
+            self.tools if tools is None else tools,
+            "deepseekv41",
+            calls_block_prefilled=prefilled,
+        )
+
+    def _stream(self, parser, text, chunk_size, lead=""):
+        """Stream ``text`` in chunks, ``lead`` in front of the first one."""
+        normal, calls = "", []
+        for i in range(0, len(text), chunk_size):
+            chunk = text[i : i + chunk_size]
+            piece, delta = parser.parse_stream_chunk(lead + chunk if i == 0 else chunk)
+            normal += piece
+            calls.extend(delta)
+        piece, delta = parser.parse_stream_end()
+        return normal + piece, calls + list(delta)
+
+    def test_prefill_is_the_encoders_calls_block_opener(self):
+        self.assertEqual(PREFILL, f"\n\n<{DSML} calls>\n")
+        self.assertEqual(DeepSeekV41Detector().tool_calls_prefill, PREFILL)
+
+    def test_one_shot_parse_equals_the_parse_with_the_prefill(self):
+        for calls in (self.CALLS[:1], self.CALLS):
+            completion = self._completion(calls)
+            with self.subTest(calls=len(calls)):
+                self.assertTrue(completion.startswith(f'<{DSML} invoke name="'))
+                parser = self._parser()
+                self.assertTrue(parser.has_tool_call(completion))
+                normal, parsed = parser.parse_non_stream(completion)
+                ref_normal, ref = self._parser(False).parse_non_stream(
+                    PREFILL + completion
+                )
+                self.assertEqual(normal, "")
+                self.assertEqual(normal, ref_normal)
+                self.assertEqual(
+                    [(c.name, json.loads(c.parameters)) for c in parsed], calls
+                )
+                self.assertEqual(
+                    [(c.tool_index, c.name, c.parameters) for c in parsed],
+                    [(c.tool_index, c.name, c.parameters) for c in ref],
+                )
+
+    def test_streaming_parse_equals_the_parse_with_the_prefill(self):
+        completion = self._completion(self.CALLS)
+        for chunk_size in CHUNK_SIZES:
+            with self.subTest(chunk_size=chunk_size):
+                normal, calls = self._stream(self._parser(), completion, chunk_size)
+                # The same model tokens, the prompt's prefill in front of them.
+                ref_normal, ref = self._stream(
+                    self._parser(False), completion, chunk_size, lead=PREFILL
+                )
+                self.assertEqual(normal, "")
+                self.assertEqual(normal, ref_normal)
+                self.assertEqual(_assemble(calls), self.CALLS)
+                self.assertEqual(
+                    [(c.tool_index, c.name, c.parameters) for c in calls],
+                    [(c.tool_index, c.name, c.parameters) for c in ref],
+                )
+
+    def test_cut_off_block_drops_its_calls_as_without_the_prefill(self):
