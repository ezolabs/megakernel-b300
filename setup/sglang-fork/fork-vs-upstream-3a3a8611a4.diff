+def test_gate_created_then_removed_follows_the_file_within_the_recheck(gate):
+    assert spt.active() is False
+    gate.path.write_text("")
+    # Still inside the second: the cached answer stands.
+    gate.clock.now += 0.5
+    assert spt.active() is False
+    # At the recheck: the file is seen.
+    gate.clock.now += 0.5
+    assert spt.active() is True
+    assert spt.detail_active() is True
+    gate.path.unlink()
+    gate.clock.now += 0.5
+    assert spt.active() is True  # not yet looked up again
+    gate.clock.now += 0.5
+    assert spt.active() is False
+    assert spt.detail_active() is False
