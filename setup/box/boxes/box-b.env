# STOPPED since 2026-11-05 01:57:49Z (`exited` 01:58:27Z; never destroyed) by the user's delegated order ("ok i'm putting you in charge of
# taking down box-b when you are finished"): rows box-b / box-b-dev parked by autopool, box-a serves alone. Record:
# qa/box-b-shutdown-20261105/NOTES.md. Last tree served: FORK_TREE below (prod 163591d9fc) + args/stack-b300-box-a-mk2.args
# + ENV_SEED (env-box-a-mk2.txt) + the FREEZEGC_CMD timer. Way back, only on the user's word: `hostctl start instance
# <INSTANCE_ID>` (the GPUs may have been re-let: the slot may not come back), then autopool rejoins box-b / box-b-dev on its
# own once both doors answer /health (onstart restarts engine, hangwatch and the freeze timer); re-read
# BOX_IP/SSH_PORT/APP_PORT_EXT from `hostctl show instance` (moved: autopool_rebind_needed).
#
# box-b — 4× B300 on a rented host: a copy of box-a's serving stack, cut from
# boxes/box-a.env with only the box-identifying keys changed. Same image digest, same paths, same
# config X' (fork prod 9a9ede7ae0 + the megakernel plugin, tools/args/stack-b300-box-a-mk2.args + env-box-a-mk2.txt,
# the L3a repack). Venv, tree, plugin and JIT caches were copied box-to-box from box-a, the repack from box-a + box-c
# (sha256-verified). Record: qa/box-b-bringup-20261030/NOTES.md; box sheet fleet-history/box-b/README.md.
# Way back: box-a's (boxes/box-a.env's FORK_TREE comment). Every script in ../ sources this through
# lib.sh (BOX=box-b). No secrets here: they live in ENV_FILE on the dev box and in /etc/environment on
# the box. BOX_IP/SSH_PORT/APP_PORT_EXT are re-read from `hostctl show instance` at a start.
BOX=box-b
BOX_IP="<BOX_IP>"           # instance <INSTANCE_ID> (machine <MACHINE_ID>, host <HOST_ID>): its public_ipaddr
SSH_PORT="<SSH_PORT>"                 # instance <INSTANCE_ID>'s DIRECT 22/tcp host mapping. Not 31622: that is the provider's listed ssh_port, the proxy
SSH_KEY="~/.ssh/<SSH_KEY>"   # the key a sandboxed worker can read (no passphrase), in the box's /root/.ssh/authorized_keys
APP_PORT_EXT="<APP_PORT_EXT>"             # instance <INSTANCE_ID>'s 8001/tcp host mapping: the router dials https://box-b.<DOMAIN>:<APP_PORT_EXT>
DOOR_PORT=8001                # container port Caddy listens on (the mapped one)
ENGINE_PORT=8002              # SGLang, loopback only
HOSTNAME="box-b.<DOMAIN>"   # the name the door serves; its DNS record points at BOX_IP
CF_ZONE="<DOMAIN>"
TLS_ALLOW="<ALLOW_CIDR> 127.0.0.1/32 ::1/128"   # the door's source-IP allowlist (QUOTED: lib.sh sources this file), box-a's: stage.sh writes it into caddy.env, the door renders it as the Caddyfile's @allowed matcher, everyone else 403
CADDY_EXPECT_SHA256=22e29521abb1ce00c030192f3c6f9126ecd84c431a672872d04095c1b1c15aba   # stock Caddy v2.11.7 + caddy-dns/cloudflare v0.2.4, box-a's binary of record; the staged binary is pinned by this value
SERVE_BUILD=1017-l3a   # edited as a pair with MODEL_DIR: names the build this box serves (box-c's and box-a's)
MODEL_DIR="<MODEL_PATH>"   # the L3a repack sglang serve loads, box-a's path. Literal, never a reference (boxenv.py cannot expand one)
STOCK_DIR=/workspace/models/DeepSeek-V4.1-Flash-1017   # the onstart's hf-download target on a re-create; absent on the box (MODEL_DIR was copied). Read by the onstart only while ONSTART_MODEL_SOURCE is stock
ONSTART_MODEL_SOURCE=copied   # build-onstart.sh: MODEL_DIR was copied from box-a/box-c, so the onstart downloads nothing and gates the engine on MODEL_DIR's shards + MODEL_READY_MARKER
MODEL_READY_MARKER="<MODEL_READY_MARKER>"   # written by the copy's own `sha256sum -c` against xfer-logs/expected.sha256 (box-a's manifest) once every shard verified
ONSTART_GRANT_FILE=/workspace/tools/authorized_keys2.box-b-kv   # the router tunnel's key grant (box-b-kv), staged on the box by hand; every boot restores /root/.ssh/authorized_keys2 from it
HANGWATCH_CMD="python3 /workspace/mk29/harness/hangwatch.py --service --on-hang kill --out /workspace/mk29/watch/serving --dump-signal none"   # build-onstart.sh (autopool B1): every boot starts the hang watcher after the engine launch (relaunch.sh starts the watchdog); a running copy (same script, same --out) is kept; it holds its own BOOT grace while the engine loads. --dump-signal none: the USR2 catcher in our ranks is LLVM (Triton) with SA_RESETHAND, so the default USR2 stack dump kills the rank (qa/sglang-takes-20261104/merge-b300/NOTES.md, M1/M1b); build-onstart.sh refuses a knob that leaves --dump-signal to the default
FREEZEGC_CMD="bash /workspace/tools/freeze-gc-timer.sh --interval-s 300"   # the recurring POST /freeze_gc (tools/freeze-gc-timer.sh, loopback, content-free log /workspace/freezegc/timer.log): box-b's >1 s eviction passes were gen2 GC (qa/eviction-stall-20261105/NOTES.md). Started on every boot by a FREEZEGC block hand-added to the box's /root/onstart.sh after the HANGWATCH block (setsid, its own session: a watchdog or hangwatch relaunch never touches it; flock on timer.lock keeps one copy). build-onstart.sh renders this key (#960, onstart.sh.tmpl `#@freezegc{`, tests/onstart-freezegc.test.sh), so a re-created instance's onstart starts it too, once stage.sh has put tools/freeze-gc-timer.sh at /workspace/tools (a missing script prints FREEZEGC-MISSING and the boot goes on). Stop: touch /workspace/freezegc/stop
SERVED_MODEL=DeepSeek-V4.1-Flash
CACHE=/workspace/cache-mk29   # XDG_CACHE_HOME of the megakernel tree, box-a's path (env-box-a-mk2.txt sets the same), copied from box-a
TOOLS_REMOTE=/workspace/tools # where stage.sh puts this tool set on the box
CERT_PUSH_PUBKEY="<SSH_PUBKEY>"   # the operator host's /root/.ssh/cert-push_ed25519 (public half, config not a secret)
SGLANG_TREE=/workspace/mk29/sglang   # the megakernel checkout at FORK_TREE (detached, clean), the editable sglang of VENV; copied from box-a
ENV_SEED=env-box-a-mk2.txt   # the seed box-b last served (box-a has since moved to env-box-a-mk3.txt) (config X'; incl. the TP probe SGLANG_MK_TP_PROBE=1, EVERY=100, ASSERT=1), paired with args/stack-b300-box-a-mk2.args
VENV=/opt/sglang-mk29   # editable /workspace/mk29/sglang/python + the plugin /workspace/mk29/sgl-nvidia-mega (54b4289 + the B300 patch); copied from box-a
# The engine's runtime gate files (stage.sh materializes them), box-a's live state.
TOOL_STRICT=1
SBR_SCHEMA_MEMO=1
SBR_UNFINISHED_REUSE=1
SBR_PHASE_TIMING=0
WATCHDOG_BOOT_GRACE=2700       # watchdog.sh's cold-boot budget, box-a's
# Scheduler CPU pinning (relaunch.sh, after /health), box-a's cores: on this machine (EPYC 9575F, GPUs on NUMA
# node 0 = CPUs 0-63,128-191) every node-0 core turbos to ~5.0 GHz under a 1 s pinned spin (2026-10-30), so
# box-a's node-0 picks carry over unchanged.
SCHED_CPU_PIN="16 17 32 33"
INSTANCE_ID="<INSTANCE_ID>"         # created 2026-10-30, machine <MACHINE_ID>, host <HOST_ID>; label box-b-dsv41-b300
GPU_NAME=B300
NUM_GPUS=4
DISK_GB=2000              # what <INSTANCE_ID> was created with (the provider disk cannot be resized after create)
# INSTANCE_LABEL unset: offer-search.sh derives ${BOX}-dsv41-${GPU_NAME} -> box-b-dsv41-b300, the label <INSTANCE_ID> carries
ENV_FILE="<HOME>/env/box-b.env"   # dev box: VLLM_API_KEY (box-b's OWN origin bearer, never box-a's or box-c's; keyring item box-b-engine-vllm-api-key-front-door-bearer), HF_TOKEN. Never tracked
FORK_REPO=sgl-project/sglang       # the public upstream this fork tracks (bare owner/repo slug)
FORK_BRANCH=prod   # the our SGLang fork branch FORK_TREE is on: prod's tip 163591d9fc (CAND-FIX committed), box-a's
FORK_TREE=163591d9fcf8c9e9bcaffa2fcc79242fb772fc72   # the COMMIT this box SERVES, detached at SGLANG_TREE, a clean checkout: prod's tip, CAND-FIX committed = sweep-c ad34bd2e96 + b268b87e98 (hicache: keep the Full host eviction heap across calls) + its test, the tree box-a serves (qa/sglang-takes-20261104/b300/NOTES.md; this roll: qa/sglang-takes-20261104/rolls/box-b/NOTES.md). Rollback: ROLLBACK_TREES in order, same args/env/paths
ROLLBACK_TREES="9a9ede7ae0183e7c43956395238e29c406d85fe8 4943d6ed906ad0f761c4845ce85ad664e7f1b7fb"   # the way back, first entry first: 9a9ede7ae0 (served 10-31 -> 11-04, qa/box-b-roll-20261031/NOTES.md), then 4943d6ed90 (qa/prod-merge-20261030/raw/gate/NOTES.md)
FORK_BASE=3a3a8611a45f5a81fd07ffa6b0ed3ba33e7a4db9   # box-a's and box-c's: the upstream/main commit last merged into prod (aee98606, under 4943d6ed90); 4943d6ed90..9a9ede7ae0 holds no merge, only cherry-picks (qa/box-b-roll-20261031/NOTES.md "stage"), nor does 9a9ede7ae0..163591d9fc (sweep-c's seven cherry-picks + the two hicache-evict commits), so prod's tip 163591d9fc sits on it still (checked in the registered checkout for #915: 3a3a8611a4 an ancestor, no merge in the range). Read only by fork-sync.sh (its `git rebase --onto` anchor)
FORK_HOST="root@<FORK_HOST>"
FORK_CLONE=/opt/box-f-fork/sglang
FORK_DEPLOY_KEY="~/.ssh/<FORK_DEPLOY_KEY>"     # box-c's read-only deploy key, reused: this box tracks the same fork
FORK_PRIVATE_REPO="<SGLANG_FORK_URL>"
FORK_MIRROR=/opt/box-f-fork/sglang-mirror.git
FORK_MIRROR_BASE=main
GRAFT_SRC="<HOME>/workspace/backups/grafts/campaign-1017/graft-1017-l3a"   # l3a's graft on THIS Mac, for a re-create that rebuilds the repack from a stock download
GRAFT_SHA256=5d234cfe4bf03349cfc57b7c36a7179ee0aca04e3a33c1435b91b3be225b1aa4
GRAFT_DIR="<GRAFT_DIR>"
APPLY_GRAFT_PY="<APPLY_GRAFT_PY>"
CONTAINER_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:4a5d132a06a77c8331e15845f2e925adc788b00105097ad55409afa3f4fa4860   # the image <INSTANCE_ID> runs (box-a's digest)
