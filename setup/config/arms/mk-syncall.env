# mk-syncall env: mk-latest.env with full speculative TP sync, on its own venv and plugin checkout.
#   SGLANG_SPEC_TP_SYNC=all: every SpecTpSyncSite broadcasts from rank 0 (sglang speculative/spec_tp_sync.py preset
#     "all"; also environ.py's default). The plugin's spec (sgl_nvidia_mega/deepseek_v41/spec.py REQUIREMENTS.env)
#     REQUIRES an exact string match and refuses the launch otherwise; the syncall checkout's spec requires "all"
#     (../patches/plugin-spec-tp-sync-all.patch). The stock plugin refuses this env, so never pair it with mk29.
#   PATH -> /opt/sglang-mk29s/bin first (editable: sglang = /workspace/mk29/sglang @ 9ec65dacaf, box-a-mk-latest, ../raw/build-latest/tree-ff.md;
#     the plugin = /workspace/mk29/sgl-nvidia-mega-syncall); no PYTHONPATH overlay
#   XDG_CACHE_HOME=/workspace/cache-mk29: shared with mk-latest. The plugin's cubin cache keys by source, headers,
#     options (incl. its -I checkout paths) and NVRTC version (sgl_nvidia_mega/common/jit.py), so the arms never
#     collide.
#   SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT=per_rank as mk-latest (the plugin's engram slot requires it).
# Optional, off unless added: SGLANG_MK_TP_PROBE=1 (the branch's TP-consistency probe, ../merge-latest.md).
SGLANG_ENABLE_REQUEST_DECOMPRESSION=1
SGLANG_SWA_BRANCH_REBUILD=true
PYTHONFAULTHANDLER=1
SGLANG_SBR_PHASE_TIMING=1
SGLANG_SBR_PHASE_TIMING_DETAIL=1
SGLANG_SBR_PHASE_TIMING_GATE_FILE=/workspace/tools/sbr-phase-timing.gate
SGLANG_SBR_SCHEMA_MEMO=1
SGLANG_SBR_SCHEMA_MEMO_GATE_FILE=/workspace/tools/sbr-schema-memo.gate
SGLANG_EVENT_LOOP_LAG_INTERVAL_S=0
SGLANG_SBR_UNFINISHED_REUSE=1
SGLANG_SBR_UNFINISHED_REUSE_GATE_FILE=/workspace/tools/sbr-unfinished-reuse.gate
SGLANG_TOOL_STRICT_LEVEL=1
SGLANG_SBR_TOOL_STRICT_GATE_FILE=/workspace/tools/tool-strict.on
SGLANG_DEFAULT_THINKING=1
SGLANG_DSV41_REASONING_EFFORT=high
SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python
SGLANG_FORWARD_UNKNOWN_TOOLS=1
SGLANG_OPT_DSV41_BF16_INDEX_LOGITS=0
SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=1
SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT=per_rank
TRITON_PRINT_AUTOTUNING=1
SGLANG_SPEC_TP_SYNC=all
PATH=/opt/sglang-mk29s/bin:/root/.cargo/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
XDG_CACHE_HOME=/workspace/cache-mk29
