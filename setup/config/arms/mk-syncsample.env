# mk-syncsample env: mk-latest.env with the sampled DSpark accept broadcast from rank 0, on its own venv and plugin checkout.
#   SGLANG_SPEC_TP_SYNC=rng: sglang speculative/spec_tp_sync.py preset "rng" = init {1 dspark-mem, 12 dflash-mem} + the
#     RNG sites {9 dspark-accept-sample, 11 dspark-target, 13 dflash-selector, 14 dflash-accept-sample, 16 dflash-target}.
#     Versus the stock pin rng,-dspark-accept-sample it adds exactly site 9; versus "all" it leaves off 7 dspark-plan,
#     8 dspark-accept-greedy, 10 dspark-accept-graph, 15 dflash-accept-greedy and 17 dspark-draft. Site 10 stays off, so
#     the fused accept tail keeps its stock state (dspark_verify.py: on iff SGLANG_DSPARK_FUSED_ACCEPT_TAIL and site 10
#     off; that env defaults to SGLANG_ENABLE_NV_MEGA_RUNTIME_OPTIMIZATION, unset here, so the tail is off unless the
#     master switch is added). The plugin's spec (sgl_nvidia_mega/deepseek_v41/spec.py REQUIREMENTS.env) REQUIRES an
#     exact string match and refuses the launch otherwise; the syncsample checkout's spec requires "rng"
#     (../patches/plugin-spec-tp-sync-rng.patch). The stock and syncall plugins refuse this env: never pair it with
#     /opt/sglang-mk29 or /opt/sglang-mk29s.
#   PATH -> /opt/sglang-mk29r/bin first (editable: sglang = /workspace/mk29/sglang @ 9ec65dacaf, box-a-mk-latest, ../raw/build-latest/tree-ff.md;
#     the plugin = /workspace/mk29/sgl-nvidia-mega-syncsample); no PYTHONPATH overlay
#   XDG_CACHE_HOME=/workspace/cache-mk29: shared with mk-latest (ccache, torch_extensions). The plugin's cubins live in
#     ~/.cache/sglang/sgl_nvidia_mega (SGLANG_CACHE_DIR unset), keyed by source, headers, options and NVRTC version
#     (sgl_nvidia_mega/common/jit.py); the options carry -I of the venv's site-packages/nvidia/*/include, so this
#     venv's first boot JITs cold (~3 min of NVRTC) and never collides with another arm's cubins.
#   SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT=per_rank as mk-latest (the plugin's engram slot requires it).
# Optional, off unless added: SGLANG_MK_TP_PROBE=1 (the branch's TP-consistency probe, ../merge-latest.md).
SGLANG_ENABLE_REQUEST_DECOMPRESSION=1
SGLANG_SWA_BRANCH_REBUILD=true
PYTHONFAULTHANDLER=1
SGLANG_SBR_PHASE_TIMING=1
SGLANG_SBR_PHASE_TIMING_DETAIL=1
SGLANG_SBR_PHASE_TIMING_GATE_FILE=/workspace/tools/sbr-phase-timing.gate
SGLANG_SBR_SCHEMA_MEMO=1
SGLANG_SBR_SCHEMA_MEMO_GATE_FILE=/workspace/tools/sbr-schema-memo.gate
SGLANG_EVENT_LOOP_LAG_INTERVAL_S=0
SGLANG_SBR_UNFINISHED_REUSE=1
SGLANG_SBR_UNFINISHED_REUSE_GATE_FILE=/workspace/tools/sbr-unfinished-reuse.gate
SGLANG_TOOL_STRICT_LEVEL=1
SGLANG_SBR_TOOL_STRICT_GATE_FILE=/workspace/tools/tool-strict.on
SGLANG_DEFAULT_THINKING=1
SGLANG_DSV41_REASONING_EFFORT=high
SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python
SGLANG_FORWARD_UNKNOWN_TOOLS=1
SGLANG_OPT_DSV41_BF16_INDEX_LOGITS=0
SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=1
SGLANG_DSV41_ENGRAM_HOST_TABLE_LAYOUT=per_rank
TRITON_PRINT_AUTOTUNING=1
SGLANG_SPEC_TP_SYNC=rng
PATH=/opt/sglang-mk29r/bin:/root/.cargo/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
XDG_CACHE_HOME=/workspace/cache-mk29
