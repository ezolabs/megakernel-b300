# mk-syncall (box-a-megakernel-20261029): the megakernel arm with full speculative TP sync. Flags = mk-latest.args
# byte for byte; the arm differs only in its env (mk-syncall.env: SGLANG_SPEC_TP_SYNC=all, venv /opt/sglang-mk29s)
# and its plugin checkout: /workspace/mk29/sgl-nvidia-mega-syncall = sgl-nvidia-mega main 54b42892 + the B300
# patch + ../patches/plugin-spec-tp-sync-all.patch (the spec's required SGLANG_SPEC_TP_SYNC "all"), editable in
# /opt/sglang-mk29s. KV events/replay on 127.0.0.1 with "bind":true. Pair: mk-syncall.env.
--tp-size 4 --ep-size 1 --mem-fraction-static 0.75 --speculative-algorithm DSPARK --speculative-dspark-block-size 5 --cuda-graph-max-bs-decode 64 --max-running-requests 64 --context-length 1048576 --chunked-prefill-size 8192 --reasoning-parser auto --tool-call-parser auto --enable-metrics --trust-remote-code --prefill-decode-interval 4 --enable-cache-report --swa-prefix-tails 2048 --enable-priority-scheduling --disable-priority-preemption --default-priority-value 1 --max-queued-requests 512 --kv-events-config '{"publisher":"zmq","endpoint":"tcp://127.0.0.1:5557","bind":true,"replay_endpoint":"tcp://127.0.0.1:5558"}' --load-publish-endpoint tcp://127.0.0.1:5559 --metric-label-denylist priority model_name --short-prefill-token-threshold 3072 --short-prefill-chunk-size 1024 --short-prefill-max-tokens 4096 --short-prefill-lookahead 8 --short-prefill-swap-limit 16384 --enable-hierarchical-cache --hicache-ratio 2 --hicache-write-policy write_through --hicache-io-backend direct --hicache-mem-layout page_first_direct --hicache-host-memory-mode cache --no-enable-decoder-swa-bounded-replay --speculative-use-block-verification --cuda-graph-backend-prefill breakable --cuda-graph-max-bs-prefill 2048 --cuda-graph-prefill-max-context 131072 --flashinfer-allreduce-fusion-backend trtllm --enable-nvidia-megakernel
