diff --git a/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py b/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py
new file mode 100644
index 0000000000..5dab0225c9
--- /dev/null
+++ b/python/sglang/srt/managers/scheduler_components/mk_tp_probe.py
@@ -0,0 +1,64 @@
+"""SGLANG_MK_TP_PROBE=1 (off by default): every SGLANG_MK_TP_PROBE_EVERY (100)
+scheduler iterations each rank snapshots its state before the request receive;
+TP rank 0's snapshot rides that iteration's request broadcast (no new
+collective) and every rank compares it with its own. SGLANG_MK_TP_PROBE_ASSERT=1
+raises on a mismatch instead of only logging it."""
+
+import logging
+import os
+import zlib
+from dataclasses import dataclass
+
+logger = logging.getLogger(__name__)
+
+ENABLED = os.environ.get("SGLANG_MK_TP_PROBE") == "1"
+EVERY = max(1, int(os.environ.get("SGLANG_MK_TP_PROBE_EVERY", "100")))
+ASSERT = os.environ.get("SGLANG_MK_TP_PROBE_ASSERT") == "1"
+FIELDS = "it,forward_ct,sum_seq_lens,kv_available,rids_crc32,spec_accept,spec_verify_ct"
+_it = 0
+_checks = 0
+
+
+@dataclass(frozen=True)
+class MkTpProbe:
+    state: tuple
+
+
+def _state(scheduler) -> tuple:
+    reqs = scheduler.running_batch.reqs
+    mr = scheduler.metrics_reporter
+    return (
+        _it,
+        scheduler.forward_ct,
+        sum(req.seqlen for req in reqs),
+        scheduler.token_to_kv_pool_allocator.available_size(),
+        zlib.crc32(",".join(sorted(req.rid for req in reqs)).encode()),
+        mr.spec_total_num_accept_tokens + mr.spec_num_accept_tokens,
+        mr.spec_total_num_forward_ct + mr.spec_num_forward_ct,
+    )
+
+
+def before_recv(scheduler):
+    """This rank's snapshot on a probe iteration (rank 0 sends it), else None."""
+    global _it
+    _it += 1
+    return MkTpProbe(_state(scheduler)) if _it % EVERY == 0 else None
+
+
+def after_recv(scheduler, recv_reqs: list, mine, tp_rank: int) -> list:
+    """Strip rank 0's snapshot from the received requests and compare it."""
+    global _checks
+    probes = [req for req in recv_reqs if isinstance(req, MkTpProbe)]
+    if not probes:
+        return recv_reqs
+    rank0 = probes[0].state
+    mine = (mine or MkTpProbe(_state(scheduler))).state
+    if mine != rank0:
+        msg = f"MK_TP_PROBE MISMATCH rank={tp_rank} fields={FIELDS} mine={mine} rank0={rank0}"
+        logger.error(msg)
+        assert not ASSERT, msg
+    else:
+        _checks += 1
+        if _checks % 10 == 0:
+            logger.info(f"MK_TP_PROBE ok it={_it} rank={tp_rank} checks={_checks} state={mine}")
+    return [req for req in recv_reqs if not isinstance(req, MkTpProbe)]
