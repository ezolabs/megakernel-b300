+    def test_block_accept_lens_snapshot_survives_the_next_replay(self):
+        ep = _epilogue()
+        ep.block_accept_lens_buf = None
+        self.assertIsNone(ep.snapshot_block_accept_lens(4))
+        ep.block_accept_lens_buf = torch.arange(8, dtype=torch.int32)
+        # The in-graph accept still writes through the view.
+        ep.read_block_accept_lens(4).copy_(torch.full((4,), 7, dtype=torch.int32))
+        snap = ep.snapshot_block_accept_lens(4)
+        self.assertNotEqual(
+            snap.untyped_storage().data_ptr(),
+            ep.block_accept_lens_buf.untyped_storage().data_ptr(),
+        )
+        ep.block_accept_lens_buf.fill_(-1)  # the next verify replay
+        self.assertEqual(snap.tolist(), [7, 7, 7, 7])
+
+    def test_worker_hands_the_result_a_snapshot(self):
+        from sglang.srt.speculative.dspark_components.dspark_worker_v2 import (
+            DSparkWorkerV2,
+        )
+
+        ep = _epilogue()
+        ep.block_accept_lens_buf = torch.full((8,), 7, dtype=torch.int32)
+        worker = DSparkWorkerV2.__new__(DSparkWorkerV2)
+        worker._verify_epilogue = ep
+        lens = worker._block_accept_lens(accept=None, folded_accept=True, bs=4)
+        ep.block_accept_lens_buf.fill_(-1)  # the next verify replay
+        self.assertEqual(lens.tolist(), [7, 7, 7, 7])
+
 
